9":130815,"_42151":130818,"_42153":130821,"_42155":130824,"_42157":130827,"_42159":130830,"_42161":130833,"_42163":130836,"_42165":130839,"_42167":130842,"_42169":130845,"_31482":130848,"_42173":130851,"_42175":130854,"_42177":130857},{"_3708":73397,"_31596":73397,"_5":15417,"_3095":121520,"_31955":121521,"_21876":121524,"_28736":73397},"Despliega desde AWS Marketplace",[51485,121522,121523],"Despliegue","Otros modelos",[],{"_3708":73398,"_31596":73397,"_21876":121526,"_5":15057,"_28736":73397,"_3095":121527},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3708":73399,"_31596":73397,"_5":31952,"_21876":121529,"_28736":121530,"_3095":121531},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3708":73400,"_31596":73397,"_5":31952,"_21876":121533,"_28736":121534,"_3095":121535},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3708":73401,"_31596":73397,"_5":31952,"_21876":121537,"_28736":121538,"_3095":121539},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3708":73402,"_31596":73397,"_5":31952,"_21876":121541,"_28736":121542,"_3095":121543},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3708":73403,"_31596":73397,"_5":31952,"_21876":121545,"_28736":121546,"_3095":121547},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3708":73404,"_31596":73397,"_5":31952,"_21876":121549,"_28736":121550,"_3095":121551},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3708":73405,"_31596":73397,"_5":31952,"_21876":121553,"_28736":121554,"_3095":121555},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3708":73406,"_31596":73397,"_21876":121557,"_5":15057,"_28736":73397,"_3095":121558},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3708":73407,"_31596":73397,"_21876":121560,"_5":15057,"_28736":121530,"_3095":121561},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3708":73408,"_31596":73397,"_21876":121563,"_5":15057,"_28736":121530,"_3095":121564},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3708":73409,"_31596":73397,"_21876":121566,"_5":15057,"_28736":121530,"_3095":121567},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3708":73410,"_31596":73397,"_21876":121569,"_5":15057,"_28736":121534,"_3095":121570},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3708":73411,"_31596":73397,"_21876":121572,"_5":15057,"_28736":121534,"_3095":121573},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3708":73412,"_31596":73397,"_21876":121575,"_5":15057,"_28736":121534,"_3095":121576},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3708":73413,"_31596":73397,"_21876":121578,"_5":15057,"_28736":121538,"_3095":121579},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3708":73414,"_31596":73397,"_21876":121581,"_5":15057,"_28736":121542,"_3095":121582},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3708":73415,"_31596":73397,"_21876":121584,"_5":15057,"_28736":121546,"_3095":121585},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3708":73416,"_31596":73397,"_21876":121587,"_5":15057,"_28736":121550,"_3095":121588},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3708":73417,"_31596":73397,"_21876":121590,"_5":15057,"_28736":121554,"_3095":121591},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3708":73418,"_31596":73418,"_5":15417,"_3095":121593,"_31955":121594,"_21876":121595,"_28736":73418},"Despliega Lamassu",[51485,121522],[],{"_3708":73419,"_31596":73418,"_21876":121597,"_5":15057,"_28736":73418,"_3095":121598},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3708":73420,"_31596":73418,"_5":31952,"_21876":121600,"_28736":121601,"_3095":121602},[],"/docs/pr-preview/pr-78/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3708":73421,"_31596":73418,"_5":31952,"_21876":121604,"_28736":121605,"_3095":121606},[],"/docs/pr-preview/pr-78/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3708":73422,"_31596":73418,"_5":31952,"_21876":121608,"_28736":121609,"_3095":121610},[],"/docs/pr-preview/pr-78/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3708":73423,"_31596":73418,"_21876":121612,"_5":15057,"_28736":73418,"_3095":121613},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3708":73424,"_31596":73418,"_21876":121615,"_5":15057,"_28736":121601,"_3095":121616},[],"Modelo",{"_3708":73425,"_31596":73418,"_21876":121618,"_5":15057,"_28736":121601,"_3095":121619},[],"Recomendado para",{"_3708":73426,"_31596":73418,"_21876":121621,"_5":15057,"_28736":121601,"_3095":121622},[],"Quién opera la infraestructura",{"_3708":73427,"_31596":73418,"_21876":121624,"_5":15057,"_28736":121601,"_3095":121625},[],"Punto de partida",{"_3708":73428,"_31596":73418,"_21876":121627,"_5":15057,"_28736":121601,"_3095":51592},[],{"_3708":73429,"_31596":73418,"_21876":121629,"_5":15057,"_28736":121601,"_3095":121630},[],"Producción, entornos regulados y despliegues personalizados",{"_3708":73430,"_31596":73418,"_21876":121632,"_5":15057,"_28736":121601,"_3095":121633},[],"Tu equipo",{"_3708":73431,"_31596":73418,"_21876":121635,"_5":15057,"_28736":121601,"_3095":121636},[],"Helm o Fastlane",{"_3708":73432,"_31596":73418,"_21876":121638,"_5":15057,"_28736":121601,"_3095":51604},[],{"_3708":73433,"_31596":73418,"_21876":121640,"_5":15057,"_28736":121601,"_3095":121641},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3708":73434,"_31596":73418,"_21876":121643,"_5":15057,"_28736":121601,"_3095":121633},[],{"_3708":73435,"_31596":73418,"_21876":121645,"_5":15057,"_28736":121601,"_3095":121646},[],"Imagen preconfigurada en EC2",{"_3708":73436,"_31596":73418,"_21876":121648,"_5":15057,"_28736":121601,"_3095":51615},[],{"_3708":73437,"_31596":73418,"_21876":121650,"_5":15057,"_28736":121601,"_3095":121651},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3708":73438,"_31596":73418,"_21876":121653,"_5":15057,"_28736":121601,"_3095":51621},[],{"_3708":73439,"_31596":73418,"_21876":121655,"_5":15057,"_28736":121601,"_3095":121656},[],"Suscripción gestionada",{"_3708":73440,"_31596":73418,"_21876":121658,"_5":15057,"_28736":121601,"_3095":121659},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3708":73441,"_31596":73418,"_21876":121661,"_5":15057,"_28736":121601,"_3095":121662},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3708":73442,"_31596":73418,"_21876":121664,"_5":15057,"_28736":121601,"_3095":121665},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3708":73443,"_31596":73418,"_21876":121667,"_5":15057,"_28736":121605,"_3095":121668},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3708":73444,"_31596":73418,"_21876":121670,"_5":15057,"_28736":121609,"_3095":121671},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3708":73445,"_31596":73445,"_5":15417,"_3095":121673,"_31955":121674,"_21876":121675,"_28736":73445},"Utiliza Lamassu como SaaS",[51485,121522,121523],[],{"_3708":73446,"_31596":73445,"_21876":121677,"_5":15057,"_28736":73445,"_3095":121678},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3708":73447,"_31596":73445,"_5":31952,"_21876":121680,"_28736":121681,"_3095":121682},[],"/docs/pr-preview/pr-78/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3708":73448,"_31596":73445,"_5":31952,"_21876":121684,"_28736":121685,"_3095":121686},[],"/docs/pr-preview/pr-78/es/deployment/saas#planes","Planes",{"_3708":73449,"_31596":73445,"_5":31952,"_21876":121688,"_28736":121689,"_3095":121690},[],"/docs/pr-preview/pr-78/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3708":73450,"_31596":73445,"_21876":121692,"_5":15057,"_28736":73445,"_3095":121693},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3708":73451,"_31596":73445,"_21876":121695,"_5":15057,"_28736":121681,"_3095":121696},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3708":73452,"_31596":73445,"_21876":121698,"_5":15057,"_28736":121681,"_3095":121699},[],"Copias de seguridad automáticas.",{"_3708":73453,"_31596":73445,"_21876":121701,"_5":15057,"_28736":121681,"_3095":121702},[],"Actualizaciones de versión.",{"_3708":73454,"_31596":73445,"_21876":121704,"_5":15057,"_28736":121681,"_3095":121705},[],"Soporte técnico y SLA según el plan contratado.",{"_3708":73455,"_31596":73445,"_21876":121707,"_5":15057,"_28736":121685,"_3095":51676},[],{"_3708":73456,"_31596":73445,"_21876":121709,"_5":15057,"_28736":121685,"_3095":121710},[],"Dispositivos",{"_3708":73457,"_31596":73445,"_21876":121712,"_5":15057,"_28736":121685,"_3095":121713},[],"Soporte",{"_3708":73458,"_31596":73445,"_21876":121715,"_5":15057,"_28736":121685,"_3095":51685},[],{"_3708":73459,"_31596":73445,"_21876":121717,"_5":15057,"_28736":121685,"_3095":51688},[],{"_3708":73460,"_31596":73445,"_21876":121719,"_5":15057,"_28736":121685,"_3095":121720},[],"Hasta 1.000",{"_3708":73461,"_31596":73445,"_21876":121722,"_5":15057,"_28736":121685,"_3095":51694},[],{"_3708":73462,"_31596":73445,"_21876":121724,"_5":15057,"_28736":121685,"_3095":121725},[],"99,5 %",{"_3708":73463,"_31596":73445,"_21876":121727,"_5":15057,"_28736":121685,"_3095":51700},[],{"_3708":73464,"_31596":73445,"_21876":121729,"_5":15057,"_28736":121685,"_3095":121730},[],"Hasta 10.000",{"_3708":73465,"_31596":73445,"_21876":121732,"_5":15057,"_28736":121685,"_3095":121733},[],"Email y chat",{"_3708":73466,"_31596":73445,"_21876":121735,"_5":15057,"_28736":121685,"_3095":121736},[],"99,9 %",{"_3708":73467,"_31596":73445,"_21876":121738,"_5":15057,"_28736":121685,"_3095":51712},[],{"_3708":73468,"_31596":73445,"_21876":121740,"_5":15057,"_28736":121685,"_3095":121741},[],"Ilimitados",{"_3708":73469,"_31596":73445,"_21876":121743,"_5":15057,"_28736":121685,"_3095":121744},[],"Dedicado",{"_3708":73470,"_31596":73445,"_21876":121746,"_5":15057,"_28736":121685,"_3095":121747},[],"99,99 %",{"_3708":73471,"_31596":73445,"_21876":121749,"_5":15057,"_28736":121689,"_3095":121750},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3708":73472,"_31596":73445,"_21876":121752,"_5":15057,"_28736":121689,"_3095":121753},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3708":73473,"_31596":73473,"_5":15417,"_3095":51729,"_31955":121755,"_21876":121757,"_28736":73473},[51485,121522,121756],"Kubernetes autogestionado",[],{"_3708":73474,"_31596":73473,"_21876":121759,"_5":15057,"_28736":73473,"_3095":121760},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3708":73475,"_31596":73473,"_5":31952,"_21876":121762,"_28736":121763,"_3095":121764},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3708":73476,"_31596":73473,"_5":31952,"_21876":121766,"_28736":121767,"_3095":121768},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3708":73477,"_31596":73473,"_5":31952,"_21876":121770,"_28736":121771,"_3095":121772},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3708":73478,"_31596":73473,"_5":31952,"_21876":121774,"_28736":121775,"_3095":121776},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3708":73479,"_31596":73473,"_5":31952,"_21876":121778,"_28736":121779,"_3095":121780},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3708":73480,"_31596":73473,"_5":31952,"_21876":121782,"_28736":121783,"_3095":121784},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3708":73481,"_31596":73473,"_5":31952,"_21876":121786,"_28736":121787,"_3095":121788},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3708":73482,"_31596":73473,"_5":31952,"_21876":121790,"_28736":121791,"_3095":121792},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3708":73483,"_31596":73473,"_5":31952,"_21876":121794,"_28736":121795,"_3095":121796},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3708":73484,"_31596":73473,"_5":31952,"_21876":121798,"_28736":121799,"_3095":121800},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3708":73485,"_31596":73473,"_5":31952,"_21876":121802,"_28736":121803,"_3095":121804},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3708":73486,"_31596":73473,"_21876":121806,"_5":15057,"_28736":121763,"_3095":121807},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3708":73487,"_31596":73473,"_21876":121809,"_5":15057,"_28736":121763,"_3095":121810},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3708":73488,"_31596":73473,"_21876":121812,"_5":15057,"_28736":121767,"_3095":121813},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3708":73489,"_31596":73473,"_21876":121815,"_5":15057,"_28736":121767,"_3095":121816},[],"Fastlane instala o configura",{"_3708":73490,"_31596":73473,"_21876":121818,"_5":15057,"_28736":121767,"_3095":121819},[],"Tú sigues proporcionando",{"_3708":73491,"_31596":73473,"_21876":121821,"_5":15057,"_28736":121767,"_3095":121822},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3708":73492,"_31596":73473,"_21876":121824,"_5":15057,"_28736":121767,"_3095":121825},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3708":73493,"_31596":73473,"_21876":121827,"_5":15057,"_28736":121767,"_3095":121828},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3708":73494,"_31596":73473,"_21876":121830,"_5":15057,"_28736":121767,"_3095":121831},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3708":73495,"_31596":73473,"_21876":121833,"_5":15057,"_28736":121767,"_3095":121834},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3708":73496,"_31596":73473,"_21876":121836,"_5":15057,"_28736":121767,"_3095":121837},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3708":73497,"_31596":73473,"_21876":121839,"_5":15057,"_28736":121767,"_3095":121840},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3708":73498,"_31596":73473,"_21876":121842,"_5":15057,"_28736":121767,"_3095":121843},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3708":73499,"_31596":73473,"_21876":121845,"_5":15057,"_28736":121767,"_3095":121846},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3708":73500,"_31596":73473,"_21876":121848,"_5":15057,"_28736":121771,"_3095":121849},[],"Necesitas:",{"_3708":73501,"_31596":73473,"_21876":121851,"_5":15057,"_28736":121771,"_3095":121852},[],"un clúster Kubernetes existente",{"_3708":73502,"_31596":73473,"_21876":121854,"_5":15057,"_28736":121771,"_3095":121855},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3708":73503,"_31596":73473,"_21876":121857,"_5":15057,"_28736":121771,"_3095":51831},[],{"_3708":73504,"_31596":73473,"_21876":121859,"_5":15057,"_28736":121771,"_3095":24703},[],{"_3708":73505,"_31596":73473,"_21876":121861,"_5":15057,"_28736":121771,"_3095":121862},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3708":73506,"_31596":73473,"_21876":121864,"_5":15057,"_28736":121771,"_3095":121865},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3708":73507,"_31596":73473,"_21876":121867,"_5":15057,"_28736":121771,"_3095":121868},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3708":73508,"_31596":73473,"_21876":121870,"_5":15057,"_28736":121771,"_3095":121871},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3708":73509,"_31596":73473,"_21876":121873,"_5":15057,"_28736":121771,"_3095":121874},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3708":73510,"_31596":73473,"_21876":121876,"_5":15057,"_28736":121775,"_3095":121877},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3708":73511,"_31596":73473,"_21876":121879,"_5":15057,"_28736":121775,"_3095":121880},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3708":73512,"_31596":73473,"_21876":121882,"_5":15057,"_28736":121779,"_3095":121883},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3708":73513,"_31596":73473,"_21876":121885,"_5":15057,"_28736":121779,"_3095":121886},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3708":73514,"_31596":73473,"_21876":121888,"_5":15057,"_28736":121779,"_3095":121889},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3708":73515,"_31596":73473,"_21876":121891,"_5":15057,"_28736":121779,"_3095":121892},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3708":73516,"_31596":73473,"_21876":121894,"_5":15057,"_28736":121783,"_3095":121895},[],"Opción",{"_3708":73517,"_31596":73473,"_21876":121897,"_5":15057,"_28736":121783,"_3095":121898},[],"Valor predeterminado",{"_3708":73518,"_31596":73473,"_21876":121900,"_5":15057,"_28736":121783,"_3095":121901},[],"Propósito",{"_3708":73519,"_31596":73473,"_21876":121903,"_5":15057,"_28736":121783,"_3095":51878},[],{"_3708":73520,"_31596":73473,"_21876":121905,"_5":15057,"_28736":121783,"_3095":51881},[],{"_3708":73521,"_31596":73473,"_21876":121907,"_5":15057,"_28736":121783,"_3095":121908},[],"Muestra la ayuda",{"_3708":73522,"_31596":73473,"_21876":121910,"_5":15057,"_28736":121783,"_3095":51887},[],{"_3708":73523,"_31596":73473,"_21876":121912,"_5":15057,"_28736":121783,"_3095":121913},[],"contexto actual",{"_3708":73524,"_31596":73473,"_21876":121915,"_5":15057,"_28736":121783,"_3095":121916},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3708":73525,"_31596":73473,"_21876":121918,"_5":15057,"_28736":121783,"_3095":51896},[],{"_3708":73526,"_31596":73473,"_21876":121920,"_5":15057,"_28736":121783,"_3095":6856},[],{"_3708":73527,"_31596":73473,"_21876":121922,"_5":15057,"_28736":121783,"_3095":121923},[],"Omite prompts y genera credenciales para las dependencias",{"_3708":73528,"_31596":73473,"_21876":121925,"_5":15057,"_28736":121783,"_3095":51904},[],{"_3708":73529,"_31596":73473,"_21876":121927,"_5":15057,"_28736":121783,"_3095":51907},[],{"_3708":73530,"_31596":73473,"_21876":121929,"_5":15057,"_28736":121783,"_3095":121930},[],"Namespace de la instalación",{"_3708":73531,"_31596":73473,"_21876":121932,"_5":15057,"_28736":121783,"_3095":51913},[],{"_3708":73532,"_31596":73473,"_21876":121934,"_5":15057,"_28736":121783,"_3095":51916},[],{"_3708":73533,"_31596":73473,"_21876":121936,"_5":15057,"_28736":121783,"_3095":121937},[],"Dominio usado por la UI, OIDC y el certificado",{"_3708":73534,"_31596":73473,"_21876":121939,"_5":15057,"_28736":121783,"_3095":51922},[],{"_3708":73535,"_31596":73473,"_21876":121941,"_5":15057,"_28736":121783,"_3095":15774},[],{"_3708":73536,"_31596":73473,"_21876":121943,"_5":15057,"_28736":121783,"_3095":121944},[],"Versión del chart de Lamassu",{"_3708":73537,"_31596":73473,"_21876":121946,"_5":15057,"_28736":121783,"_3095":51930},[],{"_3708":73538,"_31596":73473,"_21876":121948,"_5":15057,"_28736":121783,"_3095":51933},[],{"_3708":73539,"_31596":73473,"_21876":121950,"_5":15057,"_28736":121783,"_3095":121951},[],"Puerto del listener HTTPS",{"_3708":73540,"_31596":73473,"_21876":121953,"_5":15057,"_28736":121783,"_3095":51939},[],{"_3708":73541,"_31596":73473,"_21876":121955,"_5":15057,"_28736":121783,"_3095":51942},[],{"_3708":73542,"_31596":73473,"_21876":121957,"_5":15057,"_28736":121783,"_3095":121958},[],"Puerto del listener HTTP",{"_3708":73543,"_31596":73473,"_21876":121960,"_5":15057,"_28736":121783,"_3095":51948},[],{"_3708":73544,"_31596":73473,"_21876":121962,"_5":15057,"_28736":121783,"_3095":51881},[],{"_3708":73545,"_31596":73473,"_21876":121964,"_5":15057,"_28736":121783,"_3095":121965},[],"Certificado PEM para TLS downstream",{"_3708":73546,"_31596":73473,"_21876":121967,"_5":15057,"_28736":121783,"_3095":51956},[],{"_3708":73547,"_31596":73473,"_21876":121969,"_5":15057,"_28736":121783,"_3095":51881},[],{"_3708":73548,"_31596":73473,"_21876":121971,"_5":15057,"_28736":121783,"_3095":121972},[],"Clave privada PEM para TLS downstream",{"_3708":73549,"_31596":73473,"_21876":121974,"_5":15057,"_28736":121783,"_3095":51964},[],{"_3708":73550,"_31596":73473,"_21876":121976,"_5":15057,"_28736":121783,"_3095":121977},[],"chart del repositorio",{"_3708":73551,"_31596":73473,"_21876":121979,"_5":15057,"_28736":121783,"_3095":121980},[],"Usa un chart local de Lamassu sin empaquetar",{"_3708":73552,"_31596":73473,"_21876":121982,"_5":15057,"_28736":121783,"_3095":51973},[],{"_3708":73553,"_31596":73473,"_21876":121984,"_5":15057,"_28736":121783,"_3095":121985},[],"detección automática",{"_3708":73554,"_31596":73473,"_21876":121987,"_5":15057,"_28736":121783,"_3095":121988},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3708":73555,"_31596":73473,"_21876":121990,"_5":15057,"_28736":121783,"_3095":51981},[],{"_3708":73556,"_31596":73473,"_21876":121992,"_5":15057,"_28736":121783,"_3095":6856},[],{"_3708":73557,"_31596":73473,"_21876":121994,"_5":15057,"_28736":121783,"_3095":121995},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3708":73558,"_31596":73473,"_21876":121997,"_5":15057,"_28736":121783,"_3095":51989},[],{"_3708":73559,"_31596":73473,"_21876":121999,"_5":15057,"_28736":121783,"_3095":6856},[],{"_3708":73560,"_31596":73473,"_21876":122001,"_5":15057,"_28736":121783,"_3095":122002},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3708":73561,"_31596":73473,"_21876":122004,"_5":15057,"_28736":121783,"_3095":51997},[],{"_3708":73562,"_31596":73473,"_21876":122006,"_5":15057,"_28736":121783,"_3095":6856},[],{"_3708":73563,"_31596":73473,"_21876":122008,"_5":15057,"_28736":121783,"_3095":122009},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3708":73564,"_31596":73473,"_21876":122011,"_5":15057,"_28736":121783,"_3095":52005},[],{"_3708":73565,"_31596":73473,"_21876":122013,"_5":15057,"_28736":121783,"_3095":6856},[],{"_3708":73566,"_31596":73473,"_21876":122015,"_5":15057,"_28736":121783,"_3095":122016},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3708":73567,"_31596":73473,"_21876":122018,"_5":15057,"_28736":121783,"_3095":52013},[],{"_3708":73568,"_31596":73473,"_21876":122020,"_5":15057,"_28736":121783,"_3095":52016},[],{"_3708":73569,"_31596":73473,"_21876":122022,"_5":15057,"_28736":121783,"_3095":122023},[],"Usa otro chart local de SoftHSM",{"_3708":73570,"_31596":73473,"_21876":122025,"_5":15057,"_28736":121783,"_3095":122026},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3708":73571,"_31596":73473,"_21876":122028,"_5":15057,"_28736":121787,"_3095":122029},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3708":73572,"_31596":73473,"_21876":122031,"_5":15057,"_28736":121787,"_3095":122032},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3708":73573,"_31596":73473,"_21876":122034,"_5":15057,"_28736":121787,"_3095":122035},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3708":73574,"_31596":73473,"_21876":122037,"_5":15057,"_28736":121787,"_3095":122038},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3708":73575,"_31596":73473,"_21876":122040,"_5":15057,"_28736":121787,"_3095":122041},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3708":73576,"_31596":73473,"_21876":122043,"_5":15057,"_28736":121787,"_3095":122044},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3708":73577,"_31596":73473,"_21876":122046,"_5":15057,"_28736":121791,"_3095":52043},[],{"_3708":73578,"_31596":73473,"_21876":122048,"_5":15057,"_28736":121791,"_3095":122049},[],"valida las herramientas locales y el clúster seleccionado",{"_3708":73579,"_31596":73473,"_21876":122051,"_5":15057,"_28736":121791,"_3095":122052},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3708":73580,"_31596":73473,"_21876":122054,"_5":15057,"_28736":121791,"_3095":122055},[],"crea el namespace",{"_3708":73581,"_31596":73473,"_21876":122057,"_5":15057,"_28736":121791,"_3095":122058},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3708":73582,"_31596":73473,"_21876":122060,"_5":15057,"_28736":121791,"_3095":122061},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3708":73583,"_31596":73473,"_21876":122063,"_5":15057,"_28736":121791,"_3095":122064},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3708":73584,"_31596":73473,"_21876":122066,"_5":15057,"_28736":121791,"_3095":122067},[],"instala RabbitMQ",{"_3708":73585,"_31596":73473,"_21876":122069,"_5":15057,"_28736":121791,"_3095":122070},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3708":73586,"_31596":73473,"_21876":122072,"_5":15057,"_28736":121791,"_3095":122073},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3708":73587,"_31596":73473,"_21876":122075,"_5":15057,"_28736":121791,"_3095":122076},[],"carga datos de ejemplo opcionalmente",{"_3708":73588,"_31596":73473,"_21876":122078,"_5":15057,"_28736":121791,"_3095":122079},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3708":73589,"_31596":73473,"_21876":122081,"_5":15057,"_28736":121795,"_3095":122082},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3708":73590,"_31596":73473,"_21876":122084,"_5":15057,"_28736":121795,"_3095":122085},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3708":73591,"_31596":73473,"_21876":122087,"_5":15057,"_28736":121799,"_3095":122088},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3708":73592,"_31596":73473,"_21876":122090,"_5":15057,"_28736":121799,"_3095":122091},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3708":73593,"_31596":73473,"_21876":122093,"_5":15057,"_28736":121799,"_3095":122094},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3708":73594,"_31596":73473,"_21876":122096,"_5":15057,"_28736":121799,"_3095":122097},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3708":73595,"_31596":73473,"_21876":122099,"_5":15057,"_28736":121803,"_3095":122100},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3708":73596,"_31596":73596,"_5":15417,"_3095":122102,"_31955":122103,"_21876":122104,"_28736":73596},"Instala con Helm",[51485,121522,121756],[],{"_3708":73597,"_31596":73596,"_21876":122106,"_5":15057,"_28736":73596,"_3095":122107},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3708":73598,"_31596":73596,"_5":31952,"_21876":122109,"_28736":122110,"_3095":122111},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3708":73599,"_31596":73596,"_5":31952,"_21876":122113,"_28736":122114,"_3095":121772},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3708":73600,"_31596":73596,"_5":31952,"_21876":122116,"_28736":122117,"_3095":122118},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3708":73601,"_31596":73596,"_5":31952,"_21876":122120,"_28736":122121,"_3095":122122},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3708":73602,"_31596":73596,"_5":31952,"_21876":122124,"_28736":122125,"_3095":122126},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3708":73603,"_31596":73596,"_5":31952,"_21876":122128,"_28736":122129,"_3095":122130},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3708":73604,"_31596":73596,"_5":31952,"_21876":122132,"_28736":122133,"_3095":122134},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3708":73605,"_31596":73596,"_5":31952,"_21876":122136,"_28736":122137,"_3095":122138},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#flujo-de-eventos-de-dispositivo-sse","Flujo de eventos de dispositivo (SSE)",{"_3708":73606,"_31596":73596,"_5":31952,"_21876":122140,"_28736":122141,"_3095":122142},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3708":73607,"_31596":73596,"_5":31952,"_21876":122144,"_28736":122145,"_3095":122146},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3708":73608,"_31596":73596,"_5":31952,"_21876":122148,"_28736":122149,"_3095":122150},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3708":73609,"_31596":73596,"_5":31952,"_21876":122152,"_28736":122153,"_3095":122154},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3708":73610,"_31596":73596,"_5":31952,"_21876":122156,"_28736":122157,"_3095":122158},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3708":73611,"_31596":73596,"_5":31952,"_21876":122160,"_28736":122161,"_3095":122162},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3708":73612,"_31596":73596,"_21876":122164,"_5":15057,"_28736":122110,"_3095":122165},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3708":73613,"_31596":73596,"_21876":122167,"_5":15057,"_28736":122114,"_3095":122168},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3708":73614,"_31596":73596,"_21876":122170,"_5":15057,"_28736":122114,"_3095":122171},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3708":73615,"_31596":73596,"_21876":122173,"_5":15057,"_28736":122114,"_3095":122174},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3708":73616,"_31596":73596,"_21876":122176,"_5":15057,"_28736":122114,"_3095":122177},[],"un broker RabbitMQ accesible y sus credenciales",{"_3708":73617,"_31596":73596,"_21876":122179,"_5":15057,"_28736":122114,"_3095":122180},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3708":73618,"_31596":73596,"_21876":122182,"_5":15057,"_28736":122114,"_3095":122183},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3708":73619,"_31596":73596,"_21876":122185,"_5":15057,"_28736":122114,"_3095":122186},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3708":73620,"_31596":73596,"_21876":122188,"_5":15057,"_28736":122114,"_3095":122189},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3708":73621,"_31596":73596,"_21876":122191,"_5":15057,"_28736":122114,"_3095":122192},[],"una StorageClass y un diseño de tráfico externo",{"_3708":73622,"_31596":73596,"_21876":122194,"_5":15057,"_28736":122114,"_3095":122195},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3708":73623,"_31596":73596,"_21876":122197,"_5":15057,"_28736":122114,"_3095":122198},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3708":73624,"_31596":73596,"_21876":122200,"_5":15057,"_28736":122114,"_3095":122201},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3708":73625,"_31596":73596,"_21876":122203,"_5":15057,"_28736":122117,"_3095":122204},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3708":73626,"_31596":73596,"_21876":122206,"_5":15057,"_28736":122117,"_3095":122207},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3708":73627,"_31596":73596,"_21876":122209,"_5":15057,"_28736":122117,"_3095":122210},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3708":73628,"_31596":73596,"_21876":122212,"_5":15057,"_28736":122121,"_3095":122213},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3708":73629,"_31596":73596,"_21876":122215,"_5":15057,"_28736":122121,"_3095":122216},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3708":73630,"_31596":73596,"_21876":122218,"_5":15057,"_28736":122121,"_3095":122219},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3708":73631,"_31596":73596,"_21876":122221,"_5":15057,"_28736":122121,"_3095":122222},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3708":73632,"_31596":73596,"_21876":122224,"_5":15057,"_28736":122125,"_3095":122225},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3708":73633,"_31596":73596,"_21876":122227,"_5":15057,"_28736":122125,"_3095":122228},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3708":73634,"_31596":73596,"_21876":122230,"_5":15057,"_28736":122125,"_3095":122231},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3708":73635,"_31596":73596,"_21876":122233,"_5":15057,"_28736":122125,"_3095":122234},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3708":73636,"_31596":73596,"_21876":122236,"_5":15057,"_28736":122125,"_3095":122237},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3708":73637,"_31596":73596,"_21876":122239,"_5":15057,"_28736":122125,"_3095":122240},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3708":73638,"_31596":73596,"_21876":122242,"_5":15057,"_28736":122125,"_3095":122243},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3708":73639,"_31596":73596,"_21876":122245,"_5":15057,"_28736":122125,"_3095":122246},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3708":73640,"_31596":73596,"_21876":122248,"_5":15057,"_28736":122129,"_3095":122249},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3708":73641,"_31596":73596,"_21876":122251,"_5":15057,"_28736":122133,"_3095":122252},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3708":73642,"_31596":73596,"_21876":122254,"_5":15057,"_28736":122133,"_3095":122255},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3708":73643,"_31596":73596,"_21876":122257,"_5":15057,"_28736":122133,"_3095":122258},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3708":73644,"_31596":73596,"_21876":122260,"_5":15057,"_28736":122133,"_3095":122261},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3708":73645,"_31596":73596,"_21876":122263,"_5":15057,"_28736":122133,"_3095":122264},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3708":73646,"_31596":73596,"_21876":122266,"_5":15057,"_28736":122133,"_3095":122267},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3708":73647,"_31596":73596,"_21876":122269,"_5":15057,"_28736":122133,"_3095":122270},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3708":73648,"_31596":73596,"_21876":122272,"_5":15057,"_28736":122137,"_3095":122273},[],"`services.deviceManager.sseEnabled` (por defecto `true`) controla si Device Manager sirve su flujo de eventos de dispositivo mediante Server-Sent Events (SSE). Con el valor por defecto, el chart renderiza una regla de gateway dedicada para el endpoint de eventos de dispositivo con un timeout de petición de 11 minutos, porque el timeout de petición por defecto del Gateway es demasiado corto para estos flujos, que el servicio mantiene abiertos hasta unos diez minutos. Las llamadas a Device Manager que no son peticiones SSE conservan el timeout por defecto del Gateway.",{"_3708":73649,"_31596":73596,"_21876":122275,"_5":15057,"_28736":122137,"_3095":122276},[],"Defínelo como `false` para deshabilitar el flujo: el chart renderiza entonces `sse_enabled: false` en la configuración de Device Manager y omite la regla de gateway, y las peticiones SSE al endpoint de eventos de dispositivo fallan. Consulta Eventos de dispositivo en la guía de actualización de 3.8.0 a 4.0.0.",{"_3708":73650,"_31596":73596,"_21876":122278,"_5":15057,"_28736":122141,"_3095":122279},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3708":73651,"_31596":73596,"_21876":122281,"_5":15057,"_28736":122141,"_3095":122282},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3708":73652,"_31596":73596,"_21876":122284,"_5":15057,"_28736":122141,"_3095":122285},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3708":73653,"_31596":73596,"_21876":122287,"_5":15057,"_28736":122141,"_3095":122288},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3708":73654,"_31596":73596,"_21876":122290,"_5":15057,"_28736":122145,"_3095":122291},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3708":73655,"_31596":73596,"_21876":122293,"_5":15057,"_28736":122145,"_3095":122294},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3708":73656,"_31596":73596,"_21876":122296,"_5":15057,"_28736":122145,"_3095":122297},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3708":73657,"_31596":73596,"_21876":122299,"_5":15057,"_28736":122145,"_3095":122300},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3708":73658,"_31596":73596,"_21876":122302,"_5":15057,"_28736":122149,"_3095":122303},[],"Para instalar un checkout local:",{"_3708":73659,"_31596":73596,"_21876":122305,"_5":15057,"_28736":122153,"_3095":122306},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3708":73660,"_31596":73596,"_21876":122308,"_5":15057,"_28736":122153,"_3095":122309},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3708":73661,"_31596":73596,"_21876":122311,"_5":15057,"_28736":122157,"_3095":122312},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3708":73662,"_31596":73596,"_21876":122314,"_5":15057,"_28736":122157,"_3095":122315},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3708":73663,"_31596":73596,"_21876":122317,"_5":15057,"_28736":122157,"_3095":122318},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3708":73664,"_31596":73596,"_21876":122320,"_5":15057,"_28736":122157,"_3095":122321},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3708":73665,"_31596":73596,"_21876":122323,"_5":15057,"_28736":122157,"_3095":122324},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3708":73666,"_31596":73596,"_21876":122326,"_5":15057,"_28736":122161,"_3095":122327},[],"Antes de pasar a producción, revisa:",{"_3708":73667,"_31596":73596,"_21876":122329,"_5":15057,"_28736":122161,"_3095":122330},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3708":73668,"_31596":73596,"_21876":122332,"_5":15057,"_28736":122161,"_3095":122333},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3708":73669,"_31596":73596,"_21876":122335,"_5":15057,"_28736":122161,"_3095":122336},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3708":73670,"_31596":73596,"_21876":122338,"_5":15057,"_28736":122161,"_3095":122339},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3708":73671,"_31596":73596,"_21876":122341,"_5":15057,"_28736":122161,"_3095":122342},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3708":73672,"_31596":73596,"_21876":122344,"_5":15057,"_28736":122161,"_3095":122345},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3708":73673,"_31596":73596,"_21876":122347,"_5":15057,"_28736":122161,"_3095":122348},[],"SMTP, observabilidad y entrega de alertas",{"_3708":73674,"_31596":73596,"_21876":122350,"_5":15057,"_28736":122161,"_3095":122351},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3708":73675,"_31596":73596,"_21876":122353,"_5":15057,"_28736":122161,"_3095":122354},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3708":73676,"_31596":73676,"_5":15417,"_3095":122356,"_31955":122357,"_21876":122358,"_28736":73676},"Expón el Gateway",[51485,121522,121756],[],{"_3708":73677,"_31596":73676,"_21876":122360,"_5":15057,"_28736":73676,"_3095":122361},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3708":73678,"_31596":73676,"_5":31952,"_21876":122363,"_28736":122364,"_3095":122365},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3708":73679,"_31596":73676,"_5":31952,"_21876":122367,"_28736":122368,"_3095":122369},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3708":73680,"_31596":73676,"_5":31952,"_21876":122371,"_28736":122372,"_3095":122373},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3708":73681,"_31596":73676,"_5":31952,"_21876":122375,"_28736":122376,"_3095":52374},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#k3s",{"_3708":73682,"_31596":73676,"_5":31952,"_21876":122378,"_28736":122379,"_3095":122380},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3708":73683,"_31596":73676,"_5":31952,"_21876":122382,"_28736":122383,"_3095":122384},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3708":73684,"_31596":73676,"_5":31952,"_21876":122386,"_28736":122387,"_3095":122388},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3708":73685,"_31596":73676,"_5":31952,"_21876":122390,"_28736":122391,"_3095":122392},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3708":73686,"_31596":73676,"_5":31952,"_21876":122394,"_28736":122395,"_3095":122396},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3708":73687,"_31596":73676,"_5":31952,"_21876":122398,"_28736":122399,"_3095":122400},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3708":73688,"_31596":73676,"_5":31952,"_21876":122402,"_28736":122403,"_3095":122404},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3708":73689,"_31596":73676,"_21876":122406,"_5":15057,"_28736":122364,"_3095":122407},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3708":73690,"_31596":73676,"_21876":122409,"_5":15057,"_28736":122364,"_3095":122410},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3708":73691,"_31596":73676,"_21876":122412,"_5":15057,"_28736":122368,"_3095":122413},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3708":73692,"_31596":73676,"_21876":122415,"_5":15057,"_28736":122368,"_3095":122416},[],"Defínelo únicamente cuando:",{"_3708":73693,"_31596":73676,"_21876":122418,"_5":15057,"_28736":122368,"_3095":122419},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3708":73694,"_31596":73676,"_21876":122421,"_5":15057,"_28736":122368,"_3095":122422},[],"esa dirección está asignada a este Gateway",{"_3708":73695,"_31596":73676,"_21876":122424,"_5":15057,"_28736":122368,"_3095":122425},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3708":73696,"_31596":73676,"_21876":122427,"_5":15057,"_28736":122368,"_3095":122428},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3708":73697,"_31596":73676,"_21876":122430,"_5":15057,"_28736":122368,"_3095":122431},[],"No confundas estos valores:",{"_3708":73698,"_31596":73676,"_21876":122433,"_5":15057,"_28736":122368,"_3095":122434},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3708":73699,"_31596":73676,"_21876":122436,"_5":15057,"_28736":122368,"_3095":122437},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3708":73700,"_31596":73676,"_21876":122439,"_5":15057,"_28736":122368,"_3095":122440},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3708":73701,"_31596":73676,"_21876":122442,"_5":15057,"_28736":122372,"_3095":122443},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3708":73702,"_31596":73676,"_21876":122445,"_5":15057,"_28736":122372,"_3095":122446},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3708":73703,"_31596":73676,"_21876":122448,"_5":15057,"_28736":122376,"_3095":122449},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3708":73704,"_31596":73676,"_21876":122451,"_5":15057,"_28736":122376,"_3095":122452},[],"Para el diseño recomendado:",{"_3708":73705,"_31596":73676,"_21876":122454,"_5":15057,"_28736":122376,"_3095":122455},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3708":73706,"_31596":73676,"_21876":122457,"_5":15057,"_28736":122376,"_3095":122458},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3708":73707,"_31596":73676,"_21876":122460,"_5":15057,"_28736":122376,"_3095":122461},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3708":73708,"_31596":73676,"_21876":122463,"_5":15057,"_28736":122376,"_3095":122464},[],"Apunta DNS a la dirección accesible de la VM.",{"_3708":73709,"_31596":73676,"_21876":122466,"_5":15057,"_28736":122376,"_3095":122467},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3708":73710,"_31596":73676,"_21876":122469,"_5":15057,"_28736":122379,"_3095":122470},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3708":73711,"_31596":73676,"_21876":122472,"_5":15057,"_28736":122383,"_3095":122473},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3708":73712,"_31596":73676,"_21876":122475,"_5":15057,"_28736":122383,"_3095":122476},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3708":73713,"_31596":73676,"_21876":122478,"_5":15057,"_28736":122387,"_3095":122479},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3708":73714,"_31596":73676,"_21876":122481,"_5":15057,"_28736":122387,"_3095":122482},[],"Requisito",{"_3708":73715,"_31596":73676,"_21876":122484,"_5":15057,"_28736":122387,"_3095":122485},[],"Diseño recomendado",{"_3708":73716,"_31596":73676,"_21876":122487,"_5":15057,"_28736":122387,"_3095":122488},[],"Consecuencia",{"_3708":73717,"_31596":73676,"_21876":122490,"_5":15057,"_28736":122387,"_3095":122491},[],"Varias URL o servicios de Lamassu",{"_3708":73718,"_31596":73676,"_21876":122493,"_5":15057,"_28736":122387,"_3095":122494},[],"Un Gateway con varias rutas",{"_3708":73719,"_31596":73676,"_21876":122496,"_5":15057,"_28736":122387,"_3095":122497},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3708":73720,"_31596":73676,"_21876":122499,"_5":15057,"_28736":122387,"_3095":122500},[],"Gateways independientes e IP externas distintas",{"_3708":73721,"_31596":73676,"_21876":122502,"_5":15057,"_28736":122387,"_3095":122503},[],"Una VIP por Gateway",{"_3708":73722,"_31596":73676,"_21876":122505,"_5":15057,"_28736":122387,"_3095":122506},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3708":73723,"_31596":73676,"_21876":122508,"_5":15057,"_28736":122387,"_3095":122509},[],"Gateways independientes, un nodo y una IP",{"_3708":73724,"_31596":73676,"_21876":122511,"_5":15057,"_28736":122387,"_3095":122512},[],"Puertos externos diferentes",{"_3708":73725,"_31596":73676,"_21876":122514,"_5":15057,"_28736":122387,"_3095":122515},[],"Los clientes deben indicar puertos no estándar",{"_3708":73726,"_31596":73676,"_21876":122517,"_5":15057,"_28736":122387,"_3095":122518},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3708":73727,"_31596":73676,"_21876":122520,"_5":15057,"_28736":122387,"_3095":122521},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3708":73728,"_31596":73676,"_21876":122523,"_5":15057,"_28736":122387,"_3095":122524},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3708":73729,"_31596":73676,"_21876":122526,"_5":15057,"_28736":122387,"_3095":122527},[],"Recursos Gateway separados pero proxy compartido",{"_3708":73730,"_31596":73676,"_21876":122529,"_5":15057,"_28736":122387,"_3095":122530},[],"Modo merged Gateway de Envoy",{"_3708":73731,"_31596":73676,"_21876":122532,"_5":15057,"_28736":122387,"_3095":122533},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3708":73732,"_31596":73676,"_21876":122535,"_5":15057,"_28736":122387,"_3095":122536},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3708":73733,"_31596":73676,"_21876":122538,"_5":15057,"_28736":122387,"_3095":122539},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3708":73734,"_31596":73676,"_21876":122541,"_5":15057,"_28736":122387,"_3095":122542},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3708":73735,"_31596":73676,"_21876":122544,"_5":15057,"_28736":122387,"_3095":122545},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3708":73736,"_31596":73676,"_21876":122547,"_5":15057,"_28736":122391,"_3095":122548},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3708":73737,"_31596":73676,"_21876":122550,"_5":15057,"_28736":122395,"_3095":122551},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3708":73738,"_31596":73676,"_21876":122553,"_5":15057,"_28736":122395,"_3095":122554},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3708":73739,"_31596":73676,"_21876":122556,"_5":15057,"_28736":122395,"_3095":122557},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3708":73740,"_31596":73676,"_21876":122559,"_5":15057,"_28736":122395,"_3095":122560},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3708":73741,"_31596":73676,"_21876":122562,"_5":15057,"_28736":122395,"_3095":122563},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3708":73742,"_31596":73676,"_21876":122565,"_5":15057,"_28736":122399,"_3095":122566},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3708":73743,"_31596":73676,"_21876":122568,"_5":15057,"_28736":122399,"_3095":122569},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3708":73744,"_31596":73676,"_21876":122571,"_5":15057,"_28736":122403,"_3095":122572},[],"Comprueba, en orden:",{"_3708":73745,"_31596":73676,"_21876":122574,"_5":15057,"_28736":122403,"_3095":122575},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3708":73746,"_31596":73676,"_21876":122577,"_5":15057,"_28736":122403,"_3095":122578},[],"Su estado contiene la dirección esperada.",{"_3708":73747,"_31596":73676,"_21876":122580,"_5":15057,"_28736":122403,"_3095":122581},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3708":73748,"_31596":73676,"_21876":122583,"_5":15057,"_28736":122403,"_3095":122584},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3708":73749,"_31596":73676,"_21876":122586,"_5":15057,"_28736":122403,"_3095":122587},[],"DNS resuelve al endpoint accesible externamente.",{"_3708":73750,"_31596":73676,"_21876":122589,"_5":15057,"_28736":122403,"_3095":122590},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3708":73751,"_31596":73676,"_21876":122592,"_5":15057,"_28736":122403,"_3095":122593},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3708":73752,"_31596":73752,"_5":15417,"_3095":51592,"_31955":122595,"_21876":122596,"_28736":73752},[51485,121522,121756],[],{"_3708":73753,"_31596":73752,"_21876":122598,"_5":15057,"_28736":73752,"_3095":122599},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3708":73754,"_31596":73752,"_5":31952,"_21876":122601,"_28736":122602,"_3095":122603},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3708":73755,"_31596":73752,"_5":31952,"_21876":122605,"_28736":122606,"_3095":122607},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3708":73756,"_31596":73752,"_5":31952,"_21876":122609,"_28736":122610,"_3095":122611},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3708":73757,"_31596":73752,"_5":31952,"_21876":122613,"_28736":122614,"_3095":122615},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3708":73758,"_31596":73752,"_5":31952,"_21876":122617,"_28736":122618,"_3095":122619},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3708":73759,"_31596":73752,"_5":31952,"_21876":122621,"_28736":122622,"_3095":122623},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3708":73760,"_31596":73752,"_21876":122625,"_5":15057,"_28736":122602,"_3095":122626},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3708":73761,"_31596":73752,"_21876":122628,"_5":15057,"_28736":122606,"_3095":122629},[],"Flujo",{"_3708":73762,"_31596":73752,"_21876":122631,"_5":15057,"_28736":122606,"_3095":122632},[],"Úsalo para",{"_3708":73763,"_31596":73752,"_21876":122634,"_5":15057,"_28736":122606,"_3095":122635},[],"Qué instala",{"_3708":73764,"_31596":73752,"_21876":122637,"_5":15057,"_28736":122606,"_3095":52636},[],{"_3708":73765,"_31596":73752,"_21876":122639,"_5":15057,"_28736":122606,"_3095":122640},[],"Producción y entornos controlados",{"_3708":73766,"_31596":73752,"_21876":122642,"_5":15057,"_28736":122606,"_3095":122643},[],"Servicios de Lamassu y recursos de Gateway API",{"_3708":73767,"_31596":73752,"_21876":122645,"_5":15057,"_28736":122606,"_3095":51729},[],{"_3708":73768,"_31596":73752,"_21876":122647,"_5":15057,"_28736":122606,"_3095":122648},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3708":73769,"_31596":73752,"_21876":122650,"_5":15057,"_28736":122606,"_3095":122651},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3708":73770,"_31596":73752,"_21876":122653,"_5":15057,"_28736":122610,"_3095":122654},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3708":73771,"_31596":73752,"_21876":122656,"_5":15057,"_28736":122610,"_3095":122657},[],"Área",{"_3708":73772,"_31596":73752,"_21876":122659,"_5":15057,"_28736":122610,"_3095":122660},[],"El chart de Lamassu proporciona",{"_3708":73773,"_31596":73752,"_21876":122662,"_5":15057,"_28736":122610,"_3095":122663},[],"Tú proporcionas",{"_3708":73774,"_31596":73752,"_21876":122665,"_5":15057,"_28736":122610,"_3095":122666},[],"Aplicaciones Lamassu",{"_3708":73775,"_31596":73752,"_21876":122668,"_5":15057,"_28736":122610,"_3095":122669},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3708":73776,"_31596":73752,"_21876":122671,"_5":15057,"_28736":122610,"_3095":122672},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3708":73777,"_31596":73752,"_21876":122674,"_5":15057,"_28736":122610,"_3095":122675},[],"Datos PostgreSQL",{"_3708":73778,"_31596":73752,"_21876":122677,"_5":15057,"_28736":122610,"_3095":122678},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3708":73779,"_31596":73752,"_21876":122680,"_5":15057,"_28736":122610,"_3095":122681},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3708":73780,"_31596":73752,"_21876":122683,"_5":15057,"_28736":122610,"_3095":122684},[],"Mensajería",{"_3708":73781,"_31596":73752,"_21876":122686,"_5":15057,"_28736":122610,"_3095":122687},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3708":73782,"_31596":73752,"_21876":122689,"_5":15057,"_28736":122610,"_3095":122690},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3708":73783,"_31596":73752,"_21876":122692,"_5":15057,"_28736":122610,"_3095":122693},[],"Identidad",{"_3708":73784,"_31596":73752,"_21876":122695,"_5":15057,"_28736":122610,"_3095":122696},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3708":73785,"_31596":73752,"_21876":122698,"_5":15057,"_28736":122610,"_3095":122699},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3708":73786,"_31596":73752,"_21876":122701,"_5":15057,"_28736":122610,"_3095":122702},[],"Enrutamiento externo",{"_3708":73787,"_31596":73752,"_21876":122704,"_5":15057,"_28736":122610,"_3095":122705},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3708":73788,"_31596":73752,"_21876":122707,"_5":15057,"_28736":122610,"_3095":122708},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3708":73789,"_31596":73752,"_21876":122710,"_5":15057,"_28736":122610,"_3095":52710},[],{"_3708":73790,"_31596":73752,"_21876":122712,"_5":15057,"_28736":122610,"_3095":122713},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3708":73791,"_31596":73752,"_21876":122715,"_5":15057,"_28736":122610,"_3095":122716},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3708":73792,"_31596":73752,"_21876":122718,"_5":15057,"_28736":122610,"_3095":122719},[],"Datos persistentes de la aplicación",{"_3708":73793,"_31596":73752,"_21876":122721,"_5":15057,"_28736":122610,"_3095":122722},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3708":73794,"_31596":73752,"_21876":122724,"_5":15057,"_28736":122610,"_3095":122725},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3708":73795,"_31596":73752,"_21876":122727,"_5":15057,"_28736":122610,"_3095":122728},[],"Integraciones opcionales",{"_3708":73796,"_31596":73752,"_21876":122730,"_5":15057,"_28736":122610,"_3095":122731},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3708":73797,"_31596":73752,"_21876":122733,"_5":15057,"_28736":122610,"_3095":122734},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3708":73798,"_31596":73752,"_21876":122736,"_5":15057,"_28736":122610,"_3095":122737},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3708":73799,"_31596":73752,"_21876":122739,"_5":15057,"_28736":122610,"_3095":122740},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3708":73800,"_31596":73752,"_21876":122742,"_5":15057,"_28736":122614,"_3095":122743},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3708":73801,"_31596":73752,"_21876":122745,"_5":15057,"_28736":122614,"_3095":122746},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3708":73802,"_31596":73752,"_21876":122748,"_5":15057,"_28736":122618,"_3095":122749},[],"Kubernetes 1.24 o posterior",{"_3708":73803,"_31596":73752,"_21876":122751,"_5":15057,"_28736":122618,"_3095":122752},[],"Helm 3.2 o posterior",{"_3708":73804,"_31596":73752,"_21876":122754,"_5":15057,"_28736":122618,"_3095":122755},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3708":73805,"_31596":73752,"_21876":122757,"_5":15057,"_28736":122618,"_3095":122758},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3708":73806,"_31596":73752,"_21876":122760,"_5":15057,"_28736":122618,"_3095":122761},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3708":73807,"_31596":73752,"_21876":122763,"_5":15057,"_28736":122618,"_3095":122764},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3708":73808,"_31596":73752,"_21876":122766,"_5":15057,"_28736":122618,"_3095":122767},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3708":73809,"_31596":73752,"_21876":122769,"_5":15057,"_28736":122622,"_3095":122770},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3708":73810,"_31596":73752,"_21876":122772,"_5":15057,"_28736":122622,"_3095":122773},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3708":73811,"_31596":73752,"_21876":122775,"_5":15057,"_28736":122622,"_3095":122776},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3708":73812,"_31596":73752,"_21876":122778,"_5":15057,"_28736":122622,"_3095":122779},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3708":73813,"_31596":73813,"_5":15417,"_3095":122781,"_31955":122782,"_21876":122784,"_28736":73813},"Resolución de problemas de despliegue",[51485,121522,122783],"Operación",[],{"_3708":73814,"_31596":73813,"_21876":122786,"_5":15057,"_28736":73813,"_3095":122787},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3708":73815,"_31596":73813,"_5":31952,"_21876":122789,"_28736":122790,"_3095":122791},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3708":73816,"_31596":73813,"_5":31952,"_21876":122793,"_28736":122794,"_3095":122795},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3708":73817,"_31596":73813,"_5":31952,"_21876":122797,"_28736":122798,"_3095":122799},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3708":73818,"_31596":73813,"_5":31952,"_21876":122801,"_28736":122802,"_3095":122803},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3708":73819,"_31596":73813,"_5":31952,"_21876":122805,"_28736":122806,"_3095":122807},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3708":73820,"_31596":73813,"_5":31952,"_21876":122809,"_28736":122810,"_3095":122811},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3708":73821,"_31596":73813,"_5":31952,"_21876":122813,"_28736":122814,"_3095":122815},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3708":73822,"_31596":73813,"_5":31952,"_21876":122817,"_28736":122818,"_3095":122819},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3708":73823,"_31596":73813,"_5":31952,"_21876":122821,"_28736":122822,"_3095":122823},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3708":73824,"_31596":73813,"_5":31952,"_21876":122825,"_28736":122826,"_3095":122827},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3708":73825,"_31596":73813,"_5":31952,"_21876":122829,"_28736":122830,"_3095":122831},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3708":73826,"_31596":73813,"_5":31952,"_21876":122833,"_28736":122834,"_3095":122835},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3708":73827,"_31596":73813,"_5":31952,"_21876":122837,"_28736":122838,"_3095":122839},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3708":73828,"_31596":73813,"_21876":122841,"_5":15057,"_28736":73813,"_3095":122842},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3708":73829,"_31596":73813,"_21876":122844,"_5":15057,"_28736":122794,"_3095":122845},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3708":73830,"_31596":73813,"_21876":122847,"_5":15057,"_28736":122798,"_3095":122848},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3708":73831,"_31596":73813,"_21876":122850,"_5":15057,"_28736":122802,"_3095":122851},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3708":73832,"_31596":73813,"_21876":122853,"_5":15057,"_28736":122806,"_3095":122854},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3708":73833,"_31596":73813,"_21876":122856,"_5":15057,"_28736":122810,"_3095":122857},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3708":73834,"_31596":73813,"_21876":122859,"_5":15057,"_28736":122814,"_3095":122860},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3708":73835,"_31596":73813,"_21876":122862,"_5":15057,"_28736":122814,"_3095":122863},[],"Ejecuta también la prueba de conectividad del chart:",{"_3708":73836,"_31596":73813,"_21876":122865,"_5":15057,"_28736":122814,"_3095":122866},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3708":73837,"_31596":73813,"_21876":122868,"_5":15057,"_28736":122814,"_3095":122869},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3708":73838,"_31596":73813,"_21876":122871,"_5":15057,"_28736":122818,"_3095":122872},[],"Si recibes un 401:",{"_3708":73839,"_31596":73813,"_21876":122874,"_5":15057,"_28736":122818,"_3095":122875},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3708":73840,"_31596":73813,"_21876":122877,"_5":15057,"_28736":122818,"_3095":122878},[],"verifica emisor, audiencia y expiración del token;",{"_3708":73841,"_31596":73813,"_21876":122880,"_5":15057,"_28736":122818,"_3095":122881},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3708":73842,"_31596":73813,"_21876":122883,"_5":15057,"_28736":122818,"_3095":122884},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3708":73843,"_31596":73813,"_21876":122886,"_5":15057,"_28736":122818,"_3095":122887},[],"Si el login termina pero las APIs devuelven 403:",{"_3708":73844,"_31596":73813,"_21876":122889,"_5":15057,"_28736":122818,"_3095":122890},[],"inspecciona los claims reales del token;",{"_3708":73845,"_31596":73813,"_21876":122892,"_5":15057,"_28736":122818,"_3095":122893},[],"confirma que coinciden con un principal activo;",{"_3708":73846,"_31596":73813,"_21876":122895,"_5":15057,"_28736":122818,"_3095":122896},[],"revisa las políticas concedidas al principal;",{"_3708":73847,"_31596":73813,"_21876":122898,"_5":15057,"_28736":122818,"_3095":122899},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3708":73848,"_31596":73813,"_21876":122901,"_5":15057,"_28736":122818,"_3095":122902},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3708":73849,"_31596":73813,"_21876":122904,"_5":15057,"_28736":122822,"_3095":122905},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3708":73850,"_31596":73813,"_21876":122907,"_5":15057,"_28736":122822,"_3095":122908},[],"Localiza el pod y Service de authz.",{"_3708":73851,"_31596":73813,"_21876":122910,"_5":15057,"_28736":122822,"_3095":122911},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3708":73852,"_31596":73813,"_21876":122913,"_5":15057,"_28736":122822,"_3095":122914},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3708":73853,"_31596":73813,"_21876":122916,"_5":15057,"_28736":122822,"_3095":122917},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3708":73854,"_31596":73813,"_21876":122919,"_5":15057,"_28736":122822,"_3095":122920},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3708":73855,"_31596":73813,"_21876":122922,"_5":15057,"_28736":122826,"_3095":122923},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3708":73856,"_31596":73813,"_21876":122925,"_5":15057,"_28736":122830,"_3095":122926},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3708":73857,"_31596":73813,"_21876":122928,"_5":15057,"_28736":122830,"_3095":122929},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3708":73858,"_31596":73813,"_21876":122931,"_5":15057,"_28736":122830,"_3095":122932},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3708":73859,"_31596":73813,"_21876":122934,"_5":15057,"_28736":122830,"_3095":122935},[],"volumen persistente sin enlazar;",{"_3708":73860,"_31596":73813,"_21876":122937,"_5":15057,"_28736":122830,"_3095":122938},[],"imagen inaccesible o política de pull incorrecta;",{"_3708":73861,"_31596":73813,"_21876":122940,"_5":15057,"_28736":122830,"_3095":122941},[],"configuración inválida del motor criptográfico;",{"_3708":73862,"_31596":73813,"_21876":122943,"_5":15057,"_28736":122830,"_3095":122944},[],"límites de CPU o memoria demasiado bajos;",{"_3708":73863,"_31596":73813,"_21876":122946,"_5":15057,"_28736":122830,"_3095":122947},[],"migración previa incompleta.",{"_3708":73864,"_31596":73813,"_21876":122949,"_5":15057,"_28736":122830,"_3095":122950},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3708":73865,"_31596":73813,"_21876":122952,"_5":15057,"_28736":122830,"_3095":122953},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3708":73866,"_31596":73813,"_21876":122955,"_5":15057,"_28736":122830,"_3095":122956},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3708":73867,"_31596":73813,"_21876":122958,"_5":15057,"_28736":122834,"_3095":122959},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3708":73868,"_31596":73813,"_21876":122961,"_5":15057,"_28736":122834,"_3095":122962},[],"verifica que esté habilitado en el servicio emisor;",{"_3708":73869,"_31596":73813,"_21876":122964,"_5":15057,"_28736":122834,"_3095":122965},[],"comprueba conectividad y credenciales AMQP;",{"_3708":73870,"_31596":73813,"_21876":122967,"_5":15057,"_28736":122834,"_3095":122968},[],"revisa exchange, routing key, colas y consumidores;",{"_3708":73871,"_31596":73813,"_21876":122970,"_5":15057,"_28736":122834,"_3095":122971},[],"inspecciona dead-letter queues;",{"_3708":73872,"_31596":73813,"_21876":122973,"_5":15057,"_28736":122834,"_3095":122974},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3708":73873,"_31596":73813,"_21876":122976,"_5":15057,"_28736":122834,"_3095":122977},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3708":73874,"_31596":73813,"_21876":122979,"_5":15057,"_28736":122834,"_3095":122980},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3708":73875,"_31596":73813,"_21876":122982,"_5":15057,"_28736":122834,"_3095":122983},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3708":73876,"_31596":73813,"_21876":122985,"_5":15057,"_28736":122834,"_3095":122986},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3708":73877,"_31596":73813,"_21876":122988,"_5":15057,"_28736":122834,"_3095":122989},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3708":73878,"_31596":73813,"_21876":122991,"_5":15057,"_28736":122834,"_3095":122992},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3708":73879,"_31596":73813,"_21876":122994,"_5":15057,"_28736":122834,"_3095":122995},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3708":73880,"_31596":73813,"_21876":122997,"_5":15057,"_28736":122838,"_3095":122998},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3708":73881,"_31596":73813,"_21876":123000,"_5":15057,"_28736":122838,"_3095":123001},[],"Antes de cerrar una incidencia, guarda:",{"_3708":73882,"_31596":73813,"_21876":123003,"_5":15057,"_28736":122838,"_3095":123004},[],"causa confirmada;",{"_3708":73883,"_31596":73813,"_21876":123006,"_5":15057,"_28736":122838,"_3095":123007},[],"alcance temporal y recursos afectados;",{"_3708":73884,"_31596":73813,"_21876":123009,"_5":15057,"_28736":122838,"_3095":123010},[],"comandos o consultas utilizados;",{"_3708":73885,"_31596":73813,"_21876":123012,"_5":15057,"_28736":122838,"_3095":123013},[],"cambio aplicado y forma de revertirlo;",{"_3708":73886,"_31596":73813,"_21876":123015,"_5":15057,"_28736":122838,"_3095":123016},[],"validación desde un consumidor;",{"_3708":73887,"_31596":73813,"_21876":123018,"_5":15057,"_28736":122838,"_3095":123019},[],"acción preventiva y propietario.",{"_3708":73888,"_31596":73888,"_5":15417,"_3095":123021,"_31955":123022,"_21876":123026,"_28736":73888},"Modelo de datos",[51485,123023,123024,123025],"Plataforma","Administración","Control de acceso",[],{"_3708":73889,"_31596":73888,"_21876":123028,"_5":15057,"_28736":73888,"_3095":123029},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3708":73890,"_31596":73888,"_5":31952,"_21876":123031,"_28736":123032,"_3095":123033},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3708":73891,"_31596":73888,"_5":31952,"_21876":123035,"_28736":123036,"_3095":123037},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3708":73892,"_31596":73888,"_21876":123039,"_5":15057,"_28736":73888,"_3095":123040},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3708":73893,"_31596":73888,"_21876":123042,"_5":15057,"_28736":123032,"_3095":123043},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3708":73894,"_31596":73888,"_21876":123045,"_5":15057,"_28736":123032,"_3095":123046},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3708":73895,"_31596":73888,"_21876":123048,"_5":15057,"_28736":123032,"_3095":123049},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3708":73896,"_31596":73888,"_21876":123051,"_5":15057,"_28736":123036,"_3095":123052},[],"Entidad (`schema_name.entity_type`)",{"_3708":73897,"_31596":73888,"_21876":123054,"_5":15057,"_28736":123036,"_3095":123055},[],"Tabla (`table_name`)",{"_3708":73898,"_31596":73888,"_21876":123057,"_5":15057,"_28736":123036,"_3095":123058},[],"Clave (`primary_key`)",{"_3708":73899,"_31596":73888,"_21876":123060,"_5":15057,"_28736":123036,"_3095":53061},[],{"_3708":73900,"_31596":73888,"_21876":123062,"_5":15057,"_28736":123036,"_3095":53064},[],{"_3708":73901,"_31596":73888,"_21876":123064,"_5":15057,"_28736":123036,"_3095":53067},[],{"_3708":73902,"_31596":73888,"_21876":123066,"_5":15057,"_28736":123036,"_3095":53070},[],{"_3708":73903,"_31596":73888,"_21876":123068,"_5":15057,"_28736":123036,"_3095":53073},[],{"_3708":73904,"_31596":73888,"_21876":123070,"_5":15057,"_28736":123036,"_3095":53076},[],{"_3708":73905,"_31596":73888,"_21876":123072,"_5":15057,"_28736":123036,"_3095":53079},[],{"_3708":73906,"_31596":73888,"_21876":123074,"_5":15057,"_28736":123036,"_3095":53082},[],{"_3708":73907,"_31596":73888,"_21876":123076,"_5":15057,"_28736":123036,"_3095":53076},[],{"_3708":73908,"_31596":73888,"_21876":123078,"_5":15057,"_28736":123036,"_3095":53087},[],{"_3708":73909,"_31596":73888,"_21876":123080,"_5":15057,"_28736":123036,"_3095":53090},[],{"_3708":73910,"_31596":73888,"_21876":123082,"_5":15057,"_28736":123036,"_3095":53093},[],{"_3708":73911,"_31596":73888,"_21876":123084,"_5":15057,"_28736":123036,"_3095":53096},[],{"_3708":73912,"_31596":73888,"_21876":123086,"_5":15057,"_28736":123036,"_3095":53099},[],{"_3708":73913,"_31596":73888,"_21876":123088,"_5":15057,"_28736":123036,"_3095":53076},[],{"_3708":73914,"_31596":73888,"_21876":123090,"_5":15057,"_28736":123036,"_3095":53104},[],{"_3708":73915,"_31596":73888,"_21876":123092,"_5":15057,"_28736":123036,"_3095":53107},[],{"_3708":73916,"_31596":73888,"_21876":123094,"_5":15057,"_28736":123036,"_3095":53076},[],{"_3708":73917,"_31596":73888,"_21876":123096,"_5":15057,"_28736":123036,"_3095":53112},[],{"_3708":73918,"_31596":73888,"_21876":123098,"_5":15057,"_28736":123036,"_3095":53115},[],{"_3708":73919,"_31596":73888,"_21876":123100,"_5":15057,"_28736":123036,"_3095":53076},[],{"_3708":73920,"_31596":73888,"_21876":123102,"_5":15057,"_28736":123036,"_3095":53120},[],{"_3708":73921,"_31596":73888,"_21876":123104,"_5":15057,"_28736":123036,"_3095":53123},[],{"_3708":73922,"_31596":73888,"_21876":123106,"_5":15057,"_28736":123036,"_3095":53076},[],{"_3708":73923,"_31596":73888,"_21876":123108,"_5":15057,"_28736":123036,"_3095":53128},[],{"_3708":73924,"_31596":73888,"_21876":123110,"_5":15057,"_28736":123036,"_3095":53131},[],{"_3708":73925,"_31596":73888,"_21876":123112,"_5":15057,"_28736":123036,"_3095":53134},[],{"_3708":73926,"_31596":73888,"_21876":123114,"_5":15057,"_28736":123036,"_3095":53137},[],{"_3708":73927,"_31596":73888,"_21876":123116,"_5":15057,"_28736":123036,"_3095":53140},[],{"_3708":73928,"_31596":73888,"_21876":123118,"_5":15057,"_28736":123036,"_3095":53143},[],{"_3708":73929,"_31596":73888,"_21876":123120,"_5":15057,"_28736":123036,"_3095":123121},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3708":73930,"_31596":73888,"_21876":123123,"_5":15057,"_28736":123036,"_3095":123124},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3708":73931,"_31596":73888,"_21876":123126,"_5":15057,"_28736":123036,"_3095":123127},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3708":73932,"_31596":73932,"_5":15417,"_3095":123129,"_31955":123130,"_21876":123131,"_28736":73932},"Visión general del control de acceso",[51485,123023,123024,123025],[],{"_3708":73933,"_31596":73932,"_21876":123133,"_5":15057,"_28736":73932,"_3095":123134},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3708":73934,"_31596":73932,"_5":31952,"_21876":123136,"_28736":123137,"_3095":123138},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3708":73935,"_31596":73932,"_5":31952,"_21876":123140,"_28736":123141,"_3095":123142},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3708":73936,"_31596":73932,"_5":31952,"_21876":123144,"_28736":123145,"_3095":123146},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3708":73937,"_31596":73932,"_5":31952,"_21876":123148,"_28736":123149,"_3095":123150},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3708":73938,"_31596":73932,"_5":31952,"_21876":123152,"_28736":123153,"_3095":123154},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3708":73939,"_31596":73932,"_5":31952,"_21876":123156,"_28736":123157,"_3095":123158},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3708":73940,"_31596":73932,"_5":31952,"_21876":123160,"_28736":123161,"_3095":123162},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3708":73941,"_31596":73932,"_5":31952,"_21876":123164,"_28736":123165,"_3095":123166},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3708":73942,"_31596":73932,"_5":31952,"_21876":123168,"_28736":123169,"_3095":123170},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3708":73943,"_31596":73932,"_5":31952,"_21876":123172,"_28736":123173,"_3095":123174},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3708":73944,"_31596":73932,"_5":31952,"_21876":123176,"_28736":123177,"_3095":123178},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3708":73945,"_31596":73932,"_5":31952,"_21876":123180,"_28736":123181,"_3095":123182},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3708":73946,"_31596":73932,"_5":31952,"_21876":123184,"_28736":123185,"_3095":123186},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3708":73947,"_31596":73932,"_5":31952,"_21876":123188,"_28736":123189,"_3095":123190},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3708":73948,"_31596":73932,"_5":31952,"_21876":123192,"_28736":123193,"_3095":123194},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3708":73949,"_31596":73932,"_5":31952,"_21876":123196,"_28736":123197,"_3095":122142},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3708":73950,"_31596":73932,"_5":31952,"_21876":123199,"_28736":123200,"_3095":123201},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3708":73951,"_31596":73932,"_5":31952,"_21876":123203,"_28736":123204,"_3095":123205},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3708":73952,"_31596":73932,"_5":31952,"_21876":123207,"_28736":123208,"_3095":123209},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3708":73953,"_31596":73932,"_5":31952,"_21876":123211,"_28736":123212,"_3095":123213},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3708":73954,"_31596":73932,"_5":31952,"_21876":123215,"_28736":123216,"_3095":123217},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3708":73955,"_31596":73932,"_5":31952,"_21876":123219,"_28736":123220,"_3095":123221},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3708":73956,"_31596":73932,"_5":31952,"_21876":123223,"_28736":123224,"_3095":123225},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3708":73957,"_31596":73932,"_5":31952,"_21876":123227,"_28736":123228,"_3095":123229},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3708":73958,"_31596":73932,"_5":31952,"_21876":123231,"_28736":123232,"_3095":123233},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3708":73959,"_31596":73932,"_5":31952,"_21876":123235,"_28736":123236,"_3095":123237},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3708":73960,"_31596":73932,"_5":31952,"_21876":123239,"_28736":123240,"_3095":123241},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3708":73961,"_31596":73932,"_5":31952,"_21876":123243,"_28736":123244,"_3095":123245},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3708":73962,"_31596":73932,"_5":31952,"_21876":123247,"_28736":123248,"_3095":123249},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3708":73963,"_31596":73932,"_5":31952,"_21876":123251,"_28736":123252,"_3095":123253},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3708":73964,"_31596":73932,"_5":31952,"_21876":123255,"_28736":123256,"_3095":123257},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3708":73965,"_31596":73932,"_21876":123259,"_5":15057,"_28736":73932,"_3095":123260},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3708":73966,"_31596":73932,"_21876":123262,"_5":15057,"_28736":73932,"_3095":123263},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3708":73967,"_31596":73932,"_21876":123265,"_5":15057,"_28736":73932,"_3095":123266},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3708":73968,"_31596":73932,"_21876":123268,"_5":15057,"_28736":123137,"_3095":123269},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3708":73969,"_31596":73932,"_21876":123271,"_5":15057,"_28736":123137,"_3095":123272},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3708":73970,"_31596":73932,"_21876":123274,"_5":15057,"_28736":123137,"_3095":123275},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3708":73971,"_31596":73932,"_21876":123277,"_5":15057,"_28736":123137,"_3095":123278},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3708":73972,"_31596":73932,"_21876":123280,"_5":15057,"_28736":123137,"_3095":123281},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3708":73973,"_31596":73932,"_21876":123283,"_5":15057,"_28736":123137,"_3095":123284},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3708":73974,"_31596":73932,"_21876":123286,"_5":15057,"_28736":123141,"_3095":123287},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3708":73975,"_31596":73932,"_21876":123289,"_5":15057,"_28736":123141,"_3095":123290},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3708":73976,"_31596":73932,"_21876":123292,"_5":15057,"_28736":123145,"_3095":123293},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3708":73977,"_31596":73932,"_21876":123295,"_5":15057,"_28736":123145,"_3095":123296},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3708":73978,"_31596":73932,"_21876":123298,"_5":15057,"_28736":123145,"_3095":123299},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3708":73979,"_31596":73932,"_21876":123301,"_5":15057,"_28736":123145,"_3095":123302},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3708":73980,"_31596":73932,"_21876":123304,"_5":15057,"_28736":123145,"_3095":123305},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3708":73981,"_31596":73932,"_21876":123307,"_5":15057,"_28736":123145,"_3095":123308},[],"Carga por separado las políticas concedidas a cada principal.",{"_3708":73982,"_31596":73932,"_21876":123310,"_5":15057,"_28736":123145,"_3095":123311},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3708":73983,"_31596":73932,"_21876":123313,"_5":15057,"_28736":123145,"_3095":123314},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3708":73984,"_31596":73932,"_21876":123316,"_5":15057,"_28736":123145,"_3095":123317},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3708":73985,"_31596":73932,"_21876":123319,"_5":15057,"_28736":123145,"_3095":123320},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3708":73986,"_31596":73932,"_21876":123322,"_5":15057,"_28736":123145,"_3095":123323},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3708":73987,"_31596":73932,"_21876":123325,"_5":15057,"_28736":123145,"_3095":123326},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3708":73988,"_31596":73932,"_21876":123328,"_5":15057,"_28736":123149,"_3095":123329},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3708":73989,"_31596":73932,"_21876":123331,"_5":15057,"_28736":123149,"_3095":123332},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3708":73990,"_31596":73932,"_21876":123334,"_5":15057,"_28736":123149,"_3095":123335},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3708":73991,"_31596":73932,"_21876":123337,"_5":15057,"_28736":123149,"_3095":123338},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3708":73992,"_31596":73932,"_21876":123340,"_5":15057,"_28736":123149,"_3095":123341},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3708":73993,"_31596":73932,"_21876":123343,"_5":15057,"_28736":123149,"_3095":123344},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3708":73994,"_31596":73932,"_21876":123346,"_5":15057,"_28736":123149,"_3095":123347},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3708":73995,"_31596":73932,"_21876":123349,"_5":15057,"_28736":123149,"_3095":123350},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3708":73996,"_31596":73932,"_21876":123352,"_5":15057,"_28736":123149,"_3095":123353},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3708":73997,"_31596":73932,"_21876":123355,"_5":15057,"_28736":123149,"_3095":123356},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3708":73998,"_31596":73932,"_21876":123358,"_5":15057,"_28736":123153,"_3095":123359},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3708":73999,"_31596":73932,"_21876":123361,"_5":15057,"_28736":123153,"_3095":123362},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3708":74000,"_31596":73932,"_21876":123364,"_5":15057,"_28736":123153,"_3095":123365},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3708":74001,"_31596":73932,"_21876":123367,"_5":15057,"_28736":123153,"_3095":123368},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3708":74002,"_31596":73932,"_21876":123370,"_5":15057,"_28736":123153,"_3095":123371},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3708":74003,"_31596":73932,"_21876":123373,"_5":15057,"_28736":123153,"_3095":123374},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3708":74004,"_31596":73932,"_21876":123376,"_5":15057,"_28736":123153,"_3095":123377},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3708":74005,"_31596":73932,"_21876":123379,"_5":15057,"_28736":123153,"_3095":123380},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3708":74006,"_31596":73932,"_21876":123382,"_5":15057,"_28736":123153,"_3095":123383},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3708":74007,"_31596":73932,"_21876":123385,"_5":15057,"_28736":123153,"_3095":123386},[],"Las acciones se dividen en dos grupos:",{"_3708":74008,"_31596":73932,"_21876":123388,"_5":15057,"_28736":123153,"_3095":123389},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3708":74009,"_31596":73932,"_21876":123391,"_5":15057,"_28736":123153,"_3095":123392},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3708":74010,"_31596":73932,"_21876":123394,"_5":15057,"_28736":123153,"_3095":123395},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3708":74011,"_31596":73932,"_21876":123397,"_5":15057,"_28736":123157,"_3095":123398},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3708":74012,"_31596":73932,"_21876":123400,"_5":15057,"_28736":123157,"_3095":123401},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3708":74013,"_31596":73932,"_21876":123403,"_5":15057,"_28736":123157,"_3095":123404},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3708":74014,"_31596":73932,"_21876":123406,"_5":15057,"_28736":123161,"_3095":123407},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3708":74015,"_31596":73932,"_21876":123409,"_5":15057,"_28736":123161,"_3095":123410},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3708":74016,"_31596":73932,"_21876":123412,"_5":15057,"_28736":123161,"_3095":123413},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3708":74017,"_31596":73932,"_21876":123415,"_5":15057,"_28736":123161,"_3095":123416},[],"Los operadores implementados son:",{"_3708":74018,"_31596":73932,"_21876":123418,"_5":15057,"_28736":123161,"_3095":123419},[],"`equals`, para igualdad exacta;",{"_3708":74019,"_31596":73932,"_21876":123421,"_5":15057,"_28736":123161,"_3095":123422},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3708":74020,"_31596":73932,"_21876":123424,"_5":15057,"_28736":123161,"_3095":123425},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3708":74021,"_31596":73932,"_21876":123427,"_5":15057,"_28736":123161,"_3095":123428},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3708":74022,"_31596":73932,"_21876":123430,"_5":15057,"_28736":123165,"_3095":123431},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3708":74023,"_31596":73932,"_21876":123433,"_5":15057,"_28736":123165,"_3095":123434},[],"Los modos disponibles son:",{"_3708":74024,"_31596":73932,"_21876":123436,"_5":15057,"_28736":123165,"_3095":123437},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3708":74025,"_31596":73932,"_21876":123439,"_5":15057,"_28736":123165,"_3095":123440},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3708":74026,"_31596":73932,"_21876":123442,"_5":15057,"_28736":123165,"_3095":123443},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3708":74027,"_31596":73932,"_21876":123445,"_5":15057,"_28736":123165,"_3095":123446},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3708":74028,"_31596":73932,"_21876":123448,"_5":15057,"_28736":123165,"_3095":123449},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3708":74029,"_31596":73932,"_21876":123451,"_5":15057,"_28736":123165,"_3095":123452},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3708":74030,"_31596":73932,"_21876":123454,"_5":15057,"_28736":123169,"_3095":123455},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3708":74031,"_31596":73932,"_21876":123457,"_5":15057,"_28736":123169,"_3095":123458},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3708":74032,"_31596":73932,"_21876":123460,"_5":15057,"_28736":123169,"_3095":123461},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3708":74033,"_31596":73932,"_21876":123463,"_5":15057,"_28736":123169,"_3095":123464},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3708":74034,"_31596":73932,"_21876":123466,"_5":15057,"_28736":123177,"_3095":123467},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3708":74035,"_31596":73932,"_21876":123469,"_5":15057,"_28736":123177,"_3095":123470},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3708":74036,"_31596":73932,"_21876":123472,"_5":15057,"_28736":123181,"_3095":123473},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3708":74037,"_31596":73932,"_21876":123475,"_5":15057,"_28736":123181,"_3095":123476},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3708":74038,"_31596":73932,"_21876":123478,"_5":15057,"_28736":123181,"_3095":123479},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3708":74039,"_31596":73932,"_21876":123481,"_5":15057,"_28736":123181,"_3095":123482},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3708":74040,"_31596":73932,"_21876":123484,"_5":15057,"_28736":123181,"_3095":123485},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3708":74041,"_31596":73932,"_21876":123487,"_5":15057,"_28736":123185,"_3095":123488},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3708":74042,"_31596":73932,"_21876":123490,"_5":15057,"_28736":123185,"_3095":123491},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3708":74043,"_31596":73932,"_21876":123493,"_5":15057,"_28736":123185,"_3095":123494},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3708":74044,"_31596":73932,"_21876":123496,"_5":15057,"_28736":123189,"_3095":123497},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3708":74045,"_31596":73932,"_21876":123499,"_5":15057,"_28736":123189,"_3095":123500},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3708":74046,"_31596":73932,"_21876":123502,"_5":15057,"_28736":123189,"_3095":123503},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3708":74047,"_31596":73932,"_21876":123505,"_5":15057,"_28736":123189,"_3095":123506},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3708":74048,"_31596":73932,"_21876":123508,"_5":15057,"_28736":123189,"_3095":123509},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3708":74049,"_31596":73932,"_21876":123511,"_5":15057,"_28736":123189,"_3095":123512},[],"Ten en cuenta que:",{"_3708":74050,"_31596":73932,"_21876":123514,"_5":15057,"_28736":123189,"_3095":123515},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3708":74051,"_31596":73932,"_21876":123517,"_5":15057,"_28736":123189,"_3095":123518},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3708":74052,"_31596":73932,"_21876":123520,"_5":15057,"_28736":123189,"_3095":123521},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3708":74053,"_31596":73932,"_21876":123523,"_5":15057,"_28736":123193,"_3095":123524},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3708":74054,"_31596":73932,"_21876":123526,"_5":15057,"_28736":123193,"_3095":123527},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3708":74055,"_31596":73932,"_21876":123529,"_5":15057,"_28736":123193,"_3095":123530},[],"acceso completo y de solo lectura a KMS;",{"_3708":74056,"_31596":73932,"_21876":123532,"_5":15057,"_28736":123193,"_3095":123533},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3708":74057,"_31596":73932,"_21876":123535,"_5":15057,"_28736":123193,"_3095":123536},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3708":74058,"_31596":73932,"_21876":123538,"_5":15057,"_28736":123193,"_3095":123539},[],"acceso a la interfaz;",{"_3708":74059,"_31596":73932,"_21876":123541,"_5":15057,"_28736":123193,"_3095":123542},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3708":74060,"_31596":73932,"_21876":123544,"_5":15057,"_28736":123193,"_3095":123545},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3708":74061,"_31596":73932,"_21876":123547,"_5":15057,"_28736":123193,"_3095":123548},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3708":74062,"_31596":73932,"_21876":123550,"_5":15057,"_28736":123193,"_3095":123551},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3708":74063,"_31596":73932,"_21876":123553,"_5":15057,"_28736":123193,"_3095":123554},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3708":74064,"_31596":73932,"_21876":123556,"_5":15057,"_28736":123197,"_3095":123557},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3708":74065,"_31596":73932,"_21876":123559,"_5":15057,"_28736":123197,"_3095":123560},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3708":74066,"_31596":73932,"_21876":123562,"_5":15057,"_28736":123197,"_3095":123563},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3708":74067,"_31596":73932,"_21876":123565,"_5":15057,"_28736":123200,"_3095":123566},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3708":74068,"_31596":73932,"_21876":123568,"_5":15057,"_28736":123204,"_3095":123569},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3708":74069,"_31596":73932,"_21876":123571,"_5":15057,"_28736":123204,"_3095":123572},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3708":74070,"_31596":73932,"_21876":123574,"_5":15057,"_28736":123208,"_3095":123575},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3708":74071,"_31596":73932,"_21876":123577,"_5":15057,"_28736":123212,"_3095":123578},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3708":74072,"_31596":73932,"_21876":123580,"_5":15057,"_28736":123216,"_3095":123581},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3708":74073,"_31596":73932,"_21876":123583,"_5":15057,"_28736":123220,"_3095":123584},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3708":74074,"_31596":73932,"_21876":123586,"_5":15057,"_28736":123220,"_3095":123587},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3708":74075,"_31596":73932,"_21876":123589,"_5":15057,"_28736":123224,"_3095":123590},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3708":74076,"_31596":73932,"_21876":123592,"_5":15057,"_28736":123224,"_3095":123593},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3708":74077,"_31596":73932,"_21876":123595,"_5":15057,"_28736":123224,"_3095":123596},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3708":74078,"_31596":73932,"_21876":123598,"_5":15057,"_28736":123224,"_3095":123599},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3708":74079,"_31596":73932,"_21876":123601,"_5":15057,"_28736":123224,"_3095":123602},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3708":74080,"_31596":73932,"_21876":123604,"_5":15057,"_28736":123224,"_3095":123605},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3708":74081,"_31596":73932,"_21876":123607,"_5":15057,"_28736":123224,"_3095":123608},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3708":74082,"_31596":73932,"_21876":123610,"_5":15057,"_28736":123224,"_3095":123611},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3708":74083,"_31596":73932,"_21876":123613,"_5":15057,"_28736":123228,"_3095":123614},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3708":74084,"_31596":73932,"_21876":123616,"_5":15057,"_28736":123228,"_3095":123617},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3708":74085,"_31596":73932,"_21876":123619,"_5":15057,"_28736":123228,"_3095":123620},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3708":74086,"_31596":73932,"_21876":123622,"_5":15057,"_28736":123232,"_3095":123623},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3708":74087,"_31596":73932,"_21876":123625,"_5":15057,"_28736":123232,"_3095":123626},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3708":74088,"_31596":73932,"_21876":123628,"_5":15057,"_28736":123232,"_3095":123629},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3708":74089,"_31596":73932,"_21876":123631,"_5":15057,"_28736":123232,"_3095":123632},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3708":74090,"_31596":73932,"_21876":123634,"_5":15057,"_28736":123232,"_3095":123635},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3708":74091,"_31596":73932,"_21876":123637,"_5":15057,"_28736":123232,"_3095":123638},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3708":74092,"_31596":73932,"_21876":123640,"_5":15057,"_28736":123232,"_3095":123641},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3708":74093,"_31596":73932,"_21876":123643,"_5":15057,"_28736":123232,"_3095":123644},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3708":74094,"_31596":73932,"_21876":123646,"_5":15057,"_28736":123240,"_3095":123647},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3708":74095,"_31596":73932,"_21876":123649,"_5":15057,"_28736":123244,"_3095":123650},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3708":74096,"_31596":73932,"_21876":123652,"_5":15057,"_28736":123244,"_3095":123653},[],"que exista un principal activo del tipo correcto;",{"_3708":74097,"_31596":73932,"_21876":123655,"_5":15057,"_28736":123244,"_3095":123656},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3708":74098,"_31596":73932,"_21876":123658,"_5":15057,"_28736":123244,"_3095":123659},[],"que todas las condiciones del principal se cumplan;",{"_3708":74099,"_31596":73932,"_21876":123661,"_5":15057,"_28736":123244,"_3095":123662},[],"que el principal tenga concedida la política esperada;",{"_3708":74100,"_31596":73932,"_21876":123664,"_5":15057,"_28736":123244,"_3095":123665},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3708":74101,"_31596":73932,"_21876":123667,"_5":15057,"_28736":123244,"_3095":123668},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3708":74102,"_31596":73932,"_21876":123670,"_5":15057,"_28736":123244,"_3095":123671},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3708":74103,"_31596":73932,"_21876":123673,"_5":15057,"_28736":123244,"_3095":123674},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3708":74104,"_31596":73932,"_21876":123676,"_5":15057,"_28736":123248,"_3095":123677},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3708":74105,"_31596":73932,"_21876":123679,"_5":15057,"_28736":123252,"_3095":123680},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3708":74106,"_31596":73932,"_21876":123682,"_5":15057,"_28736":123256,"_3095":123683},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3708":74107,"_31596":73932,"_21876":123685,"_5":15057,"_28736":123256,"_3095":123686},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3708":74108,"_31596":74108,"_5":15417,"_3095":123688,"_31955":123689,"_21876":123690,"_28736":74108},"Alertas y suscripciones",[51485,123023,123024],[],{"_3708":74109,"_31596":74108,"_21876":123692,"_5":15057,"_28736":74108,"_3095":123693},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3708":74110,"_31596":74108,"_5":31952,"_21876":123695,"_28736":123696,"_3095":123697},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3708":74111,"_31596":74108,"_5":31952,"_21876":123699,"_28736":123700,"_3095":123701},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3708":74112,"_31596":74108,"_5":31952,"_21876":123703,"_28736":123704,"_3095":123705},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3708":74113,"_31596":74108,"_5":31952,"_21876":123707,"_28736":123708,"_3095":123709},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3708":74114,"_31596":74108,"_5":31952,"_21876":123711,"_28736":123712,"_3095":123713},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3708":74115,"_31596":74108,"_5":31952,"_21876":123715,"_28736":123716,"_3095":123717},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3708":74116,"_31596":74108,"_5":31952,"_21876":123719,"_28736":123720,"_3095":123721},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3708":74117,"_31596":74108,"_5":31952,"_21876":123723,"_28736":123724,"_3095":123725},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3708":74118,"_31596":74108,"_5":31952,"_21876":123727,"_28736":123728,"_3095":123729},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3708":74119,"_31596":74108,"_5":31952,"_21876":123731,"_28736":123732,"_3095":123733},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3708":74120,"_31596":74108,"_5":31952,"_21876":123735,"_28736":123736,"_3095":123737},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3708":74121,"_31596":74108,"_21876":123739,"_5":15057,"_28736":74108,"_3095":123740},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3708":74122,"_31596":74108,"_21876":123742,"_5":15057,"_28736":123696,"_3095":123743},[],"Un servicio publica un evento de dominio.",{"_3708":74123,"_31596":74108,"_21876":123745,"_5":15057,"_28736":123696,"_3095":123746},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3708":74124,"_31596":74108,"_21876":123748,"_5":15057,"_28736":123696,"_3095":123749},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3708":74125,"_31596":74108,"_21876":123751,"_5":15057,"_28736":123696,"_3095":123752},[],"Lamassu entrega el evento al canal configurado.",{"_3708":74126,"_31596":74108,"_21876":123754,"_5":15057,"_28736":123696,"_3095":123755},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3708":74127,"_31596":74108,"_21876":123757,"_5":15057,"_28736":123700,"_3095":123758},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3708":74128,"_31596":74108,"_21876":123760,"_5":15057,"_28736":123700,"_3095":123761},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3708":74129,"_31596":74108,"_21876":123763,"_5":15057,"_28736":123700,"_3095":123764},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3708":74130,"_31596":74108,"_21876":123766,"_5":15057,"_28736":123700,"_3095":123767},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3708":74131,"_31596":74108,"_21876":123769,"_5":15057,"_28736":123700,"_3095":123770},[],"`apikey_options` necesita `header` y `key`.",{"_3708":74132,"_31596":74108,"_21876":123772,"_5":15057,"_28736":123700,"_3095":123773},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3708":74133,"_31596":74108,"_21876":123775,"_5":15057,"_28736":123700,"_3095":123776},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3708":74134,"_31596":74108,"_21876":123778,"_5":15057,"_28736":123700,"_3095":123779},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3708":74135,"_31596":74108,"_21876":123781,"_5":15057,"_28736":123708,"_3095":123782},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3708":74136,"_31596":74108,"_21876":123784,"_5":15057,"_28736":123712,"_3095":123785},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3708":74137,"_31596":74108,"_21876":123787,"_5":15057,"_28736":123716,"_3095":123788},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3708":74138,"_31596":74108,"_21876":123790,"_5":15057,"_28736":123716,"_3095":123791},[],"**None** notifica todas las instancias del evento.",{"_3708":74139,"_31596":74108,"_21876":123793,"_5":15057,"_28736":123716,"_3095":123794},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3708":74140,"_31596":74108,"_21876":123796,"_5":15057,"_28736":123716,"_3095":123797},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3708":74141,"_31596":74108,"_21876":123799,"_5":15057,"_28736":123716,"_3095":123800},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3708":74142,"_31596":74108,"_21876":123802,"_5":15057,"_28736":123716,"_3095":123803},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3708":74143,"_31596":74108,"_21876":123805,"_5":15057,"_28736":123716,"_3095":123806},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3708":74144,"_31596":74108,"_21876":123808,"_5":15057,"_28736":123720,"_3095":123809},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3708":74145,"_31596":74108,"_21876":123811,"_5":15057,"_28736":123724,"_3095":123812},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3708":74146,"_31596":74108,"_21876":123814,"_5":15057,"_28736":123724,"_3095":123815},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3708":74147,"_31596":74108,"_21876":123817,"_5":15057,"_28736":123724,"_3095":123818},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3708":74148,"_31596":74108,"_21876":123820,"_5":15057,"_28736":123724,"_3095":123821},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3708":74149,"_31596":74108,"_21876":123823,"_5":15057,"_28736":123724,"_3095":123824},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3708":74150,"_31596":74108,"_21876":123826,"_5":15057,"_28736":123724,"_3095":123827},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3708":74151,"_31596":74108,"_21876":123829,"_5":15057,"_28736":123724,"_3095":123830},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3708":74152,"_31596":74108,"_21876":123832,"_5":15057,"_28736":123724,"_3095":123833},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3708":74153,"_31596":74108,"_21876":123835,"_5":15057,"_28736":123728,"_3095":123836},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3708":74154,"_31596":74108,"_21876":123838,"_5":15057,"_28736":123728,"_3095":123839},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3708":74155,"_31596":74108,"_21876":123841,"_5":15057,"_28736":123728,"_3095":123842},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3708":74156,"_31596":74108,"_21876":123844,"_5":15057,"_28736":123728,"_3095":123845},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3708":74157,"_31596":74108,"_21876":123847,"_5":15057,"_28736":123728,"_3095":123848},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3708":74158,"_31596":74108,"_21876":123850,"_5":15057,"_28736":123728,"_3095":123851},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3708":74159,"_31596":74108,"_21876":123853,"_5":15057,"_28736":123728,"_3095":123854},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3708":74160,"_31596":74108,"_21876":123856,"_5":15057,"_28736":123728,"_3095":123857},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3708":74161,"_31596":74108,"_21876":123859,"_5":15057,"_28736":123732,"_3095":123860},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3708":74162,"_31596":74108,"_21876":123862,"_5":15057,"_28736":123732,"_3095":123863},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3708":74163,"_31596":74108,"_21876":123865,"_5":15057,"_28736":123736,"_3095":123866},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3708":74164,"_31596":74108,"_21876":123868,"_5":15057,"_28736":123736,"_3095":123869},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3708":74165,"_31596":74108,"_21876":123871,"_5":15057,"_28736":123736,"_3095":123872},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3708":74166,"_31596":74108,"_21876":123874,"_5":15057,"_28736":123736,"_3095":123875},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3708":74167,"_31596":74108,"_21876":123877,"_5":15057,"_28736":123736,"_3095":123878},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3708":74168,"_31596":74108,"_21876":123880,"_5":15057,"_28736":123736,"_3095":123881},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3708":74169,"_31596":74108,"_21876":123883,"_5":15057,"_28736":123736,"_3095":123884},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3708":74170,"_31596":74108,"_21876":123886,"_5":15057,"_28736":123736,"_3095":123887},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3708":74171,"_31596":74108,"_21876":123889,"_5":15057,"_28736":123736,"_3095":123890},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3708":74172,"_31596":74108,"_21876":123892,"_5":15057,"_28736":123736,"_3095":123893},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3708":74173,"_31596":74173,"_5":15417,"_3095":123895,"_31955":123896,"_21876":123897,"_28736":74173},"Registros de auditoría",[51485,123023,123024],[],{"_3708":74174,"_31596":74173,"_21876":123899,"_5":15057,"_28736":74173,"_3095":123900},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3708":74175,"_31596":74173,"_5":31952,"_21876":123902,"_28736":123903,"_3095":123904},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3708":74176,"_31596":74173,"_5":31952,"_21876":123906,"_28736":123907,"_3095":123908},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3708":74177,"_31596":74173,"_5":31952,"_21876":123910,"_28736":123911,"_3095":123912},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3708":74178,"_31596":74173,"_5":31952,"_21876":123914,"_28736":123915,"_3095":123916},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3708":74179,"_31596":74173,"_5":31952,"_21876":123918,"_28736":123919,"_3095":123920},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3708":74180,"_31596":74173,"_5":31952,"_21876":123922,"_28736":123923,"_3095":123924},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3708":74181,"_31596":74173,"_5":31952,"_21876":123926,"_28736":123927,"_3095":123928},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3708":74182,"_31596":74173,"_5":31952,"_21876":123930,"_28736":123931,"_3095":123932},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3708":74183,"_31596":74173,"_5":31952,"_21876":123934,"_28736":123935,"_3095":123936},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3708":74184,"_31596":74173,"_5":31952,"_21876":123938,"_28736":123939,"_3095":123940},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3708":74185,"_31596":74173,"_5":31952,"_21876":123942,"_28736":123943,"_3095":123944},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3708":74186,"_31596":74173,"_21876":123946,"_5":15057,"_28736":74173,"_3095":123947},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3708":74187,"_31596":74173,"_21876":123949,"_5":15057,"_28736":123903,"_3095":123950},[],"El cuerpo de auditoría incluye:",{"_3708":74188,"_31596":74173,"_21876":123952,"_5":15057,"_28736":123903,"_3095":123953},[],"input: datos recibidos por la operación;",{"_3708":74189,"_31596":74173,"_21876":123955,"_5":15057,"_28736":123903,"_3095":123956},[],"has\\_error: indica si el servicio devolvió un error;",{"_3708":74190,"_31596":74173,"_21876":123958,"_5":15057,"_28736":123903,"_3095":123959},[],"output: resultado producido o mensaje de error;",{"_3708":74191,"_31596":74173,"_21876":123961,"_5":15057,"_28736":123903,"_3095":123962},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3708":74192,"_31596":74173,"_21876":123964,"_5":15057,"_28736":123903,"_3095":123965},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3708":74193,"_31596":74173,"_21876":123967,"_5":15057,"_28736":123903,"_3095":123968},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3708":74194,"_31596":74173,"_21876":123970,"_5":15057,"_28736":123907,"_3095":123971},[],"El backend aplica auditoría a mutaciones de:",{"_3708":74195,"_31596":74173,"_21876":123973,"_5":15057,"_28736":123907,"_3095":123974},[],"autoridades, certificados y perfiles de emisión;",{"_3708":74196,"_31596":74173,"_21876":123976,"_5":15057,"_28736":123907,"_3095":123977},[],"claves y motores KMS;",{"_3708":74197,"_31596":74173,"_21876":123979,"_5":15057,"_28736":123907,"_3095":123980},[],"dispositivos e identidades;",{"_3708":74198,"_31596":74173,"_21876":123982,"_5":15057,"_28736":123907,"_3095":123983},[],"DMS y operaciones de enrolamiento;",{"_3708":74199,"_31596":74173,"_21876":123985,"_5":15057,"_28736":123907,"_3095":123986},[],"funciones de validación y CRL;",{"_3708":74200,"_31596":74173,"_21876":123988,"_5":15057,"_28736":123907,"_3095":123989},[],"principales, políticas y concesiones de autorización.",{"_3708":74201,"_31596":74173,"_21876":123991,"_5":15057,"_28736":123907,"_3095":123992},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3708":74202,"_31596":74173,"_21876":123994,"_5":15057,"_28736":123911,"_3095":123995},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3708":74203,"_31596":74173,"_21876":123997,"_5":15057,"_28736":123911,"_3095":123998},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3708":74204,"_31596":74173,"_21876":124000,"_5":15057,"_28736":123911,"_3095":124001},[],"Diseña el consumidor para:",{"_3708":74205,"_31596":74173,"_21876":124003,"_5":15057,"_28736":123911,"_3095":124004},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3708":74206,"_31596":74173,"_21876":124006,"_5":15057,"_28736":123911,"_3095":124007},[],"conservar el CloudEvent completo sin modificar;",{"_3708":74207,"_31596":74173,"_21876":124009,"_5":15057,"_28736":123911,"_3095":124010},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3708":74208,"_31596":74173,"_21876":124012,"_5":15057,"_28736":123911,"_3095":124013},[],"cifrar en tránsito y en reposo;",{"_3708":74209,"_31596":74173,"_21876":124015,"_5":15057,"_28736":123911,"_3095":124016},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3708":74210,"_31596":74173,"_21876":124018,"_5":15057,"_28736":123911,"_3095":124019},[],"aplicar una política explícita de retención y legal hold;",{"_3708":74211,"_31596":74173,"_21876":124021,"_5":15057,"_28736":123911,"_3095":124022},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3708":74212,"_31596":74173,"_21876":124024,"_5":15057,"_28736":123915,"_3095":124025},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3708":74213,"_31596":74173,"_21876":124027,"_5":15057,"_28736":123915,"_3095":124028},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3708":74214,"_31596":74173,"_21876":124030,"_5":15057,"_28736":123923,"_3095":124031},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3708":74215,"_31596":74173,"_21876":124033,"_5":15057,"_28736":123927,"_3095":124034},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3708":74216,"_31596":74173,"_21876":124036,"_5":15057,"_28736":123931,"_3095":124037},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3708":74217,"_31596":74173,"_21876":124039,"_5":15057,"_28736":123935,"_3095":124040},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3708":74218,"_31596":74173,"_21876":124042,"_5":15057,"_28736":123939,"_3095":124043},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3708":74219,"_31596":74173,"_21876":124045,"_5":15057,"_28736":123943,"_3095":124046},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3708":74220,"_31596":74173,"_21876":124048,"_5":15057,"_28736":123943,"_3095":124049},[],"aparece un evento de auditoría correcto;",{"_3708":74221,"_31596":74173,"_21876":124051,"_5":15057,"_28736":123943,"_3095":124052},[],"el principal coincide con la identidad utilizada;",{"_3708":74222,"_31596":74173,"_21876":124054,"_5":15057,"_28736":123943,"_3095":124055},[],"el consumidor lo persiste una sola vez;",{"_3708":74223,"_31596":74173,"_21876":124057,"_5":15057,"_28736":123943,"_3095":124058},[],"puede recuperarse por recurso, actor y periodo;",{"_3708":74224,"_31596":74173,"_21876":124060,"_5":15057,"_28736":123943,"_3095":124061},[],"una interrupción del consumidor produce una alerta.",{"_3708":74225,"_31596":74173,"_21876":124063,"_5":15057,"_28736":123943,"_3095":124064},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3708":74226,"_31596":74226,"_5":15417,"_3095":124066,"_31955":124067,"_21876":124068,"_28736":74226},"Arquitectura de la plataforma",[51485,123023],[],{"_3708":74227,"_31596":74226,"_21876":124070,"_5":15057,"_28736":74226,"_3095":124071},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3708":74228,"_31596":74226,"_5":31952,"_21876":124073,"_28736":124074,"_3095":124075},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3708":74229,"_31596":74226,"_5":31952,"_21876":124077,"_28736":124078,"_3095":124079},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3708":74230,"_31596":74226,"_5":31952,"_21876":124081,"_28736":124082,"_3095":124083},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3708":74231,"_31596":74226,"_5":31952,"_21876":124085,"_28736":124086,"_3095":124087},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3708":74232,"_31596":74226,"_5":31952,"_21876":124089,"_28736":124090,"_3095":124091},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3708":74233,"_31596":74226,"_21876":124093,"_5":15057,"_28736":74226,"_3095":124094},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3708":74234,"_31596":74226,"_21876":124096,"_5":15057,"_28736":74226,"_3095":124097},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3708":74235,"_31596":74226,"_21876":124099,"_5":15057,"_28736":124074,"_3095":124100},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3708":74236,"_31596":74226,"_21876":124102,"_5":15057,"_28736":124078,"_3095":124103},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3708":74237,"_31596":74226,"_21876":124105,"_5":15057,"_28736":124082,"_3095":124106},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3708":74238,"_31596":74226,"_21876":124108,"_5":15057,"_28736":124086,"_3095":124109},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3708":74239,"_31596":74226,"_21876":124111,"_5":15057,"_28736":124090,"_3095":124112},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3708":74240,"_31596":74240,"_5":15417,"_3095":124114,"_31955":124115,"_21876":124116,"_28736":74240},"Cómo funciona Lamassu",[51485,123023],[],{"_3708":74241,"_31596":74240,"_21876":124118,"_5":15057,"_28736":74240,"_3095":124119},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3708":74242,"_31596":74240,"_5":31952,"_21876":124121,"_28736":124122,"_3095":124123},[],"/docs/pr-preview/pr-78/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3708":74243,"_31596":74240,"_5":31952,"_21876":124125,"_28736":124126,"_3095":124127},[],"/docs/pr-preview/pr-78/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3708":74244,"_31596":74240,"_21876":124129,"_5":15057,"_28736":74240,"_3095":124130},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3708":74245,"_31596":74240,"_21876":124132,"_5":15057,"_28736":124122,"_3095":124133},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3708":74246,"_31596":74240,"_21876":124135,"_5":15057,"_28736":124122,"_3095":124136},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3708":74247,"_31596":74240,"_21876":124138,"_5":15057,"_28736":124122,"_3095":124139},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3708":74248,"_31596":74240,"_21876":124141,"_5":15057,"_28736":124122,"_3095":124142},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3708":74249,"_31596":74240,"_21876":124144,"_5":15057,"_28736":124122,"_3095":124145},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3708":74250,"_31596":74240,"_21876":124147,"_5":15057,"_28736":124126,"_3095":124148},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3708":74251,"_31596":74240,"_21876":124150,"_5":15057,"_28736":124126,"_3095":124151},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3708":74252,"_31596":74240,"_21876":124153,"_5":15057,"_28736":124126,"_3095":124154},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3708":74253,"_31596":74240,"_21876":124156,"_5":15057,"_28736":124126,"_3095":124157},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3708":74254,"_31596":74240,"_21876":124159,"_5":15057,"_28736":124126,"_3095":124160},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3708":74255,"_31596":74240,"_21876":124162,"_5":15057,"_28736":124126,"_3095":124163},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3708":74256,"_31596":74240,"_21876":124165,"_5":15057,"_28736":124126,"_3095":124166},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3708":74257,"_31596":74257,"_5":15417,"_3095":124168,"_31955":124169,"_21876":124170,"_28736":74257},"Dispositivos e identidades",[51485,123023,54195,124168],[],{"_3708":74258,"_31596":74257,"_21876":124172,"_5":15057,"_28736":74257,"_3095":124173},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3708":74259,"_31596":74257,"_5":31952,"_21876":124175,"_28736":124176,"_3095":124177},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3708":74260,"_31596":74257,"_5":31952,"_21876":124179,"_28736":124180,"_3095":124181},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3708":74261,"_31596":74257,"_5":31952,"_21876":124183,"_28736":124184,"_3095":124185},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3708":74262,"_31596":74257,"_5":31952,"_21876":124187,"_28736":124188,"_3095":124189},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3708":74263,"_31596":74257,"_5":31952,"_21876":124191,"_28736":124192,"_3095":124193},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3708":74264,"_31596":74257,"_5":31952,"_21876":124195,"_28736":124196,"_3095":124197},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3708":74265,"_31596":74257,"_5":31952,"_21876":124199,"_28736":124200,"_3095":124201},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3708":74266,"_31596":74257,"_5":31952,"_21876":124203,"_28736":124204,"_3095":124205},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3708":74267,"_31596":74257,"_5":31952,"_21876":124207,"_28736":124208,"_3095":124209},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3708":74268,"_31596":74257,"_5":31952,"_21876":124211,"_28736":124212,"_3095":124213},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3708":74269,"_31596":74257,"_5":31952,"_21876":124215,"_28736":124216,"_3095":124217},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3708":74270,"_31596":74257,"_21876":124219,"_5":15057,"_28736":74257,"_3095":124220},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3708":74271,"_31596":74257,"_21876":124222,"_5":15057,"_28736":74257,"_3095":124223},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3708":74272,"_31596":74257,"_21876":124225,"_5":15057,"_28736":124176,"_3095":124226},[],"Vista operativa",{"_3708":74273,"_31596":74257,"_21876":124228,"_5":15057,"_28736":124176,"_3095":124229},[],"Interpretación",{"_3708":74274,"_31596":74257,"_21876":124231,"_5":15057,"_28736":124176,"_3095":54258},[],{"_3708":74275,"_31596":74257,"_21876":124233,"_5":15057,"_28736":124176,"_3095":124234},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3708":74276,"_31596":74257,"_21876":124236,"_5":15057,"_28736":124176,"_3095":54264},[],{"_3708":74277,"_31596":74257,"_21876":124238,"_5":15057,"_28736":124176,"_3095":124239},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3708":74278,"_31596":74257,"_21876":124241,"_5":15057,"_28736":124176,"_3095":54270},[],{"_3708":74279,"_31596":74257,"_21876":124243,"_5":15057,"_28736":124176,"_3095":124244},[],"La identidad está en la ventana operativa de renovación.",{"_3708":74280,"_31596":74257,"_21876":124246,"_5":15057,"_28736":124176,"_3095":54276},[],{"_3708":74281,"_31596":74257,"_21876":124248,"_5":15057,"_28736":124176,"_3095":124249},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3708":74282,"_31596":74257,"_21876":124251,"_5":15057,"_28736":124176,"_3095":54282},[],{"_3708":74283,"_31596":74257,"_21876":124253,"_5":15057,"_28736":124176,"_3095":124254},[],"La identidad ha vencido.",{"_3708":74284,"_31596":74257,"_21876":124256,"_5":15057,"_28736":124176,"_3095":54288},[],{"_3708":74285,"_31596":74257,"_21876":124258,"_5":15057,"_28736":124176,"_3095":124259},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3708":74286,"_31596":74257,"_21876":124261,"_5":15057,"_28736":124176,"_3095":54294},[],{"_3708":74287,"_31596":74257,"_21876":124263,"_5":15057,"_28736":124176,"_3095":124264},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3708":74288,"_31596":74257,"_21876":124266,"_5":15057,"_28736":124176,"_3095":124267},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3708":74289,"_31596":74257,"_21876":124269,"_5":15057,"_28736":124180,"_3095":124270},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3708":74290,"_31596":74257,"_21876":124272,"_5":15057,"_28736":124180,"_3095":124273},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3708":74291,"_31596":74257,"_21876":124275,"_5":15057,"_28736":124180,"_3095":124276},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. En el modo **Live**, sigue automáticamente los eventos nuevos y los cambios del dispositivo (como el estado o el propietario) sin recargar la página, y muestra un indicador **Connected** o **Disconnected**. Tras una interrupción se reconecta y recupera sin huecos ni duplicados, de modo que **Live** muestra el mismo contenido que una recarga de la página. Cuando las actualizaciones en vivo no pueden usarse — falta de permisos, dispositivo no encontrado o actualizaciones en vivo no habilitadas en el servidor —, la línea de tiempo muestra `Live updates unavailable: ...` con el motivo, y la navegación por el historial (**Load more**) sigue funcionando. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3708":74292,"_31596":74257,"_21876":124278,"_5":15057,"_28736":124180,"_3095":124279},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3708":74293,"_31596":74257,"_21876":124281,"_5":15057,"_28736":124184,"_3095":124282},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3708":74294,"_31596":74257,"_21876":124284,"_5":15057,"_28736":124188,"_3095":124285},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3708":74295,"_31596":74257,"_21876":124287,"_5":15057,"_28736":124192,"_3095":124288},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3708":74296,"_31596":74257,"_21876":124290,"_5":15057,"_28736":124196,"_3095":124291},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3708":74297,"_31596":74257,"_21876":124293,"_5":15057,"_28736":124200,"_3095":124294},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3708":74298,"_31596":74257,"_21876":124296,"_5":15057,"_28736":124200,"_3095":124297},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3708":74299,"_31596":74257,"_21876":124299,"_5":15057,"_28736":124204,"_3095":124300},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3708":74300,"_31596":74257,"_21876":124302,"_5":15057,"_28736":124204,"_3095":124303},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3708":74301,"_31596":74257,"_21876":124305,"_5":15057,"_28736":124204,"_3095":124306},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3708":74302,"_31596":74257,"_21876":124308,"_5":15057,"_28736":124204,"_3095":124309},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3708":74303,"_31596":74257,"_21876":124311,"_5":15057,"_28736":124204,"_3095":124312},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3708":74304,"_31596":74257,"_21876":124314,"_5":15057,"_28736":124204,"_3095":124315},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3708":74305,"_31596":74257,"_21876":124317,"_5":15057,"_28736":124208,"_3095":124318},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3708":74306,"_31596":74257,"_21876":124320,"_5":15057,"_28736":124208,"_3095":124321},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3708":74307,"_31596":74257,"_21876":124323,"_5":15057,"_28736":124208,"_3095":124324},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3708":74308,"_31596":74257,"_21876":124326,"_5":15057,"_28736":124212,"_3095":124327},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3708":74309,"_31596":74257,"_21876":124329,"_5":15057,"_28736":124212,"_3095":124330},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3708":74310,"_31596":74257,"_21876":124332,"_5":15057,"_28736":124212,"_3095":124333},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3708":74311,"_31596":74257,"_21876":124335,"_5":15057,"_28736":124212,"_3095":124336},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3708":74312,"_31596":74257,"_21876":124338,"_5":15057,"_28736":124216,"_3095":124339},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3708":74313,"_31596":74257,"_21876":124341,"_5":15057,"_28736":124216,"_3095":124342},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3708":74314,"_31596":74314,"_5":15417,"_3095":124344,"_31955":124345,"_21876":124347,"_28736":74314},"Identidad inicial y autenticación",[51485,123023,54195,124168,124346],"Enrolamiento con PKI",[],{"_3708":74315,"_31596":74314,"_21876":124349,"_5":15057,"_28736":74314,"_3095":124350},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3708":74316,"_31596":74314,"_5":31952,"_21876":124352,"_28736":124353,"_3095":124354},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3708":74317,"_31596":74314,"_5":31952,"_21876":124356,"_28736":124357,"_3095":124358},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3708":74318,"_31596":74314,"_5":31952,"_21876":124360,"_28736":124361,"_3095":124362},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3708":74319,"_31596":74314,"_5":31952,"_21876":124364,"_28736":124365,"_3095":124366},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3708":74320,"_31596":74314,"_5":31952,"_21876":124368,"_28736":124369,"_3095":124370},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3708":74321,"_31596":74314,"_21876":124372,"_5":15057,"_28736":74314,"_3095":124373},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3708":74322,"_31596":74314,"_21876":124375,"_5":15057,"_28736":124353,"_3095":124376},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3708":74323,"_31596":74314,"_21876":124378,"_5":15057,"_28736":124353,"_3095":124379},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3708":74324,"_31596":74314,"_21876":124381,"_5":15057,"_28736":124357,"_3095":124382},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3708":74325,"_31596":74314,"_21876":124384,"_5":15057,"_28736":124357,"_3095":124385},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3708":74326,"_31596":74314,"_21876":124387,"_5":15057,"_28736":124357,"_3095":124388},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3708":74327,"_31596":74314,"_21876":124390,"_5":15057,"_28736":124361,"_3095":124391},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3708":74328,"_31596":74314,"_21876":124393,"_5":15057,"_28736":124361,"_3095":124394},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3708":74329,"_31596":74314,"_21876":124396,"_5":15057,"_28736":124365,"_3095":124397},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3708":74330,"_31596":74314,"_21876":124399,"_5":15057,"_28736":124365,"_3095":124400},[],"Ejemplo de cuerpo:",{"_3708":74331,"_31596":74314,"_21876":124402,"_5":15057,"_28736":124365,"_3095":124403},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3708":74332,"_31596":74314,"_21876":124405,"_5":15057,"_28736":124365,"_3095":124406},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3708":74333,"_31596":74314,"_21876":124408,"_5":15057,"_28736":124365,"_3095":124409},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3708":74334,"_31596":74314,"_21876":124411,"_5":15057,"_28736":124365,"_3095":124412},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3708":74335,"_31596":74314,"_21876":124414,"_5":15057,"_28736":124369,"_3095":124415},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3708":74336,"_31596":74314,"_21876":124417,"_5":15057,"_28736":124369,"_3095":124418},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3708":74337,"_31596":74314,"_21876":124420,"_5":15057,"_28736":124369,"_3095":124421},[],"Los puntos de distribución CRL descargados se almacenan en caché en memoria en el DMS Manager, indexados por su URL, de modo que las operaciones de enrolamiento y reenrolamiento simultáneas comparten una única descarga. Una lista en caché se reutiliza como máximo durante `crl_cache.max_ttl` (1 hora por defecto) y nunca más allá de su propio `nextUpdate` — o, si la lista no lo tiene, unas 24 horas tras `thisUpdate` conforme a la regla de frescura anterior. Leer una lista en caché no alarga su vida, y su firma se verifica frente al emisor del certificado en cada uso. Una lista caducada, mayor que `crl_cache.max_size_mb` (256 MB por defecto) o cuya descarga falló no se guarda en caché; la siguiente operación la descarga de nuevo. La caché es una configuración del servicio DMS Manager compartida por todos los DMS, no una opción por DMS, y afecta solo a los puntos de distribución CRL — las respuestas OCSP nunca se guardan en caché. Ambos ajustes son claves de la sección `crl_cache` del fichero de configuración del DMS Manager (`max_ttl` como duración, por ejemplo `10m`, y `max_size_mb` como entero); un valor sin definir o `0` usa el valor por defecto, y un valor negativo detiene el servicio al arrancar. La caché no se puede desactivar: para acortar la ventana en la que una revocación recién publicada sigue sin verse, reduce `max_ttl`. El Helm chart de Lamassu no expone `crl_cache` como valor, así que un despliegue con Helm funciona con los valores por defecto salvo que modifiques la configuración renderizada del DMS Manager. Los certificados gestionados por Lamassu no pasan por esta ruta: se comprueban con su estado almacenado y nunca llegan a la vía CRL.",{"_3708":74338,"_31596":74314,"_21876":124423,"_5":15057,"_28736":124369,"_3095":124424},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). Una revocación publicada en una CRL externa recién emitida puede tardar además hasta la ventana de caché — `crl_cache.max_ttl`, 1 hora por defecto — en volverse visible, además del propio ritmo de publicación de los responders. La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3708":74339,"_31596":74314,"_21876":124426,"_5":15057,"_28736":124369,"_3095":124427},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3708":74340,"_31596":74340,"_5":15417,"_3095":124429,"_31955":124430,"_21876":124431,"_28736":74340},"Configura y opera el DMS",[51485,123023,54195,124168,124346],[],{"_3708":74341,"_31596":74340,"_21876":124433,"_5":15057,"_28736":74340,"_3095":124434},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3708":74342,"_31596":74340,"_5":31952,"_21876":124436,"_28736":124437,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3708":74343,"_31596":74340,"_5":31952,"_21876":124439,"_28736":124440,"_3095":124441},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3708":74344,"_31596":74340,"_5":31952,"_21876":124443,"_28736":124444,"_3095":124445},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3708":74345,"_31596":74340,"_5":31952,"_21876":124447,"_28736":124448,"_3095":124449},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3708":74346,"_31596":74340,"_5":31952,"_21876":124451,"_28736":124452,"_3095":124453},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3708":74347,"_31596":74340,"_5":31952,"_21876":124455,"_28736":124456,"_3095":124457},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3708":74348,"_31596":74340,"_5":31952,"_21876":124459,"_28736":124460,"_3095":124461},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3708":74349,"_31596":74340,"_5":31952,"_21876":124463,"_28736":124464,"_3095":124465},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3708":74350,"_31596":74340,"_5":31952,"_21876":124467,"_28736":124468,"_3095":54502},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3708":74351,"_31596":74340,"_5":31952,"_21876":124470,"_28736":124471,"_3095":54506},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3708":74352,"_31596":74340,"_5":31952,"_21876":124473,"_28736":124474,"_3095":124475},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3708":74353,"_31596":74340,"_5":31952,"_21876":124477,"_28736":124478,"_3095":124479},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3708":74354,"_31596":74340,"_5":31952,"_21876":124481,"_28736":124482,"_3095":124483},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3708":74355,"_31596":74340,"_5":31952,"_21876":124485,"_28736":124486,"_3095":124487},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3708":74356,"_31596":74340,"_5":31952,"_21876":124489,"_28736":124490,"_3095":54526},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3708":74357,"_31596":74340,"_5":31952,"_21876":124492,"_28736":124493,"_3095":124494},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3708":74358,"_31596":74340,"_5":31952,"_21876":124496,"_28736":124497,"_3095":124498},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3708":74359,"_31596":74340,"_5":31952,"_21876":124500,"_28736":124501,"_3095":124502},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3708":74360,"_31596":74340,"_21876":124504,"_5":15057,"_28736":74340,"_3095":124505},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3708":74361,"_31596":74340,"_21876":124507,"_5":15057,"_28736":124437,"_3095":124508},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3708":74362,"_31596":74340,"_21876":124510,"_5":15057,"_28736":124437,"_3095":124511},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3708":74363,"_31596":74340,"_21876":124513,"_5":15057,"_28736":124444,"_3095":124514},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3708":74364,"_31596":74340,"_21876":124516,"_5":15057,"_28736":124448,"_3095":124517},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3708":74365,"_31596":74340,"_21876":124519,"_5":15057,"_28736":124452,"_3095":124520},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3708":74366,"_31596":74340,"_21876":124522,"_5":15057,"_28736":124456,"_3095":124523},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3708":74367,"_31596":74340,"_21876":124525,"_5":15057,"_28736":124460,"_3095":124526},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3708":74368,"_31596":74340,"_21876":124528,"_5":15057,"_28736":124468,"_3095":124529},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3708":74369,"_31596":74340,"_21876":124531,"_5":15057,"_28736":124468,"_3095":124532},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3708":74370,"_31596":74340,"_21876":124534,"_5":15057,"_28736":124471,"_3095":124535},[],"Campo de `settings.enrollment_settings`",{"_3708":74371,"_31596":74340,"_21876":124537,"_5":15057,"_28736":124471,"_3095":124538},[],"Decisión",{"_3708":74372,"_31596":74340,"_21876":124540,"_5":15057,"_28736":124471,"_3095":54577},[],{"_3708":74373,"_31596":74340,"_21876":124542,"_5":15057,"_28736":124471,"_3095":124543},[],"`EST_RFC7030` para estas operaciones.",{"_3708":74374,"_31596":74340,"_21876":124545,"_5":15057,"_28736":124471,"_3095":54583},[],{"_3708":74375,"_31596":74340,"_21876":124547,"_5":15057,"_28736":124471,"_3095":124548},[],"ID de la CA que firmará.",{"_3708":74376,"_31596":74340,"_21876":124550,"_5":15057,"_28736":124471,"_3095":54589},[],{"_3708":74377,"_31596":74340,"_21876":124552,"_5":15057,"_28736":124471,"_3095":124553},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3708":74378,"_31596":74340,"_21876":124555,"_5":15057,"_28736":124471,"_3095":54595},[],{"_3708":74379,"_31596":74340,"_21876":124557,"_5":15057,"_28736":124471,"_3095":124558},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3708":74380,"_31596":74340,"_21876":124560,"_5":15057,"_28736":124471,"_3095":54601},[],{"_3708":74381,"_31596":74340,"_21876":124562,"_5":15057,"_28736":124471,"_3095":124563},[],"Uno de los cuatro modos de autenticación.",{"_3708":74382,"_31596":74340,"_21876":124565,"_5":15057,"_28736":124471,"_3095":124566},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3708":74383,"_31596":74340,"_21876":124568,"_5":15057,"_28736":124474,"_3095":124569},[],"Los bloques son independientes:",{"_3708":74384,"_31596":74340,"_21876":124571,"_5":15057,"_28736":124474,"_3095":124572},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3708":74385,"_31596":74340,"_21876":124574,"_5":15057,"_28736":124474,"_3095":124575},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3708":74386,"_31596":74340,"_21876":124577,"_5":15057,"_28736":124474,"_3095":54619},[],{"_3708":74387,"_31596":74340,"_21876":124579,"_5":15057,"_28736":124474,"_3095":124580},[],"Control aplicado en la operación configurada",{"_3708":74388,"_31596":74340,"_21876":124582,"_5":15057,"_28736":124474,"_3095":54625},[],{"_3708":74389,"_31596":74340,"_21876":124584,"_5":15057,"_28736":124474,"_3095":124585},[],"Validación del certificado presentado.",{"_3708":74390,"_31596":74340,"_21876":124587,"_5":15057,"_28736":124474,"_3095":54631},[],{"_3708":74391,"_31596":74340,"_21876":124589,"_5":15057,"_28736":124474,"_3095":124590},[],"Autorización del webhook configurado.",{"_3708":74392,"_31596":74340,"_21876":124592,"_5":15057,"_28736":124474,"_3095":54637},[],{"_3708":74393,"_31596":74340,"_21876":124594,"_5":15057,"_28736":124474,"_3095":124595},[],"Validación del certificado y, después, aprobación del webhook.",{"_3708":74394,"_31596":74340,"_21876":124597,"_5":15057,"_28736":124474,"_3095":54643},[],{"_3708":74395,"_31596":74340,"_21876":124599,"_5":15057,"_28736":124474,"_3095":124600},[],"Sin autenticación del solicitante por el DMS.",{"_3708":74396,"_31596":74340,"_21876":124602,"_5":15057,"_28736":124474,"_3095":124603},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3708":74397,"_31596":74340,"_21876":124605,"_5":15057,"_28736":124474,"_3095":124606},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3708":74398,"_31596":74340,"_21876":124608,"_5":15057,"_28736":124474,"_3095":124609},[],"El editor de autenticación ofrece el interruptor **Allow certificates without revocation information** (`allow_unverifiable_revocation`, desactivado por defecto). Cuando está activado, se aceptan certificados — y CAs intermedias de la cadena — que Lamassu no gestiona y que no declaran ningún endpoint OCSP o CRL; las respuestas de revocación inaccesibles, obsoletas o no concluyentes se rechazan siempre. Mientras el interruptor esté activado, la consola muestra una alerta de aviso: **Revocation will not be verified** — un certificado revocado sin endpoint OCSP o CRL, y no gestionado por Lamassu, será aceptado, y esto se aplica también a las CAs intermedias de la cadena.",{"_3708":74399,"_31596":74340,"_21876":124611,"_5":15057,"_28736":124474,"_3095":124612},[],"El mismo interruptor se ofrece tanto en el editor de autenticación de enrolamiento como en el de reenrolamiento, y se almacena por bloque dentro de `est_rfc7030_settings.client_certificate_settings`; un DMS almacenado antes de que existiera el campo se carga con el interruptor desactivado. La consola también muestra una alerta de aviso siempre que una opción de autenticación esté en su estado inseguro — **Allow expired certificates** activado, **Allow expired renewal** activado o **Verify CSR signature** desactivado — y la nota de No authentication se presenta también como alerta de aviso.",{"_3708":74400,"_31596":74340,"_21876":124614,"_5":15057,"_28736":124474,"_3095":124615},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones. Las listas CRL descargadas para estas comprobaciones se reutilizan durante un tiempo limitado antes de volver a descargarse; consulta Revocación y comprobaciones para conocer la ventana de caché y su efecto sobre la visibilidad de una revocación.",{"_3708":74401,"_31596":74340,"_21876":124617,"_5":15057,"_28736":124474,"_3095":124618},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3708":74402,"_31596":74340,"_21876":124620,"_5":15057,"_28736":124474,"_3095":124621},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3708":74403,"_31596":74340,"_21876":124623,"_5":15057,"_28736":124478,"_3095":124624},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3708":74404,"_31596":74340,"_21876":124626,"_5":15057,"_28736":124478,"_3095":124627},[],"Campo de `external_webhook_settings`",{"_3708":74405,"_31596":74340,"_21876":124629,"_5":15057,"_28736":124478,"_3095":124538},[],{"_3708":74406,"_31596":74340,"_21876":124631,"_5":15057,"_28736":124478,"_3095":54678},[],{"_3708":74407,"_31596":74340,"_21876":124633,"_5":15057,"_28736":124478,"_3095":124634},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3708":74408,"_31596":74340,"_21876":124636,"_5":15057,"_28736":124478,"_3095":54684},[],{"_3708":74409,"_31596":74340,"_21876":124638,"_5":15057,"_28736":124478,"_3095":124639},[],"`POST` o `PUT`; `POST` por defecto.",{"_3708":74410,"_31596":74340,"_21876":124641,"_5":15057,"_28736":124478,"_3095":54690},[],{"_3708":74411,"_31596":74340,"_21876":124643,"_5":15057,"_28736":124478,"_3095":124644},[],"Etiqueta usada en los logs del servicio.",{"_3708":74412,"_31596":74340,"_21876":124646,"_5":15057,"_28736":124478,"_3095":54696},[],{"_3708":74413,"_31596":74340,"_21876":124648,"_5":15057,"_28736":124478,"_3095":124649},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3708":74414,"_31596":74340,"_21876":124651,"_5":15057,"_28736":124478,"_3095":54702},[],{"_3708":74415,"_31596":74340,"_21876":124653,"_5":15057,"_28736":124478,"_3095":124654},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3708":74416,"_31596":74340,"_21876":124656,"_5":15057,"_28736":124478,"_3095":54708},[],{"_3708":74417,"_31596":74340,"_21876":124658,"_5":15057,"_28736":124478,"_3095":124659},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3708":74418,"_31596":74340,"_21876":124661,"_5":15057,"_28736":124478,"_3095":54714},[],{"_3708":74419,"_31596":74340,"_21876":124663,"_5":15057,"_28736":124478,"_3095":124664},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3708":74420,"_31596":74340,"_21876":124666,"_5":15057,"_28736":124478,"_3095":54720},[],{"_3708":74421,"_31596":74340,"_21876":124668,"_5":15057,"_28736":124478,"_3095":124669},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3708":74422,"_31596":74340,"_21876":124671,"_5":15057,"_28736":124478,"_3095":54726},[],{"_3708":74423,"_31596":74340,"_21876":124673,"_5":15057,"_28736":124478,"_3095":124674},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3708":74424,"_31596":74340,"_21876":124676,"_5":15057,"_28736":124478,"_3095":54732},[],{"_3708":74425,"_31596":74340,"_21876":124678,"_5":15057,"_28736":124478,"_3095":124679},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3708":74426,"_31596":74340,"_21876":124681,"_5":15057,"_28736":124478,"_3095":124682},[],"Reglas de esa configuración:",{"_3708":74427,"_31596":74340,"_21876":124684,"_5":15057,"_28736":124478,"_3095":124685},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3708":74428,"_31596":74340,"_21876":124687,"_5":15057,"_28736":124478,"_3095":124688},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3708":74429,"_31596":74340,"_21876":124690,"_5":15057,"_28736":124478,"_3095":124691},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3708":74430,"_31596":74340,"_21876":124693,"_5":15057,"_28736":124478,"_3095":124694},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3708":74431,"_31596":74340,"_21876":124696,"_5":15057,"_28736":124478,"_3095":124697},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3708":74432,"_31596":74340,"_21876":124699,"_5":15057,"_28736":124478,"_3095":124700},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3708":74433,"_31596":74340,"_21876":124702,"_5":15057,"_28736":124478,"_3095":124703},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3708":74434,"_31596":74340,"_21876":124705,"_5":15057,"_28736":124478,"_3095":124706},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3708":74435,"_31596":74340,"_21876":124708,"_5":15057,"_28736":124478,"_3095":124709},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3708":74436,"_31596":74340,"_21876":124711,"_5":15057,"_28736":124482,"_3095":124712},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3708":74437,"_31596":74340,"_21876":124714,"_5":15057,"_28736":124486,"_3095":124715},[],"Campo de `settings.reenrollment_settings`",{"_3708":74438,"_31596":74340,"_21876":124717,"_5":15057,"_28736":124486,"_3095":124718},[],"Función",{"_3708":74439,"_31596":74340,"_21876":124720,"_5":15057,"_28736":124486,"_3095":54776},[],{"_3708":74440,"_31596":74340,"_21876":124722,"_5":15057,"_28736":124486,"_3095":124723},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3708":74441,"_31596":74340,"_21876":124725,"_5":15057,"_28736":124486,"_3095":54782},[],{"_3708":74442,"_31596":74340,"_21876":124727,"_5":15057,"_28736":124486,"_3095":124728},[],"Umbral operativo preventivo de monitorización.",{"_3708":74443,"_31596":74340,"_21876":124730,"_5":15057,"_28736":124486,"_3095":54788},[],{"_3708":74444,"_31596":74340,"_21876":124732,"_5":15057,"_28736":124486,"_3095":124733},[],"Umbral operativo crítico de monitorización.",{"_3708":74445,"_31596":74340,"_21876":124735,"_5":15057,"_28736":124486,"_3095":54794},[],{"_3708":74446,"_31596":74340,"_21876":124737,"_5":15057,"_28736":124486,"_3095":124738},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3708":74447,"_31596":74340,"_21876":124740,"_5":15057,"_28736":124486,"_3095":54800},[],{"_3708":74448,"_31596":74340,"_21876":124742,"_5":15057,"_28736":124486,"_3095":124743},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3708":74449,"_31596":74340,"_21876":124745,"_5":15057,"_28736":124486,"_3095":54806},[],{"_3708":74450,"_31596":74340,"_21876":124747,"_5":15057,"_28736":124486,"_3095":124748},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3708":74451,"_31596":74340,"_21876":124750,"_5":15057,"_28736":124486,"_3095":124751},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3708":74452,"_31596":74340,"_21876":124753,"_5":15057,"_28736":124490,"_3095":124754},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3708":74453,"_31596":74340,"_21876":124756,"_5":15057,"_28736":124493,"_3095":121895},[],{"_3708":74454,"_31596":74340,"_21876":124758,"_5":15057,"_28736":124493,"_3095":124759},[],"Qué publica",{"_3708":74455,"_31596":74340,"_21876":124761,"_5":15057,"_28736":124493,"_3095":54823},[],{"_3708":74456,"_31596":74340,"_21876":124763,"_5":15057,"_28736":124493,"_3095":124764},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3708":74457,"_31596":74340,"_21876":124766,"_5":15057,"_28736":124493,"_3095":54829},[],{"_3708":74458,"_31596":74340,"_21876":124768,"_5":15057,"_28736":124493,"_3095":124769},[],"Certificado de la CA emisora seleccionada.",{"_3708":74459,"_31596":74340,"_21876":124771,"_5":15057,"_28736":124493,"_3095":54835},[],{"_3708":74460,"_31596":74340,"_21876":124773,"_5":15057,"_28736":124493,"_3095":124774},[],"Certificados de las CAs elegidas explícitamente.",{"_3708":74461,"_31596":74340,"_21876":124776,"_5":15057,"_28736":124493,"_3095":124777},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3708":74462,"_31596":74340,"_21876":124779,"_5":15057,"_28736":124497,"_3095":124780},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3708":74463,"_31596":74340,"_21876":124782,"_5":15057,"_28736":124497,"_3095":124783},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3708":74464,"_31596":74340,"_21876":124785,"_5":15057,"_28736":124497,"_3095":124786},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3708":74465,"_31596":74340,"_21876":124788,"_5":15057,"_28736":124501,"_3095":124789},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3708":74466,"_31596":74466,"_5":15417,"_3095":124791,"_31955":124792,"_21876":124793,"_28736":74466},"Integra el cliente EST",[51485,123023,54195,124168,124346],[],{"_3708":74467,"_31596":74466,"_21876":124795,"_5":15057,"_28736":74466,"_3095":124796},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3708":74468,"_31596":74466,"_5":31952,"_21876":124798,"_28736":124799,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3708":74469,"_31596":74466,"_5":31952,"_21876":124801,"_28736":124802,"_3095":124803},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3708":74470,"_31596":74466,"_5":31952,"_21876":124805,"_28736":124806,"_3095":124807},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3708":74471,"_31596":74466,"_5":31952,"_21876":124809,"_28736":124810,"_3095":124811},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3708":74472,"_31596":74466,"_5":31952,"_21876":124813,"_28736":124814,"_3095":124815},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3708":74473,"_31596":74466,"_5":31952,"_21876":124817,"_28736":124818,"_3095":124819},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3708":74474,"_31596":74466,"_21876":124821,"_5":15057,"_28736":74466,"_3095":124822},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3708":74475,"_31596":74466,"_21876":124824,"_5":15057,"_28736":124799,"_3095":124825},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3708":74476,"_31596":74466,"_21876":124827,"_5":15057,"_28736":124799,"_3095":124828},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3708":74477,"_31596":74466,"_21876":124830,"_5":15057,"_28736":124799,"_3095":124831},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3708":74478,"_31596":74466,"_21876":124833,"_5":15057,"_28736":124802,"_3095":124834},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3708":74479,"_31596":74466,"_21876":124836,"_5":15057,"_28736":124802,"_3095":124837},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3708":74480,"_31596":74466,"_21876":124839,"_5":15057,"_28736":124806,"_3095":124840},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3708":74481,"_31596":74466,"_21876":124842,"_5":15057,"_28736":124806,"_3095":124843},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3708":74482,"_31596":74466,"_21876":124845,"_5":15057,"_28736":124810,"_3095":124846},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3708":74483,"_31596":74466,"_21876":124848,"_5":15057,"_28736":124810,"_3095":124849},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3708":74484,"_31596":74466,"_21876":124851,"_5":15057,"_28736":124814,"_3095":124852},[],"Para el caso de una raíz que emite directamente:",{"_3708":74485,"_31596":74466,"_21876":124854,"_5":15057,"_28736":124814,"_3095":124855},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3708":74486,"_31596":74466,"_21876":124857,"_5":15057,"_28736":124814,"_3095":124858},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3708":74487,"_31596":74466,"_21876":124860,"_5":15057,"_28736":124818,"_3095":124861},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3708":74488,"_31596":74488,"_5":15417,"_3095":124863,"_31955":124864,"_21876":124865,"_28736":74488},"Referencia EST",[51485,123023,54195,124168,124346],[],{"_3708":74489,"_31596":74488,"_21876":124867,"_5":15057,"_28736":74488,"_3095":124868},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3708":74490,"_31596":74488,"_5":31952,"_21876":124870,"_28736":124871,"_3095":124872},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3708":74491,"_31596":74488,"_5":31952,"_21876":124874,"_28736":124875,"_3095":23685},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3708":74492,"_31596":74488,"_5":31952,"_21876":124877,"_28736":124878,"_3095":27222},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3708":74493,"_31596":74488,"_5":31952,"_21876":124880,"_28736":124881,"_3095":27229},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3708":74494,"_31596":74488,"_5":31952,"_21876":124883,"_28736":124884,"_3095":26486},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3708":74495,"_31596":74488,"_5":31952,"_21876":124886,"_28736":124887,"_3095":124888},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3708":74496,"_31596":74488,"_5":31952,"_21876":124890,"_28736":124891,"_3095":124892},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3708":74497,"_31596":74488,"_5":31952,"_21876":124894,"_28736":124895,"_3095":124896},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3708":74498,"_31596":74488,"_21876":124898,"_5":15057,"_28736":74488,"_3095":124899},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3708":74499,"_31596":74488,"_21876":124901,"_5":15057,"_28736":124871,"_3095":124902},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3708":74500,"_31596":74488,"_21876":124904,"_5":15057,"_28736":124871,"_3095":122783},[],{"_3708":74501,"_31596":74488,"_21876":124906,"_5":15057,"_28736":124871,"_3095":124907},[],"Método",{"_3708":74502,"_31596":74488,"_21876":124909,"_5":15057,"_28736":124871,"_3095":124910},[],"Autenticación y condición",{"_3708":74503,"_31596":74488,"_21876":124912,"_5":15057,"_28736":124871,"_3095":54978},[],{"_3708":74504,"_31596":74488,"_21876":124914,"_5":15057,"_28736":124871,"_3095":54981},[],{"_3708":74505,"_31596":74488,"_21876":124916,"_5":15057,"_28736":124871,"_3095":124917},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3708":74506,"_31596":74488,"_21876":124919,"_5":15057,"_28736":124871,"_3095":54987},[],{"_3708":74507,"_31596":74488,"_21876":124921,"_5":15057,"_28736":124871,"_3095":54990},[],{"_3708":74508,"_31596":74488,"_21876":124923,"_5":15057,"_28736":124871,"_3095":124924},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3708":74509,"_31596":74488,"_21876":124926,"_5":15057,"_28736":124871,"_3095":54996},[],{"_3708":74510,"_31596":74488,"_21876":124928,"_5":15057,"_28736":124871,"_3095":54990},[],{"_3708":74511,"_31596":74488,"_21876":124930,"_5":15057,"_28736":124871,"_3095":124931},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3708":74512,"_31596":74488,"_21876":124933,"_5":15057,"_28736":124871,"_3095":55004},[],{"_3708":74513,"_31596":74488,"_21876":124935,"_5":15057,"_28736":124871,"_3095":54990},[],{"_3708":74514,"_31596":74488,"_21876":124937,"_5":15057,"_28736":124871,"_3095":124938},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3708":74515,"_31596":74488,"_21876":124940,"_5":15057,"_28736":124871,"_3095":124941},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3708":74516,"_31596":74488,"_21876":124943,"_5":15057,"_28736":124875,"_3095":124944},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3708":74517,"_31596":74488,"_21876":124946,"_5":15057,"_28736":124875,"_3095":124947},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3708":74518,"_31596":74488,"_21876":124949,"_5":15057,"_28736":124878,"_3095":124950},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3708":74519,"_31596":74488,"_21876":124952,"_5":15057,"_28736":124878,"_3095":124953},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3708":74520,"_31596":74488,"_21876":124955,"_5":15057,"_28736":124881,"_3095":124956},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3708":74521,"_31596":74488,"_21876":124958,"_5":15057,"_28736":124881,"_3095":124959},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3708":74522,"_31596":74488,"_21876":124961,"_5":15057,"_28736":124884,"_3095":124962},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3708":74523,"_31596":74488,"_21876":124964,"_5":15057,"_28736":124884,"_3095":124965},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3708":74524,"_31596":74488,"_21876":124967,"_5":15057,"_28736":124887,"_3095":124968},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3708":74525,"_31596":74488,"_21876":124970,"_5":15057,"_28736":124887,"_3095":124971},[],"Parte",{"_3708":74526,"_31596":74488,"_21876":124973,"_5":15057,"_28736":124887,"_3095":124974},[],"Contenido tras decodificar su Base64",{"_3708":74527,"_31596":74488,"_21876":124976,"_5":15057,"_28736":124887,"_3095":55048},[],{"_3708":74528,"_31596":74488,"_21876":124978,"_5":15057,"_28736":124887,"_3095":124979},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3708":74529,"_31596":74488,"_21876":124981,"_5":15057,"_28736":124887,"_3095":55054},[],{"_3708":74530,"_31596":74488,"_21876":124983,"_5":15057,"_28736":124887,"_3095":124984},[],"PKCS#7 DER con el certificado emitido.",{"_3708":74531,"_31596":74488,"_21876":124986,"_5":15057,"_28736":124887,"_3095":124987},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3708":74532,"_31596":74488,"_21876":124989,"_5":15057,"_28736":124891,"_3095":124990},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3708":74533,"_31596":74488,"_21876":124992,"_5":15057,"_28736":124891,"_3095":124993},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3708":74534,"_31596":74488,"_21876":124995,"_5":15057,"_28736":124891,"_3095":124996},[],"Convierte y comprueba el resultado:",{"_3708":74535,"_31596":74488,"_21876":124998,"_5":15057,"_28736":124891,"_3095":124999},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3708":74536,"_31596":74488,"_21876":125001,"_5":15057,"_28736":124895,"_3095":125002},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3708":74537,"_31596":74488,"_21876":125004,"_5":15057,"_28736":124895,"_3095":125005},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3708":74538,"_31596":74538,"_5":15417,"_3095":124346,"_31955":125007,"_21876":125008,"_28736":74538},[51485,123023,54195,124168,124346],[],{"_3708":74539,"_31596":74538,"_21876":125010,"_5":15057,"_28736":74538,"_3095":125011},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3708":74540,"_31596":74538,"_5":31952,"_21876":125013,"_28736":125014,"_3095":125015},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3708":74541,"_31596":74538,"_5":31952,"_21876":125017,"_28736":125018,"_3095":125019},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3708":74542,"_31596":74538,"_5":31952,"_21876":125021,"_28736":125022,"_3095":125023},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3708":74543,"_31596":74538,"_21876":125025,"_5":15057,"_28736":74538,"_3095":125026},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3708":74544,"_31596":74538,"_21876":125028,"_5":15057,"_28736":125014,"_3095":125029},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3708":74545,"_31596":74538,"_21876":125031,"_5":15057,"_28736":125014,"_3095":125032},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3708":74546,"_31596":74538,"_21876":125034,"_5":15057,"_28736":125014,"_3095":125035},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3708":74547,"_31596":74538,"_21876":125037,"_5":15057,"_28736":125014,"_3095":125038},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3708":74548,"_31596":74538,"_21876":125040,"_5":15057,"_28736":125014,"_3095":125041},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3708":74549,"_31596":74538,"_21876":125043,"_5":15057,"_28736":125014,"_3095":125044},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3708":74550,"_31596":74538,"_21876":125046,"_5":15057,"_28736":125018,"_3095":125047},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3708":74551,"_31596":74538,"_21876":125049,"_5":15057,"_28736":125018,"_3095":125050},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3708":74552,"_31596":74538,"_21876":125052,"_5":15057,"_28736":125018,"_3095":125053},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3708":74553,"_31596":74538,"_21876":125055,"_5":15057,"_28736":125018,"_3095":125056},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3708":74554,"_31596":74538,"_21876":125058,"_5":15057,"_28736":125022,"_3095":125059},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3708":74555,"_31596":74538,"_21876":125061,"_5":15057,"_28736":125022,"_3095":125062},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3708":74556,"_31596":74538,"_21876":125064,"_5":15057,"_28736":125022,"_3095":125065},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3708":74557,"_31596":74538,"_21876":125067,"_5":15057,"_28736":125022,"_3095":125068},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3708":74558,"_31596":74538,"_21876":125070,"_5":15057,"_28736":125022,"_3095":125071},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3708":74559,"_31596":74559,"_5":15417,"_3095":125073,"_31955":125074,"_21876":125075,"_28736":74559},"Estrategias de aprovisionamiento",[51485,123023,54195,124168,124346],[],{"_3708":74560,"_31596":74559,"_21876":125077,"_5":15057,"_28736":74559,"_3095":125078},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3708":74561,"_31596":74559,"_5":31952,"_21876":125080,"_28736":125081,"_3095":125082},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3708":74562,"_31596":74559,"_5":31952,"_21876":125084,"_28736":125085,"_3095":125086},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3708":74563,"_31596":74559,"_5":31952,"_21876":125088,"_28736":125089,"_3095":125090},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3708":74564,"_31596":74559,"_5":31952,"_21876":125092,"_28736":125093,"_3095":125094},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3708":74565,"_31596":74559,"_5":31952,"_21876":125096,"_28736":125097,"_3095":125098},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3708":74566,"_31596":74559,"_21876":125100,"_5":15057,"_28736":74559,"_3095":125101},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3708":74567,"_31596":74559,"_21876":125103,"_5":15057,"_28736":125081,"_3095":125104},[],"Recorrido",{"_3708":74568,"_31596":74559,"_21876":125106,"_5":15057,"_28736":125081,"_3095":125107},[],"Cuándo existe el dispositivo",{"_3708":74569,"_31596":74559,"_21876":125109,"_5":15057,"_28736":125081,"_3095":125110},[],"Qué compruebas",{"_3708":74570,"_31596":74559,"_21876":125112,"_5":15057,"_28736":125081,"_3095":125113},[],"Asignación manual",{"_3708":74571,"_31596":74559,"_21876":125115,"_5":15057,"_28736":125081,"_3095":125116},[],"El operador lo crea antes de asociar un certificado.",{"_3708":74572,"_31596":74559,"_21876":125118,"_5":15057,"_28736":125081,"_3095":125119},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3708":74573,"_31596":74559,"_21876":125121,"_5":15057,"_28736":125081,"_3095":125122},[],"EST con `JITP`",{"_3708":74574,"_31596":74559,"_21876":125124,"_5":15057,"_28736":125081,"_3095":125125},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3708":74575,"_31596":74559,"_21876":125127,"_5":15057,"_28736":125081,"_3095":125128},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3708":74576,"_31596":74559,"_21876":125130,"_5":15057,"_28736":125081,"_3095":125131},[],"EST con `PRE_REGISTRATION`",{"_3708":74577,"_31596":74559,"_21876":125133,"_5":15057,"_28736":125081,"_3095":125134},[],"Debe existir antes de `/simpleenroll`.",{"_3708":74578,"_31596":74559,"_21876":125136,"_5":15057,"_28736":125081,"_3095":125137},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3708":74579,"_31596":74559,"_21876":125139,"_5":15057,"_28736":125081,"_3095":125140},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3708":74580,"_31596":74559,"_21876":125142,"_5":15057,"_28736":125081,"_3095":125143},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3708":74581,"_31596":74559,"_21876":125145,"_5":15057,"_28736":125085,"_3095":125146},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3708":74582,"_31596":74559,"_21876":125148,"_5":15057,"_28736":125085,"_3095":125149},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3708":74583,"_31596":74559,"_21876":125151,"_5":15057,"_28736":125085,"_3095":125152},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3708":74584,"_31596":74559,"_21876":125154,"_5":15057,"_28736":125089,"_3095":125155},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3708":74585,"_31596":74559,"_21876":125157,"_5":15057,"_28736":125089,"_3095":125158},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3708":74586,"_31596":74559,"_21876":125160,"_5":15057,"_28736":125089,"_3095":125161},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3708":74587,"_31596":74559,"_21876":125163,"_5":15057,"_28736":125089,"_3095":125164},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3708":74588,"_31596":74559,"_21876":125166,"_5":15057,"_28736":125089,"_3095":125167},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3708":74589,"_31596":74559,"_21876":125169,"_5":15057,"_28736":125089,"_3095":125170},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3708":74590,"_31596":74559,"_21876":125172,"_5":15057,"_28736":125093,"_3095":121895},[],{"_3708":74591,"_31596":74559,"_21876":125174,"_5":15057,"_28736":125093,"_3095":125175},[],"Material que atraviesa EST",{"_3708":74592,"_31596":74559,"_21876":125177,"_5":15057,"_28736":125093,"_3095":125178},[],"Clave generada por el dispositivo",{"_3708":74593,"_31596":74559,"_21876":125180,"_5":15057,"_28736":125093,"_3095":125181},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3708":74594,"_31596":74559,"_21876":125183,"_5":15057,"_28736":125093,"_3095":125184},[],"Clave ya disponible en el dispositivo",{"_3708":74595,"_31596":74559,"_21876":125186,"_5":15057,"_28736":125093,"_3095":125187},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3708":74596,"_31596":74559,"_21876":125189,"_5":15057,"_28736":125093,"_3095":54526},[],{"_3708":74597,"_31596":74559,"_21876":125191,"_5":15057,"_28736":125093,"_3095":125192},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3708":74598,"_31596":74559,"_21876":125194,"_5":15057,"_28736":125093,"_3095":125195},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3708":74599,"_31596":74559,"_21876":125197,"_5":15057,"_28736":125097,"_3095":125198},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3708":74600,"_31596":74600,"_5":15417,"_3095":125200,"_31955":125201,"_21876":125202,"_28736":74600},"Renovación y recuperación",[51485,123023,54195,124168,124346],[],{"_3708":74601,"_31596":74600,"_21876":125204,"_5":15057,"_28736":74600,"_3095":125205},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3708":74602,"_31596":74600,"_5":31952,"_21876":125207,"_28736":125208,"_3095":125209},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3708":74603,"_31596":74600,"_5":31952,"_21876":125211,"_28736":125212,"_3095":125213},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3708":74604,"_31596":74600,"_5":31952,"_21876":125215,"_28736":125216,"_3095":125217},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3708":74605,"_31596":74600,"_5":31952,"_21876":125219,"_28736":125220,"_3095":125221},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3708":74606,"_31596":74600,"_5":31952,"_21876":125223,"_28736":125224,"_3095":125225},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3708":74607,"_31596":74600,"_21876":125227,"_5":15057,"_28736":74600,"_3095":125228},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3708":74608,"_31596":74600,"_21876":125230,"_5":15057,"_28736":125208,"_3095":125231},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3708":74609,"_31596":74600,"_21876":125233,"_5":15057,"_28736":125208,"_3095":125234},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3708":74610,"_31596":74600,"_21876":125236,"_5":15057,"_28736":125208,"_3095":125237},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3708":74611,"_31596":74600,"_21876":125239,"_5":15057,"_28736":125208,"_3095":125240},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3708":74612,"_31596":74600,"_21876":125242,"_5":15057,"_28736":125212,"_3095":125243},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3708":74613,"_31596":74600,"_21876":125245,"_5":15057,"_28736":125212,"_3095":125246},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3708":74614,"_31596":74600,"_21876":125248,"_5":15057,"_28736":125216,"_3095":125249},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3708":74615,"_31596":74600,"_21876":125251,"_5":15057,"_28736":125216,"_3095":125252},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3708":74616,"_31596":74600,"_21876":125254,"_5":15057,"_28736":125216,"_3095":125255},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3708":74617,"_31596":74600,"_21876":125257,"_5":15057,"_28736":125220,"_3095":125258},[],"Situación",{"_3708":74618,"_31596":74600,"_21876":125260,"_5":15057,"_28736":125220,"_3095":125261},[],"Procedimiento",{"_3708":74619,"_31596":74600,"_21876":125263,"_5":15057,"_28736":125220,"_3095":125264},[],"Certificado vigente, fuera de ventana",{"_3708":74620,"_31596":74600,"_21876":125266,"_5":15057,"_28736":125220,"_3095":125267},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3708":74621,"_31596":74600,"_21876":125269,"_5":15057,"_28736":125220,"_3095":125270},[],"Certificado vencido, clave disponible",{"_3708":74622,"_31596":74600,"_21876":125272,"_5":15057,"_28736":125220,"_3095":125273},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3708":74623,"_31596":74600,"_21876":125275,"_5":15057,"_28736":125220,"_3095":125276},[],"Renovación por webhook o `NO_AUTH`",{"_3708":74624,"_31596":74600,"_21876":125278,"_5":15057,"_28736":125220,"_3095":125279},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3708":74625,"_31596":74600,"_21876":125281,"_5":15057,"_28736":125220,"_3095":125282},[],"Clave perdida o inaccesible",{"_3708":74626,"_31596":74600,"_21876":125284,"_5":15057,"_28736":125220,"_3095":125285},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3708":74627,"_31596":74600,"_21876":125287,"_5":15057,"_28736":125220,"_3095":125288},[],"Identidad actual revocada",{"_3708":74628,"_31596":74600,"_21876":125290,"_5":15057,"_28736":125220,"_3095":125291},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3708":74629,"_31596":74600,"_21876":125293,"_5":15057,"_28736":125220,"_3095":125294},[],"Dispositivo sin identidad",{"_3708":74630,"_31596":74600,"_21876":125296,"_5":15057,"_28736":125220,"_3095":125297},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3708":74631,"_31596":74600,"_21876":125299,"_5":15057,"_28736":125220,"_3095":125300},[],"Dispositivo retirado",{"_3708":74632,"_31596":74600,"_21876":125302,"_5":15057,"_28736":125220,"_3095":125303},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3708":74633,"_31596":74600,"_21876":125305,"_5":15057,"_28736":125220,"_3095":125306},[],"Timeout, HTTP 500 o fallo de instalación",{"_3708":74634,"_31596":74600,"_21876":125308,"_5":15057,"_28736":125220,"_3095":125309},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3708":74635,"_31596":74600,"_21876":125311,"_5":15057,"_28736":125224,"_3095":125312},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3708":74636,"_31596":74600,"_21876":125314,"_5":15057,"_28736":125224,"_3095":125315},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3708":74637,"_31596":74637,"_5":15417,"_3095":125317,"_31955":125318,"_21876":125319,"_28736":74637},"Diagnóstico de enrolamiento",[51485,123023,54195,124168,124346],[],{"_3708":74638,"_31596":74637,"_21876":125321,"_5":15057,"_28736":74637,"_3095":125322},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3708":74639,"_31596":74637,"_5":31952,"_21876":125324,"_28736":125325,"_3095":125326},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3708":74640,"_31596":74637,"_5":31952,"_21876":125328,"_28736":125329,"_3095":125330},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3708":74641,"_31596":74637,"_5":31952,"_21876":125332,"_28736":125333,"_3095":124896},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3708":74642,"_31596":74637,"_5":31952,"_21876":125335,"_28736":125336,"_3095":125337},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3708":74643,"_31596":74637,"_21876":125339,"_5":15057,"_28736":74637,"_3095":125340},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3708":74644,"_31596":74637,"_21876":125342,"_5":15057,"_28736":125329,"_3095":125343},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3708":74645,"_31596":74637,"_21876":125345,"_5":15057,"_28736":125329,"_3095":125346},[],"Síntoma o mensaje",{"_3708":74646,"_31596":74637,"_21876":125348,"_5":15057,"_28736":125329,"_3095":125349},[],"Qué revisar",{"_3708":74647,"_31596":74637,"_21876":125351,"_5":15057,"_28736":125329,"_3095":125352},[],"curl rechaza TLS, nombre o emisor",{"_3708":74648,"_31596":74637,"_21876":125354,"_5":15057,"_28736":125329,"_3095":125355},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3708":74649,"_31596":74637,"_21876":125357,"_5":15057,"_28736":125329,"_3095":125358},[],"404 o APS ausente",{"_3708":74650,"_31596":74637,"_21876":125360,"_5":15057,"_28736":125329,"_3095":125361},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3708":74651,"_31596":74637,"_21876":125363,"_5":15057,"_28736":125329,"_3095":125364},[],"400, error de CSR o formato",{"_3708":74652,"_31596":74637,"_21876":125366,"_5":15057,"_28736":125329,"_3095":125367},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3708":74653,"_31596":74637,"_21876":125369,"_5":15057,"_28736":125329,"_3095":125370},[],"Credencial ausente o certificado no válido",{"_3708":74654,"_31596":74637,"_21876":125372,"_5":15057,"_28736":125329,"_3095":125373},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3708":74655,"_31596":74637,"_21876":125375,"_5":15057,"_28736":125329,"_3095":125376},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3708":74656,"_31596":74637,"_21876":125378,"_5":15057,"_28736":125329,"_3095":125379},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3708":74657,"_31596":74637,"_21876":125381,"_5":15057,"_28736":125329,"_3095":125382},[],"Webhook deniega, expira o responde sin autorización",{"_3708":74658,"_31596":74637,"_21876":125384,"_5":15057,"_28736":125329,"_3095":125385},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3708":74659,"_31596":74637,"_21876":125387,"_5":15057,"_28736":125329,"_3095":55460},[],{"_3708":74660,"_31596":74637,"_21876":125389,"_5":15057,"_28736":125329,"_3095":125390},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3708":74661,"_31596":74637,"_21876":125392,"_5":15057,"_28736":125329,"_3095":55466},[],{"_3708":74662,"_31596":74637,"_21876":125394,"_5":15057,"_28736":125329,"_3095":125395},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3708":74663,"_31596":74637,"_21876":125397,"_5":15057,"_28736":125329,"_3095":55472},[],{"_3708":74664,"_31596":74637,"_21876":125399,"_5":15057,"_28736":125329,"_3095":125400},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3708":74665,"_31596":74637,"_21876":125402,"_5":15057,"_28736":125329,"_3095":55478},[],{"_3708":74666,"_31596":74637,"_21876":125404,"_5":15057,"_28736":125329,"_3095":125405},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3708":74667,"_31596":74637,"_21876":125407,"_5":15057,"_28736":125329,"_3095":55484},[],{"_3708":74668,"_31596":74637,"_21876":125409,"_5":15057,"_28736":125329,"_3095":125410},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3708":74669,"_31596":74637,"_21876":125412,"_5":15057,"_28736":125329,"_3095":125413},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3708":74670,"_31596":74637,"_21876":125415,"_5":15057,"_28736":125329,"_3095":125416},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3708":74671,"_31596":74637,"_21876":125418,"_5":15057,"_28736":125329,"_3095":125419},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3708":74672,"_31596":74637,"_21876":125421,"_5":15057,"_28736":125329,"_3095":125422},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3708":74673,"_31596":74637,"_21876":125424,"_5":15057,"_28736":125329,"_3095":55502},[],{"_3708":74674,"_31596":74637,"_21876":125426,"_5":15057,"_28736":125329,"_3095":125427},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3708":74675,"_31596":74637,"_21876":125429,"_5":15057,"_28736":125329,"_3095":55508},[],{"_3708":74676,"_31596":74637,"_21876":125431,"_5":15057,"_28736":125329,"_3095":125432},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3708":74677,"_31596":74637,"_21876":125434,"_5":15057,"_28736":125329,"_3095":125435},[],"DMS propietario distinto",{"_3708":74678,"_31596":74637,"_21876":125437,"_5":15057,"_28736":125329,"_3095":125438},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3708":74679,"_31596":74637,"_21876":125440,"_5":15057,"_28736":125329,"_3095":55520},[],{"_3708":74680,"_31596":74637,"_21876":125442,"_5":15057,"_28736":125329,"_3095":125443},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3708":74681,"_31596":74637,"_21876":125445,"_5":15057,"_28736":125329,"_3095":55526},[],{"_3708":74682,"_31596":74637,"_21876":125447,"_5":15057,"_28736":125329,"_3095":125448},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3708":74683,"_31596":74637,"_21876":125450,"_5":15057,"_28736":125329,"_3095":125451},[],"Certificado actual revocado",{"_3708":74684,"_31596":74637,"_21876":125453,"_5":15057,"_28736":125329,"_3095":125454},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3708":74685,"_31596":74637,"_21876":125456,"_5":15057,"_28736":125329,"_3095":125457},[],"Error de CA, perfil o firma",{"_3708":74686,"_31596":74637,"_21876":125459,"_5":15057,"_28736":125329,"_3095":125460},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3708":74687,"_31596":74637,"_21876":125462,"_5":15057,"_28736":125329,"_3095":125463},[],"HTTP 200 sin conexión del dispositivo",{"_3708":74688,"_31596":74637,"_21876":125465,"_5":15057,"_28736":125329,"_3095":125466},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3708":74689,"_31596":74637,"_21876":125468,"_5":15057,"_28736":125329,"_3095":125469},[],"Timeout o error después de emitir",{"_3708":74690,"_31596":74637,"_21876":125471,"_5":15057,"_28736":125329,"_3095":125472},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3708":74691,"_31596":74637,"_21876":125474,"_5":15057,"_28736":125333,"_3095":125475},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3708":74692,"_31596":74637,"_21876":125477,"_5":15057,"_28736":125333,"_3095":125478},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3708":74693,"_31596":74637,"_21876":125480,"_5":15057,"_28736":125336,"_3095":125481},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3708":74694,"_31596":74637,"_21876":125483,"_5":15057,"_28736":125336,"_3095":125484},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3708":74695,"_31596":74637,"_21876":125486,"_5":15057,"_28736":125336,"_3095":125487},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3708":74696,"_31596":74637,"_21876":125489,"_5":15057,"_28736":125336,"_3095":125490},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3708":74697,"_31596":74637,"_21876":125492,"_5":15057,"_28736":125336,"_3095":125493},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3708":74698,"_31596":74637,"_21876":125495,"_5":15057,"_28736":125336,"_3095":125496},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3708":74699,"_31596":74637,"_21876":125498,"_5":15057,"_28736":125336,"_3095":125499},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3708":74700,"_31596":74700,"_5":15417,"_3095":125501,"_31955":125502,"_21876":125503,"_28736":74700},"Distribución y actualización de confianza",[51485,123023,54195,124168,124346],[],{"_3708":74701,"_31596":74700,"_21876":125505,"_5":15057,"_28736":74700,"_3095":125506},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3708":74702,"_31596":74700,"_5":31952,"_21876":125508,"_28736":125509,"_3095":125510},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3708":74703,"_31596":74700,"_5":31952,"_21876":125512,"_28736":125513,"_3095":125514},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3708":74704,"_31596":74700,"_5":31952,"_21876":125516,"_28736":125517,"_3095":125518},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3708":74705,"_31596":74700,"_5":31952,"_21876":125520,"_28736":125521,"_3095":125522},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3708":74706,"_31596":74700,"_5":31952,"_21876":125524,"_28736":125525,"_3095":125526},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3708":74707,"_31596":74700,"_21876":125528,"_5":15057,"_28736":74700,"_3095":125529},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3708":74708,"_31596":74700,"_21876":125531,"_5":15057,"_28736":125509,"_3095":125532},[],"Relación",{"_3708":74709,"_31596":74700,"_21876":125534,"_5":15057,"_28736":125509,"_3095":125535},[],"Material que prepara el responsable",{"_3708":74710,"_31596":74700,"_21876":125537,"_5":15057,"_28736":125509,"_3095":125538},[],"Dispositivo → servidor EST",{"_3708":74711,"_31596":74700,"_21876":125540,"_5":15057,"_28736":125509,"_3095":125541},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3708":74712,"_31596":74700,"_21876":125543,"_5":15057,"_28736":125509,"_3095":125544},[],"DMS → solicitante",{"_3708":74713,"_31596":74700,"_21876":125546,"_5":15057,"_28736":125509,"_3095":125547},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3708":74714,"_31596":74700,"_21876":125549,"_5":15057,"_28736":125509,"_3095":125550},[],"Consumidor → dispositivo",{"_3708":74715,"_31596":74700,"_21876":125552,"_5":15057,"_28736":125509,"_3095":125553},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3708":74716,"_31596":74700,"_21876":125555,"_5":15057,"_28736":125509,"_3095":125556},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3708":74717,"_31596":74700,"_21876":125558,"_5":15057,"_28736":125513,"_3095":125559},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3708":74718,"_31596":74700,"_21876":125561,"_5":15057,"_28736":125513,"_3095":125562},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3708":74719,"_31596":74700,"_21876":125564,"_5":15057,"_28736":125517,"_3095":125565},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3708":74720,"_31596":74700,"_21876":125567,"_5":15057,"_28736":125517,"_3095":125568},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3708":74721,"_31596":74700,"_21876":125570,"_5":15057,"_28736":125517,"_3095":125571},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3708":74722,"_31596":74700,"_21876":125573,"_5":15057,"_28736":125517,"_3095":125574},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3708":74723,"_31596":74700,"_21876":125576,"_5":15057,"_28736":125517,"_3095":125577},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3708":74724,"_31596":74700,"_21876":125579,"_5":15057,"_28736":125517,"_3095":125580},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3708":74725,"_31596":74700,"_21876":125582,"_5":15057,"_28736":125521,"_3095":125583},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3708":74726,"_31596":74700,"_21876":125585,"_5":15057,"_28736":125521,"_3095":125586},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3708":74727,"_31596":74700,"_21876":125588,"_5":15057,"_28736":125521,"_3095":125589},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3708":74728,"_31596":74700,"_21876":125591,"_5":15057,"_28736":125525,"_3095":125592},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3708":74729,"_31596":74729,"_5":15417,"_3095":55675,"_31955":125594,"_21876":125596,"_28736":74729},[51485,123023,54195,124168,125595],"Integraciones",[],{"_3708":74730,"_31596":74729,"_21876":125598,"_5":15057,"_28736":74729,"_3095":125599},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3708":74731,"_31596":74729,"_5":31952,"_21876":125601,"_28736":125602,"_3095":125603},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3708":74732,"_31596":74729,"_5":31952,"_21876":125605,"_28736":125606,"_3095":125607},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3708":74733,"_31596":74729,"_5":31952,"_21876":125609,"_28736":125610,"_3095":125611},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3708":74734,"_31596":74729,"_5":31952,"_21876":125613,"_28736":125614,"_3095":125615},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3708":74735,"_31596":74729,"_5":31952,"_21876":125617,"_28736":125618,"_3095":125619},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3708":74736,"_31596":74729,"_5":31952,"_21876":125621,"_28736":125622,"_3095":125623},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3708":74737,"_31596":74729,"_5":31952,"_21876":125625,"_28736":125626,"_3095":125627},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3708":74738,"_31596":74729,"_5":31952,"_21876":125629,"_28736":125630,"_3095":125631},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3708":74739,"_31596":74729,"_5":31952,"_21876":125633,"_28736":125634,"_3095":55717},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3708":74740,"_31596":74729,"_5":31952,"_21876":125636,"_28736":125637,"_3095":55721},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3708":74741,"_31596":74729,"_5":31952,"_21876":125639,"_28736":125640,"_3095":125641},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3708":74742,"_31596":74729,"_5":31952,"_21876":125643,"_28736":125644,"_3095":125645},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3708":74743,"_31596":74729,"_5":31952,"_21876":125647,"_28736":125648,"_3095":125649},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3708":74744,"_31596":74729,"_5":31952,"_21876":125651,"_28736":125652,"_3095":125653},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3708":74745,"_31596":74729,"_5":31952,"_21876":125655,"_28736":125656,"_3095":125657},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3708":74746,"_31596":74729,"_5":31952,"_21876":125659,"_28736":125660,"_3095":125661},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3708":74747,"_31596":74729,"_5":31952,"_21876":125663,"_28736":125664,"_3095":125665},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3708":74748,"_31596":74729,"_5":31952,"_21876":125667,"_28736":125668,"_3095":125669},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3708":74749,"_31596":74729,"_5":31952,"_21876":125671,"_28736":125672,"_3095":125673},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3708":74750,"_31596":74729,"_5":31952,"_21876":125675,"_28736":125676,"_3095":125677},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3708":74751,"_31596":74729,"_5":31952,"_21876":125679,"_28736":125680,"_3095":125681},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3708":74752,"_31596":74729,"_5":31952,"_21876":125683,"_28736":125684,"_3095":125685},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3708":74753,"_31596":74729,"_5":31952,"_21876":125687,"_28736":125688,"_3095":125689},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3708":74754,"_31596":74729,"_5":31952,"_21876":125691,"_28736":125692,"_3095":125693},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3708":74755,"_31596":74729,"_5":31952,"_21876":125695,"_28736":125696,"_3095":125697},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3708":74756,"_31596":74729,"_21876":125699,"_5":15057,"_28736":74729,"_3095":125700},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3708":74757,"_31596":74729,"_21876":125702,"_5":15057,"_28736":74729,"_3095":125703},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3708":74758,"_31596":74729,"_21876":125705,"_5":15057,"_28736":74729,"_3095":125706},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3708":74759,"_31596":74729,"_21876":125708,"_5":15057,"_28736":125602,"_3095":125709},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3708":74760,"_31596":74729,"_21876":125711,"_5":15057,"_28736":125602,"_3095":125712},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3708":74761,"_31596":74729,"_21876":125714,"_5":15057,"_28736":125602,"_3095":125715},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3708":74762,"_31596":74729,"_21876":125717,"_5":15057,"_28736":125602,"_3095":125718},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3708":74763,"_31596":74729,"_21876":125720,"_5":15057,"_28736":125606,"_3095":125721},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3708":74764,"_31596":74729,"_21876":125723,"_5":15057,"_28736":125610,"_3095":125724},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3708":74765,"_31596":74729,"_21876":125726,"_5":15057,"_28736":125610,"_3095":125727},[],"Acción IAM",{"_3708":74766,"_31596":74729,"_21876":125729,"_5":15057,"_28736":125610,"_3095":121901},[],{"_3708":74767,"_31596":74729,"_21876":125731,"_5":15057,"_28736":125610,"_3095":55816},[],{"_3708":74768,"_31596":74729,"_21876":125733,"_5":15057,"_28736":125610,"_3095":125734},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3708":74769,"_31596":74729,"_21876":125736,"_5":15057,"_28736":125610,"_3095":55822},[],{"_3708":74770,"_31596":74729,"_21876":125738,"_5":15057,"_28736":125610,"_3095":125739},[],"Registrar la CA en AWS IoT",{"_3708":74771,"_31596":74729,"_21876":125741,"_5":15057,"_28736":125610,"_3095":55828},[],{"_3708":74772,"_31596":74729,"_21876":125743,"_5":15057,"_28736":125610,"_3095":125744},[],"Consultar el estado del registro de la CA",{"_3708":74773,"_31596":74729,"_21876":125746,"_5":15057,"_28736":125610,"_3095":55834},[],{"_3708":74774,"_31596":74729,"_21876":125748,"_5":15057,"_28736":125610,"_3095":125749},[],"Crear o actualizar Things en IoT Core",{"_3708":74775,"_31596":74729,"_21876":125751,"_5":15057,"_28736":125610,"_3095":55840},[],{"_3708":74776,"_31596":74729,"_21876":125753,"_5":15057,"_28736":125610,"_3095":125754},[],"Aprovisionar Things mediante plantilla",{"_3708":74777,"_31596":74729,"_21876":125756,"_5":15057,"_28736":125610,"_3095":55846},[],{"_3708":74778,"_31596":74729,"_21876":125758,"_5":15057,"_28736":125610,"_3095":125759},[],"Registrar certificados de dispositivo",{"_3708":74779,"_31596":74729,"_21876":125761,"_5":15057,"_28736":125610,"_3095":55852},[],{"_3708":74780,"_31596":74729,"_21876":125763,"_5":15057,"_28736":125610,"_3095":125764},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3708":74781,"_31596":74729,"_21876":125766,"_5":15057,"_28736":125610,"_3095":55858},[],{"_3708":74782,"_31596":74729,"_21876":125768,"_5":15057,"_28736":125610,"_3095":125769},[],"Crear y adjuntar políticas IoT",{"_3708":74783,"_31596":74729,"_21876":125771,"_5":15057,"_28736":125610,"_3095":55864},[],{"_3708":74784,"_31596":74729,"_21876":125773,"_5":15057,"_28736":125610,"_3095":125774},[],"Gestionar grupos de Things",{"_3708":74785,"_31596":74729,"_21876":125776,"_5":15057,"_28736":125610,"_3095":55870},[],{"_3708":74786,"_31596":74729,"_21876":125778,"_5":15057,"_28736":125610,"_3095":125779},[],"Crear plantillas JITP",{"_3708":74787,"_31596":74729,"_21876":125781,"_5":15057,"_28736":125610,"_3095":55876},[],{"_3708":74788,"_31596":74729,"_21876":125783,"_5":15057,"_28736":125610,"_3095":125784},[],"Leer y escribir el Device Shadow",{"_3708":74789,"_31596":74729,"_21876":125786,"_5":15057,"_28736":125610,"_3095":125787},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3708":74790,"_31596":74729,"_21876":125789,"_5":15057,"_28736":125614,"_3095":125790},[],"Parámetro",{"_3708":74791,"_31596":74729,"_21876":125792,"_5":15057,"_28736":125614,"_3095":125793},[],"Tipo",{"_3708":74792,"_31596":74729,"_21876":125795,"_5":15057,"_28736":125614,"_3095":125796},[],"Requerido",{"_3708":74793,"_31596":74729,"_21876":125798,"_5":15057,"_28736":125614,"_3095":125799},[],"Descripción",{"_3708":74794,"_31596":74729,"_21876":125801,"_5":15057,"_28736":125614,"_3095":55897},[],{"_3708":74795,"_31596":74729,"_21876":125803,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74796,"_31596":74729,"_21876":125805,"_5":15057,"_28736":125614,"_3095":125806},[],"Sí",{"_3708":74797,"_31596":74729,"_21876":125808,"_5":15057,"_28736":125614,"_3095":125809},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3708":74798,"_31596":74729,"_21876":125811,"_5":15057,"_28736":125614,"_3095":55908},[],{"_3708":74799,"_31596":74729,"_21876":125813,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74800,"_31596":74729,"_21876":125815,"_5":15057,"_28736":125614,"_3095":125806},[],{"_3708":74801,"_31596":74729,"_21876":125817,"_5":15057,"_28736":125614,"_3095":125818},[],"Región AWS donde opera el conector.",{"_3708":74802,"_31596":74729,"_21876":125820,"_5":15057,"_28736":125614,"_3095":55918},[],{"_3708":74803,"_31596":74729,"_21876":125822,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74804,"_31596":74729,"_21876":125824,"_5":15057,"_28736":125614,"_3095":125806},[],{"_3708":74805,"_31596":74729,"_21876":125826,"_5":15057,"_28736":125614,"_3095":125827},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3708":74806,"_31596":74729,"_21876":125829,"_5":15057,"_28736":125614,"_3095":55928},[],{"_3708":74807,"_31596":74729,"_21876":125831,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74808,"_31596":74729,"_21876":125833,"_5":15057,"_28736":125614,"_3095":125834},[],"Solo con `auth_method=static`",{"_3708":74809,"_31596":74729,"_21876":125836,"_5":15057,"_28736":125614,"_3095":125837},[],"Clave de acceso AWS.",{"_3708":74810,"_31596":74729,"_21876":125839,"_5":15057,"_28736":125614,"_3095":55939},[],{"_3708":74811,"_31596":74729,"_21876":125841,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74812,"_31596":74729,"_21876":125843,"_5":15057,"_28736":125614,"_3095":125834},[],{"_3708":74813,"_31596":74729,"_21876":125845,"_5":15057,"_28736":125614,"_3095":125846},[],"Clave secreta AWS.",{"_3708":74814,"_31596":74729,"_21876":125848,"_5":15057,"_28736":125614,"_3095":55949},[],{"_3708":74815,"_31596":74729,"_21876":125850,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74816,"_31596":74729,"_21876":125852,"_5":15057,"_28736":125614,"_3095":55954},[],{"_3708":74817,"_31596":74729,"_21876":125854,"_5":15057,"_28736":125614,"_3095":125855},[],"Token de sesión (con `auth_method=static`).",{"_3708":74818,"_31596":74729,"_21876":125857,"_5":15057,"_28736":125614,"_3095":55960},[],{"_3708":74819,"_31596":74729,"_21876":125859,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74820,"_31596":74729,"_21876":125861,"_5":15057,"_28736":125614,"_3095":125862},[],"Solo con `auth_method=role`",{"_3708":74821,"_31596":74729,"_21876":125864,"_5":15057,"_28736":125614,"_3095":125865},[],"ARN del rol a asumir.",{"_3708":74822,"_31596":74729,"_21876":125867,"_5":15057,"_28736":125614,"_3095":55971},[],{"_3708":74823,"_31596":74729,"_21876":125869,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74824,"_31596":74729,"_21876":125871,"_5":15057,"_28736":125614,"_3095":55954},[],{"_3708":74825,"_31596":74729,"_21876":125873,"_5":15057,"_28736":125614,"_3095":125874},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3708":74826,"_31596":74729,"_21876":125876,"_5":15057,"_28736":125614,"_3095":55981},[],{"_3708":74827,"_31596":74729,"_21876":125878,"_5":15057,"_28736":125614,"_3095":93865},[],{"_3708":74828,"_31596":74729,"_21876":125880,"_5":15057,"_28736":125614,"_3095":125806},[],{"_3708":74829,"_31596":74729,"_21876":125882,"_5":15057,"_28736":125614,"_3095":125883},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3708":74830,"_31596":74729,"_21876":125885,"_5":15057,"_28736":125614,"_3095":55991},[],{"_3708":74831,"_31596":74729,"_21876":125887,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74832,"_31596":74729,"_21876":125889,"_5":15057,"_28736":125614,"_3095":125806},[],{"_3708":74833,"_31596":74729,"_21876":125891,"_5":15057,"_28736":125614,"_3095":125892},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3708":74834,"_31596":74729,"_21876":125894,"_5":15057,"_28736":125614,"_3095":56001},[],{"_3708":74835,"_31596":74729,"_21876":125896,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74836,"_31596":74729,"_21876":125898,"_5":15057,"_28736":125614,"_3095":125806},[],{"_3708":74837,"_31596":74729,"_21876":125900,"_5":15057,"_28736":125614,"_3095":125901},[],"URL HTTP del Device Manager de Lamassu.",{"_3708":74838,"_31596":74729,"_21876":125903,"_5":15057,"_28736":125614,"_3095":56011},[],{"_3708":74839,"_31596":74729,"_21876":125905,"_5":15057,"_28736":125614,"_3095":26106},[],{"_3708":74840,"_31596":74729,"_21876":125907,"_5":15057,"_28736":125614,"_3095":125806},[],{"_3708":74841,"_31596":74729,"_21876":125909,"_5":15057,"_28736":125614,"_3095":125910},[],"URL HTTP del servicio de CA de Lamassu.",{"_3708":74842,"_31596":74729,"_21876":125912,"_5":15057,"_28736":125618,"_3095":125913},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3708":74843,"_31596":74729,"_21876":125915,"_5":15057,"_28736":125618,"_3095":125916},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3708":74844,"_31596":74729,"_21876":125918,"_5":15057,"_28736":125618,"_3095":125919},[],"Tipo de CloudEvent",{"_3708":74845,"_31596":74729,"_21876":125921,"_5":15057,"_28736":125618,"_3095":125922},[],"Recurso en Lamassu",{"_3708":74846,"_31596":74729,"_21876":125924,"_5":15057,"_28736":125618,"_3095":125925},[],"Recurso AWS",{"_3708":74847,"_31596":74729,"_21876":125927,"_5":15057,"_28736":125618,"_3095":125928},[],"Acciones IAM",{"_3708":74848,"_31596":74729,"_21876":125930,"_5":15057,"_28736":125618,"_3095":125931},[],"Llamadas AWS y efecto",{"_3708":74849,"_31596":74729,"_21876":125933,"_5":15057,"_28736":125618,"_3095":125934},[],"Dónde en esta página",{"_3708":74850,"_31596":74729,"_21876":125936,"_5":15057,"_28736":125618,"_3095":56045},[],{"_3708":74851,"_31596":74729,"_21876":125938,"_5":15057,"_28736":125618,"_3095":56048},[],{"_3708":74852,"_31596":74729,"_21876":125940,"_5":15057,"_28736":125618,"_3095":56051},[],{"_3708":74853,"_31596":74729,"_21876":125942,"_5":15057,"_28736":125618,"_3095":56054},[],{"_3708":74854,"_31596":74729,"_21876":125944,"_5":15057,"_28736":125618,"_3095":125945},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3708":74855,"_31596":74729,"_21876":125947,"_5":15057,"_28736":125618,"_3095":125631},[],{"_3708":74856,"_31596":74729,"_21876":125949,"_5":15057,"_28736":125618,"_3095":56062},[],{"_3708":74857,"_31596":74729,"_21876":125951,"_5":15057,"_28736":125618,"_3095":56065},[],{"_3708":74858,"_31596":74729,"_21876":125953,"_5":15057,"_28736":125618,"_3095":56068},[],{"_3708":74859,"_31596":74729,"_21876":125955,"_5":15057,"_28736":125618,"_3095":56071},[],{"_3708":74860,"_31596":74729,"_21876":125957,"_5":15057,"_28736":125618,"_3095":125958},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3708":74861,"_31596":74729,"_21876":125960,"_5":15057,"_28736":125618,"_3095":125657},[],{"_3708":74862,"_31596":74729,"_21876":125962,"_5":15057,"_28736":125618,"_3095":56079},[],{"_3708":74863,"_31596":74729,"_21876":125964,"_5":15057,"_28736":125618,"_3095":125965},[],"Dispositivo",{"_3708":74864,"_31596":74729,"_21876":125967,"_5":15057,"_28736":125618,"_3095":56085},[],{"_3708":74865,"_31596":74729,"_21876":125969,"_5":15057,"_28736":125618,"_3095":56088},[],{"_3708":74866,"_31596":74729,"_21876":125971,"_5":15057,"_28736":125618,"_3095":125972},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3708":74867,"_31596":74729,"_21876":125974,"_5":15057,"_28736":125618,"_3095":125665},[],{"_3708":74868,"_31596":74729,"_21876":125976,"_5":15057,"_28736":125618,"_3095":56096},[],{"_3708":74869,"_31596":74729,"_21876":125978,"_5":15057,"_28736":125618,"_3095":125979},[],"Certificado",{"_3708":74870,"_31596":74729,"_21876":125981,"_5":15057,"_28736":125618,"_3095":56102},[],{"_3708":74871,"_31596":74729,"_21876":125983,"_5":15057,"_28736":125618,"_3095":125984},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3708":74872,"_31596":74729,"_21876":125986,"_5":15057,"_28736":125618,"_3095":125987},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3708":74873,"_31596":74729,"_21876":125989,"_5":15057,"_28736":125618,"_3095":125677},[],{"_3708":74874,"_31596":74729,"_21876":125991,"_5":15057,"_28736":125618,"_3095":56113},[],{"_3708":74875,"_31596":74729,"_21876":125993,"_5":15057,"_28736":125618,"_3095":125994},[],"Certificado / Dispositivo",{"_3708":74876,"_31596":74729,"_21876":125996,"_5":15057,"_28736":125618,"_3095":56119},[],{"_3708":74877,"_31596":74729,"_21876":125998,"_5":15057,"_28736":125618,"_3095":51881},[],{"_3708":74878,"_31596":74729,"_21876":126000,"_5":15057,"_28736":125618,"_3095":126001},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3708":74879,"_31596":74729,"_21876":126003,"_5":15057,"_28736":125618,"_3095":125685},[],{"_3708":74880,"_31596":74729,"_21876":126005,"_5":15057,"_28736":125622,"_3095":126006},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3708":74881,"_31596":74729,"_21876":126008,"_5":15057,"_28736":125626,"_3095":126009},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3708":74882,"_31596":74729,"_21876":126011,"_5":15057,"_28736":125626,"_3095":126012},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3708":74883,"_31596":74729,"_21876":126014,"_5":15057,"_28736":125630,"_3095":126015},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3708":74884,"_31596":74729,"_21876":126017,"_5":15057,"_28736":125630,"_3095":126018},[],"Transición",{"_3708":74885,"_31596":74729,"_21876":126020,"_5":15057,"_28736":125630,"_3095":126021},[],"Llamadas AWS",{"_3708":74886,"_31596":74729,"_21876":126023,"_5":15057,"_28736":125630,"_3095":126024},[],"`NoRegistrada` → `Solicitada`",{"_3708":74887,"_31596":74729,"_21876":126026,"_5":15057,"_28736":125630,"_3095":126027},[],"ninguna (solo escritura de metadatos)",{"_3708":74888,"_31596":74729,"_21876":126029,"_5":15057,"_28736":125630,"_3095":126030},[],"`Solicitada` → `Registrando`",{"_3708":74889,"_31596":74729,"_21876":126032,"_5":15057,"_28736":125630,"_3095":126033},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3708":74890,"_31596":74729,"_21876":126035,"_5":15057,"_28736":125630,"_3095":126036},[],"`Registrando` → `Completada`",{"_3708":74891,"_31596":74729,"_21876":126038,"_5":15057,"_28736":125630,"_3095":126039},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3708":74892,"_31596":74729,"_21876":126041,"_5":15057,"_28736":125630,"_3095":126042},[],"`Registrando` → `Fallida`",{"_3708":74893,"_31596":74729,"_21876":126044,"_5":15057,"_28736":125630,"_3095":126045},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3708":74894,"_31596":74729,"_21876":126047,"_5":15057,"_28736":125630,"_3095":126048},[],"`Fallida` / `Completada` → `Solicitada`",{"_3708":74895,"_31596":74729,"_21876":126050,"_5":15057,"_28736":125630,"_3095":126051},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3708":74896,"_31596":74729,"_21876":126053,"_5":15057,"_28736":125634,"_3095":126054},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3708":74897,"_31596":74729,"_21876":126056,"_5":15057,"_28736":125634,"_3095":126057},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3708":74898,"_31596":74729,"_21876":126059,"_5":15057,"_28736":125634,"_3095":126060},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3708":74899,"_31596":74729,"_21876":126062,"_5":15057,"_28736":125634,"_3095":126063},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3708":74900,"_31596":74729,"_21876":126065,"_5":15057,"_28736":125634,"_3095":126066},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3708":74901,"_31596":74729,"_21876":126068,"_5":15057,"_28736":125634,"_3095":126069},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3708":74902,"_31596":74729,"_21876":126071,"_5":15057,"_28736":125637,"_3095":126072},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3708":74903,"_31596":74729,"_21876":126074,"_5":15057,"_28736":125640,"_3095":126075},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3708":74904,"_31596":74729,"_21876":126077,"_5":15057,"_28736":125640,"_3095":126078},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3708":74905,"_31596":74729,"_21876":126080,"_5":15057,"_28736":125644,"_3095":126081},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3708":74906,"_31596":74729,"_21876":126083,"_5":15057,"_28736":125648,"_3095":126084},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3708":74907,"_31596":74729,"_21876":126086,"_5":15057,"_28736":125648,"_3095":126087},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3708":74908,"_31596":74729,"_21876":126089,"_5":15057,"_28736":125648,"_3095":126090},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3708":74909,"_31596":74729,"_21876":126092,"_5":15057,"_28736":125648,"_3095":126093},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3708":74910,"_31596":74729,"_21876":126095,"_5":15057,"_28736":125648,"_3095":126096},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3708":74911,"_31596":74729,"_21876":126098,"_5":15057,"_28736":125648,"_3095":126099},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3708":74912,"_31596":74729,"_21876":126101,"_5":15057,"_28736":125652,"_3095":126102},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3708":74913,"_31596":74729,"_21876":126104,"_5":15057,"_28736":125652,"_3095":126105},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3708":74914,"_31596":74729,"_21876":126107,"_5":15057,"_28736":125652,"_3095":126108},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3708":74915,"_31596":74729,"_21876":126110,"_5":15057,"_28736":125652,"_3095":126111},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3708":74916,"_31596":74729,"_21876":126113,"_5":15057,"_28736":125652,"_3095":126114},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3708":74917,"_31596":74729,"_21876":126116,"_5":15057,"_28736":125656,"_3095":126117},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3708":74918,"_31596":74729,"_21876":126119,"_5":15057,"_28736":125656,"_3095":126018},[],{"_3708":74919,"_31596":74729,"_21876":126121,"_5":15057,"_28736":125656,"_3095":126021},[],{"_3708":74920,"_31596":74729,"_21876":126123,"_5":15057,"_28736":125656,"_3095":126124},[],"`SinConfigurar` → `None` / `Auto`",{"_3708":74921,"_31596":74729,"_21876":126126,"_5":15057,"_28736":125656,"_3095":126127},[],"ninguna (solo configuración)",{"_3708":74922,"_31596":74729,"_21876":126129,"_5":15057,"_28736":125656,"_3095":56256},[],{"_3708":74923,"_31596":74729,"_21876":126131,"_5":15057,"_28736":125656,"_3095":126127},[],{"_3708":74924,"_31596":74729,"_21876":126133,"_5":15057,"_28736":125656,"_3095":126134},[],"Cualquiera → `Jitp`",{"_3708":74925,"_31596":74729,"_21876":126136,"_5":15057,"_28736":125656,"_3095":126137},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3708":74926,"_31596":74729,"_21876":126139,"_5":15057,"_28736":125656,"_3095":56267},[],{"_3708":74927,"_31596":74729,"_21876":126141,"_5":15057,"_28736":125656,"_3095":126142},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3708":74928,"_31596":74729,"_21876":126144,"_5":15057,"_28736":125660,"_3095":126145},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3708":74929,"_31596":74729,"_21876":126147,"_5":15057,"_28736":125660,"_3095":126148},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3708":74930,"_31596":74729,"_21876":126150,"_5":15057,"_28736":125660,"_3095":126151},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3708":74931,"_31596":74729,"_21876":126153,"_5":15057,"_28736":125664,"_3095":126154},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3708":74932,"_31596":74729,"_21876":126156,"_5":15057,"_28736":125664,"_3095":126018},[],{"_3708":74933,"_31596":74729,"_21876":126158,"_5":15057,"_28736":125664,"_3095":126021},[],{"_3708":74934,"_31596":74729,"_21876":126160,"_5":15057,"_28736":125664,"_3095":126161},[],"`Ausente` → `Aprovisionado`",{"_3708":74935,"_31596":74729,"_21876":126163,"_5":15057,"_28736":125664,"_3095":126164},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3708":74936,"_31596":74729,"_21876":126166,"_5":15057,"_28736":125664,"_3095":126167},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3708":74937,"_31596":74729,"_21876":126169,"_5":15057,"_28736":125664,"_3095":126170},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3708":74938,"_31596":74729,"_21876":126172,"_5":15057,"_28736":125664,"_3095":126173},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3708":74939,"_31596":74729,"_21876":126175,"_5":15057,"_28736":125668,"_3095":126176},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3708":74940,"_31596":74729,"_21876":126178,"_5":15057,"_28736":125668,"_3095":126179},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3708":74941,"_31596":74729,"_21876":126181,"_5":15057,"_28736":125668,"_3095":126182},[],"Para que el flujo JITP funcione correctamente:",{"_3708":74942,"_31596":74729,"_21876":126184,"_5":15057,"_28736":125668,"_3095":126185},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3708":74943,"_31596":74729,"_21876":126187,"_5":15057,"_28736":125668,"_3095":126188},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3708":74944,"_31596":74729,"_21876":126190,"_5":15057,"_28736":125668,"_3095":126191},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3708":74945,"_31596":74729,"_21876":126193,"_5":15057,"_28736":125668,"_3095":126194},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3708":74946,"_31596":74729,"_21876":126196,"_5":15057,"_28736":125672,"_3095":126197},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3708":74947,"_31596":74729,"_21876":126199,"_5":15057,"_28736":125672,"_3095":126200},[],"Estado en Lamassu",{"_3708":74948,"_31596":74729,"_21876":126202,"_5":15057,"_28736":125672,"_3095":126203},[],"Razón de revocación",{"_3708":74949,"_31596":74729,"_21876":126205,"_5":15057,"_28736":125672,"_3095":126206},[],"Estado en AWS IoT Core",{"_3708":74950,"_31596":74729,"_21876":126208,"_5":15057,"_28736":125672,"_3095":56337},[],{"_3708":74951,"_31596":74729,"_21876":126210,"_5":15057,"_28736":125672,"_3095":126211},[],"Ninguna",{"_3708":74952,"_31596":74729,"_21876":126213,"_5":15057,"_28736":125672,"_3095":56343},[],{"_3708":74953,"_31596":74729,"_21876":126215,"_5":15057,"_28736":125672,"_3095":56346},[],{"_3708":74954,"_31596":74729,"_21876":126217,"_5":15057,"_28736":125672,"_3095":56349},[],{"_3708":74955,"_31596":74729,"_21876":126219,"_5":15057,"_28736":125672,"_3095":56352},[],{"_3708":74956,"_31596":74729,"_21876":126221,"_5":15057,"_28736":125672,"_3095":56346},[],{"_3708":74957,"_31596":74729,"_21876":126223,"_5":15057,"_28736":125672,"_3095":126224},[],"Cualquier otra razón",{"_3708":74958,"_31596":74729,"_21876":126226,"_5":15057,"_28736":125672,"_3095":56360},[],{"_3708":74959,"_31596":74729,"_21876":126228,"_5":15057,"_28736":125672,"_3095":126229},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3708":74960,"_31596":74729,"_21876":126231,"_5":15057,"_28736":125676,"_3095":126232},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3708":74961,"_31596":74729,"_21876":126234,"_5":15057,"_28736":125676,"_3095":126018},[],{"_3708":74962,"_31596":74729,"_21876":126236,"_5":15057,"_28736":125676,"_3095":126021},[],{"_3708":74963,"_31596":74729,"_21876":126238,"_5":15057,"_28736":125676,"_3095":126239},[],"`NoSincronizado` → `Active`",{"_3708":74964,"_31596":74729,"_21876":126241,"_5":15057,"_28736":125676,"_3095":55852},[],{"_3708":74965,"_31596":74729,"_21876":126243,"_5":15057,"_28736":125676,"_3095":56378},[],{"_3708":74966,"_31596":74729,"_21876":126245,"_5":15057,"_28736":125676,"_3095":126246},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3708":74967,"_31596":74729,"_21876":126248,"_5":15057,"_28736":125676,"_3095":56384},[],{"_3708":74968,"_31596":74729,"_21876":126250,"_5":15057,"_28736":125676,"_3095":126246},[],{"_3708":74969,"_31596":74729,"_21876":126252,"_5":15057,"_28736":125676,"_3095":56389},[],{"_3708":74970,"_31596":74729,"_21876":126254,"_5":15057,"_28736":125676,"_3095":55852},[],{"_3708":74971,"_31596":74729,"_21876":126256,"_5":15057,"_28736":125676,"_3095":56394},[],{"_3708":74972,"_31596":74729,"_21876":126258,"_5":15057,"_28736":125676,"_3095":126259},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3708":74973,"_31596":74729,"_21876":126261,"_5":15057,"_28736":125680,"_3095":126262},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3708":74974,"_31596":74729,"_21876":126264,"_5":15057,"_28736":125680,"_3095":126265},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3708":74975,"_31596":74729,"_21876":126267,"_5":15057,"_28736":125680,"_3095":126268},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3708":74976,"_31596":74729,"_21876":126270,"_5":15057,"_28736":125684,"_3095":126271},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3708":74977,"_31596":74729,"_21876":126273,"_5":15057,"_28736":125684,"_3095":126274},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3708":74978,"_31596":74729,"_21876":126276,"_5":15057,"_28736":125688,"_3095":126277},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3708":74979,"_31596":74729,"_21876":126279,"_5":15057,"_28736":125688,"_3095":126280},[],"Existen dos tipos de acciones:",{"_3708":74980,"_31596":74729,"_21876":126282,"_5":15057,"_28736":125688,"_3095":126283},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3708":74981,"_31596":74729,"_21876":126285,"_5":15057,"_28736":125688,"_3095":126286},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3708":74982,"_31596":74729,"_21876":126288,"_5":15057,"_28736":125688,"_3095":126289},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3708":74983,"_31596":74729,"_21876":126291,"_5":15057,"_28736":125692,"_3095":126292},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3708":74984,"_31596":74729,"_21876":126294,"_5":15057,"_28736":125692,"_3095":126295},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3708":74985,"_31596":74729,"_21876":126297,"_5":15057,"_28736":125692,"_3095":126298},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3708":74986,"_31596":74729,"_21876":126300,"_5":15057,"_28736":125696,"_3095":126301},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3708":74987,"_31596":74729,"_21876":126303,"_5":15057,"_28736":125696,"_3095":126304},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3708":74988,"_31596":74729,"_21876":126306,"_5":15057,"_28736":125696,"_3095":126307},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3708":74989,"_31596":74729,"_21876":126309,"_5":15057,"_28736":125696,"_3095":126310},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3708":74990,"_31596":74729,"_21876":126312,"_5":15057,"_28736":125696,"_3095":126313},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3708":74991,"_31596":74729,"_21876":126315,"_5":15057,"_28736":125696,"_3095":126316},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3708":74992,"_31596":74729,"_21876":126318,"_5":15057,"_28736":125696,"_3095":126319},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3708":74993,"_31596":74729,"_21876":126321,"_5":15057,"_28736":125696,"_3095":126322},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3708":74994,"_31596":74729,"_21876":126324,"_5":15057,"_28736":125696,"_3095":126325},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3708":74995,"_31596":74729,"_21876":126327,"_5":15057,"_28736":125696,"_3095":126328},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3708":74996,"_31596":74729,"_21876":126330,"_5":15057,"_28736":125696,"_3095":126331},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3708":74997,"_31596":74729,"_21876":126333,"_5":15057,"_28736":125696,"_3095":126334},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3708":74998,"_31596":74729,"_21876":126336,"_5":15057,"_28736":125696,"_3095":126337},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3708":74999,"_31596":74729,"_21876":126339,"_5":15057,"_28736":125696,"_3095":126340},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3708":75000,"_31596":74729,"_21876":126342,"_5":15057,"_28736":125696,"_3095":126343},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3708":75001,"_31596":74729,"_21876":126345,"_5":15057,"_28736":125696,"_3095":126346},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3708":75002,"_31596":74729,"_21876":126348,"_5":15057,"_28736":125696,"_3095":126349},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3708":75003,"_31596":74729,"_21876":126351,"_5":15057,"_28736":125696,"_3095":126352},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3708":75004,"_31596":74729,"_21876":126354,"_5":15057,"_28736":125696,"_3095":126355},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3708":75005,"_31596":74729,"_21876":126357,"_5":15057,"_28736":125696,"_3095":126358},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3708":75006,"_31596":74729,"_21876":126360,"_5":15057,"_28736":125696,"_3095":126361},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3708":75007,"_31596":74729,"_21876":126363,"_5":15057,"_28736":125696,"_3095":126364},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3708":75008,"_31596":74729,"_21876":126366,"_5":15057,"_28736":125696,"_3095":126367},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3708":75009,"_31596":74729,"_21876":126369,"_5":15057,"_28736":125696,"_3095":126370},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3708":75010,"_31596":75010,"_5":15417,"_3095":54195,"_31955":126372,"_21876":126373,"_28736":75010},[51485,123023,54195],[],{"_3708":75011,"_31596":75010,"_21876":126375,"_5":15057,"_28736":75010,"_3095":126376},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3708":75012,"_31596":75010,"_5":31952,"_21876":126378,"_28736":126379,"_3095":126380},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3708":75013,"_31596":75010,"_5":31952,"_21876":126382,"_28736":126383,"_3095":124168},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3708":75014,"_31596":75010,"_5":31952,"_21876":126385,"_28736":126386,"_3095":124346},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3708":75015,"_31596":75010,"_5":31952,"_21876":126388,"_28736":126389,"_3095":125595},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#integraciones",{"_3708":75016,"_31596":75010,"_5":31952,"_21876":126391,"_28736":126392,"_3095":126393},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3708":75017,"_31596":75010,"_21876":126395,"_5":15057,"_28736":75010,"_3095":126396},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3708":75018,"_31596":75010,"_21876":126398,"_5":15057,"_28736":126379,"_3095":126399},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3708":75019,"_31596":75010,"_21876":126401,"_5":15057,"_28736":126379,"_3095":126402},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3708":75020,"_31596":75010,"_21876":126404,"_5":15057,"_28736":126383,"_3095":126405},[],"Recurso",{"_3708":75021,"_31596":75010,"_21876":126407,"_5":15057,"_28736":126383,"_3095":126408},[],"Qué representa",{"_3708":75022,"_31596":75010,"_21876":126410,"_5":15057,"_28736":126383,"_3095":126411},[],"**Dispositivo**",{"_3708":75023,"_31596":75010,"_21876":126413,"_5":15057,"_28736":126383,"_3095":126414},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3708":75024,"_31596":75010,"_21876":126416,"_5":15057,"_28736":126383,"_3095":126417},[],"**Identidad**",{"_3708":75025,"_31596":75010,"_21876":126419,"_5":15057,"_28736":126383,"_3095":126420},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3708":75026,"_31596":75010,"_21876":126422,"_5":15057,"_28736":126383,"_3095":56561},[],{"_3708":75027,"_31596":75010,"_21876":126424,"_5":15057,"_28736":126383,"_3095":126425},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3708":75028,"_31596":75010,"_21876":126427,"_5":15057,"_28736":126383,"_3095":126428},[],"**Flota**",{"_3708":75029,"_31596":75010,"_21876":126430,"_5":15057,"_28736":126383,"_3095":126431},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3708":75030,"_31596":75010,"_21876":126433,"_5":15057,"_28736":126383,"_3095":126434},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3708":75031,"_31596":75010,"_21876":126436,"_5":15057,"_28736":126383,"_3095":126437},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3708":75032,"_31596":75010,"_21876":126439,"_5":15057,"_28736":126386,"_3095":126440},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3708":75033,"_31596":75010,"_21876":126442,"_5":15057,"_28736":126386,"_3095":126443},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3708":75034,"_31596":75010,"_21876":126445,"_5":15057,"_28736":126386,"_3095":126446},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3708":75035,"_31596":75010,"_21876":126448,"_5":15057,"_28736":126386,"_3095":126449},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3708":75036,"_31596":75010,"_21876":126451,"_5":15057,"_28736":126386,"_3095":126452},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3708":75037,"_31596":75010,"_21876":126454,"_5":15057,"_28736":126386,"_3095":126455},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3708":75038,"_31596":75010,"_21876":126457,"_5":15057,"_28736":126386,"_3095":126458},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3708":75039,"_31596":75010,"_21876":126460,"_5":15057,"_28736":126386,"_3095":126461},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3708":75040,"_31596":75010,"_21876":126463,"_5":15057,"_28736":126389,"_3095":126464},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3708":75041,"_31596":75010,"_21876":126466,"_5":15057,"_28736":126389,"_3095":126467},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3708":75042,"_31596":75010,"_21876":126469,"_5":15057,"_28736":126392,"_3095":126470},[],"Participante",{"_3708":75043,"_31596":75010,"_21876":126472,"_5":15057,"_28736":126392,"_3095":126473},[],"Responsabilidad",{"_3708":75044,"_31596":75010,"_21876":126475,"_5":15057,"_28736":126392,"_3095":126476},[],"Administrador PKI",{"_3708":75045,"_31596":75010,"_21876":126478,"_5":15057,"_28736":126392,"_3095":126479},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3708":75046,"_31596":75010,"_21876":126481,"_5":15057,"_28736":126392,"_3095":126482},[],"Administrador del aprovisionamiento",{"_3708":75047,"_31596":75010,"_21876":126484,"_5":15057,"_28736":126392,"_3095":126485},[],"DMS, admisión, autenticación por operación e inventario.",{"_3708":75048,"_31596":75010,"_21876":126487,"_5":15057,"_28736":126392,"_3095":126488},[],"Integrador del dispositivo",{"_3708":75049,"_31596":75010,"_21876":126490,"_5":15057,"_28736":126392,"_3095":126491},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3708":75050,"_31596":75010,"_21876":126493,"_5":15057,"_28736":126392,"_3095":126494},[],"Integrador del consumidor",{"_3708":75051,"_31596":75010,"_21876":126496,"_5":15057,"_28736":126392,"_3095":126497},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3708":75052,"_31596":75010,"_21876":126499,"_5":15057,"_28736":126392,"_3095":126500},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3708":75053,"_31596":75053,"_5":15417,"_3095":126502,"_31955":126503,"_21876":126505,"_28736":75053},"Enrola y conecta tu primer dispositivo",[51485,123023,54195,126504],"Primeros pasos",[],{"_3708":75054,"_31596":75053,"_21876":126507,"_5":15057,"_28736":75053,"_3095":126508},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3708":75055,"_31596":75053,"_5":31952,"_21876":126510,"_28736":126511,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3708":75056,"_31596":75053,"_5":31952,"_21876":126513,"_28736":126514,"_3095":126515},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3708":75057,"_31596":75053,"_5":31952,"_21876":126517,"_28736":126518,"_3095":126519},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3708":75058,"_31596":75053,"_5":31952,"_21876":126521,"_28736":126522,"_3095":126523},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3708":75059,"_31596":75053,"_5":31952,"_21876":126525,"_28736":126526,"_3095":126527},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3708":75060,"_31596":75053,"_5":31952,"_21876":126529,"_28736":126530,"_3095":126531},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3708":75061,"_31596":75053,"_5":31952,"_21876":126533,"_28736":126534,"_3095":126535},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3708":75062,"_31596":75053,"_5":31952,"_21876":126537,"_28736":126538,"_3095":126539},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3708":75063,"_31596":75053,"_21876":126541,"_5":15057,"_28736":75053,"_3095":126542},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3708":75064,"_31596":75053,"_21876":126544,"_5":15057,"_28736":126511,"_3095":126545},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3708":75065,"_31596":75053,"_21876":126547,"_5":15057,"_28736":126511,"_3095":126548},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3708":75066,"_31596":75053,"_21876":126550,"_5":15057,"_28736":126511,"_3095":126551},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3708":75067,"_31596":75053,"_21876":126553,"_5":15057,"_28736":126511,"_3095":126554},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3708":75068,"_31596":75053,"_21876":126556,"_5":15057,"_28736":126511,"_3095":126557},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3708":75069,"_31596":75053,"_21876":126559,"_5":15057,"_28736":126514,"_3095":126560},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3708":75070,"_31596":75053,"_21876":126562,"_5":15057,"_28736":126514,"_3095":126563},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3708":75071,"_31596":75053,"_21876":126565,"_5":15057,"_28736":126518,"_3095":126566},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3708":75072,"_31596":75053,"_21876":126568,"_5":15057,"_28736":126518,"_3095":126569},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3708":75073,"_31596":75053,"_21876":126571,"_5":15057,"_28736":126518,"_3095":126572},[],"Ajuste",{"_3708":75074,"_31596":75053,"_21876":126574,"_5":15057,"_28736":126518,"_3095":126575},[],"Valor de evaluación",{"_3708":75075,"_31596":75053,"_21876":126577,"_5":15057,"_28736":126518,"_3095":56717},[],{"_3708":75076,"_31596":75053,"_21876":126579,"_5":15057,"_28736":126518,"_3095":126580},[],"Raíz emisora de `device-root.pem`.",{"_3708":75077,"_31596":75053,"_21876":126582,"_5":15057,"_28736":126518,"_3095":124483},[],{"_3708":75078,"_31596":75053,"_21876":126584,"_5":15057,"_28736":126518,"_3095":126585},[],"Perfil final de 1 hora que acabas de preparar.",{"_3708":75079,"_31596":75053,"_21876":126587,"_5":15057,"_28736":126518,"_3095":56728},[],{"_3708":75080,"_31596":75053,"_21876":126589,"_5":15057,"_28736":126518,"_3095":56731},[],{"_3708":75081,"_31596":75053,"_21876":126591,"_5":15057,"_28736":126518,"_3095":56734},[],{"_3708":75082,"_31596":75053,"_21876":126593,"_5":15057,"_28736":126518,"_3095":126594},[],"Habilitado.",{"_3708":75083,"_31596":75053,"_21876":126596,"_5":15057,"_28736":126518,"_3095":56740},[],{"_3708":75084,"_31596":75053,"_21876":126598,"_5":15057,"_28736":126518,"_3095":126599},[],"Deshabilitado; el ID debe ser nuevo.",{"_3708":75085,"_31596":75053,"_21876":126601,"_5":15057,"_28736":126518,"_3095":126602},[],"Autenticación inicial",{"_3708":75086,"_31596":75053,"_21876":126604,"_5":15057,"_28736":126518,"_3095":126605},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3708":75087,"_31596":75053,"_21876":126607,"_5":15057,"_28736":126518,"_3095":126608},[],"Autenticación de renovación",{"_3708":75088,"_31596":75053,"_21876":126610,"_5":15057,"_28736":126518,"_3095":126611},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3708":75089,"_31596":75053,"_21876":126613,"_5":15057,"_28736":126518,"_3095":56758},[],{"_3708":75090,"_31596":75053,"_21876":126615,"_5":15057,"_28736":126518,"_3095":126616},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3708":75091,"_31596":75053,"_21876":126618,"_5":15057,"_28736":126518,"_3095":56764},[],{"_3708":75092,"_31596":75053,"_21876":126620,"_5":15057,"_28736":126518,"_3095":126621},[],"1 hora.",{"_3708":75093,"_31596":75053,"_21876":126623,"_5":15057,"_28736":126518,"_3095":56770},[],{"_3708":75094,"_31596":75053,"_21876":126625,"_5":15057,"_28736":126518,"_3095":126626},[],"30 minutos / 10 minutos.",{"_3708":75095,"_31596":75053,"_21876":126628,"_5":15057,"_28736":126518,"_3095":56776},[],{"_3708":75096,"_31596":75053,"_21876":126630,"_5":15057,"_28736":126518,"_3095":126631},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3708":75097,"_31596":75053,"_21876":126633,"_5":15057,"_28736":126518,"_3095":54526},[],{"_3708":75098,"_31596":75053,"_21876":126635,"_5":15057,"_28736":126518,"_3095":126636},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3708":75099,"_31596":75053,"_21876":126638,"_5":15057,"_28736":126518,"_3095":56787},[],{"_3708":75100,"_31596":75053,"_21876":126640,"_5":15057,"_28736":126518,"_3095":126641},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3708":75101,"_31596":75053,"_21876":126643,"_5":15057,"_28736":126518,"_3095":126644},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3708":75102,"_31596":75053,"_21876":126646,"_5":15057,"_28736":126522,"_3095":126647},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3708":75103,"_31596":75053,"_21876":126649,"_5":15057,"_28736":126522,"_3095":126650},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3708":75104,"_31596":75053,"_21876":126652,"_5":15057,"_28736":126526,"_3095":126653},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3708":75105,"_31596":75053,"_21876":126655,"_5":15057,"_28736":126526,"_3095":126656},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3708":75106,"_31596":75053,"_21876":126658,"_5":15057,"_28736":126526,"_3095":126659},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3708":75107,"_31596":75053,"_21876":126661,"_5":15057,"_28736":126530,"_3095":126662},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3708":75108,"_31596":75053,"_21876":126664,"_5":15057,"_28736":126530,"_3095":126665},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3708":75109,"_31596":75053,"_21876":126667,"_5":15057,"_28736":126534,"_3095":126668},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3708":75110,"_31596":75053,"_21876":126670,"_5":15057,"_28736":126534,"_3095":126671},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3708":75111,"_31596":75053,"_21876":126673,"_5":15057,"_28736":126534,"_3095":126674},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3708":75112,"_31596":75053,"_21876":126676,"_5":15057,"_28736":126534,"_3095":126677},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3708":75113,"_31596":75053,"_21876":126679,"_5":15057,"_28736":126534,"_3095":126680},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3708":75114,"_31596":75053,"_21876":126682,"_5":15057,"_28736":126538,"_3095":126683},[],"Comprobación",{"_3708":75115,"_31596":75053,"_21876":126685,"_5":15057,"_28736":126538,"_3095":126686},[],"Resultado esperado",{"_3708":75116,"_31596":75053,"_21876":126688,"_5":15057,"_28736":126538,"_3095":126689},[],"Registro",{"_3708":75117,"_31596":75053,"_21876":126691,"_5":15057,"_28736":126538,"_3095":126692},[],"ID creado automáticamente y DMS correcto.",{"_3708":75118,"_31596":75053,"_21876":126694,"_5":15057,"_28736":126538,"_3095":125979},[],{"_3708":75119,"_31596":75053,"_21876":126696,"_5":15057,"_28736":126538,"_3095":126697},[],"CN, perfil, serie y clave verificados.",{"_3708":75120,"_31596":75053,"_21876":126699,"_5":15057,"_28736":126538,"_3095":126700},[],"Inventario",{"_3708":75121,"_31596":75053,"_21876":126702,"_5":15057,"_28736":126538,"_3095":126703},[],"Serie recibida visible como identidad actual y en el historial.",{"_3708":75122,"_31596":75053,"_21876":126705,"_5":15057,"_28736":126538,"_3095":126706},[],"Consumidor",{"_3708":75123,"_31596":75053,"_21876":126708,"_5":15057,"_28736":126538,"_3095":126709},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3708":75124,"_31596":75053,"_21876":126711,"_5":15057,"_28736":126538,"_3095":126712},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3708":75125,"_31596":75053,"_21876":126714,"_5":15057,"_28736":126538,"_3095":126715},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3708":75126,"_31596":75126,"_5":15417,"_3095":124185,"_31955":126717,"_21876":126718,"_28736":75126},[51485,123023,54195,126504],[],{"_3708":75127,"_31596":75126,"_21876":126720,"_5":15057,"_28736":75126,"_3095":126721},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3708":75128,"_31596":75126,"_5":31952,"_21876":126723,"_28736":126724,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3708":75129,"_31596":75126,"_5":31952,"_21876":126726,"_28736":126727,"_3095":126728},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3708":75130,"_31596":75126,"_5":31952,"_21876":126730,"_28736":126731,"_3095":126732},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3708":75131,"_31596":75126,"_5":31952,"_21876":126734,"_28736":126735,"_3095":126736},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3708":75132,"_31596":75126,"_5":31952,"_21876":126738,"_28736":126739,"_3095":126740},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3708":75133,"_31596":75126,"_5":31952,"_21876":126742,"_28736":126743,"_3095":126744},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3708":75134,"_31596":75126,"_5":31952,"_21876":126746,"_28736":126747,"_3095":126686},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3708":75135,"_31596":75126,"_5":31952,"_21876":126749,"_28736":126750,"_3095":126751},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3708":75136,"_31596":75126,"_5":31952,"_21876":126753,"_28736":126754,"_3095":126755},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3708":75137,"_31596":75126,"_21876":126757,"_5":15057,"_28736":75126,"_3095":126758},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3708":75138,"_31596":75126,"_21876":126760,"_5":15057,"_28736":75126,"_3095":126761},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3708":75139,"_31596":75126,"_21876":126763,"_5":15057,"_28736":126724,"_3095":126764},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3708":75140,"_31596":75126,"_21876":126766,"_5":15057,"_28736":126724,"_3095":126767},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3708":75141,"_31596":75126,"_21876":126769,"_5":15057,"_28736":126724,"_3095":126770},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3708":75142,"_31596":75126,"_21876":126772,"_5":15057,"_28736":126724,"_3095":126773},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3708":75143,"_31596":75126,"_21876":126775,"_5":15057,"_28736":126727,"_3095":126776},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3708":75144,"_31596":75126,"_21876":126778,"_5":15057,"_28736":126727,"_3095":126779},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3708":75145,"_31596":75126,"_21876":126781,"_5":15057,"_28736":126727,"_3095":126782},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3708":75146,"_31596":75126,"_21876":126784,"_5":15057,"_28736":126727,"_3095":126785},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3708":75147,"_31596":75126,"_21876":126787,"_5":15057,"_28736":126727,"_3095":126788},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3708":75148,"_31596":75126,"_21876":126790,"_5":15057,"_28736":126727,"_3095":126791},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3708":75149,"_31596":75126,"_21876":126793,"_5":15057,"_28736":126727,"_3095":126794},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3708":75150,"_31596":75126,"_21876":126796,"_5":15057,"_28736":126727,"_3095":126797},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3708":75151,"_31596":75126,"_21876":126799,"_5":15057,"_28736":126731,"_3095":126800},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3708":75152,"_31596":75126,"_21876":126802,"_5":15057,"_28736":126731,"_3095":56952},[],{"_3708":75153,"_31596":75126,"_21876":126804,"_5":15057,"_28736":126731,"_3095":126805},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3708":75154,"_31596":75126,"_21876":126807,"_5":15057,"_28736":126731,"_3095":126808},[],"**Icon** y **Tags**: clasificación opcional.",{"_3708":75155,"_31596":75126,"_21876":126810,"_5":15057,"_28736":126731,"_3095":126811},[],"Confirma el registro.",{"_3708":75156,"_31596":75126,"_21876":126813,"_5":15057,"_28736":126735,"_3095":126814},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3708":75157,"_31596":75126,"_21876":126816,"_5":15057,"_28736":126735,"_3095":126817},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3708":75158,"_31596":75126,"_21876":126819,"_5":15057,"_28736":126739,"_3095":126820},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3708":75159,"_31596":75126,"_21876":126822,"_5":15057,"_28736":126739,"_3095":126823},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3708":75160,"_31596":75126,"_21876":126825,"_5":15057,"_28736":126743,"_3095":126826},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3708":75161,"_31596":75126,"_21876":126828,"_5":15057,"_28736":126743,"_3095":126829},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3708":75162,"_31596":75126,"_21876":126831,"_5":15057,"_28736":126747,"_3095":126683},[],{"_3708":75163,"_31596":75126,"_21876":126833,"_5":15057,"_28736":126747,"_3095":126834},[],"Resultado",{"_3708":75164,"_31596":75126,"_21876":126836,"_5":15057,"_28736":126747,"_3095":125965},[],{"_3708":75165,"_31596":75126,"_21876":126838,"_5":15057,"_28736":126747,"_3095":126839},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3708":75166,"_31596":75126,"_21876":126841,"_5":15057,"_28736":126747,"_3095":126842},[],"Identidad actual",{"_3708":75167,"_31596":75126,"_21876":126844,"_5":15057,"_28736":126747,"_3095":126845},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3708":75168,"_31596":75126,"_21876":126847,"_5":15057,"_28736":126747,"_3095":126848},[],"Historial",{"_3708":75169,"_31596":75126,"_21876":126850,"_5":15057,"_28736":126747,"_3095":126851},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3708":75170,"_31596":75126,"_21876":126853,"_5":15057,"_28736":126747,"_3095":126854},[],"Clave y certificado",{"_3708":75171,"_31596":75126,"_21876":126856,"_5":15057,"_28736":126747,"_3095":126857},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3708":75172,"_31596":75126,"_21876":126859,"_5":15057,"_28736":126750,"_3095":126860},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3708":75173,"_31596":75126,"_21876":126862,"_5":15057,"_28736":126750,"_3095":126863},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3708":75174,"_31596":75126,"_21876":126865,"_5":15057,"_28736":126750,"_3095":126866},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3708":75175,"_31596":75126,"_21876":126868,"_5":15057,"_28736":126750,"_3095":126869},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3708":75176,"_31596":75126,"_21876":126871,"_5":15057,"_28736":126754,"_3095":126872},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3708":75177,"_31596":75126,"_21876":126874,"_5":15057,"_28736":126754,"_3095":126875},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3708":75178,"_31596":75126,"_21876":126877,"_5":15057,"_28736":126754,"_3095":126878},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3708":75179,"_31596":75179,"_5":15417,"_3095":126880,"_31955":126881,"_21876":126882,"_28736":75179},"Plataforma Lamassu IoT",[51485,123023],[],{"_3708":75180,"_31596":75179,"_21876":126884,"_5":15057,"_28736":75179,"_3095":126885},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3708":75181,"_31596":75179,"_5":31952,"_21876":126887,"_28736":126888,"_3095":126380},[],"/docs/pr-preview/pr-78/es/platform/overview#empieza-aquí",{"_3708":75182,"_31596":75179,"_5":31952,"_21876":126890,"_28736":126891,"_3095":126892},[],"/docs/pr-preview/pr-78/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3708":75183,"_31596":75179,"_5":31952,"_21876":126894,"_28736":126895,"_3095":126896},[],"/docs/pr-preview/pr-78/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3708":75184,"_31596":75179,"_5":31952,"_21876":126898,"_28736":126899,"_3095":126900},[],"/docs/pr-preview/pr-78/es/platform/overview#capacidades-principales","Capacidades principales",{"_3708":75185,"_31596":75179,"_5":31952,"_21876":126902,"_28736":126903,"_3095":126904},[],"/docs/pr-preview/pr-78/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3708":75186,"_31596":75179,"_5":31952,"_21876":126906,"_28736":126907,"_3095":126908},[],"/docs/pr-preview/pr-78/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3708":75187,"_31596":75179,"_5":31952,"_21876":126910,"_28736":126911,"_3095":126912},[],"/docs/pr-preview/pr-78/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3708":75188,"_31596":75179,"_5":31952,"_21876":126914,"_28736":126915,"_3095":126916},[],"/docs/pr-preview/pr-78/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3708":75189,"_31596":75179,"_5":31952,"_21876":126918,"_28736":126919,"_3095":126920},[],"/docs/pr-preview/pr-78/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3708":75190,"_31596":75179,"_5":31952,"_21876":126922,"_28736":126923,"_3095":126924},[],"/docs/pr-preview/pr-78/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3708":75191,"_31596":75179,"_5":31952,"_21876":126926,"_28736":126927,"_3095":126928},[],"/docs/pr-preview/pr-78/es/platform/overview#referencia-operativa","Referencia operativa",{"_3708":75192,"_31596":75179,"_21876":126930,"_5":15057,"_28736":75179,"_3095":126931},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3708":75193,"_31596":75179,"_21876":126933,"_5":15057,"_28736":126888,"_3095":126934},[],"Elige el resultado que necesitas obtener:",{"_3708":75194,"_31596":75179,"_21876":126936,"_5":15057,"_28736":126888,"_3095":126937},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3708":75195,"_31596":75179,"_21876":126939,"_5":15057,"_28736":126888,"_3095":126940},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3708":75196,"_31596":75179,"_21876":126942,"_5":15057,"_28736":126888,"_3095":126943},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3708":75197,"_31596":75179,"_21876":126945,"_5":15057,"_28736":126891,"_3095":126946},[],"Bloque",{"_3708":75198,"_31596":75179,"_21876":126948,"_5":15057,"_28736":126891,"_3095":126949},[],"Qué gestionas",{"_3708":75199,"_31596":75179,"_21876":126951,"_5":15057,"_28736":126891,"_3095":126952},[],"Punto de entrada",{"_3708":75200,"_31596":75179,"_21876":126954,"_5":15057,"_28736":126891,"_3095":57105},[],{"_3708":75201,"_31596":75179,"_21876":126956,"_5":15057,"_28736":126891,"_3095":126957},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3708":75202,"_31596":75179,"_21876":126959,"_5":15057,"_28736":126891,"_3095":126960},[],"Visión general de PKI",{"_3708":75203,"_31596":75179,"_21876":126962,"_5":15057,"_28736":126891,"_3095":57114},[],{"_3708":75204,"_31596":75179,"_21876":126964,"_5":15057,"_28736":126891,"_3095":126965},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3708":75205,"_31596":75179,"_21876":126967,"_5":15057,"_28736":126891,"_3095":126968},[],"Visión general de IoT Fleets",{"_3708":75206,"_31596":75179,"_21876":126970,"_5":15057,"_28736":126891,"_3095":126971},[],"**Administración**",{"_3708":75207,"_31596":75179,"_21876":126973,"_5":15057,"_28736":126891,"_3095":126974},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3708":75208,"_31596":75179,"_21876":126976,"_5":15057,"_28736":126891,"_3095":123025},[],{"_3708":75209,"_31596":75179,"_21876":126978,"_5":15057,"_28736":126891,"_3095":126979},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3708":75210,"_31596":75179,"_21876":126981,"_5":15057,"_28736":126895,"_3095":126982},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3708":75211,"_31596":75179,"_21876":126984,"_5":15057,"_28736":126895,"_3095":126985},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3708":75212,"_31596":75179,"_21876":126987,"_5":15057,"_28736":126895,"_3095":126988},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3708":75213,"_31596":75179,"_21876":126990,"_5":15057,"_28736":126895,"_3095":126991},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3708":75214,"_31596":75179,"_21876":126993,"_5":15057,"_28736":126895,"_3095":126994},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3708":75215,"_31596":75179,"_21876":126996,"_5":15057,"_28736":126895,"_3095":126997},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3708":75216,"_31596":75179,"_21876":126999,"_5":15057,"_28736":126903,"_3095":127000},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3708":75217,"_31596":75179,"_21876":127002,"_5":15057,"_28736":126907,"_3095":127003},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3708":75218,"_31596":75179,"_21876":127005,"_5":15057,"_28736":126911,"_3095":127006},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3708":75219,"_31596":75179,"_21876":127008,"_5":15057,"_28736":126915,"_3095":127009},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3708":75220,"_31596":75179,"_21876":127011,"_5":15057,"_28736":126919,"_3095":127012},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3708":75221,"_31596":75179,"_21876":127014,"_5":15057,"_28736":126923,"_3095":127015},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3708":75222,"_31596":75179,"_21876":127017,"_5":15057,"_28736":126927,"_3095":126473},[],{"_3708":75223,"_31596":75179,"_21876":127019,"_5":15057,"_28736":126927,"_3095":127020},[],"Qué prepara o comprueba",{"_3708":75224,"_31596":75179,"_21876":127022,"_5":15057,"_28736":126927,"_3095":126476},[],{"_3708":75225,"_31596":75179,"_21876":127024,"_5":15057,"_28736":126927,"_3095":127025},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3708":75226,"_31596":75179,"_21876":127027,"_5":15057,"_28736":126927,"_3095":127028},[],"Administrador de la flota",{"_3708":75227,"_31596":75179,"_21876":127030,"_5":15057,"_28736":126927,"_3095":127031},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3708":75228,"_31596":75179,"_21876":127033,"_5":15057,"_28736":126927,"_3095":126488},[],{"_3708":75229,"_31596":75179,"_21876":127035,"_5":15057,"_28736":126927,"_3095":127036},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3708":75230,"_31596":75179,"_21876":127038,"_5":15057,"_28736":126927,"_3095":126494},[],{"_3708":75231,"_31596":75179,"_21876":127040,"_5":15057,"_28736":126927,"_3095":127041},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3708":75232,"_31596":75179,"_21876":127043,"_5":15057,"_28736":126927,"_3095":127044},[],"Operador de infraestructura",{"_3708":75233,"_31596":75179,"_21876":127046,"_5":15057,"_28736":126927,"_3095":127047},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3708":75234,"_31596":75179,"_21876":127049,"_5":15057,"_28736":126927,"_3095":127050},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3708":75235,"_31596":75235,"_5":15417,"_3095":127052,"_31955":127053,"_21876":127055,"_28736":75235},"Jerarquía y rotación de CAs",[51485,123023,57206,127054],"Claves, autoridades y certificados",[],{"_3708":75236,"_31596":75235,"_21876":127057,"_5":15057,"_28736":75235,"_3095":127058},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3708":75237,"_31596":75235,"_5":31952,"_21876":127060,"_28736":127061,"_3095":127062},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3708":75238,"_31596":75235,"_5":31952,"_21876":127064,"_28736":127065,"_3095":127066},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3708":75239,"_31596":75235,"_5":31952,"_21876":127068,"_28736":127069,"_3095":127070},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3708":75240,"_31596":75235,"_5":31952,"_21876":127072,"_28736":127073,"_3095":127074},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3708":75241,"_31596":75235,"_5":31952,"_21876":127076,"_28736":127077,"_3095":127078},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3708":75242,"_31596":75235,"_5":31952,"_21876":127080,"_28736":127081,"_3095":127082},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3708":75243,"_31596":75235,"_5":31952,"_21876":127084,"_28736":127085,"_3095":127086},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3708":75244,"_31596":75235,"_5":31952,"_21876":127088,"_28736":127089,"_3095":127090},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3708":75245,"_31596":75235,"_5":31952,"_21876":127092,"_28736":127093,"_3095":127094},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3708":75246,"_31596":75235,"_5":31952,"_21876":127096,"_28736":127097,"_3095":127098},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3708":75247,"_31596":75235,"_5":31952,"_21876":127100,"_28736":127101,"_3095":127102},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3708":75248,"_31596":75235,"_5":31952,"_21876":127104,"_28736":127105,"_3095":127106},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3708":75249,"_31596":75235,"_21876":127108,"_5":15057,"_28736":75235,"_3095":127109},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3708":75250,"_31596":75235,"_21876":127111,"_5":15057,"_28736":75235,"_3095":127112},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3708":75251,"_31596":75235,"_21876":127114,"_5":15057,"_28736":127061,"_3095":127115},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3708":75252,"_31596":75235,"_21876":127117,"_5":15057,"_28736":127061,"_3095":127118},[],"entorno, como producción y preproducción;",{"_3708":75253,"_31596":75235,"_21876":127120,"_5":15057,"_28736":127061,"_3095":127121},[],"propietario o equipo operador;",{"_3708":75254,"_31596":75235,"_21876":127123,"_5":15057,"_28736":127061,"_3095":127124},[],"familia de dispositivos o proceso de fabricación;",{"_3708":75255,"_31596":75235,"_21876":127126,"_5":15057,"_28736":127061,"_3095":127127},[],"región o requisito regulatorio;",{"_3708":75256,"_31596":75235,"_21876":127129,"_5":15057,"_28736":127061,"_3095":127130},[],"motor criptográfico o política de clave;",{"_3708":75257,"_31596":75235,"_21876":127132,"_5":15057,"_28736":127061,"_3095":127133},[],"ventana de mantenimiento y ritmo de renovación.",{"_3708":75258,"_31596":75235,"_21876":127135,"_5":15057,"_28736":127061,"_3095":127136},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3708":75259,"_31596":75235,"_21876":127138,"_5":15057,"_28736":127061,"_3095":127139},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3708":75260,"_31596":75235,"_21876":127141,"_5":15057,"_28736":127065,"_3095":127142},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3708":75261,"_31596":75235,"_21876":127144,"_5":15057,"_28736":127065,"_3095":127145},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3708":75262,"_31596":75235,"_21876":127147,"_5":15057,"_28736":127065,"_3095":127148},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3708":75263,"_31596":75235,"_21876":127150,"_5":15057,"_28736":127065,"_3095":127151},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3708":75264,"_31596":75235,"_21876":127153,"_5":15057,"_28736":127069,"_3095":127154},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3708":75265,"_31596":75235,"_21876":127156,"_5":15057,"_28736":127069,"_3095":127157},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3708":75266,"_31596":75235,"_21876":127159,"_5":15057,"_28736":127069,"_3095":127160},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3708":75267,"_31596":75235,"_21876":127162,"_5":15057,"_28736":127069,"_3095":127163},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3708":75268,"_31596":75235,"_21876":127165,"_5":15057,"_28736":127077,"_3095":127166},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3708":75269,"_31596":75235,"_21876":127168,"_5":15057,"_28736":127081,"_3095":127169},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3708":75270,"_31596":75235,"_21876":127171,"_5":15057,"_28736":127085,"_3095":127172},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3708":75271,"_31596":75235,"_21876":127174,"_5":15057,"_28736":127089,"_3095":127175},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3708":75272,"_31596":75235,"_21876":127177,"_5":15057,"_28736":127093,"_3095":127178},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3708":75273,"_31596":75235,"_21876":127180,"_5":15057,"_28736":127097,"_3095":127181},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3708":75274,"_31596":75235,"_21876":127183,"_5":15057,"_28736":127101,"_3095":127184},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3708":75275,"_31596":75235,"_21876":127186,"_5":15057,"_28736":127101,"_3095":127187},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3708":75276,"_31596":75235,"_21876":127189,"_5":15057,"_28736":127101,"_3095":127190},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3708":75277,"_31596":75235,"_21876":127192,"_5":15057,"_28736":127101,"_3095":127193},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3708":75278,"_31596":75235,"_21876":127195,"_5":15057,"_28736":127105,"_3095":127196},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3708":75279,"_31596":75235,"_21876":127198,"_5":15057,"_28736":127105,"_3095":127199},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3708":75280,"_31596":75235,"_21876":127201,"_5":15057,"_28736":127105,"_3095":127202},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3708":75281,"_31596":75235,"_21876":127204,"_5":15057,"_28736":127105,"_3095":127205},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3708":75282,"_31596":75235,"_21876":127207,"_5":15057,"_28736":127105,"_3095":127208},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3708":75283,"_31596":75235,"_21876":127210,"_5":15057,"_28736":127105,"_3095":127211},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3708":75284,"_31596":75235,"_21876":127213,"_5":15057,"_28736":127105,"_3095":127214},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3708":75285,"_31596":75285,"_5":15417,"_3095":127216,"_31955":127217,"_21876":127218,"_28736":75285},"Autoridades de certificación",[51485,123023,57206,127054],[],{"_3708":75286,"_31596":75285,"_21876":127220,"_5":15057,"_28736":75285,"_3095":127221},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3708":75287,"_31596":75285,"_5":31952,"_21876":127223,"_28736":127224,"_3095":127225},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3708":75288,"_31596":75285,"_5":31952,"_21876":127227,"_28736":127228,"_3095":127229},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3708":75289,"_31596":75285,"_5":31952,"_21876":127231,"_28736":127232,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3708":75290,"_31596":75285,"_5":31952,"_21876":127234,"_28736":127235,"_3095":127236},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3708":75291,"_31596":75285,"_5":31952,"_21876":127238,"_28736":127239,"_3095":127240},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3708":75292,"_31596":75285,"_5":31952,"_21876":127242,"_28736":127243,"_3095":127244},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3708":75293,"_31596":75285,"_5":31952,"_21876":127246,"_28736":127247,"_3095":127248},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3708":75294,"_31596":75285,"_5":31952,"_21876":127250,"_28736":127251,"_3095":127252},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3708":75295,"_31596":75285,"_5":31952,"_21876":127254,"_28736":127255,"_3095":127256},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3708":75296,"_31596":75285,"_5":31952,"_21876":127258,"_28736":127259,"_3095":127260},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3708":75297,"_31596":75285,"_5":31952,"_21876":127262,"_28736":127263,"_3095":127264},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3708":75298,"_31596":75285,"_5":31952,"_21876":127266,"_28736":127267,"_3095":127268},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3708":75299,"_31596":75285,"_5":31952,"_21876":127270,"_28736":127271,"_3095":127272},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3708":75300,"_31596":75285,"_5":31952,"_21876":127274,"_28736":127275,"_3095":127276},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3708":75301,"_31596":75285,"_5":31952,"_21876":127278,"_28736":127279,"_3095":127280},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3708":75302,"_31596":75285,"_5":31952,"_21876":127282,"_28736":127283,"_3095":127284},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3708":75303,"_31596":75285,"_5":31952,"_21876":127286,"_28736":127287,"_3095":127288},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3708":75304,"_31596":75285,"_5":31952,"_21876":127290,"_28736":127291,"_3095":127292},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3708":75305,"_31596":75285,"_5":31952,"_21876":127294,"_28736":127295,"_3095":127296},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3708":75306,"_31596":75285,"_5":31952,"_21876":127298,"_28736":127299,"_3095":127300},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3708":75307,"_31596":75285,"_5":31952,"_21876":127302,"_28736":127303,"_3095":127304},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3708":75308,"_31596":75285,"_5":31952,"_21876":127306,"_28736":127307,"_3095":127308},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3708":75309,"_31596":75285,"_5":31952,"_21876":127310,"_28736":127311,"_3095":127312},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3708":75310,"_31596":75285,"_5":31952,"_21876":127314,"_28736":127315,"_3095":127316},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3708":75311,"_31596":75285,"_21876":127318,"_5":15057,"_28736":75285,"_3095":127319},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3708":75312,"_31596":75285,"_21876":127321,"_5":15057,"_28736":75285,"_3095":127322},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3708":75313,"_31596":75285,"_21876":127324,"_5":15057,"_28736":75285,"_3095":127325},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3708":75314,"_31596":75285,"_21876":127327,"_5":15057,"_28736":127224,"_3095":127328},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3708":75315,"_31596":75285,"_21876":127330,"_5":15057,"_28736":127224,"_3095":127331},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3708":75316,"_31596":75285,"_21876":127333,"_5":15057,"_28736":127224,"_3095":127334},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3708":75317,"_31596":75285,"_21876":127336,"_5":15057,"_28736":127224,"_3095":127337},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3708":75318,"_31596":75285,"_21876":127339,"_5":15057,"_28736":127224,"_3095":127340},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3708":75319,"_31596":75285,"_21876":127342,"_5":15057,"_28736":127232,"_3095":127343},[],"Decide si la CA será raíz o intermedia.",{"_3708":75320,"_31596":75285,"_21876":127345,"_5":15057,"_28736":127232,"_3095":127346},[],"Elige el motor que custodiará la clave.",{"_3708":75321,"_31596":75285,"_21876":127348,"_5":15057,"_28736":127232,"_3095":127349},[],"Define una validez superior a la de los certificados que emitirá.",{"_3708":75322,"_31596":75285,"_21876":127351,"_5":15057,"_28736":127232,"_3095":127352},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3708":75323,"_31596":75285,"_21876":127354,"_5":15057,"_28736":127235,"_3095":127355},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3708":75324,"_31596":75285,"_21876":127357,"_5":15057,"_28736":127239,"_3095":127358},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3708":75325,"_31596":75285,"_21876":127360,"_5":15057,"_28736":127239,"_3095":127361},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3708":75326,"_31596":75285,"_21876":127363,"_5":15057,"_28736":127243,"_3095":127364},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3708":75327,"_31596":75285,"_21876":127366,"_5":15057,"_28736":127247,"_3095":127367},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3708":75328,"_31596":75285,"_21876":127369,"_5":15057,"_28736":127247,"_3095":127370},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3708":75329,"_31596":75285,"_21876":127372,"_5":15057,"_28736":127247,"_3095":127373},[],"`ST`: estado o provincia.",{"_3708":75330,"_31596":75285,"_21876":127375,"_5":15057,"_28736":127247,"_3095":127376},[],"`L`: localidad.",{"_3708":75331,"_31596":75285,"_21876":127378,"_5":15057,"_28736":127247,"_3095":127379},[],"`O`: organización.",{"_3708":75332,"_31596":75285,"_21876":127381,"_5":15057,"_28736":127247,"_3095":127382},[],"`OU`: unidad organizativa.",{"_3708":75333,"_31596":75285,"_21876":127384,"_5":15057,"_28736":127247,"_3095":127385},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3708":75334,"_31596":75285,"_21876":127387,"_5":15057,"_28736":127251,"_3095":127388},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3708":75335,"_31596":75285,"_21876":127390,"_5":15057,"_28736":127251,"_3095":127391},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3708":75336,"_31596":75285,"_21876":127393,"_5":15057,"_28736":127255,"_3095":127394},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3708":75337,"_31596":75285,"_21876":127396,"_5":15057,"_28736":127255,"_3095":127397},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3708":75338,"_31596":75285,"_21876":127399,"_5":15057,"_28736":127259,"_3095":127400},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3708":75339,"_31596":75285,"_21876":127402,"_5":15057,"_28736":127259,"_3095":127403},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3708":75340,"_31596":75285,"_21876":127405,"_5":15057,"_28736":127263,"_3095":127406},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3708":75341,"_31596":75285,"_21876":127408,"_5":15057,"_28736":127263,"_3095":127409},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3708":75342,"_31596":75285,"_21876":127411,"_5":15057,"_28736":127263,"_3095":127412},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3708":75343,"_31596":75285,"_21876":127414,"_5":15057,"_28736":127263,"_3095":127415},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3708":75344,"_31596":75285,"_21876":127417,"_5":15057,"_28736":127267,"_3095":127418},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3708":75345,"_31596":75285,"_21876":127420,"_5":15057,"_28736":127271,"_3095":127421},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3708":75346,"_31596":75285,"_21876":127423,"_5":15057,"_28736":127271,"_3095":127424},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3708":75347,"_31596":75285,"_21876":127426,"_5":15057,"_28736":127275,"_3095":127427},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3708":75348,"_31596":75285,"_21876":127429,"_5":15057,"_28736":127279,"_3095":127430},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3708":75349,"_31596":75285,"_21876":127432,"_5":15057,"_28736":127279,"_3095":127433},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3708":75350,"_31596":75285,"_21876":127435,"_5":15057,"_28736":127279,"_3095":127436},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3708":75351,"_31596":75285,"_21876":127438,"_5":15057,"_28736":127283,"_3095":127439},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3708":75352,"_31596":75285,"_21876":127441,"_5":15057,"_28736":127283,"_3095":127442},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3708":75353,"_31596":75285,"_21876":127444,"_5":15057,"_28736":127283,"_3095":127445},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3708":75354,"_31596":75285,"_21876":127447,"_5":15057,"_28736":127283,"_3095":127448},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3708":75355,"_31596":75285,"_21876":127450,"_5":15057,"_28736":127287,"_3095":127451},[],"Abre una CA desde el inventario para consultar:",{"_3708":75356,"_31596":75285,"_21876":127453,"_5":15057,"_28736":127287,"_3095":127454},[],"Estado y periodo de validez.",{"_3708":75357,"_31596":75285,"_21876":127456,"_5":15057,"_28736":127287,"_3095":127457},[],"Certificado y cadena en formato PEM.",{"_3708":75358,"_31596":75285,"_21876":127459,"_5":15057,"_28736":127287,"_3095":127460},[],"Número de certificados activos, expirados y revocados.",{"_3708":75359,"_31596":75285,"_21876":127462,"_5":15057,"_28736":127287,"_3095":127463},[],"Certificados emitidos en **Issued Certificates**.",{"_3708":75360,"_31596":75285,"_21876":127465,"_5":15057,"_28736":127287,"_3095":127466},[],"CRL vinculada a la autoridad.",{"_3708":75361,"_31596":75285,"_21876":127468,"_5":15057,"_28736":127287,"_3095":127469},[],"Metadatos y motor criptográfico asociado.",{"_3708":75362,"_31596":75285,"_21876":127471,"_5":15057,"_28736":127287,"_3095":127472},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3708":75363,"_31596":75285,"_21876":127474,"_5":15057,"_28736":127291,"_3095":127475},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3708":75364,"_31596":75285,"_21876":127477,"_5":15057,"_28736":127291,"_3095":127478},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3708":75365,"_31596":75285,"_21876":127480,"_5":15057,"_28736":127291,"_3095":127481},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3708":75366,"_31596":75285,"_21876":127483,"_5":15057,"_28736":127291,"_3095":127484},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3708":75367,"_31596":75285,"_21876":127486,"_5":15057,"_28736":127291,"_3095":127487},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3708":75368,"_31596":75285,"_21876":127489,"_5":15057,"_28736":127291,"_3095":127490},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3708":75369,"_31596":75285,"_21876":127492,"_5":15057,"_28736":127295,"_3095":127493},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3708":75370,"_31596":75285,"_21876":127495,"_5":15057,"_28736":127299,"_3095":127496},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3708":75371,"_31596":75285,"_21876":127498,"_5":15057,"_28736":127303,"_3095":127499},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3708":75372,"_31596":75285,"_21876":127501,"_5":15057,"_28736":127307,"_3095":127502},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3708":75373,"_31596":75285,"_21876":127504,"_5":15057,"_28736":127311,"_3095":127505},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3708":75374,"_31596":75285,"_21876":127507,"_5":15057,"_28736":127315,"_3095":127508},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3708":75375,"_31596":75285,"_21876":127510,"_5":15057,"_28736":127315,"_3095":127511},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3708":75376,"_31596":75285,"_21876":127513,"_5":15057,"_28736":127315,"_3095":127514},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3708":75377,"_31596":75285,"_21876":127516,"_5":15057,"_28736":127315,"_3095":127517},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3708":75378,"_31596":75285,"_21876":127519,"_5":15057,"_28736":127315,"_3095":127520},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3708":75379,"_31596":75379,"_5":15417,"_3095":127522,"_31955":127523,"_21876":127524,"_28736":75379},"Perfiles de certificado",[51485,123023,57206,127054],[],{"_3708":75380,"_31596":75379,"_21876":127526,"_5":15057,"_28736":75379,"_3095":127527},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3708":75381,"_31596":75379,"_5":31952,"_21876":127529,"_28736":127530,"_3095":127531},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3708":75382,"_31596":75379,"_5":31952,"_21876":127533,"_28736":127534,"_3095":127535},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#validez","Validez",{"_3708":75383,"_31596":75379,"_5":31952,"_21876":127537,"_28736":127538,"_3095":127539},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3708":75384,"_31596":75379,"_5":31952,"_21876":127541,"_28736":127542,"_3095":127543},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3708":75385,"_31596":75379,"_5":31952,"_21876":127545,"_28736":127546,"_3095":127547},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3708":75386,"_31596":75379,"_5":31952,"_21876":127549,"_28736":127550,"_3095":127551},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3708":75387,"_31596":75379,"_5":31952,"_21876":127553,"_28736":127554,"_3095":127555},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3708":75388,"_31596":75379,"_5":31952,"_21876":127557,"_28736":127558,"_3095":127559},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3708":75389,"_31596":75379,"_5":31952,"_21876":127561,"_28736":127562,"_3095":127563},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3708":75390,"_31596":75379,"_5":31952,"_21876":127565,"_28736":127566,"_3095":127567},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3708":75391,"_31596":75379,"_5":31952,"_21876":127569,"_28736":127570,"_3095":127571},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3708":75392,"_31596":75379,"_5":31952,"_21876":127573,"_28736":127574,"_3095":127575},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3708":75393,"_31596":75379,"_5":31952,"_21876":127577,"_28736":127578,"_3095":127579},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3708":75394,"_31596":75379,"_5":31952,"_21876":127581,"_28736":127582,"_3095":127583},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3708":75395,"_31596":75379,"_5":31952,"_21876":127585,"_28736":127586,"_3095":127587},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3708":75396,"_31596":75379,"_5":31952,"_21876":127589,"_28736":127590,"_3095":127591},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3708":75397,"_31596":75379,"_21876":127593,"_5":15057,"_28736":75379,"_3095":127594},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3708":75398,"_31596":75379,"_21876":127596,"_5":15057,"_28736":75379,"_3095":127597},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3708":75399,"_31596":75379,"_21876":127599,"_5":15057,"_28736":127534,"_3095":127600},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3708":75400,"_31596":75379,"_21876":127602,"_5":15057,"_28736":127534,"_3095":127603},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3708":75401,"_31596":75379,"_21876":127605,"_5":15057,"_28736":127538,"_3095":127606},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3708":75402,"_31596":75379,"_21876":127608,"_5":15057,"_28736":127542,"_3095":127609},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3708":75403,"_31596":75379,"_21876":127611,"_5":15057,"_28736":127542,"_3095":127612},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3708":75404,"_31596":75379,"_21876":127614,"_5":15057,"_28736":127542,"_3095":127615},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3708":75405,"_31596":75379,"_21876":127617,"_5":15057,"_28736":127546,"_3095":127618},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3708":75406,"_31596":75379,"_21876":127620,"_5":15057,"_28736":127550,"_3095":127621},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3708":75407,"_31596":75379,"_21876":127623,"_5":15057,"_28736":127550,"_3095":127624},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3708":75408,"_31596":75379,"_21876":127626,"_5":15057,"_28736":127554,"_3095":127627},[],"La aplicación criptográfica puede:",{"_3708":75409,"_31596":75379,"_21876":127629,"_5":15057,"_28736":127554,"_3095":127630},[],"permitir o bloquear claves RSA;",{"_3708":75410,"_31596":75379,"_21876":127632,"_5":15057,"_28736":127554,"_3095":127633},[],"limitar los tamaños RSA admitidos;",{"_3708":75411,"_31596":75379,"_21876":127635,"_5":15057,"_28736":127554,"_3095":127636},[],"permitir o bloquear claves ECDSA;",{"_3708":75412,"_31596":75379,"_21876":127638,"_5":15057,"_28736":127554,"_3095":127639},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3708":75413,"_31596":75379,"_21876":127641,"_5":15057,"_28736":127554,"_3095":127642},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3708":75414,"_31596":75379,"_21876":127644,"_5":15057,"_28736":127558,"_3095":127645},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3708":75415,"_31596":75379,"_21876":127647,"_5":15057,"_28736":127558,"_3095":122783},[],{"_3708":75416,"_31596":75379,"_21876":127649,"_5":15057,"_28736":127558,"_3095":127650},[],"Primera opción",{"_3708":75417,"_31596":75379,"_21876":127652,"_5":15057,"_28736":127558,"_3095":127653},[],"Segunda opción",{"_3708":75418,"_31596":75379,"_21876":127655,"_5":15057,"_28736":127558,"_3095":127656},[],"Si no hay ninguna",{"_3708":75419,"_31596":75379,"_21876":127658,"_5":15057,"_28736":127558,"_3095":127659},[],"Firma directa con una CA",{"_3708":75420,"_31596":75379,"_21876":127661,"_5":15057,"_28736":127558,"_3095":127662},[],"`issuance_profile` incluido en la solicitud",{"_3708":75421,"_31596":75379,"_21876":127664,"_5":15057,"_28736":127558,"_3095":127665},[],"`issuance_profile_id` de la solicitud",{"_3708":75422,"_31596":75379,"_21876":127667,"_5":15057,"_28736":127558,"_3095":127668},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3708":75423,"_31596":75379,"_21876":127670,"_5":15057,"_28736":127558,"_3095":127671},[],"Emisión mediante DMS",{"_3708":75424,"_31596":75379,"_21876":127673,"_5":15057,"_28736":127558,"_3095":57827},[],{"_3708":75425,"_31596":75379,"_21876":127675,"_5":15057,"_28736":127558,"_3095":127676},[],"`settings.issuance_profile` incluido en el DMS",{"_3708":75426,"_31596":75379,"_21876":127678,"_5":15057,"_28736":127558,"_3095":127679},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3708":75427,"_31596":75379,"_21876":127681,"_5":15057,"_28736":127558,"_3095":127682},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3708":75428,"_31596":75379,"_21876":127684,"_5":15057,"_28736":127558,"_3095":127685},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3708":75429,"_31596":75379,"_21876":127687,"_5":15057,"_28736":127566,"_3095":127688},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3708":75430,"_31596":75379,"_21876":127690,"_5":15057,"_28736":127570,"_3095":127691},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3708":75431,"_31596":75379,"_21876":127693,"_5":15057,"_28736":127574,"_3095":127694},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3708":75432,"_31596":75379,"_21876":127696,"_5":15057,"_28736":127578,"_3095":127697},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3708":75433,"_31596":75379,"_21876":127699,"_5":15057,"_28736":127582,"_3095":127700},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3708":75434,"_31596":75379,"_21876":127702,"_5":15057,"_28736":127582,"_3095":127703},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3708":75435,"_31596":75379,"_21876":127705,"_5":15057,"_28736":127586,"_3095":127706},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3708":75436,"_31596":75379,"_21876":127708,"_5":15057,"_28736":127586,"_3095":127709},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3708":75437,"_31596":75379,"_21876":127711,"_5":15057,"_28736":127586,"_3095":127712},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3708":75438,"_31596":75379,"_21876":127714,"_5":15057,"_28736":127586,"_3095":127715},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3708":75439,"_31596":75379,"_21876":127717,"_5":15057,"_28736":127590,"_3095":127718},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3708":75440,"_31596":75379,"_21876":127720,"_5":15057,"_28736":127590,"_3095":127721},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3708":75441,"_31596":75441,"_5":15417,"_3095":127723,"_31955":127724,"_21876":127726,"_28736":75441},"Validación de certificados",[51485,123023,57206,127725],"Validación",[],{"_3708":75442,"_31596":75441,"_21876":127728,"_5":15057,"_28736":75441,"_3095":127729},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3708":75443,"_31596":75441,"_5":31952,"_21876":127731,"_28736":127732,"_3095":127733},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3708":75444,"_31596":75441,"_5":31952,"_21876":127735,"_28736":127736,"_3095":127737},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3708":75445,"_31596":75441,"_5":31952,"_21876":127739,"_28736":127740,"_3095":127741},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3708":75446,"_31596":75441,"_21876":127743,"_5":15057,"_28736":75441,"_3095":127744},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3708":75447,"_31596":75441,"_21876":127746,"_5":15057,"_28736":127732,"_3095":127747},[],"Verifica estos criterios juntos:",{"_3708":75448,"_31596":75441,"_21876":127749,"_5":15057,"_28736":127732,"_3095":126683},[],{"_3708":75449,"_31596":75441,"_21876":127751,"_5":15057,"_28736":127732,"_3095":127752},[],"Resultado necesario",{"_3708":75450,"_31596":75441,"_21876":127754,"_5":15057,"_28736":127732,"_3095":127755},[],"Cadena y firma",{"_3708":75451,"_31596":75441,"_21876":127757,"_5":15057,"_28736":127732,"_3095":127758},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3708":75452,"_31596":75441,"_21876":127760,"_5":15057,"_28736":127732,"_3095":127761},[],"Fechas",{"_3708":75453,"_31596":75441,"_21876":127763,"_5":15057,"_28736":127732,"_3095":127764},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3708":75454,"_31596":75441,"_21876":127766,"_5":15057,"_28736":127732,"_3095":122693},[],{"_3708":75455,"_31596":75441,"_21876":127768,"_5":15057,"_28736":127732,"_3095":127769},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3708":75456,"_31596":75441,"_21876":127771,"_5":15057,"_28736":127732,"_3095":127772},[],"Uso",{"_3708":75457,"_31596":75441,"_21876":127774,"_5":15057,"_28736":127732,"_3095":127775},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3708":75458,"_31596":75441,"_21876":127777,"_5":15057,"_28736":127732,"_3095":127778},[],"Revocación",{"_3708":75459,"_31596":75441,"_21876":127780,"_5":15057,"_28736":127732,"_3095":127781},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3708":75460,"_31596":75441,"_21876":127783,"_5":15057,"_28736":127732,"_3095":127784},[],"Autorización",{"_3708":75461,"_31596":75441,"_21876":127786,"_5":15057,"_28736":127732,"_3095":127787},[],"La aplicación permite la acción a esa identidad.",{"_3708":75462,"_31596":75441,"_21876":127789,"_5":15057,"_28736":127732,"_3095":127790},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3708":75463,"_31596":75441,"_21876":127792,"_5":15057,"_28736":127736,"_3095":127793},[],"Mecanismo",{"_3708":75464,"_31596":75441,"_21876":127795,"_5":15057,"_28736":127736,"_3095":127796},[],"Cuándo utilizarlo",{"_3708":75465,"_31596":75441,"_21876":127798,"_5":15057,"_28736":127736,"_3095":127799},[],"Qué debes mantener",{"_3708":75466,"_31596":75441,"_21876":127801,"_5":15057,"_28736":127736,"_3095":57955},[],{"_3708":75467,"_31596":75441,"_21876":127803,"_5":15057,"_28736":127736,"_3095":127804},[],"Consulta del estado de un certificado concreto.",{"_3708":75468,"_31596":75441,"_21876":127806,"_5":15057,"_28736":127736,"_3095":127807},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3708":75469,"_31596":75441,"_21876":127809,"_5":15057,"_28736":127736,"_3095":57964},[],{"_3708":75470,"_31596":75441,"_21876":127811,"_5":15057,"_28736":127736,"_3095":127812},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3708":75471,"_31596":75441,"_21876":127814,"_5":15057,"_28736":127736,"_3095":127815},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3708":75472,"_31596":75441,"_21876":127817,"_5":15057,"_28736":127736,"_3095":127818},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3708":75473,"_31596":75441,"_21876":127820,"_5":15057,"_28736":127736,"_3095":127821},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3708":75474,"_31596":75441,"_21876":127823,"_5":15057,"_28736":127740,"_3095":127824},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3708":75475,"_31596":75441,"_21876":127826,"_5":15057,"_28736":127740,"_3095":127827},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3708":75476,"_31596":75441,"_21876":127829,"_5":15057,"_28736":127740,"_3095":127830},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3708":75477,"_31596":75441,"_21876":127832,"_5":15057,"_28736":127740,"_3095":127833},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3708":75478,"_31596":75441,"_21876":127835,"_5":15057,"_28736":127740,"_3095":127836},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3708":75479,"_31596":75441,"_21876":127838,"_5":15057,"_28736":127740,"_3095":127839},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3708":75480,"_31596":75441,"_21876":127841,"_5":15057,"_28736":127740,"_3095":127842},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3708":75481,"_31596":75441,"_21876":127844,"_5":15057,"_28736":127740,"_3095":127845},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3708":75482,"_31596":75441,"_21876":127847,"_5":15057,"_28736":127740,"_3095":127848},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3708":75483,"_31596":75483,"_5":15417,"_3095":127850,"_31955":127851,"_21876":127852,"_28736":75483},"Certificados",[51485,123023,57206,127054],[],{"_3708":75484,"_31596":75483,"_21876":127854,"_5":15057,"_28736":75483,"_3095":127855},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3708":75485,"_31596":75483,"_5":31952,"_21876":127857,"_28736":127858,"_3095":127859},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3708":75486,"_31596":75483,"_5":31952,"_21876":127861,"_28736":127862,"_3095":127863},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3708":75487,"_31596":75483,"_5":31952,"_21876":127865,"_28736":127866,"_3095":127867},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3708":75488,"_31596":75483,"_5":31952,"_21876":127869,"_28736":127870,"_3095":127871},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3708":75489,"_31596":75483,"_5":31952,"_21876":127873,"_28736":127874,"_3095":127875},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3708":75490,"_31596":75483,"_5":31952,"_21876":127877,"_28736":127878,"_3095":127879},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3708":75491,"_31596":75483,"_5":31952,"_21876":127881,"_28736":127882,"_3095":127883},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3708":75492,"_31596":75483,"_5":31952,"_21876":127885,"_28736":127886,"_3095":127887},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3708":75493,"_31596":75483,"_5":31952,"_21876":127889,"_28736":127890,"_3095":127891},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#continúa","Continúa",{"_3708":75494,"_31596":75483,"_21876":127893,"_5":15057,"_28736":75483,"_3095":127894},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3708":75495,"_31596":75483,"_21876":127896,"_5":15057,"_28736":127858,"_3095":127897},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3708":75496,"_31596":75483,"_21876":127899,"_5":15057,"_28736":127858,"_3095":127900},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3708":75497,"_31596":75483,"_21876":127902,"_5":15057,"_28736":127858,"_3095":127903},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3708":75498,"_31596":75483,"_21876":127905,"_5":15057,"_28736":127858,"_3095":127906},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3708":75499,"_31596":75483,"_21876":127908,"_5":15057,"_28736":127858,"_3095":127909},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3708":75500,"_31596":75483,"_21876":127911,"_5":15057,"_28736":127858,"_3095":127912},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3708":75501,"_31596":75483,"_21876":127914,"_5":15057,"_28736":127858,"_3095":127915},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3708":75502,"_31596":75483,"_21876":127917,"_5":15057,"_28736":127862,"_3095":127918},[],"Descarga el PEM e inspecciónalo:",{"_3708":75503,"_31596":75483,"_21876":127920,"_5":15057,"_28736":127862,"_3095":127921},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3708":75504,"_31596":75483,"_21876":127923,"_5":15057,"_28736":127866,"_3095":127924},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3708":75505,"_31596":75483,"_21876":127926,"_5":15057,"_28736":127866,"_3095":127927},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3708":75506,"_31596":75483,"_21876":127929,"_5":15057,"_28736":127866,"_3095":127930},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3708":75507,"_31596":75483,"_21876":127932,"_5":15057,"_28736":127866,"_3095":127933},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3708":75508,"_31596":75483,"_21876":127935,"_5":15057,"_28736":127866,"_3095":127936},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3708":75509,"_31596":75483,"_21876":127938,"_5":15057,"_28736":127866,"_3095":127939},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3708":75510,"_31596":75483,"_21876":127941,"_5":15057,"_28736":127866,"_3095":127942},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3708":75511,"_31596":75483,"_21876":127944,"_5":15057,"_28736":127870,"_3095":127945},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3708":75512,"_31596":75483,"_21876":127947,"_5":15057,"_28736":127874,"_3095":127948},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3708":75513,"_31596":75483,"_21876":127950,"_5":15057,"_28736":127878,"_3095":127951},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3708":75514,"_31596":75483,"_21876":127953,"_5":15057,"_28736":127882,"_3095":127954},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3708":75515,"_31596":75483,"_21876":127956,"_5":15057,"_28736":127882,"_3095":127957},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3708":75516,"_31596":75483,"_21876":127959,"_5":15057,"_28736":127882,"_3095":127960},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3708":75517,"_31596":75483,"_21876":127962,"_5":15057,"_28736":127886,"_3095":127963},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3708":75518,"_31596":75483,"_21876":127965,"_5":15057,"_28736":127886,"_3095":127966},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3708":75519,"_31596":75483,"_21876":127968,"_5":15057,"_28736":127886,"_3095":127969},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3708":75520,"_31596":75483,"_21876":127971,"_5":15057,"_28736":127890,"_3095":127972},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3708":75521,"_31596":75483,"_21876":127974,"_5":15057,"_28736":127890,"_3095":127975},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3708":75522,"_31596":75522,"_5":15417,"_3095":127977,"_31955":127978,"_21876":127980,"_28736":75522},"Ciclo de vida de un certificado",[51485,123023,57206,127979],"Conceptos",[],{"_3708":75523,"_31596":75522,"_21876":127982,"_5":15057,"_28736":75522,"_3095":127983},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3708":75524,"_31596":75522,"_5":31952,"_21876":127985,"_28736":127986,"_3095":127987},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3708":75525,"_31596":75522,"_5":31952,"_21876":127989,"_28736":127990,"_3095":127991},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3708":75526,"_31596":75522,"_5":31952,"_21876":127993,"_28736":127994,"_3095":127995},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3708":75527,"_31596":75522,"_5":31952,"_21876":127997,"_28736":127998,"_3095":127999},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3708":75528,"_31596":75522,"_5":31952,"_21876":128001,"_28736":128002,"_3095":128003},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3708":75529,"_31596":75522,"_5":31952,"_21876":128005,"_28736":128006,"_3095":128007},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3708":75530,"_31596":75522,"_5":31952,"_21876":128009,"_28736":128010,"_3095":125677},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3708":75531,"_31596":75522,"_5":31952,"_21876":128012,"_28736":128013,"_3095":128014},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3708":75532,"_31596":75522,"_5":31952,"_21876":128016,"_28736":128017,"_3095":128018},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3708":75533,"_31596":75522,"_5":31952,"_21876":128020,"_28736":128021,"_3095":128022},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3708":75534,"_31596":75522,"_21876":128024,"_5":15057,"_28736":75522,"_3095":128025},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3708":75535,"_31596":75522,"_21876":128027,"_5":15057,"_28736":127990,"_3095":128028},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3708":75536,"_31596":75522,"_21876":128030,"_5":15057,"_28736":127994,"_3095":128031},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3708":75537,"_31596":75522,"_21876":128033,"_5":15057,"_28736":127998,"_3095":128034},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3708":75538,"_31596":75522,"_21876":128036,"_5":15057,"_28736":128002,"_3095":128037},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3708":75539,"_31596":75522,"_21876":128039,"_5":15057,"_28736":128006,"_3095":128040},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3708":75540,"_31596":75522,"_21876":128042,"_5":15057,"_28736":128010,"_3095":128043},[],"Lamassu persiste cuatro estados X.509:",{"_3708":75541,"_31596":75522,"_21876":128045,"_5":15057,"_28736":128010,"_3095":128046},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3708":75542,"_31596":75522,"_21876":128048,"_5":15057,"_28736":128010,"_3095":128049},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3708":75543,"_31596":75522,"_21876":128051,"_5":15057,"_28736":128010,"_3095":128052},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3708":75544,"_31596":75522,"_21876":128054,"_5":15057,"_28736":128010,"_3095":128055},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3708":75545,"_31596":75522,"_21876":128057,"_5":15057,"_28736":128010,"_3095":128058},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3708":75546,"_31596":75522,"_21876":128060,"_5":15057,"_28736":128013,"_3095":128061},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3708":75547,"_31596":75522,"_21876":128063,"_5":15057,"_28736":128013,"_3095":128064},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3708":75548,"_31596":75522,"_21876":128066,"_5":15057,"_28736":128013,"_3095":128067},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3708":75549,"_31596":75522,"_21876":128069,"_5":15057,"_28736":128017,"_3095":128070},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3708":75550,"_31596":75522,"_21876":128072,"_5":15057,"_28736":128017,"_3095":128073},[],"Antes de confirmar:",{"_3708":75551,"_31596":75522,"_21876":128075,"_5":15057,"_28736":128017,"_3095":128076},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3708":75552,"_31596":75522,"_21876":128078,"_5":15057,"_28736":128017,"_3095":128079},[],"Distribuye la nueva cadena de confianza.",{"_3708":75553,"_31596":75522,"_21876":128081,"_5":15057,"_28736":128017,"_3095":128082},[],"Reemite las identidades necesarias.",{"_3708":75554,"_31596":75522,"_21876":128084,"_5":15057,"_28736":128017,"_3095":128085},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3708":75555,"_31596":75522,"_21876":128087,"_5":15057,"_28736":128017,"_3095":128088},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3708":75556,"_31596":75522,"_21876":128090,"_5":15057,"_28736":128017,"_3095":128091},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3708":75557,"_31596":75522,"_21876":128093,"_5":15057,"_28736":128021,"_3095":128094},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3708":75558,"_31596":75522,"_21876":128096,"_5":15057,"_28736":128021,"_3095":128097},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3708":75559,"_31596":75522,"_21876":128099,"_5":15057,"_28736":128021,"_3095":128100},[],"Cambios de estado y razones de revocación.",{"_3708":75560,"_31596":75522,"_21876":128102,"_5":15057,"_28736":128021,"_3095":128103},[],"Publicación y vigencia de OCSP y CRLs.",{"_3708":75561,"_31596":75522,"_21876":128105,"_5":15057,"_28736":128021,"_3095":128106},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3708":75562,"_31596":75522,"_21876":128108,"_5":15057,"_28736":128021,"_3095":128109},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3708":75563,"_31596":75563,"_5":15417,"_3095":128111,"_31955":128112,"_21876":128113,"_28736":75563},"Modelo de confianza",[51485,123023,57206,127979],[],{"_3708":75564,"_31596":75563,"_21876":128115,"_5":15057,"_28736":75563,"_3095":128116},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3708":75565,"_31596":75563,"_5":31952,"_21876":128118,"_28736":128119,"_3095":128120},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3708":75566,"_31596":75563,"_5":31952,"_21876":128122,"_28736":128123,"_3095":128124},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3708":75567,"_31596":75563,"_5":31952,"_21876":128126,"_28736":128127,"_3095":128128},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3708":75568,"_31596":75563,"_5":31952,"_21876":128130,"_28736":128131,"_3095":128132},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3708":75569,"_31596":75563,"_5":31952,"_21876":128134,"_28736":128135,"_3095":128136},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3708":75570,"_31596":75563,"_5":31952,"_21876":128138,"_28736":128139,"_3095":128140},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3708":75571,"_31596":75563,"_5":31952,"_21876":128142,"_28736":128143,"_3095":128144},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3708":75572,"_31596":75563,"_5":31952,"_21876":128146,"_28736":128147,"_3095":128148},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3708":75573,"_31596":75563,"_5":31952,"_21876":128150,"_28736":128151,"_3095":128152},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3708":75574,"_31596":75563,"_5":31952,"_21876":128154,"_28736":128155,"_3095":128156},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3708":75575,"_31596":75563,"_21876":128158,"_5":15057,"_28736":75563,"_3095":128159},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3708":75576,"_31596":75563,"_21876":128161,"_5":15057,"_28736":128123,"_3095":128162},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3708":75577,"_31596":75563,"_21876":128164,"_5":15057,"_28736":128127,"_3095":128165},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3708":75578,"_31596":75563,"_21876":128167,"_5":15057,"_28736":128131,"_3095":128168},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3708":75579,"_31596":75563,"_21876":128170,"_5":15057,"_28736":128135,"_3095":128171},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3708":75580,"_31596":75563,"_21876":128173,"_5":15057,"_28736":128139,"_3095":128174},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3708":75581,"_31596":75563,"_21876":128176,"_5":15057,"_28736":128139,"_3095":128177},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3708":75582,"_31596":75563,"_21876":128179,"_5":15057,"_28736":128139,"_3095":128180},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3708":75583,"_31596":75563,"_21876":128182,"_5":15057,"_28736":128139,"_3095":128183},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3708":75584,"_31596":75563,"_21876":128185,"_5":15057,"_28736":128139,"_3095":128186},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3708":75585,"_31596":75563,"_21876":128188,"_5":15057,"_28736":128139,"_3095":128189},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3708":75586,"_31596":75563,"_21876":128191,"_5":15057,"_28736":128143,"_3095":128192},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3708":75587,"_31596":75563,"_21876":128194,"_5":15057,"_28736":128143,"_3095":128195},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3708":75588,"_31596":75563,"_21876":128197,"_5":15057,"_28736":128143,"_3095":128198},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3708":75589,"_31596":75563,"_21876":128200,"_5":15057,"_28736":128143,"_3095":128201},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3708":75590,"_31596":75563,"_21876":128203,"_5":15057,"_28736":128143,"_3095":128204},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3708":75591,"_31596":75563,"_21876":128206,"_5":15057,"_28736":128147,"_3095":128207},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3708":75592,"_31596":75563,"_21876":128209,"_5":15057,"_28736":128147,"_3095":128210},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3708":75593,"_31596":75563,"_21876":128212,"_5":15057,"_28736":128147,"_3095":128213},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3708":75594,"_31596":75563,"_21876":128215,"_5":15057,"_28736":128147,"_3095":128216},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3708":75595,"_31596":75563,"_21876":128218,"_5":15057,"_28736":128147,"_3095":128219},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3708":75596,"_31596":75563,"_21876":128221,"_5":15057,"_28736":128147,"_3095":128222},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3708":75597,"_31596":75563,"_21876":128224,"_5":15057,"_28736":128147,"_3095":128225},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3708":75598,"_31596":75563,"_21876":128227,"_5":15057,"_28736":128151,"_3095":128228},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3708":75599,"_31596":75563,"_21876":128230,"_5":15057,"_28736":128155,"_3095":128231},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3708":75600,"_31596":75563,"_21876":128233,"_5":15057,"_28736":128155,"_3095":128234},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3708":75601,"_31596":75563,"_21876":128236,"_5":15057,"_28736":128155,"_3095":128237},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3708":75602,"_31596":75563,"_21876":128239,"_5":15057,"_28736":128155,"_3095":128240},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3708":75603,"_31596":75563,"_21876":128242,"_5":15057,"_28736":128155,"_3095":128243},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3708":75604,"_31596":75563,"_21876":128245,"_5":15057,"_28736":128155,"_3095":128246},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3708":75605,"_31596":75563,"_21876":128248,"_5":15057,"_28736":128155,"_3095":128249},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3708":75606,"_31596":75606,"_5":15417,"_3095":128251,"_31955":128252,"_21876":128253,"_28736":75606},"Listas de revocación (CRL)",[51485,123023,57206,127725],[],{"_3708":75607,"_31596":75606,"_21876":128255,"_5":15057,"_28736":75606,"_3095":128256},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3708":75608,"_31596":75606,"_5":31952,"_21876":128258,"_28736":128259,"_3095":128260},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3708":75609,"_31596":75606,"_5":31952,"_21876":128262,"_28736":128263,"_3095":128264},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3708":75610,"_31596":75606,"_5":31952,"_21876":128266,"_28736":128267,"_3095":128268},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3708":75611,"_31596":75606,"_5":31952,"_21876":128270,"_28736":128271,"_3095":128272},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3708":75612,"_31596":75606,"_5":31952,"_21876":128274,"_28736":128275,"_3095":128276},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3708":75613,"_31596":75606,"_5":31952,"_21876":128278,"_28736":128279,"_3095":128280},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3708":75614,"_31596":75606,"_5":31952,"_21876":128282,"_28736":128283,"_3095":128284},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3708":75615,"_31596":75606,"_5":31952,"_21876":128286,"_28736":128287,"_3095":128288},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#referencias","Referencias",{"_3708":75616,"_31596":75606,"_21876":128290,"_5":15057,"_28736":75606,"_3095":128291},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3708":75617,"_31596":75606,"_21876":128293,"_5":15057,"_28736":128259,"_3095":128294},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3708":75618,"_31596":75606,"_21876":128296,"_5":15057,"_28736":128259,"_3095":128297},[],"Campo",{"_3708":75619,"_31596":75606,"_21876":128299,"_5":15057,"_28736":128259,"_3095":124718},[],{"_3708":75620,"_31596":75606,"_21876":128301,"_5":15057,"_28736":128259,"_3095":53143},[],{"_3708":75621,"_31596":75606,"_21876":128303,"_5":15057,"_28736":128259,"_3095":128304},[],"ID de la CA a la que pertenecen los ajustes.",{"_3708":75622,"_31596":75606,"_21876":128306,"_5":15057,"_28736":128259,"_3095":58463},[],{"_3708":75623,"_31596":75606,"_21876":128308,"_5":15057,"_28736":128259,"_3095":128309},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3708":75624,"_31596":75606,"_21876":128311,"_5":15057,"_28736":128259,"_3095":58469},[],{"_3708":75625,"_31596":75606,"_21876":128313,"_5":15057,"_28736":128259,"_3095":128314},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3708":75626,"_31596":75606,"_21876":128316,"_5":15057,"_28736":128259,"_3095":58475},[],{"_3708":75627,"_31596":75606,"_21876":128318,"_5":15057,"_28736":128259,"_3095":128319},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3708":75628,"_31596":75606,"_21876":128321,"_5":15057,"_28736":128259,"_3095":128322},[],"Campo de `crl_options`",{"_3708":75629,"_31596":75606,"_21876":128324,"_5":15057,"_28736":128259,"_3095":124718},[],{"_3708":75630,"_31596":75606,"_21876":128326,"_5":15057,"_28736":128259,"_3095":128327},[],"Valor inicial",{"_3708":75631,"_31596":75606,"_21876":128329,"_5":15057,"_28736":128259,"_3095":58489},[],{"_3708":75632,"_31596":75606,"_21876":128331,"_5":15057,"_28736":128259,"_3095":128332},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3708":75633,"_31596":75606,"_21876":128334,"_5":15057,"_28736":128259,"_3095":128335},[],"7 días.",{"_3708":75634,"_31596":75606,"_21876":128337,"_5":15057,"_28736":128259,"_3095":58498},[],{"_3708":75635,"_31596":75606,"_21876":128339,"_5":15057,"_28736":128259,"_3095":128340},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3708":75636,"_31596":75606,"_21876":128342,"_5":15057,"_28736":128259,"_3095":128343},[],"6 días y 23 horas.",{"_3708":75637,"_31596":75606,"_21876":128345,"_5":15057,"_28736":128259,"_3095":58507},[],{"_3708":75638,"_31596":75606,"_21876":128347,"_5":15057,"_28736":128259,"_3095":128348},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3708":75639,"_31596":75606,"_21876":128350,"_5":15057,"_28736":128259,"_3095":58513},[],{"_3708":75640,"_31596":75606,"_21876":128352,"_5":15057,"_28736":128259,"_3095":58516},[],{"_3708":75641,"_31596":75606,"_21876":128354,"_5":15057,"_28736":128259,"_3095":128355},[],"Número de serie del certificado existente que firma la CRL.",{"_3708":75642,"_31596":75606,"_21876":128357,"_5":15057,"_28736":128259,"_3095":128358},[],"Número de serie del certificado actual de la CA.",{"_3708":75643,"_31596":75606,"_21876":128360,"_5":15057,"_28736":128259,"_3095":128361},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3708":75644,"_31596":75606,"_21876":128363,"_5":15057,"_28736":128259,"_3095":128364},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3708":75645,"_31596":75606,"_21876":128366,"_5":15057,"_28736":128259,"_3095":128367},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3708":75646,"_31596":75606,"_21876":128369,"_5":15057,"_28736":128259,"_3095":128370},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3708":75647,"_31596":75606,"_21876":128372,"_5":15057,"_28736":128259,"_3095":128373},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3708":75648,"_31596":75606,"_21876":128375,"_5":15057,"_28736":128259,"_3095":128376},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3708":75649,"_31596":75606,"_21876":128378,"_5":15057,"_28736":128259,"_3095":128379},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3708":75650,"_31596":75606,"_21876":128381,"_5":15057,"_28736":128259,"_3095":128382},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3708":75651,"_31596":75606,"_21876":128384,"_5":15057,"_28736":128259,"_3095":128385},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3708":75652,"_31596":75606,"_21876":128387,"_5":15057,"_28736":128259,"_3095":128388},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3708":75653,"_31596":75606,"_21876":128390,"_5":15057,"_28736":128259,"_3095":128391},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3708":75654,"_31596":75606,"_21876":128393,"_5":15057,"_28736":128263,"_3095":128394},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3708":75655,"_31596":75606,"_21876":128396,"_5":15057,"_28736":128263,"_3095":128397},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3708":75656,"_31596":75606,"_21876":128399,"_5":15057,"_28736":128263,"_3095":128400},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3708":75657,"_31596":75606,"_21876":128402,"_5":15057,"_28736":128263,"_3095":128403},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3708":75658,"_31596":75606,"_21876":128405,"_5":15057,"_28736":128267,"_3095":128406},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3708":75659,"_31596":75606,"_21876":128408,"_5":15057,"_28736":128267,"_3095":128409},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3708":75660,"_31596":75606,"_21876":128411,"_5":15057,"_28736":128267,"_3095":128412},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3708":75661,"_31596":75606,"_21876":128414,"_5":15057,"_28736":128267,"_3095":128415},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3708":75662,"_31596":75606,"_21876":128417,"_5":15057,"_28736":128267,"_3095":128418},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3708":75663,"_31596":75606,"_21876":128420,"_5":15057,"_28736":128267,"_3095":128421},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3708":75664,"_31596":75606,"_21876":128423,"_5":15057,"_28736":128267,"_3095":128424},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3708":75665,"_31596":75606,"_21876":128426,"_5":15057,"_28736":128267,"_3095":128427},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3708":75666,"_31596":75606,"_21876":128429,"_5":15057,"_28736":128267,"_3095":128430},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3708":75667,"_31596":75606,"_21876":128432,"_5":15057,"_28736":128271,"_3095":128433},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3708":75668,"_31596":75606,"_21876":128435,"_5":15057,"_28736":128271,"_3095":128436},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3708":75669,"_31596":75606,"_21876":128438,"_5":15057,"_28736":128275,"_3095":128439},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3708":75670,"_31596":75606,"_21876":128441,"_5":15057,"_28736":128275,"_3095":128442},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3708":75671,"_31596":75606,"_21876":128444,"_5":15057,"_28736":128275,"_3095":128445},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3708":75672,"_31596":75606,"_21876":128447,"_5":15057,"_28736":128275,"_3095":128448},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3708":75673,"_31596":75606,"_21876":128450,"_5":15057,"_28736":128275,"_3095":128451},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3708":75674,"_31596":75606,"_21876":128453,"_5":15057,"_28736":128279,"_3095":128454},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3708":75675,"_31596":75606,"_21876":128456,"_5":15057,"_28736":128279,"_3095":124907},[],{"_3708":75676,"_31596":75606,"_21876":128458,"_5":15057,"_28736":128279,"_3095":128459},[],"Path relativo",{"_3708":75677,"_31596":75606,"_21876":128461,"_5":15057,"_28736":128279,"_3095":122783},[],{"_3708":75678,"_31596":75606,"_21876":128463,"_5":15057,"_28736":128279,"_3095":58628},[],{"_3708":75679,"_31596":75606,"_21876":128465,"_5":15057,"_28736":128279,"_3095":58631},[],{"_3708":75680,"_31596":75606,"_21876":128467,"_5":15057,"_28736":128279,"_3095":128468},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3708":75681,"_31596":75606,"_21876":128470,"_5":15057,"_28736":128279,"_3095":58628},[],{"_3708":75682,"_31596":75606,"_21876":128472,"_5":15057,"_28736":128279,"_3095":58639},[],{"_3708":75683,"_31596":75606,"_21876":128474,"_5":15057,"_28736":128279,"_3095":128475},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3708":75684,"_31596":75606,"_21876":128477,"_5":15057,"_28736":128279,"_3095":58645},[],{"_3708":75685,"_31596":75606,"_21876":128479,"_5":15057,"_28736":128279,"_3095":58639},[],{"_3708":75686,"_31596":75606,"_21876":128481,"_5":15057,"_28736":128279,"_3095":128482},[],"Sustituir la configuración de CRL de una CA.",{"_3708":75687,"_31596":75606,"_21876":128484,"_5":15057,"_28736":128279,"_3095":58653},[],{"_3708":75688,"_31596":75606,"_21876":128486,"_5":15057,"_28736":128279,"_3095":58639},[],{"_3708":75689,"_31596":75606,"_21876":128488,"_5":15057,"_28736":128279,"_3095":128489},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3708":75690,"_31596":75606,"_21876":128491,"_5":15057,"_28736":128279,"_3095":128492},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3708":75691,"_31596":75606,"_21876":128494,"_5":15057,"_28736":128279,"_3095":128495},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3708":75692,"_31596":75606,"_21876":128497,"_5":15057,"_28736":128279,"_3095":128498},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3708":75693,"_31596":75606,"_21876":128500,"_5":15057,"_28736":128283,"_3095":128501},[],"Síntoma",{"_3708":75694,"_31596":75606,"_21876":128503,"_5":15057,"_28736":128283,"_3095":128504},[],"Causa",{"_3708":75695,"_31596":75606,"_21876":128506,"_5":15057,"_28736":128283,"_3095":128507},[],"Acción",{"_3708":75696,"_31596":75606,"_21876":128509,"_5":15057,"_28736":128283,"_3095":128510},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3708":75697,"_31596":75606,"_21876":128512,"_5":15057,"_28736":128283,"_3095":128513},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3708":75698,"_31596":75606,"_21876":128515,"_5":15057,"_28736":128283,"_3095":128516},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3708":75699,"_31596":75606,"_21876":128518,"_5":15057,"_28736":128283,"_3095":128519},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3708":75700,"_31596":75606,"_21876":128521,"_5":15057,"_28736":128283,"_3095":128522},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3708":75701,"_31596":75606,"_21876":128524,"_5":15057,"_28736":128283,"_3095":128525},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3708":75702,"_31596":75606,"_21876":128527,"_5":15057,"_28736":128283,"_3095":128528},[],"`PUT` devuelve 400.",{"_3708":75703,"_31596":75606,"_21876":128530,"_5":15057,"_28736":128283,"_3095":128531},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3708":75704,"_31596":75606,"_21876":128533,"_5":15057,"_28736":128283,"_3095":128534},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3708":75705,"_31596":75606,"_21876":128536,"_5":15057,"_28736":128283,"_3095":128537},[],"`PUT` devuelve 404.",{"_3708":75706,"_31596":75606,"_21876":128539,"_5":15057,"_28736":128283,"_3095":128540},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3708":75707,"_31596":75606,"_21876":128542,"_5":15057,"_28736":128283,"_3095":128543},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3708":75708,"_31596":75606,"_21876":128545,"_5":15057,"_28736":128283,"_3095":128546},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3708":75709,"_31596":75606,"_21876":128548,"_5":15057,"_28736":128283,"_3095":128549},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3708":75710,"_31596":75606,"_21876":128551,"_5":15057,"_28736":128283,"_3095":128552},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3708":75711,"_31596":75606,"_21876":128554,"_5":15057,"_28736":128283,"_3095":128555},[],"La CRL no cambia tras revocar un certificado.",{"_3708":75712,"_31596":75606,"_21876":128557,"_5":15057,"_28736":128283,"_3095":128558},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3708":75713,"_31596":75606,"_21876":128560,"_5":15057,"_28736":128283,"_3095":128561},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3708":75714,"_31596":75606,"_21876":128563,"_5":15057,"_28736":128283,"_3095":128564},[],"Un verificador rechaza la CRL por el emisor.",{"_3708":75715,"_31596":75606,"_21876":128566,"_5":15057,"_28736":128283,"_3095":128567},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3708":75716,"_31596":75606,"_21876":128569,"_5":15057,"_28736":128283,"_3095":128570},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3708":75717,"_31596":75606,"_21876":128572,"_5":15057,"_28736":128287,"_3095":128573},[],"RFC 5280: perfil X.509 y CRL.",{"_3708":75718,"_31596":75606,"_21876":128575,"_5":15057,"_28736":128287,"_3095":58745},[],{"_3708":75719,"_31596":75606,"_21876":128577,"_5":15057,"_28736":128287,"_3095":58748},[],{"_3708":75720,"_31596":75606,"_21876":128579,"_5":15057,"_28736":128287,"_3095":128580},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3708":75721,"_31596":75606,"_21876":128582,"_5":15057,"_28736":128287,"_3095":128583},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3708":75722,"_31596":75722,"_5":15417,"_3095":128585,"_31955":128586,"_21876":128587,"_28736":75722},"Claves y motores criptográficos",[51485,123023,57206,127054],[],{"_3708":75723,"_31596":75722,"_21876":128589,"_5":15057,"_28736":75722,"_3095":128590},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3708":75724,"_31596":75722,"_5":31952,"_21876":128592,"_28736":128593,"_3095":128594},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3708":75725,"_31596":75722,"_5":31952,"_21876":128596,"_28736":128597,"_3095":128598},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3708":75726,"_31596":75722,"_5":31952,"_21876":128600,"_28736":128601,"_3095":58773},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#file-system",{"_3708":75727,"_31596":75722,"_5":31952,"_21876":128603,"_28736":128604,"_3095":58777},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#hashicorp-vault",{"_3708":75728,"_31596":75722,"_5":31952,"_21876":128606,"_28736":128607,"_3095":58781},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#aws-secrets-manager",{"_3708":75729,"_31596":75722,"_5":31952,"_21876":128609,"_28736":128610,"_3095":58785},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#aws-kms",{"_3708":75730,"_31596":75722,"_5":31952,"_21876":128612,"_28736":128613,"_3095":58789},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#pkcs11",{"_3708":75731,"_31596":75722,"_5":31952,"_21876":128615,"_28736":128616,"_3095":58793},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#azure-key-vault",{"_3708":75732,"_31596":75722,"_5":31952,"_21876":128618,"_28736":128619,"_3095":128620},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3708":75733,"_31596":75722,"_5":31952,"_21876":128622,"_28736":128623,"_3095":128624},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3708":75734,"_31596":75722,"_5":31952,"_21876":128626,"_28736":128627,"_3095":128628},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3708":75735,"_31596":75722,"_5":31952,"_21876":128630,"_28736":128631,"_3095":128632},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3708":75736,"_31596":75722,"_5":31952,"_21876":128634,"_28736":128635,"_3095":128636},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3708":75737,"_31596":75722,"_5":31952,"_21876":128638,"_28736":128639,"_3095":128640},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3708":75738,"_31596":75722,"_5":31952,"_21876":128642,"_28736":128643,"_3095":128644},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3708":75739,"_31596":75722,"_5":31952,"_21876":128646,"_28736":128647,"_3095":58825},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#sign",{"_3708":75740,"_31596":75722,"_5":31952,"_21876":128649,"_28736":128650,"_3095":58829},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#verify",{"_3708":75741,"_31596":75722,"_5":31952,"_21876":128652,"_28736":128653,"_3095":128654},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3708":75742,"_31596":75722,"_5":31952,"_21876":128656,"_28736":128657,"_3095":128658},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3708":75743,"_31596":75722,"_5":31952,"_21876":128660,"_28736":128661,"_3095":128662},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3708":75744,"_31596":75722,"_21876":128664,"_5":15057,"_28736":75722,"_3095":128665},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3708":75745,"_31596":75722,"_21876":128667,"_5":15057,"_28736":75722,"_3095":128668},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3708":75746,"_31596":75722,"_21876":128670,"_5":15057,"_28736":128593,"_3095":128671},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3708":75747,"_31596":75722,"_21876":128673,"_5":15057,"_28736":128593,"_3095":128674},[],"En la práctica, permite:",{"_3708":75748,"_31596":75722,"_21876":128676,"_5":15057,"_28736":128593,"_3095":128677},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3708":75749,"_31596":75722,"_21876":128679,"_5":15057,"_28736":128593,"_3095":128680},[],"Importar claves creadas externamente.",{"_3708":75750,"_31596":75722,"_21876":128682,"_5":15057,"_28736":128593,"_3095":128683},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3708":75751,"_31596":75722,"_21876":128685,"_5":15057,"_28736":128593,"_3095":128686},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3708":75752,"_31596":75722,"_21876":128688,"_5":15057,"_28736":128597,"_3095":128689},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3708":75753,"_31596":75722,"_21876":128691,"_5":15057,"_28736":128597,"_3095":128692},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3708":75754,"_31596":75722,"_21876":128694,"_5":15057,"_28736":128597,"_3095":128695},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3708":75755,"_31596":75722,"_21876":128697,"_5":15057,"_28736":128601,"_3095":128698},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3708":75756,"_31596":75722,"_21876":128700,"_5":15057,"_28736":128604,"_3095":128701},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3708":75757,"_31596":75722,"_21876":128703,"_5":15057,"_28736":128604,"_3095":128704},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3708":75758,"_31596":75722,"_21876":128706,"_5":15057,"_28736":128607,"_3095":128707},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3708":75759,"_31596":75722,"_21876":128709,"_5":15057,"_28736":128610,"_3095":128710},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3708":75760,"_31596":75722,"_21876":128712,"_5":15057,"_28736":128613,"_3095":128713},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3708":75761,"_31596":75722,"_21876":128715,"_5":15057,"_28736":128616,"_3095":128716},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3708":75762,"_31596":75722,"_21876":128718,"_5":15057,"_28736":128616,"_3095":128719},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3708":75763,"_31596":75722,"_21876":128721,"_5":15057,"_28736":128616,"_3095":128722},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3708":75764,"_31596":75722,"_21876":128724,"_5":15057,"_28736":128616,"_3095":128725},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3708":75765,"_31596":75722,"_21876":128727,"_5":15057,"_28736":128619,"_3095":128728},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3708":75766,"_31596":75722,"_21876":128730,"_5":15057,"_28736":128619,"_3095":128731},[],"La tabla incluye los siguientes campos:",{"_3708":75767,"_31596":75722,"_21876":128733,"_5":15057,"_28736":128619,"_3095":128734},[],"**Name**: nombre descriptivo de la clave.",{"_3708":75768,"_31596":75722,"_21876":128736,"_5":15057,"_28736":128619,"_3095":128737},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3708":75769,"_31596":75722,"_21876":128739,"_5":15057,"_28736":128619,"_3095":128740},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3708":75770,"_31596":75722,"_21876":128742,"_5":15057,"_28736":128619,"_3095":128743},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3708":75771,"_31596":75722,"_21876":128745,"_5":15057,"_28736":128619,"_3095":128746},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3708":75772,"_31596":75722,"_21876":128748,"_5":15057,"_28736":128619,"_3095":128749},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3708":75773,"_31596":75722,"_21876":128751,"_5":15057,"_28736":128619,"_3095":128752},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3708":75774,"_31596":75722,"_21876":128754,"_5":15057,"_28736":128619,"_3095":128755},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3708":75775,"_31596":75722,"_21876":128757,"_5":15057,"_28736":128619,"_3095":128758},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3708":75776,"_31596":75722,"_21876":128760,"_5":15057,"_28736":128619,"_3095":128761},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3708":75777,"_31596":75722,"_21876":128763,"_5":15057,"_28736":128619,"_3095":128764},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3708":75778,"_31596":75722,"_21876":128766,"_5":15057,"_28736":128619,"_3095":128767},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3708":75779,"_31596":75722,"_21876":128769,"_5":15057,"_28736":128619,"_3095":128770},[],"**Delete Key** para eliminar la clave del sistema.",{"_3708":75780,"_31596":75722,"_21876":128772,"_5":15057,"_28736":128623,"_3095":128773},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3708":75781,"_31596":75722,"_21876":128775,"_5":15057,"_28736":128627,"_3095":128776},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3708":75782,"_31596":75722,"_21876":128778,"_5":15057,"_28736":128627,"_3095":128779},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3708":75783,"_31596":75722,"_21876":128781,"_5":15057,"_28736":128627,"_3095":128782},[],"**Key Name**: nombre único y descriptivo.",{"_3708":75784,"_31596":75722,"_21876":128784,"_5":15057,"_28736":128627,"_3095":128785},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3708":75785,"_31596":75722,"_21876":128787,"_5":15057,"_28736":128627,"_3095":128788},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3708":75786,"_31596":75722,"_21876":128790,"_5":15057,"_28736":128627,"_3095":128791},[],"**Tags**: metadatos para clasificar la clave.",{"_3708":75787,"_31596":75722,"_21876":128793,"_5":15057,"_28736":128627,"_3095":128794},[],"**Metadata**: información adicional para usos avanzados.",{"_3708":75788,"_31596":75722,"_21876":128796,"_5":15057,"_28736":128631,"_3095":128797},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3708":75789,"_31596":75722,"_21876":128799,"_5":15057,"_28736":128631,"_3095":128800},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3708":75790,"_31596":75722,"_21876":128802,"_5":15057,"_28736":128631,"_3095":128803},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3708":75791,"_31596":75722,"_21876":128805,"_5":15057,"_28736":128631,"_3095":128806},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3708":75792,"_31596":75722,"_21876":128808,"_5":15057,"_28736":128631,"_3095":128809},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3708":75793,"_31596":75722,"_21876":128811,"_5":15057,"_28736":128631,"_3095":128812},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3708":75794,"_31596":75722,"_21876":128814,"_5":15057,"_28736":128631,"_3095":128815},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3708":75795,"_31596":75722,"_21876":128817,"_5":15057,"_28736":128631,"_3095":128818},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3708":75796,"_31596":75722,"_21876":128820,"_5":15057,"_28736":128631,"_3095":128821},[],"**Metadata**: información adicional opcional.",{"_3708":75797,"_31596":75722,"_21876":128823,"_5":15057,"_28736":128631,"_3095":128824},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3708":75798,"_31596":75722,"_21876":128826,"_5":15057,"_28736":128631,"_3095":128827},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3708":75799,"_31596":75722,"_21876":128829,"_5":15057,"_28736":128635,"_3095":128830},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3708":75800,"_31596":75722,"_21876":128832,"_5":15057,"_28736":128639,"_3095":128833},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3708":75801,"_31596":75722,"_21876":128835,"_5":15057,"_28736":128639,"_3095":128836},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3708":75802,"_31596":75722,"_21876":128838,"_5":15057,"_28736":128639,"_3095":128839},[],"**Key Name**: nombre descriptivo.",{"_3708":75803,"_31596":75722,"_21876":128841,"_5":15057,"_28736":128639,"_3095":128842},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3708":75804,"_31596":75722,"_21876":128844,"_5":15057,"_28736":128639,"_3095":128845},[],"**Tags**: etiquetas asociadas.",{"_3708":75805,"_31596":75722,"_21876":128847,"_5":15057,"_28736":128639,"_3095":128848},[],"**Aliases**: nombres alternativos.",{"_3708":75806,"_31596":75722,"_21876":128850,"_5":15057,"_28736":128639,"_3095":128851},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3708":75807,"_31596":75722,"_21876":128853,"_5":15057,"_28736":128639,"_3095":128854},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3708":75808,"_31596":75722,"_21876":128856,"_5":15057,"_28736":128639,"_3095":128857},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3708":75809,"_31596":75722,"_21876":128859,"_5":15057,"_28736":128639,"_3095":128860},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3708":75810,"_31596":75722,"_21876":128862,"_5":15057,"_28736":128643,"_3095":128863},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3708":75811,"_31596":75722,"_21876":128865,"_5":15057,"_28736":128643,"_3095":128866},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3708":75812,"_31596":75722,"_21876":128868,"_5":15057,"_28736":128643,"_3095":128869},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3708":75813,"_31596":75722,"_21876":128871,"_5":15057,"_28736":128647,"_3095":128872},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3708":75814,"_31596":75722,"_21876":128874,"_5":15057,"_28736":128647,"_3095":128875},[],"Campos principales:",{"_3708":75815,"_31596":75722,"_21876":128877,"_5":15057,"_28736":128647,"_3095":128878},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3708":75816,"_31596":75722,"_21876":128880,"_5":15057,"_28736":128647,"_3095":128881},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3708":75817,"_31596":75722,"_21876":128883,"_5":15057,"_28736":128647,"_3095":128884},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3708":75818,"_31596":75722,"_21876":128886,"_5":15057,"_28736":128647,"_3095":128887},[],"**Message**: contenido que se va a firmar.",{"_3708":75819,"_31596":75722,"_21876":128889,"_5":15057,"_28736":128647,"_3095":128890},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3708":75820,"_31596":75722,"_21876":128892,"_5":15057,"_28736":128650,"_3095":128893},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3708":75821,"_31596":75722,"_21876":128895,"_5":15057,"_28736":128650,"_3095":128875},[],{"_3708":75822,"_31596":75722,"_21876":128897,"_5":15057,"_28736":128650,"_3095":128898},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3708":75823,"_31596":75722,"_21876":128900,"_5":15057,"_28736":128650,"_3095":128901},[],"**Message Type**: `Raw` o `Digest`.",{"_3708":75824,"_31596":75722,"_21876":128903,"_5":15057,"_28736":128650,"_3095":128904},[],"**Payload Encoding**: codificación del mensaje.",{"_3708":75825,"_31596":75722,"_21876":128906,"_5":15057,"_28736":128650,"_3095":128907},[],"**Message**: mensaje original o hash.",{"_3708":75826,"_31596":75722,"_21876":128909,"_5":15057,"_28736":128650,"_3095":128910},[],"**Signature**: firma que se desea comprobar.",{"_3708":75827,"_31596":75722,"_21876":128912,"_5":15057,"_28736":128650,"_3095":128913},[],"**Result**: indicador del resultado de la validación.",{"_3708":75828,"_31596":75722,"_21876":128915,"_5":15057,"_28736":128653,"_3095":128916},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3708":75829,"_31596":75722,"_21876":128918,"_5":15057,"_28736":128653,"_3095":128919},[],"Este flujo es útil para:",{"_3708":75830,"_31596":75722,"_21876":128921,"_5":15057,"_28736":128653,"_3095":128922},[],"Solicitar certificados a una CA externa.",{"_3708":75831,"_31596":75722,"_21876":128924,"_5":15057,"_28736":128653,"_3095":128925},[],"Renovar una identidad manteniendo la misma clave.",{"_3708":75832,"_31596":75722,"_21876":128927,"_5":15057,"_28736":128653,"_3095":128928},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3708":75833,"_31596":75722,"_21876":128930,"_5":15057,"_28736":128653,"_3095":128931},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3708":75834,"_31596":75722,"_21876":128933,"_5":15057,"_28736":128653,"_3095":128934},[],"**Organization (O)**: organización o empresa.",{"_3708":75835,"_31596":75722,"_21876":128936,"_5":15057,"_28736":128653,"_3095":128937},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3708":75836,"_31596":75722,"_21876":128939,"_5":15057,"_28736":128653,"_3095":128940},[],"**Country (C)**: código de país de dos letras.",{"_3708":75837,"_31596":75722,"_21876":128942,"_5":15057,"_28736":128653,"_3095":128943},[],"**State / Province (ST)**: estado o provincia.",{"_3708":75838,"_31596":75722,"_21876":128945,"_5":15057,"_28736":128653,"_3095":128946},[],"**Locality (L)**: ciudad o localidad.",{"_3708":75839,"_31596":75722,"_21876":128948,"_5":15057,"_28736":128653,"_3095":128949},[],"**Email Address**: correo de contacto.",{"_3708":75840,"_31596":75722,"_21876":128951,"_5":15057,"_28736":128653,"_3095":128952},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3708":75841,"_31596":75722,"_21876":128954,"_5":15057,"_28736":128653,"_3095":128955},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3708":75842,"_31596":75722,"_21876":128957,"_5":15057,"_28736":128657,"_3095":128958},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3708":75843,"_31596":75722,"_21876":128960,"_5":15057,"_28736":128657,"_3095":128961},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3708":75844,"_31596":75722,"_21876":128963,"_5":15057,"_28736":128661,"_3095":128964},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3708":75845,"_31596":75722,"_21876":128966,"_5":15057,"_28736":128661,"_3095":128967},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3708":75846,"_31596":75846,"_5":15417,"_3095":128969,"_31955":128970,"_21876":128971,"_28736":75846},"Validación online con OCSP",[51485,123023,57206,127725],[],{"_3708":75847,"_31596":75846,"_21876":128973,"_5":15057,"_28736":75846,"_3095":128974},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3708":75848,"_31596":75846,"_5":31952,"_21876":128976,"_28736":128977,"_3095":128978},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3708":75849,"_31596":75846,"_5":31952,"_21876":128980,"_28736":128981,"_3095":128982},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3708":75850,"_31596":75846,"_5":31952,"_21876":128984,"_28736":128985,"_3095":128986},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3708":75851,"_31596":75846,"_5":31952,"_21876":128988,"_28736":128989,"_3095":128990},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3708":75852,"_31596":75846,"_5":31952,"_21876":128992,"_28736":128993,"_3095":128994},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3708":75853,"_31596":75846,"_5":31952,"_21876":128996,"_28736":128997,"_3095":128288},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#referencias",{"_3708":75854,"_31596":75846,"_21876":128999,"_5":15057,"_28736":75846,"_3095":129000},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3708":75855,"_31596":75846,"_21876":129002,"_5":15057,"_28736":128977,"_3095":129003},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3708":75856,"_31596":75846,"_21876":129005,"_5":15057,"_28736":128977,"_3095":129006},[],"Estado del registro",{"_3708":75857,"_31596":75846,"_21876":129008,"_5":15057,"_28736":128977,"_3095":129009},[],"Respuesta firmada",{"_3708":75858,"_31596":75846,"_21876":129011,"_5":15057,"_28736":128977,"_3095":56343},[],{"_3708":75859,"_31596":75846,"_21876":129013,"_5":15057,"_28736":128977,"_3095":59193},[],{"_3708":75860,"_31596":75846,"_21876":129015,"_5":15057,"_28736":128977,"_3095":56360},[],{"_3708":75861,"_31596":75846,"_21876":129017,"_5":15057,"_28736":128977,"_3095":129018},[],"`Revoked`, con razón y fecha de revocación.",{"_3708":75862,"_31596":75846,"_21876":129020,"_5":15057,"_28736":128977,"_3095":129021},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3708":75863,"_31596":75846,"_21876":129023,"_5":15057,"_28736":128977,"_3095":129024},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3708":75864,"_31596":75846,"_21876":129026,"_5":15057,"_28736":128977,"_3095":129027},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3708":75865,"_31596":75846,"_21876":129029,"_5":15057,"_28736":128977,"_3095":129030},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3708":75866,"_31596":75846,"_21876":129032,"_5":15057,"_28736":128977,"_3095":129033},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3708":75867,"_31596":75846,"_21876":129035,"_5":15057,"_28736":128981,"_3095":129036},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3708":75868,"_31596":75846,"_21876":129038,"_5":15057,"_28736":128981,"_3095":129039},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3708":75869,"_31596":75846,"_21876":129041,"_5":15057,"_28736":128985,"_3095":129042},[],"El servicio acepta:",{"_3708":75870,"_31596":75846,"_21876":129044,"_5":15057,"_28736":128985,"_3095":124907},[],{"_3708":75871,"_31596":75846,"_21876":129046,"_5":15057,"_28736":128985,"_3095":129047},[],"Ruta del servicio VA",{"_3708":75872,"_31596":75846,"_21876":129049,"_5":15057,"_28736":128985,"_3095":129050},[],"Formato",{"_3708":75873,"_31596":75846,"_21876":129052,"_5":15057,"_28736":128985,"_3095":59233},[],{"_3708":75874,"_31596":75846,"_21876":129054,"_5":15057,"_28736":128985,"_3095":59236},[],{"_3708":75875,"_31596":75846,"_21876":129056,"_5":15057,"_28736":128985,"_3095":129057},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3708":75876,"_31596":75846,"_21876":129059,"_5":15057,"_28736":128985,"_3095":58628},[],{"_3708":75877,"_31596":75846,"_21876":129061,"_5":15057,"_28736":128985,"_3095":59244},[],{"_3708":75878,"_31596":75846,"_21876":129063,"_5":15057,"_28736":128985,"_3095":129064},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3708":75879,"_31596":75846,"_21876":129066,"_5":15057,"_28736":128985,"_3095":129067},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3708":75880,"_31596":75846,"_21876":129069,"_5":15057,"_28736":128989,"_3095":129070},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3708":75881,"_31596":75846,"_21876":129072,"_5":15057,"_28736":128989,"_3095":129073},[],"Genera la solicitud:",{"_3708":75882,"_31596":75846,"_21876":129075,"_5":15057,"_28736":128989,"_3095":129076},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3708":75883,"_31596":75846,"_21876":129078,"_5":15057,"_28736":128989,"_3095":129079},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3708":75884,"_31596":75846,"_21876":129081,"_5":15057,"_28736":128989,"_3095":129082},[],"Verifica el DER recibido:",{"_3708":75885,"_31596":75846,"_21876":129084,"_5":15057,"_28736":128989,"_3095":129085},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3708":75886,"_31596":75846,"_21876":129087,"_5":15057,"_28736":128993,"_3095":129088},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3708":75887,"_31596":75846,"_21876":129090,"_5":15057,"_28736":128993,"_3095":129091},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3708":75888,"_31596":75846,"_21876":129093,"_5":15057,"_28736":128997,"_3095":59277},[],{"_3708":75889,"_31596":75846,"_21876":129095,"_5":15057,"_28736":128997,"_3095":59280},[],{"_3708":75890,"_31596":75846,"_21876":129097,"_5":15057,"_28736":128997,"_3095":129098},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3708":75891,"_31596":75846,"_21876":129100,"_5":15057,"_28736":128997,"_3095":128583},[],{"_3708":75892,"_31596":75892,"_5":15417,"_3095":57206,"_31955":129102,"_21876":129103,"_28736":75892},[51485,123023,57206],[],{"_3708":75893,"_31596":75892,"_21876":129105,"_5":15057,"_28736":75892,"_3095":129106},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3708":75894,"_31596":75892,"_5":31952,"_21876":129108,"_28736":129109,"_3095":126380},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#empieza-aquí",{"_3708":75895,"_31596":75892,"_5":31952,"_21876":129111,"_28736":129112,"_3095":129113},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3708":75896,"_31596":75892,"_5":31952,"_21876":129115,"_28736":129116,"_3095":126900},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#capacidades-principales",{"_3708":75897,"_31596":75892,"_5":31952,"_21876":129118,"_28736":129119,"_3095":126904},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3708":75898,"_31596":75892,"_5":31952,"_21876":129121,"_28736":129122,"_3095":126908},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3708":75899,"_31596":75892,"_5":31952,"_21876":129124,"_28736":129125,"_3095":126912},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#emite-y-controla-certificados",{"_3708":75900,"_31596":75892,"_5":31952,"_21876":129127,"_28736":129128,"_3095":126920},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#publica-el-estado-de-validación",{"_3708":75901,"_31596":75892,"_5":31952,"_21876":129130,"_28736":129131,"_3095":129132},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3708":75902,"_31596":75892,"_5":31952,"_21876":129134,"_28736":129135,"_3095":127891},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#continúa",{"_3708":75903,"_31596":75892,"_21876":129137,"_5":15057,"_28736":75892,"_3095":129138},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3708":75904,"_31596":75892,"_21876":129140,"_5":15057,"_28736":129109,"_3095":129141},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3708":75905,"_31596":75892,"_21876":129143,"_5":15057,"_28736":129109,"_3095":129144},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3708":75906,"_31596":75892,"_21876":129146,"_5":15057,"_28736":129112,"_3095":129147},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3708":75907,"_31596":75892,"_21876":129149,"_5":15057,"_28736":129112,"_3095":129150},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3708":75908,"_31596":75892,"_21876":129152,"_5":15057,"_28736":129112,"_3095":129153},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3708":75909,"_31596":75892,"_21876":129155,"_5":15057,"_28736":129112,"_3095":129156},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3708":75910,"_31596":75892,"_21876":129158,"_5":15057,"_28736":129112,"_3095":129159},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3708":75911,"_31596":75892,"_21876":129161,"_5":15057,"_28736":129119,"_3095":129162},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3708":75912,"_31596":75892,"_21876":129164,"_5":15057,"_28736":129122,"_3095":129165},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3708":75913,"_31596":75892,"_21876":129167,"_5":15057,"_28736":129125,"_3095":129168},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3708":75914,"_31596":75892,"_21876":129170,"_5":15057,"_28736":129128,"_3095":129171},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3708":75915,"_31596":75892,"_21876":129173,"_5":15057,"_28736":129131,"_3095":129174},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3708":75916,"_31596":75892,"_21876":129176,"_5":15057,"_28736":129131,"_3095":129177},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3708":75917,"_31596":75892,"_21876":129179,"_5":15057,"_28736":129131,"_3095":129180},[],"su clave pública corresponda a la clave privada del cliente;",{"_3708":75918,"_31596":75892,"_21876":129182,"_5":15057,"_28736":129131,"_3095":129183},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3708":75919,"_31596":75892,"_21876":129185,"_5":15057,"_28736":129131,"_3095":129186},[],"sus fechas y usos permitan la operación;",{"_3708":75920,"_31596":75892,"_21876":129188,"_5":15057,"_28736":129131,"_3095":129189},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3708":75921,"_31596":75892,"_21876":129191,"_5":15057,"_28736":129131,"_3095":129192},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3708":75922,"_31596":75892,"_21876":129194,"_5":15057,"_28736":129135,"_3095":129195},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3708":75923,"_31596":75892,"_21876":129197,"_5":15057,"_28736":129135,"_3095":129198},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3708":75924,"_31596":75892,"_21876":129200,"_5":15057,"_28736":129135,"_3095":129201},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3708":75925,"_31596":75925,"_5":15417,"_3095":129203,"_31955":129204,"_21876":129205,"_28736":75925},"Crea tu primera CA",[51485,123023,57206,126504],[],{"_3708":75926,"_31596":75925,"_21876":129207,"_5":15057,"_28736":75925,"_3095":129208},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3708":75927,"_31596":75925,"_5":31952,"_21876":129210,"_28736":129211,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3708":75928,"_31596":75925,"_5":31952,"_21876":129213,"_28736":129214,"_3095":129215},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3708":75929,"_31596":75925,"_5":31952,"_21876":129217,"_28736":129218,"_3095":129219},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3708":75930,"_31596":75925,"_5":31952,"_21876":129221,"_28736":129222,"_3095":129223},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3708":75931,"_31596":75925,"_5":31952,"_21876":129225,"_28736":129226,"_3095":129227},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3708":75932,"_31596":75925,"_5":31952,"_21876":129229,"_28736":129230,"_3095":129231},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3708":75933,"_31596":75925,"_5":31952,"_21876":129233,"_28736":129234,"_3095":129235},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3708":75934,"_31596":75925,"_5":31952,"_21876":129237,"_28736":129238,"_3095":126751},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3708":75935,"_31596":75925,"_5":31952,"_21876":129240,"_28736":129241,"_3095":121555},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3708":75936,"_31596":75925,"_21876":129243,"_5":15057,"_28736":75925,"_3095":129244},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3708":75937,"_31596":75925,"_21876":129246,"_5":15057,"_28736":129211,"_3095":129247},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3708":75938,"_31596":75925,"_21876":129249,"_5":15057,"_28736":129211,"_3095":129250},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3708":75939,"_31596":75925,"_21876":129252,"_5":15057,"_28736":129211,"_3095":129253},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3708":75940,"_31596":75925,"_21876":129255,"_5":15057,"_28736":129211,"_3095":129256},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3708":75941,"_31596":75925,"_21876":129258,"_5":15057,"_28736":129214,"_3095":129259},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3708":75942,"_31596":75925,"_21876":129261,"_5":15057,"_28736":129214,"_3095":129262},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3708":75943,"_31596":75925,"_21876":129264,"_5":15057,"_28736":129218,"_3095":129265},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3708":75944,"_31596":75925,"_21876":129267,"_5":15057,"_28736":129218,"_3095":129268},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3708":75945,"_31596":75925,"_21876":129270,"_5":15057,"_28736":129222,"_3095":129271},[],"Selecciona **Root CA** y completa:",{"_3708":75946,"_31596":75925,"_21876":129273,"_5":15057,"_28736":129222,"_3095":59459},[],{"_3708":75947,"_31596":75925,"_21876":129275,"_5":15057,"_28736":129222,"_3095":129276},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3708":75948,"_31596":75925,"_21876":129278,"_5":15057,"_28736":129222,"_3095":129279},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3708":75949,"_31596":75925,"_21876":129281,"_5":15057,"_28736":129222,"_3095":129282},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3708":75950,"_31596":75925,"_21876":129284,"_5":15057,"_28736":129222,"_3095":129285},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3708":75951,"_31596":75925,"_21876":129287,"_5":15057,"_28736":129226,"_3095":129288},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3708":75952,"_31596":75925,"_21876":129290,"_5":15057,"_28736":129230,"_3095":129291},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3708":75953,"_31596":75925,"_21876":129293,"_5":15057,"_28736":129230,"_3095":129294},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3708":75954,"_31596":75925,"_21876":129296,"_5":15057,"_28736":129234,"_3095":129297},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3708":75955,"_31596":75925,"_21876":129299,"_5":15057,"_28736":129234,"_3095":129300},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3708":75956,"_31596":75925,"_21876":129302,"_5":15057,"_28736":129234,"_3095":129303},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3708":75957,"_31596":75925,"_21876":129305,"_5":15057,"_28736":129238,"_3095":129306},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3708":75958,"_31596":75925,"_21876":129308,"_5":15057,"_28736":129238,"_3095":129309},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3708":75959,"_31596":75925,"_21876":129311,"_5":15057,"_28736":129238,"_3095":129312},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3708":75960,"_31596":75925,"_21876":129314,"_5":15057,"_28736":129238,"_3095":129315},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3708":75961,"_31596":75925,"_21876":129317,"_5":15057,"_28736":129241,"_3095":129318},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3708":75962,"_31596":75962,"_5":15417,"_3095":129320,"_31955":129321,"_21876":129322,"_28736":75962},"Emite y verifica un certificado",[51485,123023,57206,126504],[],{"_3708":75963,"_31596":75962,"_21876":129324,"_5":15057,"_28736":75962,"_3095":129325},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3708":75964,"_31596":75962,"_5":31952,"_21876":129327,"_28736":129328,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3708":75965,"_31596":75962,"_5":31952,"_21876":129330,"_28736":129331,"_3095":129332},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3708":75966,"_31596":75962,"_5":31952,"_21876":129334,"_28736":129335,"_3095":129336},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3708":75967,"_31596":75962,"_5":31952,"_21876":129338,"_28736":129339,"_3095":129340},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3708":75968,"_31596":75962,"_5":31952,"_21876":129342,"_28736":129343,"_3095":129344},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3708":75969,"_31596":75962,"_5":31952,"_21876":129346,"_28736":129347,"_3095":129348},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3708":75970,"_31596":75962,"_5":31952,"_21876":129350,"_28736":129351,"_3095":129352},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3708":75971,"_31596":75962,"_5":31952,"_21876":129354,"_28736":129355,"_3095":129356},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3708":75972,"_31596":75962,"_5":31952,"_21876":129358,"_28736":129359,"_3095":129360},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3708":75973,"_31596":75962,"_5":31952,"_21876":129362,"_28736":129363,"_3095":129364},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3708":75974,"_31596":75962,"_5":31952,"_21876":129366,"_28736":129367,"_3095":126751},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3708":75975,"_31596":75962,"_5":31952,"_21876":129369,"_28736":129370,"_3095":121555},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3708":75976,"_31596":75962,"_21876":129372,"_5":15057,"_28736":75962,"_3095":129373},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3708":75977,"_31596":75962,"_21876":129375,"_5":15057,"_28736":129328,"_3095":129376},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3708":75978,"_31596":75962,"_21876":129378,"_5":15057,"_28736":129328,"_3095":129379},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3708":75979,"_31596":75962,"_21876":129381,"_5":15057,"_28736":129328,"_3095":129382},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3708":75980,"_31596":75962,"_21876":129384,"_5":15057,"_28736":129328,"_3095":129385},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3708":75981,"_31596":75962,"_21876":129387,"_5":15057,"_28736":129328,"_3095":129388},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3708":75982,"_31596":75962,"_21876":129390,"_5":15057,"_28736":129331,"_3095":129391},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3708":75983,"_31596":75962,"_21876":129393,"_5":15057,"_28736":129335,"_3095":129394},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3708":75984,"_31596":75962,"_21876":129396,"_5":15057,"_28736":129335,"_3095":129397},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3708":75985,"_31596":75962,"_21876":129399,"_5":15057,"_28736":129339,"_3095":129400},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3708":75986,"_31596":75962,"_21876":129402,"_5":15057,"_28736":129339,"_3095":129403},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3708":75987,"_31596":75962,"_21876":129405,"_5":15057,"_28736":129343,"_3095":129406},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3708":75988,"_31596":75962,"_21876":129408,"_5":15057,"_28736":129343,"_3095":129409},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3708":75989,"_31596":75962,"_21876":129411,"_5":15057,"_28736":129347,"_3095":129412},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3708":75990,"_31596":75962,"_21876":129414,"_5":15057,"_28736":129351,"_3095":129415},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3708":75991,"_31596":75962,"_21876":129417,"_5":15057,"_28736":129355,"_3095":129418},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3708":75992,"_31596":75962,"_21876":129420,"_5":15057,"_28736":129359,"_3095":129421},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3708":75993,"_31596":75962,"_21876":129423,"_5":15057,"_28736":129359,"_3095":129424},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3708":75994,"_31596":75962,"_21876":129426,"_5":15057,"_28736":129359,"_3095":129427},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3708":75995,"_31596":75962,"_21876":129429,"_5":15057,"_28736":129363,"_3095":129430},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3708":75996,"_31596":75962,"_21876":129432,"_5":15057,"_28736":129363,"_3095":129433},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3708":75997,"_31596":75962,"_21876":129435,"_5":15057,"_28736":129363,"_3095":129436},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3708":75998,"_31596":75962,"_21876":129438,"_5":15057,"_28736":129367,"_3095":126834},[],{"_3708":75999,"_31596":75962,"_21876":129440,"_5":15057,"_28736":129367,"_3095":125349},[],{"_3708":76000,"_31596":75962,"_21876":129442,"_5":15057,"_28736":129367,"_3095":129443},[],"La CA rechaza la emisión",{"_3708":76001,"_31596":75962,"_21876":129445,"_5":15057,"_28736":129367,"_3095":129446},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3708":76002,"_31596":75962,"_21876":129448,"_5":15057,"_28736":129367,"_3095":129449},[],"Sujeto o usos diferentes",{"_3708":76003,"_31596":75962,"_21876":129451,"_5":15057,"_28736":129367,"_3095":129452},[],"Perfil aplicado y valores solicitados.",{"_3708":76004,"_31596":75962,"_21876":129454,"_5":15057,"_28736":129367,"_3095":129455},[],"No se encuentra el emisor",{"_3708":76005,"_31596":75962,"_21876":129457,"_5":15057,"_28736":129367,"_3095":129458},[],"CA descargada y cadena intermedia necesaria.",{"_3708":76006,"_31596":75962,"_21876":129460,"_5":15057,"_28736":129367,"_3095":129461},[],"Falla la vigencia",{"_3708":76007,"_31596":75962,"_21876":129463,"_5":15057,"_28736":129367,"_3095":129464},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3708":76008,"_31596":75962,"_21876":129466,"_5":15057,"_28736":129367,"_3095":129467},[],"Los resúmenes de clave difieren",{"_3708":76009,"_31596":75962,"_21876":129469,"_5":15057,"_28736":129367,"_3095":129470},[],"Archivos de certificado y clave de la misma emisión.",{"_3708":76010,"_31596":75962,"_21876":129472,"_5":15057,"_28736":129367,"_3095":129473},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3708":76011,"_31596":75962,"_21876":129475,"_5":15057,"_28736":129370,"_3095":129476},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3708":76012,"_31596":75962,"_21876":129478,"_5":15057,"_28736":129370,"_3095":129479},[],"Gestionar certificados para inspección, estado y revocación.",{"_3708":76013,"_31596":75962,"_21876":129481,"_5":15057,"_28736":129370,"_3095":129482},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3708":76014,"_31596":75962,"_21876":129484,"_5":15057,"_28736":129370,"_3095":129485},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3708":76015,"_31596":75962,"_21876":129487,"_5":15057,"_28736":129370,"_3095":129488},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3708":76016,"_31596":76016,"_5":15417,"_3095":129490,"_31955":129491,"_21876":129492,"_28736":76016},"Primeros pasos de PKI",[51485,123023,57206,126504],[],{"_3708":76017,"_31596":76016,"_21876":129494,"_5":15057,"_28736":76016,"_3095":129495},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3708":76018,"_31596":76016,"_5":31952,"_21876":129497,"_28736":129498,"_3095":121531},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3708":76019,"_31596":76016,"_5":31952,"_21876":129500,"_28736":129501,"_3095":129502},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3708":76020,"_31596":76016,"_5":31952,"_21876":129504,"_28736":129505,"_3095":126686},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3708":76021,"_31596":76016,"_5":31952,"_21876":129507,"_28736":129508,"_3095":129509},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3708":76022,"_31596":76016,"_21876":129511,"_5":15057,"_28736":76016,"_3095":129512},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3708":76023,"_31596":76016,"_21876":129514,"_5":15057,"_28736":129498,"_3095":129515},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3708":76024,"_31596":76016,"_21876":129517,"_5":15057,"_28736":129498,"_3095":129518},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3708":76025,"_31596":76016,"_21876":129520,"_5":15057,"_28736":129498,"_3095":129521},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3708":76026,"_31596":76016,"_21876":129523,"_5":15057,"_28736":129498,"_3095":129524},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3708":76027,"_31596":76016,"_21876":129526,"_5":15057,"_28736":129498,"_3095":129527},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3708":76028,"_31596":76016,"_21876":129529,"_5":15057,"_28736":129501,"_3095":129530},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3708":76029,"_31596":76016,"_21876":129532,"_5":15057,"_28736":129501,"_3095":129533},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3708":76030,"_31596":76016,"_21876":129535,"_5":15057,"_28736":129501,"_3095":129536},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3708":76031,"_31596":76016,"_21876":129538,"_5":15057,"_28736":129501,"_3095":129539},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3708":76032,"_31596":76016,"_21876":129541,"_5":15057,"_28736":129505,"_3095":129542},[],"Archivo o recurso",{"_3708":76033,"_31596":76016,"_21876":129544,"_5":15057,"_28736":129505,"_3095":126683},[],{"_3708":76034,"_31596":76016,"_21876":129546,"_5":15057,"_28736":129505,"_3095":129547},[],"CA raíz activa y `ca.pem`",{"_3708":76035,"_31596":76016,"_21876":129549,"_5":15057,"_28736":129505,"_3095":129550},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3708":76036,"_31596":76016,"_21876":129552,"_5":15057,"_28736":129505,"_3095":129553},[],"Certificado final y `device.crt`",{"_3708":76037,"_31596":76016,"_21876":129555,"_5":15057,"_28736":129505,"_3095":129556},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3708":76038,"_31596":76016,"_21876":129558,"_5":15057,"_28736":129505,"_3095":129559},[],"Clave privada `device.key`",{"_3708":76039,"_31596":76016,"_21876":129561,"_5":15057,"_28736":129505,"_3095":129562},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3708":76040,"_31596":76016,"_21876":129564,"_5":15057,"_28736":129505,"_3095":129565},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3708":76041,"_31596":76016,"_21876":129567,"_5":15057,"_28736":129508,"_3095":129568},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3708":76042,"_31596":76016,"_21876":129570,"_5":15057,"_28736":129508,"_3095":129571},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3708":76043,"_31596":76016,"_21876":129573,"_5":15057,"_28736":129508,"_3095":129574},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3708":76044,"_31596":76044,"_5":15417,"_3095":129576,"_31955":129577,"_21876":129579,"_28736":76044},"Resolución de problemas PKI",[51485,123023,57206,129578],"Resolución de problemas",[],{"_3708":76045,"_31596":76044,"_21876":129581,"_5":15057,"_28736":76044,"_3095":129582},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3708":76046,"_31596":76044,"_5":31952,"_21876":129584,"_28736":129585,"_3095":129586},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3708":76047,"_31596":76044,"_5":31952,"_21876":129588,"_28736":129589,"_3095":129590},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3708":76048,"_31596":76044,"_5":31952,"_21876":129592,"_28736":129593,"_3095":129594},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3708":76049,"_31596":76044,"_21876":129596,"_5":15057,"_28736":76044,"_3095":129597},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3708":76050,"_31596":76044,"_21876":129599,"_5":15057,"_28736":76044,"_3095":129600},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3708":76051,"_31596":76044,"_21876":129602,"_5":15057,"_28736":129585,"_3095":126683},[],{"_3708":76052,"_31596":76044,"_21876":129604,"_5":15057,"_28736":129585,"_3095":125349},[],{"_3708":76053,"_31596":76044,"_21876":129606,"_5":15057,"_28736":129585,"_3095":121555},[],{"_3708":76054,"_31596":76044,"_21876":129608,"_5":15057,"_28736":129585,"_3095":56048},[],{"_3708":76055,"_31596":76044,"_21876":129610,"_5":15057,"_28736":129585,"_3095":129611},[],"Existe, está activa y sus fechas son utilizables.",{"_3708":76056,"_31596":76044,"_21876":129613,"_5":15057,"_28736":129585,"_3095":129614},[],"Autoridades.",{"_3708":76057,"_31596":76044,"_21876":129616,"_5":15057,"_28736":129585,"_3095":129617},[],"Clave",{"_3708":76058,"_31596":76044,"_21876":129619,"_5":15057,"_28736":129585,"_3095":129620},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3708":76059,"_31596":76044,"_21876":129622,"_5":15057,"_28736":129585,"_3095":129623},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3708":76060,"_31596":76044,"_21876":129625,"_5":15057,"_28736":129585,"_3095":59813},[],{"_3708":76061,"_31596":76044,"_21876":129627,"_5":15057,"_28736":129585,"_3095":129628},[],"PEM correcto y firma verificable.",{"_3708":76062,"_31596":76044,"_21876":129630,"_5":15057,"_28736":129585,"_3095":59819},[],{"_3708":76063,"_31596":76044,"_21876":129632,"_5":15057,"_28736":129585,"_3095":129633},[],"Perfil",{"_3708":76064,"_31596":76044,"_21876":129635,"_5":15057,"_28736":129585,"_3095":129636},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3708":76065,"_31596":76044,"_21876":129638,"_5":15057,"_28736":129585,"_3095":129639},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3708":76066,"_31596":76044,"_21876":129641,"_5":15057,"_28736":129585,"_3095":126834},[],{"_3708":76067,"_31596":76044,"_21876":129643,"_5":15057,"_28736":129585,"_3095":129644},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3708":76068,"_31596":76044,"_21876":129646,"_5":15057,"_28736":129585,"_3095":129647},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3708":76069,"_31596":76044,"_21876":129649,"_5":15057,"_28736":129585,"_3095":129650},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3708":76070,"_31596":76044,"_21876":129652,"_5":15057,"_28736":129585,"_3095":129653},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3708":76071,"_31596":76044,"_21876":129655,"_5":15057,"_28736":129585,"_3095":129656},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3708":76072,"_31596":76044,"_21876":129658,"_5":15057,"_28736":129589,"_3095":129659},[],"Revisa cada frontera por separado:",{"_3708":76073,"_31596":76044,"_21876":129661,"_5":15057,"_28736":129589,"_3095":129662},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3708":76074,"_31596":76044,"_21876":129664,"_5":15057,"_28736":129589,"_3095":129665},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3708":76075,"_31596":76044,"_21876":129667,"_5":15057,"_28736":129589,"_3095":129668},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3708":76076,"_31596":76044,"_21876":129670,"_5":15057,"_28736":129589,"_3095":129671},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3708":76077,"_31596":76044,"_21876":129673,"_5":15057,"_28736":129589,"_3095":129674},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3708":76078,"_31596":76044,"_21876":129676,"_5":15057,"_28736":129589,"_3095":129677},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3708":76079,"_31596":76044,"_21876":129679,"_5":15057,"_28736":129593,"_3095":129680},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3708":76080,"_31596":76044,"_21876":129682,"_5":15057,"_28736":129593,"_3095":129683},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3708":76081,"_31596":76081,"_5":15417,"_3095":129685,"_31955":129686,"_21876":129687,"_28736":76081},"Seguridad",[51485],[],{"_3708":76082,"_31596":76081,"_21876":129689,"_5":15057,"_28736":76081,"_3095":129690},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3708":76083,"_31596":76081,"_5":31952,"_21876":129692,"_28736":129693,"_3095":129694},[],"/docs/pr-preview/pr-78/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3708":76084,"_31596":76081,"_5":31952,"_21876":129696,"_28736":129697,"_3095":129698},[],"/docs/pr-preview/pr-78/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3708":76085,"_31596":76081,"_5":31952,"_21876":129700,"_28736":129701,"_3095":129702},[],"/docs/pr-preview/pr-78/es/security#versiones-soportadas","Versiones soportadas",{"_3708":76086,"_31596":76081,"_5":31952,"_21876":129704,"_28736":129705,"_3095":129706},[],"/docs/pr-preview/pr-78/es/security#divulgación-responsable","Divulgación responsable",{"_3708":76087,"_31596":76081,"_21876":129708,"_5":15057,"_28736":76081,"_3095":129709},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3708":76088,"_31596":76081,"_21876":129711,"_5":15057,"_28736":129693,"_3095":129712},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3708":76089,"_31596":76081,"_21876":129714,"_5":15057,"_28736":129693,"_3095":129715},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3708":76090,"_31596":76081,"_21876":129717,"_5":15057,"_28736":129693,"_3095":15701},[],{"_3708":76091,"_31596":76081,"_21876":129719,"_5":15057,"_28736":129693,"_3095":15625},[],{"_3708":76092,"_31596":76081,"_21876":129721,"_5":15057,"_28736":129693,"_3095":15688},[],{"_3708":76093,"_31596":76081,"_21876":129723,"_5":15057,"_28736":129693,"_3095":129724},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3708":76094,"_31596":76081,"_21876":129726,"_5":15057,"_28736":129693,"_3095":129727},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3708":76095,"_31596":76081,"_21876":129729,"_5":15057,"_28736":129697,"_3095":129730},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3708":76096,"_31596":76081,"_21876":129732,"_5":15057,"_28736":129697,"_3095":129733},[],"No incluyas en el reporte:",{"_3708":76097,"_31596":76081,"_21876":129735,"_5":15057,"_28736":129697,"_3095":129736},[],"Credenciales, tokens o claves privadas",{"_3708":76098,"_31596":76081,"_21876":129738,"_5":15057,"_28736":129697,"_3095":129739},[],"Datos de clientes o información identificable de clientes",{"_3708":76099,"_31596":76081,"_21876":129741,"_5":15057,"_28736":129697,"_3095":129742},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3708":76100,"_31596":76081,"_21876":129744,"_5":15057,"_28736":129701,"_3095":129745},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3708":76101,"_31596":76081,"_21876":129747,"_5":15057,"_28736":129701,"_3095":129748},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3708":76102,"_31596":76081,"_21876":129750,"_5":15057,"_28736":129705,"_3095":129751},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3708":76103,"_31596":76081,"_21876":129753,"_5":15057,"_28736":129705,"_3095":129754},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3708":76104,"_31596":76081,"_21876":129756,"_5":15057,"_28736":129705,"_3095":129757},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3708":76105,"_31596":76081,"_21876":129759,"_5":15057,"_28736":129705,"_3095":129760},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3708":76106,"_31596":76081,"_21876":129762,"_5":15057,"_28736":129705,"_3095":129763},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3708":76107,"_31596":76107,"_5":15417,"_3095":129765,"_31955":129766,"_21876":129768,"_28736":76107},"3.8.0 a 4.0.0",[51485,129767],"Actualizaciones",[],{"_3708":76108,"_31596":76107,"_21876":129770,"_5":15057,"_28736":76107,"_3095":129771},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3708":76109,"_31596":76107,"_5":31952,"_21876":129773,"_28736":129774,"_3095":129775},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3708":76110,"_31596":76107,"_5":31952,"_21876":129777,"_28736":129778,"_3095":129779},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3708":76111,"_31596":76107,"_5":31952,"_21876":129781,"_28736":129782,"_3095":129783},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3708":76112,"_31596":76107,"_5":31952,"_21876":129785,"_28736":129786,"_3095":129787},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3708":76113,"_31596":76107,"_5":31952,"_21876":129789,"_28736":129790,"_3095":129791},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3708":76114,"_31596":76107,"_5":31952,"_21876":129793,"_28736":129794,"_3095":129795},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3708":76115,"_31596":76107,"_5":31952,"_21876":129797,"_28736":129798,"_3095":59988},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3708":76116,"_31596":76107,"_5":31952,"_21876":129800,"_28736":129801,"_3095":129802},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3708":76117,"_31596":76107,"_5":31952,"_21876":129804,"_28736":129805,"_3095":129806},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3708":76118,"_31596":76107,"_5":31952,"_21876":129808,"_28736":129809,"_3095":129810},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3708":76119,"_31596":76107,"_5":31952,"_21876":129812,"_28736":129813,"_3095":122126},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3708":76120,"_31596":76107,"_5":31952,"_21876":129815,"_28736":129816,"_3095":129817},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3708":76121,"_31596":76107,"_5":31952,"_21876":129819,"_28736":129820,"_3095":129821},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3708":76122,"_31596":76107,"_5":31952,"_21876":129823,"_28736":129824,"_3095":129825},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3708":76123,"_31596":76107,"_5":31952,"_21876":129827,"_28736":129828,"_3095":129829},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3708":76124,"_31596":76107,"_5":31952,"_21876":129831,"_28736":129832,"_3095":129833},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3708":76125,"_31596":76107,"_5":31952,"_21876":129835,"_28736":129836,"_3095":129837},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3708":76126,"_31596":76107,"_5":31952,"_21876":129839,"_28736":129840,"_3095":129841},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3708":76127,"_31596":76107,"_5":31952,"_21876":129843,"_28736":129844,"_3095":129845},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3708":76128,"_31596":76107,"_5":31952,"_21876":129847,"_28736":129848,"_3095":129849},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3708":76129,"_31596":76107,"_5":31952,"_21876":129851,"_28736":129852,"_3095":129853},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3708":76130,"_31596":76107,"_5":31952,"_21876":129855,"_28736":129856,"_3095":129857},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3708":76131,"_31596":76107,"_5":31952,"_21876":129859,"_28736":129860,"_3095":129861},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3708":76132,"_31596":76107,"_5":31952,"_21876":129863,"_28736":129864,"_3095":129865},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3708":76133,"_31596":76107,"_5":31952,"_21876":129867,"_28736":129868,"_3095":129869},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3708":76134,"_31596":76107,"_5":31952,"_21876":129871,"_28736":129872,"_3095":129873},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3708":76135,"_31596":76107,"_5":31952,"_21876":129875,"_28736":129876,"_3095":129877},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3708":76136,"_31596":76107,"_5":31952,"_21876":129879,"_28736":129880,"_3095":129881},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3708":76137,"_31596":76107,"_5":31952,"_21876":129883,"_28736":129884,"_3095":129885},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3708":76138,"_31596":76107,"_5":31952,"_21876":129887,"_28736":129888,"_3095":129889},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3708":76139,"_31596":76107,"_5":31952,"_21876":129891,"_28736":129892,"_3095":129893},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3708":76140,"_31596":76107,"_5":31952,"_21876":129895,"_28736":129896,"_3095":129897},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3708":76141,"_31596":76107,"_5":31952,"_21876":129899,"_28736":129900,"_3095":129901},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3708":76142,"_31596":76107,"_5":31952,"_21876":129903,"_28736":129904,"_3095":129905},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3708":76143,"_31596":76107,"_5":31952,"_21876":129907,"_28736":129908,"_3095":129909},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3708":76144,"_31596":76107,"_5":31952,"_21876":129911,"_28736":129912,"_3095":129913},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3708":76145,"_31596":76107,"_5":31952,"_21876":129915,"_28736":129916,"_3095":129917},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3708":76146,"_31596":76107,"_5":31952,"_21876":129919,"_28736":129920,"_3095":129921},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3708":76147,"_31596":76107,"_5":31952,"_21876":129923,"_28736":129924,"_3095":129925},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3708":76148,"_31596":76107,"_5":31952,"_21876":129927,"_28736":129928,"_3095":129929},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3708":76149,"_31596":76107,"_5":31952,"_21876":129931,"_28736":129932,"_3095":129933},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3708":76150,"_31596":76107,"_5":31952,"_21876":129935,"_28736":129936,"_3095":129937},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3708":76151,"_31596":76107,"_5":31952,"_21876":129939,"_28736":129940,"_3095":129941},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3708":76152,"_31596":76107,"_5":31952,"_21876":129943,"_28736":129944,"_3095":129945},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3708":76153,"_31596":76107,"_5":31952,"_21876":129947,"_28736":129948,"_3095":125697},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3708":76154,"_31596":76107,"_5":31952,"_21876":129950,"_28736":129951,"_3095":129952},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3708":76155,"_31596":76107,"_5":31952,"_21876":129954,"_28736":129955,"_3095":129956},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3708":76156,"_31596":76107,"_21876":129958,"_5":15057,"_28736":76107,"_3095":129959},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3708":76157,"_31596":76107,"_21876":129961,"_5":15057,"_28736":76107,"_3095":129962},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3708":76158,"_31596":76107,"_21876":129964,"_5":15057,"_28736":76107,"_3095":129965},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3708":76159,"_31596":76107,"_21876":129967,"_5":15057,"_28736":76107,"_3095":129968},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3708":76160,"_31596":76107,"_21876":129970,"_5":15057,"_28736":76107,"_3095":129971},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3708":76161,"_31596":76107,"_21876":129973,"_5":15057,"_28736":76107,"_3095":129974},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3708":76162,"_31596":76107,"_21876":129976,"_5":15057,"_28736":76107,"_3095":129977},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3708":76163,"_31596":76107,"_21876":129979,"_5":15057,"_28736":129778,"_3095":129980},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3708":76164,"_31596":76107,"_21876":129982,"_5":15057,"_28736":129778,"_3095":129983},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3708":76165,"_31596":76107,"_21876":129985,"_5":15057,"_28736":129782,"_3095":129986},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3708":76166,"_31596":76107,"_21876":129988,"_5":15057,"_28736":129782,"_3095":129989},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3708":76167,"_31596":76107,"_21876":129991,"_5":15057,"_28736":129786,"_3095":129992},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP, que en AMQP el broker elimina automáticamente cuando la instancia se detiene (véase Eventos de dispositivo).",{"_3708":76168,"_31596":76107,"_21876":129994,"_5":15057,"_28736":129790,"_3095":129995},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3708":76169,"_31596":76107,"_21876":129997,"_5":15057,"_28736":129790,"_3095":129998},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3708":76170,"_31596":76107,"_21876":130000,"_5":15057,"_28736":129790,"_3095":130001},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3708":76171,"_31596":76107,"_21876":130003,"_5":15057,"_28736":129790,"_3095":130004},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3708":76172,"_31596":76107,"_21876":130006,"_5":15057,"_28736":129790,"_3095":130007},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3708":76173,"_31596":76107,"_21876":130009,"_5":15057,"_28736":129794,"_3095":130010},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3708":76174,"_31596":76107,"_21876":130012,"_5":15057,"_28736":129794,"_3095":130013},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3708":76175,"_31596":76107,"_21876":130015,"_5":15057,"_28736":129794,"_3095":130016},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3708":76176,"_31596":76107,"_21876":130018,"_5":15057,"_28736":129794,"_3095":130019},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3708":76177,"_31596":76107,"_21876":130021,"_5":15057,"_28736":129794,"_3095":130022},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3708":76178,"_31596":76107,"_21876":130024,"_5":15057,"_28736":129794,"_3095":130025},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3708":76179,"_31596":76107,"_21876":130027,"_5":15057,"_28736":129798,"_3095":130028},[],"Cambio",{"_3708":76180,"_31596":76107,"_21876":130030,"_5":15057,"_28736":129798,"_3095":130031},[],"A quién afecta",{"_3708":76181,"_31596":76107,"_21876":130033,"_5":15057,"_28736":129798,"_3095":130034},[],"Gravedad",{"_3708":76182,"_31596":76107,"_21876":130036,"_5":15057,"_28736":129798,"_3095":128507},[],{"_3708":76183,"_31596":76107,"_21876":130038,"_5":15057,"_28736":129798,"_3095":129806},[],{"_3708":76184,"_31596":76107,"_21876":130040,"_5":15057,"_28736":129798,"_3095":130041},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3708":76185,"_31596":76107,"_21876":130043,"_5":15057,"_28736":129798,"_3095":130044},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3708":76186,"_31596":76107,"_21876":130046,"_5":15057,"_28736":129798,"_3095":130047},[],"Copiar los datos a los volúmenes nuevos",{"_3708":76187,"_31596":76107,"_21876":130049,"_5":15057,"_28736":129798,"_3095":129810},[],{"_3708":76188,"_31596":76107,"_21876":130051,"_5":15057,"_28736":129798,"_3095":130052},[],"Todas las releases de Helm",{"_3708":76189,"_31596":76107,"_21876":130054,"_5":15057,"_28736":129798,"_3095":130055},[],"Alta: `helm upgrade` falla",{"_3708":76190,"_31596":76107,"_21876":130057,"_5":15057,"_28736":129798,"_3095":130058},[],"Eliminar o renombrar las claves heredadas",{"_3708":76191,"_31596":76107,"_21876":130060,"_5":15057,"_28736":129798,"_3095":122126},[],{"_3708":76192,"_31596":76107,"_21876":130062,"_5":15057,"_28736":129798,"_3095":130052},[],{"_3708":76193,"_31596":76107,"_21876":130064,"_5":15057,"_28736":129798,"_3095":130065},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3708":76194,"_31596":76107,"_21876":130067,"_5":15057,"_28736":129798,"_3095":130068},[],"Crear primero los Secrets; consulta el paso 2",{"_3708":76195,"_31596":76107,"_21876":130070,"_5":15057,"_28736":129798,"_3095":129817},[],{"_3708":76196,"_31596":76107,"_21876":130072,"_5":15057,"_28736":129798,"_3095":130073},[],"Todos los despliegues",{"_3708":76197,"_31596":76107,"_21876":130075,"_5":15057,"_28736":129798,"_3095":130076},[],"Alta: sin principal de bootstrap no hay administrador",{"_3708":76198,"_31596":76107,"_21876":130078,"_5":15057,"_28736":129798,"_3095":130079},[],"Configurar `services.authz`",{"_3708":76199,"_31596":76107,"_21876":130081,"_5":15057,"_28736":129798,"_3095":129821},[],{"_3708":76200,"_31596":76107,"_21876":130083,"_5":15057,"_28736":129798,"_3095":130052},[],{"_3708":76201,"_31596":76107,"_21876":130085,"_5":15057,"_28736":129798,"_3095":130086},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3708":76202,"_31596":76107,"_21876":130088,"_5":15057,"_28736":129798,"_3095":130089},[],"Mover JWKS y roles a `services.authz`",{"_3708":76203,"_31596":76107,"_21876":130091,"_5":15057,"_28736":129798,"_3095":129841},[],{"_3708":76204,"_31596":76107,"_21876":130093,"_5":15057,"_28736":129798,"_3095":130094},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3708":76205,"_31596":76107,"_21876":130096,"_5":15057,"_28736":129798,"_3095":130097},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3708":76206,"_31596":76107,"_21876":130099,"_5":15057,"_28736":129798,"_3095":130100},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3708":76207,"_31596":76107,"_21876":130102,"_5":15057,"_28736":129798,"_3095":129845},[],{"_3708":76208,"_31596":76107,"_21876":130104,"_5":15057,"_28736":129798,"_3095":130105},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3708":76209,"_31596":76107,"_21876":130107,"_5":15057,"_28736":129798,"_3095":130108},[],"Alta: el backend ya no arranca con ellos",{"_3708":76210,"_31596":76107,"_21876":130110,"_5":15057,"_28736":129798,"_3095":130111},[],"Pasar a PostgreSQL antes de actualizar",{"_3708":76211,"_31596":76107,"_21876":130113,"_5":15057,"_28736":129798,"_3095":129893},[],{"_3708":76212,"_31596":76107,"_21876":130115,"_5":15057,"_28736":129798,"_3095":130116},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3708":76213,"_31596":76107,"_21876":130118,"_5":15057,"_28736":129798,"_3095":130119},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3708":76214,"_31596":76107,"_21876":130121,"_5":15057,"_28736":129798,"_3095":130122},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3708":76215,"_31596":76107,"_21876":130124,"_5":15057,"_28736":129798,"_3095":130125},[],"Webhooks con referencias a archivos",{"_3708":76216,"_31596":76107,"_21876":130127,"_5":15057,"_28736":129798,"_3095":130128},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3708":76217,"_31596":76107,"_21876":130130,"_5":15057,"_28736":129798,"_3095":130131},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3708":76218,"_31596":76107,"_21876":130133,"_5":15057,"_28736":129798,"_3095":130134},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3708":76219,"_31596":76107,"_21876":130136,"_5":15057,"_28736":129798,"_3095":129825},[],{"_3708":76220,"_31596":76107,"_21876":130138,"_5":15057,"_28736":129798,"_3095":130139},[],"Releases con identidades por servicio o material de claves montado",{"_3708":76221,"_31596":76107,"_21876":130141,"_5":15057,"_28736":129798,"_3095":130142},[],"Media: los servicios no pueden leer sus archivos",{"_3708":76222,"_31596":76107,"_21876":130144,"_5":15057,"_28736":129798,"_3095":130145},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3708":76223,"_31596":76107,"_21876":130147,"_5":15057,"_28736":129798,"_3095":129829},[],{"_3708":76224,"_31596":76107,"_21876":130149,"_5":15057,"_28736":129798,"_3095":130150},[],"Releases que definen `amqp.tls`",{"_3708":76225,"_31596":76107,"_21876":130152,"_5":15057,"_28736":129798,"_3095":130153},[],"Media: los clientes se conectan al puerto equivocado",{"_3708":76226,"_31596":76107,"_21876":130155,"_5":15057,"_28736":129798,"_3095":130156},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3708":76227,"_31596":76107,"_21876":130158,"_5":15057,"_28736":129798,"_3095":129849},[],{"_3708":76228,"_31596":76107,"_21876":130160,"_5":15057,"_28736":129798,"_3095":130161},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3708":76229,"_31596":76107,"_21876":130163,"_5":15057,"_28736":129798,"_3095":130164},[],"Media: las claves de CA quedan sin gestionar",{"_3708":76230,"_31596":76107,"_21876":130166,"_5":15057,"_28736":129798,"_3095":130167},[],"Ejecutar la migración de CA a KMS",{"_3708":76231,"_31596":76107,"_21876":130169,"_5":15057,"_28736":129798,"_3095":130170},[],"Verificación del certificado del receptor",{"_3708":76232,"_31596":76107,"_21876":130172,"_5":15057,"_28736":129798,"_3095":130173},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3708":76233,"_31596":76107,"_21876":130175,"_5":15057,"_28736":129798,"_3095":130176},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3708":76234,"_31596":76107,"_21876":130178,"_5":15057,"_28736":129798,"_3095":130179},[],"Poner `insecure_skip_verify` a `false`",{"_3708":76235,"_31596":76107,"_21876":130181,"_5":15057,"_28736":129798,"_3095":129865},[],{"_3708":76236,"_31596":76107,"_21876":130183,"_5":15057,"_28736":129798,"_3095":130184},[],"Scripts y consolas que editan DMS por API",{"_3708":76237,"_31596":76107,"_21876":130186,"_5":15057,"_28736":129798,"_3095":130187},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3708":76238,"_31596":76107,"_21876":130189,"_5":15057,"_28736":129798,"_3095":130190},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3708":76239,"_31596":76107,"_21876":130192,"_5":15057,"_28736":129798,"_3095":129869},[],{"_3708":76240,"_31596":76107,"_21876":130194,"_5":15057,"_28736":129798,"_3095":130195},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3708":76241,"_31596":76107,"_21876":130197,"_5":15057,"_28736":129798,"_3095":130198},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3708":76242,"_31596":76107,"_21876":130200,"_5":15057,"_28736":129798,"_3095":130201},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3708":76243,"_31596":76107,"_21876":130203,"_5":15057,"_28736":129798,"_3095":129889},[],{"_3708":76244,"_31596":76107,"_21876":130205,"_5":15057,"_28736":129798,"_3095":130206},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3708":76245,"_31596":76107,"_21876":130208,"_5":15057,"_28736":129798,"_3095":130209},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3708":76246,"_31596":76107,"_21876":130211,"_5":15057,"_28736":129798,"_3095":130212},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3708":76247,"_31596":76107,"_21876":130214,"_5":15057,"_28736":129798,"_3095":129897},[],{"_3708":76248,"_31596":76107,"_21876":130216,"_5":15057,"_28736":129798,"_3095":130217},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3708":76249,"_31596":76107,"_21876":130219,"_5":15057,"_28736":129798,"_3095":130220},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3708":76250,"_31596":76107,"_21876":130222,"_5":15057,"_28736":129798,"_3095":130223},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3708":76251,"_31596":76107,"_21876":130225,"_5":15057,"_28736":129798,"_3095":129901},[],{"_3708":76252,"_31596":76107,"_21876":130227,"_5":15057,"_28736":129798,"_3095":130228},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3708":76253,"_31596":76107,"_21876":130230,"_5":15057,"_28736":129798,"_3095":130231},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3708":76254,"_31596":76107,"_21876":130233,"_5":15057,"_28736":129798,"_3095":130234},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3708":76255,"_31596":76107,"_21876":130236,"_5":15057,"_28736":129798,"_3095":129885},[],{"_3708":76256,"_31596":76107,"_21876":130238,"_5":15057,"_28736":129798,"_3095":130239},[],"Consumidores que leen el campo `events` del dispositivo",{"_3708":76257,"_31596":76107,"_21876":130241,"_5":15057,"_28736":129798,"_3095":130242},[],"Media: el campo desaparece",{"_3708":76258,"_31596":76107,"_21876":130244,"_5":15057,"_28736":129798,"_3095":130245},[],"Usar los nuevos endpoints de eventos",{"_3708":76259,"_31596":76107,"_21876":130247,"_5":15057,"_28736":129798,"_3095":129913},[],{"_3708":76260,"_31596":76107,"_21876":130249,"_5":15057,"_28736":129798,"_3095":130250},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3708":76261,"_31596":76107,"_21876":130252,"_5":15057,"_28736":129798,"_3095":130253},[],"Media: la migración de la VA aborta",{"_3708":76262,"_31596":76107,"_21876":130255,"_5":15057,"_28736":129798,"_3095":130256},[],"Corregir los roles afectados antes de actualizar",{"_3708":76263,"_31596":76107,"_21876":130258,"_5":15057,"_28736":129798,"_3095":129833},[],{"_3708":76264,"_31596":76107,"_21876":130260,"_5":15057,"_28736":129798,"_3095":130261},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3708":76265,"_31596":76107,"_21876":130263,"_5":15057,"_28736":129798,"_3095":130264},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3708":76266,"_31596":76107,"_21876":130266,"_5":15057,"_28736":129798,"_3095":130267},[],"Actualizar el archivo de values",{"_3708":76267,"_31596":76107,"_21876":130269,"_5":15057,"_28736":129798,"_3095":129877},[],{"_3708":76268,"_31596":76107,"_21876":130271,"_5":15057,"_28736":129798,"_3095":130272},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3708":76269,"_31596":76107,"_21876":130274,"_5":15057,"_28736":129798,"_3095":130275},[],"Baja: prevalece el ID de la URL",{"_3708":76270,"_31596":76107,"_21876":130277,"_5":15057,"_28736":129798,"_3095":130278},[],"Enviar el ID en la URL",{"_3708":76271,"_31596":76107,"_21876":130280,"_5":15057,"_28736":129798,"_3095":129905},[],{"_3708":76272,"_31596":76107,"_21876":130282,"_5":15057,"_28736":129798,"_3095":130283},[],"Clientes que envían un `id` al crear o importar CAs",{"_3708":76273,"_31596":76107,"_21876":130285,"_5":15057,"_28736":129798,"_3095":130286},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3708":76274,"_31596":76107,"_21876":130288,"_5":15057,"_28736":129798,"_3095":130289},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3708":76275,"_31596":76107,"_21876":130291,"_5":15057,"_28736":129798,"_3095":129909},[],{"_3708":76276,"_31596":76107,"_21876":130293,"_5":15057,"_28736":129798,"_3095":130294},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3708":76277,"_31596":76107,"_21876":130296,"_5":15057,"_28736":129798,"_3095":130297},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3708":76278,"_31596":76107,"_21876":130299,"_5":15057,"_28736":129798,"_3095":130300},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3708":76279,"_31596":76107,"_21876":130302,"_5":15057,"_28736":129798,"_3095":129881},[],{"_3708":76280,"_31596":76107,"_21876":130304,"_5":15057,"_28736":129798,"_3095":130305},[],"Consumidores que comparan el `type` del certificado",{"_3708":76281,"_31596":76107,"_21876":130307,"_5":15057,"_28736":129798,"_3095":130308},[],"Baja: dos valores cambian de nombre",{"_3708":76282,"_31596":76107,"_21876":130310,"_5":15057,"_28736":129798,"_3095":130311},[],"Adaptar los consumidores",{"_3708":76283,"_31596":76107,"_21876":130313,"_5":15057,"_28736":129798,"_3095":129873},[],{"_3708":76284,"_31596":76107,"_21876":130315,"_5":15057,"_28736":129798,"_3095":130316},[],"Cualquier DMS",{"_3708":76285,"_31596":76107,"_21876":130318,"_5":15057,"_28736":129798,"_3095":130319},[],"Baja: solo informativo",{"_3708":76286,"_31596":76107,"_21876":130321,"_5":15057,"_28736":129798,"_3095":130322},[],"Revisar ambos bloques antes de editar",{"_3708":76287,"_31596":76107,"_21876":130324,"_5":15057,"_28736":129805,"_3095":130325},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3708":76288,"_31596":76107,"_21876":130327,"_5":15057,"_28736":129805,"_3095":130328},[],"El paso 4 de la guía de migración copia los datos.",{"_3708":76289,"_31596":76107,"_21876":130330,"_5":15057,"_28736":129809,"_3095":130331},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3708":76290,"_31596":76107,"_21876":130333,"_5":15057,"_28736":129813,"_3095":130334},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3708":76291,"_31596":76107,"_21876":130336,"_5":15057,"_28736":129813,"_3095":130337},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3708":76292,"_31596":76107,"_21876":130339,"_5":15057,"_28736":129816,"_3095":130340},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3708":76293,"_31596":76107,"_21876":130342,"_5":15057,"_28736":129820,"_3095":130343},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3708":76294,"_31596":76107,"_21876":130345,"_5":15057,"_28736":129824,"_3095":130346},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3708":76295,"_31596":76107,"_21876":130348,"_5":15057,"_28736":129824,"_3095":130349},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3708":76296,"_31596":76107,"_21876":130351,"_5":15057,"_28736":129824,"_3095":130352},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3708":76297,"_31596":76107,"_21876":130354,"_5":15057,"_28736":129828,"_3095":130355},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3708":76298,"_31596":76107,"_21876":130357,"_5":15057,"_28736":129832,"_3095":130358},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3708":76299,"_31596":76107,"_21876":130360,"_5":15057,"_28736":129832,"_3095":130361},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3708":76300,"_31596":76107,"_21876":130363,"_5":15057,"_28736":129832,"_3095":130364},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3708":76301,"_31596":76107,"_21876":130366,"_5":15057,"_28736":129832,"_3095":130367},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3708":76302,"_31596":76107,"_21876":130369,"_5":15057,"_28736":129832,"_3095":130370},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3708":76303,"_31596":76107,"_21876":130372,"_5":15057,"_28736":129832,"_3095":130373},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3708":76304,"_31596":76107,"_21876":130375,"_5":15057,"_28736":129840,"_3095":130376},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3708":76305,"_31596":76107,"_21876":130378,"_5":15057,"_28736":129840,"_3095":130379},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3708":76306,"_31596":76107,"_21876":130381,"_5":15057,"_28736":129840,"_3095":130382},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3708":76307,"_31596":76107,"_21876":130384,"_5":15057,"_28736":129840,"_3095":130385},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3708":76308,"_31596":76107,"_21876":130387,"_5":15057,"_28736":129840,"_3095":130388},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3708":76309,"_31596":76107,"_21876":130390,"_5":15057,"_28736":129844,"_3095":130391},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3708":76310,"_31596":76107,"_21876":130393,"_5":15057,"_28736":129848,"_3095":130394},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3708":76311,"_31596":76107,"_21876":130396,"_5":15057,"_28736":129848,"_3095":130397},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3708":76312,"_31596":76107,"_21876":130399,"_5":15057,"_28736":129848,"_3095":130400},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3708":76313,"_31596":76107,"_21876":130402,"_5":15057,"_28736":129848,"_3095":130403},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3708":76314,"_31596":76107,"_21876":130405,"_5":15057,"_28736":129848,"_3095":130406},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3708":76315,"_31596":76107,"_21876":130408,"_5":15057,"_28736":129848,"_3095":130409},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3708":76316,"_31596":76107,"_21876":130411,"_5":15057,"_28736":129848,"_3095":130412},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3708":76317,"_31596":76107,"_21876":130414,"_5":15057,"_28736":129848,"_3095":130415},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3708":76318,"_31596":76107,"_21876":130417,"_5":15057,"_28736":129852,"_3095":130418},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3708":76319,"_31596":76107,"_21876":130420,"_5":15057,"_28736":129860,"_3095":130421},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3708":76320,"_31596":76107,"_21876":130423,"_5":15057,"_28736":129860,"_3095":130424},[],"Campo en 3.8.0",{"_3708":76321,"_31596":76107,"_21876":130426,"_5":15057,"_28736":129860,"_3095":130427},[],"Campo en 4.0.0",{"_3708":76322,"_31596":76107,"_21876":130429,"_5":15057,"_28736":129860,"_3095":60619},[],{"_3708":76323,"_31596":76107,"_21876":130431,"_5":15057,"_28736":129860,"_3095":130432},[],"`insecure_skip_verify` (con el valor negado)",{"_3708":76324,"_31596":76107,"_21876":130434,"_5":15057,"_28736":129860,"_3095":60625},[],{"_3708":76325,"_31596":76107,"_21876":130436,"_5":15057,"_28736":129860,"_3095":60628},[],{"_3708":76326,"_31596":76107,"_21876":130438,"_5":15057,"_28736":129860,"_3095":60631},[],{"_3708":76327,"_31596":76107,"_21876":130440,"_5":15057,"_28736":129860,"_3095":60634},[],{"_3708":76328,"_31596":76107,"_21876":130442,"_5":15057,"_28736":129860,"_3095":60637},[],{"_3708":76329,"_31596":76107,"_21876":130444,"_5":15057,"_28736":129860,"_3095":60640},[],{"_3708":76330,"_31596":76107,"_21876":130446,"_5":15057,"_28736":129860,"_3095":130447},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3708":76331,"_31596":76107,"_21876":130449,"_5":15057,"_28736":129860,"_3095":130450},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3708":76332,"_31596":76107,"_21876":130452,"_5":15057,"_28736":129860,"_3095":130453},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3708":76333,"_31596":76107,"_21876":130455,"_5":15057,"_28736":129864,"_3095":130456},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3708":76334,"_31596":76107,"_21876":130458,"_5":15057,"_28736":129864,"_3095":130459},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3708":76335,"_31596":76107,"_21876":130461,"_5":15057,"_28736":129864,"_3095":130462},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3708":76336,"_31596":76107,"_21876":130464,"_5":15057,"_28736":129868,"_3095":130465},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3708":76337,"_31596":76107,"_21876":130467,"_5":15057,"_28736":129868,"_3095":130468},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3708":76338,"_31596":76107,"_21876":130470,"_5":15057,"_28736":129872,"_3095":130471},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3708":76339,"_31596":76107,"_21876":130473,"_5":15057,"_28736":129876,"_3095":130474},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3708":76340,"_31596":76107,"_21876":130476,"_5":15057,"_28736":129880,"_3095":130477},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3708":76341,"_31596":76107,"_21876":130479,"_5":15057,"_28736":129884,"_3095":130480},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3708":76342,"_31596":76107,"_21876":130482,"_5":15057,"_28736":129884,"_3095":130483},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3708":76343,"_31596":76107,"_21876":130485,"_5":15057,"_28736":129884,"_3095":130486},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3708":76344,"_31596":76107,"_21876":130488,"_5":15057,"_28736":129884,"_3095":130489},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. La entrega es de tipo best effort: los eventos emitidos mientras no hay ningún cliente conectado no se reenvían en la siguiente conexión. El servidor cierra cada stream tras un tiempo de vida máximo, 10 minutos por omisión y configurable con la opción `sse_max_stream_duration` de Device Manager, y el cliente se reconecta para seguir recibiendo eventos. Cuando una instancia alcanza su límite de suscriptores, configurado con la opción `sse_max_subscribers` de Device Manager (1000 por omisión y compartido por todos los streams de la instancia), los nuevos streams reciben una respuesta `503` con una cabecera `Retry-After`. Cada stream vuelve a comprobar el permiso de lectura del dispositivo mientras está activo, y lo cierra cuando el permiso se revoca o no se puede verificar; la reconexión vuelve a pasar por las comprobaciones de autorización habituales. En un despliegue con Helm, define `services.deviceManager.sseEnabled` como `false` para deshabilitar SSE (por defecto `true`); consulta Flujo de eventos de dispositivo (SSE).",{"_3708":76345,"_31596":76107,"_21876":130491,"_5":15057,"_28736":129884,"_3095":130492},[],"En AMQP, cada instancia de Device Manager enlaza una cola de suscriptores con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. La cola es duradera y auto-delete, con una expiración de una hora (`x-expires`), de modo que el broker la elimina cuando la instancia se detiene o su conexión muere, y no hace falta ninguna política de limpieza. Solo en proveedores de event bus sin soporte de suscriptores efímeros puede quedar una cola duradera por proceso tras detenerse su instancia; revisa esos proveedores si observas colas residuales.",{"_3708":76346,"_31596":76107,"_21876":130494,"_5":15057,"_28736":129888,"_3095":130495},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3708":76347,"_31596":76107,"_21876":130497,"_5":15057,"_28736":129892,"_3095":130498},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3708":76348,"_31596":76107,"_21876":130500,"_5":15057,"_28736":129892,"_3095":130501},[],"Ruta",{"_3708":76349,"_31596":76107,"_21876":130503,"_5":15057,"_28736":129892,"_3095":122783},[],{"_3708":76350,"_31596":76107,"_21876":130505,"_5":15057,"_28736":129892,"_3095":60702},[],{"_3708":76351,"_31596":76107,"_21876":130507,"_5":15057,"_28736":129892,"_3095":130508},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3708":76352,"_31596":76107,"_21876":130510,"_5":15057,"_28736":129892,"_3095":60708},[],{"_3708":76353,"_31596":76107,"_21876":130512,"_5":15057,"_28736":129892,"_3095":130513},[],"Lee los ajustes de una CA.",{"_3708":76354,"_31596":76107,"_21876":130515,"_5":15057,"_28736":129892,"_3095":60714},[],{"_3708":76355,"_31596":76107,"_21876":130517,"_5":15057,"_28736":129892,"_3095":130518},[],"Sustituye los `crl_options`.",{"_3708":76356,"_31596":76107,"_21876":130520,"_5":15057,"_28736":129892,"_3095":60720},[],{"_3708":76357,"_31596":76107,"_21876":130522,"_5":15057,"_28736":129892,"_3095":130523},[],"Elimina los ajustes archivados de una CA.",{"_3708":76358,"_31596":76107,"_21876":130525,"_5":15057,"_28736":129892,"_3095":130526},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3708":76359,"_31596":76107,"_21876":130528,"_5":15057,"_28736":129892,"_3095":130529},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3708":76360,"_31596":76107,"_21876":130531,"_5":15057,"_28736":129892,"_3095":130532},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3708":76361,"_31596":76107,"_21876":130534,"_5":15057,"_28736":129892,"_3095":130535},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3708":76362,"_31596":76107,"_21876":130537,"_5":15057,"_28736":129892,"_3095":130538},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3708":76363,"_31596":76107,"_21876":130540,"_5":15057,"_28736":129892,"_3095":130541},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3708":76364,"_31596":76107,"_21876":130543,"_5":15057,"_28736":129892,"_3095":130544},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3708":76365,"_31596":76107,"_21876":130546,"_5":15057,"_28736":129892,"_3095":130547},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3708":76366,"_31596":76107,"_21876":130549,"_5":15057,"_28736":129892,"_3095":130550},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3708":76367,"_31596":76107,"_21876":130552,"_5":15057,"_28736":129892,"_3095":130553},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3708":76368,"_31596":76107,"_21876":130555,"_5":15057,"_28736":129892,"_3095":130556},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3708":76369,"_31596":76107,"_21876":130558,"_5":15057,"_28736":129896,"_3095":130559},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3708":76370,"_31596":76107,"_21876":130561,"_5":15057,"_28736":129900,"_3095":130562},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3708":76371,"_31596":76107,"_21876":130564,"_5":15057,"_28736":129904,"_3095":130565},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3708":76372,"_31596":76107,"_21876":130567,"_5":15057,"_28736":129908,"_3095":130568},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3708":76373,"_31596":76107,"_21876":130570,"_5":15057,"_28736":129908,"_3095":130571},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3708":76374,"_31596":76107,"_21876":130573,"_5":15057,"_28736":129912,"_3095":130574},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3708":76375,"_31596":76107,"_21876":130576,"_5":15057,"_28736":129916,"_3095":130577},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3708":76376,"_31596":76107,"_21876":130579,"_5":15057,"_28736":129920,"_3095":130580},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3708":76377,"_31596":76107,"_21876":130582,"_5":15057,"_28736":129920,"_3095":130583},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3708":76378,"_31596":76107,"_21876":130585,"_5":15057,"_28736":129920,"_3095":130586},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3708":76379,"_31596":76107,"_21876":130588,"_5":15057,"_28736":129920,"_3095":130589},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3708":76380,"_31596":76107,"_21876":130591,"_5":15057,"_28736":129920,"_3095":130592},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3708":76381,"_31596":76107,"_21876":130594,"_5":15057,"_28736":129920,"_3095":130595},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3708":76382,"_31596":76107,"_21876":130597,"_5":15057,"_28736":129924,"_3095":130598},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3708":76383,"_31596":76107,"_21876":130600,"_5":15057,"_28736":129924,"_3095":130601},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3708":76384,"_31596":76107,"_21876":130603,"_5":15057,"_28736":129924,"_3095":130604},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3708":76385,"_31596":76107,"_21876":130606,"_5":15057,"_28736":129924,"_3095":130607},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3708":76386,"_31596":76107,"_21876":130609,"_5":15057,"_28736":129924,"_3095":130610},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3708":76387,"_31596":76107,"_21876":130612,"_5":15057,"_28736":129928,"_3095":130613},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3708":76388,"_31596":76107,"_21876":130615,"_5":15057,"_28736":129928,"_3095":130616},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3708":76389,"_31596":76107,"_21876":130618,"_5":15057,"_28736":129928,"_3095":130619},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3708":76390,"_31596":76107,"_21876":130621,"_5":15057,"_28736":129928,"_3095":60822},[],{"_3708":76391,"_31596":76107,"_21876":130623,"_5":15057,"_28736":129928,"_3095":130624},[],"Claves de datos obligatorias",{"_3708":76392,"_31596":76107,"_21876":130626,"_5":15057,"_28736":129928,"_3095":130627},[],"Cuándo",{"_3708":76393,"_31596":76107,"_21876":130629,"_5":15057,"_28736":129928,"_3095":130630},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3708":76394,"_31596":76107,"_21876":130632,"_5":15057,"_28736":129928,"_3095":60834},[],{"_3708":76395,"_31596":76107,"_21876":130634,"_5":15057,"_28736":129928,"_3095":130635},[],"Siempre",{"_3708":76396,"_31596":76107,"_21876":130637,"_5":15057,"_28736":129928,"_3095":130638},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3708":76397,"_31596":76107,"_21876":130640,"_5":15057,"_28736":129928,"_3095":60834},[],{"_3708":76398,"_31596":76107,"_21876":130642,"_5":15057,"_28736":129928,"_3095":130635},[],{"_3708":76399,"_31596":76107,"_21876":130644,"_5":15057,"_28736":129928,"_3095":60847},[],{"_3708":76400,"_31596":76107,"_21876":130646,"_5":15057,"_28736":129928,"_3095":60834},[],{"_3708":76401,"_31596":76107,"_21876":130648,"_5":15057,"_28736":129928,"_3095":130649},[],"Solo cuando hay autenticación SMTP",{"_3708":76402,"_31596":76107,"_21876":130651,"_5":15057,"_28736":129928,"_3095":130652},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3708":76403,"_31596":76107,"_21876":130654,"_5":15057,"_28736":129928,"_3095":130655},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3708":76404,"_31596":76107,"_21876":130657,"_5":15057,"_28736":129928,"_3095":130658},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3708":76405,"_31596":76107,"_21876":130660,"_5":15057,"_28736":129928,"_3095":130661},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3708":76406,"_31596":76107,"_21876":130663,"_5":15057,"_28736":129928,"_3095":130664},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3708":76407,"_31596":76107,"_21876":130666,"_5":15057,"_28736":129928,"_3095":130667},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3708":76408,"_31596":76107,"_21876":130669,"_5":15057,"_28736":129928,"_3095":130670},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3708":76409,"_31596":76107,"_21876":130672,"_5":15057,"_28736":129928,"_3095":130673},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3708":76410,"_31596":76107,"_21876":130675,"_5":15057,"_28736":129928,"_3095":130676},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3708":76411,"_31596":76107,"_21876":130678,"_5":15057,"_28736":129928,"_3095":130679},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3708":76412,"_31596":76107,"_21876":130681,"_5":15057,"_28736":129928,"_3095":130682},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3708":76413,"_31596":76107,"_21876":130684,"_5":15057,"_28736":129928,"_3095":130685},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3708":76414,"_31596":76107,"_21876":130687,"_5":15057,"_28736":129928,"_3095":130688},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3708":76415,"_31596":76107,"_21876":130690,"_5":15057,"_28736":129928,"_3095":130691},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3708":76416,"_31596":76107,"_21876":130693,"_5":15057,"_28736":129928,"_3095":130694},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3708":76417,"_31596":76107,"_21876":130696,"_5":15057,"_28736":129932,"_3095":130697},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3708":76418,"_31596":76107,"_21876":130699,"_5":15057,"_28736":129932,"_3095":130700},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3708":76419,"_31596":76107,"_21876":130702,"_5":15057,"_28736":129936,"_3095":130703},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3708":76420,"_31596":76107,"_21876":130705,"_5":15057,"_28736":129936,"_3095":130706},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3708":76421,"_31596":76107,"_21876":130708,"_5":15057,"_28736":129936,"_3095":130709},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3708":76422,"_31596":76107,"_21876":130711,"_5":15057,"_28736":129936,"_3095":130712},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3708":76423,"_31596":76107,"_21876":130714,"_5":15057,"_28736":129936,"_3095":130715},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3708":76424,"_31596":76107,"_21876":130717,"_5":15057,"_28736":129936,"_3095":130718},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3708":76425,"_31596":76107,"_21876":130720,"_5":15057,"_28736":129936,"_3095":130721},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3708":76426,"_31596":76107,"_21876":130723,"_5":15057,"_28736":129936,"_3095":130724},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3708":76427,"_31596":76107,"_21876":130726,"_5":15057,"_28736":129936,"_3095":130727},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3708":76428,"_31596":76107,"_21876":130729,"_5":15057,"_28736":129936,"_3095":130730},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3708":76429,"_31596":76107,"_21876":130732,"_5":15057,"_28736":129936,"_3095":130733},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3708":76430,"_31596":76107,"_21876":130735,"_5":15057,"_28736":129940,"_3095":130736},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3708":76431,"_31596":76107,"_21876":130738,"_5":15057,"_28736":129940,"_3095":130739},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3708":76432,"_31596":76107,"_21876":130741,"_5":15057,"_28736":129944,"_3095":130742},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3708":76433,"_31596":76107,"_21876":130744,"_5":15057,"_28736":129944,"_3095":130745},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3708":76434,"_31596":76107,"_21876":130747,"_5":15057,"_28736":129944,"_3095":130748},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3708":76435,"_31596":76107,"_21876":130750,"_5":15057,"_28736":129944,"_3095":130751},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3708":76436,"_31596":76107,"_21876":130753,"_5":15057,"_28736":129944,"_3095":130754},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3708":76437,"_31596":76107,"_21876":130756,"_5":15057,"_28736":129944,"_3095":130757},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3708":76438,"_31596":76107,"_21876":130759,"_5":15057,"_28736":129944,"_3095":130760},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3708":76439,"_31596":76107,"_21876":130762,"_5":15057,"_28736":129944,"_3095":130763},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3708":76440,"_31596":76107,"_21876":130765,"_5":15057,"_28736":129948,"_3095":130766},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3708":76441,"_31596":76107,"_21876":130768,"_5":15057,"_28736":129948,"_3095":130769},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3708":76442,"_31596":76107,"_21876":130771,"_5":15057,"_28736":129948,"_3095":130772},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3708":76443,"_31596":76107,"_21876":130774,"_5":15057,"_28736":129948,"_3095":130775},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3708":76444,"_31596":76107,"_21876":130777,"_5":15057,"_28736":129948,"_3095":130778},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3708":76445,"_31596":76107,"_21876":130780,"_5":15057,"_28736":129948,"_3095":130781},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3708":76446,"_31596":76107,"_21876":130783,"_5":15057,"_28736":129948,"_3095":130784},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3708":76447,"_31596":76107,"_21876":130786,"_5":15057,"_28736":129948,"_3095":130787},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3708":76448,"_31596":76107,"_21876":130789,"_5":15057,"_28736":129948,"_3095":130790},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3708":76449,"_31596":76107,"_21876":130792,"_5":15057,"_28736":129948,"_3095":130793},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3708":76450,"_31596":76107,"_21876":130795,"_5":15057,"_28736":129948,"_3095":130796},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3708":76451,"_31596":76107,"_21876":130798,"_5":15057,"_28736":129951,"_3095":130799},[],"Tras la actualización, comprueba en este orden:",{"_3708":76452,"_31596":76107,"_21876":130801,"_5":15057,"_28736":129951,"_3095":130802},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3708":76453,"_31596":76107,"_21876":130804,"_5":15057,"_28736":129951,"_3095":130805},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3708":76454,"_31596":76107,"_21876":130807,"_5":15057,"_28736":129951,"_3095":130808},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3708":76455,"_31596":76107,"_21876":130810,"_5":15057,"_28736":129951,"_3095":130811},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3708":76456,"_31596":76107,"_21876":130813,"_5":15057,"_28736":129951,"_3095":130814},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3708":76457,"_31596":76107,"_21876":130816,"_5":15057,"_28736":129951,"_3095":130817},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3708":76458,"_31596":76107,"_21876":130819,"_5":15057,"_28736":129951,"_3095":130820},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3708":76459,"_31596":76107,"_21876":130822,"_5":15057,"_28736":129951,"_3095":130823},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3708":76460,"_31596":76107,"_21876":130825,"_5":15057,"_28736":129951,"_3095":130826},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada. En AMQP las colas de suscriptores de SSE son auto-delete y desaparecen cuando su instancia se detiene; en proveedores de event bus sin soporte de suscriptores efímeros, comprueba que no se acumulen colas de SSE por proceso.",{"_3708":76461,"_31596":76107,"_21876":130828,"_5":15057,"_28736":129951,"_3095":130829},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3708":76462,"_31596":76107,"_21876":130831,"_5":15057,"_28736":129951,"_3095":130832},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3708":76463,"_31596":76107,"_21876":130834,"_5":15057,"_28736":129951,"_3095":130835},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3708":76464,"_31596":76107,"_21876":130837,"_5":15057,"_28736":129951,"_3095":130838},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3708":76465,"_31596":76107,"_21876":130840,"_5":15057,"_28736":129951,"_3095":130841},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3708":76466,"_31596":76107,"_21876":130843,"_5":15057,"_28736":129951,"_3095":130844},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3708":76467,"_31596":76107,"_21876":130846,"_5":15057,"_28736":129955,"_3095":130847},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3708":76468,"_31596":76107,"_21876":130849,"_5":15057,"_28736":129955,"_3095":130850},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3708":76469,"_31596":76107,"_21876":130852,"_5":15057,"_28736":129955,"_3095":130853},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3708":76470,"_31596":76107,"_21876":130855,"_5":15057,"_28736":129955,"_3095":130856},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3708":76471,"_31596":76107,"_21876":130858,"_5":15057,"_28736":129955,"_3095":130859},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_61065":130861,"_61067":130862,"_61069":130863,"_61071":130864,"_18967":3130,"_73390":3130},"spanish",[3095,31596,5,28736],{"_3095":26106,"_31596":26106,"_5":26106,"_28736":26106},{"_3095":130865,"_31596":133943,"_5":137021,"_28736":140099},{"_4866":130866,"_61075":130867,"_5":26106},{"_15138":7963,"_15517":5385,"_15536":4935,"_30575":7817,"_15523":4813,"_20780":5777,"_15159":17510,"_15166":22563,"_30512":3550,"_30925":8004,"_30962":16795,"_30551":4609,"_36031":5222,"_30654":19917,"_31017":10327,"_36038":5634,"_36041":4250,"_36044":8052,"_36047":3388,"_31419":3508,"_36052":4669,"_36054":3411,"_31454":19289,"_15532":3441,"_36058":7891,"_36061":3584,"_36063":7351,"_31001":5676,"_31439":17940,"_31467":4769,"_36068":22054,"_36070":6282,"_36072":4124,"_30665":8066,"_36075":3672,"_36077":5137,"_36079":5407,"_36081":8067,"_36083":15187,"_30588":7678,"_36086":7305,"_36088":5071,"_30582":16245,"_31038":5823,"_36092":5362,"_36094":7556,"_36097":4611,"_30628":10293,"_36101":8574,"_30503":6265,"_36104":12580,"_30556":3240,"_36107":5192,"_36109":13919,"_36112":16317,"_15526":10038,"_36115":6240,"_36117":6617,"_36120":4585,"_36122":3417,"_36124":11527,"_36126":21630,"_36128":8062,"_20783":3595,"_36131":7655,"_36133":4930,"_30529":4138,"_30995":3496,"_36137":12200,"_36139":3299,"_36141":9620,"_31483":3617,"_36144":3825,"_36146":3777,"_36148":6921,"_31576":4766,"_31054":18969,"_31661":4816,"_36153":3662,"_30566":8299,"_36156":5025,"_36158":3509,"_36160":7364,"_31499":18117,"_30648":6954,"_30023":6308,"_36165":3580,"_36167":18016,"_36169":5228,"_30691":5825,"_36173":4603,"_30989":5779,"_36177":8951,"_36179":5809,"_36181":7994,"_36183":4270,"_36185":3461,"_36187":4939,"_30680":6935,"_30930":13910,"_36191":5365,"_36193":20331,"_36195":5780,"_36198":4982,"_36200":8071,"_36202":10134,"_36204":3624,"_36206":3999,"_36208":3263,"_36210":12763,"_36213":7044,"_36215":8950,"_36217":12937,"_36219":5183,"_36221":3396,"_36224":3179,"_36226":24689,"_36229":11524,"_36232":22099,"_36234":5340,"_36236":6618,"_36238":8830,"_36240":5172,"_36242":51475,"_36244":10945,"_36246":4166,"_36248":4194,"_31000":3547,"_36251":4922,"_36253":19049,"_36255":5790,"_36257":6093,"_36259":9437,"_36261":7621,"_36263":5171,"_36265":7910,"_36267":10244,"_36269":3342,"_36271":10942,"_36273":6138,"_36275":4164,"_36277":3344,"_36279":9911,"_36281":7485,"_36283":4168,"_36285":5187,"_36287":4894,"_36289":3132,"_36291":3160,"_36293":6592,"_36295":7241,"_36297":7950,"_36299":5259,"_36301":3360,"_36303":5224,"_36305":4167,"_36307":7965,"_36309":4607,"_36311":4165,"_36313":3652,"_36315":3512,"_36317":6092,"_36319":13912,"_36321":8022,"_36323":5219,"_36325":135