ki/concepts/certificate-lifecycle.mdx",{"_39":127,"_46":86,"_61":-7,"_41":128},"es:_2","Claves, autoridades y certificados",{"_39":130,"_46":58,"_41":131,"_52":132,"_61":-7,"_11":133,"_63":134},"es:platform/pki/key-management.mdx","Claves y motores criptográficos","Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.","/docs/pr-preview/pr-78/es/platform/pki/key-management",{"_65":135},"platform/pki/key-management.mdx",{"_39":137,"_46":58,"_41":138,"_52":139,"_61":-7,"_11":140,"_63":141},"es:platform/pki/certificate-authorities.mdx","Autoridades","Crea, importa y opera las autoridades que establecen la confianza de tu PKI.","/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities",{"_65":142},"platform/pki/certificate-authorities.mdx",{"_39":144,"_46":58,"_41":145,"_52":146,"_61":-7,"_11":147,"_63":148},"es:platform/pki/certificate-profiles.mdx","Perfiles de certificado","Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.","/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles",{"_65":149},"platform/pki/certificate-profiles.mdx",{"_39":151,"_46":58,"_41":152,"_52":153,"_61":-7,"_11":154,"_63":155},"es:platform/pki/ca-hierarchy-and-rotation.mdx","Jerarquía y rotación","Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.","/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation",{"_65":156},"platform/pki/ca-hierarchy-and-rotation.mdx",{"_39":158,"_46":58,"_41":159,"_52":160,"_61":-7,"_11":161,"_63":162},"es:platform/pki/certificates.mdx","Certificados","Consulta, descarga y revoca los certificados emitidos por Lamassu.","/docs/pr-preview/pr-78/es/platform/pki/certificates",{"_65":163},"platform/pki/certificates.mdx",{"_39":165,"_46":58,"_41":166,"_52":167,"_61":-7,"_11":168,"_63":169},"es:platform/pki/enrollment-protocols.mdx","Protocolos de enrolamiento","Solicita y renueva certificados de una CA de Lamassu.","/docs/pr-preview/pr-78/