.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud shrink-0\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg>","es:platform/iot-fleets",{"_197":316},"platform/iot-fleets/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cpu shrink-0\" aria-hidden=\"true\"><path d=\"M12 20v2\"></path><path d=\"M12 2v2\"></path><path d=\"M17 20v2\"></path><path d=\"M17 2v2\"></path><path d=\"M2 12h2\"></path><path d=\"M2 17h2\"></path><path d=\"M2 7h2\"></path><path d=\"M20 12h2\"></path><path d=\"M20 17h2\"></path><path d=\"M20 7h2\"></path><path d=\"M7 20v2\"></path><path d=\"M7 2v2\"></path><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"></rect><rect x=\"8\" y=\"8\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg>",{"_36":319,"_43":55,"_38":208,"_49":320,"_58":-7,"_10":321,"_60":322},"es:platform/iot-fleets/overview.mdx","Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.","/docs/pr-preview/pr-78/es/platform/iot-fleets/overview",{"_62":323},"platform/iot-fleets/overview.mdx",{"_43":44,"_38":325,"_46":-7,"_48":-7,"_49":-7,"_51":-7,"_40":326,"_36":361,"_60":362,"_58":-7},"Administración",[327,347,354],{"_43":44,"_38":328,"_46":-7,"_48":-7,"_49":-7,"_51":-7,"_40":329,"_36":344,"_60":345,"_58":-7},"Control de acceso",[330,337],{"_36":331,"_43":55,"_38":332,"_49":333,"_58":-7,"_10":334,"_60":335},"es:platform/administration/access-control/index.mdx","Visión general","Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.","/docs/pr-preview/pr-78/es/platform/administration/access-control",{"_6