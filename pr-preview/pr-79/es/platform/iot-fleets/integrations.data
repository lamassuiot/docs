rollment/est-reference.mdx",{"_39":288,"_46":57,"_41":289,"_51":290,"_60":-7,"_13":291,"_62":292},"es:platform/iot-fleets/enrollment/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/pr-preview/pr-79/es/platform/iot-fleets/enrollment/troubleshooting",{"_64":293},"platform/iot-fleets/enrollment/troubleshooting.mdx","es:platform/iot-fleets/enrollment",{"_198":296},"platform/iot-fleets/enrollment/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network shrink-0\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg>",{"_39":299,"_46":57,"_41":236,"_51":300,"_60":-7,"_13":301,"_62":302},"es:platform/iot-fleets/enrollment/overview.mdx","Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.","/docs/pr-preview/pr-79/es/platform/iot-fleets/enrollment/overview",{"_64":303},"platform/iot-fleets/enrollment/overview.mdx",{"_46":47,"_41":19,"_48":-7,"_50":-7,"_51":-7,"_53":-7,"_43":305,"_39":312,"_62":313,"_60":315},[306],{"_39":307,"_46":57,"_41":308,"_51":309,"_60":-7,"_13":14,"_62":310},"es:platform/iot-fleets/integrations/aws-iot-core.mdx","AWS IoT Core","El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_64":311},"platform/iot-fleets/integrations/aws-iot-core.mdx","es:platform/iot-fleets/integrations",{"_198":314},"platform/iot