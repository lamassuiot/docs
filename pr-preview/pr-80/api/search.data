"_41700":129784,"_41702":129787,"_41704":129790,"_41706":129793,"_41708":129796,"_41710":129799,"_41712":129802,"_41715":129805,"_41717":129808,"_41719":129811,"_41721":129814,"_41723":129817,"_41725":129820,"_41727":129823,"_41729":129826,"_41731":129829,"_41733":129832,"_41735":129835,"_41737":129838,"_41739":129841,"_41741":129844,"_41743":129847,"_41745":129850,"_41747":129853,"_41749":129856,"_41751":129859,"_41753":129862,"_41755":129865,"_41757":129868,"_41759":129871,"_41761":129874,"_41763":129877,"_41765":129880,"_41767":129883,"_41769":129886,"_41771":129889,"_41773":129892,"_41775":129895,"_41777":129898,"_41780":129901,"_41782":129904,"_41784":129907},{"_3696":72913,"_31230":72913,"_5":15247,"_3086":120598,"_31588":120599,"_21622":120602,"_28406":72913},"Despliega desde AWS Marketplace",[51065,120600,120601],"Despliegue","Otros modelos",[],{"_3696":72914,"_31230":72913,"_21622":120604,"_5":14887,"_28406":72913,"_3086":120605},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3696":72915,"_31230":72913,"_5":31585,"_21622":120607,"_28406":120608,"_3086":120609},[],"/docs/pr-preview/pr-80/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3696":72916,"_31230":72913,"_5":31585,"_21622":120611,"_28406":120612,"_3086":120613},[],"/docs/pr-preview/pr-80/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3696":72917,"_31230":72913,"_5":31585,"_21622":120615,"_28406":120616,"_3086":120617},[],"/docs/pr-preview/pr-80/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3696":72918,"_31230":72913,"_5":31585,"_21622":120619,"_28406":120620,"_3086":120621},[],"/docs/pr-preview/pr-80/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3696":72919,"_31230":72913,"_5":31585,"_21622":120623,"_28406":120624,"_3086":120625},[],"/docs/pr-preview/pr-80/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3696":72920,"_31230":72913,"_5":31585,"_21622":120627,"_28406":120628,"_3086":120629},[],"/docs/pr-preview/pr-80/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3696":72921,"_31230":72913,"_5":31585,"_21622":120631,"_28406":120632,"_3086":120633},[],"/docs/pr-preview/pr-80/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3696":72922,"_31230":72913,"_21622":120635,"_5":14887,"_28406":72913,"_3086":120636},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3696":72923,"_31230":72913,"_21622":120638,"_5":14887,"_28406":120608,"_3086":120639},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3696":72924,"_31230":72913,"_21622":120641,"_5":14887,"_28406":120608,"_3086":120642},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3696":72925,"_31230":72913,"_21622":120644,"_5":14887,"_28406":120608,"_3086":120645},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3696":72926,"_31230":72913,"_21622":120647,"_5":14887,"_28406":120612,"_3086":120648},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3696":72927,"_31230":72913,"_21622":120650,"_5":14887,"_28406":120612,"_3086":120651},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3696":72928,"_31230":72913,"_21622":120653,"_5":14887,"_28406":120612,"_3086":120654},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3696":72929,"_31230":72913,"_21622":120656,"_5":14887,"_28406":120616,"_3086":120657},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3696":72930,"_31230":72913,"_21622":120659,"_5":14887,"_28406":120620,"_3086":120660},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3696":72931,"_31230":72913,"_21622":120662,"_5":14887,"_28406":120624,"_3086":120663},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3696":72932,"_31230":72913,"_21622":120665,"_5":14887,"_28406":120628,"_3086":120666},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3696":72933,"_31230":72913,"_21622":120668,"_5":14887,"_28406":120632,"_3086":120669},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3696":72934,"_31230":72934,"_5":15247,"_3086":120671,"_31588":120672,"_21622":120673,"_28406":72934},"Despliega Lamassu",[51065,120600],[],{"_3696":72935,"_31230":72934,"_21622":120675,"_5":14887,"_28406":72934,"_3086":120676},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3696":72936,"_31230":72934,"_5":31585,"_21622":120678,"_28406":120679,"_3086":120680},[],"/docs/pr-preview/pr-80/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3696":72937,"_31230":72934,"_5":31585,"_21622":120682,"_28406":120683,"_3086":120684},[],"/docs/pr-preview/pr-80/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3696":72938,"_31230":72934,"_5":31585,"_21622":120686,"_28406":120687,"_3086":120688},[],"/docs/pr-preview/pr-80/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3696":72939,"_31230":72934,"_21622":120690,"_5":14887,"_28406":72934,"_3086":120691},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3696":72940,"_31230":72934,"_21622":120693,"_5":14887,"_28406":120679,"_3086":120694},[],"Modelo",{"_3696":72941,"_31230":72934,"_21622":120696,"_5":14887,"_28406":120679,"_3086":120697},[],"Recomendado para",{"_3696":72942,"_31230":72934,"_21622":120699,"_5":14887,"_28406":120679,"_3086":120700},[],"Quién opera la infraestructura",{"_3696":72943,"_31230":72934,"_21622":120702,"_5":14887,"_28406":120679,"_3086":120703},[],"Punto de partida",{"_3696":72944,"_31230":72934,"_21622":120705,"_5":14887,"_28406":120679,"_3086":51172},[],{"_3696":72945,"_31230":72934,"_21622":120707,"_5":14887,"_28406":120679,"_3086":120708},[],"Producción, entornos regulados y despliegues personalizados",{"_3696":72946,"_31230":72934,"_21622":120710,"_5":14887,"_28406":120679,"_3086":120711},[],"Tu equipo",{"_3696":72947,"_31230":72934,"_21622":120713,"_5":14887,"_28406":120679,"_3086":120714},[],"Helm o Fastlane",{"_3696":72948,"_31230":72934,"_21622":120716,"_5":14887,"_28406":120679,"_3086":51184},[],{"_3696":72949,"_31230":72934,"_21622":120718,"_5":14887,"_28406":120679,"_3086":120719},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3696":72950,"_31230":72934,"_21622":120721,"_5":14887,"_28406":120679,"_3086":120711},[],{"_3696":72951,"_31230":72934,"_21622":120723,"_5":14887,"_28406":120679,"_3086":120724},[],"Imagen preconfigurada en EC2",{"_3696":72952,"_31230":72934,"_21622":120726,"_5":14887,"_28406":120679,"_3086":51195},[],{"_3696":72953,"_31230":72934,"_21622":120728,"_5":14887,"_28406":120679,"_3086":120729},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3696":72954,"_31230":72934,"_21622":120731,"_5":14887,"_28406":120679,"_3086":51201},[],{"_3696":72955,"_31230":72934,"_21622":120733,"_5":14887,"_28406":120679,"_3086":120734},[],"Suscripción gestionada",{"_3696":72956,"_31230":72934,"_21622":120736,"_5":14887,"_28406":120679,"_3086":120737},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3696":72957,"_31230":72934,"_21622":120739,"_5":14887,"_28406":120679,"_3086":120740},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3696":72958,"_31230":72934,"_21622":120742,"_5":14887,"_28406":120679,"_3086":120743},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3696":72959,"_31230":72934,"_21622":120745,"_5":14887,"_28406":120683,"_3086":120746},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3696":72960,"_31230":72934,"_21622":120748,"_5":14887,"_28406":120687,"_3086":120749},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3696":72961,"_31230":72961,"_5":15247,"_3086":120751,"_31588":120752,"_21622":120753,"_28406":72961},"Utiliza Lamassu como SaaS",[51065,120600,120601],[],{"_3696":72962,"_31230":72961,"_21622":120755,"_5":14887,"_28406":72961,"_3086":120756},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3696":72963,"_31230":72961,"_5":31585,"_21622":120758,"_28406":120759,"_3086":120760},[],"/docs/pr-preview/pr-80/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3696":72964,"_31230":72961,"_5":31585,"_21622":120762,"_28406":120763,"_3086":120764},[],"/docs/pr-preview/pr-80/es/deployment/saas#planes","Planes",{"_3696":72965,"_31230":72961,"_5":31585,"_21622":120766,"_28406":120767,"_3086":120768},[],"/docs/pr-preview/pr-80/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3696":72966,"_31230":72961,"_21622":120770,"_5":14887,"_28406":72961,"_3086":120771},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3696":72967,"_31230":72961,"_21622":120773,"_5":14887,"_28406":120759,"_3086":120774},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3696":72968,"_31230":72961,"_21622":120776,"_5":14887,"_28406":120759,"_3086":120777},[],"Copias de seguridad automáticas.",{"_3696":72969,"_31230":72961,"_21622":120779,"_5":14887,"_28406":120759,"_3086":120780},[],"Actualizaciones de versión.",{"_3696":72970,"_31230":72961,"_21622":120782,"_5":14887,"_28406":120759,"_3086":120783},[],"Soporte técnico y SLA según el plan contratado.",{"_3696":72971,"_31230":72961,"_21622":120785,"_5":14887,"_28406":120763,"_3086":51256},[],{"_3696":72972,"_31230":72961,"_21622":120787,"_5":14887,"_28406":120763,"_3086":120788},[],"Dispositivos",{"_3696":72973,"_31230":72961,"_21622":120790,"_5":14887,"_28406":120763,"_3086":120791},[],"Soporte",{"_3696":72974,"_31230":72961,"_21622":120793,"_5":14887,"_28406":120763,"_3086":51265},[],{"_3696":72975,"_31230":72961,"_21622":120795,"_5":14887,"_28406":120763,"_3086":51268},[],{"_3696":72976,"_31230":72961,"_21622":120797,"_5":14887,"_28406":120763,"_3086":120798},[],"Hasta 1.000",{"_3696":72977,"_31230":72961,"_21622":120800,"_5":14887,"_28406":120763,"_3086":51274},[],{"_3696":72978,"_31230":72961,"_21622":120802,"_5":14887,"_28406":120763,"_3086":120803},[],"99,5 %",{"_3696":72979,"_31230":72961,"_21622":120805,"_5":14887,"_28406":120763,"_3086":51280},[],{"_3696":72980,"_31230":72961,"_21622":120807,"_5":14887,"_28406":120763,"_3086":120808},[],"Hasta 10.000",{"_3696":72981,"_31230":72961,"_21622":120810,"_5":14887,"_28406":120763,"_3086":120811},[],"Email y chat",{"_3696":72982,"_31230":72961,"_21622":120813,"_5":14887,"_28406":120763,"_3086":120814},[],"99,9 %",{"_3696":72983,"_31230":72961,"_21622":120816,"_5":14887,"_28406":120763,"_3086":51292},[],{"_3696":72984,"_31230":72961,"_21622":120818,"_5":14887,"_28406":120763,"_3086":120819},[],"Ilimitados",{"_3696":72985,"_31230":72961,"_21622":120821,"_5":14887,"_28406":120763,"_3086":120822},[],"Dedicado",{"_3696":72986,"_31230":72961,"_21622":120824,"_5":14887,"_28406":120763,"_3086":120825},[],"99,99 %",{"_3696":72987,"_31230":72961,"_21622":120827,"_5":14887,"_28406":120767,"_3086":120828},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3696":72988,"_31230":72961,"_21622":120830,"_5":14887,"_28406":120767,"_3086":120831},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3696":72989,"_31230":72989,"_5":15247,"_3086":51309,"_31588":120833,"_21622":120835,"_28406":72989},[51065,120600,120834],"Kubernetes autogestionado",[],{"_3696":72990,"_31230":72989,"_21622":120837,"_5":14887,"_28406":72989,"_3086":120838},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3696":72991,"_31230":72989,"_5":31585,"_21622":120840,"_28406":120841,"_3086":120842},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3696":72992,"_31230":72989,"_5":31585,"_21622":120844,"_28406":120845,"_3086":120846},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3696":72993,"_31230":72989,"_5":31585,"_21622":120848,"_28406":120849,"_3086":120850},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3696":72994,"_31230":72989,"_5":31585,"_21622":120852,"_28406":120853,"_3086":120854},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3696":72995,"_31230":72989,"_5":31585,"_21622":120856,"_28406":120857,"_3086":120858},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3696":72996,"_31230":72989,"_5":31585,"_21622":120860,"_28406":120861,"_3086":120862},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3696":72997,"_31230":72989,"_5":31585,"_21622":120864,"_28406":120865,"_3086":120866},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3696":72998,"_31230":72989,"_5":31585,"_21622":120868,"_28406":120869,"_3086":120870},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3696":72999,"_31230":72989,"_5":31585,"_21622":120872,"_28406":120873,"_3086":120874},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3696":73000,"_31230":72989,"_5":31585,"_21622":120876,"_28406":120877,"_3086":120878},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3696":73001,"_31230":72989,"_5":31585,"_21622":120880,"_28406":120881,"_3086":120882},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3696":73002,"_31230":72989,"_21622":120884,"_5":14887,"_28406":120841,"_3086":120885},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3696":73003,"_31230":72989,"_21622":120887,"_5":14887,"_28406":120841,"_3086":120888},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3696":73004,"_31230":72989,"_21622":120890,"_5":14887,"_28406":120845,"_3086":120891},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3696":73005,"_31230":72989,"_21622":120893,"_5":14887,"_28406":120845,"_3086":120894},[],"Fastlane instala o configura",{"_3696":73006,"_31230":72989,"_21622":120896,"_5":14887,"_28406":120845,"_3086":120897},[],"Tú sigues proporcionando",{"_3696":73007,"_31230":72989,"_21622":120899,"_5":14887,"_28406":120845,"_3086":120900},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3696":73008,"_31230":72989,"_21622":120902,"_5":14887,"_28406":120845,"_3086":120903},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3696":73009,"_31230":72989,"_21622":120905,"_5":14887,"_28406":120845,"_3086":120906},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3696":73010,"_31230":72989,"_21622":120908,"_5":14887,"_28406":120845,"_3086":120909},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3696":73011,"_31230":72989,"_21622":120911,"_5":14887,"_28406":120845,"_3086":120912},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3696":73012,"_31230":72989,"_21622":120914,"_5":14887,"_28406":120845,"_3086":120915},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3696":73013,"_31230":72989,"_21622":120917,"_5":14887,"_28406":120845,"_3086":120918},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3696":73014,"_31230":72989,"_21622":120920,"_5":14887,"_28406":120845,"_3086":120921},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3696":73015,"_31230":72989,"_21622":120923,"_5":14887,"_28406":120845,"_3086":120924},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3696":73016,"_31230":72989,"_21622":120926,"_5":14887,"_28406":120849,"_3086":120927},[],"Necesitas:",{"_3696":73017,"_31230":72989,"_21622":120929,"_5":14887,"_28406":120849,"_3086":120930},[],"un clúster Kubernetes existente",{"_3696":73018,"_31230":72989,"_21622":120932,"_5":14887,"_28406":120849,"_3086":120933},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3696":73019,"_31230":72989,"_21622":120935,"_5":14887,"_28406":120849,"_3086":51411},[],{"_3696":73020,"_31230":72989,"_21622":120937,"_5":14887,"_28406":120849,"_3086":24435},[],{"_3696":73021,"_31230":72989,"_21622":120939,"_5":14887,"_28406":120849,"_3086":120940},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3696":73022,"_31230":72989,"_21622":120942,"_5":14887,"_28406":120849,"_3086":120943},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3696":73023,"_31230":72989,"_21622":120945,"_5":14887,"_28406":120849,"_3086":120946},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3696":73024,"_31230":72989,"_21622":120948,"_5":14887,"_28406":120849,"_3086":120949},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3696":73025,"_31230":72989,"_21622":120951,"_5":14887,"_28406":120849,"_3086":120952},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3696":73026,"_31230":72989,"_21622":120954,"_5":14887,"_28406":120853,"_3086":120955},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3696":73027,"_31230":72989,"_21622":120957,"_5":14887,"_28406":120853,"_3086":120958},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3696":73028,"_31230":72989,"_21622":120960,"_5":14887,"_28406":120857,"_3086":120961},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3696":73029,"_31230":72989,"_21622":120963,"_5":14887,"_28406":120857,"_3086":120964},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3696":73030,"_31230":72989,"_21622":120966,"_5":14887,"_28406":120857,"_3086":120967},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3696":73031,"_31230":72989,"_21622":120969,"_5":14887,"_28406":120857,"_3086":120970},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3696":73032,"_31230":72989,"_21622":120972,"_5":14887,"_28406":120861,"_3086":120973},[],"Opción",{"_3696":73033,"_31230":72989,"_21622":120975,"_5":14887,"_28406":120861,"_3086":120976},[],"Valor predeterminado",{"_3696":73034,"_31230":72989,"_21622":120978,"_5":14887,"_28406":120861,"_3086":120979},[],"Propósito",{"_3696":73035,"_31230":72989,"_21622":120981,"_5":14887,"_28406":120861,"_3086":51458},[],{"_3696":73036,"_31230":72989,"_21622":120983,"_5":14887,"_28406":120861,"_3086":51461},[],{"_3696":73037,"_31230":72989,"_21622":120985,"_5":14887,"_28406":120861,"_3086":120986},[],"Muestra la ayuda",{"_3696":73038,"_31230":72989,"_21622":120988,"_5":14887,"_28406":120861,"_3086":51467},[],{"_3696":73039,"_31230":72989,"_21622":120990,"_5":14887,"_28406":120861,"_3086":120991},[],"contexto actual",{"_3696":73040,"_31230":72989,"_21622":120993,"_5":14887,"_28406":120861,"_3086":120994},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3696":73041,"_31230":72989,"_21622":120996,"_5":14887,"_28406":120861,"_3086":51476},[],{"_3696":73042,"_31230":72989,"_21622":120998,"_5":14887,"_28406":120861,"_3086":6819},[],{"_3696":73043,"_31230":72989,"_21622":121000,"_5":14887,"_28406":120861,"_3086":121001},[],"Omite prompts y genera credenciales para las dependencias",{"_3696":73044,"_31230":72989,"_21622":121003,"_5":14887,"_28406":120861,"_3086":51484},[],{"_3696":73045,"_31230":72989,"_21622":121005,"_5":14887,"_28406":120861,"_3086":51487},[],{"_3696":73046,"_31230":72989,"_21622":121007,"_5":14887,"_28406":120861,"_3086":121008},[],"Namespace de la instalación",{"_3696":73047,"_31230":72989,"_21622":121010,"_5":14887,"_28406":120861,"_3086":51493},[],{"_3696":73048,"_31230":72989,"_21622":121012,"_5":14887,"_28406":120861,"_3086":51496},[],{"_3696":73049,"_31230":72989,"_21622":121014,"_5":14887,"_28406":120861,"_3086":121015},[],"Dominio usado por la UI, OIDC y el certificado",{"_3696":73050,"_31230":72989,"_21622":121017,"_5":14887,"_28406":120861,"_3086":51502},[],{"_3696":73051,"_31230":72989,"_21622":121019,"_5":14887,"_28406":120861,"_3086":15599},[],{"_3696":73052,"_31230":72989,"_21622":121021,"_5":14887,"_28406":120861,"_3086":121022},[],"Versión del chart de Lamassu",{"_3696":73053,"_31230":72989,"_21622":121024,"_5":14887,"_28406":120861,"_3086":51510},[],{"_3696":73054,"_31230":72989,"_21622":121026,"_5":14887,"_28406":120861,"_3086":51513},[],{"_3696":73055,"_31230":72989,"_21622":121028,"_5":14887,"_28406":120861,"_3086":121029},[],"Puerto del listener HTTPS",{"_3696":73056,"_31230":72989,"_21622":121031,"_5":14887,"_28406":120861,"_3086":51519},[],{"_3696":73057,"_31230":72989,"_21622":121033,"_5":14887,"_28406":120861,"_3086":51522},[],{"_3696":73058,"_31230":72989,"_21622":121035,"_5":14887,"_28406":120861,"_3086":121036},[],"Puerto del listener HTTP",{"_3696":73059,"_31230":72989,"_21622":121038,"_5":14887,"_28406":120861,"_3086":51528},[],{"_3696":73060,"_31230":72989,"_21622":121040,"_5":14887,"_28406":120861,"_3086":51461},[],{"_3696":73061,"_31230":72989,"_21622":121042,"_5":14887,"_28406":120861,"_3086":121043},[],"Certificado PEM para TLS downstream",{"_3696":73062,"_31230":72989,"_21622":121045,"_5":14887,"_28406":120861,"_3086":51536},[],{"_3696":73063,"_31230":72989,"_21622":121047,"_5":14887,"_28406":120861,"_3086":51461},[],{"_3696":73064,"_31230":72989,"_21622":121049,"_5":14887,"_28406":120861,"_3086":121050},[],"Clave privada PEM para TLS downstream",{"_3696":73065,"_31230":72989,"_21622":121052,"_5":14887,"_28406":120861,"_3086":51544},[],{"_3696":73066,"_31230":72989,"_21622":121054,"_5":14887,"_28406":120861,"_3086":121055},[],"chart del repositorio",{"_3696":73067,"_31230":72989,"_21622":121057,"_5":14887,"_28406":120861,"_3086":121058},[],"Usa un chart local de Lamassu sin empaquetar",{"_3696":73068,"_31230":72989,"_21622":121060,"_5":14887,"_28406":120861,"_3086":51553},[],{"_3696":73069,"_31230":72989,"_21622":121062,"_5":14887,"_28406":120861,"_3086":121063},[],"detección automática",{"_3696":73070,"_31230":72989,"_21622":121065,"_5":14887,"_28406":120861,"_3086":121066},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3696":73071,"_31230":72989,"_21622":121068,"_5":14887,"_28406":120861,"_3086":51561},[],{"_3696":73072,"_31230":72989,"_21622":121070,"_5":14887,"_28406":120861,"_3086":6819},[],{"_3696":73073,"_31230":72989,"_21622":121072,"_5":14887,"_28406":120861,"_3086":121073},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3696":73074,"_31230":72989,"_21622":121075,"_5":14887,"_28406":120861,"_3086":51569},[],{"_3696":73075,"_31230":72989,"_21622":121077,"_5":14887,"_28406":120861,"_3086":6819},[],{"_3696":73076,"_31230":72989,"_21622":121079,"_5":14887,"_28406":120861,"_3086":121080},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3696":73077,"_31230":72989,"_21622":121082,"_5":14887,"_28406":120861,"_3086":51577},[],{"_3696":73078,"_31230":72989,"_21622":121084,"_5":14887,"_28406":120861,"_3086":6819},[],{"_3696":73079,"_31230":72989,"_21622":121086,"_5":14887,"_28406":120861,"_3086":121087},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3696":73080,"_31230":72989,"_21622":121089,"_5":14887,"_28406":120861,"_3086":51585},[],{"_3696":73081,"_31230":72989,"_21622":121091,"_5":14887,"_28406":120861,"_3086":6819},[],{"_3696":73082,"_31230":72989,"_21622":121093,"_5":14887,"_28406":120861,"_3086":121094},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3696":73083,"_31230":72989,"_21622":121096,"_5":14887,"_28406":120861,"_3086":51593},[],{"_3696":73084,"_31230":72989,"_21622":121098,"_5":14887,"_28406":120861,"_3086":51596},[],{"_3696":73085,"_31230":72989,"_21622":121100,"_5":14887,"_28406":120861,"_3086":121101},[],"Usa otro chart local de SoftHSM",{"_3696":73086,"_31230":72989,"_21622":121103,"_5":14887,"_28406":120861,"_3086":121104},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3696":73087,"_31230":72989,"_21622":121106,"_5":14887,"_28406":120865,"_3086":121107},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3696":73088,"_31230":72989,"_21622":121109,"_5":14887,"_28406":120865,"_3086":121110},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3696":73089,"_31230":72989,"_21622":121112,"_5":14887,"_28406":120865,"_3086":121113},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3696":73090,"_31230":72989,"_21622":121115,"_5":14887,"_28406":120865,"_3086":121116},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3696":73091,"_31230":72989,"_21622":121118,"_5":14887,"_28406":120865,"_3086":121119},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3696":73092,"_31230":72989,"_21622":121121,"_5":14887,"_28406":120865,"_3086":121122},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3696":73093,"_31230":72989,"_21622":121124,"_5":14887,"_28406":120869,"_3086":51623},[],{"_3696":73094,"_31230":72989,"_21622":121126,"_5":14887,"_28406":120869,"_3086":121127},[],"valida las herramientas locales y el clúster seleccionado",{"_3696":73095,"_31230":72989,"_21622":121129,"_5":14887,"_28406":120869,"_3086":121130},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3696":73096,"_31230":72989,"_21622":121132,"_5":14887,"_28406":120869,"_3086":121133},[],"crea el namespace",{"_3696":73097,"_31230":72989,"_21622":121135,"_5":14887,"_28406":120869,"_3086":121136},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3696":73098,"_31230":72989,"_21622":121138,"_5":14887,"_28406":120869,"_3086":121139},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3696":73099,"_31230":72989,"_21622":121141,"_5":14887,"_28406":120869,"_3086":121142},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3696":73100,"_31230":72989,"_21622":121144,"_5":14887,"_28406":120869,"_3086":121145},[],"instala RabbitMQ",{"_3696":73101,"_31230":72989,"_21622":121147,"_5":14887,"_28406":120869,"_3086":121148},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3696":73102,"_31230":72989,"_21622":121150,"_5":14887,"_28406":120869,"_3086":121151},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3696":73103,"_31230":72989,"_21622":121153,"_5":14887,"_28406":120869,"_3086":121154},[],"carga datos de ejemplo opcionalmente",{"_3696":73104,"_31230":72989,"_21622":121156,"_5":14887,"_28406":120869,"_3086":121157},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3696":73105,"_31230":72989,"_21622":121159,"_5":14887,"_28406":120873,"_3086":121160},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3696":73106,"_31230":72989,"_21622":121162,"_5":14887,"_28406":120873,"_3086":121163},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3696":73107,"_31230":72989,"_21622":121165,"_5":14887,"_28406":120877,"_3086":121166},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3696":73108,"_31230":72989,"_21622":121168,"_5":14887,"_28406":120877,"_3086":121169},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3696":73109,"_31230":72989,"_21622":121171,"_5":14887,"_28406":120877,"_3086":121172},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3696":73110,"_31230":72989,"_21622":121174,"_5":14887,"_28406":120877,"_3086":121175},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3696":73111,"_31230":72989,"_21622":121177,"_5":14887,"_28406":120881,"_3086":121178},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3696":73112,"_31230":73112,"_5":15247,"_3086":121180,"_31588":121181,"_21622":121182,"_28406":73112},"Instala con Helm",[51065,120600,120834],[],{"_3696":73113,"_31230":73112,"_21622":121184,"_5":14887,"_28406":73112,"_3086":121185},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3696":73114,"_31230":73112,"_5":31585,"_21622":121187,"_28406":121188,"_3086":121189},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3696":73115,"_31230":73112,"_5":31585,"_21622":121191,"_28406":121192,"_3086":120850},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3696":73116,"_31230":73112,"_5":31585,"_21622":121194,"_28406":121195,"_3086":121196},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3696":73117,"_31230":73112,"_5":31585,"_21622":121198,"_28406":121199,"_3086":121200},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3696":73118,"_31230":73112,"_5":31585,"_21622":121202,"_28406":121203,"_3086":121204},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3696":73119,"_31230":73112,"_5":31585,"_21622":121206,"_28406":121207,"_3086":121208},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3696":73120,"_31230":73112,"_5":31585,"_21622":121210,"_28406":121211,"_3086":121212},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3696":73121,"_31230":73112,"_5":31585,"_21622":121214,"_28406":121215,"_3086":121216},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#flujo-de-eventos-de-dispositivo-sse","Flujo de eventos de dispositivo (SSE)",{"_3696":73122,"_31230":73112,"_5":31585,"_21622":121218,"_28406":121219,"_3086":121220},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3696":73123,"_31230":73112,"_5":31585,"_21622":121222,"_28406":121223,"_3086":121224},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3696":73124,"_31230":73112,"_5":31585,"_21622":121226,"_28406":121227,"_3086":121228},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3696":73125,"_31230":73112,"_5":31585,"_21622":121230,"_28406":121231,"_3086":121232},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3696":73126,"_31230":73112,"_5":31585,"_21622":121234,"_28406":121235,"_3086":121236},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3696":73127,"_31230":73112,"_21622":121238,"_5":14887,"_28406":121188,"_3086":121239},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3696":73128,"_31230":73112,"_21622":121241,"_5":14887,"_28406":121192,"_3086":121242},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3696":73129,"_31230":73112,"_21622":121244,"_5":14887,"_28406":121192,"_3086":121245},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3696":73130,"_31230":73112,"_21622":121247,"_5":14887,"_28406":121192,"_3086":121248},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3696":73131,"_31230":73112,"_21622":121250,"_5":14887,"_28406":121192,"_3086":121251},[],"un broker RabbitMQ accesible y sus credenciales",{"_3696":73132,"_31230":73112,"_21622":121253,"_5":14887,"_28406":121192,"_3086":121254},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3696":73133,"_31230":73112,"_21622":121256,"_5":14887,"_28406":121192,"_3086":121257},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3696":73134,"_31230":73112,"_21622":121259,"_5":14887,"_28406":121192,"_3086":121260},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3696":73135,"_31230":73112,"_21622":121262,"_5":14887,"_28406":121192,"_3086":121263},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3696":73136,"_31230":73112,"_21622":121265,"_5":14887,"_28406":121192,"_3086":121266},[],"una StorageClass y un diseño de tráfico externo",{"_3696":73137,"_31230":73112,"_21622":121268,"_5":14887,"_28406":121192,"_3086":121269},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3696":73138,"_31230":73112,"_21622":121271,"_5":14887,"_28406":121192,"_3086":121272},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3696":73139,"_31230":73112,"_21622":121274,"_5":14887,"_28406":121192,"_3086":121275},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3696":73140,"_31230":73112,"_21622":121277,"_5":14887,"_28406":121195,"_3086":121278},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3696":73141,"_31230":73112,"_21622":121280,"_5":14887,"_28406":121195,"_3086":121281},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3696":73142,"_31230":73112,"_21622":121283,"_5":14887,"_28406":121195,"_3086":121284},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3696":73143,"_31230":73112,"_21622":121286,"_5":14887,"_28406":121199,"_3086":121287},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3696":73144,"_31230":73112,"_21622":121289,"_5":14887,"_28406":121199,"_3086":121290},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3696":73145,"_31230":73112,"_21622":121292,"_5":14887,"_28406":121199,"_3086":121293},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3696":73146,"_31230":73112,"_21622":121295,"_5":14887,"_28406":121199,"_3086":121296},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3696":73147,"_31230":73112,"_21622":121298,"_5":14887,"_28406":121203,"_3086":121299},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3696":73148,"_31230":73112,"_21622":121301,"_5":14887,"_28406":121203,"_3086":121302},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3696":73149,"_31230":73112,"_21622":121304,"_5":14887,"_28406":121203,"_3086":121305},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3696":73150,"_31230":73112,"_21622":121307,"_5":14887,"_28406":121203,"_3086":121308},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3696":73151,"_31230":73112,"_21622":121310,"_5":14887,"_28406":121203,"_3086":121311},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3696":73152,"_31230":73112,"_21622":121313,"_5":14887,"_28406":121203,"_3086":121314},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3696":73153,"_31230":73112,"_21622":121316,"_5":14887,"_28406":121203,"_3086":121317},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3696":73154,"_31230":73112,"_21622":121319,"_5":14887,"_28406":121203,"_3086":121320},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3696":73155,"_31230":73112,"_21622":121322,"_5":14887,"_28406":121207,"_3086":121323},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3696":73156,"_31230":73112,"_21622":121325,"_5":14887,"_28406":121211,"_3086":121326},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3696":73157,"_31230":73112,"_21622":121328,"_5":14887,"_28406":121211,"_3086":121329},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3696":73158,"_31230":73112,"_21622":121331,"_5":14887,"_28406":121211,"_3086":121332},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3696":73159,"_31230":73112,"_21622":121334,"_5":14887,"_28406":121211,"_3086":121335},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3696":73160,"_31230":73112,"_21622":121337,"_5":14887,"_28406":121211,"_3086":121338},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3696":73161,"_31230":73112,"_21622":121340,"_5":14887,"_28406":121211,"_3086":121341},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3696":73162,"_31230":73112,"_21622":121343,"_5":14887,"_28406":121211,"_3086":121344},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3696":73163,"_31230":73112,"_21622":121346,"_5":14887,"_28406":121215,"_3086":121347},[],"`services.deviceManager.sseEnabled` (por defecto `true`) controla si Device Manager sirve su flujo de eventos de dispositivo mediante Server-Sent Events (SSE). Con el valor por defecto, el chart renderiza una regla de gateway dedicada para el endpoint de eventos de dispositivo con un timeout de petición de 11 minutos, porque el timeout de petición por defecto del Gateway es demasiado corto para estos flujos, que el servicio mantiene abiertos hasta unos diez minutos. Las llamadas a Device Manager que no son peticiones SSE conservan el timeout por defecto del Gateway.",{"_3696":73164,"_31230":73112,"_21622":121349,"_5":14887,"_28406":121215,"_3086":121350},[],"Defínelo como `false` para deshabilitar el flujo: el chart renderiza entonces `sse_enabled: false` en la configuración de Device Manager y omite la regla de gateway, y las peticiones SSE al endpoint de eventos de dispositivo fallan. Consulta Eventos de dispositivo en la guía de actualización de 3.8.0 a 4.0.0.",{"_3696":73165,"_31230":73112,"_21622":121352,"_5":14887,"_28406":121219,"_3086":121353},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3696":73166,"_31230":73112,"_21622":121355,"_5":14887,"_28406":121219,"_3086":121356},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3696":73167,"_31230":73112,"_21622":121358,"_5":14887,"_28406":121219,"_3086":121359},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3696":73168,"_31230":73112,"_21622":121361,"_5":14887,"_28406":121219,"_3086":121362},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3696":73169,"_31230":73112,"_21622":121364,"_5":14887,"_28406":121223,"_3086":121365},[],"Para instalar un checkout local:",{"_3696":73170,"_31230":73112,"_21622":121367,"_5":14887,"_28406":121227,"_3086":121368},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3696":73171,"_31230":73112,"_21622":121370,"_5":14887,"_28406":121227,"_3086":121371},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3696":73172,"_31230":73112,"_21622":121373,"_5":14887,"_28406":121231,"_3086":121374},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3696":73173,"_31230":73112,"_21622":121376,"_5":14887,"_28406":121231,"_3086":121377},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3696":73174,"_31230":73112,"_21622":121379,"_5":14887,"_28406":121231,"_3086":121380},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3696":73175,"_31230":73112,"_21622":121382,"_5":14887,"_28406":121231,"_3086":121383},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3696":73176,"_31230":73112,"_21622":121385,"_5":14887,"_28406":121231,"_3086":121386},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3696":73177,"_31230":73112,"_21622":121388,"_5":14887,"_28406":121235,"_3086":121389},[],"Antes de pasar a producción, revisa:",{"_3696":73178,"_31230":73112,"_21622":121391,"_5":14887,"_28406":121235,"_3086":121392},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3696":73179,"_31230":73112,"_21622":121394,"_5":14887,"_28406":121235,"_3086":121395},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3696":73180,"_31230":73112,"_21622":121397,"_5":14887,"_28406":121235,"_3086":121398},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3696":73181,"_31230":73112,"_21622":121400,"_5":14887,"_28406":121235,"_3086":121401},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3696":73182,"_31230":73112,"_21622":121403,"_5":14887,"_28406":121235,"_3086":121404},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3696":73183,"_31230":73112,"_21622":121406,"_5":14887,"_28406":121235,"_3086":121407},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3696":73184,"_31230":73112,"_21622":121409,"_5":14887,"_28406":121235,"_3086":121410},[],"SMTP, observabilidad y entrega de alertas",{"_3696":73185,"_31230":73112,"_21622":121412,"_5":14887,"_28406":121235,"_3086":121413},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3696":73186,"_31230":73112,"_21622":121415,"_5":14887,"_28406":121235,"_3086":121416},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3696":73187,"_31230":73187,"_5":15247,"_3086":121418,"_31588":121419,"_21622":121420,"_28406":73187},"Expón el Gateway",[51065,120600,120834],[],{"_3696":73188,"_31230":73187,"_21622":121422,"_5":14887,"_28406":73187,"_3086":121423},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3696":73189,"_31230":73187,"_5":31585,"_21622":121425,"_28406":121426,"_3086":121427},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3696":73190,"_31230":73187,"_5":31585,"_21622":121429,"_28406":121430,"_3086":121431},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3696":73191,"_31230":73187,"_5":31585,"_21622":121433,"_28406":121434,"_3086":121435},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3696":73192,"_31230":73187,"_5":31585,"_21622":121437,"_28406":121438,"_3086":51938},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#k3s",{"_3696":73193,"_31230":73187,"_5":31585,"_21622":121440,"_28406":121441,"_3086":121442},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3696":73194,"_31230":73187,"_5":31585,"_21622":121444,"_28406":121445,"_3086":121446},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3696":73195,"_31230":73187,"_5":31585,"_21622":121448,"_28406":121449,"_3086":121450},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3696":73196,"_31230":73187,"_5":31585,"_21622":121452,"_28406":121453,"_3086":121454},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3696":73197,"_31230":73187,"_5":31585,"_21622":121456,"_28406":121457,"_3086":121458},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3696":73198,"_31230":73187,"_5":31585,"_21622":121460,"_28406":121461,"_3086":121462},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3696":73199,"_31230":73187,"_5":31585,"_21622":121464,"_28406":121465,"_3086":121466},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3696":73200,"_31230":73187,"_21622":121468,"_5":14887,"_28406":121426,"_3086":121469},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3696":73201,"_31230":73187,"_21622":121471,"_5":14887,"_28406":121426,"_3086":121472},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3696":73202,"_31230":73187,"_21622":121474,"_5":14887,"_28406":121430,"_3086":121475},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3696":73203,"_31230":73187,"_21622":121477,"_5":14887,"_28406":121430,"_3086":121478},[],"Defínelo únicamente cuando:",{"_3696":73204,"_31230":73187,"_21622":121480,"_5":14887,"_28406":121430,"_3086":121481},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3696":73205,"_31230":73187,"_21622":121483,"_5":14887,"_28406":121430,"_3086":121484},[],"esa dirección está asignada a este Gateway",{"_3696":73206,"_31230":73187,"_21622":121486,"_5":14887,"_28406":121430,"_3086":121487},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3696":73207,"_31230":73187,"_21622":121489,"_5":14887,"_28406":121430,"_3086":121490},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3696":73208,"_31230":73187,"_21622":121492,"_5":14887,"_28406":121430,"_3086":121493},[],"No confundas estos valores:",{"_3696":73209,"_31230":73187,"_21622":121495,"_5":14887,"_28406":121430,"_3086":121496},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3696":73210,"_31230":73187,"_21622":121498,"_5":14887,"_28406":121430,"_3086":121499},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3696":73211,"_31230":73187,"_21622":121501,"_5":14887,"_28406":121430,"_3086":121502},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3696":73212,"_31230":73187,"_21622":121504,"_5":14887,"_28406":121434,"_3086":121505},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3696":73213,"_31230":73187,"_21622":121507,"_5":14887,"_28406":121434,"_3086":121508},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3696":73214,"_31230":73187,"_21622":121510,"_5":14887,"_28406":121438,"_3086":121511},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3696":73215,"_31230":73187,"_21622":121513,"_5":14887,"_28406":121438,"_3086":121514},[],"Para el diseño recomendado:",{"_3696":73216,"_31230":73187,"_21622":121516,"_5":14887,"_28406":121438,"_3086":121517},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3696":73217,"_31230":73187,"_21622":121519,"_5":14887,"_28406":121438,"_3086":121520},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3696":73218,"_31230":73187,"_21622":121522,"_5":14887,"_28406":121438,"_3086":121523},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3696":73219,"_31230":73187,"_21622":121525,"_5":14887,"_28406":121438,"_3086":121526},[],"Apunta DNS a la dirección accesible de la VM.",{"_3696":73220,"_31230":73187,"_21622":121528,"_5":14887,"_28406":121438,"_3086":121529},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3696":73221,"_31230":73187,"_21622":121531,"_5":14887,"_28406":121441,"_3086":121532},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3696":73222,"_31230":73187,"_21622":121534,"_5":14887,"_28406":121445,"_3086":121535},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3696":73223,"_31230":73187,"_21622":121537,"_5":14887,"_28406":121445,"_3086":121538},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3696":73224,"_31230":73187,"_21622":121540,"_5":14887,"_28406":121449,"_3086":121541},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3696":73225,"_31230":73187,"_21622":121543,"_5":14887,"_28406":121449,"_3086":121544},[],"Requisito",{"_3696":73226,"_31230":73187,"_21622":121546,"_5":14887,"_28406":121449,"_3086":121547},[],"Diseño recomendado",{"_3696":73227,"_31230":73187,"_21622":121549,"_5":14887,"_28406":121449,"_3086":121550},[],"Consecuencia",{"_3696":73228,"_31230":73187,"_21622":121552,"_5":14887,"_28406":121449,"_3086":121553},[],"Varias URL o servicios de Lamassu",{"_3696":73229,"_31230":73187,"_21622":121555,"_5":14887,"_28406":121449,"_3086":121556},[],"Un Gateway con varias rutas",{"_3696":73230,"_31230":73187,"_21622":121558,"_5":14887,"_28406":121449,"_3086":121559},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3696":73231,"_31230":73187,"_21622":121561,"_5":14887,"_28406":121449,"_3086":121562},[],"Gateways independientes e IP externas distintas",{"_3696":73232,"_31230":73187,"_21622":121564,"_5":14887,"_28406":121449,"_3086":121565},[],"Una VIP por Gateway",{"_3696":73233,"_31230":73187,"_21622":121567,"_5":14887,"_28406":121449,"_3086":121568},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3696":73234,"_31230":73187,"_21622":121570,"_5":14887,"_28406":121449,"_3086":121571},[],"Gateways independientes, un nodo y una IP",{"_3696":73235,"_31230":73187,"_21622":121573,"_5":14887,"_28406":121449,"_3086":121574},[],"Puertos externos diferentes",{"_3696":73236,"_31230":73187,"_21622":121576,"_5":14887,"_28406":121449,"_3086":121577},[],"Los clientes deben indicar puertos no estándar",{"_3696":73237,"_31230":73187,"_21622":121579,"_5":14887,"_28406":121449,"_3086":121580},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3696":73238,"_31230":73187,"_21622":121582,"_5":14887,"_28406":121449,"_3086":121583},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3696":73239,"_31230":73187,"_21622":121585,"_5":14887,"_28406":121449,"_3086":121586},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3696":73240,"_31230":73187,"_21622":121588,"_5":14887,"_28406":121449,"_3086":121589},[],"Recursos Gateway separados pero proxy compartido",{"_3696":73241,"_31230":73187,"_21622":121591,"_5":14887,"_28406":121449,"_3086":121592},[],"Modo merged Gateway de Envoy",{"_3696":73242,"_31230":73187,"_21622":121594,"_5":14887,"_28406":121449,"_3086":121595},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3696":73243,"_31230":73187,"_21622":121597,"_5":14887,"_28406":121449,"_3086":121598},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3696":73244,"_31230":73187,"_21622":121600,"_5":14887,"_28406":121449,"_3086":121601},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3696":73245,"_31230":73187,"_21622":121603,"_5":14887,"_28406":121449,"_3086":121604},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3696":73246,"_31230":73187,"_21622":121606,"_5":14887,"_28406":121449,"_3086":121607},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3696":73247,"_31230":73187,"_21622":121609,"_5":14887,"_28406":121453,"_3086":121610},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3696":73248,"_31230":73187,"_21622":121612,"_5":14887,"_28406":121457,"_3086":121613},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3696":73249,"_31230":73187,"_21622":121615,"_5":14887,"_28406":121457,"_3086":121616},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3696":73250,"_31230":73187,"_21622":121618,"_5":14887,"_28406":121457,"_3086":121619},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3696":73251,"_31230":73187,"_21622":121621,"_5":14887,"_28406":121457,"_3086":121622},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3696":73252,"_31230":73187,"_21622":121624,"_5":14887,"_28406":121457,"_3086":121625},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3696":73253,"_31230":73187,"_21622":121627,"_5":14887,"_28406":121461,"_3086":121628},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3696":73254,"_31230":73187,"_21622":121630,"_5":14887,"_28406":121461,"_3086":121631},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3696":73255,"_31230":73187,"_21622":121633,"_5":14887,"_28406":121465,"_3086":121634},[],"Comprueba, en orden:",{"_3696":73256,"_31230":73187,"_21622":121636,"_5":14887,"_28406":121465,"_3086":121637},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3696":73257,"_31230":73187,"_21622":121639,"_5":14887,"_28406":121465,"_3086":121640},[],"Su estado contiene la dirección esperada.",{"_3696":73258,"_31230":73187,"_21622":121642,"_5":14887,"_28406":121465,"_3086":121643},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3696":73259,"_31230":73187,"_21622":121645,"_5":14887,"_28406":121465,"_3086":121646},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3696":73260,"_31230":73187,"_21622":121648,"_5":14887,"_28406":121465,"_3086":121649},[],"DNS resuelve al endpoint accesible externamente.",{"_3696":73261,"_31230":73187,"_21622":121651,"_5":14887,"_28406":121465,"_3086":121652},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3696":73262,"_31230":73187,"_21622":121654,"_5":14887,"_28406":121465,"_3086":121655},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3696":73263,"_31230":73263,"_5":15247,"_3086":51172,"_31588":121657,"_21622":121658,"_28406":73263},[51065,120600,120834],[],{"_3696":73264,"_31230":73263,"_21622":121660,"_5":14887,"_28406":73263,"_3086":121661},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3696":73265,"_31230":73263,"_5":31585,"_21622":121663,"_28406":121664,"_3086":121665},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3696":73266,"_31230":73263,"_5":31585,"_21622":121667,"_28406":121668,"_3086":121669},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3696":73267,"_31230":73263,"_5":31585,"_21622":121671,"_28406":121672,"_3086":121673},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3696":73268,"_31230":73263,"_5":31585,"_21622":121675,"_28406":121676,"_3086":121677},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3696":73269,"_31230":73263,"_5":31585,"_21622":121679,"_28406":121680,"_3086":121681},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3696":73270,"_31230":73263,"_5":31585,"_21622":121683,"_28406":121684,"_3086":121685},[],"/docs/pr-preview/pr-80/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3696":73271,"_31230":73263,"_21622":121687,"_5":14887,"_28406":121664,"_3086":121688},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3696":73272,"_31230":73263,"_21622":121690,"_5":14887,"_28406":121668,"_3086":121691},[],"Flujo",{"_3696":73273,"_31230":73263,"_21622":121693,"_5":14887,"_28406":121668,"_3086":121694},[],"Úsalo para",{"_3696":73274,"_31230":73263,"_21622":121696,"_5":14887,"_28406":121668,"_3086":121697},[],"Qué instala",{"_3696":73275,"_31230":73263,"_21622":121699,"_5":14887,"_28406":121668,"_3086":52200},[],{"_3696":73276,"_31230":73263,"_21622":121701,"_5":14887,"_28406":121668,"_3086":121702},[],"Producción y entornos controlados",{"_3696":73277,"_31230":73263,"_21622":121704,"_5":14887,"_28406":121668,"_3086":121705},[],"Servicios de Lamassu y recursos de Gateway API",{"_3696":73278,"_31230":73263,"_21622":121707,"_5":14887,"_28406":121668,"_3086":51309},[],{"_3696":73279,"_31230":73263,"_21622":121709,"_5":14887,"_28406":121668,"_3086":121710},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3696":73280,"_31230":73263,"_21622":121712,"_5":14887,"_28406":121668,"_3086":121713},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3696":73281,"_31230":73263,"_21622":121715,"_5":14887,"_28406":121672,"_3086":121716},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3696":73282,"_31230":73263,"_21622":121718,"_5":14887,"_28406":121672,"_3086":121719},[],"Área",{"_3696":73283,"_31230":73263,"_21622":121721,"_5":14887,"_28406":121672,"_3086":121722},[],"El chart de Lamassu proporciona",{"_3696":73284,"_31230":73263,"_21622":121724,"_5":14887,"_28406":121672,"_3086":121725},[],"Tú proporcionas",{"_3696":73285,"_31230":73263,"_21622":121727,"_5":14887,"_28406":121672,"_3086":121728},[],"Aplicaciones Lamassu",{"_3696":73286,"_31230":73263,"_21622":121730,"_5":14887,"_28406":121672,"_3086":121731},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3696":73287,"_31230":73263,"_21622":121733,"_5":14887,"_28406":121672,"_3086":121734},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3696":73288,"_31230":73263,"_21622":121736,"_5":14887,"_28406":121672,"_3086":121737},[],"Datos PostgreSQL",{"_3696":73289,"_31230":73263,"_21622":121739,"_5":14887,"_28406":121672,"_3086":121740},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3696":73290,"_31230":73263,"_21622":121742,"_5":14887,"_28406":121672,"_3086":121743},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3696":73291,"_31230":73263,"_21622":121745,"_5":14887,"_28406":121672,"_3086":121746},[],"Mensajería",{"_3696":73292,"_31230":73263,"_21622":121748,"_5":14887,"_28406":121672,"_3086":121749},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3696":73293,"_31230":73263,"_21622":121751,"_5":14887,"_28406":121672,"_3086":121752},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3696":73294,"_31230":73263,"_21622":121754,"_5":14887,"_28406":121672,"_3086":121755},[],"Identidad",{"_3696":73295,"_31230":73263,"_21622":121757,"_5":14887,"_28406":121672,"_3086":121758},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3696":73296,"_31230":73263,"_21622":121760,"_5":14887,"_28406":121672,"_3086":121761},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3696":73297,"_31230":73263,"_21622":121763,"_5":14887,"_28406":121672,"_3086":121764},[],"Enrutamiento externo",{"_3696":73298,"_31230":73263,"_21622":121766,"_5":14887,"_28406":121672,"_3086":121767},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3696":73299,"_31230":73263,"_21622":121769,"_5":14887,"_28406":121672,"_3086":121770},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3696":73300,"_31230":73263,"_21622":121772,"_5":14887,"_28406":121672,"_3086":52274},[],{"_3696":73301,"_31230":73263,"_21622":121774,"_5":14887,"_28406":121672,"_3086":121775},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3696":73302,"_31230":73263,"_21622":121777,"_5":14887,"_28406":121672,"_3086":121778},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3696":73303,"_31230":73263,"_21622":121780,"_5":14887,"_28406":121672,"_3086":121781},[],"Datos persistentes de la aplicación",{"_3696":73304,"_31230":73263,"_21622":121783,"_5":14887,"_28406":121672,"_3086":121784},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3696":73305,"_31230":73263,"_21622":121786,"_5":14887,"_28406":121672,"_3086":121787},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3696":73306,"_31230":73263,"_21622":121789,"_5":14887,"_28406":121672,"_3086":121790},[],"Integraciones opcionales",{"_3696":73307,"_31230":73263,"_21622":121792,"_5":14887,"_28406":121672,"_3086":121793},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3696":73308,"_31230":73263,"_21622":121795,"_5":14887,"_28406":121672,"_3086":121796},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3696":73309,"_31230":73263,"_21622":121798,"_5":14887,"_28406":121672,"_3086":121799},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3696":73310,"_31230":73263,"_21622":121801,"_5":14887,"_28406":121672,"_3086":121802},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3696":73311,"_31230":73263,"_21622":121804,"_5":14887,"_28406":121676,"_3086":121805},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3696":73312,"_31230":73263,"_21622":121807,"_5":14887,"_28406":121676,"_3086":121808},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3696":73313,"_31230":73263,"_21622":121810,"_5":14887,"_28406":121680,"_3086":121811},[],"Kubernetes 1.24 o posterior",{"_3696":73314,"_31230":73263,"_21622":121813,"_5":14887,"_28406":121680,"_3086":121814},[],"Helm 3.2 o posterior",{"_3696":73315,"_31230":73263,"_21622":121816,"_5":14887,"_28406":121680,"_3086":121817},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3696":73316,"_31230":73263,"_21622":121819,"_5":14887,"_28406":121680,"_3086":121820},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3696":73317,"_31230":73263,"_21622":121822,"_5":14887,"_28406":121680,"_3086":121823},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3696":73318,"_31230":73263,"_21622":121825,"_5":14887,"_28406":121680,"_3086":121826},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3696":73319,"_31230":73263,"_21622":121828,"_5":14887,"_28406":121680,"_3086":121829},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3696":73320,"_31230":73263,"_21622":121831,"_5":14887,"_28406":121684,"_3086":121832},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3696":73321,"_31230":73263,"_21622":121834,"_5":14887,"_28406":121684,"_3086":121835},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3696":73322,"_31230":73263,"_21622":121837,"_5":14887,"_28406":121684,"_3086":121838},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3696":73323,"_31230":73263,"_21622":121840,"_5":14887,"_28406":121684,"_3086":121841},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3696":73324,"_31230":73324,"_5":15247,"_3086":121843,"_31588":121844,"_21622":121846,"_28406":73324},"Resolución de problemas de despliegue",[51065,120600,121845],"Operación",[],{"_3696":73325,"_31230":73324,"_21622":121848,"_5":14887,"_28406":73324,"_3086":121849},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3696":73326,"_31230":73324,"_5":31585,"_21622":121851,"_28406":121852,"_3086":121853},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3696":73327,"_31230":73324,"_5":31585,"_21622":121855,"_28406":121856,"_3086":121857},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3696":73328,"_31230":73324,"_5":31585,"_21622":121859,"_28406":121860,"_3086":121861},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3696":73329,"_31230":73324,"_5":31585,"_21622":121863,"_28406":121864,"_3086":121865},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3696":73330,"_31230":73324,"_5":31585,"_21622":121867,"_28406":121868,"_3086":121869},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3696":73331,"_31230":73324,"_5":31585,"_21622":121871,"_28406":121872,"_3086":121873},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3696":73332,"_31230":73324,"_5":31585,"_21622":121875,"_28406":121876,"_3086":121877},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3696":73333,"_31230":73324,"_5":31585,"_21622":121879,"_28406":121880,"_3086":121881},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3696":73334,"_31230":73324,"_5":31585,"_21622":121883,"_28406":121884,"_3086":121885},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3696":73335,"_31230":73324,"_5":31585,"_21622":121887,"_28406":121888,"_3086":121889},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3696":73336,"_31230":73324,"_5":31585,"_21622":121891,"_28406":121892,"_3086":121893},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3696":73337,"_31230":73324,"_5":31585,"_21622":121895,"_28406":121896,"_3086":121897},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3696":73338,"_31230":73324,"_5":31585,"_21622":121899,"_28406":121900,"_3086":121901},[],"/docs/pr-preview/pr-80/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3696":73339,"_31230":73324,"_21622":121903,"_5":14887,"_28406":73324,"_3086":121904},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3696":73340,"_31230":73324,"_21622":121906,"_5":14887,"_28406":121856,"_3086":121907},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3696":73341,"_31230":73324,"_21622":121909,"_5":14887,"_28406":121860,"_3086":121910},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3696":73342,"_31230":73324,"_21622":121912,"_5":14887,"_28406":121864,"_3086":121913},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3696":73343,"_31230":73324,"_21622":121915,"_5":14887,"_28406":121868,"_3086":121916},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3696":73344,"_31230":73324,"_21622":121918,"_5":14887,"_28406":121872,"_3086":121919},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3696":73345,"_31230":73324,"_21622":121921,"_5":14887,"_28406":121876,"_3086":121922},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3696":73346,"_31230":73324,"_21622":121924,"_5":14887,"_28406":121876,"_3086":121925},[],"Ejecuta también la prueba de conectividad del chart:",{"_3696":73347,"_31230":73324,"_21622":121927,"_5":14887,"_28406":121876,"_3086":121928},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3696":73348,"_31230":73324,"_21622":121930,"_5":14887,"_28406":121876,"_3086":121931},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3696":73349,"_31230":73324,"_21622":121933,"_5":14887,"_28406":121880,"_3086":121934},[],"Si recibes un 401:",{"_3696":73350,"_31230":73324,"_21622":121936,"_5":14887,"_28406":121880,"_3086":121937},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3696":73351,"_31230":73324,"_21622":121939,"_5":14887,"_28406":121880,"_3086":121940},[],"verifica emisor, audiencia y expiración del token;",{"_3696":73352,"_31230":73324,"_21622":121942,"_5":14887,"_28406":121880,"_3086":121943},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3696":73353,"_31230":73324,"_21622":121945,"_5":14887,"_28406":121880,"_3086":121946},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3696":73354,"_31230":73324,"_21622":121948,"_5":14887,"_28406":121880,"_3086":121949},[],"Si el login termina pero las APIs devuelven 403:",{"_3696":73355,"_31230":73324,"_21622":121951,"_5":14887,"_28406":121880,"_3086":121952},[],"inspecciona los claims reales del token;",{"_3696":73356,"_31230":73324,"_21622":121954,"_5":14887,"_28406":121880,"_3086":121955},[],"confirma que coinciden con un principal activo;",{"_3696":73357,"_31230":73324,"_21622":121957,"_5":14887,"_28406":121880,"_3086":121958},[],"revisa las políticas concedidas al principal;",{"_3696":73358,"_31230":73324,"_21622":121960,"_5":14887,"_28406":121880,"_3086":121961},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3696":73359,"_31230":73324,"_21622":121963,"_5":14887,"_28406":121880,"_3086":121964},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3696":73360,"_31230":73324,"_21622":121966,"_5":14887,"_28406":121884,"_3086":121967},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3696":73361,"_31230":73324,"_21622":121969,"_5":14887,"_28406":121884,"_3086":121970},[],"Localiza el pod y Service de authz.",{"_3696":73362,"_31230":73324,"_21622":121972,"_5":14887,"_28406":121884,"_3086":121973},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3696":73363,"_31230":73324,"_21622":121975,"_5":14887,"_28406":121884,"_3086":121976},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3696":73364,"_31230":73324,"_21622":121978,"_5":14887,"_28406":121884,"_3086":121979},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3696":73365,"_31230":73324,"_21622":121981,"_5":14887,"_28406":121884,"_3086":121982},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3696":73366,"_31230":73324,"_21622":121984,"_5":14887,"_28406":121888,"_3086":121985},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3696":73367,"_31230":73324,"_21622":121987,"_5":14887,"_28406":121892,"_3086":121988},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3696":73368,"_31230":73324,"_21622":121990,"_5":14887,"_28406":121892,"_3086":121991},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3696":73369,"_31230":73324,"_21622":121993,"_5":14887,"_28406":121892,"_3086":121994},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3696":73370,"_31230":73324,"_21622":121996,"_5":14887,"_28406":121892,"_3086":121997},[],"volumen persistente sin enlazar;",{"_3696":73371,"_31230":73324,"_21622":121999,"_5":14887,"_28406":121892,"_3086":122000},[],"imagen inaccesible o política de pull incorrecta;",{"_3696":73372,"_31230":73324,"_21622":122002,"_5":14887,"_28406":121892,"_3086":122003},[],"configuración inválida del motor criptográfico;",{"_3696":73373,"_31230":73324,"_21622":122005,"_5":14887,"_28406":121892,"_3086":122006},[],"límites de CPU o memoria demasiado bajos;",{"_3696":73374,"_31230":73324,"_21622":122008,"_5":14887,"_28406":121892,"_3086":122009},[],"migración previa incompleta.",{"_3696":73375,"_31230":73324,"_21622":122011,"_5":14887,"_28406":121892,"_3086":122012},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3696":73376,"_31230":73324,"_21622":122014,"_5":14887,"_28406":121892,"_3086":122015},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3696":73377,"_31230":73324,"_21622":122017,"_5":14887,"_28406":121892,"_3086":122018},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3696":73378,"_31230":73324,"_21622":122020,"_5":14887,"_28406":121896,"_3086":122021},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3696":73379,"_31230":73324,"_21622":122023,"_5":14887,"_28406":121896,"_3086":122024},[],"verifica que esté habilitado en el servicio emisor;",{"_3696":73380,"_31230":73324,"_21622":122026,"_5":14887,"_28406":121896,"_3086":122027},[],"comprueba conectividad y credenciales AMQP;",{"_3696":73381,"_31230":73324,"_21622":122029,"_5":14887,"_28406":121896,"_3086":122030},[],"revisa exchange, routing key, colas y consumidores;",{"_3696":73382,"_31230":73324,"_21622":122032,"_5":14887,"_28406":121896,"_3086":122033},[],"inspecciona dead-letter queues;",{"_3696":73383,"_31230":73324,"_21622":122035,"_5":14887,"_28406":121896,"_3086":122036},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3696":73384,"_31230":73324,"_21622":122038,"_5":14887,"_28406":121896,"_3086":122039},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3696":73385,"_31230":73324,"_21622":122041,"_5":14887,"_28406":121896,"_3086":122042},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3696":73386,"_31230":73324,"_21622":122044,"_5":14887,"_28406":121896,"_3086":122045},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3696":73387,"_31230":73324,"_21622":122047,"_5":14887,"_28406":121896,"_3086":122048},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3696":73388,"_31230":73324,"_21622":122050,"_5":14887,"_28406":121896,"_3086":122051},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3696":73389,"_31230":73324,"_21622":122053,"_5":14887,"_28406":121896,"_3086":122054},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3696":73390,"_31230":73324,"_21622":122056,"_5":14887,"_28406":121896,"_3086":122057},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3696":73391,"_31230":73324,"_21622":122059,"_5":14887,"_28406":121900,"_3086":122060},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3696":73392,"_31230":73324,"_21622":122062,"_5":14887,"_28406":121900,"_3086":122063},[],"Antes de cerrar una incidencia, guarda:",{"_3696":73393,"_31230":73324,"_21622":122065,"_5":14887,"_28406":121900,"_3086":122066},[],"causa confirmada;",{"_3696":73394,"_31230":73324,"_21622":122068,"_5":14887,"_28406":121900,"_3086":122069},[],"alcance temporal y recursos afectados;",{"_3696":73395,"_31230":73324,"_21622":122071,"_5":14887,"_28406":121900,"_3086":122072},[],"comandos o consultas utilizados;",{"_3696":73396,"_31230":73324,"_21622":122074,"_5":14887,"_28406":121900,"_3086":122075},[],"cambio aplicado y forma de revertirlo;",{"_3696":73397,"_31230":73324,"_21622":122077,"_5":14887,"_28406":121900,"_3086":122078},[],"validación desde un consumidor;",{"_3696":73398,"_31230":73324,"_21622":122080,"_5":14887,"_28406":121900,"_3086":122081},[],"acción preventiva y propietario.",{"_3696":73399,"_31230":73399,"_5":15247,"_3086":122083,"_31588":122084,"_21622":122088,"_28406":73399},"Modelo de datos",[51065,122085,122086,122087],"Plataforma","Administración","Control de acceso",[],{"_3696":73400,"_31230":73399,"_21622":122090,"_5":14887,"_28406":73399,"_3086":122091},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3696":73401,"_31230":73399,"_5":31585,"_21622":122093,"_28406":122094,"_3086":122095},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3696":73402,"_31230":73399,"_5":31585,"_21622":122097,"_28406":122098,"_3086":122099},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3696":73403,"_31230":73399,"_21622":122101,"_5":14887,"_28406":73399,"_3086":122102},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3696":73404,"_31230":73399,"_21622":122104,"_5":14887,"_28406":122094,"_3086":122105},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3696":73405,"_31230":73399,"_21622":122107,"_5":14887,"_28406":122094,"_3086":122108},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3696":73406,"_31230":73399,"_21622":122110,"_5":14887,"_28406":122094,"_3086":122111},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3696":73407,"_31230":73399,"_21622":122113,"_5":14887,"_28406":122098,"_3086":122114},[],"Entidad (`schema_name.entity_type`)",{"_3696":73408,"_31230":73399,"_21622":122116,"_5":14887,"_28406":122098,"_3086":122117},[],"Tabla (`table_name`)",{"_3696":73409,"_31230":73399,"_21622":122119,"_5":14887,"_28406":122098,"_3086":122120},[],"Clave (`primary_key`)",{"_3696":73410,"_31230":73399,"_21622":122122,"_5":14887,"_28406":122098,"_3086":52625},[],{"_3696":73411,"_31230":73399,"_21622":122124,"_5":14887,"_28406":122098,"_3086":52628},[],{"_3696":73412,"_31230":73399,"_21622":122126,"_5":14887,"_28406":122098,"_3086":52631},[],{"_3696":73413,"_31230":73399,"_21622":122128,"_5":14887,"_28406":122098,"_3086":52634},[],{"_3696":73414,"_31230":73399,"_21622":122130,"_5":14887,"_28406":122098,"_3086":52637},[],{"_3696":73415,"_31230":73399,"_21622":122132,"_5":14887,"_28406":122098,"_3086":52640},[],{"_3696":73416,"_31230":73399,"_21622":122134,"_5":14887,"_28406":122098,"_3086":52643},[],{"_3696":73417,"_31230":73399,"_21622":122136,"_5":14887,"_28406":122098,"_3086":52646},[],{"_3696":73418,"_31230":73399,"_21622":122138,"_5":14887,"_28406":122098,"_3086":52640},[],{"_3696":73419,"_31230":73399,"_21622":122140,"_5":14887,"_28406":122098,"_3086":52651},[],{"_3696":73420,"_31230":73399,"_21622":122142,"_5":14887,"_28406":122098,"_3086":52654},[],{"_3696":73421,"_31230":73399,"_21622":122144,"_5":14887,"_28406":122098,"_3086":52657},[],{"_3696":73422,"_31230":73399,"_21622":122146,"_5":14887,"_28406":122098,"_3086":52660},[],{"_3696":73423,"_31230":73399,"_21622":122148,"_5":14887,"_28406":122098,"_3086":52663},[],{"_3696":73424,"_31230":73399,"_21622":122150,"_5":14887,"_28406":122098,"_3086":52640},[],{"_3696":73425,"_31230":73399,"_21622":122152,"_5":14887,"_28406":122098,"_3086":52668},[],{"_3696":73426,"_31230":73399,"_21622":122154,"_5":14887,"_28406":122098,"_3086":52671},[],{"_3696":73427,"_31230":73399,"_21622":122156,"_5":14887,"_28406":122098,"_3086":52640},[],{"_3696":73428,"_31230":73399,"_21622":122158,"_5":14887,"_28406":122098,"_3086":52676},[],{"_3696":73429,"_31230":73399,"_21622":122160,"_5":14887,"_28406":122098,"_3086":52679},[],{"_3696":73430,"_31230":73399,"_21622":122162,"_5":14887,"_28406":122098,"_3086":52640},[],{"_3696":73431,"_31230":73399,"_21622":122164,"_5":14887,"_28406":122098,"_3086":52684},[],{"_3696":73432,"_31230":73399,"_21622":122166,"_5":14887,"_28406":122098,"_3086":52687},[],{"_3696":73433,"_31230":73399,"_21622":122168,"_5":14887,"_28406":122098,"_3086":52640},[],{"_3696":73434,"_31230":73399,"_21622":122170,"_5":14887,"_28406":122098,"_3086":52692},[],{"_3696":73435,"_31230":73399,"_21622":122172,"_5":14887,"_28406":122098,"_3086":52695},[],{"_3696":73436,"_31230":73399,"_21622":122174,"_5":14887,"_28406":122098,"_3086":52698},[],{"_3696":73437,"_31230":73399,"_21622":122176,"_5":14887,"_28406":122098,"_3086":52701},[],{"_3696":73438,"_31230":73399,"_21622":122178,"_5":14887,"_28406":122098,"_3086":52704},[],{"_3696":73439,"_31230":73399,"_21622":122180,"_5":14887,"_28406":122098,"_3086":52707},[],{"_3696":73440,"_31230":73399,"_21622":122182,"_5":14887,"_28406":122098,"_3086":122183},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3696":73441,"_31230":73399,"_21622":122185,"_5":14887,"_28406":122098,"_3086":122186},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3696":73442,"_31230":73399,"_21622":122188,"_5":14887,"_28406":122098,"_3086":122189},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3696":73443,"_31230":73443,"_5":15247,"_3086":122191,"_31588":122192,"_21622":122193,"_28406":73443},"Visión general del control de acceso",[51065,122085,122086,122087],[],{"_3696":73444,"_31230":73443,"_21622":122195,"_5":14887,"_28406":73443,"_3086":122196},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3696":73445,"_31230":73443,"_5":31585,"_21622":122198,"_28406":122199,"_3086":122200},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3696":73446,"_31230":73443,"_5":31585,"_21622":122202,"_28406":122203,"_3086":122204},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3696":73447,"_31230":73443,"_5":31585,"_21622":122206,"_28406":122207,"_3086":122208},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3696":73448,"_31230":73443,"_5":31585,"_21622":122210,"_28406":122211,"_3086":122212},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3696":73449,"_31230":73443,"_5":31585,"_21622":122214,"_28406":122215,"_3086":122216},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3696":73450,"_31230":73443,"_5":31585,"_21622":122218,"_28406":122219,"_3086":122220},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3696":73451,"_31230":73443,"_5":31585,"_21622":122222,"_28406":122223,"_3086":122224},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3696":73452,"_31230":73443,"_5":31585,"_21622":122226,"_28406":122227,"_3086":122228},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3696":73453,"_31230":73443,"_5":31585,"_21622":122230,"_28406":122231,"_3086":122232},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3696":73454,"_31230":73443,"_5":31585,"_21622":122234,"_28406":122235,"_3086":122236},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3696":73455,"_31230":73443,"_5":31585,"_21622":122238,"_28406":122239,"_3086":122240},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3696":73456,"_31230":73443,"_5":31585,"_21622":122242,"_28406":122243,"_3086":122244},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3696":73457,"_31230":73443,"_5":31585,"_21622":122246,"_28406":122247,"_3086":122248},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3696":73458,"_31230":73443,"_5":31585,"_21622":122250,"_28406":122251,"_3086":122252},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3696":73459,"_31230":73443,"_5":31585,"_21622":122254,"_28406":122255,"_3086":122256},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3696":73460,"_31230":73443,"_5":31585,"_21622":122258,"_28406":122259,"_3086":121220},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3696":73461,"_31230":73443,"_5":31585,"_21622":122261,"_28406":122262,"_3086":122263},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3696":73462,"_31230":73443,"_5":31585,"_21622":122265,"_28406":122266,"_3086":122267},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3696":73463,"_31230":73443,"_5":31585,"_21622":122269,"_28406":122270,"_3086":122271},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3696":73464,"_31230":73443,"_5":31585,"_21622":122273,"_28406":122274,"_3086":122275},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3696":73465,"_31230":73443,"_5":31585,"_21622":122277,"_28406":122278,"_3086":122279},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3696":73466,"_31230":73443,"_5":31585,"_21622":122281,"_28406":122282,"_3086":122283},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3696":73467,"_31230":73443,"_5":31585,"_21622":122285,"_28406":122286,"_3086":122287},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3696":73468,"_31230":73443,"_5":31585,"_21622":122289,"_28406":122290,"_3086":122291},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3696":73469,"_31230":73443,"_5":31585,"_21622":122293,"_28406":122294,"_3086":122295},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3696":73470,"_31230":73443,"_5":31585,"_21622":122297,"_28406":122298,"_3086":122299},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3696":73471,"_31230":73443,"_5":31585,"_21622":122301,"_28406":122302,"_3086":122303},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3696":73472,"_31230":73443,"_5":31585,"_21622":122305,"_28406":122306,"_3086":122307},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3696":73473,"_31230":73443,"_5":31585,"_21622":122309,"_28406":122310,"_3086":122311},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3696":73474,"_31230":73443,"_5":31585,"_21622":122313,"_28406":122314,"_3086":122315},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3696":73475,"_31230":73443,"_5":31585,"_21622":122317,"_28406":122318,"_3086":122319},[],"/docs/pr-preview/pr-80/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3696":73476,"_31230":73443,"_21622":122321,"_5":14887,"_28406":73443,"_3086":122322},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3696":73477,"_31230":73443,"_21622":122324,"_5":14887,"_28406":73443,"_3086":122325},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3696":73478,"_31230":73443,"_21622":122327,"_5":14887,"_28406":73443,"_3086":122328},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3696":73479,"_31230":73443,"_21622":122330,"_5":14887,"_28406":122199,"_3086":122331},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3696":73480,"_31230":73443,"_21622":122333,"_5":14887,"_28406":122199,"_3086":122334},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3696":73481,"_31230":73443,"_21622":122336,"_5":14887,"_28406":122199,"_3086":122337},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3696":73482,"_31230":73443,"_21622":122339,"_5":14887,"_28406":122199,"_3086":122340},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3696":73483,"_31230":73443,"_21622":122342,"_5":14887,"_28406":122199,"_3086":122343},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3696":73484,"_31230":73443,"_21622":122345,"_5":14887,"_28406":122199,"_3086":122346},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3696":73485,"_31230":73443,"_21622":122348,"_5":14887,"_28406":122203,"_3086":122349},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3696":73486,"_31230":73443,"_21622":122351,"_5":14887,"_28406":122203,"_3086":122352},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3696":73487,"_31230":73443,"_21622":122354,"_5":14887,"_28406":122207,"_3086":122355},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3696":73488,"_31230":73443,"_21622":122357,"_5":14887,"_28406":122207,"_3086":122358},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3696":73489,"_31230":73443,"_21622":122360,"_5":14887,"_28406":122207,"_3086":122361},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3696":73490,"_31230":73443,"_21622":122363,"_5":14887,"_28406":122207,"_3086":122364},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3696":73491,"_31230":73443,"_21622":122366,"_5":14887,"_28406":122207,"_3086":122367},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3696":73492,"_31230":73443,"_21622":122369,"_5":14887,"_28406":122207,"_3086":122370},[],"Carga por separado las políticas concedidas a cada principal.",{"_3696":73493,"_31230":73443,"_21622":122372,"_5":14887,"_28406":122207,"_3086":122373},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3696":73494,"_31230":73443,"_21622":122375,"_5":14887,"_28406":122207,"_3086":122376},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3696":73495,"_31230":73443,"_21622":122378,"_5":14887,"_28406":122207,"_3086":122379},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3696":73496,"_31230":73443,"_21622":122381,"_5":14887,"_28406":122207,"_3086":122382},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3696":73497,"_31230":73443,"_21622":122384,"_5":14887,"_28406":122207,"_3086":122385},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3696":73498,"_31230":73443,"_21622":122387,"_5":14887,"_28406":122207,"_3086":122388},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3696":73499,"_31230":73443,"_21622":122390,"_5":14887,"_28406":122211,"_3086":122391},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3696":73500,"_31230":73443,"_21622":122393,"_5":14887,"_28406":122211,"_3086":122394},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3696":73501,"_31230":73443,"_21622":122396,"_5":14887,"_28406":122211,"_3086":122397},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3696":73502,"_31230":73443,"_21622":122399,"_5":14887,"_28406":122211,"_3086":122400},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3696":73503,"_31230":73443,"_21622":122402,"_5":14887,"_28406":122211,"_3086":122403},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3696":73504,"_31230":73443,"_21622":122405,"_5":14887,"_28406":122211,"_3086":122406},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3696":73505,"_31230":73443,"_21622":122408,"_5":14887,"_28406":122211,"_3086":122409},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3696":73506,"_31230":73443,"_21622":122411,"_5":14887,"_28406":122211,"_3086":122412},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3696":73507,"_31230":73443,"_21622":122414,"_5":14887,"_28406":122211,"_3086":122415},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3696":73508,"_31230":73443,"_21622":122417,"_5":14887,"_28406":122211,"_3086":122418},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3696":73509,"_31230":73443,"_21622":122420,"_5":14887,"_28406":122215,"_3086":122421},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3696":73510,"_31230":73443,"_21622":122423,"_5":14887,"_28406":122215,"_3086":122424},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3696":73511,"_31230":73443,"_21622":122426,"_5":14887,"_28406":122215,"_3086":122427},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3696":73512,"_31230":73443,"_21622":122429,"_5":14887,"_28406":122215,"_3086":122430},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3696":73513,"_31230":73443,"_21622":122432,"_5":14887,"_28406":122215,"_3086":122433},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3696":73514,"_31230":73443,"_21622":122435,"_5":14887,"_28406":122215,"_3086":122436},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3696":73515,"_31230":73443,"_21622":122438,"_5":14887,"_28406":122215,"_3086":122439},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3696":73516,"_31230":73443,"_21622":122441,"_5":14887,"_28406":122215,"_3086":122442},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3696":73517,"_31230":73443,"_21622":122444,"_5":14887,"_28406":122215,"_3086":122445},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3696":73518,"_31230":73443,"_21622":122447,"_5":14887,"_28406":122215,"_3086":122448},[],"Las acciones se dividen en dos grupos:",{"_3696":73519,"_31230":73443,"_21622":122450,"_5":14887,"_28406":122215,"_3086":122451},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3696":73520,"_31230":73443,"_21622":122453,"_5":14887,"_28406":122215,"_3086":122454},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3696":73521,"_31230":73443,"_21622":122456,"_5":14887,"_28406":122215,"_3086":122457},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3696":73522,"_31230":73443,"_21622":122459,"_5":14887,"_28406":122219,"_3086":122460},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3696":73523,"_31230":73443,"_21622":122462,"_5":14887,"_28406":122219,"_3086":122463},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3696":73524,"_31230":73443,"_21622":122465,"_5":14887,"_28406":122219,"_3086":122466},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3696":73525,"_31230":73443,"_21622":122468,"_5":14887,"_28406":122223,"_3086":122469},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3696":73526,"_31230":73443,"_21622":122471,"_5":14887,"_28406":122223,"_3086":122472},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3696":73527,"_31230":73443,"_21622":122474,"_5":14887,"_28406":122223,"_3086":122475},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3696":73528,"_31230":73443,"_21622":122477,"_5":14887,"_28406":122223,"_3086":122478},[],"Los operadores implementados son:",{"_3696":73529,"_31230":73443,"_21622":122480,"_5":14887,"_28406":122223,"_3086":122481},[],"`equals`, para igualdad exacta;",{"_3696":73530,"_31230":73443,"_21622":122483,"_5":14887,"_28406":122223,"_3086":122484},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3696":73531,"_31230":73443,"_21622":122486,"_5":14887,"_28406":122223,"_3086":122487},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3696":73532,"_31230":73443,"_21622":122489,"_5":14887,"_28406":122223,"_3086":122490},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3696":73533,"_31230":73443,"_21622":122492,"_5":14887,"_28406":122227,"_3086":122493},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3696":73534,"_31230":73443,"_21622":122495,"_5":14887,"_28406":122227,"_3086":122496},[],"Los modos disponibles son:",{"_3696":73535,"_31230":73443,"_21622":122498,"_5":14887,"_28406":122227,"_3086":122499},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3696":73536,"_31230":73443,"_21622":122501,"_5":14887,"_28406":122227,"_3086":122502},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3696":73537,"_31230":73443,"_21622":122504,"_5":14887,"_28406":122227,"_3086":122505},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3696":73538,"_31230":73443,"_21622":122507,"_5":14887,"_28406":122227,"_3086":122508},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3696":73539,"_31230":73443,"_21622":122510,"_5":14887,"_28406":122227,"_3086":122511},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3696":73540,"_31230":73443,"_21622":122513,"_5":14887,"_28406":122227,"_3086":122514},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3696":73541,"_31230":73443,"_21622":122516,"_5":14887,"_28406":122231,"_3086":122517},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3696":73542,"_31230":73443,"_21622":122519,"_5":14887,"_28406":122231,"_3086":122520},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3696":73543,"_31230":73443,"_21622":122522,"_5":14887,"_28406":122231,"_3086":122523},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3696":73544,"_31230":73443,"_21622":122525,"_5":14887,"_28406":122231,"_3086":122526},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3696":73545,"_31230":73443,"_21622":122528,"_5":14887,"_28406":122239,"_3086":122529},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3696":73546,"_31230":73443,"_21622":122531,"_5":14887,"_28406":122239,"_3086":122532},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3696":73547,"_31230":73443,"_21622":122534,"_5":14887,"_28406":122243,"_3086":122535},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3696":73548,"_31230":73443,"_21622":122537,"_5":14887,"_28406":122243,"_3086":122538},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3696":73549,"_31230":73443,"_21622":122540,"_5":14887,"_28406":122243,"_3086":122541},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3696":73550,"_31230":73443,"_21622":122543,"_5":14887,"_28406":122243,"_3086":122544},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3696":73551,"_31230":73443,"_21622":122546,"_5":14887,"_28406":122243,"_3086":122547},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3696":73552,"_31230":73443,"_21622":122549,"_5":14887,"_28406":122247,"_3086":122550},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3696":73553,"_31230":73443,"_21622":122552,"_5":14887,"_28406":122247,"_3086":122553},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3696":73554,"_31230":73443,"_21622":122555,"_5":14887,"_28406":122247,"_3086":122556},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3696":73555,"_31230":73443,"_21622":122558,"_5":14887,"_28406":122251,"_3086":122559},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3696":73556,"_31230":73443,"_21622":122561,"_5":14887,"_28406":122251,"_3086":122562},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3696":73557,"_31230":73443,"_21622":122564,"_5":14887,"_28406":122251,"_3086":122565},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3696":73558,"_31230":73443,"_21622":122567,"_5":14887,"_28406":122251,"_3086":122568},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3696":73559,"_31230":73443,"_21622":122570,"_5":14887,"_28406":122251,"_3086":122571},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3696":73560,"_31230":73443,"_21622":122573,"_5":14887,"_28406":122251,"_3086":122574},[],"Ten en cuenta que:",{"_3696":73561,"_31230":73443,"_21622":122576,"_5":14887,"_28406":122251,"_3086":122577},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3696":73562,"_31230":73443,"_21622":122579,"_5":14887,"_28406":122251,"_3086":122580},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3696":73563,"_31230":73443,"_21622":122582,"_5":14887,"_28406":122251,"_3086":122583},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3696":73564,"_31230":73443,"_21622":122585,"_5":14887,"_28406":122255,"_3086":122586},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3696":73565,"_31230":73443,"_21622":122588,"_5":14887,"_28406":122255,"_3086":122589},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3696":73566,"_31230":73443,"_21622":122591,"_5":14887,"_28406":122255,"_3086":122592},[],"acceso completo y de solo lectura a KMS;",{"_3696":73567,"_31230":73443,"_21622":122594,"_5":14887,"_28406":122255,"_3086":122595},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3696":73568,"_31230":73443,"_21622":122597,"_5":14887,"_28406":122255,"_3086":122598},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3696":73569,"_31230":73443,"_21622":122600,"_5":14887,"_28406":122255,"_3086":122601},[],"acceso a la interfaz;",{"_3696":73570,"_31230":73443,"_21622":122603,"_5":14887,"_28406":122255,"_3086":122604},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3696":73571,"_31230":73443,"_21622":122606,"_5":14887,"_28406":122255,"_3086":122607},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3696":73572,"_31230":73443,"_21622":122609,"_5":14887,"_28406":122255,"_3086":122610},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3696":73573,"_31230":73443,"_21622":122612,"_5":14887,"_28406":122255,"_3086":122613},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3696":73574,"_31230":73443,"_21622":122615,"_5":14887,"_28406":122255,"_3086":122616},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3696":73575,"_31230":73443,"_21622":122618,"_5":14887,"_28406":122259,"_3086":122619},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3696":73576,"_31230":73443,"_21622":122621,"_5":14887,"_28406":122259,"_3086":122622},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3696":73577,"_31230":73443,"_21622":122624,"_5":14887,"_28406":122259,"_3086":122625},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3696":73578,"_31230":73443,"_21622":122627,"_5":14887,"_28406":122262,"_3086":122628},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3696":73579,"_31230":73443,"_21622":122630,"_5":14887,"_28406":122266,"_3086":122631},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3696":73580,"_31230":73443,"_21622":122633,"_5":14887,"_28406":122266,"_3086":122634},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3696":73581,"_31230":73443,"_21622":122636,"_5":14887,"_28406":122270,"_3086":122637},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3696":73582,"_31230":73443,"_21622":122639,"_5":14887,"_28406":122274,"_3086":122640},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3696":73583,"_31230":73443,"_21622":122642,"_5":14887,"_28406":122278,"_3086":122643},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3696":73584,"_31230":73443,"_21622":122645,"_5":14887,"_28406":122282,"_3086":122646},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3696":73585,"_31230":73443,"_21622":122648,"_5":14887,"_28406":122282,"_3086":122649},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3696":73586,"_31230":73443,"_21622":122651,"_5":14887,"_28406":122286,"_3086":122652},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3696":73587,"_31230":73443,"_21622":122654,"_5":14887,"_28406":122286,"_3086":122655},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3696":73588,"_31230":73443,"_21622":122657,"_5":14887,"_28406":122286,"_3086":122658},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3696":73589,"_31230":73443,"_21622":122660,"_5":14887,"_28406":122286,"_3086":122661},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3696":73590,"_31230":73443,"_21622":122663,"_5":14887,"_28406":122286,"_3086":122664},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3696":73591,"_31230":73443,"_21622":122666,"_5":14887,"_28406":122286,"_3086":122667},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3696":73592,"_31230":73443,"_21622":122669,"_5":14887,"_28406":122286,"_3086":122670},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3696":73593,"_31230":73443,"_21622":122672,"_5":14887,"_28406":122286,"_3086":122673},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3696":73594,"_31230":73443,"_21622":122675,"_5":14887,"_28406":122290,"_3086":122676},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3696":73595,"_31230":73443,"_21622":122678,"_5":14887,"_28406":122290,"_3086":122679},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3696":73596,"_31230":73443,"_21622":122681,"_5":14887,"_28406":122290,"_3086":122682},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3696":73597,"_31230":73443,"_21622":122684,"_5":14887,"_28406":122294,"_3086":122685},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3696":73598,"_31230":73443,"_21622":122687,"_5":14887,"_28406":122294,"_3086":122688},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3696":73599,"_31230":73443,"_21622":122690,"_5":14887,"_28406":122294,"_3086":122691},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3696":73600,"_31230":73443,"_21622":122693,"_5":14887,"_28406":122294,"_3086":122694},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3696":73601,"_31230":73443,"_21622":122696,"_5":14887,"_28406":122294,"_3086":122697},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3696":73602,"_31230":73443,"_21622":122699,"_5":14887,"_28406":122294,"_3086":122700},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3696":73603,"_31230":73443,"_21622":122702,"_5":14887,"_28406":122294,"_3086":122703},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3696":73604,"_31230":73443,"_21622":122705,"_5":14887,"_28406":122294,"_3086":122706},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3696":73605,"_31230":73443,"_21622":122708,"_5":14887,"_28406":122302,"_3086":122709},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3696":73606,"_31230":73443,"_21622":122711,"_5":14887,"_28406":122306,"_3086":122712},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3696":73607,"_31230":73443,"_21622":122714,"_5":14887,"_28406":122306,"_3086":122715},[],"que exista un principal activo del tipo correcto;",{"_3696":73608,"_31230":73443,"_21622":122717,"_5":14887,"_28406":122306,"_3086":122718},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3696":73609,"_31230":73443,"_21622":122720,"_5":14887,"_28406":122306,"_3086":122721},[],"que todas las condiciones del principal se cumplan;",{"_3696":73610,"_31230":73443,"_21622":122723,"_5":14887,"_28406":122306,"_3086":122724},[],"que el principal tenga concedida la política esperada;",{"_3696":73611,"_31230":73443,"_21622":122726,"_5":14887,"_28406":122306,"_3086":122727},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3696":73612,"_31230":73443,"_21622":122729,"_5":14887,"_28406":122306,"_3086":122730},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3696":73613,"_31230":73443,"_21622":122732,"_5":14887,"_28406":122306,"_3086":122733},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3696":73614,"_31230":73443,"_21622":122735,"_5":14887,"_28406":122306,"_3086":122736},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3696":73615,"_31230":73443,"_21622":122738,"_5":14887,"_28406":122310,"_3086":122739},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3696":73616,"_31230":73443,"_21622":122741,"_5":14887,"_28406":122314,"_3086":122742},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3696":73617,"_31230":73443,"_21622":122744,"_5":14887,"_28406":122318,"_3086":122745},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3696":73618,"_31230":73443,"_21622":122747,"_5":14887,"_28406":122318,"_3086":122748},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3696":73619,"_31230":73619,"_5":15247,"_3086":122750,"_31588":122751,"_21622":122752,"_28406":73619},"Alertas y suscripciones",[51065,122085,122086],[],{"_3696":73620,"_31230":73619,"_21622":122754,"_5":14887,"_28406":73619,"_3086":122755},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3696":73621,"_31230":73619,"_5":31585,"_21622":122757,"_28406":122758,"_3086":122759},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3696":73622,"_31230":73619,"_5":31585,"_21622":122761,"_28406":122762,"_3086":122763},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3696":73623,"_31230":73619,"_5":31585,"_21622":122765,"_28406":122766,"_3086":122767},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3696":73624,"_31230":73619,"_5":31585,"_21622":122769,"_28406":122770,"_3086":122771},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3696":73625,"_31230":73619,"_5":31585,"_21622":122773,"_28406":122774,"_3086":122775},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3696":73626,"_31230":73619,"_5":31585,"_21622":122777,"_28406":122778,"_3086":122779},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3696":73627,"_31230":73619,"_5":31585,"_21622":122781,"_28406":122782,"_3086":122783},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3696":73628,"_31230":73619,"_5":31585,"_21622":122785,"_28406":122786,"_3086":122787},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3696":73629,"_31230":73619,"_5":31585,"_21622":122789,"_28406":122790,"_3086":122791},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3696":73630,"_31230":73619,"_5":31585,"_21622":122793,"_28406":122794,"_3086":122795},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3696":73631,"_31230":73619,"_5":31585,"_21622":122797,"_28406":122798,"_3086":122799},[],"/docs/pr-preview/pr-80/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3696":73632,"_31230":73619,"_21622":122801,"_5":14887,"_28406":73619,"_3086":122802},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3696":73633,"_31230":73619,"_21622":122804,"_5":14887,"_28406":122758,"_3086":122805},[],"Un servicio publica un evento de dominio.",{"_3696":73634,"_31230":73619,"_21622":122807,"_5":14887,"_28406":122758,"_3086":122808},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3696":73635,"_31230":73619,"_21622":122810,"_5":14887,"_28406":122758,"_3086":122811},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3696":73636,"_31230":73619,"_21622":122813,"_5":14887,"_28406":122758,"_3086":122814},[],"Lamassu entrega el evento al canal configurado.",{"_3696":73637,"_31230":73619,"_21622":122816,"_5":14887,"_28406":122758,"_3086":122817},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3696":73638,"_31230":73619,"_21622":122819,"_5":14887,"_28406":122762,"_3086":122820},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3696":73639,"_31230":73619,"_21622":122822,"_5":14887,"_28406":122762,"_3086":122823},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3696":73640,"_31230":73619,"_21622":122825,"_5":14887,"_28406":122762,"_3086":122826},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3696":73641,"_31230":73619,"_21622":122828,"_5":14887,"_28406":122762,"_3086":122829},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3696":73642,"_31230":73619,"_21622":122831,"_5":14887,"_28406":122762,"_3086":122832},[],"`apikey_options` necesita `header` y `key`.",{"_3696":73643,"_31230":73619,"_21622":122834,"_5":14887,"_28406":122762,"_3086":122835},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3696":73644,"_31230":73619,"_21622":122837,"_5":14887,"_28406":122762,"_3086":122838},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3696":73645,"_31230":73619,"_21622":122840,"_5":14887,"_28406":122762,"_3086":122841},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3696":73646,"_31230":73619,"_21622":122843,"_5":14887,"_28406":122770,"_3086":122844},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3696":73647,"_31230":73619,"_21622":122846,"_5":14887,"_28406":122774,"_3086":122847},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3696":73648,"_31230":73619,"_21622":122849,"_5":14887,"_28406":122778,"_3086":122850},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3696":73649,"_31230":73619,"_21622":122852,"_5":14887,"_28406":122778,"_3086":122853},[],"**None** notifica todas las instancias del evento.",{"_3696":73650,"_31230":73619,"_21622":122855,"_5":14887,"_28406":122778,"_3086":122856},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3696":73651,"_31230":73619,"_21622":122858,"_5":14887,"_28406":122778,"_3086":122859},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3696":73652,"_31230":73619,"_21622":122861,"_5":14887,"_28406":122778,"_3086":122862},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3696":73653,"_31230":73619,"_21622":122864,"_5":14887,"_28406":122778,"_3086":122865},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3696":73654,"_31230":73619,"_21622":122867,"_5":14887,"_28406":122778,"_3086":122868},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3696":73655,"_31230":73619,"_21622":122870,"_5":14887,"_28406":122782,"_3086":122871},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3696":73656,"_31230":73619,"_21622":122873,"_5":14887,"_28406":122786,"_3086":122874},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3696":73657,"_31230":73619,"_21622":122876,"_5":14887,"_28406":122786,"_3086":122877},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3696":73658,"_31230":73619,"_21622":122879,"_5":14887,"_28406":122786,"_3086":122880},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3696":73659,"_31230":73619,"_21622":122882,"_5":14887,"_28406":122786,"_3086":122883},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3696":73660,"_31230":73619,"_21622":122885,"_5":14887,"_28406":122786,"_3086":122886},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3696":73661,"_31230":73619,"_21622":122888,"_5":14887,"_28406":122786,"_3086":122889},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3696":73662,"_31230":73619,"_21622":122891,"_5":14887,"_28406":122786,"_3086":122892},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3696":73663,"_31230":73619,"_21622":122894,"_5":14887,"_28406":122786,"_3086":122895},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3696":73664,"_31230":73619,"_21622":122897,"_5":14887,"_28406":122790,"_3086":122898},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3696":73665,"_31230":73619,"_21622":122900,"_5":14887,"_28406":122790,"_3086":122901},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3696":73666,"_31230":73619,"_21622":122903,"_5":14887,"_28406":122790,"_3086":122904},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3696":73667,"_31230":73619,"_21622":122906,"_5":14887,"_28406":122790,"_3086":122907},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3696":73668,"_31230":73619,"_21622":122909,"_5":14887,"_28406":122790,"_3086":122910},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3696":73669,"_31230":73619,"_21622":122912,"_5":14887,"_28406":122790,"_3086":122913},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3696":73670,"_31230":73619,"_21622":122915,"_5":14887,"_28406":122790,"_3086":122916},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3696":73671,"_31230":73619,"_21622":122918,"_5":14887,"_28406":122790,"_3086":122919},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3696":73672,"_31230":73619,"_21622":122921,"_5":14887,"_28406":122794,"_3086":122922},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3696":73673,"_31230":73619,"_21622":122924,"_5":14887,"_28406":122794,"_3086":122925},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3696":73674,"_31230":73619,"_21622":122927,"_5":14887,"_28406":122798,"_3086":122928},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3696":73675,"_31230":73619,"_21622":122930,"_5":14887,"_28406":122798,"_3086":122931},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3696":73676,"_31230":73619,"_21622":122933,"_5":14887,"_28406":122798,"_3086":122934},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3696":73677,"_31230":73619,"_21622":122936,"_5":14887,"_28406":122798,"_3086":122937},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3696":73678,"_31230":73619,"_21622":122939,"_5":14887,"_28406":122798,"_3086":122940},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3696":73679,"_31230":73619,"_21622":122942,"_5":14887,"_28406":122798,"_3086":122943},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3696":73680,"_31230":73619,"_21622":122945,"_5":14887,"_28406":122798,"_3086":122946},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3696":73681,"_31230":73619,"_21622":122948,"_5":14887,"_28406":122798,"_3086":122949},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3696":73682,"_31230":73619,"_21622":122951,"_5":14887,"_28406":122798,"_3086":122952},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3696":73683,"_31230":73619,"_21622":122954,"_5":14887,"_28406":122798,"_3086":122955},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3696":73684,"_31230":73684,"_5":15247,"_3086":122957,"_31588":122958,"_21622":122959,"_28406":73684},"Registros de auditoría",[51065,122085,122086],[],{"_3696":73685,"_31230":73684,"_21622":122961,"_5":14887,"_28406":73684,"_3086":122962},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3696":73686,"_31230":73684,"_5":31585,"_21622":122964,"_28406":122965,"_3086":122966},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3696":73687,"_31230":73684,"_5":31585,"_21622":122968,"_28406":122969,"_3086":122970},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3696":73688,"_31230":73684,"_5":31585,"_21622":122972,"_28406":122973,"_3086":122974},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3696":73689,"_31230":73684,"_5":31585,"_21622":122976,"_28406":122977,"_3086":122978},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3696":73690,"_31230":73684,"_5":31585,"_21622":122980,"_28406":122981,"_3086":122982},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3696":73691,"_31230":73684,"_5":31585,"_21622":122984,"_28406":122985,"_3086":122986},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3696":73692,"_31230":73684,"_5":31585,"_21622":122988,"_28406":122989,"_3086":122990},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3696":73693,"_31230":73684,"_5":31585,"_21622":122992,"_28406":122993,"_3086":122994},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3696":73694,"_31230":73684,"_5":31585,"_21622":122996,"_28406":122997,"_3086":122998},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3696":73695,"_31230":73684,"_5":31585,"_21622":123000,"_28406":123001,"_3086":123002},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3696":73696,"_31230":73684,"_5":31585,"_21622":123004,"_28406":123005,"_3086":123006},[],"/docs/pr-preview/pr-80/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3696":73697,"_31230":73684,"_21622":123008,"_5":14887,"_28406":73684,"_3086":123009},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3696":73698,"_31230":73684,"_21622":123011,"_5":14887,"_28406":122965,"_3086":123012},[],"El cuerpo de auditoría incluye:",{"_3696":73699,"_31230":73684,"_21622":123014,"_5":14887,"_28406":122965,"_3086":123015},[],"input: datos recibidos por la operación;",{"_3696":73700,"_31230":73684,"_21622":123017,"_5":14887,"_28406":122965,"_3086":123018},[],"has\\_error: indica si el servicio devolvió un error;",{"_3696":73701,"_31230":73684,"_21622":123020,"_5":14887,"_28406":122965,"_3086":123021},[],"output: resultado producido o mensaje de error;",{"_3696":73702,"_31230":73684,"_21622":123023,"_5":14887,"_28406":122965,"_3086":123024},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3696":73703,"_31230":73684,"_21622":123026,"_5":14887,"_28406":122965,"_3086":123027},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3696":73704,"_31230":73684,"_21622":123029,"_5":14887,"_28406":122965,"_3086":123030},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3696":73705,"_31230":73684,"_21622":123032,"_5":14887,"_28406":122969,"_3086":123033},[],"El backend aplica auditoría a mutaciones de:",{"_3696":73706,"_31230":73684,"_21622":123035,"_5":14887,"_28406":122969,"_3086":123036},[],"autoridades, certificados y perfiles de emisión;",{"_3696":73707,"_31230":73684,"_21622":123038,"_5":14887,"_28406":122969,"_3086":123039},[],"claves y motores KMS;",{"_3696":73708,"_31230":73684,"_21622":123041,"_5":14887,"_28406":122969,"_3086":123042},[],"dispositivos e identidades;",{"_3696":73709,"_31230":73684,"_21622":123044,"_5":14887,"_28406":122969,"_3086":123045},[],"DMS y operaciones de enrolamiento;",{"_3696":73710,"_31230":73684,"_21622":123047,"_5":14887,"_28406":122969,"_3086":123048},[],"funciones de validación y CRL;",{"_3696":73711,"_31230":73684,"_21622":123050,"_5":14887,"_28406":122969,"_3086":123051},[],"principales, políticas y concesiones de autorización.",{"_3696":73712,"_31230":73684,"_21622":123053,"_5":14887,"_28406":122969,"_3086":123054},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3696":73713,"_31230":73684,"_21622":123056,"_5":14887,"_28406":122973,"_3086":123057},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3696":73714,"_31230":73684,"_21622":123059,"_5":14887,"_28406":122973,"_3086":123060},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3696":73715,"_31230":73684,"_21622":123062,"_5":14887,"_28406":122973,"_3086":123063},[],"Diseña el consumidor para:",{"_3696":73716,"_31230":73684,"_21622":123065,"_5":14887,"_28406":122973,"_3086":123066},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3696":73717,"_31230":73684,"_21622":123068,"_5":14887,"_28406":122973,"_3086":123069},[],"conservar el CloudEvent completo sin modificar;",{"_3696":73718,"_31230":73684,"_21622":123071,"_5":14887,"_28406":122973,"_3086":123072},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3696":73719,"_31230":73684,"_21622":123074,"_5":14887,"_28406":122973,"_3086":123075},[],"cifrar en tránsito y en reposo;",{"_3696":73720,"_31230":73684,"_21622":123077,"_5":14887,"_28406":122973,"_3086":123078},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3696":73721,"_31230":73684,"_21622":123080,"_5":14887,"_28406":122973,"_3086":123081},[],"aplicar una política explícita de retención y legal hold;",{"_3696":73722,"_31230":73684,"_21622":123083,"_5":14887,"_28406":122973,"_3086":123084},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3696":73723,"_31230":73684,"_21622":123086,"_5":14887,"_28406":122977,"_3086":123087},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3696":73724,"_31230":73684,"_21622":123089,"_5":14887,"_28406":122977,"_3086":123090},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3696":73725,"_31230":73684,"_21622":123092,"_5":14887,"_28406":122985,"_3086":123093},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3696":73726,"_31230":73684,"_21622":123095,"_5":14887,"_28406":122989,"_3086":123096},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3696":73727,"_31230":73684,"_21622":123098,"_5":14887,"_28406":122993,"_3086":123099},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3696":73728,"_31230":73684,"_21622":123101,"_5":14887,"_28406":122997,"_3086":123102},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3696":73729,"_31230":73684,"_21622":123104,"_5":14887,"_28406":123001,"_3086":123105},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3696":73730,"_31230":73684,"_21622":123107,"_5":14887,"_28406":123005,"_3086":123108},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3696":73731,"_31230":73684,"_21622":123110,"_5":14887,"_28406":123005,"_3086":123111},[],"aparece un evento de auditoría correcto;",{"_3696":73732,"_31230":73684,"_21622":123113,"_5":14887,"_28406":123005,"_3086":123114},[],"el principal coincide con la identidad utilizada;",{"_3696":73733,"_31230":73684,"_21622":123116,"_5":14887,"_28406":123005,"_3086":123117},[],"el consumidor lo persiste una sola vez;",{"_3696":73734,"_31230":73684,"_21622":123119,"_5":14887,"_28406":123005,"_3086":123120},[],"puede recuperarse por recurso, actor y periodo;",{"_3696":73735,"_31230":73684,"_21622":123122,"_5":14887,"_28406":123005,"_3086":123123},[],"una interrupción del consumidor produce una alerta.",{"_3696":73736,"_31230":73684,"_21622":123125,"_5":14887,"_28406":123005,"_3086":123126},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3696":73737,"_31230":73737,"_5":15247,"_3086":123128,"_31588":123129,"_21622":123130,"_28406":73737},"Arquitectura de la plataforma",[51065,122085],[],{"_3696":73738,"_31230":73737,"_21622":123132,"_5":14887,"_28406":73737,"_3086":123133},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3696":73739,"_31230":73737,"_5":31585,"_21622":123135,"_28406":123136,"_3086":123137},[],"/docs/pr-preview/pr-80/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3696":73740,"_31230":73737,"_5":31585,"_21622":123139,"_28406":123140,"_3086":123141},[],"/docs/pr-preview/pr-80/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3696":73741,"_31230":73737,"_5":31585,"_21622":123143,"_28406":123144,"_3086":123145},[],"/docs/pr-preview/pr-80/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3696":73742,"_31230":73737,"_5":31585,"_21622":123147,"_28406":123148,"_3086":123149},[],"/docs/pr-preview/pr-80/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3696":73743,"_31230":73737,"_5":31585,"_21622":123151,"_28406":123152,"_3086":123153},[],"/docs/pr-preview/pr-80/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3696":73744,"_31230":73737,"_21622":123155,"_5":14887,"_28406":73737,"_3086":123156},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3696":73745,"_31230":73737,"_21622":123158,"_5":14887,"_28406":73737,"_3086":123159},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3696":73746,"_31230":73737,"_21622":123161,"_5":14887,"_28406":123136,"_3086":123162},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3696":73747,"_31230":73737,"_21622":123164,"_5":14887,"_28406":123140,"_3086":123165},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3696":73748,"_31230":73737,"_21622":123167,"_5":14887,"_28406":123144,"_3086":123168},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3696":73749,"_31230":73737,"_21622":123170,"_5":14887,"_28406":123148,"_3086":123171},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3696":73750,"_31230":73737,"_21622":123173,"_5":14887,"_28406":123152,"_3086":123174},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3696":73751,"_31230":73751,"_5":15247,"_3086":123176,"_31588":123177,"_21622":123178,"_28406":73751},"Cómo funciona Lamassu",[51065,122085],[],{"_3696":73752,"_31230":73751,"_21622":123180,"_5":14887,"_28406":73751,"_3086":123181},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3696":73753,"_31230":73751,"_5":31585,"_21622":123183,"_28406":123184,"_3086":123185},[],"/docs/pr-preview/pr-80/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3696":73754,"_31230":73751,"_5":31585,"_21622":123187,"_28406":123188,"_3086":123189},[],"/docs/pr-preview/pr-80/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3696":73755,"_31230":73751,"_21622":123191,"_5":14887,"_28406":73751,"_3086":123192},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3696":73756,"_31230":73751,"_21622":123194,"_5":14887,"_28406":123184,"_3086":123195},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3696":73757,"_31230":73751,"_21622":123197,"_5":14887,"_28406":123184,"_3086":123198},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3696":73758,"_31230":73751,"_21622":123200,"_5":14887,"_28406":123184,"_3086":123201},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3696":73759,"_31230":73751,"_21622":123203,"_5":14887,"_28406":123184,"_3086":123204},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3696":73760,"_31230":73751,"_21622":123206,"_5":14887,"_28406":123184,"_3086":123207},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3696":73761,"_31230":73751,"_21622":123209,"_5":14887,"_28406":123188,"_3086":123210},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3696":73762,"_31230":73751,"_21622":123212,"_5":14887,"_28406":123188,"_3086":123213},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3696":73763,"_31230":73751,"_21622":123215,"_5":14887,"_28406":123188,"_3086":123216},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3696":73764,"_31230":73751,"_21622":123218,"_5":14887,"_28406":123188,"_3086":123219},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3696":73765,"_31230":73751,"_21622":123221,"_5":14887,"_28406":123188,"_3086":123222},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3696":73766,"_31230":73751,"_21622":123224,"_5":14887,"_28406":123188,"_3086":123225},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3696":73767,"_31230":73751,"_21622":123227,"_5":14887,"_28406":123188,"_3086":123228},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3696":73768,"_31230":73768,"_5":15247,"_3086":123230,"_31588":123231,"_21622":123232,"_28406":73768},"Dispositivos e identidades",[51065,122085,53759,123230],[],{"_3696":73769,"_31230":73768,"_21622":123234,"_5":14887,"_28406":73768,"_3086":123235},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3696":73770,"_31230":73768,"_5":31585,"_21622":123237,"_28406":123238,"_3086":123239},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3696":73771,"_31230":73768,"_5":31585,"_21622":123241,"_28406":123242,"_3086":123243},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3696":73772,"_31230":73768,"_5":31585,"_21622":123245,"_28406":123246,"_3086":123247},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3696":73773,"_31230":73768,"_5":31585,"_21622":123249,"_28406":123250,"_3086":123251},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3696":73774,"_31230":73768,"_5":31585,"_21622":123253,"_28406":123254,"_3086":123255},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3696":73775,"_31230":73768,"_5":31585,"_21622":123257,"_28406":123258,"_3086":123259},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3696":73776,"_31230":73768,"_5":31585,"_21622":123261,"_28406":123262,"_3086":123263},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3696":73777,"_31230":73768,"_5":31585,"_21622":123265,"_28406":123266,"_3086":123267},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3696":73778,"_31230":73768,"_5":31585,"_21622":123269,"_28406":123270,"_3086":123271},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3696":73779,"_31230":73768,"_5":31585,"_21622":123273,"_28406":123274,"_3086":123275},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3696":73780,"_31230":73768,"_5":31585,"_21622":123277,"_28406":123278,"_3086":123279},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3696":73781,"_31230":73768,"_21622":123281,"_5":14887,"_28406":73768,"_3086":123282},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3696":73782,"_31230":73768,"_21622":123284,"_5":14887,"_28406":73768,"_3086":123285},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3696":73783,"_31230":73768,"_21622":123287,"_5":14887,"_28406":123238,"_3086":123288},[],"Vista operativa",{"_3696":73784,"_31230":73768,"_21622":123290,"_5":14887,"_28406":123238,"_3086":123291},[],"Interpretación",{"_3696":73785,"_31230":73768,"_21622":123293,"_5":14887,"_28406":123238,"_3086":53822},[],{"_3696":73786,"_31230":73768,"_21622":123295,"_5":14887,"_28406":123238,"_3086":123296},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3696":73787,"_31230":73768,"_21622":123298,"_5":14887,"_28406":123238,"_3086":53828},[],{"_3696":73788,"_31230":73768,"_21622":123300,"_5":14887,"_28406":123238,"_3086":123301},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3696":73789,"_31230":73768,"_21622":123303,"_5":14887,"_28406":123238,"_3086":53834},[],{"_3696":73790,"_31230":73768,"_21622":123305,"_5":14887,"_28406":123238,"_3086":123306},[],"La identidad está en la ventana operativa de renovación.",{"_3696":73791,"_31230":73768,"_21622":123308,"_5":14887,"_28406":123238,"_3086":53840},[],{"_3696":73792,"_31230":73768,"_21622":123310,"_5":14887,"_28406":123238,"_3086":123311},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3696":73793,"_31230":73768,"_21622":123313,"_5":14887,"_28406":123238,"_3086":53846},[],{"_3696":73794,"_31230":73768,"_21622":123315,"_5":14887,"_28406":123238,"_3086":123316},[],"La identidad ha vencido.",{"_3696":73795,"_31230":73768,"_21622":123318,"_5":14887,"_28406":123238,"_3086":53852},[],{"_3696":73796,"_31230":73768,"_21622":123320,"_5":14887,"_28406":123238,"_3086":123321},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3696":73797,"_31230":73768,"_21622":123323,"_5":14887,"_28406":123238,"_3086":53858},[],{"_3696":73798,"_31230":73768,"_21622":123325,"_5":14887,"_28406":123238,"_3086":123326},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3696":73799,"_31230":73768,"_21622":123328,"_5":14887,"_28406":123238,"_3086":123329},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3696":73800,"_31230":73768,"_21622":123331,"_5":14887,"_28406":123242,"_3086":123332},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3696":73801,"_31230":73768,"_21622":123334,"_5":14887,"_28406":123242,"_3086":123335},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3696":73802,"_31230":73768,"_21622":123337,"_5":14887,"_28406":123242,"_3086":123338},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3696":73803,"_31230":73768,"_21622":123340,"_5":14887,"_28406":123242,"_3086":123341},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3696":73804,"_31230":73768,"_21622":123343,"_5":14887,"_28406":123246,"_3086":123344},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3696":73805,"_31230":73768,"_21622":123346,"_5":14887,"_28406":123250,"_3086":123347},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3696":73806,"_31230":73768,"_21622":123349,"_5":14887,"_28406":123254,"_3086":123350},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3696":73807,"_31230":73768,"_21622":123352,"_5":14887,"_28406":123258,"_3086":123353},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3696":73808,"_31230":73768,"_21622":123355,"_5":14887,"_28406":123262,"_3086":123356},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3696":73809,"_31230":73768,"_21622":123358,"_5":14887,"_28406":123262,"_3086":123359},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3696":73810,"_31230":73768,"_21622":123361,"_5":14887,"_28406":123266,"_3086":123362},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3696":73811,"_31230":73768,"_21622":123364,"_5":14887,"_28406":123266,"_3086":123365},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3696":73812,"_31230":73768,"_21622":123367,"_5":14887,"_28406":123266,"_3086":123368},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3696":73813,"_31230":73768,"_21622":123370,"_5":14887,"_28406":123266,"_3086":123371},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3696":73814,"_31230":73768,"_21622":123373,"_5":14887,"_28406":123266,"_3086":123374},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3696":73815,"_31230":73768,"_21622":123376,"_5":14887,"_28406":123266,"_3086":123377},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3696":73816,"_31230":73768,"_21622":123379,"_5":14887,"_28406":123270,"_3086":123380},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3696":73817,"_31230":73768,"_21622":123382,"_5":14887,"_28406":123270,"_3086":123383},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3696":73818,"_31230":73768,"_21622":123385,"_5":14887,"_28406":123270,"_3086":123386},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3696":73819,"_31230":73768,"_21622":123388,"_5":14887,"_28406":123274,"_3086":123389},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3696":73820,"_31230":73768,"_21622":123391,"_5":14887,"_28406":123274,"_3086":123392},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3696":73821,"_31230":73768,"_21622":123394,"_5":14887,"_28406":123274,"_3086":123395},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3696":73822,"_31230":73768,"_21622":123397,"_5":14887,"_28406":123274,"_3086":123398},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3696":73823,"_31230":73768,"_21622":123400,"_5":14887,"_28406":123278,"_3086":123401},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3696":73824,"_31230":73768,"_21622":123403,"_5":14887,"_28406":123278,"_3086":123404},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3696":73825,"_31230":73825,"_5":15247,"_3086":123406,"_31588":123407,"_21622":123409,"_28406":73825},"Identidad inicial y autenticación",[51065,122085,53759,123230,123408],"Enrolamiento con PKI",[],{"_3696":73826,"_31230":73825,"_21622":123411,"_5":14887,"_28406":73825,"_3086":123412},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3696":73827,"_31230":73825,"_5":31585,"_21622":123414,"_28406":123415,"_3086":123416},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3696":73828,"_31230":73825,"_5":31585,"_21622":123418,"_28406":123419,"_3086":123420},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3696":73829,"_31230":73825,"_5":31585,"_21622":123422,"_28406":123423,"_3086":123424},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3696":73830,"_31230":73825,"_5":31585,"_21622":123426,"_28406":123427,"_3086":123428},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3696":73831,"_31230":73825,"_5":31585,"_21622":123430,"_28406":123431,"_3086":123432},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3696":73832,"_31230":73825,"_21622":123434,"_5":14887,"_28406":73825,"_3086":123435},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3696":73833,"_31230":73825,"_21622":123437,"_5":14887,"_28406":123415,"_3086":123438},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3696":73834,"_31230":73825,"_21622":123440,"_5":14887,"_28406":123415,"_3086":123441},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3696":73835,"_31230":73825,"_21622":123443,"_5":14887,"_28406":123419,"_3086":123444},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3696":73836,"_31230":73825,"_21622":123446,"_5":14887,"_28406":123419,"_3086":123447},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3696":73837,"_31230":73825,"_21622":123449,"_5":14887,"_28406":123419,"_3086":123450},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3696":73838,"_31230":73825,"_21622":123452,"_5":14887,"_28406":123423,"_3086":123453},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3696":73839,"_31230":73825,"_21622":123455,"_5":14887,"_28406":123423,"_3086":123456},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3696":73840,"_31230":73825,"_21622":123458,"_5":14887,"_28406":123427,"_3086":123459},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3696":73841,"_31230":73825,"_21622":123461,"_5":14887,"_28406":123427,"_3086":123462},[],"Ejemplo de cuerpo:",{"_3696":73842,"_31230":73825,"_21622":123464,"_5":14887,"_28406":123427,"_3086":123465},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3696":73843,"_31230":73825,"_21622":123467,"_5":14887,"_28406":123427,"_3086":123468},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3696":73844,"_31230":73825,"_21622":123470,"_5":14887,"_28406":123427,"_3086":123471},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3696":73845,"_31230":73825,"_21622":123473,"_5":14887,"_28406":123427,"_3086":123474},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3696":73846,"_31230":73825,"_21622":123476,"_5":14887,"_28406":123431,"_3086":123477},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3696":73847,"_31230":73825,"_21622":123479,"_5":14887,"_28406":123431,"_3086":123480},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3696":73848,"_31230":73825,"_21622":123482,"_5":14887,"_28406":123431,"_3086":123483},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3696":73849,"_31230":73825,"_21622":123485,"_5":14887,"_28406":123431,"_3086":123486},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3696":73850,"_31230":73850,"_5":15247,"_3086":123488,"_31588":123489,"_21622":123490,"_28406":73850},"Configura y opera el DMS",[51065,122085,53759,123230,123408],[],{"_3696":73851,"_31230":73850,"_21622":123492,"_5":14887,"_28406":73850,"_3086":123493},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3696":73852,"_31230":73850,"_5":31585,"_21622":123495,"_28406":123496,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3696":73853,"_31230":73850,"_5":31585,"_21622":123498,"_28406":123499,"_3086":123500},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3696":73854,"_31230":73850,"_5":31585,"_21622":123502,"_28406":123503,"_3086":123504},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3696":73855,"_31230":73850,"_5":31585,"_21622":123506,"_28406":123507,"_3086":123508},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3696":73856,"_31230":73850,"_5":31585,"_21622":123510,"_28406":123511,"_3086":123512},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3696":73857,"_31230":73850,"_5":31585,"_21622":123514,"_28406":123515,"_3086":123516},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3696":73858,"_31230":73850,"_5":31585,"_21622":123518,"_28406":123519,"_3086":123520},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3696":73859,"_31230":73850,"_5":31585,"_21622":123522,"_28406":123523,"_3086":123524},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3696":73860,"_31230":73850,"_5":31585,"_21622":123526,"_28406":123527,"_3086":54063},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3696":73861,"_31230":73850,"_5":31585,"_21622":123529,"_28406":123530,"_3086":54067},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3696":73862,"_31230":73850,"_5":31585,"_21622":123532,"_28406":123533,"_3086":123534},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3696":73863,"_31230":73850,"_5":31585,"_21622":123536,"_28406":123537,"_3086":123538},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3696":73864,"_31230":73850,"_5":31585,"_21622":123540,"_28406":123541,"_3086":123542},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3696":73865,"_31230":73850,"_5":31585,"_21622":123544,"_28406":123545,"_3086":123546},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3696":73866,"_31230":73850,"_5":31585,"_21622":123548,"_28406":123549,"_3086":54087},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3696":73867,"_31230":73850,"_5":31585,"_21622":123551,"_28406":123552,"_3086":123553},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3696":73868,"_31230":73850,"_5":31585,"_21622":123555,"_28406":123556,"_3086":123557},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3696":73869,"_31230":73850,"_5":31585,"_21622":123559,"_28406":123560,"_3086":123561},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3696":73870,"_31230":73850,"_21622":123563,"_5":14887,"_28406":73850,"_3086":123564},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3696":73871,"_31230":73850,"_21622":123566,"_5":14887,"_28406":123496,"_3086":123567},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3696":73872,"_31230":73850,"_21622":123569,"_5":14887,"_28406":123496,"_3086":123570},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3696":73873,"_31230":73850,"_21622":123572,"_5":14887,"_28406":123503,"_3086":123573},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3696":73874,"_31230":73850,"_21622":123575,"_5":14887,"_28406":123507,"_3086":123576},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3696":73875,"_31230":73850,"_21622":123578,"_5":14887,"_28406":123511,"_3086":123579},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3696":73876,"_31230":73850,"_21622":123581,"_5":14887,"_28406":123515,"_3086":123582},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3696":73877,"_31230":73850,"_21622":123584,"_5":14887,"_28406":123519,"_3086":123585},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3696":73878,"_31230":73850,"_21622":123587,"_5":14887,"_28406":123527,"_3086":123588},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3696":73879,"_31230":73850,"_21622":123590,"_5":14887,"_28406":123527,"_3086":123591},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3696":73880,"_31230":73850,"_21622":123593,"_5":14887,"_28406":123530,"_3086":123594},[],"Campo de `settings.enrollment_settings`",{"_3696":73881,"_31230":73850,"_21622":123596,"_5":14887,"_28406":123530,"_3086":123597},[],"Decisión",{"_3696":73882,"_31230":73850,"_21622":123599,"_5":14887,"_28406":123530,"_3086":54138},[],{"_3696":73883,"_31230":73850,"_21622":123601,"_5":14887,"_28406":123530,"_3086":123602},[],"`EST_RFC7030` para estas operaciones.",{"_3696":73884,"_31230":73850,"_21622":123604,"_5":14887,"_28406":123530,"_3086":54144},[],{"_3696":73885,"_31230":73850,"_21622":123606,"_5":14887,"_28406":123530,"_3086":123607},[],"ID de la CA que firmará.",{"_3696":73886,"_31230":73850,"_21622":123609,"_5":14887,"_28406":123530,"_3086":54150},[],{"_3696":73887,"_31230":73850,"_21622":123611,"_5":14887,"_28406":123530,"_3086":123612},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3696":73888,"_31230":73850,"_21622":123614,"_5":14887,"_28406":123530,"_3086":54156},[],{"_3696":73889,"_31230":73850,"_21622":123616,"_5":14887,"_28406":123530,"_3086":123617},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3696":73890,"_31230":73850,"_21622":123619,"_5":14887,"_28406":123530,"_3086":54162},[],{"_3696":73891,"_31230":73850,"_21622":123621,"_5":14887,"_28406":123530,"_3086":123622},[],"Uno de los cuatro modos de autenticación.",{"_3696":73892,"_31230":73850,"_21622":123624,"_5":14887,"_28406":123530,"_3086":123625},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3696":73893,"_31230":73850,"_21622":123627,"_5":14887,"_28406":123533,"_3086":123628},[],"Los bloques son independientes:",{"_3696":73894,"_31230":73850,"_21622":123630,"_5":14887,"_28406":123533,"_3086":123631},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3696":73895,"_31230":73850,"_21622":123633,"_5":14887,"_28406":123533,"_3086":123634},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3696":73896,"_31230":73850,"_21622":123636,"_5":14887,"_28406":123533,"_3086":54180},[],{"_3696":73897,"_31230":73850,"_21622":123638,"_5":14887,"_28406":123533,"_3086":123639},[],"Control aplicado en la operación configurada",{"_3696":73898,"_31230":73850,"_21622":123641,"_5":14887,"_28406":123533,"_3086":54186},[],{"_3696":73899,"_31230":73850,"_21622":123643,"_5":14887,"_28406":123533,"_3086":123644},[],"Validación del certificado presentado.",{"_3696":73900,"_31230":73850,"_21622":123646,"_5":14887,"_28406":123533,"_3086":54192},[],{"_3696":73901,"_31230":73850,"_21622":123648,"_5":14887,"_28406":123533,"_3086":123649},[],"Autorización del webhook configurado.",{"_3696":73902,"_31230":73850,"_21622":123651,"_5":14887,"_28406":123533,"_3086":54198},[],{"_3696":73903,"_31230":73850,"_21622":123653,"_5":14887,"_28406":123533,"_3086":123654},[],"Validación del certificado y, después, aprobación del webhook.",{"_3696":73904,"_31230":73850,"_21622":123656,"_5":14887,"_28406":123533,"_3086":54204},[],{"_3696":73905,"_31230":73850,"_21622":123658,"_5":14887,"_28406":123533,"_3086":123659},[],"Sin autenticación del solicitante por el DMS.",{"_3696":73906,"_31230":73850,"_21622":123661,"_5":14887,"_28406":123533,"_3086":123662},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3696":73907,"_31230":73850,"_21622":123664,"_5":14887,"_28406":123533,"_3086":123665},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3696":73908,"_31230":73850,"_21622":123667,"_5":14887,"_28406":123533,"_3086":123668},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3696":73909,"_31230":73850,"_21622":123670,"_5":14887,"_28406":123533,"_3086":123671},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3696":73910,"_31230":73850,"_21622":123673,"_5":14887,"_28406":123533,"_3086":123674},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3696":73911,"_31230":73850,"_21622":123676,"_5":14887,"_28406":123537,"_3086":123677},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3696":73912,"_31230":73850,"_21622":123679,"_5":14887,"_28406":123537,"_3086":123680},[],"Campo de `external_webhook_settings`",{"_3696":73913,"_31230":73850,"_21622":123682,"_5":14887,"_28406":123537,"_3086":123597},[],{"_3696":73914,"_31230":73850,"_21622":123684,"_5":14887,"_28406":123537,"_3086":54233},[],{"_3696":73915,"_31230":73850,"_21622":123686,"_5":14887,"_28406":123537,"_3086":123687},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3696":73916,"_31230":73850,"_21622":123689,"_5":14887,"_28406":123537,"_3086":54239},[],{"_3696":73917,"_31230":73850,"_21622":123691,"_5":14887,"_28406":123537,"_3086":123692},[],"`POST` o `PUT`; `POST` por defecto.",{"_3696":73918,"_31230":73850,"_21622":123694,"_5":14887,"_28406":123537,"_3086":54245},[],{"_3696":73919,"_31230":73850,"_21622":123696,"_5":14887,"_28406":123537,"_3086":123697},[],"Etiqueta usada en los logs del servicio.",{"_3696":73920,"_31230":73850,"_21622":123699,"_5":14887,"_28406":123537,"_3086":54251},[],{"_3696":73921,"_31230":73850,"_21622":123701,"_5":14887,"_28406":123537,"_3086":123702},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3696":73922,"_31230":73850,"_21622":123704,"_5":14887,"_28406":123537,"_3086":54257},[],{"_3696":73923,"_31230":73850,"_21622":123706,"_5":14887,"_28406":123537,"_3086":123707},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3696":73924,"_31230":73850,"_21622":123709,"_5":14887,"_28406":123537,"_3086":54263},[],{"_3696":73925,"_31230":73850,"_21622":123711,"_5":14887,"_28406":123537,"_3086":123712},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3696":73926,"_31230":73850,"_21622":123714,"_5":14887,"_28406":123537,"_3086":54269},[],{"_3696":73927,"_31230":73850,"_21622":123716,"_5":14887,"_28406":123537,"_3086":123717},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3696":73928,"_31230":73850,"_21622":123719,"_5":14887,"_28406":123537,"_3086":54275},[],{"_3696":73929,"_31230":73850,"_21622":123721,"_5":14887,"_28406":123537,"_3086":123722},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3696":73930,"_31230":73850,"_21622":123724,"_5":14887,"_28406":123537,"_3086":54281},[],{"_3696":73931,"_31230":73850,"_21622":123726,"_5":14887,"_28406":123537,"_3086":123727},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3696":73932,"_31230":73850,"_21622":123729,"_5":14887,"_28406":123537,"_3086":54287},[],{"_3696":73933,"_31230":73850,"_21622":123731,"_5":14887,"_28406":123537,"_3086":123732},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3696":73934,"_31230":73850,"_21622":123734,"_5":14887,"_28406":123537,"_3086":123735},[],"Reglas de esa configuración:",{"_3696":73935,"_31230":73850,"_21622":123737,"_5":14887,"_28406":123537,"_3086":123738},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3696":73936,"_31230":73850,"_21622":123740,"_5":14887,"_28406":123537,"_3086":123741},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3696":73937,"_31230":73850,"_21622":123743,"_5":14887,"_28406":123537,"_3086":123744},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3696":73938,"_31230":73850,"_21622":123746,"_5":14887,"_28406":123537,"_3086":123747},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3696":73939,"_31230":73850,"_21622":123749,"_5":14887,"_28406":123537,"_3086":123750},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3696":73940,"_31230":73850,"_21622":123752,"_5":14887,"_28406":123537,"_3086":123753},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3696":73941,"_31230":73850,"_21622":123755,"_5":14887,"_28406":123537,"_3086":123756},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3696":73942,"_31230":73850,"_21622":123758,"_5":14887,"_28406":123537,"_3086":123759},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3696":73943,"_31230":73850,"_21622":123761,"_5":14887,"_28406":123537,"_3086":123762},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3696":73944,"_31230":73850,"_21622":123764,"_5":14887,"_28406":123541,"_3086":123765},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3696":73945,"_31230":73850,"_21622":123767,"_5":14887,"_28406":123545,"_3086":123768},[],"Campo de `settings.reenrollment_settings`",{"_3696":73946,"_31230":73850,"_21622":123770,"_5":14887,"_28406":123545,"_3086":123771},[],"Función",{"_3696":73947,"_31230":73850,"_21622":123773,"_5":14887,"_28406":123545,"_3086":54331},[],{"_3696":73948,"_31230":73850,"_21622":123775,"_5":14887,"_28406":123545,"_3086":123776},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3696":73949,"_31230":73850,"_21622":123778,"_5":14887,"_28406":123545,"_3086":54337},[],{"_3696":73950,"_31230":73850,"_21622":123780,"_5":14887,"_28406":123545,"_3086":123781},[],"Umbral operativo preventivo de monitorización.",{"_3696":73951,"_31230":73850,"_21622":123783,"_5":14887,"_28406":123545,"_3086":54343},[],{"_3696":73952,"_31230":73850,"_21622":123785,"_5":14887,"_28406":123545,"_3086":123786},[],"Umbral operativo crítico de monitorización.",{"_3696":73953,"_31230":73850,"_21622":123788,"_5":14887,"_28406":123545,"_3086":54349},[],{"_3696":73954,"_31230":73850,"_21622":123790,"_5":14887,"_28406":123545,"_3086":123791},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3696":73955,"_31230":73850,"_21622":123793,"_5":14887,"_28406":123545,"_3086":54355},[],{"_3696":73956,"_31230":73850,"_21622":123795,"_5":14887,"_28406":123545,"_3086":123796},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3696":73957,"_31230":73850,"_21622":123798,"_5":14887,"_28406":123545,"_3086":54361},[],{"_3696":73958,"_31230":73850,"_21622":123800,"_5":14887,"_28406":123545,"_3086":123801},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3696":73959,"_31230":73850,"_21622":123803,"_5":14887,"_28406":123545,"_3086":123804},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3696":73960,"_31230":73850,"_21622":123806,"_5":14887,"_28406":123549,"_3086":123807},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3696":73961,"_31230":73850,"_21622":123809,"_5":14887,"_28406":123552,"_3086":120973},[],{"_3696":73962,"_31230":73850,"_21622":123811,"_5":14887,"_28406":123552,"_3086":123812},[],"Qué publica",{"_3696":73963,"_31230":73850,"_21622":123814,"_5":14887,"_28406":123552,"_3086":54378},[],{"_3696":73964,"_31230":73850,"_21622":123816,"_5":14887,"_28406":123552,"_3086":123817},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3696":73965,"_31230":73850,"_21622":123819,"_5":14887,"_28406":123552,"_3086":54384},[],{"_3696":73966,"_31230":73850,"_21622":123821,"_5":14887,"_28406":123552,"_3086":123822},[],"Certificado de la CA emisora seleccionada.",{"_3696":73967,"_31230":73850,"_21622":123824,"_5":14887,"_28406":123552,"_3086":54390},[],{"_3696":73968,"_31230":73850,"_21622":123826,"_5":14887,"_28406":123552,"_3086":123827},[],"Certificados de las CAs elegidas explícitamente.",{"_3696":73969,"_31230":73850,"_21622":123829,"_5":14887,"_28406":123552,"_3086":123830},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3696":73970,"_31230":73850,"_21622":123832,"_5":14887,"_28406":123556,"_3086":123833},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3696":73971,"_31230":73850,"_21622":123835,"_5":14887,"_28406":123556,"_3086":123836},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3696":73972,"_31230":73850,"_21622":123838,"_5":14887,"_28406":123556,"_3086":123839},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3696":73973,"_31230":73850,"_21622":123841,"_5":14887,"_28406":123560,"_3086":123842},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3696":73974,"_31230":73974,"_5":15247,"_3086":123844,"_31588":123845,"_21622":123846,"_28406":73974},"Integra el cliente EST",[51065,122085,53759,123230,123408],[],{"_3696":73975,"_31230":73974,"_21622":123848,"_5":14887,"_28406":73974,"_3086":123849},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3696":73976,"_31230":73974,"_5":31585,"_21622":123851,"_28406":123852,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3696":73977,"_31230":73974,"_5":31585,"_21622":123854,"_28406":123855,"_3086":123856},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3696":73978,"_31230":73974,"_5":31585,"_21622":123858,"_28406":123859,"_3086":123860},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3696":73979,"_31230":73974,"_5":31585,"_21622":123862,"_28406":123863,"_3086":123864},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3696":73980,"_31230":73974,"_5":31585,"_21622":123866,"_28406":123867,"_3086":123868},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3696":73981,"_31230":73974,"_5":31585,"_21622":123870,"_28406":123871,"_3086":123872},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3696":73982,"_31230":73974,"_21622":123874,"_5":14887,"_28406":73974,"_3086":123875},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3696":73983,"_31230":73974,"_21622":123877,"_5":14887,"_28406":123852,"_3086":123878},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3696":73984,"_31230":73974,"_21622":123880,"_5":14887,"_28406":123852,"_3086":123881},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3696":73985,"_31230":73974,"_21622":123883,"_5":14887,"_28406":123852,"_3086":123884},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3696":73986,"_31230":73974,"_21622":123886,"_5":14887,"_28406":123855,"_3086":123887},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3696":73987,"_31230":73974,"_21622":123889,"_5":14887,"_28406":123855,"_3086":123890},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3696":73988,"_31230":73974,"_21622":123892,"_5":14887,"_28406":123859,"_3086":123893},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3696":73989,"_31230":73974,"_21622":123895,"_5":14887,"_28406":123859,"_3086":123896},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3696":73990,"_31230":73974,"_21622":123898,"_5":14887,"_28406":123863,"_3086":123899},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3696":73991,"_31230":73974,"_21622":123901,"_5":14887,"_28406":123863,"_3086":123902},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3696":73992,"_31230":73974,"_21622":123904,"_5":14887,"_28406":123867,"_3086":123905},[],"Para el caso de una raíz que emite directamente:",{"_3696":73993,"_31230":73974,"_21622":123907,"_5":14887,"_28406":123867,"_3086":123908},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3696":73994,"_31230":73974,"_21622":123910,"_5":14887,"_28406":123867,"_3086":123911},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3696":73995,"_31230":73974,"_21622":123913,"_5":14887,"_28406":123871,"_3086":123914},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3696":73996,"_31230":73996,"_5":15247,"_3086":123916,"_31588":123917,"_21622":123918,"_28406":73996},"Referencia EST",[51065,122085,53759,123230,123408],[],{"_3696":73997,"_31230":73996,"_21622":123920,"_5":14887,"_28406":73996,"_3086":123921},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3696":73998,"_31230":73996,"_5":31585,"_21622":123923,"_28406":123924,"_3086":123925},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3696":73999,"_31230":73996,"_5":31585,"_21622":123927,"_28406":123928,"_3086":23425},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3696":74000,"_31230":73996,"_5":31585,"_21622":123930,"_28406":123931,"_3086":26940},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3696":74001,"_31230":73996,"_5":31585,"_21622":123933,"_28406":123934,"_3086":26947},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3696":74002,"_31230":73996,"_5":31585,"_21622":123936,"_28406":123937,"_3086":26209},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3696":74003,"_31230":73996,"_5":31585,"_21622":123939,"_28406":123940,"_3086":123941},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3696":74004,"_31230":73996,"_5":31585,"_21622":123943,"_28406":123944,"_3086":123945},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3696":74005,"_31230":73996,"_5":31585,"_21622":123947,"_28406":123948,"_3086":123949},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3696":74006,"_31230":73996,"_21622":123951,"_5":14887,"_28406":73996,"_3086":123952},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3696":74007,"_31230":73996,"_21622":123954,"_5":14887,"_28406":123924,"_3086":123955},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3696":74008,"_31230":73996,"_21622":123957,"_5":14887,"_28406":123924,"_3086":121845},[],{"_3696":74009,"_31230":73996,"_21622":123959,"_5":14887,"_28406":123924,"_3086":123960},[],"Método",{"_3696":74010,"_31230":73996,"_21622":123962,"_5":14887,"_28406":123924,"_3086":123963},[],"Autenticación y condición",{"_3696":74011,"_31230":73996,"_21622":123965,"_5":14887,"_28406":123924,"_3086":54533},[],{"_3696":74012,"_31230":73996,"_21622":123967,"_5":14887,"_28406":123924,"_3086":54536},[],{"_3696":74013,"_31230":73996,"_21622":123969,"_5":14887,"_28406":123924,"_3086":123970},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3696":74014,"_31230":73996,"_21622":123972,"_5":14887,"_28406":123924,"_3086":54542},[],{"_3696":74015,"_31230":73996,"_21622":123974,"_5":14887,"_28406":123924,"_3086":54545},[],{"_3696":74016,"_31230":73996,"_21622":123976,"_5":14887,"_28406":123924,"_3086":123977},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3696":74017,"_31230":73996,"_21622":123979,"_5":14887,"_28406":123924,"_3086":54551},[],{"_3696":74018,"_31230":73996,"_21622":123981,"_5":14887,"_28406":123924,"_3086":54545},[],{"_3696":74019,"_31230":73996,"_21622":123983,"_5":14887,"_28406":123924,"_3086":123984},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3696":74020,"_31230":73996,"_21622":123986,"_5":14887,"_28406":123924,"_3086":54559},[],{"_3696":74021,"_31230":73996,"_21622":123988,"_5":14887,"_28406":123924,"_3086":54545},[],{"_3696":74022,"_31230":73996,"_21622":123990,"_5":14887,"_28406":123924,"_3086":123991},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3696":74023,"_31230":73996,"_21622":123993,"_5":14887,"_28406":123924,"_3086":123994},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3696":74024,"_31230":73996,"_21622":123996,"_5":14887,"_28406":123928,"_3086":123997},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3696":74025,"_31230":73996,"_21622":123999,"_5":14887,"_28406":123928,"_3086":124000},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3696":74026,"_31230":73996,"_21622":124002,"_5":14887,"_28406":123931,"_3086":124003},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3696":74027,"_31230":73996,"_21622":124005,"_5":14887,"_28406":123931,"_3086":124006},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3696":74028,"_31230":73996,"_21622":124008,"_5":14887,"_28406":123934,"_3086":124009},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3696":74029,"_31230":73996,"_21622":124011,"_5":14887,"_28406":123934,"_3086":124012},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3696":74030,"_31230":73996,"_21622":124014,"_5":14887,"_28406":123937,"_3086":124015},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3696":74031,"_31230":73996,"_21622":124017,"_5":14887,"_28406":123937,"_3086":124018},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3696":74032,"_31230":73996,"_21622":124020,"_5":14887,"_28406":123940,"_3086":124021},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3696":74033,"_31230":73996,"_21622":124023,"_5":14887,"_28406":123940,"_3086":124024},[],"Parte",{"_3696":74034,"_31230":73996,"_21622":124026,"_5":14887,"_28406":123940,"_3086":124027},[],"Contenido tras decodificar su Base64",{"_3696":74035,"_31230":73996,"_21622":124029,"_5":14887,"_28406":123940,"_3086":54603},[],{"_3696":74036,"_31230":73996,"_21622":124031,"_5":14887,"_28406":123940,"_3086":124032},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3696":74037,"_31230":73996,"_21622":124034,"_5":14887,"_28406":123940,"_3086":54609},[],{"_3696":74038,"_31230":73996,"_21622":124036,"_5":14887,"_28406":123940,"_3086":124037},[],"PKCS#7 DER con el certificado emitido.",{"_3696":74039,"_31230":73996,"_21622":124039,"_5":14887,"_28406":123940,"_3086":124040},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3696":74040,"_31230":73996,"_21622":124042,"_5":14887,"_28406":123944,"_3086":124043},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3696":74041,"_31230":73996,"_21622":124045,"_5":14887,"_28406":123944,"_3086":124046},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3696":74042,"_31230":73996,"_21622":124048,"_5":14887,"_28406":123944,"_3086":124049},[],"Convierte y comprueba el resultado:",{"_3696":74043,"_31230":73996,"_21622":124051,"_5":14887,"_28406":123944,"_3086":124052},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3696":74044,"_31230":73996,"_21622":124054,"_5":14887,"_28406":123948,"_3086":124055},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3696":74045,"_31230":73996,"_21622":124057,"_5":14887,"_28406":123948,"_3086":124058},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3696":74046,"_31230":74046,"_5":15247,"_3086":123408,"_31588":124060,"_21622":124061,"_28406":74046},[51065,122085,53759,123230,123408],[],{"_3696":74047,"_31230":74046,"_21622":124063,"_5":14887,"_28406":74046,"_3086":124064},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3696":74048,"_31230":74046,"_5":31585,"_21622":124066,"_28406":124067,"_3086":124068},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3696":74049,"_31230":74046,"_5":31585,"_21622":124070,"_28406":124071,"_3086":124072},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3696":74050,"_31230":74046,"_5":31585,"_21622":124074,"_28406":124075,"_3086":124076},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3696":74051,"_31230":74046,"_21622":124078,"_5":14887,"_28406":74046,"_3086":124079},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3696":74052,"_31230":74046,"_21622":124081,"_5":14887,"_28406":124067,"_3086":124082},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3696":74053,"_31230":74046,"_21622":124084,"_5":14887,"_28406":124067,"_3086":124085},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3696":74054,"_31230":74046,"_21622":124087,"_5":14887,"_28406":124067,"_3086":124088},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3696":74055,"_31230":74046,"_21622":124090,"_5":14887,"_28406":124067,"_3086":124091},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3696":74056,"_31230":74046,"_21622":124093,"_5":14887,"_28406":124067,"_3086":124094},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3696":74057,"_31230":74046,"_21622":124096,"_5":14887,"_28406":124067,"_3086":124097},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3696":74058,"_31230":74046,"_21622":124099,"_5":14887,"_28406":124071,"_3086":124100},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3696":74059,"_31230":74046,"_21622":124102,"_5":14887,"_28406":124071,"_3086":124103},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3696":74060,"_31230":74046,"_21622":124105,"_5":14887,"_28406":124071,"_3086":124106},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3696":74061,"_31230":74046,"_21622":124108,"_5":14887,"_28406":124071,"_3086":124109},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3696":74062,"_31230":74046,"_21622":124111,"_5":14887,"_28406":124075,"_3086":124112},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3696":74063,"_31230":74046,"_21622":124114,"_5":14887,"_28406":124075,"_3086":124115},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3696":74064,"_31230":74046,"_21622":124117,"_5":14887,"_28406":124075,"_3086":124118},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3696":74065,"_31230":74046,"_21622":124120,"_5":14887,"_28406":124075,"_3086":124121},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3696":74066,"_31230":74046,"_21622":124123,"_5":14887,"_28406":124075,"_3086":124124},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3696":74067,"_31230":74067,"_5":15247,"_3086":124126,"_31588":124127,"_21622":124128,"_28406":74067},"Estrategias de aprovisionamiento",[51065,122085,53759,123230,123408],[],{"_3696":74068,"_31230":74067,"_21622":124130,"_5":14887,"_28406":74067,"_3086":124131},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3696":74069,"_31230":74067,"_5":31585,"_21622":124133,"_28406":124134,"_3086":124135},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3696":74070,"_31230":74067,"_5":31585,"_21622":124137,"_28406":124138,"_3086":124139},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3696":74071,"_31230":74067,"_5":31585,"_21622":124141,"_28406":124142,"_3086":124143},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3696":74072,"_31230":74067,"_5":31585,"_21622":124145,"_28406":124146,"_3086":124147},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3696":74073,"_31230":74067,"_5":31585,"_21622":124149,"_28406":124150,"_3086":124151},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3696":74074,"_31230":74067,"_21622":124153,"_5":14887,"_28406":74067,"_3086":124154},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3696":74075,"_31230":74067,"_21622":124156,"_5":14887,"_28406":124134,"_3086":124157},[],"Recorrido",{"_3696":74076,"_31230":74067,"_21622":124159,"_5":14887,"_28406":124134,"_3086":124160},[],"Cuándo existe el dispositivo",{"_3696":74077,"_31230":74067,"_21622":124162,"_5":14887,"_28406":124134,"_3086":124163},[],"Qué compruebas",{"_3696":74078,"_31230":74067,"_21622":124165,"_5":14887,"_28406":124134,"_3086":124166},[],"Asignación manual",{"_3696":74079,"_31230":74067,"_21622":124168,"_5":14887,"_28406":124134,"_3086":124169},[],"El operador lo crea antes de asociar un certificado.",{"_3696":74080,"_31230":74067,"_21622":124171,"_5":14887,"_28406":124134,"_3086":124172},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3696":74081,"_31230":74067,"_21622":124174,"_5":14887,"_28406":124134,"_3086":124175},[],"EST con `JITP`",{"_3696":74082,"_31230":74067,"_21622":124177,"_5":14887,"_28406":124134,"_3086":124178},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3696":74083,"_31230":74067,"_21622":124180,"_5":14887,"_28406":124134,"_3086":124181},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3696":74084,"_31230":74067,"_21622":124183,"_5":14887,"_28406":124134,"_3086":124184},[],"EST con `PRE_REGISTRATION`",{"_3696":74085,"_31230":74067,"_21622":124186,"_5":14887,"_28406":124134,"_3086":124187},[],"Debe existir antes de `/simpleenroll`.",{"_3696":74086,"_31230":74067,"_21622":124189,"_5":14887,"_28406":124134,"_3086":124190},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3696":74087,"_31230":74067,"_21622":124192,"_5":14887,"_28406":124134,"_3086":124193},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3696":74088,"_31230":74067,"_21622":124195,"_5":14887,"_28406":124134,"_3086":124196},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3696":74089,"_31230":74067,"_21622":124198,"_5":14887,"_28406":124138,"_3086":124199},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3696":74090,"_31230":74067,"_21622":124201,"_5":14887,"_28406":124138,"_3086":124202},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3696":74091,"_31230":74067,"_21622":124204,"_5":14887,"_28406":124138,"_3086":124205},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3696":74092,"_31230":74067,"_21622":124207,"_5":14887,"_28406":124142,"_3086":124208},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3696":74093,"_31230":74067,"_21622":124210,"_5":14887,"_28406":124142,"_3086":124211},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3696":74094,"_31230":74067,"_21622":124213,"_5":14887,"_28406":124142,"_3086":124214},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3696":74095,"_31230":74067,"_21622":124216,"_5":14887,"_28406":124142,"_3086":124217},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3696":74096,"_31230":74067,"_21622":124219,"_5":14887,"_28406":124142,"_3086":124220},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3696":74097,"_31230":74067,"_21622":124222,"_5":14887,"_28406":124142,"_3086":124223},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3696":74098,"_31230":74067,"_21622":124225,"_5":14887,"_28406":124146,"_3086":120973},[],{"_3696":74099,"_31230":74067,"_21622":124227,"_5":14887,"_28406":124146,"_3086":124228},[],"Material que atraviesa EST",{"_3696":74100,"_31230":74067,"_21622":124230,"_5":14887,"_28406":124146,"_3086":124231},[],"Clave generada por el dispositivo",{"_3696":74101,"_31230":74067,"_21622":124233,"_5":14887,"_28406":124146,"_3086":124234},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3696":74102,"_31230":74067,"_21622":124236,"_5":14887,"_28406":124146,"_3086":124237},[],"Clave ya disponible en el dispositivo",{"_3696":74103,"_31230":74067,"_21622":124239,"_5":14887,"_28406":124146,"_3086":124240},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3696":74104,"_31230":74067,"_21622":124242,"_5":14887,"_28406":124146,"_3086":54087},[],{"_3696":74105,"_31230":74067,"_21622":124244,"_5":14887,"_28406":124146,"_3086":124245},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3696":74106,"_31230":74067,"_21622":124247,"_5":14887,"_28406":124146,"_3086":124248},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3696":74107,"_31230":74067,"_21622":124250,"_5":14887,"_28406":124150,"_3086":124251},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3696":74108,"_31230":74108,"_5":15247,"_3086":124253,"_31588":124254,"_21622":124255,"_28406":74108},"Renovación y recuperación",[51065,122085,53759,123230,123408],[],{"_3696":74109,"_31230":74108,"_21622":124257,"_5":14887,"_28406":74108,"_3086":124258},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3696":74110,"_31230":74108,"_5":31585,"_21622":124260,"_28406":124261,"_3086":124262},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3696":74111,"_31230":74108,"_5":31585,"_21622":124264,"_28406":124265,"_3086":124266},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3696":74112,"_31230":74108,"_5":31585,"_21622":124268,"_28406":124269,"_3086":124270},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3696":74113,"_31230":74108,"_5":31585,"_21622":124272,"_28406":124273,"_3086":124274},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3696":74114,"_31230":74108,"_5":31585,"_21622":124276,"_28406":124277,"_3086":124278},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3696":74115,"_31230":74108,"_21622":124280,"_5":14887,"_28406":74108,"_3086":124281},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3696":74116,"_31230":74108,"_21622":124283,"_5":14887,"_28406":124261,"_3086":124284},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3696":74117,"_31230":74108,"_21622":124286,"_5":14887,"_28406":124261,"_3086":124287},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3696":74118,"_31230":74108,"_21622":124289,"_5":14887,"_28406":124261,"_3086":124290},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3696":74119,"_31230":74108,"_21622":124292,"_5":14887,"_28406":124261,"_3086":124293},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3696":74120,"_31230":74108,"_21622":124295,"_5":14887,"_28406":124265,"_3086":124296},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3696":74121,"_31230":74108,"_21622":124298,"_5":14887,"_28406":124265,"_3086":124299},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3696":74122,"_31230":74108,"_21622":124301,"_5":14887,"_28406":124269,"_3086":124302},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3696":74123,"_31230":74108,"_21622":124304,"_5":14887,"_28406":124269,"_3086":124305},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3696":74124,"_31230":74108,"_21622":124307,"_5":14887,"_28406":124269,"_3086":124308},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3696":74125,"_31230":74108,"_21622":124310,"_5":14887,"_28406":124273,"_3086":124311},[],"Situación",{"_3696":74126,"_31230":74108,"_21622":124313,"_5":14887,"_28406":124273,"_3086":124314},[],"Procedimiento",{"_3696":74127,"_31230":74108,"_21622":124316,"_5":14887,"_28406":124273,"_3086":124317},[],"Certificado vigente, fuera de ventana",{"_3696":74128,"_31230":74108,"_21622":124319,"_5":14887,"_28406":124273,"_3086":124320},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3696":74129,"_31230":74108,"_21622":124322,"_5":14887,"_28406":124273,"_3086":124323},[],"Certificado vencido, clave disponible",{"_3696":74130,"_31230":74108,"_21622":124325,"_5":14887,"_28406":124273,"_3086":124326},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3696":74131,"_31230":74108,"_21622":124328,"_5":14887,"_28406":124273,"_3086":124329},[],"Renovación por webhook o `NO_AUTH`",{"_3696":74132,"_31230":74108,"_21622":124331,"_5":14887,"_28406":124273,"_3086":124332},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3696":74133,"_31230":74108,"_21622":124334,"_5":14887,"_28406":124273,"_3086":124335},[],"Clave perdida o inaccesible",{"_3696":74134,"_31230":74108,"_21622":124337,"_5":14887,"_28406":124273,"_3086":124338},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3696":74135,"_31230":74108,"_21622":124340,"_5":14887,"_28406":124273,"_3086":124341},[],"Identidad actual revocada",{"_3696":74136,"_31230":74108,"_21622":124343,"_5":14887,"_28406":124273,"_3086":124344},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3696":74137,"_31230":74108,"_21622":124346,"_5":14887,"_28406":124273,"_3086":124347},[],"Dispositivo sin identidad",{"_3696":74138,"_31230":74108,"_21622":124349,"_5":14887,"_28406":124273,"_3086":124350},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3696":74139,"_31230":74108,"_21622":124352,"_5":14887,"_28406":124273,"_3086":124353},[],"Dispositivo retirado",{"_3696":74140,"_31230":74108,"_21622":124355,"_5":14887,"_28406":124273,"_3086":124356},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3696":74141,"_31230":74108,"_21622":124358,"_5":14887,"_28406":124273,"_3086":124359},[],"Timeout, HTTP 500 o fallo de instalación",{"_3696":74142,"_31230":74108,"_21622":124361,"_5":14887,"_28406":124273,"_3086":124362},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3696":74143,"_31230":74108,"_21622":124364,"_5":14887,"_28406":124277,"_3086":124365},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3696":74144,"_31230":74108,"_21622":124367,"_5":14887,"_28406":124277,"_3086":124368},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3696":74145,"_31230":74145,"_5":15247,"_3086":124370,"_31588":124371,"_21622":124372,"_28406":74145},"Diagnóstico de enrolamiento",[51065,122085,53759,123230,123408],[],{"_3696":74146,"_31230":74145,"_21622":124374,"_5":14887,"_28406":74145,"_3086":124375},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3696":74147,"_31230":74145,"_5":31585,"_21622":124377,"_28406":124378,"_3086":124379},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3696":74148,"_31230":74145,"_5":31585,"_21622":124381,"_28406":124382,"_3086":124383},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3696":74149,"_31230":74145,"_5":31585,"_21622":124385,"_28406":124386,"_3086":123949},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3696":74150,"_31230":74145,"_5":31585,"_21622":124388,"_28406":124389,"_3086":124390},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3696":74151,"_31230":74145,"_21622":124392,"_5":14887,"_28406":74145,"_3086":124393},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3696":74152,"_31230":74145,"_21622":124395,"_5":14887,"_28406":124382,"_3086":124396},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3696":74153,"_31230":74145,"_21622":124398,"_5":14887,"_28406":124382,"_3086":124399},[],"Síntoma o mensaje",{"_3696":74154,"_31230":74145,"_21622":124401,"_5":14887,"_28406":124382,"_3086":124402},[],"Qué revisar",{"_3696":74155,"_31230":74145,"_21622":124404,"_5":14887,"_28406":124382,"_3086":124405},[],"curl rechaza TLS, nombre o emisor",{"_3696":74156,"_31230":74145,"_21622":124407,"_5":14887,"_28406":124382,"_3086":124408},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3696":74157,"_31230":74145,"_21622":124410,"_5":14887,"_28406":124382,"_3086":124411},[],"404 o APS ausente",{"_3696":74158,"_31230":74145,"_21622":124413,"_5":14887,"_28406":124382,"_3086":124414},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3696":74159,"_31230":74145,"_21622":124416,"_5":14887,"_28406":124382,"_3086":124417},[],"400, error de CSR o formato",{"_3696":74160,"_31230":74145,"_21622":124419,"_5":14887,"_28406":124382,"_3086":124420},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3696":74161,"_31230":74145,"_21622":124422,"_5":14887,"_28406":124382,"_3086":124423},[],"Credencial ausente o certificado no válido",{"_3696":74162,"_31230":74145,"_21622":124425,"_5":14887,"_28406":124382,"_3086":124426},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3696":74163,"_31230":74145,"_21622":124428,"_5":14887,"_28406":124382,"_3086":124429},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3696":74164,"_31230":74145,"_21622":124431,"_5":14887,"_28406":124382,"_3086":124432},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3696":74165,"_31230":74145,"_21622":124434,"_5":14887,"_28406":124382,"_3086":124435},[],"Webhook deniega, expira o responde sin autorización",{"_3696":74166,"_31230":74145,"_21622":124437,"_5":14887,"_28406":124382,"_3086":124438},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3696":74167,"_31230":74145,"_21622":124440,"_5":14887,"_28406":124382,"_3086":55015},[],{"_3696":74168,"_31230":74145,"_21622":124442,"_5":14887,"_28406":124382,"_3086":124443},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3696":74169,"_31230":74145,"_21622":124445,"_5":14887,"_28406":124382,"_3086":55021},[],{"_3696":74170,"_31230":74145,"_21622":124447,"_5":14887,"_28406":124382,"_3086":124448},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3696":74171,"_31230":74145,"_21622":124450,"_5":14887,"_28406":124382,"_3086":55027},[],{"_3696":74172,"_31230":74145,"_21622":124452,"_5":14887,"_28406":124382,"_3086":124453},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3696":74173,"_31230":74145,"_21622":124455,"_5":14887,"_28406":124382,"_3086":55033},[],{"_3696":74174,"_31230":74145,"_21622":124457,"_5":14887,"_28406":124382,"_3086":124458},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3696":74175,"_31230":74145,"_21622":124460,"_5":14887,"_28406":124382,"_3086":55039},[],{"_3696":74176,"_31230":74145,"_21622":124462,"_5":14887,"_28406":124382,"_3086":124463},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3696":74177,"_31230":74145,"_21622":124465,"_5":14887,"_28406":124382,"_3086":124466},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3696":74178,"_31230":74145,"_21622":124468,"_5":14887,"_28406":124382,"_3086":124469},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3696":74179,"_31230":74145,"_21622":124471,"_5":14887,"_28406":124382,"_3086":124472},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3696":74180,"_31230":74145,"_21622":124474,"_5":14887,"_28406":124382,"_3086":124475},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3696":74181,"_31230":74145,"_21622":124477,"_5":14887,"_28406":124382,"_3086":55057},[],{"_3696":74182,"_31230":74145,"_21622":124479,"_5":14887,"_28406":124382,"_3086":124480},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3696":74183,"_31230":74145,"_21622":124482,"_5":14887,"_28406":124382,"_3086":55063},[],{"_3696":74184,"_31230":74145,"_21622":124484,"_5":14887,"_28406":124382,"_3086":124485},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3696":74185,"_31230":74145,"_21622":124487,"_5":14887,"_28406":124382,"_3086":124488},[],"DMS propietario distinto",{"_3696":74186,"_31230":74145,"_21622":124490,"_5":14887,"_28406":124382,"_3086":124491},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3696":74187,"_31230":74145,"_21622":124493,"_5":14887,"_28406":124382,"_3086":55075},[],{"_3696":74188,"_31230":74145,"_21622":124495,"_5":14887,"_28406":124382,"_3086":124496},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3696":74189,"_31230":74145,"_21622":124498,"_5":14887,"_28406":124382,"_3086":55081},[],{"_3696":74190,"_31230":74145,"_21622":124500,"_5":14887,"_28406":124382,"_3086":124501},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3696":74191,"_31230":74145,"_21622":124503,"_5":14887,"_28406":124382,"_3086":124504},[],"Certificado actual revocado",{"_3696":74192,"_31230":74145,"_21622":124506,"_5":14887,"_28406":124382,"_3086":124507},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3696":74193,"_31230":74145,"_21622":124509,"_5":14887,"_28406":124382,"_3086":124510},[],"Error de CA, perfil o firma",{"_3696":74194,"_31230":74145,"_21622":124512,"_5":14887,"_28406":124382,"_3086":124513},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3696":74195,"_31230":74145,"_21622":124515,"_5":14887,"_28406":124382,"_3086":124516},[],"HTTP 200 sin conexión del dispositivo",{"_3696":74196,"_31230":74145,"_21622":124518,"_5":14887,"_28406":124382,"_3086":124519},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3696":74197,"_31230":74145,"_21622":124521,"_5":14887,"_28406":124382,"_3086":124522},[],"Timeout o error después de emitir",{"_3696":74198,"_31230":74145,"_21622":124524,"_5":14887,"_28406":124382,"_3086":124525},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3696":74199,"_31230":74145,"_21622":124527,"_5":14887,"_28406":124386,"_3086":124528},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3696":74200,"_31230":74145,"_21622":124530,"_5":14887,"_28406":124386,"_3086":124531},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3696":74201,"_31230":74145,"_21622":124533,"_5":14887,"_28406":124389,"_3086":124534},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3696":74202,"_31230":74145,"_21622":124536,"_5":14887,"_28406":124389,"_3086":124537},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3696":74203,"_31230":74145,"_21622":124539,"_5":14887,"_28406":124389,"_3086":124540},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3696":74204,"_31230":74145,"_21622":124542,"_5":14887,"_28406":124389,"_3086":124543},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3696":74205,"_31230":74145,"_21622":124545,"_5":14887,"_28406":124389,"_3086":124546},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3696":74206,"_31230":74145,"_21622":124548,"_5":14887,"_28406":124389,"_3086":124549},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3696":74207,"_31230":74145,"_21622":124551,"_5":14887,"_28406":124389,"_3086":124552},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3696":74208,"_31230":74208,"_5":15247,"_3086":124554,"_31588":124555,"_21622":124556,"_28406":74208},"Distribución y actualización de confianza",[51065,122085,53759,123230,123408],[],{"_3696":74209,"_31230":74208,"_21622":124558,"_5":14887,"_28406":74208,"_3086":124559},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3696":74210,"_31230":74208,"_5":31585,"_21622":124561,"_28406":124562,"_3086":124563},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3696":74211,"_31230":74208,"_5":31585,"_21622":124565,"_28406":124566,"_3086":124567},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3696":74212,"_31230":74208,"_5":31585,"_21622":124569,"_28406":124570,"_3086":124571},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3696":74213,"_31230":74208,"_5":31585,"_21622":124573,"_28406":124574,"_3086":124575},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3696":74214,"_31230":74208,"_5":31585,"_21622":124577,"_28406":124578,"_3086":124579},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3696":74215,"_31230":74208,"_21622":124581,"_5":14887,"_28406":74208,"_3086":124582},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3696":74216,"_31230":74208,"_21622":124584,"_5":14887,"_28406":124562,"_3086":124585},[],"Relación",{"_3696":74217,"_31230":74208,"_21622":124587,"_5":14887,"_28406":124562,"_3086":124588},[],"Material que prepara el responsable",{"_3696":74218,"_31230":74208,"_21622":124590,"_5":14887,"_28406":124562,"_3086":124591},[],"Dispositivo → servidor EST",{"_3696":74219,"_31230":74208,"_21622":124593,"_5":14887,"_28406":124562,"_3086":124594},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3696":74220,"_31230":74208,"_21622":124596,"_5":14887,"_28406":124562,"_3086":124597},[],"DMS → solicitante",{"_3696":74221,"_31230":74208,"_21622":124599,"_5":14887,"_28406":124562,"_3086":124600},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3696":74222,"_31230":74208,"_21622":124602,"_5":14887,"_28406":124562,"_3086":124603},[],"Consumidor → dispositivo",{"_3696":74223,"_31230":74208,"_21622":124605,"_5":14887,"_28406":124562,"_3086":124606},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3696":74224,"_31230":74208,"_21622":124608,"_5":14887,"_28406":124562,"_3086":124609},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3696":74225,"_31230":74208,"_21622":124611,"_5":14887,"_28406":124566,"_3086":124612},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3696":74226,"_31230":74208,"_21622":124614,"_5":14887,"_28406":124566,"_3086":124615},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3696":74227,"_31230":74208,"_21622":124617,"_5":14887,"_28406":124570,"_3086":124618},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3696":74228,"_31230":74208,"_21622":124620,"_5":14887,"_28406":124570,"_3086":124621},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3696":74229,"_31230":74208,"_21622":124623,"_5":14887,"_28406":124570,"_3086":124624},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3696":74230,"_31230":74208,"_21622":124626,"_5":14887,"_28406":124570,"_3086":124627},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3696":74231,"_31230":74208,"_21622":124629,"_5":14887,"_28406":124570,"_3086":124630},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3696":74232,"_31230":74208,"_21622":124632,"_5":14887,"_28406":124570,"_3086":124633},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3696":74233,"_31230":74208,"_21622":124635,"_5":14887,"_28406":124574,"_3086":124636},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3696":74234,"_31230":74208,"_21622":124638,"_5":14887,"_28406":124574,"_3086":124639},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3696":74235,"_31230":74208,"_21622":124641,"_5":14887,"_28406":124574,"_3086":124642},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3696":74236,"_31230":74208,"_21622":124644,"_5":14887,"_28406":124578,"_3086":124645},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3696":74237,"_31230":74237,"_5":15247,"_3086":55230,"_31588":124647,"_21622":124649,"_28406":74237},[51065,122085,53759,123230,124648],"Integraciones",[],{"_3696":74238,"_31230":74237,"_21622":124651,"_5":14887,"_28406":74237,"_3086":124652},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3696":74239,"_31230":74237,"_5":31585,"_21622":124654,"_28406":124655,"_3086":124656},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3696":74240,"_31230":74237,"_5":31585,"_21622":124658,"_28406":124659,"_3086":124660},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3696":74241,"_31230":74237,"_5":31585,"_21622":124662,"_28406":124663,"_3086":124664},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3696":74242,"_31230":74237,"_5":31585,"_21622":124666,"_28406":124667,"_3086":124668},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3696":74243,"_31230":74237,"_5":31585,"_21622":124670,"_28406":124671,"_3086":124672},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3696":74244,"_31230":74237,"_5":31585,"_21622":124674,"_28406":124675,"_3086":124676},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3696":74245,"_31230":74237,"_5":31585,"_21622":124678,"_28406":124679,"_3086":124680},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3696":74246,"_31230":74237,"_5":31585,"_21622":124682,"_28406":124683,"_3086":124684},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3696":74247,"_31230":74237,"_5":31585,"_21622":124686,"_28406":124687,"_3086":55272},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3696":74248,"_31230":74237,"_5":31585,"_21622":124689,"_28406":124690,"_3086":55276},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3696":74249,"_31230":74237,"_5":31585,"_21622":124692,"_28406":124693,"_3086":124694},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3696":74250,"_31230":74237,"_5":31585,"_21622":124696,"_28406":124697,"_3086":124698},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3696":74251,"_31230":74237,"_5":31585,"_21622":124700,"_28406":124701,"_3086":124702},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3696":74252,"_31230":74237,"_5":31585,"_21622":124704,"_28406":124705,"_3086":124706},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3696":74253,"_31230":74237,"_5":31585,"_21622":124708,"_28406":124709,"_3086":124710},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3696":74254,"_31230":74237,"_5":31585,"_21622":124712,"_28406":124713,"_3086":124714},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3696":74255,"_31230":74237,"_5":31585,"_21622":124716,"_28406":124717,"_3086":124718},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3696":74256,"_31230":74237,"_5":31585,"_21622":124720,"_28406":124721,"_3086":124722},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3696":74257,"_31230":74237,"_5":31585,"_21622":124724,"_28406":124725,"_3086":124726},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3696":74258,"_31230":74237,"_5":31585,"_21622":124728,"_28406":124729,"_3086":124730},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3696":74259,"_31230":74237,"_5":31585,"_21622":124732,"_28406":124733,"_3086":124734},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3696":74260,"_31230":74237,"_5":31585,"_21622":124736,"_28406":124737,"_3086":124738},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3696":74261,"_31230":74237,"_5":31585,"_21622":124740,"_28406":124741,"_3086":124742},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3696":74262,"_31230":74237,"_5":31585,"_21622":124744,"_28406":124745,"_3086":124746},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3696":74263,"_31230":74237,"_5":31585,"_21622":124748,"_28406":124749,"_3086":124750},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3696":74264,"_31230":74237,"_21622":124752,"_5":14887,"_28406":74237,"_3086":124753},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3696":74265,"_31230":74237,"_21622":124755,"_5":14887,"_28406":74237,"_3086":124756},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3696":74266,"_31230":74237,"_21622":124758,"_5":14887,"_28406":74237,"_3086":124759},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3696":74267,"_31230":74237,"_21622":124761,"_5":14887,"_28406":124655,"_3086":124762},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3696":74268,"_31230":74237,"_21622":124764,"_5":14887,"_28406":124655,"_3086":124765},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3696":74269,"_31230":74237,"_21622":124767,"_5":14887,"_28406":124655,"_3086":124768},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3696":74270,"_31230":74237,"_21622":124770,"_5":14887,"_28406":124655,"_3086":124771},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3696":74271,"_31230":74237,"_21622":124773,"_5":14887,"_28406":124659,"_3086":124774},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3696":74272,"_31230":74237,"_21622":124776,"_5":14887,"_28406":124663,"_3086":124777},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3696":74273,"_31230":74237,"_21622":124779,"_5":14887,"_28406":124663,"_3086":124780},[],"Acción IAM",{"_3696":74274,"_31230":74237,"_21622":124782,"_5":14887,"_28406":124663,"_3086":120979},[],{"_3696":74275,"_31230":74237,"_21622":124784,"_5":14887,"_28406":124663,"_3086":55371},[],{"_3696":74276,"_31230":74237,"_21622":124786,"_5":14887,"_28406":124663,"_3086":124787},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3696":74277,"_31230":74237,"_21622":124789,"_5":14887,"_28406":124663,"_3086":55377},[],{"_3696":74278,"_31230":74237,"_21622":124791,"_5":14887,"_28406":124663,"_3086":124792},[],"Registrar la CA en AWS IoT",{"_3696":74279,"_31230":74237,"_21622":124794,"_5":14887,"_28406":124663,"_3086":55383},[],{"_3696":74280,"_31230":74237,"_21622":124796,"_5":14887,"_28406":124663,"_3086":124797},[],"Consultar el estado del registro de la CA",{"_3696":74281,"_31230":74237,"_21622":124799,"_5":14887,"_28406":124663,"_3086":55389},[],{"_3696":74282,"_31230":74237,"_21622":124801,"_5":14887,"_28406":124663,"_3086":124802},[],"Crear o actualizar Things en IoT Core",{"_3696":74283,"_31230":74237,"_21622":124804,"_5":14887,"_28406":124663,"_3086":55395},[],{"_3696":74284,"_31230":74237,"_21622":124806,"_5":14887,"_28406":124663,"_3086":124807},[],"Aprovisionar Things mediante plantilla",{"_3696":74285,"_31230":74237,"_21622":124809,"_5":14887,"_28406":124663,"_3086":55401},[],{"_3696":74286,"_31230":74237,"_21622":124811,"_5":14887,"_28406":124663,"_3086":124812},[],"Registrar certificados de dispositivo",{"_3696":74287,"_31230":74237,"_21622":124814,"_5":14887,"_28406":124663,"_3086":55407},[],{"_3696":74288,"_31230":74237,"_21622":124816,"_5":14887,"_28406":124663,"_3086":124817},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3696":74289,"_31230":74237,"_21622":124819,"_5":14887,"_28406":124663,"_3086":55413},[],{"_3696":74290,"_31230":74237,"_21622":124821,"_5":14887,"_28406":124663,"_3086":124822},[],"Crear y adjuntar políticas IoT",{"_3696":74291,"_31230":74237,"_21622":124824,"_5":14887,"_28406":124663,"_3086":55419},[],{"_3696":74292,"_31230":74237,"_21622":124826,"_5":14887,"_28406":124663,"_3086":124827},[],"Gestionar grupos de Things",{"_3696":74293,"_31230":74237,"_21622":124829,"_5":14887,"_28406":124663,"_3086":55425},[],{"_3696":74294,"_31230":74237,"_21622":124831,"_5":14887,"_28406":124663,"_3086":124832},[],"Crear plantillas JITP",{"_3696":74295,"_31230":74237,"_21622":124834,"_5":14887,"_28406":124663,"_3086":55431},[],{"_3696":74296,"_31230":74237,"_21622":124836,"_5":14887,"_28406":124663,"_3086":124837},[],"Leer y escribir el Device Shadow",{"_3696":74297,"_31230":74237,"_21622":124839,"_5":14887,"_28406":124663,"_3086":124840},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3696":74298,"_31230":74237,"_21622":124842,"_5":14887,"_28406":124667,"_3086":124843},[],"Parámetro",{"_3696":74299,"_31230":74237,"_21622":124845,"_5":14887,"_28406":124667,"_3086":124846},[],"Tipo",{"_3696":74300,"_31230":74237,"_21622":124848,"_5":14887,"_28406":124667,"_3086":124849},[],"Requerido",{"_3696":74301,"_31230":74237,"_21622":124851,"_5":14887,"_28406":124667,"_3086":124852},[],"Descripción",{"_3696":74302,"_31230":74237,"_21622":124854,"_5":14887,"_28406":124667,"_3086":55452},[],{"_3696":74303,"_31230":74237,"_21622":124856,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74304,"_31230":74237,"_21622":124858,"_5":14887,"_28406":124667,"_3086":124859},[],"Sí",{"_3696":74305,"_31230":74237,"_21622":124861,"_5":14887,"_28406":124667,"_3086":124862},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3696":74306,"_31230":74237,"_21622":124864,"_5":14887,"_28406":124667,"_3086":55463},[],{"_3696":74307,"_31230":74237,"_21622":124866,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74308,"_31230":74237,"_21622":124868,"_5":14887,"_28406":124667,"_3086":124859},[],{"_3696":74309,"_31230":74237,"_21622":124870,"_5":14887,"_28406":124667,"_3086":124871},[],"Región AWS donde opera el conector.",{"_3696":74310,"_31230":74237,"_21622":124873,"_5":14887,"_28406":124667,"_3086":55473},[],{"_3696":74311,"_31230":74237,"_21622":124875,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74312,"_31230":74237,"_21622":124877,"_5":14887,"_28406":124667,"_3086":124859},[],{"_3696":74313,"_31230":74237,"_21622":124879,"_5":14887,"_28406":124667,"_3086":124880},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3696":74314,"_31230":74237,"_21622":124882,"_5":14887,"_28406":124667,"_3086":55483},[],{"_3696":74315,"_31230":74237,"_21622":124884,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74316,"_31230":74237,"_21622":124886,"_5":14887,"_28406":124667,"_3086":124887},[],"Solo con `auth_method=static`",{"_3696":74317,"_31230":74237,"_21622":124889,"_5":14887,"_28406":124667,"_3086":124890},[],"Clave de acceso AWS.",{"_3696":74318,"_31230":74237,"_21622":124892,"_5":14887,"_28406":124667,"_3086":55494},[],{"_3696":74319,"_31230":74237,"_21622":124894,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74320,"_31230":74237,"_21622":124896,"_5":14887,"_28406":124667,"_3086":124887},[],{"_3696":74321,"_31230":74237,"_21622":124898,"_5":14887,"_28406":124667,"_3086":124899},[],"Clave secreta AWS.",{"_3696":74322,"_31230":74237,"_21622":124901,"_5":14887,"_28406":124667,"_3086":55504},[],{"_3696":74323,"_31230":74237,"_21622":124903,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74324,"_31230":74237,"_21622":124905,"_5":14887,"_28406":124667,"_3086":55509},[],{"_3696":74325,"_31230":74237,"_21622":124907,"_5":14887,"_28406":124667,"_3086":124908},[],"Token de sesión (con `auth_method=static`).",{"_3696":74326,"_31230":74237,"_21622":124910,"_5":14887,"_28406":124667,"_3086":55515},[],{"_3696":74327,"_31230":74237,"_21622":124912,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74328,"_31230":74237,"_21622":124914,"_5":14887,"_28406":124667,"_3086":124915},[],"Solo con `auth_method=role`",{"_3696":74329,"_31230":74237,"_21622":124917,"_5":14887,"_28406":124667,"_3086":124918},[],"ARN del rol a asumir.",{"_3696":74330,"_31230":74237,"_21622":124920,"_5":14887,"_28406":124667,"_3086":55526},[],{"_3696":74331,"_31230":74237,"_21622":124922,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74332,"_31230":74237,"_21622":124924,"_5":14887,"_28406":124667,"_3086":55509},[],{"_3696":74333,"_31230":74237,"_21622":124926,"_5":14887,"_28406":124667,"_3086":124927},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3696":74334,"_31230":74237,"_21622":124929,"_5":14887,"_28406":124667,"_3086":55536},[],{"_3696":74335,"_31230":74237,"_21622":124931,"_5":14887,"_28406":124667,"_3086":93117},[],{"_3696":74336,"_31230":74237,"_21622":124933,"_5":14887,"_28406":124667,"_3086":124859},[],{"_3696":74337,"_31230":74237,"_21622":124935,"_5":14887,"_28406":124667,"_3086":124936},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3696":74338,"_31230":74237,"_21622":124938,"_5":14887,"_28406":124667,"_3086":55546},[],{"_3696":74339,"_31230":74237,"_21622":124940,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74340,"_31230":74237,"_21622":124942,"_5":14887,"_28406":124667,"_3086":124859},[],{"_3696":74341,"_31230":74237,"_21622":124944,"_5":14887,"_28406":124667,"_3086":124945},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3696":74342,"_31230":74237,"_21622":124947,"_5":14887,"_28406":124667,"_3086":55556},[],{"_3696":74343,"_31230":74237,"_21622":124949,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74344,"_31230":74237,"_21622":124951,"_5":14887,"_28406":124667,"_3086":124859},[],{"_3696":74345,"_31230":74237,"_21622":124953,"_5":14887,"_28406":124667,"_3086":124954},[],"URL HTTP del Device Manager de Lamassu.",{"_3696":74346,"_31230":74237,"_21622":124956,"_5":14887,"_28406":124667,"_3086":55566},[],{"_3696":74347,"_31230":74237,"_21622":124958,"_5":14887,"_28406":124667,"_3086":25829},[],{"_3696":74348,"_31230":74237,"_21622":124960,"_5":14887,"_28406":124667,"_3086":124859},[],{"_3696":74349,"_31230":74237,"_21622":124962,"_5":14887,"_28406":124667,"_3086":124963},[],"URL HTTP del servicio de CA de Lamassu.",{"_3696":74350,"_31230":74237,"_21622":124965,"_5":14887,"_28406":124671,"_3086":124966},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3696":74351,"_31230":74237,"_21622":124968,"_5":14887,"_28406":124671,"_3086":124969},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3696":74352,"_31230":74237,"_21622":124971,"_5":14887,"_28406":124671,"_3086":124972},[],"Tipo de CloudEvent",{"_3696":74353,"_31230":74237,"_21622":124974,"_5":14887,"_28406":124671,"_3086":124975},[],"Recurso en Lamassu",{"_3696":74354,"_31230":74237,"_21622":124977,"_5":14887,"_28406":124671,"_3086":124978},[],"Recurso AWS",{"_3696":74355,"_31230":74237,"_21622":124980,"_5":14887,"_28406":124671,"_3086":124981},[],"Acciones IAM",{"_3696":74356,"_31230":74237,"_21622":124983,"_5":14887,"_28406":124671,"_3086":124984},[],"Llamadas AWS y efecto",{"_3696":74357,"_31230":74237,"_21622":124986,"_5":14887,"_28406":124671,"_3086":124987},[],"Dónde en esta página",{"_3696":74358,"_31230":74237,"_21622":124989,"_5":14887,"_28406":124671,"_3086":55600},[],{"_3696":74359,"_31230":74237,"_21622":124991,"_5":14887,"_28406":124671,"_3086":55603},[],{"_3696":74360,"_31230":74237,"_21622":124993,"_5":14887,"_28406":124671,"_3086":55606},[],{"_3696":74361,"_31230":74237,"_21622":124995,"_5":14887,"_28406":124671,"_3086":55609},[],{"_3696":74362,"_31230":74237,"_21622":124997,"_5":14887,"_28406":124671,"_3086":124998},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3696":74363,"_31230":74237,"_21622":125000,"_5":14887,"_28406":124671,"_3086":124684},[],{"_3696":74364,"_31230":74237,"_21622":125002,"_5":14887,"_28406":124671,"_3086":55617},[],{"_3696":74365,"_31230":74237,"_21622":125004,"_5":14887,"_28406":124671,"_3086":55620},[],{"_3696":74366,"_31230":74237,"_21622":125006,"_5":14887,"_28406":124671,"_3086":55623},[],{"_3696":74367,"_31230":74237,"_21622":125008,"_5":14887,"_28406":124671,"_3086":55626},[],{"_3696":74368,"_31230":74237,"_21622":125010,"_5":14887,"_28406":124671,"_3086":125011},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3696":74369,"_31230":74237,"_21622":125013,"_5":14887,"_28406":124671,"_3086":124710},[],{"_3696":74370,"_31230":74237,"_21622":125015,"_5":14887,"_28406":124671,"_3086":55634},[],{"_3696":74371,"_31230":74237,"_21622":125017,"_5":14887,"_28406":124671,"_3086":125018},[],"Dispositivo",{"_3696":74372,"_31230":74237,"_21622":125020,"_5":14887,"_28406":124671,"_3086":55640},[],{"_3696":74373,"_31230":74237,"_21622":125022,"_5":14887,"_28406":124671,"_3086":55643},[],{"_3696":74374,"_31230":74237,"_21622":125024,"_5":14887,"_28406":124671,"_3086":125025},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3696":74375,"_31230":74237,"_21622":125027,"_5":14887,"_28406":124671,"_3086":124718},[],{"_3696":74376,"_31230":74237,"_21622":125029,"_5":14887,"_28406":124671,"_3086":55651},[],{"_3696":74377,"_31230":74237,"_21622":125031,"_5":14887,"_28406":124671,"_3086":125032},[],"Certificado",{"_3696":74378,"_31230":74237,"_21622":125034,"_5":14887,"_28406":124671,"_3086":55657},[],{"_3696":74379,"_31230":74237,"_21622":125036,"_5":14887,"_28406":124671,"_3086":125037},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3696":74380,"_31230":74237,"_21622":125039,"_5":14887,"_28406":124671,"_3086":125040},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3696":74381,"_31230":74237,"_21622":125042,"_5":14887,"_28406":124671,"_3086":124730},[],{"_3696":74382,"_31230":74237,"_21622":125044,"_5":14887,"_28406":124671,"_3086":55668},[],{"_3696":74383,"_31230":74237,"_21622":125046,"_5":14887,"_28406":124671,"_3086":125047},[],"Certificado / Dispositivo",{"_3696":74384,"_31230":74237,"_21622":125049,"_5":14887,"_28406":124671,"_3086":55674},[],{"_3696":74385,"_31230":74237,"_21622":125051,"_5":14887,"_28406":124671,"_3086":51461},[],{"_3696":74386,"_31230":74237,"_21622":125053,"_5":14887,"_28406":124671,"_3086":125054},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3696":74387,"_31230":74237,"_21622":125056,"_5":14887,"_28406":124671,"_3086":124738},[],{"_3696":74388,"_31230":74237,"_21622":125058,"_5":14887,"_28406":124675,"_3086":125059},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3696":74389,"_31230":74237,"_21622":125061,"_5":14887,"_28406":124679,"_3086":125062},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3696":74390,"_31230":74237,"_21622":125064,"_5":14887,"_28406":124679,"_3086":125065},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3696":74391,"_31230":74237,"_21622":125067,"_5":14887,"_28406":124683,"_3086":125068},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3696":74392,"_31230":74237,"_21622":125070,"_5":14887,"_28406":124683,"_3086":125071},[],"Transición",{"_3696":74393,"_31230":74237,"_21622":125073,"_5":14887,"_28406":124683,"_3086":125074},[],"Llamadas AWS",{"_3696":74394,"_31230":74237,"_21622":125076,"_5":14887,"_28406":124683,"_3086":125077},[],"`NoRegistrada` → `Solicitada`",{"_3696":74395,"_31230":74237,"_21622":125079,"_5":14887,"_28406":124683,"_3086":125080},[],"ninguna (solo escritura de metadatos)",{"_3696":74396,"_31230":74237,"_21622":125082,"_5":14887,"_28406":124683,"_3086":125083},[],"`Solicitada` → `Registrando`",{"_3696":74397,"_31230":74237,"_21622":125085,"_5":14887,"_28406":124683,"_3086":125086},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3696":74398,"_31230":74237,"_21622":125088,"_5":14887,"_28406":124683,"_3086":125089},[],"`Registrando` → `Completada`",{"_3696":74399,"_31230":74237,"_21622":125091,"_5":14887,"_28406":124683,"_3086":125092},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3696":74400,"_31230":74237,"_21622":125094,"_5":14887,"_28406":124683,"_3086":125095},[],"`Registrando` → `Fallida`",{"_3696":74401,"_31230":74237,"_21622":125097,"_5":14887,"_28406":124683,"_3086":125098},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3696":74402,"_31230":74237,"_21622":125100,"_5":14887,"_28406":124683,"_3086":125101},[],"`Fallida` / `Completada` → `Solicitada`",{"_3696":74403,"_31230":74237,"_21622":125103,"_5":14887,"_28406":124683,"_3086":125104},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3696":74404,"_31230":74237,"_21622":125106,"_5":14887,"_28406":124687,"_3086":125107},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3696":74405,"_31230":74237,"_21622":125109,"_5":14887,"_28406":124687,"_3086":125110},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3696":74406,"_31230":74237,"_21622":125112,"_5":14887,"_28406":124687,"_3086":125113},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3696":74407,"_31230":74237,"_21622":125115,"_5":14887,"_28406":124687,"_3086":125116},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3696":74408,"_31230":74237,"_21622":125118,"_5":14887,"_28406":124687,"_3086":125119},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3696":74409,"_31230":74237,"_21622":125121,"_5":14887,"_28406":124687,"_3086":125122},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3696":74410,"_31230":74237,"_21622":125124,"_5":14887,"_28406":124690,"_3086":125125},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3696":74411,"_31230":74237,"_21622":125127,"_5":14887,"_28406":124693,"_3086":125128},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3696":74412,"_31230":74237,"_21622":125130,"_5":14887,"_28406":124693,"_3086":125131},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3696":74413,"_31230":74237,"_21622":125133,"_5":14887,"_28406":124697,"_3086":125134},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3696":74414,"_31230":74237,"_21622":125136,"_5":14887,"_28406":124701,"_3086":125137},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3696":74415,"_31230":74237,"_21622":125139,"_5":14887,"_28406":124701,"_3086":125140},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3696":74416,"_31230":74237,"_21622":125142,"_5":14887,"_28406":124701,"_3086":125143},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3696":74417,"_31230":74237,"_21622":125145,"_5":14887,"_28406":124701,"_3086":125146},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3696":74418,"_31230":74237,"_21622":125148,"_5":14887,"_28406":124701,"_3086":125149},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3696":74419,"_31230":74237,"_21622":125151,"_5":14887,"_28406":124701,"_3086":125152},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3696":74420,"_31230":74237,"_21622":125154,"_5":14887,"_28406":124705,"_3086":125155},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3696":74421,"_31230":74237,"_21622":125157,"_5":14887,"_28406":124705,"_3086":125158},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3696":74422,"_31230":74237,"_21622":125160,"_5":14887,"_28406":124705,"_3086":125161},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3696":74423,"_31230":74237,"_21622":125163,"_5":14887,"_28406":124705,"_3086":125164},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3696":74424,"_31230":74237,"_21622":125166,"_5":14887,"_28406":124705,"_3086":125167},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3696":74425,"_31230":74237,"_21622":125169,"_5":14887,"_28406":124709,"_3086":125170},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3696":74426,"_31230":74237,"_21622":125172,"_5":14887,"_28406":124709,"_3086":125071},[],{"_3696":74427,"_31230":74237,"_21622":125174,"_5":14887,"_28406":124709,"_3086":125074},[],{"_3696":74428,"_31230":74237,"_21622":125176,"_5":14887,"_28406":124709,"_3086":125177},[],"`SinConfigurar` → `None` / `Auto`",{"_3696":74429,"_31230":74237,"_21622":125179,"_5":14887,"_28406":124709,"_3086":125180},[],"ninguna (solo configuración)",{"_3696":74430,"_31230":74237,"_21622":125182,"_5":14887,"_28406":124709,"_3086":55811},[],{"_3696":74431,"_31230":74237,"_21622":125184,"_5":14887,"_28406":124709,"_3086":125180},[],{"_3696":74432,"_31230":74237,"_21622":125186,"_5":14887,"_28406":124709,"_3086":125187},[],"Cualquiera → `Jitp`",{"_3696":74433,"_31230":74237,"_21622":125189,"_5":14887,"_28406":124709,"_3086":125190},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3696":74434,"_31230":74237,"_21622":125192,"_5":14887,"_28406":124709,"_3086":55822},[],{"_3696":74435,"_31230":74237,"_21622":125194,"_5":14887,"_28406":124709,"_3086":125195},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3696":74436,"_31230":74237,"_21622":125197,"_5":14887,"_28406":124713,"_3086":125198},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3696":74437,"_31230":74237,"_21622":125200,"_5":14887,"_28406":124713,"_3086":125201},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3696":74438,"_31230":74237,"_21622":125203,"_5":14887,"_28406":124713,"_3086":125204},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3696":74439,"_31230":74237,"_21622":125206,"_5":14887,"_28406":124717,"_3086":125207},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3696":74440,"_31230":74237,"_21622":125209,"_5":14887,"_28406":124717,"_3086":125071},[],{"_3696":74441,"_31230":74237,"_21622":125211,"_5":14887,"_28406":124717,"_3086":125074},[],{"_3696":74442,"_31230":74237,"_21622":125213,"_5":14887,"_28406":124717,"_3086":125214},[],"`Ausente` → `Aprovisionado`",{"_3696":74443,"_31230":74237,"_21622":125216,"_5":14887,"_28406":124717,"_3086":125217},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3696":74444,"_31230":74237,"_21622":125219,"_5":14887,"_28406":124717,"_3086":125220},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3696":74445,"_31230":74237,"_21622":125222,"_5":14887,"_28406":124717,"_3086":125223},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3696":74446,"_31230":74237,"_21622":125225,"_5":14887,"_28406":124717,"_3086":125226},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3696":74447,"_31230":74237,"_21622":125228,"_5":14887,"_28406":124721,"_3086":125229},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3696":74448,"_31230":74237,"_21622":125231,"_5":14887,"_28406":124721,"_3086":125232},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3696":74449,"_31230":74237,"_21622":125234,"_5":14887,"_28406":124721,"_3086":125235},[],"Para que el flujo JITP funcione correctamente:",{"_3696":74450,"_31230":74237,"_21622":125237,"_5":14887,"_28406":124721,"_3086":125238},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3696":74451,"_31230":74237,"_21622":125240,"_5":14887,"_28406":124721,"_3086":125241},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3696":74452,"_31230":74237,"_21622":125243,"_5":14887,"_28406":124721,"_3086":125244},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3696":74453,"_31230":74237,"_21622":125246,"_5":14887,"_28406":124721,"_3086":125247},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3696":74454,"_31230":74237,"_21622":125249,"_5":14887,"_28406":124725,"_3086":125250},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3696":74455,"_31230":74237,"_21622":125252,"_5":14887,"_28406":124725,"_3086":125253},[],"Estado en Lamassu",{"_3696":74456,"_31230":74237,"_21622":125255,"_5":14887,"_28406":124725,"_3086":125256},[],"Razón de revocación",{"_3696":74457,"_31230":74237,"_21622":125258,"_5":14887,"_28406":124725,"_3086":125259},[],"Estado en AWS IoT Core",{"_3696":74458,"_31230":74237,"_21622":125261,"_5":14887,"_28406":124725,"_3086":55892},[],{"_3696":74459,"_31230":74237,"_21622":125263,"_5":14887,"_28406":124725,"_3086":125264},[],"Ninguna",{"_3696":74460,"_31230":74237,"_21622":125266,"_5":14887,"_28406":124725,"_3086":55898},[],{"_3696":74461,"_31230":74237,"_21622":125268,"_5":14887,"_28406":124725,"_3086":55901},[],{"_3696":74462,"_31230":74237,"_21622":125270,"_5":14887,"_28406":124725,"_3086":55904},[],{"_3696":74463,"_31230":74237,"_21622":125272,"_5":14887,"_28406":124725,"_3086":55907},[],{"_3696":74464,"_31230":74237,"_21622":125274,"_5":14887,"_28406":124725,"_3086":55901},[],{"_3696":74465,"_31230":74237,"_21622":125276,"_5":14887,"_28406":124725,"_3086":125277},[],"Cualquier otra razón",{"_3696":74466,"_31230":74237,"_21622":125279,"_5":14887,"_28406":124725,"_3086":55915},[],{"_3696":74467,"_31230":74237,"_21622":125281,"_5":14887,"_28406":124725,"_3086":125282},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3696":74468,"_31230":74237,"_21622":125284,"_5":14887,"_28406":124729,"_3086":125285},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3696":74469,"_31230":74237,"_21622":125287,"_5":14887,"_28406":124729,"_3086":125071},[],{"_3696":74470,"_31230":74237,"_21622":125289,"_5":14887,"_28406":124729,"_3086":125074},[],{"_3696":74471,"_31230":74237,"_21622":125291,"_5":14887,"_28406":124729,"_3086":125292},[],"`NoSincronizado` → `Active`",{"_3696":74472,"_31230":74237,"_21622":125294,"_5":14887,"_28406":124729,"_3086":55407},[],{"_3696":74473,"_31230":74237,"_21622":125296,"_5":14887,"_28406":124729,"_3086":55933},[],{"_3696":74474,"_31230":74237,"_21622":125298,"_5":14887,"_28406":124729,"_3086":125299},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3696":74475,"_31230":74237,"_21622":125301,"_5":14887,"_28406":124729,"_3086":55939},[],{"_3696":74476,"_31230":74237,"_21622":125303,"_5":14887,"_28406":124729,"_3086":125299},[],{"_3696":74477,"_31230":74237,"_21622":125305,"_5":14887,"_28406":124729,"_3086":55944},[],{"_3696":74478,"_31230":74237,"_21622":125307,"_5":14887,"_28406":124729,"_3086":55407},[],{"_3696":74479,"_31230":74237,"_21622":125309,"_5":14887,"_28406":124729,"_3086":55949},[],{"_3696":74480,"_31230":74237,"_21622":125311,"_5":14887,"_28406":124729,"_3086":125312},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3696":74481,"_31230":74237,"_21622":125314,"_5":14887,"_28406":124733,"_3086":125315},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3696":74482,"_31230":74237,"_21622":125317,"_5":14887,"_28406":124733,"_3086":125318},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3696":74483,"_31230":74237,"_21622":125320,"_5":14887,"_28406":124733,"_3086":125321},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3696":74484,"_31230":74237,"_21622":125323,"_5":14887,"_28406":124737,"_3086":125324},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3696":74485,"_31230":74237,"_21622":125326,"_5":14887,"_28406":124737,"_3086":125327},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3696":74486,"_31230":74237,"_21622":125329,"_5":14887,"_28406":124741,"_3086":125330},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3696":74487,"_31230":74237,"_21622":125332,"_5":14887,"_28406":124741,"_3086":125333},[],"Existen dos tipos de acciones:",{"_3696":74488,"_31230":74237,"_21622":125335,"_5":14887,"_28406":124741,"_3086":125336},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3696":74489,"_31230":74237,"_21622":125338,"_5":14887,"_28406":124741,"_3086":125339},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3696":74490,"_31230":74237,"_21622":125341,"_5":14887,"_28406":124741,"_3086":125342},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3696":74491,"_31230":74237,"_21622":125344,"_5":14887,"_28406":124745,"_3086":125345},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3696":74492,"_31230":74237,"_21622":125347,"_5":14887,"_28406":124745,"_3086":125348},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3696":74493,"_31230":74237,"_21622":125350,"_5":14887,"_28406":124745,"_3086":125351},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3696":74494,"_31230":74237,"_21622":125353,"_5":14887,"_28406":124749,"_3086":125354},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3696":74495,"_31230":74237,"_21622":125356,"_5":14887,"_28406":124749,"_3086":125357},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3696":74496,"_31230":74237,"_21622":125359,"_5":14887,"_28406":124749,"_3086":125360},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3696":74497,"_31230":74237,"_21622":125362,"_5":14887,"_28406":124749,"_3086":125363},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3696":74498,"_31230":74237,"_21622":125365,"_5":14887,"_28406":124749,"_3086":125366},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3696":74499,"_31230":74237,"_21622":125368,"_5":14887,"_28406":124749,"_3086":125369},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3696":74500,"_31230":74237,"_21622":125371,"_5":14887,"_28406":124749,"_3086":125372},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3696":74501,"_31230":74237,"_21622":125374,"_5":14887,"_28406":124749,"_3086":125375},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3696":74502,"_31230":74237,"_21622":125377,"_5":14887,"_28406":124749,"_3086":125378},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3696":74503,"_31230":74237,"_21622":125380,"_5":14887,"_28406":124749,"_3086":125381},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3696":74504,"_31230":74237,"_21622":125383,"_5":14887,"_28406":124749,"_3086":125384},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3696":74505,"_31230":74237,"_21622":125386,"_5":14887,"_28406":124749,"_3086":125387},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3696":74506,"_31230":74237,"_21622":125389,"_5":14887,"_28406":124749,"_3086":125390},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3696":74507,"_31230":74237,"_21622":125392,"_5":14887,"_28406":124749,"_3086":125393},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3696":74508,"_31230":74237,"_21622":125395,"_5":14887,"_28406":124749,"_3086":125396},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3696":74509,"_31230":74237,"_21622":125398,"_5":14887,"_28406":124749,"_3086":125399},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3696":74510,"_31230":74237,"_21622":125401,"_5":14887,"_28406":124749,"_3086":125402},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3696":74511,"_31230":74237,"_21622":125404,"_5":14887,"_28406":124749,"_3086":125405},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3696":74512,"_31230":74237,"_21622":125407,"_5":14887,"_28406":124749,"_3086":125408},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3696":74513,"_31230":74237,"_21622":125410,"_5":14887,"_28406":124749,"_3086":125411},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3696":74514,"_31230":74237,"_21622":125413,"_5":14887,"_28406":124749,"_3086":125414},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3696":74515,"_31230":74237,"_21622":125416,"_5":14887,"_28406":124749,"_3086":125417},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3696":74516,"_31230":74237,"_21622":125419,"_5":14887,"_28406":124749,"_3086":125420},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3696":74517,"_31230":74237,"_21622":125422,"_5":14887,"_28406":124749,"_3086":125423},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3696":74518,"_31230":74518,"_5":15247,"_3086":53759,"_31588":125425,"_21622":125426,"_28406":74518},[51065,122085,53759],[],{"_3696":74519,"_31230":74518,"_21622":125428,"_5":14887,"_28406":74518,"_3086":125429},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3696":74520,"_31230":74518,"_5":31585,"_21622":125431,"_28406":125432,"_3086":125433},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3696":74521,"_31230":74518,"_5":31585,"_21622":125435,"_28406":125436,"_3086":123230},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3696":74522,"_31230":74518,"_5":31585,"_21622":125438,"_28406":125439,"_3086":123408},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3696":74523,"_31230":74518,"_5":31585,"_21622":125441,"_28406":125442,"_3086":124648},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/overview#integraciones",{"_3696":74524,"_31230":74518,"_5":31585,"_21622":125444,"_28406":125445,"_3086":125446},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3696":74525,"_31230":74518,"_21622":125448,"_5":14887,"_28406":74518,"_3086":125449},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3696":74526,"_31230":74518,"_21622":125451,"_5":14887,"_28406":125432,"_3086":125452},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3696":74527,"_31230":74518,"_21622":125454,"_5":14887,"_28406":125432,"_3086":125455},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3696":74528,"_31230":74518,"_21622":125457,"_5":14887,"_28406":125436,"_3086":125458},[],"Recurso",{"_3696":74529,"_31230":74518,"_21622":125460,"_5":14887,"_28406":125436,"_3086":125461},[],"Qué representa",{"_3696":74530,"_31230":74518,"_21622":125463,"_5":14887,"_28406":125436,"_3086":125464},[],"**Dispositivo**",{"_3696":74531,"_31230":74518,"_21622":125466,"_5":14887,"_28406":125436,"_3086":125467},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3696":74532,"_31230":74518,"_21622":125469,"_5":14887,"_28406":125436,"_3086":125470},[],"**Identidad**",{"_3696":74533,"_31230":74518,"_21622":125472,"_5":14887,"_28406":125436,"_3086":125473},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3696":74534,"_31230":74518,"_21622":125475,"_5":14887,"_28406":125436,"_3086":56116},[],{"_3696":74535,"_31230":74518,"_21622":125477,"_5":14887,"_28406":125436,"_3086":125478},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3696":74536,"_31230":74518,"_21622":125480,"_5":14887,"_28406":125436,"_3086":125481},[],"**Flota**",{"_3696":74537,"_31230":74518,"_21622":125483,"_5":14887,"_28406":125436,"_3086":125484},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3696":74538,"_31230":74518,"_21622":125486,"_5":14887,"_28406":125436,"_3086":125487},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3696":74539,"_31230":74518,"_21622":125489,"_5":14887,"_28406":125436,"_3086":125490},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3696":74540,"_31230":74518,"_21622":125492,"_5":14887,"_28406":125439,"_3086":125493},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3696":74541,"_31230":74518,"_21622":125495,"_5":14887,"_28406":125439,"_3086":125496},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3696":74542,"_31230":74518,"_21622":125498,"_5":14887,"_28406":125439,"_3086":125499},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3696":74543,"_31230":74518,"_21622":125501,"_5":14887,"_28406":125439,"_3086":125502},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3696":74544,"_31230":74518,"_21622":125504,"_5":14887,"_28406":125439,"_3086":125505},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3696":74545,"_31230":74518,"_21622":125507,"_5":14887,"_28406":125439,"_3086":125508},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3696":74546,"_31230":74518,"_21622":125510,"_5":14887,"_28406":125439,"_3086":125511},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3696":74547,"_31230":74518,"_21622":125513,"_5":14887,"_28406":125439,"_3086":125514},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3696":74548,"_31230":74518,"_21622":125516,"_5":14887,"_28406":125442,"_3086":125517},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3696":74549,"_31230":74518,"_21622":125519,"_5":14887,"_28406":125442,"_3086":125520},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3696":74550,"_31230":74518,"_21622":125522,"_5":14887,"_28406":125445,"_3086":125523},[],"Participante",{"_3696":74551,"_31230":74518,"_21622":125525,"_5":14887,"_28406":125445,"_3086":125526},[],"Responsabilidad",{"_3696":74552,"_31230":74518,"_21622":125528,"_5":14887,"_28406":125445,"_3086":125529},[],"Administrador PKI",{"_3696":74553,"_31230":74518,"_21622":125531,"_5":14887,"_28406":125445,"_3086":125532},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3696":74554,"_31230":74518,"_21622":125534,"_5":14887,"_28406":125445,"_3086":125535},[],"Administrador del aprovisionamiento",{"_3696":74555,"_31230":74518,"_21622":125537,"_5":14887,"_28406":125445,"_3086":125538},[],"DMS, admisión, autenticación por operación e inventario.",{"_3696":74556,"_31230":74518,"_21622":125540,"_5":14887,"_28406":125445,"_3086":125541},[],"Integrador del dispositivo",{"_3696":74557,"_31230":74518,"_21622":125543,"_5":14887,"_28406":125445,"_3086":125544},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3696":74558,"_31230":74518,"_21622":125546,"_5":14887,"_28406":125445,"_3086":125547},[],"Integrador del consumidor",{"_3696":74559,"_31230":74518,"_21622":125549,"_5":14887,"_28406":125445,"_3086":125550},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3696":74560,"_31230":74518,"_21622":125552,"_5":14887,"_28406":125445,"_3086":125553},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3696":74561,"_31230":74561,"_5":15247,"_3086":125555,"_31588":125556,"_21622":125558,"_28406":74561},"Enrola y conecta tu primer dispositivo",[51065,122085,53759,125557],"Primeros pasos",[],{"_3696":74562,"_31230":74561,"_21622":125560,"_5":14887,"_28406":74561,"_3086":125561},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3696":74563,"_31230":74561,"_5":31585,"_21622":125563,"_28406":125564,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3696":74564,"_31230":74561,"_5":31585,"_21622":125566,"_28406":125567,"_3086":125568},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3696":74565,"_31230":74561,"_5":31585,"_21622":125570,"_28406":125571,"_3086":125572},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3696":74566,"_31230":74561,"_5":31585,"_21622":125574,"_28406":125575,"_3086":125576},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3696":74567,"_31230":74561,"_5":31585,"_21622":125578,"_28406":125579,"_3086":125580},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3696":74568,"_31230":74561,"_5":31585,"_21622":125582,"_28406":125583,"_3086":125584},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3696":74569,"_31230":74561,"_5":31585,"_21622":125586,"_28406":125587,"_3086":125588},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3696":74570,"_31230":74561,"_5":31585,"_21622":125590,"_28406":125591,"_3086":125592},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3696":74571,"_31230":74561,"_21622":125594,"_5":14887,"_28406":74561,"_3086":125595},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3696":74572,"_31230":74561,"_21622":125597,"_5":14887,"_28406":125564,"_3086":125598},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3696":74573,"_31230":74561,"_21622":125600,"_5":14887,"_28406":125564,"_3086":125601},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3696":74574,"_31230":74561,"_21622":125603,"_5":14887,"_28406":125564,"_3086":125604},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3696":74575,"_31230":74561,"_21622":125606,"_5":14887,"_28406":125564,"_3086":125607},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3696":74576,"_31230":74561,"_21622":125609,"_5":14887,"_28406":125564,"_3086":125610},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3696":74577,"_31230":74561,"_21622":125612,"_5":14887,"_28406":125567,"_3086":125613},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3696":74578,"_31230":74561,"_21622":125615,"_5":14887,"_28406":125567,"_3086":125616},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3696":74579,"_31230":74561,"_21622":125618,"_5":14887,"_28406":125571,"_3086":125619},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3696":74580,"_31230":74561,"_21622":125621,"_5":14887,"_28406":125571,"_3086":125622},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3696":74581,"_31230":74561,"_21622":125624,"_5":14887,"_28406":125571,"_3086":125625},[],"Ajuste",{"_3696":74582,"_31230":74561,"_21622":125627,"_5":14887,"_28406":125571,"_3086":125628},[],"Valor de evaluación",{"_3696":74583,"_31230":74561,"_21622":125630,"_5":14887,"_28406":125571,"_3086":56272},[],{"_3696":74584,"_31230":74561,"_21622":125632,"_5":14887,"_28406":125571,"_3086":125633},[],"Raíz emisora de `device-root.pem`.",{"_3696":74585,"_31230":74561,"_21622":125635,"_5":14887,"_28406":125571,"_3086":123542},[],{"_3696":74586,"_31230":74561,"_21622":125637,"_5":14887,"_28406":125571,"_3086":125638},[],"Perfil final de 1 hora que acabas de preparar.",{"_3696":74587,"_31230":74561,"_21622":125640,"_5":14887,"_28406":125571,"_3086":56283},[],{"_3696":74588,"_31230":74561,"_21622":125642,"_5":14887,"_28406":125571,"_3086":56286},[],{"_3696":74589,"_31230":74561,"_21622":125644,"_5":14887,"_28406":125571,"_3086":56289},[],{"_3696":74590,"_31230":74561,"_21622":125646,"_5":14887,"_28406":125571,"_3086":125647},[],"Habilitado.",{"_3696":74591,"_31230":74561,"_21622":125649,"_5":14887,"_28406":125571,"_3086":56295},[],{"_3696":74592,"_31230":74561,"_21622":125651,"_5":14887,"_28406":125571,"_3086":125652},[],"Deshabilitado; el ID debe ser nuevo.",{"_3696":74593,"_31230":74561,"_21622":125654,"_5":14887,"_28406":125571,"_3086":125655},[],"Autenticación inicial",{"_3696":74594,"_31230":74561,"_21622":125657,"_5":14887,"_28406":125571,"_3086":125658},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3696":74595,"_31230":74561,"_21622":125660,"_5":14887,"_28406":125571,"_3086":125661},[],"Autenticación de renovación",{"_3696":74596,"_31230":74561,"_21622":125663,"_5":14887,"_28406":125571,"_3086":125664},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3696":74597,"_31230":74561,"_21622":125666,"_5":14887,"_28406":125571,"_3086":56313},[],{"_3696":74598,"_31230":74561,"_21622":125668,"_5":14887,"_28406":125571,"_3086":125669},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3696":74599,"_31230":74561,"_21622":125671,"_5":14887,"_28406":125571,"_3086":56319},[],{"_3696":74600,"_31230":74561,"_21622":125673,"_5":14887,"_28406":125571,"_3086":125674},[],"1 hora.",{"_3696":74601,"_31230":74561,"_21622":125676,"_5":14887,"_28406":125571,"_3086":56325},[],{"_3696":74602,"_31230":74561,"_21622":125678,"_5":14887,"_28406":125571,"_3086":125679},[],"30 minutos / 10 minutos.",{"_3696":74603,"_31230":74561,"_21622":125681,"_5":14887,"_28406":125571,"_3086":56331},[],{"_3696":74604,"_31230":74561,"_21622":125683,"_5":14887,"_28406":125571,"_3086":125684},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3696":74605,"_31230":74561,"_21622":125686,"_5":14887,"_28406":125571,"_3086":54087},[],{"_3696":74606,"_31230":74561,"_21622":125688,"_5":14887,"_28406":125571,"_3086":125689},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3696":74607,"_31230":74561,"_21622":125691,"_5":14887,"_28406":125571,"_3086":56342},[],{"_3696":74608,"_31230":74561,"_21622":125693,"_5":14887,"_28406":125571,"_3086":125694},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3696":74609,"_31230":74561,"_21622":125696,"_5":14887,"_28406":125571,"_3086":125697},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3696":74610,"_31230":74561,"_21622":125699,"_5":14887,"_28406":125575,"_3086":125700},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3696":74611,"_31230":74561,"_21622":125702,"_5":14887,"_28406":125575,"_3086":125703},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3696":74612,"_31230":74561,"_21622":125705,"_5":14887,"_28406":125579,"_3086":125706},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3696":74613,"_31230":74561,"_21622":125708,"_5":14887,"_28406":125579,"_3086":125709},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3696":74614,"_31230":74561,"_21622":125711,"_5":14887,"_28406":125579,"_3086":125712},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3696":74615,"_31230":74561,"_21622":125714,"_5":14887,"_28406":125583,"_3086":125715},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3696":74616,"_31230":74561,"_21622":125717,"_5":14887,"_28406":125583,"_3086":125718},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3696":74617,"_31230":74561,"_21622":125720,"_5":14887,"_28406":125587,"_3086":125721},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3696":74618,"_31230":74561,"_21622":125723,"_5":14887,"_28406":125587,"_3086":125724},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3696":74619,"_31230":74561,"_21622":125726,"_5":14887,"_28406":125587,"_3086":125727},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3696":74620,"_31230":74561,"_21622":125729,"_5":14887,"_28406":125587,"_3086":125730},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3696":74621,"_31230":74561,"_21622":125732,"_5":14887,"_28406":125587,"_3086":125733},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3696":74622,"_31230":74561,"_21622":125735,"_5":14887,"_28406":125591,"_3086":125736},[],"Comprobación",{"_3696":74623,"_31230":74561,"_21622":125738,"_5":14887,"_28406":125591,"_3086":125739},[],"Resultado esperado",{"_3696":74624,"_31230":74561,"_21622":125741,"_5":14887,"_28406":125591,"_3086":125742},[],"Registro",{"_3696":74625,"_31230":74561,"_21622":125744,"_5":14887,"_28406":125591,"_3086":125745},[],"ID creado automáticamente y DMS correcto.",{"_3696":74626,"_31230":74561,"_21622":125747,"_5":14887,"_28406":125591,"_3086":125032},[],{"_3696":74627,"_31230":74561,"_21622":125749,"_5":14887,"_28406":125591,"_3086":125750},[],"CN, perfil, serie y clave verificados.",{"_3696":74628,"_31230":74561,"_21622":125752,"_5":14887,"_28406":125591,"_3086":125753},[],"Inventario",{"_3696":74629,"_31230":74561,"_21622":125755,"_5":14887,"_28406":125591,"_3086":125756},[],"Serie recibida visible como identidad actual y en el historial.",{"_3696":74630,"_31230":74561,"_21622":125758,"_5":14887,"_28406":125591,"_3086":125759},[],"Consumidor",{"_3696":74631,"_31230":74561,"_21622":125761,"_5":14887,"_28406":125591,"_3086":125762},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3696":74632,"_31230":74561,"_21622":125764,"_5":14887,"_28406":125591,"_3086":125765},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3696":74633,"_31230":74561,"_21622":125767,"_5":14887,"_28406":125591,"_3086":125768},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3696":74634,"_31230":74634,"_5":15247,"_3086":123247,"_31588":125770,"_21622":125771,"_28406":74634},[51065,122085,53759,125557],[],{"_3696":74635,"_31230":74634,"_21622":125773,"_5":14887,"_28406":74634,"_3086":125774},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3696":74636,"_31230":74634,"_5":31585,"_21622":125776,"_28406":125777,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3696":74637,"_31230":74634,"_5":31585,"_21622":125779,"_28406":125780,"_3086":125781},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3696":74638,"_31230":74634,"_5":31585,"_21622":125783,"_28406":125784,"_3086":125785},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3696":74639,"_31230":74634,"_5":31585,"_21622":125787,"_28406":125788,"_3086":125789},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3696":74640,"_31230":74634,"_5":31585,"_21622":125791,"_28406":125792,"_3086":125793},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3696":74641,"_31230":74634,"_5":31585,"_21622":125795,"_28406":125796,"_3086":125797},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3696":74642,"_31230":74634,"_5":31585,"_21622":125799,"_28406":125800,"_3086":125739},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3696":74643,"_31230":74634,"_5":31585,"_21622":125802,"_28406":125803,"_3086":125804},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3696":74644,"_31230":74634,"_5":31585,"_21622":125806,"_28406":125807,"_3086":125808},[],"/docs/pr-preview/pr-80/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3696":74645,"_31230":74634,"_21622":125810,"_5":14887,"_28406":74634,"_3086":125811},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3696":74646,"_31230":74634,"_21622":125813,"_5":14887,"_28406":74634,"_3086":125814},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3696":74647,"_31230":74634,"_21622":125816,"_5":14887,"_28406":125777,"_3086":125817},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3696":74648,"_31230":74634,"_21622":125819,"_5":14887,"_28406":125777,"_3086":125820},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3696":74649,"_31230":74634,"_21622":125822,"_5":14887,"_28406":125777,"_3086":125823},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3696":74650,"_31230":74634,"_21622":125825,"_5":14887,"_28406":125777,"_3086":125826},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3696":74651,"_31230":74634,"_21622":125828,"_5":14887,"_28406":125780,"_3086":125829},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3696":74652,"_31230":74634,"_21622":125831,"_5":14887,"_28406":125780,"_3086":125832},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3696":74653,"_31230":74634,"_21622":125834,"_5":14887,"_28406":125780,"_3086":125835},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3696":74654,"_31230":74634,"_21622":125837,"_5":14887,"_28406":125780,"_3086":125838},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3696":74655,"_31230":74634,"_21622":125840,"_5":14887,"_28406":125780,"_3086":125841},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3696":74656,"_31230":74634,"_21622":125843,"_5":14887,"_28406":125780,"_3086":125844},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3696":74657,"_31230":74634,"_21622":125846,"_5":14887,"_28406":125780,"_3086":125847},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3696":74658,"_31230":74634,"_21622":125849,"_5":14887,"_28406":125780,"_3086":125850},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3696":74659,"_31230":74634,"_21622":125852,"_5":14887,"_28406":125784,"_3086":125853},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3696":74660,"_31230":74634,"_21622":125855,"_5":14887,"_28406":125784,"_3086":56507},[],{"_3696":74661,"_31230":74634,"_21622":125857,"_5":14887,"_28406":125784,"_3086":125858},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3696":74662,"_31230":74634,"_21622":125860,"_5":14887,"_28406":125784,"_3086":125861},[],"**Icon** y **Tags**: clasificación opcional.",{"_3696":74663,"_31230":74634,"_21622":125863,"_5":14887,"_28406":125784,"_3086":125864},[],"Confirma el registro.",{"_3696":74664,"_31230":74634,"_21622":125866,"_5":14887,"_28406":125788,"_3086":125867},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3696":74665,"_31230":74634,"_21622":125869,"_5":14887,"_28406":125788,"_3086":125870},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3696":74666,"_31230":74634,"_21622":125872,"_5":14887,"_28406":125792,"_3086":125873},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3696":74667,"_31230":74634,"_21622":125875,"_5":14887,"_28406":125792,"_3086":125876},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3696":74668,"_31230":74634,"_21622":125878,"_5":14887,"_28406":125796,"_3086":125879},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3696":74669,"_31230":74634,"_21622":125881,"_5":14887,"_28406":125796,"_3086":125882},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3696":74670,"_31230":74634,"_21622":125884,"_5":14887,"_28406":125800,"_3086":125736},[],{"_3696":74671,"_31230":74634,"_21622":125886,"_5":14887,"_28406":125800,"_3086":125887},[],"Resultado",{"_3696":74672,"_31230":74634,"_21622":125889,"_5":14887,"_28406":125800,"_3086":125018},[],{"_3696":74673,"_31230":74634,"_21622":125891,"_5":14887,"_28406":125800,"_3086":125892},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3696":74674,"_31230":74634,"_21622":125894,"_5":14887,"_28406":125800,"_3086":125895},[],"Identidad actual",{"_3696":74675,"_31230":74634,"_21622":125897,"_5":14887,"_28406":125800,"_3086":125898},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3696":74676,"_31230":74634,"_21622":125900,"_5":14887,"_28406":125800,"_3086":125901},[],"Historial",{"_3696":74677,"_31230":74634,"_21622":125903,"_5":14887,"_28406":125800,"_3086":125904},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3696":74678,"_31230":74634,"_21622":125906,"_5":14887,"_28406":125800,"_3086":125907},[],"Clave y certificado",{"_3696":74679,"_31230":74634,"_21622":125909,"_5":14887,"_28406":125800,"_3086":125910},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3696":74680,"_31230":74634,"_21622":125912,"_5":14887,"_28406":125803,"_3086":125913},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3696":74681,"_31230":74634,"_21622":125915,"_5":14887,"_28406":125803,"_3086":125916},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3696":74682,"_31230":74634,"_21622":125918,"_5":14887,"_28406":125803,"_3086":125919},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3696":74683,"_31230":74634,"_21622":125921,"_5":14887,"_28406":125803,"_3086":125922},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3696":74684,"_31230":74634,"_21622":125924,"_5":14887,"_28406":125807,"_3086":125925},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3696":74685,"_31230":74634,"_21622":125927,"_5":14887,"_28406":125807,"_3086":125928},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3696":74686,"_31230":74634,"_21622":125930,"_5":14887,"_28406":125807,"_3086":125931},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3696":74687,"_31230":74687,"_5":15247,"_3086":125933,"_31588":125934,"_21622":125935,"_28406":74687},"Plataforma Lamassu IoT",[51065,122085],[],{"_3696":74688,"_31230":74687,"_21622":125937,"_5":14887,"_28406":74687,"_3086":125938},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3696":74689,"_31230":74687,"_5":31585,"_21622":125940,"_28406":125941,"_3086":125433},[],"/docs/pr-preview/pr-80/es/platform/overview#empieza-aquí",{"_3696":74690,"_31230":74687,"_5":31585,"_21622":125943,"_28406":125944,"_3086":125945},[],"/docs/pr-preview/pr-80/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3696":74691,"_31230":74687,"_5":31585,"_21622":125947,"_28406":125948,"_3086":125949},[],"/docs/pr-preview/pr-80/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3696":74692,"_31230":74687,"_5":31585,"_21622":125951,"_28406":125952,"_3086":125953},[],"/docs/pr-preview/pr-80/es/platform/overview#capacidades-principales","Capacidades principales",{"_3696":74693,"_31230":74687,"_5":31585,"_21622":125955,"_28406":125956,"_3086":125957},[],"/docs/pr-preview/pr-80/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3696":74694,"_31230":74687,"_5":31585,"_21622":125959,"_28406":125960,"_3086":125961},[],"/docs/pr-preview/pr-80/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3696":74695,"_31230":74687,"_5":31585,"_21622":125963,"_28406":125964,"_3086":125965},[],"/docs/pr-preview/pr-80/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3696":74696,"_31230":74687,"_5":31585,"_21622":125967,"_28406":125968,"_3086":125969},[],"/docs/pr-preview/pr-80/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3696":74697,"_31230":74687,"_5":31585,"_21622":125971,"_28406":125972,"_3086":125973},[],"/docs/pr-preview/pr-80/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3696":74698,"_31230":74687,"_5":31585,"_21622":125975,"_28406":125976,"_3086":125977},[],"/docs/pr-preview/pr-80/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3696":74699,"_31230":74687,"_5":31585,"_21622":125979,"_28406":125980,"_3086":125981},[],"/docs/pr-preview/pr-80/es/platform/overview#referencia-operativa","Referencia operativa",{"_3696":74700,"_31230":74687,"_21622":125983,"_5":14887,"_28406":74687,"_3086":125984},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3696":74701,"_31230":74687,"_21622":125986,"_5":14887,"_28406":125941,"_3086":125987},[],"Elige el resultado que necesitas obtener:",{"_3696":74702,"_31230":74687,"_21622":125989,"_5":14887,"_28406":125941,"_3086":125990},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3696":74703,"_31230":74687,"_21622":125992,"_5":14887,"_28406":125941,"_3086":125993},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3696":74704,"_31230":74687,"_21622":125995,"_5":14887,"_28406":125941,"_3086":125996},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3696":74705,"_31230":74687,"_21622":125998,"_5":14887,"_28406":125944,"_3086":125999},[],"Bloque",{"_3696":74706,"_31230":74687,"_21622":126001,"_5":14887,"_28406":125944,"_3086":126002},[],"Qué gestionas",{"_3696":74707,"_31230":74687,"_21622":126004,"_5":14887,"_28406":125944,"_3086":126005},[],"Punto de entrada",{"_3696":74708,"_31230":74687,"_21622":126007,"_5":14887,"_28406":125944,"_3086":56660},[],{"_3696":74709,"_31230":74687,"_21622":126009,"_5":14887,"_28406":125944,"_3086":126010},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3696":74710,"_31230":74687,"_21622":126012,"_5":14887,"_28406":125944,"_3086":126013},[],"Visión general de PKI",{"_3696":74711,"_31230":74687,"_21622":126015,"_5":14887,"_28406":125944,"_3086":56669},[],{"_3696":74712,"_31230":74687,"_21622":126017,"_5":14887,"_28406":125944,"_3086":126018},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3696":74713,"_31230":74687,"_21622":126020,"_5":14887,"_28406":125944,"_3086":126021},[],"Visión general de IoT Fleets",{"_3696":74714,"_31230":74687,"_21622":126023,"_5":14887,"_28406":125944,"_3086":126024},[],"**Administración**",{"_3696":74715,"_31230":74687,"_21622":126026,"_5":14887,"_28406":125944,"_3086":126027},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3696":74716,"_31230":74687,"_21622":126029,"_5":14887,"_28406":125944,"_3086":122087},[],{"_3696":74717,"_31230":74687,"_21622":126031,"_5":14887,"_28406":125944,"_3086":126032},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3696":74718,"_31230":74687,"_21622":126034,"_5":14887,"_28406":125948,"_3086":126035},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3696":74719,"_31230":74687,"_21622":126037,"_5":14887,"_28406":125948,"_3086":126038},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3696":74720,"_31230":74687,"_21622":126040,"_5":14887,"_28406":125948,"_3086":126041},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3696":74721,"_31230":74687,"_21622":126043,"_5":14887,"_28406":125948,"_3086":126044},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3696":74722,"_31230":74687,"_21622":126046,"_5":14887,"_28406":125948,"_3086":126047},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3696":74723,"_31230":74687,"_21622":126049,"_5":14887,"_28406":125948,"_3086":126050},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3696":74724,"_31230":74687,"_21622":126052,"_5":14887,"_28406":125956,"_3086":126053},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3696":74725,"_31230":74687,"_21622":126055,"_5":14887,"_28406":125960,"_3086":126056},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3696":74726,"_31230":74687,"_21622":126058,"_5":14887,"_28406":125964,"_3086":126059},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3696":74727,"_31230":74687,"_21622":126061,"_5":14887,"_28406":125968,"_3086":126062},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3696":74728,"_31230":74687,"_21622":126064,"_5":14887,"_28406":125972,"_3086":126065},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3696":74729,"_31230":74687,"_21622":126067,"_5":14887,"_28406":125976,"_3086":126068},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3696":74730,"_31230":74687,"_21622":126070,"_5":14887,"_28406":125980,"_3086":125526},[],{"_3696":74731,"_31230":74687,"_21622":126072,"_5":14887,"_28406":125980,"_3086":126073},[],"Qué prepara o comprueba",{"_3696":74732,"_31230":74687,"_21622":126075,"_5":14887,"_28406":125980,"_3086":125529},[],{"_3696":74733,"_31230":74687,"_21622":126077,"_5":14887,"_28406":125980,"_3086":126078},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3696":74734,"_31230":74687,"_21622":126080,"_5":14887,"_28406":125980,"_3086":126081},[],"Administrador de la flota",{"_3696":74735,"_31230":74687,"_21622":126083,"_5":14887,"_28406":125980,"_3086":126084},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3696":74736,"_31230":74687,"_21622":126086,"_5":14887,"_28406":125980,"_3086":125541},[],{"_3696":74737,"_31230":74687,"_21622":126088,"_5":14887,"_28406":125980,"_3086":126089},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3696":74738,"_31230":74687,"_21622":126091,"_5":14887,"_28406":125980,"_3086":125547},[],{"_3696":74739,"_31230":74687,"_21622":126093,"_5":14887,"_28406":125980,"_3086":126094},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3696":74740,"_31230":74687,"_21622":126096,"_5":14887,"_28406":125980,"_3086":126097},[],"Operador de infraestructura",{"_3696":74741,"_31230":74687,"_21622":126099,"_5":14887,"_28406":125980,"_3086":126100},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3696":74742,"_31230":74687,"_21622":126102,"_5":14887,"_28406":125980,"_3086":126103},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3696":74743,"_31230":74743,"_5":15247,"_3086":126105,"_31588":126106,"_21622":126108,"_28406":74743},"Jerarquía y rotación de CAs",[51065,122085,56761,126107],"Claves, autoridades y certificados",[],{"_3696":74744,"_31230":74743,"_21622":126110,"_5":14887,"_28406":74743,"_3086":126111},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3696":74745,"_31230":74743,"_5":31585,"_21622":126113,"_28406":126114,"_3086":126115},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3696":74746,"_31230":74743,"_5":31585,"_21622":126117,"_28406":126118,"_3086":126119},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3696":74747,"_31230":74743,"_5":31585,"_21622":126121,"_28406":126122,"_3086":126123},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3696":74748,"_31230":74743,"_5":31585,"_21622":126125,"_28406":126126,"_3086":126127},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3696":74749,"_31230":74743,"_5":31585,"_21622":126129,"_28406":126130,"_3086":126131},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3696":74750,"_31230":74743,"_5":31585,"_21622":126133,"_28406":126134,"_3086":126135},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3696":74751,"_31230":74743,"_5":31585,"_21622":126137,"_28406":126138,"_3086":126139},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3696":74752,"_31230":74743,"_5":31585,"_21622":126141,"_28406":126142,"_3086":126143},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3696":74753,"_31230":74743,"_5":31585,"_21622":126145,"_28406":126146,"_3086":126147},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3696":74754,"_31230":74743,"_5":31585,"_21622":126149,"_28406":126150,"_3086":126151},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3696":74755,"_31230":74743,"_5":31585,"_21622":126153,"_28406":126154,"_3086":126155},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3696":74756,"_31230":74743,"_5":31585,"_21622":126157,"_28406":126158,"_3086":126159},[],"/docs/pr-preview/pr-80/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3696":74757,"_31230":74743,"_21622":126161,"_5":14887,"_28406":74743,"_3086":126162},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3696":74758,"_31230":74743,"_21622":126164,"_5":14887,"_28406":74743,"_3086":126165},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3696":74759,"_31230":74743,"_21622":126167,"_5":14887,"_28406":126114,"_3086":126168},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3696":74760,"_31230":74743,"_21622":126170,"_5":14887,"_28406":126114,"_3086":126171},[],"entorno, como producción y preproducción;",{"_3696":74761,"_31230":74743,"_21622":126173,"_5":14887,"_28406":126114,"_3086":126174},[],"propietario o equipo operador;",{"_3696":74762,"_31230":74743,"_21622":126176,"_5":14887,"_28406":126114,"_3086":126177},[],"familia de dispositivos o proceso de fabricación;",{"_3696":74763,"_31230":74743,"_21622":126179,"_5":14887,"_28406":126114,"_3086":126180},[],"región o requisito regulatorio;",{"_3696":74764,"_31230":74743,"_21622":126182,"_5":14887,"_28406":126114,"_3086":126183},[],"motor criptográfico o política de clave;",{"_3696":74765,"_31230":74743,"_21622":126185,"_5":14887,"_28406":126114,"_3086":126186},[],"ventana de mantenimiento y ritmo de renovación.",{"_3696":74766,"_31230":74743,"_21622":126188,"_5":14887,"_28406":126114,"_3086":126189},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3696":74767,"_31230":74743,"_21622":126191,"_5":14887,"_28406":126114,"_3086":126192},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3696":74768,"_31230":74743,"_21622":126194,"_5":14887,"_28406":126118,"_3086":126195},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3696":74769,"_31230":74743,"_21622":126197,"_5":14887,"_28406":126118,"_3086":126198},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3696":74770,"_31230":74743,"_21622":126200,"_5":14887,"_28406":126118,"_3086":126201},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3696":74771,"_31230":74743,"_21622":126203,"_5":14887,"_28406":126118,"_3086":126204},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3696":74772,"_31230":74743,"_21622":126206,"_5":14887,"_28406":126122,"_3086":126207},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3696":74773,"_31230":74743,"_21622":126209,"_5":14887,"_28406":126122,"_3086":126210},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3696":74774,"_31230":74743,"_21622":126212,"_5":14887,"_28406":126122,"_3086":126213},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3696":74775,"_31230":74743,"_21622":126215,"_5":14887,"_28406":126122,"_3086":126216},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3696":74776,"_31230":74743,"_21622":126218,"_5":14887,"_28406":126130,"_3086":126219},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3696":74777,"_31230":74743,"_21622":126221,"_5":14887,"_28406":126134,"_3086":126222},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3696":74778,"_31230":74743,"_21622":126224,"_5":14887,"_28406":126138,"_3086":126225},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3696":74779,"_31230":74743,"_21622":126227,"_5":14887,"_28406":126142,"_3086":126228},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3696":74780,"_31230":74743,"_21622":126230,"_5":14887,"_28406":126146,"_3086":126231},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3696":74781,"_31230":74743,"_21622":126233,"_5":14887,"_28406":126150,"_3086":126234},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3696":74782,"_31230":74743,"_21622":126236,"_5":14887,"_28406":126154,"_3086":126237},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3696":74783,"_31230":74743,"_21622":126239,"_5":14887,"_28406":126154,"_3086":126240},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3696":74784,"_31230":74743,"_21622":126242,"_5":14887,"_28406":126154,"_3086":126243},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3696":74785,"_31230":74743,"_21622":126245,"_5":14887,"_28406":126154,"_3086":126246},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3696":74786,"_31230":74743,"_21622":126248,"_5":14887,"_28406":126158,"_3086":126249},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3696":74787,"_31230":74743,"_21622":126251,"_5":14887,"_28406":126158,"_3086":126252},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3696":74788,"_31230":74743,"_21622":126254,"_5":14887,"_28406":126158,"_3086":126255},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3696":74789,"_31230":74743,"_21622":126257,"_5":14887,"_28406":126158,"_3086":126258},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3696":74790,"_31230":74743,"_21622":126260,"_5":14887,"_28406":126158,"_3086":126261},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3696":74791,"_31230":74743,"_21622":126263,"_5":14887,"_28406":126158,"_3086":126264},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3696":74792,"_31230":74743,"_21622":126266,"_5":14887,"_28406":126158,"_3086":126267},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3696":74793,"_31230":74793,"_5":15247,"_3086":126269,"_31588":126270,"_21622":126271,"_28406":74793},"Autoridades de certificación",[51065,122085,56761,126107],[],{"_3696":74794,"_31230":74793,"_21622":126273,"_5":14887,"_28406":74793,"_3086":126274},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3696":74795,"_31230":74793,"_5":31585,"_21622":126276,"_28406":126277,"_3086":126278},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3696":74796,"_31230":74793,"_5":31585,"_21622":126280,"_28406":126281,"_3086":126282},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3696":74797,"_31230":74793,"_5":31585,"_21622":126284,"_28406":126285,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3696":74798,"_31230":74793,"_5":31585,"_21622":126287,"_28406":126288,"_3086":126289},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3696":74799,"_31230":74793,"_5":31585,"_21622":126291,"_28406":126292,"_3086":126293},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3696":74800,"_31230":74793,"_5":31585,"_21622":126295,"_28406":126296,"_3086":126297},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3696":74801,"_31230":74793,"_5":31585,"_21622":126299,"_28406":126300,"_3086":126301},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3696":74802,"_31230":74793,"_5":31585,"_21622":126303,"_28406":126304,"_3086":126305},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3696":74803,"_31230":74793,"_5":31585,"_21622":126307,"_28406":126308,"_3086":126309},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3696":74804,"_31230":74793,"_5":31585,"_21622":126311,"_28406":126312,"_3086":126313},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3696":74805,"_31230":74793,"_5":31585,"_21622":126315,"_28406":126316,"_3086":126317},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3696":74806,"_31230":74793,"_5":31585,"_21622":126319,"_28406":126320,"_3086":126321},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3696":74807,"_31230":74793,"_5":31585,"_21622":126323,"_28406":126324,"_3086":126325},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3696":74808,"_31230":74793,"_5":31585,"_21622":126327,"_28406":126328,"_3086":126329},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3696":74809,"_31230":74793,"_5":31585,"_21622":126331,"_28406":126332,"_3086":126333},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3696":74810,"_31230":74793,"_5":31585,"_21622":126335,"_28406":126336,"_3086":126337},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3696":74811,"_31230":74793,"_5":31585,"_21622":126339,"_28406":126340,"_3086":126341},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3696":74812,"_31230":74793,"_5":31585,"_21622":126343,"_28406":126344,"_3086":126345},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3696":74813,"_31230":74793,"_5":31585,"_21622":126347,"_28406":126348,"_3086":126349},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3696":74814,"_31230":74793,"_5":31585,"_21622":126351,"_28406":126352,"_3086":126353},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3696":74815,"_31230":74793,"_5":31585,"_21622":126355,"_28406":126356,"_3086":126357},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3696":74816,"_31230":74793,"_5":31585,"_21622":126359,"_28406":126360,"_3086":126361},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3696":74817,"_31230":74793,"_5":31585,"_21622":126363,"_28406":126364,"_3086":126365},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3696":74818,"_31230":74793,"_5":31585,"_21622":126367,"_28406":126368,"_3086":126369},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3696":74819,"_31230":74793,"_21622":126371,"_5":14887,"_28406":74793,"_3086":126372},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3696":74820,"_31230":74793,"_21622":126374,"_5":14887,"_28406":74793,"_3086":126375},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3696":74821,"_31230":74793,"_21622":126377,"_5":14887,"_28406":74793,"_3086":126378},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3696":74822,"_31230":74793,"_21622":126380,"_5":14887,"_28406":126277,"_3086":126381},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3696":74823,"_31230":74793,"_21622":126383,"_5":14887,"_28406":126277,"_3086":126384},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3696":74824,"_31230":74793,"_21622":126386,"_5":14887,"_28406":126277,"_3086":126387},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3696":74825,"_31230":74793,"_21622":126389,"_5":14887,"_28406":126277,"_3086":126390},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3696":74826,"_31230":74793,"_21622":126392,"_5":14887,"_28406":126277,"_3086":126393},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3696":74827,"_31230":74793,"_21622":126395,"_5":14887,"_28406":126285,"_3086":126396},[],"Decide si la CA será raíz o intermedia.",{"_3696":74828,"_31230":74793,"_21622":126398,"_5":14887,"_28406":126285,"_3086":126399},[],"Elige el motor que custodiará la clave.",{"_3696":74829,"_31230":74793,"_21622":126401,"_5":14887,"_28406":126285,"_3086":126402},[],"Define una validez superior a la de los certificados que emitirá.",{"_3696":74830,"_31230":74793,"_21622":126404,"_5":14887,"_28406":126285,"_3086":126405},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3696":74831,"_31230":74793,"_21622":126407,"_5":14887,"_28406":126288,"_3086":126408},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3696":74832,"_31230":74793,"_21622":126410,"_5":14887,"_28406":126292,"_3086":126411},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3696":74833,"_31230":74793,"_21622":126413,"_5":14887,"_28406":126292,"_3086":126414},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3696":74834,"_31230":74793,"_21622":126416,"_5":14887,"_28406":126296,"_3086":126417},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3696":74835,"_31230":74793,"_21622":126419,"_5":14887,"_28406":126300,"_3086":126420},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3696":74836,"_31230":74793,"_21622":126422,"_5":14887,"_28406":126300,"_3086":126423},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3696":74837,"_31230":74793,"_21622":126425,"_5":14887,"_28406":126300,"_3086":126426},[],"`ST`: estado o provincia.",{"_3696":74838,"_31230":74793,"_21622":126428,"_5":14887,"_28406":126300,"_3086":126429},[],"`L`: localidad.",{"_3696":74839,"_31230":74793,"_21622":126431,"_5":14887,"_28406":126300,"_3086":126432},[],"`O`: organización.",{"_3696":74840,"_31230":74793,"_21622":126434,"_5":14887,"_28406":126300,"_3086":126435},[],"`OU`: unidad organizativa.",{"_3696":74841,"_31230":74793,"_21622":126437,"_5":14887,"_28406":126300,"_3086":126438},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3696":74842,"_31230":74793,"_21622":126440,"_5":14887,"_28406":126304,"_3086":126441},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3696":74843,"_31230":74793,"_21622":126443,"_5":14887,"_28406":126304,"_3086":126444},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3696":74844,"_31230":74793,"_21622":126446,"_5":14887,"_28406":126308,"_3086":126447},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3696":74845,"_31230":74793,"_21622":126449,"_5":14887,"_28406":126308,"_3086":126450},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3696":74846,"_31230":74793,"_21622":126452,"_5":14887,"_28406":126312,"_3086":126453},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3696":74847,"_31230":74793,"_21622":126455,"_5":14887,"_28406":126312,"_3086":126456},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3696":74848,"_31230":74793,"_21622":126458,"_5":14887,"_28406":126316,"_3086":126459},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3696":74849,"_31230":74793,"_21622":126461,"_5":14887,"_28406":126316,"_3086":126462},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3696":74850,"_31230":74793,"_21622":126464,"_5":14887,"_28406":126316,"_3086":126465},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3696":74851,"_31230":74793,"_21622":126467,"_5":14887,"_28406":126316,"_3086":126468},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3696":74852,"_31230":74793,"_21622":126470,"_5":14887,"_28406":126320,"_3086":126471},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3696":74853,"_31230":74793,"_21622":126473,"_5":14887,"_28406":126324,"_3086":126474},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3696":74854,"_31230":74793,"_21622":126476,"_5":14887,"_28406":126324,"_3086":126477},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3696":74855,"_31230":74793,"_21622":126479,"_5":14887,"_28406":126328,"_3086":126480},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3696":74856,"_31230":74793,"_21622":126482,"_5":14887,"_28406":126332,"_3086":126483},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3696":74857,"_31230":74793,"_21622":126485,"_5":14887,"_28406":126332,"_3086":126486},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3696":74858,"_31230":74793,"_21622":126488,"_5":14887,"_28406":126332,"_3086":126489},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3696":74859,"_31230":74793,"_21622":126491,"_5":14887,"_28406":126336,"_3086":126492},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3696":74860,"_31230":74793,"_21622":126494,"_5":14887,"_28406":126336,"_3086":126495},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3696":74861,"_31230":74793,"_21622":126497,"_5":14887,"_28406":126336,"_3086":126498},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3696":74862,"_31230":74793,"_21622":126500,"_5":14887,"_28406":126336,"_3086":126501},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3696":74863,"_31230":74793,"_21622":126503,"_5":14887,"_28406":126340,"_3086":126504},[],"Abre una CA desde el inventario para consultar:",{"_3696":74864,"_31230":74793,"_21622":126506,"_5":14887,"_28406":126340,"_3086":126507},[],"Estado y periodo de validez.",{"_3696":74865,"_31230":74793,"_21622":126509,"_5":14887,"_28406":126340,"_3086":126510},[],"Certificado y cadena en formato PEM.",{"_3696":74866,"_31230":74793,"_21622":126512,"_5":14887,"_28406":126340,"_3086":126513},[],"Número de certificados activos, expirados y revocados.",{"_3696":74867,"_31230":74793,"_21622":126515,"_5":14887,"_28406":126340,"_3086":126516},[],"Certificados emitidos en **Issued Certificates**.",{"_3696":74868,"_31230":74793,"_21622":126518,"_5":14887,"_28406":126340,"_3086":126519},[],"CRL vinculada a la autoridad.",{"_3696":74869,"_31230":74793,"_21622":126521,"_5":14887,"_28406":126340,"_3086":126522},[],"Metadatos y motor criptográfico asociado.",{"_3696":74870,"_31230":74793,"_21622":126524,"_5":14887,"_28406":126340,"_3086":126525},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3696":74871,"_31230":74793,"_21622":126527,"_5":14887,"_28406":126344,"_3086":126528},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3696":74872,"_31230":74793,"_21622":126530,"_5":14887,"_28406":126344,"_3086":126531},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3696":74873,"_31230":74793,"_21622":126533,"_5":14887,"_28406":126344,"_3086":126534},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3696":74874,"_31230":74793,"_21622":126536,"_5":14887,"_28406":126344,"_3086":126537},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3696":74875,"_31230":74793,"_21622":126539,"_5":14887,"_28406":126344,"_3086":126540},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3696":74876,"_31230":74793,"_21622":126542,"_5":14887,"_28406":126344,"_3086":126543},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3696":74877,"_31230":74793,"_21622":126545,"_5":14887,"_28406":126348,"_3086":126546},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3696":74878,"_31230":74793,"_21622":126548,"_5":14887,"_28406":126352,"_3086":126549},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3696":74879,"_31230":74793,"_21622":126551,"_5":14887,"_28406":126356,"_3086":126552},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3696":74880,"_31230":74793,"_21622":126554,"_5":14887,"_28406":126360,"_3086":126555},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3696":74881,"_31230":74793,"_21622":126557,"_5":14887,"_28406":126364,"_3086":126558},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3696":74882,"_31230":74793,"_21622":126560,"_5":14887,"_28406":126368,"_3086":126561},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3696":74883,"_31230":74793,"_21622":126563,"_5":14887,"_28406":126368,"_3086":126564},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3696":74884,"_31230":74793,"_21622":126566,"_5":14887,"_28406":126368,"_3086":126567},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3696":74885,"_31230":74793,"_21622":126569,"_5":14887,"_28406":126368,"_3086":126570},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3696":74886,"_31230":74793,"_21622":126572,"_5":14887,"_28406":126368,"_3086":126573},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3696":74887,"_31230":74887,"_5":15247,"_3086":126575,"_31588":126576,"_21622":126577,"_28406":74887},"Perfiles de certificado",[51065,122085,56761,126107],[],{"_3696":74888,"_31230":74887,"_21622":126579,"_5":14887,"_28406":74887,"_3086":126580},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3696":74889,"_31230":74887,"_5":31585,"_21622":126582,"_28406":126583,"_3086":126584},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3696":74890,"_31230":74887,"_5":31585,"_21622":126586,"_28406":126587,"_3086":126588},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#validez","Validez",{"_3696":74891,"_31230":74887,"_5":31585,"_21622":126590,"_28406":126591,"_3086":126592},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3696":74892,"_31230":74887,"_5":31585,"_21622":126594,"_28406":126595,"_3086":126596},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3696":74893,"_31230":74887,"_5":31585,"_21622":126598,"_28406":126599,"_3086":126600},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3696":74894,"_31230":74887,"_5":31585,"_21622":126602,"_28406":126603,"_3086":126604},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3696":74895,"_31230":74887,"_5":31585,"_21622":126606,"_28406":126607,"_3086":126608},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3696":74896,"_31230":74887,"_5":31585,"_21622":126610,"_28406":126611,"_3086":126612},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3696":74897,"_31230":74887,"_5":31585,"_21622":126614,"_28406":126615,"_3086":126616},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3696":74898,"_31230":74887,"_5":31585,"_21622":126618,"_28406":126619,"_3086":126620},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3696":74899,"_31230":74887,"_5":31585,"_21622":126622,"_28406":126623,"_3086":126624},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3696":74900,"_31230":74887,"_5":31585,"_21622":126626,"_28406":126627,"_3086":126628},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3696":74901,"_31230":74887,"_5":31585,"_21622":126630,"_28406":126631,"_3086":126632},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3696":74902,"_31230":74887,"_5":31585,"_21622":126634,"_28406":126635,"_3086":126636},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3696":74903,"_31230":74887,"_5":31585,"_21622":126638,"_28406":126639,"_3086":126640},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3696":74904,"_31230":74887,"_5":31585,"_21622":126642,"_28406":126643,"_3086":126644},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3696":74905,"_31230":74887,"_21622":126646,"_5":14887,"_28406":74887,"_3086":126647},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3696":74906,"_31230":74887,"_21622":126649,"_5":14887,"_28406":74887,"_3086":126650},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3696":74907,"_31230":74887,"_21622":126652,"_5":14887,"_28406":126587,"_3086":126653},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3696":74908,"_31230":74887,"_21622":126655,"_5":14887,"_28406":126587,"_3086":126656},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3696":74909,"_31230":74887,"_21622":126658,"_5":14887,"_28406":126591,"_3086":126659},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3696":74910,"_31230":74887,"_21622":126661,"_5":14887,"_28406":126595,"_3086":126662},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3696":74911,"_31230":74887,"_21622":126664,"_5":14887,"_28406":126595,"_3086":126665},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3696":74912,"_31230":74887,"_21622":126667,"_5":14887,"_28406":126595,"_3086":126668},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3696":74913,"_31230":74887,"_21622":126670,"_5":14887,"_28406":126599,"_3086":126671},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3696":74914,"_31230":74887,"_21622":126673,"_5":14887,"_28406":126603,"_3086":126674},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3696":74915,"_31230":74887,"_21622":126676,"_5":14887,"_28406":126603,"_3086":126677},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3696":74916,"_31230":74887,"_21622":126679,"_5":14887,"_28406":126607,"_3086":126680},[],"La aplicación criptográfica puede:",{"_3696":74917,"_31230":74887,"_21622":126682,"_5":14887,"_28406":126607,"_3086":126683},[],"permitir o bloquear claves RSA;",{"_3696":74918,"_31230":74887,"_21622":126685,"_5":14887,"_28406":126607,"_3086":126686},[],"limitar los tamaños RSA admitidos;",{"_3696":74919,"_31230":74887,"_21622":126688,"_5":14887,"_28406":126607,"_3086":126689},[],"permitir o bloquear claves ECDSA;",{"_3696":74920,"_31230":74887,"_21622":126691,"_5":14887,"_28406":126607,"_3086":126692},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3696":74921,"_31230":74887,"_21622":126694,"_5":14887,"_28406":126607,"_3086":126695},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3696":74922,"_31230":74887,"_21622":126697,"_5":14887,"_28406":126611,"_3086":126698},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3696":74923,"_31230":74887,"_21622":126700,"_5":14887,"_28406":126611,"_3086":121845},[],{"_3696":74924,"_31230":74887,"_21622":126702,"_5":14887,"_28406":126611,"_3086":126703},[],"Primera opción",{"_3696":74925,"_31230":74887,"_21622":126705,"_5":14887,"_28406":126611,"_3086":126706},[],"Segunda opción",{"_3696":74926,"_31230":74887,"_21622":126708,"_5":14887,"_28406":126611,"_3086":126709},[],"Si no hay ninguna",{"_3696":74927,"_31230":74887,"_21622":126711,"_5":14887,"_28406":126611,"_3086":126712},[],"Firma directa con una CA",{"_3696":74928,"_31230":74887,"_21622":126714,"_5":14887,"_28406":126611,"_3086":126715},[],"`issuance_profile` incluido en la solicitud",{"_3696":74929,"_31230":74887,"_21622":126717,"_5":14887,"_28406":126611,"_3086":126718},[],"`issuance_profile_id` de la solicitud",{"_3696":74930,"_31230":74887,"_21622":126720,"_5":14887,"_28406":126611,"_3086":126721},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3696":74931,"_31230":74887,"_21622":126723,"_5":14887,"_28406":126611,"_3086":126724},[],"Emisión mediante DMS",{"_3696":74932,"_31230":74887,"_21622":126726,"_5":14887,"_28406":126611,"_3086":57382},[],{"_3696":74933,"_31230":74887,"_21622":126728,"_5":14887,"_28406":126611,"_3086":126729},[],"`settings.issuance_profile` incluido en el DMS",{"_3696":74934,"_31230":74887,"_21622":126731,"_5":14887,"_28406":126611,"_3086":126732},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3696":74935,"_31230":74887,"_21622":126734,"_5":14887,"_28406":126611,"_3086":126735},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3696":74936,"_31230":74887,"_21622":126737,"_5":14887,"_28406":126611,"_3086":126738},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3696":74937,"_31230":74887,"_21622":126740,"_5":14887,"_28406":126619,"_3086":126741},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3696":74938,"_31230":74887,"_21622":126743,"_5":14887,"_28406":126623,"_3086":126744},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3696":74939,"_31230":74887,"_21622":126746,"_5":14887,"_28406":126627,"_3086":126747},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3696":74940,"_31230":74887,"_21622":126749,"_5":14887,"_28406":126631,"_3086":126750},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3696":74941,"_31230":74887,"_21622":126752,"_5":14887,"_28406":126635,"_3086":126753},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3696":74942,"_31230":74887,"_21622":126755,"_5":14887,"_28406":126635,"_3086":126756},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3696":74943,"_31230":74887,"_21622":126758,"_5":14887,"_28406":126639,"_3086":126759},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3696":74944,"_31230":74887,"_21622":126761,"_5":14887,"_28406":126639,"_3086":126762},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3696":74945,"_31230":74887,"_21622":126764,"_5":14887,"_28406":126639,"_3086":126765},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3696":74946,"_31230":74887,"_21622":126767,"_5":14887,"_28406":126639,"_3086":126768},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3696":74947,"_31230":74887,"_21622":126770,"_5":14887,"_28406":126643,"_3086":126771},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3696":74948,"_31230":74887,"_21622":126773,"_5":14887,"_28406":126643,"_3086":126774},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3696":74949,"_31230":74949,"_5":15247,"_3086":126776,"_31588":126777,"_21622":126779,"_28406":74949},"Validación de certificados",[51065,122085,56761,126778],"Validación",[],{"_3696":74950,"_31230":74949,"_21622":126781,"_5":14887,"_28406":74949,"_3086":126782},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3696":74951,"_31230":74949,"_5":31585,"_21622":126784,"_28406":126785,"_3086":126786},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3696":74952,"_31230":74949,"_5":31585,"_21622":126788,"_28406":126789,"_3086":126790},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3696":74953,"_31230":74949,"_5":31585,"_21622":126792,"_28406":126793,"_3086":126794},[],"/docs/pr-preview/pr-80/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3696":74954,"_31230":74949,"_21622":126796,"_5":14887,"_28406":74949,"_3086":126797},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3696":74955,"_31230":74949,"_21622":126799,"_5":14887,"_28406":126785,"_3086":126800},[],"Verifica estos criterios juntos:",{"_3696":74956,"_31230":74949,"_21622":126802,"_5":14887,"_28406":126785,"_3086":125736},[],{"_3696":74957,"_31230":74949,"_21622":126804,"_5":14887,"_28406":126785,"_3086":126805},[],"Resultado necesario",{"_3696":74958,"_31230":74949,"_21622":126807,"_5":14887,"_28406":126785,"_3086":126808},[],"Cadena y firma",{"_3696":74959,"_31230":74949,"_21622":126810,"_5":14887,"_28406":126785,"_3086":126811},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3696":74960,"_31230":74949,"_21622":126813,"_5":14887,"_28406":126785,"_3086":126814},[],"Fechas",{"_3696":74961,"_31230":74949,"_21622":126816,"_5":14887,"_28406":126785,"_3086":126817},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3696":74962,"_31230":74949,"_21622":126819,"_5":14887,"_28406":126785,"_3086":121755},[],{"_3696":74963,"_31230":74949,"_21622":126821,"_5":14887,"_28406":126785,"_3086":126822},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3696":74964,"_31230":74949,"_21622":126824,"_5":14887,"_28406":126785,"_3086":126825},[],"Uso",{"_3696":74965,"_31230":74949,"_21622":126827,"_5":14887,"_28406":126785,"_3086":126828},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3696":74966,"_31230":74949,"_21622":126830,"_5":14887,"_28406":126785,"_3086":126831},[],"Revocación",{"_3696":74967,"_31230":74949,"_21622":126833,"_5":14887,"_28406":126785,"_3086":126834},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3696":74968,"_31230":74949,"_21622":126836,"_5":14887,"_28406":126785,"_3086":126837},[],"Autorización",{"_3696":74969,"_31230":74949,"_21622":126839,"_5":14887,"_28406":126785,"_3086":126840},[],"La aplicación permite la acción a esa identidad.",{"_3696":74970,"_31230":74949,"_21622":126842,"_5":14887,"_28406":126785,"_3086":126843},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3696":74971,"_31230":74949,"_21622":126845,"_5":14887,"_28406":126789,"_3086":126846},[],"Mecanismo",{"_3696":74972,"_31230":74949,"_21622":126848,"_5":14887,"_28406":126789,"_3086":126849},[],"Cuándo utilizarlo",{"_3696":74973,"_31230":74949,"_21622":126851,"_5":14887,"_28406":126789,"_3086":126852},[],"Qué debes mantener",{"_3696":74974,"_31230":74949,"_21622":126854,"_5":14887,"_28406":126789,"_3086":57510},[],{"_3696":74975,"_31230":74949,"_21622":126856,"_5":14887,"_28406":126789,"_3086":126857},[],"Consulta del estado de un certificado concreto.",{"_3696":74976,"_31230":74949,"_21622":126859,"_5":14887,"_28406":126789,"_3086":126860},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3696":74977,"_31230":74949,"_21622":126862,"_5":14887,"_28406":126789,"_3086":57519},[],{"_3696":74978,"_31230":74949,"_21622":126864,"_5":14887,"_28406":126789,"_3086":126865},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3696":74979,"_31230":74949,"_21622":126867,"_5":14887,"_28406":126789,"_3086":126868},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3696":74980,"_31230":74949,"_21622":126870,"_5":14887,"_28406":126789,"_3086":126871},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3696":74981,"_31230":74949,"_21622":126873,"_5":14887,"_28406":126789,"_3086":126874},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3696":74982,"_31230":74949,"_21622":126876,"_5":14887,"_28406":126793,"_3086":126877},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3696":74983,"_31230":74949,"_21622":126879,"_5":14887,"_28406":126793,"_3086":126880},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3696":74984,"_31230":74949,"_21622":126882,"_5":14887,"_28406":126793,"_3086":126883},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3696":74985,"_31230":74949,"_21622":126885,"_5":14887,"_28406":126793,"_3086":126886},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3696":74986,"_31230":74949,"_21622":126888,"_5":14887,"_28406":126793,"_3086":126889},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3696":74987,"_31230":74949,"_21622":126891,"_5":14887,"_28406":126793,"_3086":126892},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3696":74988,"_31230":74949,"_21622":126894,"_5":14887,"_28406":126793,"_3086":126895},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3696":74989,"_31230":74949,"_21622":126897,"_5":14887,"_28406":126793,"_3086":126898},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3696":74990,"_31230":74949,"_21622":126900,"_5":14887,"_28406":126793,"_3086":126901},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3696":74991,"_31230":74991,"_5":15247,"_3086":126903,"_31588":126904,"_21622":126905,"_28406":74991},"Certificados",[51065,122085,56761,126107],[],{"_3696":74992,"_31230":74991,"_21622":126907,"_5":14887,"_28406":74991,"_3086":126908},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3696":74993,"_31230":74991,"_5":31585,"_21622":126910,"_28406":126911,"_3086":126912},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3696":74994,"_31230":74991,"_5":31585,"_21622":126914,"_28406":126915,"_3086":126916},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3696":74995,"_31230":74991,"_5":31585,"_21622":126918,"_28406":126919,"_3086":126920},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3696":74996,"_31230":74991,"_5":31585,"_21622":126922,"_28406":126923,"_3086":126924},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3696":74997,"_31230":74991,"_5":31585,"_21622":126926,"_28406":126927,"_3086":126928},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3696":74998,"_31230":74991,"_5":31585,"_21622":126930,"_28406":126931,"_3086":126932},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3696":74999,"_31230":74991,"_5":31585,"_21622":126934,"_28406":126935,"_3086":126936},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3696":75000,"_31230":74991,"_5":31585,"_21622":126938,"_28406":126939,"_3086":126940},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3696":75001,"_31230":74991,"_5":31585,"_21622":126942,"_28406":126943,"_3086":126944},[],"/docs/pr-preview/pr-80/es/platform/pki/certificates#continúa","Continúa",{"_3696":75002,"_31230":74991,"_21622":126946,"_5":14887,"_28406":74991,"_3086":126947},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3696":75003,"_31230":74991,"_21622":126949,"_5":14887,"_28406":126911,"_3086":126950},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3696":75004,"_31230":74991,"_21622":126952,"_5":14887,"_28406":126911,"_3086":126953},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3696":75005,"_31230":74991,"_21622":126955,"_5":14887,"_28406":126911,"_3086":126956},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3696":75006,"_31230":74991,"_21622":126958,"_5":14887,"_28406":126911,"_3086":126959},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3696":75007,"_31230":74991,"_21622":126961,"_5":14887,"_28406":126911,"_3086":126962},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3696":75008,"_31230":74991,"_21622":126964,"_5":14887,"_28406":126911,"_3086":126965},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3696":75009,"_31230":74991,"_21622":126967,"_5":14887,"_28406":126911,"_3086":126968},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3696":75010,"_31230":74991,"_21622":126970,"_5":14887,"_28406":126915,"_3086":126971},[],"Descarga el PEM e inspecciónalo:",{"_3696":75011,"_31230":74991,"_21622":126973,"_5":14887,"_28406":126915,"_3086":126974},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3696":75012,"_31230":74991,"_21622":126976,"_5":14887,"_28406":126919,"_3086":126977},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3696":75013,"_31230":74991,"_21622":126979,"_5":14887,"_28406":126919,"_3086":126980},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3696":75014,"_31230":74991,"_21622":126982,"_5":14887,"_28406":126919,"_3086":126983},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3696":75015,"_31230":74991,"_21622":126985,"_5":14887,"_28406":126919,"_3086":126986},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3696":75016,"_31230":74991,"_21622":126988,"_5":14887,"_28406":126919,"_3086":126989},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3696":75017,"_31230":74991,"_21622":126991,"_5":14887,"_28406":126919,"_3086":126992},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3696":75018,"_31230":74991,"_21622":126994,"_5":14887,"_28406":126919,"_3086":126995},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3696":75019,"_31230":74991,"_21622":126997,"_5":14887,"_28406":126923,"_3086":126998},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3696":75020,"_31230":74991,"_21622":127000,"_5":14887,"_28406":126927,"_3086":127001},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3696":75021,"_31230":74991,"_21622":127003,"_5":14887,"_28406":126931,"_3086":127004},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3696":75022,"_31230":74991,"_21622":127006,"_5":14887,"_28406":126935,"_3086":127007},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3696":75023,"_31230":74991,"_21622":127009,"_5":14887,"_28406":126935,"_3086":127010},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3696":75024,"_31230":74991,"_21622":127012,"_5":14887,"_28406":126935,"_3086":127013},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3696":75025,"_31230":74991,"_21622":127015,"_5":14887,"_28406":126939,"_3086":127016},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3696":75026,"_31230":74991,"_21622":127018,"_5":14887,"_28406":126939,"_3086":127019},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3696":75027,"_31230":74991,"_21622":127021,"_5":14887,"_28406":126939,"_3086":127022},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3696":75028,"_31230":74991,"_21622":127024,"_5":14887,"_28406":126943,"_3086":127025},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3696":75029,"_31230":74991,"_21622":127027,"_5":14887,"_28406":126943,"_3086":127028},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3696":75030,"_31230":75030,"_5":15247,"_3086":127030,"_31588":127031,"_21622":127033,"_28406":75030},"Ciclo de vida de un certificado",[51065,122085,56761,127032],"Conceptos",[],{"_3696":75031,"_31230":75030,"_21622":127035,"_5":14887,"_28406":75030,"_3086":127036},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3696":75032,"_31230":75030,"_5":31585,"_21622":127038,"_28406":127039,"_3086":127040},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3696":75033,"_31230":75030,"_5":31585,"_21622":127042,"_28406":127043,"_3086":127044},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3696":75034,"_31230":75030,"_5":31585,"_21622":127046,"_28406":127047,"_3086":127048},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3696":75035,"_31230":75030,"_5":31585,"_21622":127050,"_28406":127051,"_3086":127052},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3696":75036,"_31230":75030,"_5":31585,"_21622":127054,"_28406":127055,"_3086":127056},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3696":75037,"_31230":75030,"_5":31585,"_21622":127058,"_28406":127059,"_3086":127060},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3696":75038,"_31230":75030,"_5":31585,"_21622":127062,"_28406":127063,"_3086":124730},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3696":75039,"_31230":75030,"_5":31585,"_21622":127065,"_28406":127066,"_3086":127067},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3696":75040,"_31230":75030,"_5":31585,"_21622":127069,"_28406":127070,"_3086":127071},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3696":75041,"_31230":75030,"_5":31585,"_21622":127073,"_28406":127074,"_3086":127075},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3696":75042,"_31230":75030,"_21622":127077,"_5":14887,"_28406":75030,"_3086":127078},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3696":75043,"_31230":75030,"_21622":127080,"_5":14887,"_28406":127043,"_3086":127081},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3696":75044,"_31230":75030,"_21622":127083,"_5":14887,"_28406":127047,"_3086":127084},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3696":75045,"_31230":75030,"_21622":127086,"_5":14887,"_28406":127051,"_3086":127087},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3696":75046,"_31230":75030,"_21622":127089,"_5":14887,"_28406":127055,"_3086":127090},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3696":75047,"_31230":75030,"_21622":127092,"_5":14887,"_28406":127059,"_3086":127093},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3696":75048,"_31230":75030,"_21622":127095,"_5":14887,"_28406":127063,"_3086":127096},[],"Lamassu persiste cuatro estados X.509:",{"_3696":75049,"_31230":75030,"_21622":127098,"_5":14887,"_28406":127063,"_3086":127099},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3696":75050,"_31230":75030,"_21622":127101,"_5":14887,"_28406":127063,"_3086":127102},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3696":75051,"_31230":75030,"_21622":127104,"_5":14887,"_28406":127063,"_3086":127105},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3696":75052,"_31230":75030,"_21622":127107,"_5":14887,"_28406":127063,"_3086":127108},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3696":75053,"_31230":75030,"_21622":127110,"_5":14887,"_28406":127063,"_3086":127111},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3696":75054,"_31230":75030,"_21622":127113,"_5":14887,"_28406":127066,"_3086":127114},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3696":75055,"_31230":75030,"_21622":127116,"_5":14887,"_28406":127066,"_3086":127117},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3696":75056,"_31230":75030,"_21622":127119,"_5":14887,"_28406":127066,"_3086":127120},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3696":75057,"_31230":75030,"_21622":127122,"_5":14887,"_28406":127070,"_3086":127123},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3696":75058,"_31230":75030,"_21622":127125,"_5":14887,"_28406":127070,"_3086":127126},[],"Antes de confirmar:",{"_3696":75059,"_31230":75030,"_21622":127128,"_5":14887,"_28406":127070,"_3086":127129},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3696":75060,"_31230":75030,"_21622":127131,"_5":14887,"_28406":127070,"_3086":127132},[],"Distribuye la nueva cadena de confianza.",{"_3696":75061,"_31230":75030,"_21622":127134,"_5":14887,"_28406":127070,"_3086":127135},[],"Reemite las identidades necesarias.",{"_3696":75062,"_31230":75030,"_21622":127137,"_5":14887,"_28406":127070,"_3086":127138},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3696":75063,"_31230":75030,"_21622":127140,"_5":14887,"_28406":127070,"_3086":127141},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3696":75064,"_31230":75030,"_21622":127143,"_5":14887,"_28406":127070,"_3086":127144},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3696":75065,"_31230":75030,"_21622":127146,"_5":14887,"_28406":127074,"_3086":127147},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3696":75066,"_31230":75030,"_21622":127149,"_5":14887,"_28406":127074,"_3086":127150},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3696":75067,"_31230":75030,"_21622":127152,"_5":14887,"_28406":127074,"_3086":127153},[],"Cambios de estado y razones de revocación.",{"_3696":75068,"_31230":75030,"_21622":127155,"_5":14887,"_28406":127074,"_3086":127156},[],"Publicación y vigencia de OCSP y CRLs.",{"_3696":75069,"_31230":75030,"_21622":127158,"_5":14887,"_28406":127074,"_3086":127159},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3696":75070,"_31230":75030,"_21622":127161,"_5":14887,"_28406":127074,"_3086":127162},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3696":75071,"_31230":75071,"_5":15247,"_3086":127164,"_31588":127165,"_21622":127166,"_28406":75071},"Modelo de confianza",[51065,122085,56761,127032],[],{"_3696":75072,"_31230":75071,"_21622":127168,"_5":14887,"_28406":75071,"_3086":127169},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3696":75073,"_31230":75071,"_5":31585,"_21622":127171,"_28406":127172,"_3086":127173},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3696":75074,"_31230":75071,"_5":31585,"_21622":127175,"_28406":127176,"_3086":127177},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3696":75075,"_31230":75071,"_5":31585,"_21622":127179,"_28406":127180,"_3086":127181},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3696":75076,"_31230":75071,"_5":31585,"_21622":127183,"_28406":127184,"_3086":127185},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3696":75077,"_31230":75071,"_5":31585,"_21622":127187,"_28406":127188,"_3086":127189},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3696":75078,"_31230":75071,"_5":31585,"_21622":127191,"_28406":127192,"_3086":127193},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3696":75079,"_31230":75071,"_5":31585,"_21622":127195,"_28406":127196,"_3086":127197},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3696":75080,"_31230":75071,"_5":31585,"_21622":127199,"_28406":127200,"_3086":127201},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3696":75081,"_31230":75071,"_5":31585,"_21622":127203,"_28406":127204,"_3086":127205},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3696":75082,"_31230":75071,"_5":31585,"_21622":127207,"_28406":127208,"_3086":127209},[],"/docs/pr-preview/pr-80/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3696":75083,"_31230":75071,"_21622":127211,"_5":14887,"_28406":75071,"_3086":127212},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3696":75084,"_31230":75071,"_21622":127214,"_5":14887,"_28406":127176,"_3086":127215},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3696":75085,"_31230":75071,"_21622":127217,"_5":14887,"_28406":127180,"_3086":127218},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3696":75086,"_31230":75071,"_21622":127220,"_5":14887,"_28406":127184,"_3086":127221},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3696":75087,"_31230":75071,"_21622":127223,"_5":14887,"_28406":127188,"_3086":127224},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3696":75088,"_31230":75071,"_21622":127226,"_5":14887,"_28406":127192,"_3086":127227},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3696":75089,"_31230":75071,"_21622":127229,"_5":14887,"_28406":127192,"_3086":127230},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3696":75090,"_31230":75071,"_21622":127232,"_5":14887,"_28406":127192,"_3086":127233},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3696":75091,"_31230":75071,"_21622":127235,"_5":14887,"_28406":127192,"_3086":127236},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3696":75092,"_31230":75071,"_21622":127238,"_5":14887,"_28406":127192,"_3086":127239},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3696":75093,"_31230":75071,"_21622":127241,"_5":14887,"_28406":127192,"_3086":127242},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3696":75094,"_31230":75071,"_21622":127244,"_5":14887,"_28406":127196,"_3086":127245},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3696":75095,"_31230":75071,"_21622":127247,"_5":14887,"_28406":127196,"_3086":127248},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3696":75096,"_31230":75071,"_21622":127250,"_5":14887,"_28406":127196,"_3086":127251},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3696":75097,"_31230":75071,"_21622":127253,"_5":14887,"_28406":127196,"_3086":127254},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3696":75098,"_31230":75071,"_21622":127256,"_5":14887,"_28406":127196,"_3086":127257},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3696":75099,"_31230":75071,"_21622":127259,"_5":14887,"_28406":127200,"_3086":127260},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3696":75100,"_31230":75071,"_21622":127262,"_5":14887,"_28406":127200,"_3086":127263},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3696":75101,"_31230":75071,"_21622":127265,"_5":14887,"_28406":127200,"_3086":127266},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3696":75102,"_31230":75071,"_21622":127268,"_5":14887,"_28406":127200,"_3086":127269},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3696":75103,"_31230":75071,"_21622":127271,"_5":14887,"_28406":127200,"_3086":127272},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3696":75104,"_31230":75071,"_21622":127274,"_5":14887,"_28406":127200,"_3086":127275},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3696":75105,"_31230":75071,"_21622":127277,"_5":14887,"_28406":127200,"_3086":127278},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3696":75106,"_31230":75071,"_21622":127280,"_5":14887,"_28406":127204,"_3086":127281},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3696":75107,"_31230":75071,"_21622":127283,"_5":14887,"_28406":127208,"_3086":127284},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3696":75108,"_31230":75071,"_21622":127286,"_5":14887,"_28406":127208,"_3086":127287},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3696":75109,"_31230":75071,"_21622":127289,"_5":14887,"_28406":127208,"_3086":127290},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3696":75110,"_31230":75071,"_21622":127292,"_5":14887,"_28406":127208,"_3086":127293},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3696":75111,"_31230":75071,"_21622":127295,"_5":14887,"_28406":127208,"_3086":127296},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3696":75112,"_31230":75071,"_21622":127298,"_5":14887,"_28406":127208,"_3086":127299},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3696":75113,"_31230":75071,"_21622":127301,"_5":14887,"_28406":127208,"_3086":127302},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3696":75114,"_31230":75114,"_5":15247,"_3086":127304,"_31588":127305,"_21622":127306,"_28406":75114},"Listas de revocación (CRL)",[51065,122085,56761,126778],[],{"_3696":75115,"_31230":75114,"_21622":127308,"_5":14887,"_28406":75114,"_3086":127309},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3696":75116,"_31230":75114,"_5":31585,"_21622":127311,"_28406":127312,"_3086":127313},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3696":75117,"_31230":75114,"_5":31585,"_21622":127315,"_28406":127316,"_3086":127317},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3696":75118,"_31230":75114,"_5":31585,"_21622":127319,"_28406":127320,"_3086":127321},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3696":75119,"_31230":75114,"_5":31585,"_21622":127323,"_28406":127324,"_3086":127325},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3696":75120,"_31230":75114,"_5":31585,"_21622":127327,"_28406":127328,"_3086":127329},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3696":75121,"_31230":75114,"_5":31585,"_21622":127331,"_28406":127332,"_3086":127333},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3696":75122,"_31230":75114,"_5":31585,"_21622":127335,"_28406":127336,"_3086":127337},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3696":75123,"_31230":75114,"_5":31585,"_21622":127339,"_28406":127340,"_3086":127341},[],"/docs/pr-preview/pr-80/es/platform/pki/crl#referencias","Referencias",{"_3696":75124,"_31230":75114,"_21622":127343,"_5":14887,"_28406":75114,"_3086":127344},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3696":75125,"_31230":75114,"_21622":127346,"_5":14887,"_28406":127312,"_3086":127347},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3696":75126,"_31230":75114,"_21622":127349,"_5":14887,"_28406":127312,"_3086":127350},[],"Campo",{"_3696":75127,"_31230":75114,"_21622":127352,"_5":14887,"_28406":127312,"_3086":123771},[],{"_3696":75128,"_31230":75114,"_21622":127354,"_5":14887,"_28406":127312,"_3086":52707},[],{"_3696":75129,"_31230":75114,"_21622":127356,"_5":14887,"_28406":127312,"_3086":127357},[],"ID de la CA a la que pertenecen los ajustes.",{"_3696":75130,"_31230":75114,"_21622":127359,"_5":14887,"_28406":127312,"_3086":58018},[],{"_3696":75131,"_31230":75114,"_21622":127361,"_5":14887,"_28406":127312,"_3086":127362},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3696":75132,"_31230":75114,"_21622":127364,"_5":14887,"_28406":127312,"_3086":58024},[],{"_3696":75133,"_31230":75114,"_21622":127366,"_5":14887,"_28406":127312,"_3086":127367},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3696":75134,"_31230":75114,"_21622":127369,"_5":14887,"_28406":127312,"_3086":58030},[],{"_3696":75135,"_31230":75114,"_21622":127371,"_5":14887,"_28406":127312,"_3086":127372},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3696":75136,"_31230":75114,"_21622":127374,"_5":14887,"_28406":127312,"_3086":127375},[],"Campo de `crl_options`",{"_3696":75137,"_31230":75114,"_21622":127377,"_5":14887,"_28406":127312,"_3086":123771},[],{"_3696":75138,"_31230":75114,"_21622":127379,"_5":14887,"_28406":127312,"_3086":127380},[],"Valor inicial",{"_3696":75139,"_31230":75114,"_21622":127382,"_5":14887,"_28406":127312,"_3086":58044},[],{"_3696":75140,"_31230":75114,"_21622":127384,"_5":14887,"_28406":127312,"_3086":127385},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3696":75141,"_31230":75114,"_21622":127387,"_5":14887,"_28406":127312,"_3086":127388},[],"7 días.",{"_3696":75142,"_31230":75114,"_21622":127390,"_5":14887,"_28406":127312,"_3086":58053},[],{"_3696":75143,"_31230":75114,"_21622":127392,"_5":14887,"_28406":127312,"_3086":127393},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3696":75144,"_31230":75114,"_21622":127395,"_5":14887,"_28406":127312,"_3086":127396},[],"6 días y 23 horas.",{"_3696":75145,"_31230":75114,"_21622":127398,"_5":14887,"_28406":127312,"_3086":58062},[],{"_3696":75146,"_31230":75114,"_21622":127400,"_5":14887,"_28406":127312,"_3086":127401},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3696":75147,"_31230":75114,"_21622":127403,"_5":14887,"_28406":127312,"_3086":58068},[],{"_3696":75148,"_31230":75114,"_21622":127405,"_5":14887,"_28406":127312,"_3086":58071},[],{"_3696":75149,"_31230":75114,"_21622":127407,"_5":14887,"_28406":127312,"_3086":127408},[],"Número de serie del certificado existente que firma la CRL.",{"_3696":75150,"_31230":75114,"_21622":127410,"_5":14887,"_28406":127312,"_3086":127411},[],"Número de serie del certificado actual de la CA.",{"_3696":75151,"_31230":75114,"_21622":127413,"_5":14887,"_28406":127312,"_3086":127414},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3696":75152,"_31230":75114,"_21622":127416,"_5":14887,"_28406":127312,"_3086":127417},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3696":75153,"_31230":75114,"_21622":127419,"_5":14887,"_28406":127312,"_3086":127420},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3696":75154,"_31230":75114,"_21622":127422,"_5":14887,"_28406":127312,"_3086":127423},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3696":75155,"_31230":75114,"_21622":127425,"_5":14887,"_28406":127312,"_3086":127426},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3696":75156,"_31230":75114,"_21622":127428,"_5":14887,"_28406":127312,"_3086":127429},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3696":75157,"_31230":75114,"_21622":127431,"_5":14887,"_28406":127312,"_3086":127432},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3696":75158,"_31230":75114,"_21622":127434,"_5":14887,"_28406":127312,"_3086":127435},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3696":75159,"_31230":75114,"_21622":127437,"_5":14887,"_28406":127312,"_3086":127438},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3696":75160,"_31230":75114,"_21622":127440,"_5":14887,"_28406":127312,"_3086":127441},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3696":75161,"_31230":75114,"_21622":127443,"_5":14887,"_28406":127312,"_3086":127444},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3696":75162,"_31230":75114,"_21622":127446,"_5":14887,"_28406":127316,"_3086":127447},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3696":75163,"_31230":75114,"_21622":127449,"_5":14887,"_28406":127316,"_3086":127450},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3696":75164,"_31230":75114,"_21622":127452,"_5":14887,"_28406":127316,"_3086":127453},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3696":75165,"_31230":75114,"_21622":127455,"_5":14887,"_28406":127316,"_3086":127456},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3696":75166,"_31230":75114,"_21622":127458,"_5":14887,"_28406":127320,"_3086":127459},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3696":75167,"_31230":75114,"_21622":127461,"_5":14887,"_28406":127320,"_3086":127462},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3696":75168,"_31230":75114,"_21622":127464,"_5":14887,"_28406":127320,"_3086":127465},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3696":75169,"_31230":75114,"_21622":127467,"_5":14887,"_28406":127320,"_3086":127468},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3696":75170,"_31230":75114,"_21622":127470,"_5":14887,"_28406":127320,"_3086":127471},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3696":75171,"_31230":75114,"_21622":127473,"_5":14887,"_28406":127320,"_3086":127474},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3696":75172,"_31230":75114,"_21622":127476,"_5":14887,"_28406":127320,"_3086":127477},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3696":75173,"_31230":75114,"_21622":127479,"_5":14887,"_28406":127320,"_3086":127480},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3696":75174,"_31230":75114,"_21622":127482,"_5":14887,"_28406":127320,"_3086":127483},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3696":75175,"_31230":75114,"_21622":127485,"_5":14887,"_28406":127324,"_3086":127486},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3696":75176,"_31230":75114,"_21622":127488,"_5":14887,"_28406":127324,"_3086":127489},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3696":75177,"_31230":75114,"_21622":127491,"_5":14887,"_28406":127328,"_3086":127492},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3696":75178,"_31230":75114,"_21622":127494,"_5":14887,"_28406":127328,"_3086":127495},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3696":75179,"_31230":75114,"_21622":127497,"_5":14887,"_28406":127328,"_3086":127498},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3696":75180,"_31230":75114,"_21622":127500,"_5":14887,"_28406":127328,"_3086":127501},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3696":75181,"_31230":75114,"_21622":127503,"_5":14887,"_28406":127328,"_3086":127504},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3696":75182,"_31230":75114,"_21622":127506,"_5":14887,"_28406":127332,"_3086":127507},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3696":75183,"_31230":75114,"_21622":127509,"_5":14887,"_28406":127332,"_3086":123960},[],{"_3696":75184,"_31230":75114,"_21622":127511,"_5":14887,"_28406":127332,"_3086":127512},[],"Path relativo",{"_3696":75185,"_31230":75114,"_21622":127514,"_5":14887,"_28406":127332,"_3086":121845},[],{"_3696":75186,"_31230":75114,"_21622":127516,"_5":14887,"_28406":127332,"_3086":58183},[],{"_3696":75187,"_31230":75114,"_21622":127518,"_5":14887,"_28406":127332,"_3086":58186},[],{"_3696":75188,"_31230":75114,"_21622":127520,"_5":14887,"_28406":127332,"_3086":127521},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3696":75189,"_31230":75114,"_21622":127523,"_5":14887,"_28406":127332,"_3086":58183},[],{"_3696":75190,"_31230":75114,"_21622":127525,"_5":14887,"_28406":127332,"_3086":58194},[],{"_3696":75191,"_31230":75114,"_21622":127527,"_5":14887,"_28406":127332,"_3086":127528},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3696":75192,"_31230":75114,"_21622":127530,"_5":14887,"_28406":127332,"_3086":58200},[],{"_3696":75193,"_31230":75114,"_21622":127532,"_5":14887,"_28406":127332,"_3086":58194},[],{"_3696":75194,"_31230":75114,"_21622":127534,"_5":14887,"_28406":127332,"_3086":127535},[],"Sustituir la configuración de CRL de una CA.",{"_3696":75195,"_31230":75114,"_21622":127537,"_5":14887,"_28406":127332,"_3086":58208},[],{"_3696":75196,"_31230":75114,"_21622":127539,"_5":14887,"_28406":127332,"_3086":58194},[],{"_3696":75197,"_31230":75114,"_21622":127541,"_5":14887,"_28406":127332,"_3086":127542},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3696":75198,"_31230":75114,"_21622":127544,"_5":14887,"_28406":127332,"_3086":127545},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3696":75199,"_31230":75114,"_21622":127547,"_5":14887,"_28406":127332,"_3086":127548},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3696":75200,"_31230":75114,"_21622":127550,"_5":14887,"_28406":127332,"_3086":127551},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3696":75201,"_31230":75114,"_21622":127553,"_5":14887,"_28406":127336,"_3086":127554},[],"Síntoma",{"_3696":75202,"_31230":75114,"_21622":127556,"_5":14887,"_28406":127336,"_3086":127557},[],"Causa",{"_3696":75203,"_31230":75114,"_21622":127559,"_5":14887,"_28406":127336,"_3086":127560},[],"Acción",{"_3696":75204,"_31230":75114,"_21622":127562,"_5":14887,"_28406":127336,"_3086":127563},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3696":75205,"_31230":75114,"_21622":127565,"_5":14887,"_28406":127336,"_3086":127566},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3696":75206,"_31230":75114,"_21622":127568,"_5":14887,"_28406":127336,"_3086":127569},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3696":75207,"_31230":75114,"_21622":127571,"_5":14887,"_28406":127336,"_3086":127572},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3696":75208,"_31230":75114,"_21622":127574,"_5":14887,"_28406":127336,"_3086":127575},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3696":75209,"_31230":75114,"_21622":127577,"_5":14887,"_28406":127336,"_3086":127578},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3696":75210,"_31230":75114,"_21622":127580,"_5":14887,"_28406":127336,"_3086":127581},[],"`PUT` devuelve 400.",{"_3696":75211,"_31230":75114,"_21622":127583,"_5":14887,"_28406":127336,"_3086":127584},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3696":75212,"_31230":75114,"_21622":127586,"_5":14887,"_28406":127336,"_3086":127587},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3696":75213,"_31230":75114,"_21622":127589,"_5":14887,"_28406":127336,"_3086":127590},[],"`PUT` devuelve 404.",{"_3696":75214,"_31230":75114,"_21622":127592,"_5":14887,"_28406":127336,"_3086":127593},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3696":75215,"_31230":75114,"_21622":127595,"_5":14887,"_28406":127336,"_3086":127596},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3696":75216,"_31230":75114,"_21622":127598,"_5":14887,"_28406":127336,"_3086":127599},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3696":75217,"_31230":75114,"_21622":127601,"_5":14887,"_28406":127336,"_3086":127602},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3696":75218,"_31230":75114,"_21622":127604,"_5":14887,"_28406":127336,"_3086":127605},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3696":75219,"_31230":75114,"_21622":127607,"_5":14887,"_28406":127336,"_3086":127608},[],"La CRL no cambia tras revocar un certificado.",{"_3696":75220,"_31230":75114,"_21622":127610,"_5":14887,"_28406":127336,"_3086":127611},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3696":75221,"_31230":75114,"_21622":127613,"_5":14887,"_28406":127336,"_3086":127614},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3696":75222,"_31230":75114,"_21622":127616,"_5":14887,"_28406":127336,"_3086":127617},[],"Un verificador rechaza la CRL por el emisor.",{"_3696":75223,"_31230":75114,"_21622":127619,"_5":14887,"_28406":127336,"_3086":127620},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3696":75224,"_31230":75114,"_21622":127622,"_5":14887,"_28406":127336,"_3086":127623},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3696":75225,"_31230":75114,"_21622":127625,"_5":14887,"_28406":127340,"_3086":127626},[],"RFC 5280: perfil X.509 y CRL.",{"_3696":75226,"_31230":75114,"_21622":127628,"_5":14887,"_28406":127340,"_3086":58300},[],{"_3696":75227,"_31230":75114,"_21622":127630,"_5":14887,"_28406":127340,"_3086":58303},[],{"_3696":75228,"_31230":75114,"_21622":127632,"_5":14887,"_28406":127340,"_3086":127633},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3696":75229,"_31230":75114,"_21622":127635,"_5":14887,"_28406":127340,"_3086":127636},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3696":75230,"_31230":75230,"_5":15247,"_3086":127638,"_31588":127639,"_21622":127640,"_28406":75230},"Claves y motores criptográficos",[51065,122085,56761,126107],[],{"_3696":75231,"_31230":75230,"_21622":127642,"_5":14887,"_28406":75230,"_3086":127643},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3696":75232,"_31230":75230,"_5":31585,"_21622":127645,"_28406":127646,"_3086":127647},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3696":75233,"_31230":75230,"_5":31585,"_21622":127649,"_28406":127650,"_3086":127651},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3696":75234,"_31230":75230,"_5":31585,"_21622":127653,"_28406":127654,"_3086":58328},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#file-system",{"_3696":75235,"_31230":75230,"_5":31585,"_21622":127656,"_28406":127657,"_3086":58332},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#hashicorp-vault",{"_3696":75236,"_31230":75230,"_5":31585,"_21622":127659,"_28406":127660,"_3086":58336},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#aws-secrets-manager",{"_3696":75237,"_31230":75230,"_5":31585,"_21622":127662,"_28406":127663,"_3086":58340},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#aws-kms",{"_3696":75238,"_31230":75230,"_5":31585,"_21622":127665,"_28406":127666,"_3086":58344},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#pkcs11",{"_3696":75239,"_31230":75230,"_5":31585,"_21622":127668,"_28406":127669,"_3086":58348},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#azure-key-vault",{"_3696":75240,"_31230":75230,"_5":31585,"_21622":127671,"_28406":127672,"_3086":127673},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3696":75241,"_31230":75230,"_5":31585,"_21622":127675,"_28406":127676,"_3086":127677},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3696":75242,"_31230":75230,"_5":31585,"_21622":127679,"_28406":127680,"_3086":127681},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3696":75243,"_31230":75230,"_5":31585,"_21622":127683,"_28406":127684,"_3086":127685},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3696":75244,"_31230":75230,"_5":31585,"_21622":127687,"_28406":127688,"_3086":127689},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3696":75245,"_31230":75230,"_5":31585,"_21622":127691,"_28406":127692,"_3086":127693},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3696":75246,"_31230":75230,"_5":31585,"_21622":127695,"_28406":127696,"_3086":127697},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3696":75247,"_31230":75230,"_5":31585,"_21622":127699,"_28406":127700,"_3086":58380},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#sign",{"_3696":75248,"_31230":75230,"_5":31585,"_21622":127702,"_28406":127703,"_3086":58384},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#verify",{"_3696":75249,"_31230":75230,"_5":31585,"_21622":127705,"_28406":127706,"_3086":127707},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3696":75250,"_31230":75230,"_5":31585,"_21622":127709,"_28406":127710,"_3086":127711},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3696":75251,"_31230":75230,"_5":31585,"_21622":127713,"_28406":127714,"_3086":127715},[],"/docs/pr-preview/pr-80/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3696":75252,"_31230":75230,"_21622":127717,"_5":14887,"_28406":75230,"_3086":127718},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3696":75253,"_31230":75230,"_21622":127720,"_5":14887,"_28406":75230,"_3086":127721},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3696":75254,"_31230":75230,"_21622":127723,"_5":14887,"_28406":127646,"_3086":127724},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3696":75255,"_31230":75230,"_21622":127726,"_5":14887,"_28406":127646,"_3086":127727},[],"En la práctica, permite:",{"_3696":75256,"_31230":75230,"_21622":127729,"_5":14887,"_28406":127646,"_3086":127730},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3696":75257,"_31230":75230,"_21622":127732,"_5":14887,"_28406":127646,"_3086":127733},[],"Importar claves creadas externamente.",{"_3696":75258,"_31230":75230,"_21622":127735,"_5":14887,"_28406":127646,"_3086":127736},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3696":75259,"_31230":75230,"_21622":127738,"_5":14887,"_28406":127646,"_3086":127739},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3696":75260,"_31230":75230,"_21622":127741,"_5":14887,"_28406":127650,"_3086":127742},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3696":75261,"_31230":75230,"_21622":127744,"_5":14887,"_28406":127650,"_3086":127745},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3696":75262,"_31230":75230,"_21622":127747,"_5":14887,"_28406":127650,"_3086":127748},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3696":75263,"_31230":75230,"_21622":127750,"_5":14887,"_28406":127654,"_3086":127751},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3696":75264,"_31230":75230,"_21622":127753,"_5":14887,"_28406":127657,"_3086":127754},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3696":75265,"_31230":75230,"_21622":127756,"_5":14887,"_28406":127657,"_3086":127757},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3696":75266,"_31230":75230,"_21622":127759,"_5":14887,"_28406":127660,"_3086":127760},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3696":75267,"_31230":75230,"_21622":127762,"_5":14887,"_28406":127663,"_3086":127763},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3696":75268,"_31230":75230,"_21622":127765,"_5":14887,"_28406":127666,"_3086":127766},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3696":75269,"_31230":75230,"_21622":127768,"_5":14887,"_28406":127669,"_3086":127769},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3696":75270,"_31230":75230,"_21622":127771,"_5":14887,"_28406":127669,"_3086":127772},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3696":75271,"_31230":75230,"_21622":127774,"_5":14887,"_28406":127669,"_3086":127775},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3696":75272,"_31230":75230,"_21622":127777,"_5":14887,"_28406":127669,"_3086":127778},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3696":75273,"_31230":75230,"_21622":127780,"_5":14887,"_28406":127672,"_3086":127781},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3696":75274,"_31230":75230,"_21622":127783,"_5":14887,"_28406":127672,"_3086":127784},[],"La tabla incluye los siguientes campos:",{"_3696":75275,"_31230":75230,"_21622":127786,"_5":14887,"_28406":127672,"_3086":127787},[],"**Name**: nombre descriptivo de la clave.",{"_3696":75276,"_31230":75230,"_21622":127789,"_5":14887,"_28406":127672,"_3086":127790},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3696":75277,"_31230":75230,"_21622":127792,"_5":14887,"_28406":127672,"_3086":127793},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3696":75278,"_31230":75230,"_21622":127795,"_5":14887,"_28406":127672,"_3086":127796},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3696":75279,"_31230":75230,"_21622":127798,"_5":14887,"_28406":127672,"_3086":127799},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3696":75280,"_31230":75230,"_21622":127801,"_5":14887,"_28406":127672,"_3086":127802},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3696":75281,"_31230":75230,"_21622":127804,"_5":14887,"_28406":127672,"_3086":127805},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3696":75282,"_31230":75230,"_21622":127807,"_5":14887,"_28406":127672,"_3086":127808},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3696":75283,"_31230":75230,"_21622":127810,"_5":14887,"_28406":127672,"_3086":127811},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3696":75284,"_31230":75230,"_21622":127813,"_5":14887,"_28406":127672,"_3086":127814},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3696":75285,"_31230":75230,"_21622":127816,"_5":14887,"_28406":127672,"_3086":127817},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3696":75286,"_31230":75230,"_21622":127819,"_5":14887,"_28406":127672,"_3086":127820},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3696":75287,"_31230":75230,"_21622":127822,"_5":14887,"_28406":127672,"_3086":127823},[],"**Delete Key** para eliminar la clave del sistema.",{"_3696":75288,"_31230":75230,"_21622":127825,"_5":14887,"_28406":127676,"_3086":127826},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3696":75289,"_31230":75230,"_21622":127828,"_5":14887,"_28406":127680,"_3086":127829},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3696":75290,"_31230":75230,"_21622":127831,"_5":14887,"_28406":127680,"_3086":127832},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3696":75291,"_31230":75230,"_21622":127834,"_5":14887,"_28406":127680,"_3086":127835},[],"**Key Name**: nombre único y descriptivo.",{"_3696":75292,"_31230":75230,"_21622":127837,"_5":14887,"_28406":127680,"_3086":127838},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3696":75293,"_31230":75230,"_21622":127840,"_5":14887,"_28406":127680,"_3086":127841},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3696":75294,"_31230":75230,"_21622":127843,"_5":14887,"_28406":127680,"_3086":127844},[],"**Tags**: metadatos para clasificar la clave.",{"_3696":75295,"_31230":75230,"_21622":127846,"_5":14887,"_28406":127680,"_3086":127847},[],"**Metadata**: información adicional para usos avanzados.",{"_3696":75296,"_31230":75230,"_21622":127849,"_5":14887,"_28406":127684,"_3086":127850},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3696":75297,"_31230":75230,"_21622":127852,"_5":14887,"_28406":127684,"_3086":127853},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3696":75298,"_31230":75230,"_21622":127855,"_5":14887,"_28406":127684,"_3086":127856},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3696":75299,"_31230":75230,"_21622":127858,"_5":14887,"_28406":127684,"_3086":127859},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3696":75300,"_31230":75230,"_21622":127861,"_5":14887,"_28406":127684,"_3086":127862},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3696":75301,"_31230":75230,"_21622":127864,"_5":14887,"_28406":127684,"_3086":127865},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3696":75302,"_31230":75230,"_21622":127867,"_5":14887,"_28406":127684,"_3086":127868},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3696":75303,"_31230":75230,"_21622":127870,"_5":14887,"_28406":127684,"_3086":127871},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3696":75304,"_31230":75230,"_21622":127873,"_5":14887,"_28406":127684,"_3086":127874},[],"**Metadata**: información adicional opcional.",{"_3696":75305,"_31230":75230,"_21622":127876,"_5":14887,"_28406":127684,"_3086":127877},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3696":75306,"_31230":75230,"_21622":127879,"_5":14887,"_28406":127684,"_3086":127880},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3696":75307,"_31230":75230,"_21622":127882,"_5":14887,"_28406":127688,"_3086":127883},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3696":75308,"_31230":75230,"_21622":127885,"_5":14887,"_28406":127692,"_3086":127886},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3696":75309,"_31230":75230,"_21622":127888,"_5":14887,"_28406":127692,"_3086":127889},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3696":75310,"_31230":75230,"_21622":127891,"_5":14887,"_28406":127692,"_3086":127892},[],"**Key Name**: nombre descriptivo.",{"_3696":75311,"_31230":75230,"_21622":127894,"_5":14887,"_28406":127692,"_3086":127895},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3696":75312,"_31230":75230,"_21622":127897,"_5":14887,"_28406":127692,"_3086":127898},[],"**Tags**: etiquetas asociadas.",{"_3696":75313,"_31230":75230,"_21622":127900,"_5":14887,"_28406":127692,"_3086":127901},[],"**Aliases**: nombres alternativos.",{"_3696":75314,"_31230":75230,"_21622":127903,"_5":14887,"_28406":127692,"_3086":127904},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3696":75315,"_31230":75230,"_21622":127906,"_5":14887,"_28406":127692,"_3086":127907},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3696":75316,"_31230":75230,"_21622":127909,"_5":14887,"_28406":127692,"_3086":127910},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3696":75317,"_31230":75230,"_21622":127912,"_5":14887,"_28406":127692,"_3086":127913},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3696":75318,"_31230":75230,"_21622":127915,"_5":14887,"_28406":127696,"_3086":127916},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3696":75319,"_31230":75230,"_21622":127918,"_5":14887,"_28406":127696,"_3086":127919},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3696":75320,"_31230":75230,"_21622":127921,"_5":14887,"_28406":127696,"_3086":127922},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3696":75321,"_31230":75230,"_21622":127924,"_5":14887,"_28406":127700,"_3086":127925},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3696":75322,"_31230":75230,"_21622":127927,"_5":14887,"_28406":127700,"_3086":127928},[],"Campos principales:",{"_3696":75323,"_31230":75230,"_21622":127930,"_5":14887,"_28406":127700,"_3086":127931},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3696":75324,"_31230":75230,"_21622":127933,"_5":14887,"_28406":127700,"_3086":127934},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3696":75325,"_31230":75230,"_21622":127936,"_5":14887,"_28406":127700,"_3086":127937},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3696":75326,"_31230":75230,"_21622":127939,"_5":14887,"_28406":127700,"_3086":127940},[],"**Message**: contenido que se va a firmar.",{"_3696":75327,"_31230":75230,"_21622":127942,"_5":14887,"_28406":127700,"_3086":127943},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3696":75328,"_31230":75230,"_21622":127945,"_5":14887,"_28406":127703,"_3086":127946},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3696":75329,"_31230":75230,"_21622":127948,"_5":14887,"_28406":127703,"_3086":127928},[],{"_3696":75330,"_31230":75230,"_21622":127950,"_5":14887,"_28406":127703,"_3086":127951},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3696":75331,"_31230":75230,"_21622":127953,"_5":14887,"_28406":127703,"_3086":127954},[],"**Message Type**: `Raw` o `Digest`.",{"_3696":75332,"_31230":75230,"_21622":127956,"_5":14887,"_28406":127703,"_3086":127957},[],"**Payload Encoding**: codificación del mensaje.",{"_3696":75333,"_31230":75230,"_21622":127959,"_5":14887,"_28406":127703,"_3086":127960},[],"**Message**: mensaje original o hash.",{"_3696":75334,"_31230":75230,"_21622":127962,"_5":14887,"_28406":127703,"_3086":127963},[],"**Signature**: firma que se desea comprobar.",{"_3696":75335,"_31230":75230,"_21622":127965,"_5":14887,"_28406":127703,"_3086":127966},[],"**Result**: indicador del resultado de la validación.",{"_3696":75336,"_31230":75230,"_21622":127968,"_5":14887,"_28406":127706,"_3086":127969},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3696":75337,"_31230":75230,"_21622":127971,"_5":14887,"_28406":127706,"_3086":127972},[],"Este flujo es útil para:",{"_3696":75338,"_31230":75230,"_21622":127974,"_5":14887,"_28406":127706,"_3086":127975},[],"Solicitar certificados a una CA externa.",{"_3696":75339,"_31230":75230,"_21622":127977,"_5":14887,"_28406":127706,"_3086":127978},[],"Renovar una identidad manteniendo la misma clave.",{"_3696":75340,"_31230":75230,"_21622":127980,"_5":14887,"_28406":127706,"_3086":127981},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3696":75341,"_31230":75230,"_21622":127983,"_5":14887,"_28406":127706,"_3086":127984},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3696":75342,"_31230":75230,"_21622":127986,"_5":14887,"_28406":127706,"_3086":127987},[],"**Organization (O)**: organización o empresa.",{"_3696":75343,"_31230":75230,"_21622":127989,"_5":14887,"_28406":127706,"_3086":127990},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3696":75344,"_31230":75230,"_21622":127992,"_5":14887,"_28406":127706,"_3086":127993},[],"**Country (C)**: código de país de dos letras.",{"_3696":75345,"_31230":75230,"_21622":127995,"_5":14887,"_28406":127706,"_3086":127996},[],"**State / Province (ST)**: estado o provincia.",{"_3696":75346,"_31230":75230,"_21622":127998,"_5":14887,"_28406":127706,"_3086":127999},[],"**Locality (L)**: ciudad o localidad.",{"_3696":75347,"_31230":75230,"_21622":128001,"_5":14887,"_28406":127706,"_3086":128002},[],"**Email Address**: correo de contacto.",{"_3696":75348,"_31230":75230,"_21622":128004,"_5":14887,"_28406":127706,"_3086":128005},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3696":75349,"_31230":75230,"_21622":128007,"_5":14887,"_28406":127706,"_3086":128008},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3696":75350,"_31230":75230,"_21622":128010,"_5":14887,"_28406":127710,"_3086":128011},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3696":75351,"_31230":75230,"_21622":128013,"_5":14887,"_28406":127710,"_3086":128014},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3696":75352,"_31230":75230,"_21622":128016,"_5":14887,"_28406":127714,"_3086":128017},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3696":75353,"_31230":75230,"_21622":128019,"_5":14887,"_28406":127714,"_3086":128020},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3696":75354,"_31230":75354,"_5":15247,"_3086":128022,"_31588":128023,"_21622":128024,"_28406":75354},"Validación online con OCSP",[51065,122085,56761,126778],[],{"_3696":75355,"_31230":75354,"_21622":128026,"_5":14887,"_28406":75354,"_3086":128027},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3696":75356,"_31230":75354,"_5":31585,"_21622":128029,"_28406":128030,"_3086":128031},[],"/docs/pr-preview/pr-80/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3696":75357,"_31230":75354,"_5":31585,"_21622":128033,"_28406":128034,"_3086":128035},[],"/docs/pr-preview/pr-80/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3696":75358,"_31230":75354,"_5":31585,"_21622":128037,"_28406":128038,"_3086":128039},[],"/docs/pr-preview/pr-80/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3696":75359,"_31230":75354,"_5":31585,"_21622":128041,"_28406":128042,"_3086":128043},[],"/docs/pr-preview/pr-80/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3696":75360,"_31230":75354,"_5":31585,"_21622":128045,"_28406":128046,"_3086":128047},[],"/docs/pr-preview/pr-80/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3696":75361,"_31230":75354,"_5":31585,"_21622":128049,"_28406":128050,"_3086":127341},[],"/docs/pr-preview/pr-80/es/platform/pki/ocsp#referencias",{"_3696":75362,"_31230":75354,"_21622":128052,"_5":14887,"_28406":75354,"_3086":128053},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3696":75363,"_31230":75354,"_21622":128055,"_5":14887,"_28406":128030,"_3086":128056},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3696":75364,"_31230":75354,"_21622":128058,"_5":14887,"_28406":128030,"_3086":128059},[],"Estado del registro",{"_3696":75365,"_31230":75354,"_21622":128061,"_5":14887,"_28406":128030,"_3086":128062},[],"Respuesta firmada",{"_3696":75366,"_31230":75354,"_21622":128064,"_5":14887,"_28406":128030,"_3086":55898},[],{"_3696":75367,"_31230":75354,"_21622":128066,"_5":14887,"_28406":128030,"_3086":58748},[],{"_3696":75368,"_31230":75354,"_21622":128068,"_5":14887,"_28406":128030,"_3086":55915},[],{"_3696":75369,"_31230":75354,"_21622":128070,"_5":14887,"_28406":128030,"_3086":128071},[],"`Revoked`, con razón y fecha de revocación.",{"_3696":75370,"_31230":75354,"_21622":128073,"_5":14887,"_28406":128030,"_3086":128074},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3696":75371,"_31230":75354,"_21622":128076,"_5":14887,"_28406":128030,"_3086":128077},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3696":75372,"_31230":75354,"_21622":128079,"_5":14887,"_28406":128030,"_3086":128080},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3696":75373,"_31230":75354,"_21622":128082,"_5":14887,"_28406":128030,"_3086":128083},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3696":75374,"_31230":75354,"_21622":128085,"_5":14887,"_28406":128030,"_3086":128086},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3696":75375,"_31230":75354,"_21622":128088,"_5":14887,"_28406":128034,"_3086":128089},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3696":75376,"_31230":75354,"_21622":128091,"_5":14887,"_28406":128034,"_3086":128092},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3696":75377,"_31230":75354,"_21622":128094,"_5":14887,"_28406":128038,"_3086":128095},[],"El servicio acepta:",{"_3696":75378,"_31230":75354,"_21622":128097,"_5":14887,"_28406":128038,"_3086":123960},[],{"_3696":75379,"_31230":75354,"_21622":128099,"_5":14887,"_28406":128038,"_3086":128100},[],"Ruta del servicio VA",{"_3696":75380,"_31230":75354,"_21622":128102,"_5":14887,"_28406":128038,"_3086":128103},[],"Formato",{"_3696":75381,"_31230":75354,"_21622":128105,"_5":14887,"_28406":128038,"_3086":58788},[],{"_3696":75382,"_31230":75354,"_21622":128107,"_5":14887,"_28406":128038,"_3086":58791},[],{"_3696":75383,"_31230":75354,"_21622":128109,"_5":14887,"_28406":128038,"_3086":128110},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3696":75384,"_31230":75354,"_21622":128112,"_5":14887,"_28406":128038,"_3086":58183},[],{"_3696":75385,"_31230":75354,"_21622":128114,"_5":14887,"_28406":128038,"_3086":58799},[],{"_3696":75386,"_31230":75354,"_21622":128116,"_5":14887,"_28406":128038,"_3086":128117},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3696":75387,"_31230":75354,"_21622":128119,"_5":14887,"_28406":128038,"_3086":128120},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3696":75388,"_31230":75354,"_21622":128122,"_5":14887,"_28406":128042,"_3086":128123},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3696":75389,"_31230":75354,"_21622":128125,"_5":14887,"_28406":128042,"_3086":128126},[],"Genera la solicitud:",{"_3696":75390,"_31230":75354,"_21622":128128,"_5":14887,"_28406":128042,"_3086":128129},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3696":75391,"_31230":75354,"_21622":128131,"_5":14887,"_28406":128042,"_3086":128132},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3696":75392,"_31230":75354,"_21622":128134,"_5":14887,"_28406":128042,"_3086":128135},[],"Verifica el DER recibido:",{"_3696":75393,"_31230":75354,"_21622":128137,"_5":14887,"_28406":128042,"_3086":128138},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3696":75394,"_31230":75354,"_21622":128140,"_5":14887,"_28406":128046,"_3086":128141},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3696":75395,"_31230":75354,"_21622":128143,"_5":14887,"_28406":128046,"_3086":128144},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3696":75396,"_31230":75354,"_21622":128146,"_5":14887,"_28406":128050,"_3086":58832},[],{"_3696":75397,"_31230":75354,"_21622":128148,"_5":14887,"_28406":128050,"_3086":58835},[],{"_3696":75398,"_31230":75354,"_21622":128150,"_5":14887,"_28406":128050,"_3086":128151},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3696":75399,"_31230":75354,"_21622":128153,"_5":14887,"_28406":128050,"_3086":127636},[],{"_3696":75400,"_31230":75400,"_5":15247,"_3086":56761,"_31588":128155,"_21622":128156,"_28406":75400},[51065,122085,56761],[],{"_3696":75401,"_31230":75400,"_21622":128158,"_5":14887,"_28406":75400,"_3086":128159},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3696":75402,"_31230":75400,"_5":31585,"_21622":128161,"_28406":128162,"_3086":125433},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#empieza-aquí",{"_3696":75403,"_31230":75400,"_5":31585,"_21622":128164,"_28406":128165,"_3086":128166},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3696":75404,"_31230":75400,"_5":31585,"_21622":128168,"_28406":128169,"_3086":125953},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#capacidades-principales",{"_3696":75405,"_31230":75400,"_5":31585,"_21622":128171,"_28406":128172,"_3086":125957},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3696":75406,"_31230":75400,"_5":31585,"_21622":128174,"_28406":128175,"_3086":125961},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3696":75407,"_31230":75400,"_5":31585,"_21622":128177,"_28406":128178,"_3086":125965},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#emite-y-controla-certificados",{"_3696":75408,"_31230":75400,"_5":31585,"_21622":128180,"_28406":128181,"_3086":125973},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#publica-el-estado-de-validación",{"_3696":75409,"_31230":75400,"_5":31585,"_21622":128183,"_28406":128184,"_3086":128185},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3696":75410,"_31230":75400,"_5":31585,"_21622":128187,"_28406":128188,"_3086":126944},[],"/docs/pr-preview/pr-80/es/platform/pki/overview#continúa",{"_3696":75411,"_31230":75400,"_21622":128190,"_5":14887,"_28406":75400,"_3086":128191},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3696":75412,"_31230":75400,"_21622":128193,"_5":14887,"_28406":128162,"_3086":128194},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3696":75413,"_31230":75400,"_21622":128196,"_5":14887,"_28406":128162,"_3086":128197},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3696":75414,"_31230":75400,"_21622":128199,"_5":14887,"_28406":128165,"_3086":128200},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3696":75415,"_31230":75400,"_21622":128202,"_5":14887,"_28406":128165,"_3086":128203},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3696":75416,"_31230":75400,"_21622":128205,"_5":14887,"_28406":128165,"_3086":128206},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3696":75417,"_31230":75400,"_21622":128208,"_5":14887,"_28406":128165,"_3086":128209},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3696":75418,"_31230":75400,"_21622":128211,"_5":14887,"_28406":128165,"_3086":128212},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3696":75419,"_31230":75400,"_21622":128214,"_5":14887,"_28406":128172,"_3086":128215},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3696":75420,"_31230":75400,"_21622":128217,"_5":14887,"_28406":128175,"_3086":128218},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3696":75421,"_31230":75400,"_21622":128220,"_5":14887,"_28406":128178,"_3086":128221},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3696":75422,"_31230":75400,"_21622":128223,"_5":14887,"_28406":128181,"_3086":128224},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3696":75423,"_31230":75400,"_21622":128226,"_5":14887,"_28406":128184,"_3086":128227},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3696":75424,"_31230":75400,"_21622":128229,"_5":14887,"_28406":128184,"_3086":128230},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3696":75425,"_31230":75400,"_21622":128232,"_5":14887,"_28406":128184,"_3086":128233},[],"su clave pública corresponda a la clave privada del cliente;",{"_3696":75426,"_31230":75400,"_21622":128235,"_5":14887,"_28406":128184,"_3086":128236},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3696":75427,"_31230":75400,"_21622":128238,"_5":14887,"_28406":128184,"_3086":128239},[],"sus fechas y usos permitan la operación;",{"_3696":75428,"_31230":75400,"_21622":128241,"_5":14887,"_28406":128184,"_3086":128242},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3696":75429,"_31230":75400,"_21622":128244,"_5":14887,"_28406":128184,"_3086":128245},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3696":75430,"_31230":75400,"_21622":128247,"_5":14887,"_28406":128188,"_3086":128248},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3696":75431,"_31230":75400,"_21622":128250,"_5":14887,"_28406":128188,"_3086":128251},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3696":75432,"_31230":75400,"_21622":128253,"_5":14887,"_28406":128188,"_3086":128254},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3696":75433,"_31230":75433,"_5":15247,"_3086":128256,"_31588":128257,"_21622":128258,"_28406":75433},"Crea tu primera CA",[51065,122085,56761,125557],[],{"_3696":75434,"_31230":75433,"_21622":128260,"_5":14887,"_28406":75433,"_3086":128261},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3696":75435,"_31230":75433,"_5":31585,"_21622":128263,"_28406":128264,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3696":75436,"_31230":75433,"_5":31585,"_21622":128266,"_28406":128267,"_3086":128268},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3696":75437,"_31230":75433,"_5":31585,"_21622":128270,"_28406":128271,"_3086":128272},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3696":75438,"_31230":75433,"_5":31585,"_21622":128274,"_28406":128275,"_3086":128276},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3696":75439,"_31230":75433,"_5":31585,"_21622":128278,"_28406":128279,"_3086":128280},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3696":75440,"_31230":75433,"_5":31585,"_21622":128282,"_28406":128283,"_3086":128284},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3696":75441,"_31230":75433,"_5":31585,"_21622":128286,"_28406":128287,"_3086":128288},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3696":75442,"_31230":75433,"_5":31585,"_21622":128290,"_28406":128291,"_3086":125804},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3696":75443,"_31230":75433,"_5":31585,"_21622":128293,"_28406":128294,"_3086":120633},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3696":75444,"_31230":75433,"_21622":128296,"_5":14887,"_28406":75433,"_3086":128297},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3696":75445,"_31230":75433,"_21622":128299,"_5":14887,"_28406":128264,"_3086":128300},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3696":75446,"_31230":75433,"_21622":128302,"_5":14887,"_28406":128264,"_3086":128303},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3696":75447,"_31230":75433,"_21622":128305,"_5":14887,"_28406":128264,"_3086":128306},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3696":75448,"_31230":75433,"_21622":128308,"_5":14887,"_28406":128264,"_3086":128309},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3696":75449,"_31230":75433,"_21622":128311,"_5":14887,"_28406":128267,"_3086":128312},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3696":75450,"_31230":75433,"_21622":128314,"_5":14887,"_28406":128267,"_3086":128315},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3696":75451,"_31230":75433,"_21622":128317,"_5":14887,"_28406":128271,"_3086":128318},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3696":75452,"_31230":75433,"_21622":128320,"_5":14887,"_28406":128271,"_3086":128321},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3696":75453,"_31230":75433,"_21622":128323,"_5":14887,"_28406":128275,"_3086":128324},[],"Selecciona **Root CA** y completa:",{"_3696":75454,"_31230":75433,"_21622":128326,"_5":14887,"_28406":128275,"_3086":59014},[],{"_3696":75455,"_31230":75433,"_21622":128328,"_5":14887,"_28406":128275,"_3086":128329},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3696":75456,"_31230":75433,"_21622":128331,"_5":14887,"_28406":128275,"_3086":128332},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3696":75457,"_31230":75433,"_21622":128334,"_5":14887,"_28406":128275,"_3086":128335},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3696":75458,"_31230":75433,"_21622":128337,"_5":14887,"_28406":128275,"_3086":128338},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3696":75459,"_31230":75433,"_21622":128340,"_5":14887,"_28406":128279,"_3086":128341},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3696":75460,"_31230":75433,"_21622":128343,"_5":14887,"_28406":128283,"_3086":128344},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3696":75461,"_31230":75433,"_21622":128346,"_5":14887,"_28406":128283,"_3086":128347},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3696":75462,"_31230":75433,"_21622":128349,"_5":14887,"_28406":128287,"_3086":128350},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3696":75463,"_31230":75433,"_21622":128352,"_5":14887,"_28406":128287,"_3086":128353},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3696":75464,"_31230":75433,"_21622":128355,"_5":14887,"_28406":128287,"_3086":128356},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3696":75465,"_31230":75433,"_21622":128358,"_5":14887,"_28406":128291,"_3086":128359},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3696":75466,"_31230":75433,"_21622":128361,"_5":14887,"_28406":128291,"_3086":128362},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3696":75467,"_31230":75433,"_21622":128364,"_5":14887,"_28406":128291,"_3086":128365},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3696":75468,"_31230":75433,"_21622":128367,"_5":14887,"_28406":128291,"_3086":128368},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3696":75469,"_31230":75433,"_21622":128370,"_5":14887,"_28406":128294,"_3086":128371},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3696":75470,"_31230":75470,"_5":15247,"_3086":128373,"_31588":128374,"_21622":128375,"_28406":75470},"Emite y verifica un certificado",[51065,122085,56761,125557],[],{"_3696":75471,"_31230":75470,"_21622":128377,"_5":14887,"_28406":75470,"_3086":128378},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3696":75472,"_31230":75470,"_5":31585,"_21622":128380,"_28406":128381,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3696":75473,"_31230":75470,"_5":31585,"_21622":128383,"_28406":128384,"_3086":128385},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3696":75474,"_31230":75470,"_5":31585,"_21622":128387,"_28406":128388,"_3086":128389},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3696":75475,"_31230":75470,"_5":31585,"_21622":128391,"_28406":128392,"_3086":128393},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3696":75476,"_31230":75470,"_5":31585,"_21622":128395,"_28406":128396,"_3086":128397},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3696":75477,"_31230":75470,"_5":31585,"_21622":128399,"_28406":128400,"_3086":128401},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3696":75478,"_31230":75470,"_5":31585,"_21622":128403,"_28406":128404,"_3086":128405},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3696":75479,"_31230":75470,"_5":31585,"_21622":128407,"_28406":128408,"_3086":128409},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3696":75480,"_31230":75470,"_5":31585,"_21622":128411,"_28406":128412,"_3086":128413},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3696":75481,"_31230":75470,"_5":31585,"_21622":128415,"_28406":128416,"_3086":128417},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3696":75482,"_31230":75470,"_5":31585,"_21622":128419,"_28406":128420,"_3086":125804},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3696":75483,"_31230":75470,"_5":31585,"_21622":128422,"_28406":128423,"_3086":120633},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3696":75484,"_31230":75470,"_21622":128425,"_5":14887,"_28406":75470,"_3086":128426},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3696":75485,"_31230":75470,"_21622":128428,"_5":14887,"_28406":128381,"_3086":128429},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3696":75486,"_31230":75470,"_21622":128431,"_5":14887,"_28406":128381,"_3086":128432},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3696":75487,"_31230":75470,"_21622":128434,"_5":14887,"_28406":128381,"_3086":128435},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3696":75488,"_31230":75470,"_21622":128437,"_5":14887,"_28406":128381,"_3086":128438},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3696":75489,"_31230":75470,"_21622":128440,"_5":14887,"_28406":128381,"_3086":128441},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3696":75490,"_31230":75470,"_21622":128443,"_5":14887,"_28406":128384,"_3086":128444},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3696":75491,"_31230":75470,"_21622":128446,"_5":14887,"_28406":128388,"_3086":128447},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3696":75492,"_31230":75470,"_21622":128449,"_5":14887,"_28406":128388,"_3086":128450},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3696":75493,"_31230":75470,"_21622":128452,"_5":14887,"_28406":128392,"_3086":128453},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3696":75494,"_31230":75470,"_21622":128455,"_5":14887,"_28406":128392,"_3086":128456},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3696":75495,"_31230":75470,"_21622":128458,"_5":14887,"_28406":128396,"_3086":128459},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3696":75496,"_31230":75470,"_21622":128461,"_5":14887,"_28406":128396,"_3086":128462},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3696":75497,"_31230":75470,"_21622":128464,"_5":14887,"_28406":128400,"_3086":128465},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3696":75498,"_31230":75470,"_21622":128467,"_5":14887,"_28406":128404,"_3086":128468},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3696":75499,"_31230":75470,"_21622":128470,"_5":14887,"_28406":128408,"_3086":128471},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3696":75500,"_31230":75470,"_21622":128473,"_5":14887,"_28406":128412,"_3086":128474},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3696":75501,"_31230":75470,"_21622":128476,"_5":14887,"_28406":128412,"_3086":128477},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3696":75502,"_31230":75470,"_21622":128479,"_5":14887,"_28406":128412,"_3086":128480},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3696":75503,"_31230":75470,"_21622":128482,"_5":14887,"_28406":128416,"_3086":128483},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3696":75504,"_31230":75470,"_21622":128485,"_5":14887,"_28406":128416,"_3086":128486},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3696":75505,"_31230":75470,"_21622":128488,"_5":14887,"_28406":128416,"_3086":128489},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3696":75506,"_31230":75470,"_21622":128491,"_5":14887,"_28406":128420,"_3086":125887},[],{"_3696":75507,"_31230":75470,"_21622":128493,"_5":14887,"_28406":128420,"_3086":124402},[],{"_3696":75508,"_31230":75470,"_21622":128495,"_5":14887,"_28406":128420,"_3086":128496},[],"La CA rechaza la emisión",{"_3696":75509,"_31230":75470,"_21622":128498,"_5":14887,"_28406":128420,"_3086":128499},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3696":75510,"_31230":75470,"_21622":128501,"_5":14887,"_28406":128420,"_3086":128502},[],"Sujeto o usos diferentes",{"_3696":75511,"_31230":75470,"_21622":128504,"_5":14887,"_28406":128420,"_3086":128505},[],"Perfil aplicado y valores solicitados.",{"_3696":75512,"_31230":75470,"_21622":128507,"_5":14887,"_28406":128420,"_3086":128508},[],"No se encuentra el emisor",{"_3696":75513,"_31230":75470,"_21622":128510,"_5":14887,"_28406":128420,"_3086":128511},[],"CA descargada y cadena intermedia necesaria.",{"_3696":75514,"_31230":75470,"_21622":128513,"_5":14887,"_28406":128420,"_3086":128514},[],"Falla la vigencia",{"_3696":75515,"_31230":75470,"_21622":128516,"_5":14887,"_28406":128420,"_3086":128517},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3696":75516,"_31230":75470,"_21622":128519,"_5":14887,"_28406":128420,"_3086":128520},[],"Los resúmenes de clave difieren",{"_3696":75517,"_31230":75470,"_21622":128522,"_5":14887,"_28406":128420,"_3086":128523},[],"Archivos de certificado y clave de la misma emisión.",{"_3696":75518,"_31230":75470,"_21622":128525,"_5":14887,"_28406":128420,"_3086":128526},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3696":75519,"_31230":75470,"_21622":128528,"_5":14887,"_28406":128423,"_3086":128529},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3696":75520,"_31230":75470,"_21622":128531,"_5":14887,"_28406":128423,"_3086":128532},[],"Gestionar certificados para inspección, estado y revocación.",{"_3696":75521,"_31230":75470,"_21622":128534,"_5":14887,"_28406":128423,"_3086":128535},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3696":75522,"_31230":75470,"_21622":128537,"_5":14887,"_28406":128423,"_3086":128538},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3696":75523,"_31230":75470,"_21622":128540,"_5":14887,"_28406":128423,"_3086":128541},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3696":75524,"_31230":75524,"_5":15247,"_3086":128543,"_31588":128544,"_21622":128545,"_28406":75524},"Primeros pasos de PKI",[51065,122085,56761,125557],[],{"_3696":75525,"_31230":75524,"_21622":128547,"_5":14887,"_28406":75524,"_3086":128548},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3696":75526,"_31230":75524,"_5":31585,"_21622":128550,"_28406":128551,"_3086":120609},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3696":75527,"_31230":75524,"_5":31585,"_21622":128553,"_28406":128554,"_3086":128555},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3696":75528,"_31230":75524,"_5":31585,"_21622":128557,"_28406":128558,"_3086":125739},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3696":75529,"_31230":75524,"_5":31585,"_21622":128560,"_28406":128561,"_3086":128562},[],"/docs/pr-preview/pr-80/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3696":75530,"_31230":75524,"_21622":128564,"_5":14887,"_28406":75524,"_3086":128565},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3696":75531,"_31230":75524,"_21622":128567,"_5":14887,"_28406":128551,"_3086":128568},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3696":75532,"_31230":75524,"_21622":128570,"_5":14887,"_28406":128551,"_3086":128571},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3696":75533,"_31230":75524,"_21622":128573,"_5":14887,"_28406":128551,"_3086":128574},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3696":75534,"_31230":75524,"_21622":128576,"_5":14887,"_28406":128551,"_3086":128577},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3696":75535,"_31230":75524,"_21622":128579,"_5":14887,"_28406":128551,"_3086":128580},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3696":75536,"_31230":75524,"_21622":128582,"_5":14887,"_28406":128554,"_3086":128583},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3696":75537,"_31230":75524,"_21622":128585,"_5":14887,"_28406":128554,"_3086":128586},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3696":75538,"_31230":75524,"_21622":128588,"_5":14887,"_28406":128554,"_3086":128589},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3696":75539,"_31230":75524,"_21622":128591,"_5":14887,"_28406":128554,"_3086":128592},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3696":75540,"_31230":75524,"_21622":128594,"_5":14887,"_28406":128558,"_3086":128595},[],"Archivo o recurso",{"_3696":75541,"_31230":75524,"_21622":128597,"_5":14887,"_28406":128558,"_3086":125736},[],{"_3696":75542,"_31230":75524,"_21622":128599,"_5":14887,"_28406":128558,"_3086":128600},[],"CA raíz activa y `ca.pem`",{"_3696":75543,"_31230":75524,"_21622":128602,"_5":14887,"_28406":128558,"_3086":128603},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3696":75544,"_31230":75524,"_21622":128605,"_5":14887,"_28406":128558,"_3086":128606},[],"Certificado final y `device.crt`",{"_3696":75545,"_31230":75524,"_21622":128608,"_5":14887,"_28406":128558,"_3086":128609},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3696":75546,"_31230":75524,"_21622":128611,"_5":14887,"_28406":128558,"_3086":128612},[],"Clave privada `device.key`",{"_3696":75547,"_31230":75524,"_21622":128614,"_5":14887,"_28406":128558,"_3086":128615},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3696":75548,"_31230":75524,"_21622":128617,"_5":14887,"_28406":128558,"_3086":128618},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3696":75549,"_31230":75524,"_21622":128620,"_5":14887,"_28406":128561,"_3086":128621},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3696":75550,"_31230":75524,"_21622":128623,"_5":14887,"_28406":128561,"_3086":128624},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3696":75551,"_31230":75524,"_21622":128626,"_5":14887,"_28406":128561,"_3086":128627},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3696":75552,"_31230":75552,"_5":15247,"_3086":128629,"_31588":128630,"_21622":128632,"_28406":75552},"Resolución de problemas PKI",[51065,122085,56761,128631],"Resolución de problemas",[],{"_3696":75553,"_31230":75552,"_21622":128634,"_5":14887,"_28406":75552,"_3086":128635},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3696":75554,"_31230":75552,"_5":31585,"_21622":128637,"_28406":128638,"_3086":128639},[],"/docs/pr-preview/pr-80/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3696":75555,"_31230":75552,"_5":31585,"_21622":128641,"_28406":128642,"_3086":128643},[],"/docs/pr-preview/pr-80/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3696":75556,"_31230":75552,"_5":31585,"_21622":128645,"_28406":128646,"_3086":128647},[],"/docs/pr-preview/pr-80/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3696":75557,"_31230":75552,"_21622":128649,"_5":14887,"_28406":75552,"_3086":128650},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3696":75558,"_31230":75552,"_21622":128652,"_5":14887,"_28406":75552,"_3086":128653},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3696":75559,"_31230":75552,"_21622":128655,"_5":14887,"_28406":128638,"_3086":125736},[],{"_3696":75560,"_31230":75552,"_21622":128657,"_5":14887,"_28406":128638,"_3086":124402},[],{"_3696":75561,"_31230":75552,"_21622":128659,"_5":14887,"_28406":128638,"_3086":120633},[],{"_3696":75562,"_31230":75552,"_21622":128661,"_5":14887,"_28406":128638,"_3086":55603},[],{"_3696":75563,"_31230":75552,"_21622":128663,"_5":14887,"_28406":128638,"_3086":128664},[],"Existe, está activa y sus fechas son utilizables.",{"_3696":75564,"_31230":75552,"_21622":128666,"_5":14887,"_28406":128638,"_3086":128667},[],"Autoridades.",{"_3696":75565,"_31230":75552,"_21622":128669,"_5":14887,"_28406":128638,"_3086":128670},[],"Clave",{"_3696":75566,"_31230":75552,"_21622":128672,"_5":14887,"_28406":128638,"_3086":128673},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3696":75567,"_31230":75552,"_21622":128675,"_5":14887,"_28406":128638,"_3086":128676},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3696":75568,"_31230":75552,"_21622":128678,"_5":14887,"_28406":128638,"_3086":59368},[],{"_3696":75569,"_31230":75552,"_21622":128680,"_5":14887,"_28406":128638,"_3086":128681},[],"PEM correcto y firma verificable.",{"_3696":75570,"_31230":75552,"_21622":128683,"_5":14887,"_28406":128638,"_3086":59374},[],{"_3696":75571,"_31230":75552,"_21622":128685,"_5":14887,"_28406":128638,"_3086":128686},[],"Perfil",{"_3696":75572,"_31230":75552,"_21622":128688,"_5":14887,"_28406":128638,"_3086":128689},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3696":75573,"_31230":75552,"_21622":128691,"_5":14887,"_28406":128638,"_3086":128692},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3696":75574,"_31230":75552,"_21622":128694,"_5":14887,"_28406":128638,"_3086":125887},[],{"_3696":75575,"_31230":75552,"_21622":128696,"_5":14887,"_28406":128638,"_3086":128697},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3696":75576,"_31230":75552,"_21622":128699,"_5":14887,"_28406":128638,"_3086":128700},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3696":75577,"_31230":75552,"_21622":128702,"_5":14887,"_28406":128638,"_3086":128703},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3696":75578,"_31230":75552,"_21622":128705,"_5":14887,"_28406":128638,"_3086":128706},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3696":75579,"_31230":75552,"_21622":128708,"_5":14887,"_28406":128638,"_3086":128709},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3696":75580,"_31230":75552,"_21622":128711,"_5":14887,"_28406":128642,"_3086":128712},[],"Revisa cada frontera por separado:",{"_3696":75581,"_31230":75552,"_21622":128714,"_5":14887,"_28406":128642,"_3086":128715},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3696":75582,"_31230":75552,"_21622":128717,"_5":14887,"_28406":128642,"_3086":128718},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3696":75583,"_31230":75552,"_21622":128720,"_5":14887,"_28406":128642,"_3086":128721},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3696":75584,"_31230":75552,"_21622":128723,"_5":14887,"_28406":128642,"_3086":128724},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3696":75585,"_31230":75552,"_21622":128726,"_5":14887,"_28406":128642,"_3086":128727},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3696":75586,"_31230":75552,"_21622":128729,"_5":14887,"_28406":128642,"_3086":128730},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3696":75587,"_31230":75552,"_21622":128732,"_5":14887,"_28406":128646,"_3086":128733},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3696":75588,"_31230":75552,"_21622":128735,"_5":14887,"_28406":128646,"_3086":128736},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3696":75589,"_31230":75589,"_5":15247,"_3086":128738,"_31588":128739,"_21622":128740,"_28406":75589},"Seguridad",[51065],[],{"_3696":75590,"_31230":75589,"_21622":128742,"_5":14887,"_28406":75589,"_3086":128743},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3696":75591,"_31230":75589,"_5":31585,"_21622":128745,"_28406":128746,"_3086":128747},[],"/docs/pr-preview/pr-80/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3696":75592,"_31230":75589,"_5":31585,"_21622":128749,"_28406":128750,"_3086":128751},[],"/docs/pr-preview/pr-80/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3696":75593,"_31230":75589,"_5":31585,"_21622":128753,"_28406":128754,"_3086":128755},[],"/docs/pr-preview/pr-80/es/security#versiones-soportadas","Versiones soportadas",{"_3696":75594,"_31230":75589,"_5":31585,"_21622":128757,"_28406":128758,"_3086":128759},[],"/docs/pr-preview/pr-80/es/security#divulgación-responsable","Divulgación responsable",{"_3696":75595,"_31230":75589,"_21622":128761,"_5":14887,"_28406":75589,"_3086":128762},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3696":75596,"_31230":75589,"_21622":128764,"_5":14887,"_28406":128746,"_3086":128765},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3696":75597,"_31230":75589,"_21622":128767,"_5":14887,"_28406":128746,"_3086":128768},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3696":75598,"_31230":75589,"_21622":128770,"_5":14887,"_28406":128746,"_3086":15526},[],{"_3696":75599,"_31230":75589,"_21622":128772,"_5":14887,"_28406":128746,"_3086":15455},[],{"_3696":75600,"_31230":75589,"_21622":128774,"_5":14887,"_28406":128746,"_3086":15513},[],{"_3696":75601,"_31230":75589,"_21622":128776,"_5":14887,"_28406":128746,"_3086":128777},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3696":75602,"_31230":75589,"_21622":128779,"_5":14887,"_28406":128746,"_3086":128780},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3696":75603,"_31230":75589,"_21622":128782,"_5":14887,"_28406":128750,"_3086":128783},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3696":75604,"_31230":75589,"_21622":128785,"_5":14887,"_28406":128750,"_3086":128786},[],"No incluyas en el reporte:",{"_3696":75605,"_31230":75589,"_21622":128788,"_5":14887,"_28406":128750,"_3086":128789},[],"Credenciales, tokens o claves privadas",{"_3696":75606,"_31230":75589,"_21622":128791,"_5":14887,"_28406":128750,"_3086":128792},[],"Datos de clientes o información identificable de clientes",{"_3696":75607,"_31230":75589,"_21622":128794,"_5":14887,"_28406":128750,"_3086":128795},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3696":75608,"_31230":75589,"_21622":128797,"_5":14887,"_28406":128754,"_3086":128798},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3696":75609,"_31230":75589,"_21622":128800,"_5":14887,"_28406":128754,"_3086":128801},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3696":75610,"_31230":75589,"_21622":128803,"_5":14887,"_28406":128758,"_3086":128804},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3696":75611,"_31230":75589,"_21622":128806,"_5":14887,"_28406":128758,"_3086":128807},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3696":75612,"_31230":75589,"_21622":128809,"_5":14887,"_28406":128758,"_3086":128810},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3696":75613,"_31230":75589,"_21622":128812,"_5":14887,"_28406":128758,"_3086":128813},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3696":75614,"_31230":75589,"_21622":128815,"_5":14887,"_28406":128758,"_3086":128816},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3696":75615,"_31230":75615,"_5":15247,"_3086":128818,"_31588":128819,"_21622":128821,"_28406":75615},"3.8.0 a 4.0.0",[51065,128820],"Actualizaciones",[],{"_3696":75616,"_31230":75615,"_21622":128823,"_5":14887,"_28406":75615,"_3086":128824},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3696":75617,"_31230":75615,"_5":31585,"_21622":128826,"_28406":128827,"_3086":128828},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3696":75618,"_31230":75615,"_5":31585,"_21622":128830,"_28406":128831,"_3086":128832},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3696":75619,"_31230":75615,"_5":31585,"_21622":128834,"_28406":128835,"_3086":128836},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3696":75620,"_31230":75615,"_5":31585,"_21622":128838,"_28406":128839,"_3086":128840},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3696":75621,"_31230":75615,"_5":31585,"_21622":128842,"_28406":128843,"_3086":128844},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3696":75622,"_31230":75615,"_5":31585,"_21622":128846,"_28406":128847,"_3086":128848},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3696":75623,"_31230":75615,"_5":31585,"_21622":128850,"_28406":128851,"_3086":59543},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3696":75624,"_31230":75615,"_5":31585,"_21622":128853,"_28406":128854,"_3086":128855},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3696":75625,"_31230":75615,"_5":31585,"_21622":128857,"_28406":128858,"_3086":128859},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3696":75626,"_31230":75615,"_5":31585,"_21622":128861,"_28406":128862,"_3086":128863},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3696":75627,"_31230":75615,"_5":31585,"_21622":128865,"_28406":128866,"_3086":121204},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3696":75628,"_31230":75615,"_5":31585,"_21622":128868,"_28406":128869,"_3086":128870},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3696":75629,"_31230":75615,"_5":31585,"_21622":128872,"_28406":128873,"_3086":128874},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3696":75630,"_31230":75615,"_5":31585,"_21622":128876,"_28406":128877,"_3086":128878},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3696":75631,"_31230":75615,"_5":31585,"_21622":128880,"_28406":128881,"_3086":128882},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3696":75632,"_31230":75615,"_5":31585,"_21622":128884,"_28406":128885,"_3086":128886},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3696":75633,"_31230":75615,"_5":31585,"_21622":128888,"_28406":128889,"_3086":128890},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3696":75634,"_31230":75615,"_5":31585,"_21622":128892,"_28406":128893,"_3086":128894},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3696":75635,"_31230":75615,"_5":31585,"_21622":128896,"_28406":128897,"_3086":128898},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3696":75636,"_31230":75615,"_5":31585,"_21622":128900,"_28406":128901,"_3086":128902},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3696":75637,"_31230":75615,"_5":31585,"_21622":128904,"_28406":128905,"_3086":128906},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3696":75638,"_31230":75615,"_5":31585,"_21622":128908,"_28406":128909,"_3086":128910},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3696":75639,"_31230":75615,"_5":31585,"_21622":128912,"_28406":128913,"_3086":128914},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3696":75640,"_31230":75615,"_5":31585,"_21622":128916,"_28406":128917,"_3086":128918},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3696":75641,"_31230":75615,"_5":31585,"_21622":128920,"_28406":128921,"_3086":128922},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3696":75642,"_31230":75615,"_5":31585,"_21622":128924,"_28406":128925,"_3086":128926},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3696":75643,"_31230":75615,"_5":31585,"_21622":128928,"_28406":128929,"_3086":128930},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3696":75644,"_31230":75615,"_5":31585,"_21622":128932,"_28406":128933,"_3086":128934},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3696":75645,"_31230":75615,"_5":31585,"_21622":128936,"_28406":128937,"_3086":128938},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3696":75646,"_31230":75615,"_5":31585,"_21622":128940,"_28406":128941,"_3086":128942},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3696":75647,"_31230":75615,"_5":31585,"_21622":128944,"_28406":128945,"_3086":128946},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3696":75648,"_31230":75615,"_5":31585,"_21622":128948,"_28406":128949,"_3086":128950},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3696":75649,"_31230":75615,"_5":31585,"_21622":128952,"_28406":128953,"_3086":128954},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3696":75650,"_31230":75615,"_5":31585,"_21622":128956,"_28406":128957,"_3086":128958},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3696":75651,"_31230":75615,"_5":31585,"_21622":128960,"_28406":128961,"_3086":128962},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3696":75652,"_31230":75615,"_5":31585,"_21622":128964,"_28406":128965,"_3086":128966},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3696":75653,"_31230":75615,"_5":31585,"_21622":128968,"_28406":128969,"_3086":128970},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3696":75654,"_31230":75615,"_5":31585,"_21622":128972,"_28406":128973,"_3086":128974},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3696":75655,"_31230":75615,"_5":31585,"_21622":128976,"_28406":128977,"_3086":128978},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3696":75656,"_31230":75615,"_5":31585,"_21622":128980,"_28406":128981,"_3086":128982},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3696":75657,"_31230":75615,"_5":31585,"_21622":128984,"_28406":128985,"_3086":128986},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3696":75658,"_31230":75615,"_5":31585,"_21622":128988,"_28406":128989,"_3086":128990},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3696":75659,"_31230":75615,"_5":31585,"_21622":128992,"_28406":128993,"_3086":128994},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3696":75660,"_31230":75615,"_5":31585,"_21622":128996,"_28406":128997,"_3086":128998},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3696":75661,"_31230":75615,"_5":31585,"_21622":129000,"_28406":129001,"_3086":124750},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3696":75662,"_31230":75615,"_5":31585,"_21622":129003,"_28406":129004,"_3086":129005},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3696":75663,"_31230":75615,"_5":31585,"_21622":129007,"_28406":129008,"_3086":129009},[],"/docs/pr-preview/pr-80/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3696":75664,"_31230":75615,"_21622":129011,"_5":14887,"_28406":75615,"_3086":129012},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3696":75665,"_31230":75615,"_21622":129014,"_5":14887,"_28406":75615,"_3086":129015},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3696":75666,"_31230":75615,"_21622":129017,"_5":14887,"_28406":75615,"_3086":129018},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3696":75667,"_31230":75615,"_21622":129020,"_5":14887,"_28406":75615,"_3086":129021},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3696":75668,"_31230":75615,"_21622":129023,"_5":14887,"_28406":75615,"_3086":129024},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3696":75669,"_31230":75615,"_21622":129026,"_5":14887,"_28406":75615,"_3086":129027},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3696":75670,"_31230":75615,"_21622":129029,"_5":14887,"_28406":75615,"_3086":129030},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3696":75671,"_31230":75615,"_21622":129032,"_5":14887,"_28406":128831,"_3086":129033},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3696":75672,"_31230":75615,"_21622":129035,"_5":14887,"_28406":128831,"_3086":129036},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3696":75673,"_31230":75615,"_21622":129038,"_5":14887,"_28406":128835,"_3086":129039},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3696":75674,"_31230":75615,"_21622":129041,"_5":14887,"_28406":128835,"_3086":129042},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3696":75675,"_31230":75615,"_21622":129044,"_5":14887,"_28406":128839,"_3086":129045},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3696":75676,"_31230":75615,"_21622":129047,"_5":14887,"_28406":128843,"_3086":129048},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3696":75677,"_31230":75615,"_21622":129050,"_5":14887,"_28406":128843,"_3086":129051},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3696":75678,"_31230":75615,"_21622":129053,"_5":14887,"_28406":128843,"_3086":129054},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3696":75679,"_31230":75615,"_21622":129056,"_5":14887,"_28406":128843,"_3086":129057},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3696":75680,"_31230":75615,"_21622":129059,"_5":14887,"_28406":128843,"_3086":129060},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3696":75681,"_31230":75615,"_21622":129062,"_5":14887,"_28406":128847,"_3086":129063},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3696":75682,"_31230":75615,"_21622":129065,"_5":14887,"_28406":128847,"_3086":129066},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3696":75683,"_31230":75615,"_21622":129068,"_5":14887,"_28406":128847,"_3086":129069},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3696":75684,"_31230":75615,"_21622":129071,"_5":14887,"_28406":128847,"_3086":129072},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3696":75685,"_31230":75615,"_21622":129074,"_5":14887,"_28406":128847,"_3086":129075},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3696":75686,"_31230":75615,"_21622":129077,"_5":14887,"_28406":128847,"_3086":129078},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3696":75687,"_31230":75615,"_21622":129080,"_5":14887,"_28406":128851,"_3086":129081},[],"Cambio",{"_3696":75688,"_31230":75615,"_21622":129083,"_5":14887,"_28406":128851,"_3086":129084},[],"A quién afecta",{"_3696":75689,"_31230":75615,"_21622":129086,"_5":14887,"_28406":128851,"_3086":129087},[],"Gravedad",{"_3696":75690,"_31230":75615,"_21622":129089,"_5":14887,"_28406":128851,"_3086":127560},[],{"_3696":75691,"_31230":75615,"_21622":129091,"_5":14887,"_28406":128851,"_3086":128859},[],{"_3696":75692,"_31230":75615,"_21622":129093,"_5":14887,"_28406":128851,"_3086":129094},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3696":75693,"_31230":75615,"_21622":129096,"_5":14887,"_28406":128851,"_3086":129097},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3696":75694,"_31230":75615,"_21622":129099,"_5":14887,"_28406":128851,"_3086":129100},[],"Copiar los datos a los volúmenes nuevos",{"_3696":75695,"_31230":75615,"_21622":129102,"_5":14887,"_28406":128851,"_3086":128863},[],{"_3696":75696,"_31230":75615,"_21622":129104,"_5":14887,"_28406":128851,"_3086":129105},[],"Todas las releases de Helm",{"_3696":75697,"_31230":75615,"_21622":129107,"_5":14887,"_28406":128851,"_3086":129108},[],"Alta: `helm upgrade` falla",{"_3696":75698,"_31230":75615,"_21622":129110,"_5":14887,"_28406":128851,"_3086":129111},[],"Eliminar o renombrar las claves heredadas",{"_3696":75699,"_31230":75615,"_21622":129113,"_5":14887,"_28406":128851,"_3086":121204},[],{"_3696":75700,"_31230":75615,"_21622":129115,"_5":14887,"_28406":128851,"_3086":129105},[],{"_3696":75701,"_31230":75615,"_21622":129117,"_5":14887,"_28406":128851,"_3086":129118},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3696":75702,"_31230":75615,"_21622":129120,"_5":14887,"_28406":128851,"_3086":129121},[],"Crear primero los Secrets; consulta el paso 2",{"_3696":75703,"_31230":75615,"_21622":129123,"_5":14887,"_28406":128851,"_3086":128870},[],{"_3696":75704,"_31230":75615,"_21622":129125,"_5":14887,"_28406":128851,"_3086":129126},[],"Todos los despliegues",{"_3696":75705,"_31230":75615,"_21622":129128,"_5":14887,"_28406":128851,"_3086":129129},[],"Alta: sin principal de bootstrap no hay administrador",{"_3696":75706,"_31230":75615,"_21622":129131,"_5":14887,"_28406":128851,"_3086":129132},[],"Configurar `services.authz`",{"_3696":75707,"_31230":75615,"_21622":129134,"_5":14887,"_28406":128851,"_3086":128874},[],{"_3696":75708,"_31230":75615,"_21622":129136,"_5":14887,"_28406":128851,"_3086":129105},[],{"_3696":75709,"_31230":75615,"_21622":129138,"_5":14887,"_28406":128851,"_3086":129139},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3696":75710,"_31230":75615,"_21622":129141,"_5":14887,"_28406":128851,"_3086":129142},[],"Mover JWKS y roles a `services.authz`",{"_3696":75711,"_31230":75615,"_21622":129144,"_5":14887,"_28406":128851,"_3086":128894},[],{"_3696":75712,"_31230":75615,"_21622":129146,"_5":14887,"_28406":128851,"_3086":129147},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3696":75713,"_31230":75615,"_21622":129149,"_5":14887,"_28406":128851,"_3086":129150},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3696":75714,"_31230":75615,"_21622":129152,"_5":14887,"_28406":128851,"_3086":129153},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3696":75715,"_31230":75615,"_21622":129155,"_5":14887,"_28406":128851,"_3086":128898},[],{"_3696":75716,"_31230":75615,"_21622":129157,"_5":14887,"_28406":128851,"_3086":129158},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3696":75717,"_31230":75615,"_21622":129160,"_5":14887,"_28406":128851,"_3086":129161},[],"Alta: el backend ya no arranca con ellos",{"_3696":75718,"_31230":75615,"_21622":129163,"_5":14887,"_28406":128851,"_3086":129164},[],"Pasar a PostgreSQL antes de actualizar",{"_3696":75719,"_31230":75615,"_21622":129166,"_5":14887,"_28406":128851,"_3086":128946},[],{"_3696":75720,"_31230":75615,"_21622":129168,"_5":14887,"_28406":128851,"_3086":129169},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3696":75721,"_31230":75615,"_21622":129171,"_5":14887,"_28406":128851,"_3086":129172},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3696":75722,"_31230":75615,"_21622":129174,"_5":14887,"_28406":128851,"_3086":129175},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3696":75723,"_31230":75615,"_21622":129177,"_5":14887,"_28406":128851,"_3086":129178},[],"Webhooks con referencias a archivos",{"_3696":75724,"_31230":75615,"_21622":129180,"_5":14887,"_28406":128851,"_3086":129181},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3696":75725,"_31230":75615,"_21622":129183,"_5":14887,"_28406":128851,"_3086":129184},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3696":75726,"_31230":75615,"_21622":129186,"_5":14887,"_28406":128851,"_3086":129187},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3696":75727,"_31230":75615,"_21622":129189,"_5":14887,"_28406":128851,"_3086":128878},[],{"_3696":75728,"_31230":75615,"_21622":129191,"_5":14887,"_28406":128851,"_3086":129192},[],"Releases con identidades por servicio o material de claves montado",{"_3696":75729,"_31230":75615,"_21622":129194,"_5":14887,"_28406":128851,"_3086":129195},[],"Media: los servicios no pueden leer sus archivos",{"_3696":75730,"_31230":75615,"_21622":129197,"_5":14887,"_28406":128851,"_3086":129198},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3696":75731,"_31230":75615,"_21622":129200,"_5":14887,"_28406":128851,"_3086":128882},[],{"_3696":75732,"_31230":75615,"_21622":129202,"_5":14887,"_28406":128851,"_3086":129203},[],"Releases que definen `amqp.tls`",{"_3696":75733,"_31230":75615,"_21622":129205,"_5":14887,"_28406":128851,"_3086":129206},[],"Media: los clientes se conectan al puerto equivocado",{"_3696":75734,"_31230":75615,"_21622":129208,"_5":14887,"_28406":128851,"_3086":129209},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3696":75735,"_31230":75615,"_21622":129211,"_5":14887,"_28406":128851,"_3086":128902},[],{"_3696":75736,"_31230":75615,"_21622":129213,"_5":14887,"_28406":128851,"_3086":129214},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3696":75737,"_31230":75615,"_21622":129216,"_5":14887,"_28406":128851,"_3086":129217},[],"Media: las claves de CA quedan sin gestionar",{"_3696":75738,"_31230":75615,"_21622":129219,"_5":14887,"_28406":128851,"_3086":129220},[],"Ejecutar la migración de CA a KMS",{"_3696":75739,"_31230":75615,"_21622":129222,"_5":14887,"_28406":128851,"_3086":129223},[],"Verificación del certificado del receptor",{"_3696":75740,"_31230":75615,"_21622":129225,"_5":14887,"_28406":128851,"_3086":129226},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3696":75741,"_31230":75615,"_21622":129228,"_5":14887,"_28406":128851,"_3086":129229},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3696":75742,"_31230":75615,"_21622":129231,"_5":14887,"_28406":128851,"_3086":129232},[],"Poner `insecure_skip_verify` a `false`",{"_3696":75743,"_31230":75615,"_21622":129234,"_5":14887,"_28406":128851,"_3086":128918},[],{"_3696":75744,"_31230":75615,"_21622":129236,"_5":14887,"_28406":128851,"_3086":129237},[],"Scripts y consolas que editan DMS por API",{"_3696":75745,"_31230":75615,"_21622":129239,"_5":14887,"_28406":128851,"_3086":129240},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3696":75746,"_31230":75615,"_21622":129242,"_5":14887,"_28406":128851,"_3086":129243},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3696":75747,"_31230":75615,"_21622":129245,"_5":14887,"_28406":128851,"_3086":128922},[],{"_3696":75748,"_31230":75615,"_21622":129247,"_5":14887,"_28406":128851,"_3086":129248},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3696":75749,"_31230":75615,"_21622":129250,"_5":14887,"_28406":128851,"_3086":129251},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3696":75750,"_31230":75615,"_21622":129253,"_5":14887,"_28406":128851,"_3086":129254},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3696":75751,"_31230":75615,"_21622":129256,"_5":14887,"_28406":128851,"_3086":128942},[],{"_3696":75752,"_31230":75615,"_21622":129258,"_5":14887,"_28406":128851,"_3086":129259},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3696":75753,"_31230":75615,"_21622":129261,"_5":14887,"_28406":128851,"_3086":129262},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3696":75754,"_31230":75615,"_21622":129264,"_5":14887,"_28406":128851,"_3086":129265},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3696":75755,"_31230":75615,"_21622":129267,"_5":14887,"_28406":128851,"_3086":128950},[],{"_3696":75756,"_31230":75615,"_21622":129269,"_5":14887,"_28406":128851,"_3086":129270},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3696":75757,"_31230":75615,"_21622":129272,"_5":14887,"_28406":128851,"_3086":129273},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3696":75758,"_31230":75615,"_21622":129275,"_5":14887,"_28406":128851,"_3086":129276},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3696":75759,"_31230":75615,"_21622":129278,"_5":14887,"_28406":128851,"_3086":128954},[],{"_3696":75760,"_31230":75615,"_21622":129280,"_5":14887,"_28406":128851,"_3086":129281},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3696":75761,"_31230":75615,"_21622":129283,"_5":14887,"_28406":128851,"_3086":129284},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3696":75762,"_31230":75615,"_21622":129286,"_5":14887,"_28406":128851,"_3086":129287},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3696":75763,"_31230":75615,"_21622":129289,"_5":14887,"_28406":128851,"_3086":128938},[],{"_3696":75764,"_31230":75615,"_21622":129291,"_5":14887,"_28406":128851,"_3086":129292},[],"Consumidores que leen el campo `events` del dispositivo",{"_3696":75765,"_31230":75615,"_21622":129294,"_5":14887,"_28406":128851,"_3086":129295},[],"Media: el campo desaparece",{"_3696":75766,"_31230":75615,"_21622":129297,"_5":14887,"_28406":128851,"_3086":129298},[],"Usar los nuevos endpoints de eventos",{"_3696":75767,"_31230":75615,"_21622":129300,"_5":14887,"_28406":128851,"_3086":128966},[],{"_3696":75768,"_31230":75615,"_21622":129302,"_5":14887,"_28406":128851,"_3086":129303},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3696":75769,"_31230":75615,"_21622":129305,"_5":14887,"_28406":128851,"_3086":129306},[],"Media: la migración de la VA aborta",{"_3696":75770,"_31230":75615,"_21622":129308,"_5":14887,"_28406":128851,"_3086":129309},[],"Corregir los roles afectados antes de actualizar",{"_3696":75771,"_31230":75615,"_21622":129311,"_5":14887,"_28406":128851,"_3086":128886},[],{"_3696":75772,"_31230":75615,"_21622":129313,"_5":14887,"_28406":128851,"_3086":129314},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3696":75773,"_31230":75615,"_21622":129316,"_5":14887,"_28406":128851,"_3086":129317},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3696":75774,"_31230":75615,"_21622":129319,"_5":14887,"_28406":128851,"_3086":129320},[],"Actualizar el archivo de values",{"_3696":75775,"_31230":75615,"_21622":129322,"_5":14887,"_28406":128851,"_3086":128930},[],{"_3696":75776,"_31230":75615,"_21622":129324,"_5":14887,"_28406":128851,"_3086":129325},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3696":75777,"_31230":75615,"_21622":129327,"_5":14887,"_28406":128851,"_3086":129328},[],"Baja: prevalece el ID de la URL",{"_3696":75778,"_31230":75615,"_21622":129330,"_5":14887,"_28406":128851,"_3086":129331},[],"Enviar el ID en la URL",{"_3696":75779,"_31230":75615,"_21622":129333,"_5":14887,"_28406":128851,"_3086":128958},[],{"_3696":75780,"_31230":75615,"_21622":129335,"_5":14887,"_28406":128851,"_3086":129336},[],"Clientes que envían un `id` al crear o importar CAs",{"_3696":75781,"_31230":75615,"_21622":129338,"_5":14887,"_28406":128851,"_3086":129339},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3696":75782,"_31230":75615,"_21622":129341,"_5":14887,"_28406":128851,"_3086":129342},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3696":75783,"_31230":75615,"_21622":129344,"_5":14887,"_28406":128851,"_3086":128962},[],{"_3696":75784,"_31230":75615,"_21622":129346,"_5":14887,"_28406":128851,"_3086":129347},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3696":75785,"_31230":75615,"_21622":129349,"_5":14887,"_28406":128851,"_3086":129350},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3696":75786,"_31230":75615,"_21622":129352,"_5":14887,"_28406":128851,"_3086":129353},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3696":75787,"_31230":75615,"_21622":129355,"_5":14887,"_28406":128851,"_3086":128934},[],{"_3696":75788,"_31230":75615,"_21622":129357,"_5":14887,"_28406":128851,"_3086":129358},[],"Consumidores que comparan el `type` del certificado",{"_3696":75789,"_31230":75615,"_21622":129360,"_5":14887,"_28406":128851,"_3086":129361},[],"Baja: dos valores cambian de nombre",{"_3696":75790,"_31230":75615,"_21622":129363,"_5":14887,"_28406":128851,"_3086":129364},[],"Adaptar los consumidores",{"_3696":75791,"_31230":75615,"_21622":129366,"_5":14887,"_28406":128851,"_3086":128926},[],{"_3696":75792,"_31230":75615,"_21622":129368,"_5":14887,"_28406":128851,"_3086":129369},[],"Cualquier DMS",{"_3696":75793,"_31230":75615,"_21622":129371,"_5":14887,"_28406":128851,"_3086":129372},[],"Baja: solo informativo",{"_3696":75794,"_31230":75615,"_21622":129374,"_5":14887,"_28406":128851,"_3086":129375},[],"Revisar ambos bloques antes de editar",{"_3696":75795,"_31230":75615,"_21622":129377,"_5":14887,"_28406":128858,"_3086":129378},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3696":75796,"_31230":75615,"_21622":129380,"_5":14887,"_28406":128858,"_3086":129381},[],"El paso 4 de la guía de migración copia los datos.",{"_3696":75797,"_31230":75615,"_21622":129383,"_5":14887,"_28406":128862,"_3086":129384},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3696":75798,"_31230":75615,"_21622":129386,"_5":14887,"_28406":128866,"_3086":129387},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3696":75799,"_31230":75615,"_21622":129389,"_5":14887,"_28406":128866,"_3086":129390},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3696":75800,"_31230":75615,"_21622":129392,"_5":14887,"_28406":128869,"_3086":129393},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3696":75801,"_31230":75615,"_21622":129395,"_5":14887,"_28406":128873,"_3086":129396},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3696":75802,"_31230":75615,"_21622":129398,"_5":14887,"_28406":128877,"_3086":129399},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3696":75803,"_31230":75615,"_21622":129401,"_5":14887,"_28406":128877,"_3086":129402},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3696":75804,"_31230":75615,"_21622":129404,"_5":14887,"_28406":128877,"_3086":129405},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3696":75805,"_31230":75615,"_21622":129407,"_5":14887,"_28406":128881,"_3086":129408},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3696":75806,"_31230":75615,"_21622":129410,"_5":14887,"_28406":128885,"_3086":129411},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3696":75807,"_31230":75615,"_21622":129413,"_5":14887,"_28406":128885,"_3086":129414},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3696":75808,"_31230":75615,"_21622":129416,"_5":14887,"_28406":128885,"_3086":129417},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3696":75809,"_31230":75615,"_21622":129419,"_5":14887,"_28406":128885,"_3086":129420},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3696":75810,"_31230":75615,"_21622":129422,"_5":14887,"_28406":128885,"_3086":129423},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3696":75811,"_31230":75615,"_21622":129425,"_5":14887,"_28406":128885,"_3086":129426},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3696":75812,"_31230":75615,"_21622":129428,"_5":14887,"_28406":128893,"_3086":129429},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3696":75813,"_31230":75615,"_21622":129431,"_5":14887,"_28406":128893,"_3086":129432},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3696":75814,"_31230":75615,"_21622":129434,"_5":14887,"_28406":128893,"_3086":129435},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3696":75815,"_31230":75615,"_21622":129437,"_5":14887,"_28406":128893,"_3086":129438},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3696":75816,"_31230":75615,"_21622":129440,"_5":14887,"_28406":128893,"_3086":129441},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3696":75817,"_31230":75615,"_21622":129443,"_5":14887,"_28406":128897,"_3086":129444},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3696":75818,"_31230":75615,"_21622":129446,"_5":14887,"_28406":128901,"_3086":129447},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3696":75819,"_31230":75615,"_21622":129449,"_5":14887,"_28406":128901,"_3086":129450},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3696":75820,"_31230":75615,"_21622":129452,"_5":14887,"_28406":128901,"_3086":129453},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3696":75821,"_31230":75615,"_21622":129455,"_5":14887,"_28406":128901,"_3086":129456},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3696":75822,"_31230":75615,"_21622":129458,"_5":14887,"_28406":128901,"_3086":129459},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3696":75823,"_31230":75615,"_21622":129461,"_5":14887,"_28406":128901,"_3086":129462},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3696":75824,"_31230":75615,"_21622":129464,"_5":14887,"_28406":128901,"_3086":129465},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3696":75825,"_31230":75615,"_21622":129467,"_5":14887,"_28406":128901,"_3086":129468},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3696":75826,"_31230":75615,"_21622":129470,"_5":14887,"_28406":128905,"_3086":129471},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3696":75827,"_31230":75615,"_21622":129473,"_5":14887,"_28406":128913,"_3086":129474},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3696":75828,"_31230":75615,"_21622":129476,"_5":14887,"_28406":128913,"_3086":129477},[],"Campo en 3.8.0",{"_3696":75829,"_31230":75615,"_21622":129479,"_5":14887,"_28406":128913,"_3086":129480},[],"Campo en 4.0.0",{"_3696":75830,"_31230":75615,"_21622":129482,"_5":14887,"_28406":128913,"_3086":60174},[],{"_3696":75831,"_31230":75615,"_21622":129484,"_5":14887,"_28406":128913,"_3086":129485},[],"`insecure_skip_verify` (con el valor negado)",{"_3696":75832,"_31230":75615,"_21622":129487,"_5":14887,"_28406":128913,"_3086":60180},[],{"_3696":75833,"_31230":75615,"_21622":129489,"_5":14887,"_28406":128913,"_3086":60183},[],{"_3696":75834,"_31230":75615,"_21622":129491,"_5":14887,"_28406":128913,"_3086":60186},[],{"_3696":75835,"_31230":75615,"_21622":129493,"_5":14887,"_28406":128913,"_3086":60189},[],{"_3696":75836,"_31230":75615,"_21622":129495,"_5":14887,"_28406":128913,"_3086":60192},[],{"_3696":75837,"_31230":75615,"_21622":129497,"_5":14887,"_28406":128913,"_3086":60195},[],{"_3696":75838,"_31230":75615,"_21622":129499,"_5":14887,"_28406":128913,"_3086":129500},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3696":75839,"_31230":75615,"_21622":129502,"_5":14887,"_28406":128913,"_3086":129503},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3696":75840,"_31230":75615,"_21622":129505,"_5":14887,"_28406":128913,"_3086":129506},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3696":75841,"_31230":75615,"_21622":129508,"_5":14887,"_28406":128917,"_3086":129509},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3696":75842,"_31230":75615,"_21622":129511,"_5":14887,"_28406":128917,"_3086":129512},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3696":75843,"_31230":75615,"_21622":129514,"_5":14887,"_28406":128917,"_3086":129515},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3696":75844,"_31230":75615,"_21622":129517,"_5":14887,"_28406":128921,"_3086":129518},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3696":75845,"_31230":75615,"_21622":129520,"_5":14887,"_28406":128921,"_3086":129521},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3696":75846,"_31230":75615,"_21622":129523,"_5":14887,"_28406":128925,"_3086":129524},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3696":75847,"_31230":75615,"_21622":129526,"_5":14887,"_28406":128929,"_3086":129527},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3696":75848,"_31230":75615,"_21622":129529,"_5":14887,"_28406":128933,"_3086":129530},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3696":75849,"_31230":75615,"_21622":129532,"_5":14887,"_28406":128937,"_3086":129533},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3696":75850,"_31230":75615,"_21622":129535,"_5":14887,"_28406":128937,"_3086":129536},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3696":75851,"_31230":75615,"_21622":129538,"_5":14887,"_28406":128937,"_3086":129539},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3696":75852,"_31230":75615,"_21622":129541,"_5":14887,"_28406":128937,"_3086":129542},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza. En un despliegue con Helm, define `services.deviceManager.sseEnabled` como `false` para deshabilitar SSE (por defecto `true`); consulta Flujo de eventos de dispositivo (SSE).",{"_3696":75853,"_31230":75615,"_21622":129544,"_5":14887,"_28406":128941,"_3086":129545},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3696":75854,"_31230":75615,"_21622":129547,"_5":14887,"_28406":128945,"_3086":129548},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3696":75855,"_31230":75615,"_21622":129550,"_5":14887,"_28406":128945,"_3086":129551},[],"Ruta",{"_3696":75856,"_31230":75615,"_21622":129553,"_5":14887,"_28406":128945,"_3086":121845},[],{"_3696":75857,"_31230":75615,"_21622":129555,"_5":14887,"_28406":128945,"_3086":60254},[],{"_3696":75858,"_31230":75615,"_21622":129557,"_5":14887,"_28406":128945,"_3086":129558},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3696":75859,"_31230":75615,"_21622":129560,"_5":14887,"_28406":128945,"_3086":60260},[],{"_3696":75860,"_31230":75615,"_21622":129562,"_5":14887,"_28406":128945,"_3086":129563},[],"Lee los ajustes de una CA.",{"_3696":75861,"_31230":75615,"_21622":129565,"_5":14887,"_28406":128945,"_3086":60266},[],{"_3696":75862,"_31230":75615,"_21622":129567,"_5":14887,"_28406":128945,"_3086":129568},[],"Sustituye los `crl_options`.",{"_3696":75863,"_31230":75615,"_21622":129570,"_5":14887,"_28406":128945,"_3086":60272},[],{"_3696":75864,"_31230":75615,"_21622":129572,"_5":14887,"_28406":128945,"_3086":129573},[],"Elimina los ajustes archivados de una CA.",{"_3696":75865,"_31230":75615,"_21622":129575,"_5":14887,"_28406":128945,"_3086":129576},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3696":75866,"_31230":75615,"_21622":129578,"_5":14887,"_28406":128945,"_3086":129579},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3696":75867,"_31230":75615,"_21622":129581,"_5":14887,"_28406":128945,"_3086":129582},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3696":75868,"_31230":75615,"_21622":129584,"_5":14887,"_28406":128945,"_3086":129585},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3696":75869,"_31230":75615,"_21622":129587,"_5":14887,"_28406":128945,"_3086":129588},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3696":75870,"_31230":75615,"_21622":129590,"_5":14887,"_28406":128945,"_3086":129591},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3696":75871,"_31230":75615,"_21622":129593,"_5":14887,"_28406":128945,"_3086":129594},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3696":75872,"_31230":75615,"_21622":129596,"_5":14887,"_28406":128945,"_3086":129597},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3696":75873,"_31230":75615,"_21622":129599,"_5":14887,"_28406":128945,"_3086":129600},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3696":75874,"_31230":75615,"_21622":129602,"_5":14887,"_28406":128945,"_3086":129603},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3696":75875,"_31230":75615,"_21622":129605,"_5":14887,"_28406":128945,"_3086":129606},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3696":75876,"_31230":75615,"_21622":129608,"_5":14887,"_28406":128949,"_3086":129609},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3696":75877,"_31230":75615,"_21622":129611,"_5":14887,"_28406":128953,"_3086":129612},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3696":75878,"_31230":75615,"_21622":129614,"_5":14887,"_28406":128957,"_3086":129615},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3696":75879,"_31230":75615,"_21622":129617,"_5":14887,"_28406":128961,"_3086":129618},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3696":75880,"_31230":75615,"_21622":129620,"_5":14887,"_28406":128961,"_3086":129621},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3696":75881,"_31230":75615,"_21622":129623,"_5":14887,"_28406":128965,"_3086":129624},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3696":75882,"_31230":75615,"_21622":129626,"_5":14887,"_28406":128969,"_3086":129627},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3696":75883,"_31230":75615,"_21622":129629,"_5":14887,"_28406":128973,"_3086":129630},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3696":75884,"_31230":75615,"_21622":129632,"_5":14887,"_28406":128973,"_3086":129633},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3696":75885,"_31230":75615,"_21622":129635,"_5":14887,"_28406":128973,"_3086":129636},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3696":75886,"_31230":75615,"_21622":129638,"_5":14887,"_28406":128973,"_3086":129639},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3696":75887,"_31230":75615,"_21622":129641,"_5":14887,"_28406":128973,"_3086":129642},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3696":75888,"_31230":75615,"_21622":129644,"_5":14887,"_28406":128973,"_3086":129645},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3696":75889,"_31230":75615,"_21622":129647,"_5":14887,"_28406":128977,"_3086":129648},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3696":75890,"_31230":75615,"_21622":129650,"_5":14887,"_28406":128977,"_3086":129651},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3696":75891,"_31230":75615,"_21622":129653,"_5":14887,"_28406":128977,"_3086":129654},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3696":75892,"_31230":75615,"_21622":129656,"_5":14887,"_28406":128977,"_3086":129657},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3696":75893,"_31230":75615,"_21622":129659,"_5":14887,"_28406":128977,"_3086":129660},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3696":75894,"_31230":75615,"_21622":129662,"_5":14887,"_28406":128981,"_3086":129663},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3696":75895,"_31230":75615,"_21622":129665,"_5":14887,"_28406":128981,"_3086":129666},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3696":75896,"_31230":75615,"_21622":129668,"_5":14887,"_28406":128981,"_3086":129669},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3696":75897,"_31230":75615,"_21622":129671,"_5":14887,"_28406":128981,"_3086":60374},[],{"_3696":75898,"_31230":75615,"_21622":129673,"_5":14887,"_28406":128981,"_3086":129674},[],"Claves de datos obligatorias",{"_3696":75899,"_31230":75615,"_21622":129676,"_5":14887,"_28406":128981,"_3086":129677},[],"Cuándo",{"_3696":75900,"_31230":75615,"_21622":129679,"_5":14887,"_28406":128981,"_3086":129680},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3696":75901,"_31230":75615,"_21622":129682,"_5":14887,"_28406":128981,"_3086":60386},[],{"_3696":75902,"_31230":75615,"_21622":129684,"_5":14887,"_28406":128981,"_3086":129685},[],"Siempre",{"_3696":75903,"_31230":75615,"_21622":129687,"_5":14887,"_28406":128981,"_3086":129688},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3696":75904,"_31230":75615,"_21622":129690,"_5":14887,"_28406":128981,"_3086":60386},[],{"_3696":75905,"_31230":75615,"_21622":129692,"_5":14887,"_28406":128981,"_3086":129685},[],{"_3696":75906,"_31230":75615,"_21622":129694,"_5":14887,"_28406":128981,"_3086":60399},[],{"_3696":75907,"_31230":75615,"_21622":129696,"_5":14887,"_28406":128981,"_3086":60386},[],{"_3696":75908,"_31230":75615,"_21622":129698,"_5":14887,"_28406":128981,"_3086":129699},[],"Solo cuando hay autenticación SMTP",{"_3696":75909,"_31230":75615,"_21622":129701,"_5":14887,"_28406":128981,"_3086":129702},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3696":75910,"_31230":75615,"_21622":129704,"_5":14887,"_28406":128981,"_3086":129705},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3696":75911,"_31230":75615,"_21622":129707,"_5":14887,"_28406":128981,"_3086":129708},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3696":75912,"_31230":75615,"_21622":129710,"_5":14887,"_28406":128981,"_3086":129711},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3696":75913,"_31230":75615,"_21622":129713,"_5":14887,"_28406":128981,"_3086":129714},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3696":75914,"_31230":75615,"_21622":129716,"_5":14887,"_28406":128981,"_3086":129717},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3696":75915,"_31230":75615,"_21622":129719,"_5":14887,"_28406":128981,"_3086":129720},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3696":75916,"_31230":75615,"_21622":129722,"_5":14887,"_28406":128981,"_3086":129723},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3696":75917,"_31230":75615,"_21622":129725,"_5":14887,"_28406":128981,"_3086":129726},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3696":75918,"_31230":75615,"_21622":129728,"_5":14887,"_28406":128981,"_3086":129729},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3696":75919,"_31230":75615,"_21622":129731,"_5":14887,"_28406":128981,"_3086":129732},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3696":75920,"_31230":75615,"_21622":129734,"_5":14887,"_28406":128981,"_3086":129735},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3696":75921,"_31230":75615,"_21622":129737,"_5":14887,"_28406":128981,"_3086":129738},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3696":75922,"_31230":75615,"_21622":129740,"_5":14887,"_28406":128981,"_3086":129741},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3696":75923,"_31230":75615,"_21622":129743,"_5":14887,"_28406":128981,"_3086":129744},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3696":75924,"_31230":75615,"_21622":129746,"_5":14887,"_28406":128985,"_3086":129747},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3696":75925,"_31230":75615,"_21622":129749,"_5":14887,"_28406":128985,"_3086":129750},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3696":75926,"_31230":75615,"_21622":129752,"_5":14887,"_28406":128989,"_3086":129753},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3696":75927,"_31230":75615,"_21622":129755,"_5":14887,"_28406":128989,"_3086":129756},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3696":75928,"_31230":75615,"_21622":129758,"_5":14887,"_28406":128989,"_3086":129759},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3696":75929,"_31230":75615,"_21622":129761,"_5":14887,"_28406":128989,"_3086":129762},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3696":75930,"_31230":75615,"_21622":129764,"_5":14887,"_28406":128989,"_3086":129765},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3696":75931,"_31230":75615,"_21622":129767,"_5":14887,"_28406":128989,"_3086":129768},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3696":75932,"_31230":75615,"_21622":129770,"_5":14887,"_28406":128989,"_3086":129771},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3696":75933,"_31230":75615,"_21622":129773,"_5":14887,"_28406":128989,"_3086":129774},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3696":75934,"_31230":75615,"_21622":129776,"_5":14887,"_28406":128989,"_3086":129777},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3696":75935,"_31230":75615,"_21622":129779,"_5":14887,"_28406":128989,"_3086":129780},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3696":75936,"_31230":75615,"_21622":129782,"_5":14887,"_28406":128989,"_3086":129783},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3696":75937,"_31230":75615,"_21622":129785,"_5":14887,"_28406":128993,"_3086":129786},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3696":75938,"_31230":75615,"_21622":129788,"_5":14887,"_28406":128993,"_3086":129789},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3696":75939,"_31230":75615,"_21622":129791,"_5":14887,"_28406":128997,"_3086":129792},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3696":75940,"_31230":75615,"_21622":129794,"_5":14887,"_28406":128997,"_3086":129795},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3696":75941,"_31230":75615,"_21622":129797,"_5":14887,"_28406":128997,"_3086":129798},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3696":75942,"_31230":75615,"_21622":129800,"_5":14887,"_28406":128997,"_3086":129801},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3696":75943,"_31230":75615,"_21622":129803,"_5":14887,"_28406":128997,"_3086":129804},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3696":75944,"_31230":75615,"_21622":129806,"_5":14887,"_28406":128997,"_3086":129807},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3696":75945,"_31230":75615,"_21622":129809,"_5":14887,"_28406":128997,"_3086":129810},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3696":75946,"_31230":75615,"_21622":129812,"_5":14887,"_28406":128997,"_3086":129813},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3696":75947,"_31230":75615,"_21622":129815,"_5":14887,"_28406":129001,"_3086":129816},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3696":75948,"_31230":75615,"_21622":129818,"_5":14887,"_28406":129001,"_3086":129819},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3696":75949,"_31230":75615,"_21622":129821,"_5":14887,"_28406":129001,"_3086":129822},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3696":75950,"_31230":75615,"_21622":129824,"_5":14887,"_28406":129001,"_3086":129825},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3696":75951,"_31230":75615,"_21622":129827,"_5":14887,"_28406":129001,"_3086":129828},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3696":75952,"_31230":75615,"_21622":129830,"_5":14887,"_28406":129001,"_3086":129831},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3696":75953,"_31230":75615,"_21622":129833,"_5":14887,"_28406":129001,"_3086":129834},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3696":75954,"_31230":75615,"_21622":129836,"_5":14887,"_28406":129001,"_3086":129837},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3696":75955,"_31230":75615,"_21622":129839,"_5":14887,"_28406":129001,"_3086":129840},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3696":75956,"_31230":75615,"_21622":129842,"_5":14887,"_28406":129001,"_3086":129843},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3696":75957,"_31230":75615,"_21622":129845,"_5":14887,"_28406":129001,"_3086":129846},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3696":75958,"_31230":75615,"_21622":129848,"_5":14887,"_28406":129004,"_3086":129849},[],"Tras la actualización, comprueba en este orden:",{"_3696":75959,"_31230":75615,"_21622":129851,"_5":14887,"_28406":129004,"_3086":129852},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3696":75960,"_31230":75615,"_21622":129854,"_5":14887,"_28406":129004,"_3086":129855},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3696":75961,"_31230":75615,"_21622":129857,"_5":14887,"_28406":129004,"_3086":129858},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3696":75962,"_31230":75615,"_21622":129860,"_5":14887,"_28406":129004,"_3086":129861},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3696":75963,"_31230":75615,"_21622":129863,"_5":14887,"_28406":129004,"_3086":129864},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3696":75964,"_31230":75615,"_21622":129866,"_5":14887,"_28406":129004,"_3086":129867},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3696":75965,"_31230":75615,"_21622":129869,"_5":14887,"_28406":129004,"_3086":129870},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3696":75966,"_31230":75615,"_21622":129872,"_5":14887,"_28406":129004,"_3086":129873},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3696":75967,"_31230":75615,"_21622":129875,"_5":14887,"_28406":129004,"_3086":129876},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3696":75968,"_31230":75615,"_21622":129878,"_5":14887,"_28406":129004,"_3086":129879},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3696":75969,"_31230":75615,"_21622":129881,"_5":14887,"_28406":129004,"_3086":129882},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3696":75970,"_31230":75615,"_21622":129884,"_5":14887,"_28406":129004,"_3086":129885},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3696":75971,"_31230":75615,"_21622":129887,"_5":14887,"_28406":129004,"_3086":129888},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3696":75972,"_31230":75615,"_21622":129890,"_5":14887,"_28406":129004,"_3086":129891},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3696":75973,"_31230":75615,"_21622":129893,"_5":14887,"_28406":129004,"_3086":129894},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3696":75974,"_31230":75615,"_21622":129896,"_5":14887,"_28406":129008,"_3086":129897},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3696":75975,"_31230":75615,"_21622":129899,"_5":14887,"_28406":129008,"_3086":129900},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3696":75976,"_31230":75615,"_21622":129902,"_5":14887,"_28406":129008,"_3086":129903},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3696":75977,"_31230":75615,"_21622":129905,"_5":14887,"_28406":129008,"_3086":129906},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3696":75978,"_31230":75615,"_21622":129908,"_5":14887,"_28406":129008,"_3086":129909},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60617":129911,"_60619":129912,"_60621":129913,"_60623":129914,"_18757":3121,"_72906":3121},"spanish",[3086,31230,5,28406],{"_3086":25829,"_31230":25829,"_5":25829,"_28406":25829},{"_3086":129915,"_31230":132984,"_5":136053,"_28406":139122},{"_4853":129916,"_60627":129917,"_5":25829},{"_14968":3572,"_15347":4819,"_15366":5303,"_30219":6095,"_15353":4378,"_20531":4346,"_14989":3507,"_14996":20836,"_30161":17404,"_30569":13871,"_30596":7306,"_30195":4596,"_35654":5182,"_30298":19707,"_30651":10239,"_35661":5609,"_35664":4801,"_35667":3538,"_35670":3381,"_31053":3161,"_35675":5982,"_35677":12787,"_31088":5370,"_15362":3574,"_35681":7837,"_35684":4814,"_35686":6093,"_30635":11725,"_31073":4861,"_31101":18389,"_35691":15405,"_35693":10813,"_35695":6776,"_30309":5180,"_35698":23522,"_35700":3561,"_35702":4056,"_35704":8012,"_35706":13915,"_30232":3175,"_35709":3576,"_35711":5278,"_30226":10326,"_30672":6485,"_35715":23836,"_35717":13375,"_35720":4598,"_30272":6073,"_35724":8520,"_30152":4508,"_35727":6438,"_30200":5817,"_35730":5489,"_35732":17965,"_35735":6908,"_15356":4932,"_35738":7233,"_35740":8008,"_35743":7979,"_35745":5872,"_35747":6580,"_35749":4594,"_35751":5176,"_20534":12016,"_35754":6924,"_35756":7231,"_30173":3842,"_30629":3487,"_35760":7002,"_35762":5160,"_35764":4823,"_31117":22845,"_35767":13840,"_35769":7679,"_35771":12902,"_31210":14930,"_30688":5794,"_35775":7880,"_35777":7910,"_30210":4095,"_35780":4921,"_35782":14511,"_35784":3667,"_31133":4488,"_30292":3258,"_29672":3306,"_35789":6071,"_35791":5351,"_35793":5210,"_30335":5762,"_35797":7302,"_30623":12926,"_35801":4657,"_3580