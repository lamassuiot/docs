5,"_5":31687,"_21707":51157,"_28497":51158,"_3084":51159},[],"/docs/pr-preview/pr-81/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3634":19,"_31331":15,"_5":31687,"_21707":51161,"_28497":51162,"_3084":51163},[],"/docs/pr-preview/pr-81/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3634":20,"_31331":15,"_5":31687,"_21707":51165,"_28497":51166,"_3084":51167},[],"/docs/pr-preview/pr-81/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3634":21,"_31331":15,"_5":31687,"_21707":51169,"_28497":51170,"_3084":51171},[],"/docs/pr-preview/pr-81/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3634":22,"_31331":15,"_5":31687,"_21707":51173,"_28497":51174,"_3084":51175},[],"/docs/pr-preview/pr-81/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3634":23,"_31331":15,"_5":31687,"_21707":51177,"_28497":51178,"_3084":51179},[],"/docs/pr-preview/pr-81/deployment/aws-marketplace#next-step","Next step",{"_3634":24,"_31331":15,"_21707":51181,"_5":14945,"_28497":15,"_3084":51182},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3634":25,"_31331":15,"_21707":51184,"_5":14945,"_28497":51154,"_3084":51185},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3634":26,"_31331":15,"_21707":51187,"_5":14945,"_28497":51154,"_3084":51188},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3634":27,"_31331":15,"_21707":51190,"_5":14945,"_28497":51154,"_3084":51191},[],"A security group allowing the necessary endpoints.",{"_3634":28,"_31331":15,"_21707":51193,"_5":14945,"_28497":51158,"_3084":51194},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3634":29,"_31331":15,"_21707":51196,"_5":14945,"_28497":51158,"_3084":51197},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3634":30,"_31331":15,"_21707":51199,"_5":14945,"_28497":51158,"_3084":51200},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3634":31,"_31331":15,"_21707":51202,"_5":14945,"_28497":51162,"_3084":51203},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3634":32,"_31331":15,"_21707":51205,"_5":14945,"_28497":51166,"_3084":51206},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3634":33,"_31331":15,"_21707":51208,"_5":14945,"_28497":51170,"_3084":51209},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3634":34,"_31331":15,"_21707":51211,"_5":14945,"_28497":51174,"_3084":51212},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3634":35,"_31331":15,"_21707":51214,"_5":14945,"_28497":51178,"_3084":51215},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3634":36,"_31331":36,"_5":15305,"_3084":51217,"_31690":51218,"_21707":51219,"_28497":36},"Deploy Lamassu",[51145,51146],[],{"_3634":37,"_31331":36,"_21707":51221,"_5":14945,"_28497":36,"_3084":51222},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3634":38,"_31331":36,"_5":31687,"_21707":51224,"_28497":51225,"_3084":51226},[],"/docs/pr-preview/pr-81/deployment/overview#choose-a-model","Choose a model",{"_3634":39,"_31331":36,"_5":31687,"_21707":51228,"_28497":51229,"_3084":51230},[],"/docs/pr-preview/pr-81/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3634":40,"_31331":36,"_5":31687,"_21707":51232,"_28497":51233,"_3084":51234},[],"/docs/pr-preview/pr-81/deployment/overview#after-deployment","After deployment",{"_3634":41,"_31331":36,"_21707":51236,"_5":14945,"_28497":36,"_3084":51237},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3634":42,"_31331":36,"_21707":51239,"_5":14945,"_28497":51225,"_3084":51240},[],"Model",{"_3634":43,"_31331":36,"_21707":51242,"_5":14945,"_28497":51225,"_3084":51243},[],"Recommended for",{"_3634":44,"_31331":36,"_21707":51245,"_5":14945,"_28497":51225,"_3084":51246},[],"Who operates the infrastructure",{"_3634":45,"_31331":36,"_21707":51248,"_5":14945,"_28497":51225,"_3084":51249},[],"Starting point",{"_3634":46,"_31331":36,"_21707":51251,"_5":14945,"_28497":51225,"_3084":51252},[],"Kubernetes self-managed",{"_3634":47,"_31331":36,"_21707":51254,"_5":14945,"_28497":51225,"_3084":51255},[],"Production, regulated environments and custom deployments",{"_3634":48,"_31331":36,"_21707":51257,"_5":14945,"_28497":51225,"_3084":51258},[],"Your team",{"_3634":49,"_31331":36,"_21707":51260,"_5":14945,"_28497":51225,"_3084":51261},[],"Helm or Fastlane",{"_3634":50,"_31331":36,"_21707":51263,"_5":14945,"_28497":51225,"_3084":51264},[],"AWS Marketplace",{"_3634":51,"_31331":36,"_21707":51266,"_5":14945,"_28497":51225,"_3084":51267},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3634":52,"_31331":36,"_21707":51269,"_5":14945,"_28497":51225,"_3084":51258},[],{"_3634":53,"_31331":36,"_21707":51271,"_5":14945,"_28497":51225,"_3084":51272},[],"Preconfigured image on EC2",{"_3634":54,"_31331":36,"_21707":51274,"_5":14945,"_28497":51225,"_3084":51275},[],"SaaS",{"_3634":55,"_31331":36,"_21707":51277,"_5":14945,"_28497":51225,"_3084":51278},[],"Teams that want to use the platform without operating it",{"_3634":56,"_31331":36,"_21707":51280,"_5":14945,"_28497":51225,"_3084":51281},[],"Lamassu",{"_3634":57,"_31331":36,"_21707":51283,"_5":14945,"_28497":51225,"_3084":51284},[],"Managed subscription",{"_3634":58,"_31331":36,"_21707":51286,"_5":14945,"_28497":51225,"_3084":51287},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3634":59,"_31331":36,"_21707":51289,"_5":14945,"_28497":51225,"_3084":51290},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3634":60,"_31331":36,"_21707":51292,"_5":14945,"_28497":51225,"_3084":51293},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3634":61,"_31331":36,"_21707":51295,"_5":14945,"_28497":51229,"_3084":51296},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3634":62,"_31331":36,"_21707":51298,"_5":14945,"_28497":51233,"_3084":51299},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3634":63,"_31331":63,"_5":15305,"_3084":51301,"_31690":51302,"_21707":51303,"_28497":63},"Use Lamassu as SaaS",[51145,51146,51147],[],{"_3634":64,"_31331":63,"_21707":51305,"_5":14945,"_28497":63,"_3084":51306},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3634":65,"_31331":63,"_5":31687,"_21707":51308,"_28497":51309,"_3084":51310},[],"/docs/pr-preview/pr-81/deployment/saas#what-the-service-manages","What the service manages",{"_3634":66,"_31331":63,"_5":31687,"_21707":51312,"_28497":51313,"_3084":51314},[],"/docs/pr-preview/pr-81/deployment/saas#plans","Plans",{"_3634":67,"_31331":63,"_5":31687,"_21707":51316,"_28497":51317,"_3084":51318},[],"/docs/pr-preview/pr-81/deployment/saas#request-access","Request access",{"_3634":68,"_31331":63,"_21707":51320,"_5":14945,"_28497":63,"_3084":51321},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3634":69,"_31331":63,"_21707":51323,"_5":14945,"_28497":51309,"_3084":51324},[],"Platform availability and maintenance.",{"_3634":70,"_31331":63,"_21707":51326,"_5":14945,"_28497":51309,"_3084":51327},[],"Automatic backups.",{"_3634":71,"_31331":63,"_21707":51329,"_5":14945,"_28497":51309,"_3084":51330},[],"Version upgrades.",{"_3634":72,"_31331":63,"_21707":51332,"_5":14945,"_28497":51309,"_3084":51333},[],"Technical support and SLA according to your plan.",{"_3634":73,"_31331":63,"_21707":51335,"_5":14945,"_28497":51313,"_3084":51336},[],"Plan",{"_3634":74,"_31331":63,"_21707":51338,"_5":14945,"_28497":51313,"_3084":51339},[],"Devices",{"_3634":75,"_31331":63,"_21707":51341,"_5":14945,"_28497":51313,"_3084":51342},[],"Support",{"_3634":76,"_31331":63,"_21707":51344,"_5":14945,"_28497":51313,"_3084":51345},[],"SLA",{"_3634":77,"_31331":63,"_21707":51347,"_5":14945,"_28497":51313,"_3084":51348},[],"Starter",{"_3634":78,"_31331":63,"_21707":51350,"_5":14945,"_28497":51313,"_3084":51351},[],"Up to 1,000",{"_3634":79,"_31331":63,"_21707":51353,"_5":14945,"_28497":51313,"_3084":51354},[],"Email",{"_3634":80,"_31331":63,"_21707":51356,"_5":14945,"_28497":51313,"_3084":51357},[],"99.5 %",{"_3634":81,"_31331":63,"_21707":51359,"_5":14945,"_28497":51313,"_3084":51360},[],"Professional",{"_3634":82,"_31331":63,"_21707":51362,"_5":14945,"_28497":51313,"_3084":51363},[],"Up to 10,000",{"_3634":83,"_31331":63,"_21707":51365,"_5":14945,"_28497":51313,"_3084":51366},[],"Email and chat",{"_3634":84,"_31331":63,"_21707":51368,"_5":14945,"_28497":51313,"_3084":51369},[],"99.9 %",{"_3634":85,"_31331":63,"_21707":51371,"_5":14945,"_28497":51313,"_3084":51372},[],"Enterprise",{"_3634":86,"_31331":63,"_21707":51374,"_5":14945,"_28497":51313,"_3084":51375},[],"Unlimited",{"_3634":87,"_31331":63,"_21707":51377,"_5":14945,"_28497":51313,"_3084":51378},[],"Dedicated",{"_3634":88,"_31331":63,"_21707":51380,"_5":14945,"_28497":51313,"_3084":51381},[],"99.99 %",{"_3634":89,"_31331":63,"_21707":51383,"_5":14945,"_28497":51317,"_3084":51384},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3634":90,"_31331":63,"_21707":51386,"_5":14945,"_28497":51317,"_3084":51387},[],"When you receive your instance's credentials, continue with Get started.",{"_3634":91,"_31331":91,"_5":15305,"_3084":51389,"_31690":51390,"_21707":51391,"_28497":91},"Fastlane",[51145,51146,51252],[],{"_3634":92,"_31331":91,"_21707":51393,"_5":14945,"_28497":91,"_3084":51394},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3634":93,"_31331":91,"_5":31687,"_21707":51396,"_28497":51397,"_3084":51398},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3634":94,"_31331":91,"_5":31687,"_21707":51400,"_28497":51401,"_3084":51402},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3634":95,"_31331":91,"_5":31687,"_21707":51404,"_28497":51405,"_3084":51155},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#before-you-begin",{"_3634":96,"_31331":91,"_5":31687,"_21707":51407,"_28497":51408,"_3084":51409},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3634":97,"_31331":91,"_5":31687,"_21707":51411,"_28497":51412,"_3084":51413},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3634":98,"_31331":91,"_5":31687,"_21707":51415,"_28497":51416,"_3084":51417},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3634":99,"_31331":91,"_5":31687,"_21707":51419,"_28497":51420,"_3084":51421},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3634":100,"_31331":91,"_5":31687,"_21707":51423,"_28497":51424,"_3084":51425},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3634":101,"_31331":91,"_5":31687,"_21707":51427,"_28497":51428,"_3084":51429},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3634":102,"_31331":91,"_5":31687,"_21707":51431,"_28497":51432,"_3084":51433},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3634":103,"_31331":91,"_5":31687,"_21707":51435,"_28497":51436,"_3084":51437},[],"/docs/pr-preview/pr-81/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3634":104,"_31331":91,"_21707":51439,"_5":14945,"_28497":51397,"_3084":51440},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3634":105,"_31331":91,"_21707":51442,"_5":14945,"_28497":51397,"_3084":51443},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3634":106,"_31331":91,"_21707":51445,"_5":14945,"_28497":51401,"_3084":51446},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3634":107,"_31331":91,"_21707":51448,"_5":14945,"_28497":51401,"_3084":51449},[],"Fastlane installs or configures",{"_3634":108,"_31331":91,"_21707":51451,"_5":14945,"_28497":51401,"_3084":51452},[],"You still provide",{"_3634":109,"_31331":91,"_21707":51454,"_5":14945,"_28497":51401,"_3084":51455},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3634":110,"_31331":91,"_21707":51457,"_5":14945,"_28497":51401,"_3084":51458},[],"The Kubernetes cluster, nodes and persistent storage",{"_3634":111,"_31331":91,"_21707":51460,"_5":14945,"_28497":51401,"_3084":51461},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3634":112,"_31331":91,"_21707":51463,"_5":14945,"_28497":51401,"_3084":51464},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3634":113,"_31331":91,"_21707":51466,"_5":14945,"_28497":51401,"_3084":51467},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3634":114,"_31331":91,"_21707":51469,"_5":14945,"_28497":51401,"_3084":51470},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3634":115,"_31331":91,"_21707":51472,"_5":14945,"_28497":51401,"_3084":51473},[],"Optional observability and lab HSM components",{"_3634":116,"_31331":91,"_21707":51475,"_5":14945,"_28497":51401,"_3084":51476},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3634":117,"_31331":91,"_21707":51478,"_5":14945,"_28497":51401,"_3084":51479},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3634":118,"_31331":91,"_21707":51481,"_5":14945,"_28497":51405,"_3084":51482},[],"You need:",{"_3634":119,"_31331":91,"_21707":51484,"_5":14945,"_28497":51405,"_3084":51485},[],"an existing Kubernetes cluster",{"_3634":120,"_31331":91,"_21707":51487,"_5":14945,"_28497":51405,"_3084":51488},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3634":121,"_31331":91,"_21707":51490,"_5":14945,"_28497":51405,"_3084":51491},[],"`yq`",{"_3634":122,"_31331":91,"_21707":51493,"_5":14945,"_28497":51405,"_3084":24514},[],{"_3634":123,"_31331":91,"_21707":51495,"_5":14945,"_28497":51405,"_3084":51496},[],"`jq` only when using `--sample-data` or `--development`",{"_3634":124,"_31331":91,"_21707":51498,"_5":14945,"_28497":51405,"_3084":51499},[],"`ssh-keygen` only when using `--with-hsm`",{"_3634":125,"_31331":91,"_21707":51501,"_5":14945,"_28497":51405,"_3084":51502},[],"free external ports 80 and 443 on a single-node K3s host",{"_3634":126,"_31331":91,"_21707":51504,"_5":14945,"_28497":51405,"_3084":51505},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3634":127,"_31331":91,"_21707":51507,"_5":14945,"_28497":51405,"_3084":51508},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3634":128,"_31331":91,"_21707":51510,"_5":14945,"_28497":51408,"_3084":51511},[],"Run the script from a clone of the Helm repository:",{"_3634":129,"_31331":91,"_21707":51513,"_5":14945,"_28497":51408,"_3084":51514},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3634":130,"_31331":91,"_21707":51516,"_5":14945,"_28497":51412,"_3084":51517},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3634":131,"_31331":91,"_21707":51519,"_5":14945,"_28497":51412,"_3084":51520},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3634":132,"_31331":91,"_21707":51522,"_5":14945,"_28497":51412,"_3084":51523},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3634":133,"_31331":91,"_21707":51525,"_5":14945,"_28497":51412,"_3084":51526},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3634":134,"_31331":91,"_21707":51528,"_5":14945,"_28497":51416,"_3084":51529},[],"Option",{"_3634":135,"_31331":91,"_21707":51531,"_5":14945,"_28497":51416,"_3084":51532},[],"Default",{"_3634":136,"_31331":91,"_21707":51534,"_5":14945,"_28497":51416,"_3084":51535},[],"Purpose",{"_3634":137,"_31331":91,"_21707":51537,"_5":14945,"_28497":51416,"_3084":51538},[],"`-h`, `--help`",{"_3634":138,"_31331":91,"_21707":51540,"_5":14945,"_28497":51416,"_3084":51541},[],"—",{"_3634":139,"_31331":91,"_21707":51543,"_5":14945,"_28497":51416,"_3084":51544},[],"Show help",{"_3634":140,"_31331":91,"_21707":51546,"_5":14945,"_28497":51416,"_3084":51547},[],"`-c`, `--context`",{"_3634":141,"_31331":91,"_21707":51549,"_5":14945,"_28497":51416,"_3084":51550},[],"current context",{"_3634":142,"_31331":91,"_21707":51552,"_5":14945,"_28497":51416,"_3084":51553},[],"Select the kubeconfig context for kubectl and Helm",{"_3634":143,"_31331":91,"_21707":51555,"_5":14945,"_28497":51416,"_3084":51556},[],"`-n`, `--non-interactive`",{"_3634":144,"_31331":91,"_21707":51558,"_5":14945,"_28497":51416,"_3084":6814},[],{"_3634":145,"_31331":91,"_21707":51560,"_5":14945,"_28497":51416,"_3084":51561},[],"Skip prompts and generate dependency credentials",{"_3634":146,"_31331":91,"_21707":51563,"_5":14945,"_28497":51416,"_3084":51564},[],"`-ns`, `--namespace`",{"_3634":147,"_31331":91,"_21707":51566,"_5":14945,"_28497":51416,"_3084":51567},[],"`lamassu-dev`",{"_3634":148,"_31331":91,"_21707":51569,"_5":14945,"_28497":51416,"_3084":51570},[],"Namespace for the installation",{"_3634":149,"_31331":91,"_21707":51572,"_5":14945,"_28497":51416,"_3084":51573},[],"`-d`, `--domain`",{"_3634":150,"_31331":91,"_21707":51575,"_5":14945,"_28497":51416,"_3084":51576},[],"`dev.lamassu.io`",{"_3634":151,"_31331":91,"_21707":51578,"_5":14945,"_28497":51416,"_3084":51579},[],"Domain used by the UI, OIDC and certificate",{"_3634":152,"_31331":91,"_21707":51581,"_5":14945,"_28497":51416,"_3084":51582},[],"`-v`, `--version`",{"_3634":153,"_31331":91,"_21707":51584,"_5":14945,"_28497":51416,"_3084":15657},[],{"_3634":154,"_31331":91,"_21707":51586,"_5":14945,"_28497":51416,"_3084":51587},[],"Lamassu chart version",{"_3634":155,"_31331":91,"_21707":51589,"_5":14945,"_28497":51416,"_3084":51590},[],"`--https-port`",{"_3634":156,"_31331":91,"_21707":51592,"_5":14945,"_28497":51416,"_3084":51593},[],"`443`",{"_3634":157,"_31331":91,"_21707":51595,"_5":14945,"_28497":51416,"_3084":51596},[],"Gateway HTTPS listener port",{"_3634":158,"_31331":91,"_21707":51598,"_5":14945,"_28497":51416,"_3084":51599},[],"`--http-port`",{"_3634":159,"_31331":91,"_21707":51601,"_5":14945,"_28497":51416,"_3084":51602},[],"`80`",{"_3634":160,"_31331":91,"_21707":51604,"_5":14945,"_28497":51416,"_3084":51605},[],"Gateway HTTP listener port",{"_3634":161,"_31331":91,"_21707":51607,"_5":14945,"_28497":51416,"_3084":51608},[],"`--tls-crt`",{"_3634":162,"_31331":91,"_21707":51610,"_5":14945,"_28497":51416,"_3084":51541},[],{"_3634":163,"_31331":91,"_21707":51612,"_5":14945,"_28497":51416,"_3084":51613},[],"PEM certificate for downstream TLS",{"_3634":164,"_31331":91,"_21707":51615,"_5":14945,"_28497":51416,"_3084":51616},[],"`--tls-key`",{"_3634":165,"_31331":91,"_21707":51618,"_5":14945,"_28497":51416,"_3084":51541},[],{"_3634":166,"_31331":91,"_21707":51620,"_5":14945,"_28497":51416,"_3084":51621},[],"PEM private key for downstream TLS",{"_3634":167,"_31331":91,"_21707":51623,"_5":14945,"_28497":51416,"_3084":51624},[],"`-l`, `--local-chart-path`",{"_3634":168,"_31331":91,"_21707":51626,"_5":14945,"_28497":51416,"_3084":51627},[],"repository chart",{"_3634":169,"_31331":91,"_21707":51629,"_5":14945,"_28497":51416,"_3084":51630},[],"Use an unpacked local Lamassu chart",{"_3634":170,"_31331":91,"_21707":51632,"_5":14945,"_28497":51416,"_3084":51633},[],"`-ip`, `--gateway-ip`",{"_3634":171,"_31331":91,"_21707":51635,"_5":14945,"_28497":51416,"_3084":9112},[],{"_3634":172,"_31331":91,"_21707":51637,"_5":14945,"_28497":51416,"_3084":51638},[],"Override the address written to `gateway.addresses`",{"_3634":173,"_31331":91,"_21707":51640,"_5":14945,"_28497":51416,"_3084":51641},[],"`--otel`",{"_3634":174,"_31331":91,"_21707":51643,"_5":14945,"_28497":51416,"_3084":6814},[],{"_3634":175,"_31331":91,"_21707":51645,"_5":14945,"_28497":51416,"_3084":51646},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3634":176,"_31331":91,"_21707":51648,"_5":14945,"_28497":51416,"_3084":51649},[],"`--development`",{"_3634":177,"_31331":91,"_21707":51651,"_5":14945,"_28497":51416,"_3084":6814},[],{"_3634":178,"_31331":91,"_21707":51653,"_5":14945,"_28497":51416,"_3084":51654},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3634":179,"_31331":91,"_21707":51656,"_5":14945,"_28497":51416,"_3084":51657},[],"`--sample-data`",{"_3634":180,"_31331":91,"_21707":51659,"_5":14945,"_28497":51416,"_3084":6814},[],{"_3634":181,"_31331":91,"_21707":51661,"_5":14945,"_28497":51416,"_3084":51662},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3634":182,"_31331":91,"_21707":51664,"_5":14945,"_28497":51416,"_3084":51665},[],"`--with-hsm`",{"_3634":183,"_31331":91,"_21707":51667,"_5":14945,"_28497":51416,"_3084":6814},[],{"_3634":184,"_31331":91,"_21707":51669,"_5":14945,"_28497":51416,"_3084":51670},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3634":185,"_31331":91,"_21707":51672,"_5":14945,"_28497":51416,"_3084":51673},[],"`--softhsm-chart-path`",{"_3634":186,"_31331":91,"_21707":51675,"_5":14945,"_28497":51416,"_3084":51676},[],"`./charts/softhsm`",{"_3634":187,"_31331":91,"_21707":51678,"_5":14945,"_28497":51416,"_3084":51679},[],"Use a different local SoftHSM chart",{"_3634":188,"_31331":91,"_21707":51681,"_5":14945,"_28497":51416,"_3084":51682},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3634":189,"_31331":91,"_21707":51684,"_5":14945,"_28497":51420,"_3084":51685},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3634":190,"_31331":91,"_21707":51687,"_5":14945,"_28497":51420,"_3084":51688},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3634":191,"_31331":91,"_21707":51690,"_5":14945,"_28497":51420,"_3084":51691},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3634":192,"_31331":91,"_21707":51693,"_5":14945,"_28497":51420,"_3084":51694},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3634":193,"_31331":91,"_21707":51696,"_5":14945,"_28497":51420,"_3084":51697},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3634":194,"_31331":91,"_21707":51699,"_5":14945,"_28497":51420,"_3084":51700},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3634":195,"_31331":91,"_21707":51702,"_5":14945,"_28497":51424,"_3084":51703},[],"Fastlane:",{"_3634":196,"_31331":91,"_21707":51705,"_5":14945,"_28497":51424,"_3084":51706},[],"validates local tools and the selected cluster",{"_3634":197,"_31331":91,"_21707":51708,"_5":14945,"_28497":51424,"_3084":51709},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3634":198,"_31331":91,"_21707":51711,"_5":14945,"_28497":51424,"_3084":51712},[],"creates the namespace",{"_3634":199,"_31331":91,"_21707":51714,"_5":14945,"_28497":51424,"_3084":51715},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3634":200,"_31331":91,"_21707":51717,"_5":14945,"_28497":51424,"_3084":51718},[],"installs PostgreSQL and creates the required databases",{"_3634":201,"_31331":91,"_21707":51720,"_5":14945,"_28497":51424,"_3084":51721},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3634":202,"_31331":91,"_21707":51723,"_5":14945,"_28497":51424,"_3084":51724},[],"installs RabbitMQ",{"_3634":203,"_31331":91,"_21707":51726,"_5":14945,"_28497":51424,"_3084":51727},[],"optionally installs observability and lab HSM components",{"_3634":204,"_31331":91,"_21707":51729,"_5":14945,"_28497":51424,"_3084":51730},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3634":205,"_31331":91,"_21707":51732,"_5":14945,"_28497":51424,"_3084":51733},[],"optionally loads sample data",{"_3634":206,"_31331":91,"_21707":51735,"_5":14945,"_28497":51424,"_3084":51736},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3634":207,"_31331":91,"_21707":51738,"_5":14945,"_28497":51428,"_3084":51739},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3634":208,"_31331":91,"_21707":51741,"_5":14945,"_28497":51428,"_3084":51742},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3634":209,"_31331":91,"_21707":51744,"_5":14945,"_28497":51432,"_3084":51745},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3634":210,"_31331":91,"_21707":51747,"_5":14945,"_28497":51432,"_3084":51748},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3634":211,"_31331":91,"_21707":51750,"_5":14945,"_28497":51432,"_3084":51751},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3634":212,"_31331":91,"_21707":51753,"_5":14945,"_28497":51432,"_3084":51754},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3634":213,"_31331":91,"_21707":51756,"_5":14945,"_28497":51436,"_3084":51757},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3634":214,"_31331":214,"_5":15305,"_3084":51759,"_31690":51760,"_21707":51761,"_28497":214},"Install with Helm",[51145,51146,51252],[],{"_3634":215,"_31331":214,"_21707":51763,"_5":14945,"_28497":214,"_3084":51764},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3634":216,"_31331":214,"_5":31687,"_21707":51766,"_28497":51767,"_3084":51768},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3634":217,"_31331":214,"_5":31687,"_21707":51770,"_28497":51771,"_3084":51155},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#before-you-begin",{"_3634":218,"_31331":214,"_5":31687,"_21707":51773,"_28497":51774,"_3084":51775},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3634":219,"_31331":214,"_5":31687,"_21707":51777,"_28497":51778,"_3084":51779},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3634":220,"_31331":214,"_5":31687,"_21707":51781,"_28497":51782,"_3084":51783},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3634":221,"_31331":214,"_5":31687,"_21707":51785,"_28497":51786,"_3084":51787},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3634":222,"_31331":214,"_5":31687,"_21707":51789,"_28497":51790,"_3084":51791},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3634":223,"_31331":214,"_5":31687,"_21707":51793,"_28497":51794,"_3084":51795},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3634":224,"_31331":214,"_5":31687,"_21707":51797,"_28497":51798,"_3084":51799},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3634":225,"_31331":214,"_5":31687,"_21707":51801,"_28497":51802,"_3084":51803},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3634":226,"_31331":214,"_5":31687,"_21707":51805,"_28497":51806,"_3084":51807},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3634":227,"_31331":214,"_5":31687,"_21707":51809,"_28497":51810,"_3084":51811},[],"/docs/pr-preview/pr-81/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3634":228,"_31331":214,"_21707":51813,"_5":14945,"_28497":51767,"_3084":51814},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3634":229,"_31331":214,"_21707":51816,"_5":14945,"_28497":51771,"_3084":51817},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3634":230,"_31331":214,"_21707":51819,"_5":14945,"_28497":51771,"_3084":51820},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3634":231,"_31331":214,"_21707":51822,"_5":14945,"_28497":51771,"_3084":51823},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3634":232,"_31331":214,"_21707":51825,"_5":14945,"_28497":51771,"_3084":51826},[],"a reachable RabbitMQ broker and credentials",{"_3634":233,"_31331":214,"_21707":51828,"_5":14945,"_28497":51771,"_3084":51829},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3634":234,"_31331":214,"_21707":51831,"_5":14945,"_28497":51771,"_3084":51832},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3634":235,"_31331":214,"_21707":51834,"_5":14945,"_28497":51771,"_3084":51835},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3634":236,"_31331":214,"_21707":51837,"_5":14945,"_28497":51771,"_3084":51838},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3634":237,"_31331":214,"_21707":51840,"_5":14945,"_28497":51771,"_3084":51841},[],"a StorageClass and an external traffic design",{"_3634":238,"_31331":214,"_21707":51843,"_5":14945,"_28497":51771,"_3084":51844},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3634":239,"_31331":214,"_21707":51846,"_5":14945,"_28497":51771,"_3084":51847},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3634":240,"_31331":214,"_21707":51849,"_5":14945,"_28497":51771,"_3084":51850},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3634":241,"_31331":214,"_21707":51852,"_5":14945,"_28497":51774,"_3084":51853},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3634":242,"_31331":214,"_21707":51855,"_5":14945,"_28497":51774,"_3084":51856},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3634":243,"_31331":214,"_21707":51858,"_5":14945,"_28497":51774,"_3084":51859},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3634":244,"_31331":214,"_21707":51861,"_5":14945,"_28497":51778,"_3084":51862},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3634":245,"_31331":214,"_21707":51864,"_5":14945,"_28497":51778,"_3084":51865},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3634":246,"_31331":214,"_21707":51867,"_5":14945,"_28497":51778,"_3084":51868},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3634":247,"_31331":214,"_21707":51870,"_5":14945,"_28497":51778,"_3084":51871},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3634":248,"_31331":214,"_21707":51873,"_5":14945,"_28497":51782,"_3084":51874},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3634":249,"_31331":214,"_21707":51876,"_5":14945,"_28497":51782,"_3084":51877},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3634":250,"_31331":214,"_21707":51879,"_5":14945,"_28497":51782,"_3084":51880},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3634":251,"_31331":214,"_21707":51882,"_5":14945,"_28497":51782,"_3084":51883},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3634":252,"_31331":214,"_21707":51885,"_5":14945,"_28497":51782,"_3084":51886},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3634":253,"_31331":214,"_21707":51888,"_5":14945,"_28497":51782,"_3084":51889},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3634":254,"_31331":214,"_21707":51891,"_5":14945,"_28497":51782,"_3084":51892},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3634":255,"_31331":214,"_21707":51894,"_5":14945,"_28497":51782,"_3084":51895},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3634":256,"_31331":214,"_21707":51897,"_5":14945,"_28497":51786,"_3084":51898},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3634":257,"_31331":214,"_21707":51900,"_5":14945,"_28497":51790,"_3084":51901},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3634":258,"_31331":214,"_21707":51903,"_5":14945,"_28497":51790,"_3084":51904},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3634":259,"_31331":214,"_21707":51906,"_5":14945,"_28497":51790,"_3084":51907},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3634":260,"_31331":214,"_21707":51909,"_5":14945,"_28497":51790,"_3084":51910},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3634":261,"_31331":214,"_21707":51912,"_5":14945,"_28497":51790,"_3084":51913},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3634":262,"_31331":214,"_21707":51915,"_5":14945,"_28497":51790,"_3084":51916},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3634":263,"_31331":214,"_21707":51918,"_5":14945,"_28497":51790,"_3084":51919},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3634":264,"_31331":214,"_21707":51921,"_5":14945,"_28497":51794,"_3084":51922},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3634":265,"_31331":214,"_21707":51924,"_5":14945,"_28497":51794,"_3084":51925},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3634":266,"_31331":214,"_21707":51927,"_5":14945,"_28497":51794,"_3084":51928},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3634":267,"_31331":214,"_21707":51930,"_5":14945,"_28497":51794,"_3084":51931},[],"See Access control for the principal and policy model.",{"_3634":268,"_31331":214,"_21707":51933,"_5":14945,"_28497":51798,"_3084":51934},[],"To install a local checkout instead:",{"_3634":269,"_31331":214,"_21707":51936,"_5":14945,"_28497":51802,"_3084":51937},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3634":270,"_31331":214,"_21707":51939,"_5":14945,"_28497":51802,"_3084":51940},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3634":271,"_31331":214,"_21707":51942,"_5":14945,"_28497":51806,"_3084":51943},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3634":272,"_31331":214,"_21707":51945,"_5":14945,"_28497":51806,"_3084":51946},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3634":273,"_31331":214,"_21707":51948,"_5":14945,"_28497":51806,"_3084":51949},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3634":274,"_31331":214,"_21707":51951,"_5":14945,"_28497":51806,"_3084":51952},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3634":275,"_31331":214,"_21707":51954,"_5":14945,"_28497":51806,"_3084":51955},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3634":276,"_31331":214,"_21707":51957,"_5":14945,"_28497":51810,"_3084":51958},[],"Before going live, review:",{"_3634":277,"_31331":214,"_21707":51960,"_5":14945,"_28497":51810,"_3084":51961},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3634":278,"_31331":214,"_21707":51963,"_5":14945,"_28497":51810,"_3084":51964},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3634":279,"_31331":214,"_21707":51966,"_5":14945,"_28497":51810,"_3084":51967},[],"shared VA storage before increasing VA replicas",{"_3634":280,"_31331":214,"_21707":51969,"_5":14945,"_28497":51810,"_3084":51970},[],"managed OIDC roles and removal of evaluation credentials",{"_3634":281,"_31331":214,"_21707":51972,"_5":14945,"_28497":51810,"_3084":51973},[],"a trusted TLS issuer or externally managed certificate",{"_3634":282,"_31331":214,"_21707":51975,"_5":14945,"_28497":51810,"_3084":51976},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3634":283,"_31331":214,"_21707":51978,"_5":14945,"_28497":51810,"_3084":51979},[],"SMTP, observability and alert delivery",{"_3634":284,"_31331":214,"_21707":51981,"_5":14945,"_28497":51810,"_3084":51982},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3634":285,"_31331":214,"_21707":51984,"_5":14945,"_28497":51810,"_3084":51985},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3634":286,"_31331":286,"_5":15305,"_3084":51987,"_31690":51988,"_21707":51989,"_28497":286},"Expose the Gateway",[51145,51146,51252],[],{"_3634":287,"_31331":286,"_21707":51991,"_5":14945,"_28497":286,"_3084":51992},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3634":288,"_31331":286,"_5":31687,"_21707":51994,"_28497":51995,"_3084":51996},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3634":289,"_31331":286,"_5":31687,"_21707":51998,"_28497":51999,"_3084":52000},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3634":290,"_31331":286,"_5":31687,"_21707":52002,"_28497":52003,"_3084":52004},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3634":291,"_31331":286,"_5":31687,"_21707":52006,"_28497":52007,"_3084":52008},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#k3s","K3s",{"_3634":292,"_31331":286,"_5":31687,"_21707":52010,"_28497":52011,"_3084":52012},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3634":293,"_31331":286,"_5":31687,"_21707":52014,"_28497":52015,"_3084":52016},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3634":294,"_31331":286,"_5":31687,"_21707":52018,"_28497":52019,"_3084":52020},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3634":295,"_31331":286,"_5":31687,"_21707":52022,"_28497":52023,"_3084":52024},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3634":296,"_31331":286,"_5":31687,"_21707":52026,"_28497":52027,"_3084":52028},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3634":297,"_31331":286,"_5":31687,"_21707":52030,"_28497":52031,"_3084":52032},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3634":298,"_31331":286,"_5":31687,"_21707":52034,"_28497":52035,"_3084":52036},[],"/docs/pr-preview/pr-81/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3634":299,"_31331":286,"_21707":52038,"_5":14945,"_28497":51995,"_3084":52039},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3634":300,"_31331":286,"_21707":52041,"_5":14945,"_28497":51995,"_3084":52042},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3634":301,"_31331":286,"_21707":52044,"_5":14945,"_28497":51999,"_3084":52045},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3634":302,"_31331":286,"_21707":52047,"_5":14945,"_28497":51999,"_3084":52048},[],"Set it only when:",{"_3634":303,"_31331":286,"_21707":52050,"_5":14945,"_28497":51999,"_3084":52051},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3634":304,"_31331":286,"_21707":52053,"_5":14945,"_28497":51999,"_3084":52054},[],"that address is allocated to this Gateway",{"_3634":305,"_31331":286,"_21707":52056,"_5":14945,"_28497":51999,"_3084":52057},[],"the surrounding network already routes traffic for it to the cluster",{"_3634":306,"_31331":286,"_21707":52059,"_5":14945,"_28497":51999,"_3084":52060},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3634":307,"_31331":286,"_21707":52062,"_5":14945,"_28497":51999,"_3084":52063},[],"Keep these two settings separate:",{"_3634":308,"_31331":286,"_21707":52065,"_5":14945,"_28497":51999,"_3084":52066},[],"`gateway.addresses` requests an address for the Gateway.",{"_3634":309,"_31331":286,"_21707":52068,"_5":14945,"_28497":51999,"_3084":52069},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3634":310,"_31331":286,"_21707":52071,"_5":14945,"_28497":51999,"_3084":52072},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3634":311,"_31331":286,"_21707":52074,"_5":14945,"_28497":52003,"_3084":52075},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3634":312,"_31331":286,"_21707":52077,"_5":14945,"_28497":52003,"_3084":52078},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3634":313,"_31331":286,"_21707":52080,"_5":14945,"_28497":52007,"_3084":52081},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3634":314,"_31331":286,"_21707":52083,"_5":14945,"_28497":52007,"_3084":52084},[],"For the recommended design:",{"_3634":315,"_31331":286,"_21707":52086,"_5":14945,"_28497":52007,"_3084":52087},[],"Use only one externally exposed Lamassu Gateway.",{"_3634":316,"_31331":286,"_21707":52089,"_5":14945,"_28497":52007,"_3084":52090},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3634":317,"_31331":286,"_21707":52092,"_5":14945,"_28497":52007,"_3084":52093},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3634":318,"_31331":286,"_21707":52095,"_5":14945,"_28497":52007,"_3084":52096},[],"Point DNS at the VM's reachable address.",{"_3634":319,"_31331":286,"_21707":52098,"_5":14945,"_28497":52007,"_3084":52099},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3634":320,"_31331":286,"_21707":52101,"_5":14945,"_28497":52011,"_3084":52102},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3634":321,"_31331":286,"_21707":52104,"_5":14945,"_28497":52015,"_3084":52105},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3634":322,"_31331":286,"_21707":52107,"_5":14945,"_28497":52015,"_3084":52108},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3634":323,"_31331":286,"_21707":52110,"_5":14945,"_28497":52019,"_3084":52111},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3634":324,"_31331":286,"_21707":52113,"_5":14945,"_28497":52019,"_3084":52114},[],"Requirement",{"_3634":325,"_31331":286,"_21707":52116,"_5":14945,"_28497":52019,"_3084":52117},[],"Recommended design",{"_3634":326,"_31331":286,"_21707":52119,"_5":14945,"_28497":52019,"_3084":52120},[],"Consequence",{"_3634":327,"_31331":286,"_21707":52122,"_5":14945,"_28497":52019,"_3084":52123},[],"Several Lamassu URLs or services",{"_3634":328,"_31331":286,"_21707":52125,"_5":14945,"_28497":52019,"_3084":52126},[],"One Gateway with multiple routes",{"_3634":329,"_31331":286,"_21707":52128,"_5":14945,"_28497":52019,"_3084":52129},[],"One IP and one proxy fleet; this is the chart default",{"_3634":330,"_31331":286,"_21707":52131,"_5":14945,"_28497":52019,"_3084":52132},[],"Independent Gateways and separate external IPs",{"_3634":331,"_31331":286,"_21707":52134,"_5":14945,"_28497":52019,"_3084":52135},[],"One VIP per Gateway",{"_3634":332,"_31331":286,"_21707":52137,"_5":14945,"_28497":52019,"_3084":52138},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3634":333,"_31331":286,"_21707":52140,"_5":14945,"_28497":52019,"_3084":52141},[],"Independent Gateways on one node and one IP",{"_3634":334,"_31331":286,"_21707":52143,"_5":14945,"_28497":52019,"_3084":52144},[],"Use different external ports",{"_3634":335,"_31331":286,"_21707":52146,"_5":14945,"_28497":52019,"_3084":52147},[],"Clients must include non-standard ports",{"_3634":336,"_31331":286,"_21707":52149,"_5":14945,"_28497":52019,"_3084":52150},[],"Separate TLS/mTLS termination behind one IP",{"_3634":337,"_31331":286,"_21707":52152,"_5":14945,"_28497":52019,"_3084":52153},[],"Front-door SNI routing to internal Gateways",{"_3634":338,"_31331":286,"_21707":52155,"_5":14945,"_28497":52019,"_3084":52156},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3634":339,"_31331":286,"_21707":52158,"_5":14945,"_28497":52019,"_3084":52159},[],"Separate Gateway resources but shared proxy infrastructure",{"_3634":340,"_31331":286,"_21707":52161,"_5":14945,"_28497":52019,"_3084":52162},[],"Envoy merged-Gateway mode",{"_3634":341,"_31331":286,"_21707":52164,"_5":14945,"_28497":52019,"_3084":52165},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3634":342,"_31331":286,"_21707":52167,"_5":14945,"_28497":52019,"_3084":52168},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3634":343,"_31331":286,"_21707":52170,"_5":14945,"_28497":52019,"_3084":52171},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3634":344,"_31331":286,"_21707":52173,"_5":14945,"_28497":52019,"_3084":52174},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3634":345,"_31331":286,"_21707":52176,"_5":14945,"_28497":52019,"_3084":52177},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3634":346,"_31331":286,"_21707":52179,"_5":14945,"_28497":52023,"_3084":52180},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3634":347,"_31331":286,"_21707":52182,"_5":14945,"_28497":52027,"_3084":52183},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3634":348,"_31331":286,"_21707":52185,"_5":14945,"_28497":52027,"_3084":52186},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3634":349,"_31331":286,"_21707":52188,"_5":14945,"_28497":52027,"_3084":52189},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3634":350,"_31331":286,"_21707":52191,"_5":14945,"_28497":52027,"_3084":52192},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3634":351,"_31331":286,"_21707":52194,"_5":14945,"_28497":52027,"_3084":52195},[],"If none of those are possible, use different external ports or change the external network design.",{"_3634":352,"_31331":286,"_21707":52197,"_5":14945,"_28497":52031,"_3084":52198},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3634":353,"_31331":286,"_21707":52200,"_5":14945,"_28497":52031,"_3084":52201},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3634":354,"_31331":286,"_21707":52203,"_5":14945,"_28497":52035,"_3084":52204},[],"Check, in order:",{"_3634":355,"_31331":286,"_21707":52206,"_5":14945,"_28497":52035,"_3084":52207},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3634":356,"_31331":286,"_21707":52209,"_5":14945,"_28497":52035,"_3084":52210},[],"Its status contains the expected address.",{"_3634":357,"_31331":286,"_21707":52212,"_5":14945,"_28497":52035,"_3084":52213},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3634":358,"_31331":286,"_21707":52215,"_5":14945,"_28497":52035,"_3084":52216},[],"Port 443 reaches that address from the client network.",{"_3634":359,"_31331":286,"_21707":52218,"_5":14945,"_28497":52035,"_3084":52219},[],"DNS resolves to the externally reachable endpoint.",{"_3634":360,"_31331":286,"_21707":52221,"_5":14945,"_28497":52035,"_3084":52222},[],"The certificate contains the DNS name or IP used by the client.",{"_3634":361,"_31331":286,"_21707":52224,"_5":14945,"_28497":52035,"_3084":52225},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3634":362,"_31331":362,"_5":15305,"_3084":51252,"_31690":52227,"_21707":52228,"_28497":362},[51145,51146,51252],[],{"_3634":363,"_31331":362,"_21707":52230,"_5":14945,"_28497":362,"_3084":52231},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3634":364,"_31331":362,"_5":31687,"_21707":52233,"_28497":52234,"_3084":52235},[],"/docs/pr-preview/pr-81/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3634":365,"_31331":362,"_5":31687,"_21707":52237,"_28497":52238,"_3084":52239},[],"/docs/pr-preview/pr-81/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3634":366,"_31331":362,"_5":31687,"_21707":52241,"_28497":52242,"_3084":52243},[],"/docs/pr-preview/pr-81/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3634":367,"_31331":362,"_5":31687,"_21707":52245,"_28497":52246,"_3084":52247},[],"/docs/pr-preview/pr-81/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3634":368,"_31331":362,"_5":31687,"_21707":52249,"_28497":52250,"_3084":52251},[],"/docs/pr-preview/pr-81/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3634":369,"_31331":362,"_5":31687,"_21707":52253,"_28497":52254,"_3084":52255},[],"/docs/pr-preview/pr-81/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3634":370,"_31331":362,"_21707":52257,"_5":14945,"_28497":52234,"_3084":52258},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3634":371,"_31331":362,"_21707":52260,"_5":14945,"_28497":52238,"_3084":52261},[],"Workflow",{"_3634":372,"_31331":362,"_21707":52263,"_5":14945,"_28497":52238,"_3084":52264},[],"Use it for",{"_3634":373,"_31331":362,"_21707":52266,"_5":14945,"_28497":52238,"_3084":52267},[],"What it installs",{"_3634":374,"_31331":362,"_21707":52269,"_5":14945,"_28497":52238,"_3084":52270},[],"Helm",{"_3634":375,"_31331":362,"_21707":52272,"_5":14945,"_28497":52238,"_3084":52273},[],"Production and controlled environments",{"_3634":376,"_31331":362,"_21707":52275,"_5":14945,"_28497":52238,"_3084":52276},[],"Lamassu services and Gateway API resources",{"_3634":377,"_31331":362,"_21707":52278,"_5":14945,"_28497":52238,"_3084":51389},[],{"_3634":378,"_31331":362,"_21707":52280,"_5":14945,"_28497":52238,"_3084":52281},[],"Evaluation, demos, CI and small lab clusters",{"_3634":379,"_31331":362,"_21707":52283,"_5":14945,"_28497":52238,"_3084":52284},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3634":380,"_31331":362,"_21707":52286,"_5":14945,"_28497":52242,"_3084":52287},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3634":381,"_31331":362,"_21707":52289,"_5":14945,"_28497":52242,"_3084":52290},[],"Area",{"_3634":382,"_31331":362,"_21707":52292,"_5":14945,"_28497":52242,"_3084":52293},[],"The Lamassu chart provides",{"_3634":383,"_31331":362,"_21707":52295,"_5":14945,"_28497":52242,"_3084":52296},[],"You provide",{"_3634":384,"_31331":362,"_21707":52298,"_5":14945,"_28497":52242,"_3084":52299},[],"Lamassu applications",{"_3634":385,"_31331":362,"_21707":52301,"_5":14945,"_28497":52242,"_3084":52302},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3634":386,"_31331":362,"_21707":52304,"_5":14945,"_28497":52242,"_3084":52305},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3634":387,"_31331":362,"_21707":52307,"_5":14945,"_28497":52242,"_3084":52308},[],"PostgreSQL data",{"_3634":388,"_31331":362,"_21707":52310,"_5":14945,"_28497":52242,"_3084":52311},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3634":389,"_31331":362,"_21707":52313,"_5":14945,"_28497":52242,"_3084":52314},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3634":390,"_31331":362,"_21707":52316,"_5":14945,"_28497":52242,"_3084":52317},[],"Messaging",{"_3634":391,"_31331":362,"_21707":52319,"_5":14945,"_28497":52242,"_3084":52320},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3634":392,"_31331":362,"_21707":52322,"_5":14945,"_28497":52242,"_3084":52323},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3634":393,"_31331":362,"_21707":52325,"_5":14945,"_28497":52242,"_3084":52326},[],"Identity",{"_3634":394,"_31331":362,"_21707":52328,"_5":14945,"_28497":52242,"_3084":52329},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3634":395,"_31331":362,"_21707":52331,"_5":14945,"_28497":52242,"_3084":52332},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3634":396,"_31331":362,"_21707":52334,"_5":14945,"_28497":52242,"_3084":52335},[],"External routing",{"_3634":397,"_31331":362,"_21707":52337,"_5":14945,"_28497":52242,"_3084":52338},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3634":398,"_31331":362,"_21707":52340,"_5":14945,"_28497":52242,"_3084":52341},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3634":399,"_31331":362,"_21707":52343,"_5":14945,"_28497":52242,"_3084":52344},[],"TLS",{"_3634":400,"_31331":362,"_21707":52346,"_5":14945,"_28497":52242,"_3084":52347},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3634":401,"_31331":362,"_21707":52349,"_5":14945,"_28497":52242,"_3084":52350},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3634":402,"_31331":362,"_21707":52352,"_5":14945,"_28497":52242,"_3084":52353},[],"Persistent application data",{"_3634":403,"_31331":362,"_21707":52355,"_5":14945,"_28497":52242,"_3084":52356},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3634":404,"_31331":362,"_21707":52358,"_5":14945,"_28497":52242,"_3084":52359},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3634":405,"_31331":362,"_21707":52361,"_5":14945,"_28497":52242,"_3084":52362},[],"Optional integrations",{"_3634":406,"_31331":362,"_21707":52364,"_5":14945,"_28497":52242,"_3084":52365},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3634":407,"_31331":362,"_21707":52367,"_5":14945,"_28497":52242,"_3084":52368},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3634":408,"_31331":362,"_21707":52370,"_5":14945,"_28497":52242,"_3084":52371},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3634":409,"_31331":362,"_21707":52373,"_5":14945,"_28497":52242,"_3084":52374},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3634":410,"_31331":362,"_21707":52376,"_5":14945,"_28497":52246,"_3084":52377},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3634":411,"_31331":362,"_21707":52379,"_5":14945,"_28497":52246,"_3084":52380},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3634":412,"_31331":362,"_21707":52382,"_5":14945,"_28497":52250,"_3084":52383},[],"Kubernetes 1.24 or newer",{"_3634":413,"_31331":362,"_21707":52385,"_5":14945,"_28497":52250,"_3084":52386},[],"Helm 3.2 or newer",{"_3634":414,"_31331":362,"_21707":52388,"_5":14945,"_28497":52250,"_3084":52389},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3634":415,"_31331":362,"_21707":52391,"_5":14945,"_28497":52250,"_3084":52392},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3634":416,"_31331":362,"_21707":52394,"_5":14945,"_28497":52250,"_3084":52395},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3634":417,"_31331":362,"_21707":52397,"_5":14945,"_28497":52250,"_3084":52398},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3634":418,"_31331":362,"_21707":52400,"_5":14945,"_28497":52250,"_3084":52401},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3634":419,"_31331":362,"_21707":52403,"_5":14945,"_28497":52254,"_3084":52404},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":420,"_31331":362,"_21707":52406,"_5":14945,"_28497":52254,"_3084":52407},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3634":421,"_31331":362,"_21707":52409,"_5":14945,"_28497":52254,"_3084":52410},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3634":422,"_31331":362,"_21707":52412,"_5":14945,"_28497":52254,"_3084":52413},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3634":423,"_31331":423,"_5":15305,"_3084":52415,"_31690":52416,"_21707":52418,"_28497":423},"Deployment troubleshooting",[51145,51146,52417],"Operations",[],{"_3634":424,"_31331":423,"_21707":52420,"_5":14945,"_28497":423,"_3084":52421},[],"Diagnose access, service health and infrastructure dependencies.",{"_3634":425,"_31331":423,"_5":31687,"_21707":52423,"_28497":52424,"_3084":52425},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3634":426,"_31331":423,"_5":31687,"_21707":52427,"_28497":52428,"_3084":52429},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3634":427,"_31331":423,"_5":31687,"_21707":52431,"_28497":52432,"_3084":52433},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3634":428,"_31331":423,"_5":31687,"_21707":52435,"_28497":52436,"_3084":52437},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3634":429,"_31331":423,"_5":31687,"_21707":52439,"_28497":52440,"_3084":52441},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3634":430,"_31331":423,"_5":31687,"_21707":52443,"_28497":52444,"_3084":52445},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3634":431,"_31331":423,"_5":31687,"_21707":52447,"_28497":52448,"_3084":52449},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3634":432,"_31331":423,"_5":31687,"_21707":52451,"_28497":52452,"_3084":52453},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3634":433,"_31331":423,"_5":31687,"_21707":52455,"_28497":52456,"_3084":52457},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3634":434,"_31331":423,"_5":31687,"_21707":52459,"_28497":52460,"_3084":52461},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3634":435,"_31331":423,"_5":31687,"_21707":52463,"_28497":52464,"_3084":52465},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3634":436,"_31331":423,"_5":31687,"_21707":52467,"_28497":52468,"_3084":52469},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3634":437,"_31331":423,"_5":31687,"_21707":52471,"_28497":52472,"_3084":52473},[],"/docs/pr-preview/pr-81/deployment/troubleshooting#observability","Observability",{"_3634":438,"_31331":423,"_21707":52475,"_5":14945,"_28497":423,"_3084":52476},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3634":439,"_31331":423,"_21707":52478,"_5":14945,"_28497":52428,"_3084":52479},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3634":440,"_31331":423,"_21707":52481,"_5":14945,"_28497":52432,"_3084":52482},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3634":441,"_31331":423,"_21707":52484,"_5":14945,"_28497":52436,"_3084":52485},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3634":442,"_31331":423,"_21707":52487,"_5":14945,"_28497":52440,"_3084":52488},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3634":443,"_31331":423,"_21707":52490,"_5":14945,"_28497":52444,"_3084":52491},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3634":444,"_31331":423,"_21707":52493,"_5":14945,"_28497":52448,"_3084":52494},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3634":445,"_31331":423,"_21707":52496,"_5":14945,"_28497":52448,"_3084":52497},[],"Also run the chart's connectivity test:",{"_3634":446,"_31331":423,"_21707":52499,"_5":14945,"_28497":52448,"_3084":52500},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3634":447,"_31331":423,"_21707":52502,"_5":14945,"_28497":52448,"_3084":52503},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3634":448,"_31331":423,"_21707":52505,"_5":14945,"_28497":52452,"_3084":52506},[],"If you receive a 401:",{"_3634":449,"_31331":423,"_21707":52508,"_5":14945,"_28497":52452,"_3084":52509},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3634":450,"_31331":423,"_21707":52511,"_5":14945,"_28497":52452,"_3084":52512},[],"verify issuer, audience and expiration of the token;",{"_3634":451,"_31331":423,"_21707":52514,"_5":14945,"_28497":52452,"_3084":52515},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3634":452,"_31331":423,"_21707":52517,"_5":14945,"_28497":52452,"_3084":52518},[],"check that the provider's public and internal routes point to the same realm.",{"_3634":453,"_31331":423,"_21707":52520,"_5":14945,"_28497":52452,"_3084":52521},[],"If login succeeds but the APIs return 403:",{"_3634":454,"_31331":423,"_21707":52523,"_5":14945,"_28497":52452,"_3084":52524},[],"inspect the token's real claims;",{"_3634":455,"_31331":423,"_21707":52526,"_5":14945,"_28497":52452,"_3084":52527},[],"confirm they match an active principal;",{"_3634":456,"_31331":423,"_21707":52529,"_5":14945,"_28497":52452,"_3084":52530},[],"review the policies granted to that principal;",{"_3634":457,"_31331":423,"_21707":52532,"_5":14945,"_28497":52452,"_3084":52533},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3634":458,"_31331":423,"_21707":52535,"_5":14945,"_28497":52452,"_3084":52536},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3634":459,"_31331":423,"_21707":52538,"_5":14945,"_28497":52456,"_3084":52539},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3634":460,"_31331":423,"_21707":52541,"_5":14945,"_28497":52456,"_3084":52542},[],"Locate the authz pod and Service.",{"_3634":461,"_31331":423,"_21707":52544,"_5":14945,"_28497":52456,"_3084":52545},[],"Check /health, logs and its database connection.",{"_3634":462,"_31331":423,"_21707":52547,"_5":14945,"_28497":52456,"_3084":52548},[],"Verify the DNS and port configured in externalAuthorization.",{"_3634":463,"_31331":423,"_21707":52550,"_5":14945,"_28497":52456,"_3084":52551},[],"Check the check route is /v1/ext\\_authz/check.",{"_3634":464,"_31331":423,"_21707":52553,"_5":14945,"_28497":52456,"_3084":52554},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3634":465,"_31331":423,"_21707":52556,"_5":14945,"_28497":52460,"_3084":52557},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3634":466,"_31331":423,"_21707":52559,"_5":14945,"_28497":52464,"_3084":52560},[],"Review kubectl describe pod first. Common causes are:",{"_3634":467,"_31331":423,"_21707":52562,"_5":14945,"_28497":52464,"_3084":52563},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3634":468,"_31331":423,"_21707":52565,"_5":14945,"_28497":52464,"_3084":52566},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3634":469,"_31331":423,"_21707":52568,"_5":14945,"_28497":52464,"_3084":52569},[],"unbound persistent volume;",{"_3634":470,"_31331":423,"_21707":52571,"_5":14945,"_28497":52464,"_3084":52572},[],"inaccessible image or incorrect pull policy;",{"_3634":471,"_31331":423,"_21707":52574,"_5":14945,"_28497":52464,"_3084":52575},[],"invalid cryptographic engine configuration;",{"_3634":472,"_31331":423,"_21707":52577,"_5":14945,"_28497":52464,"_3084":52578},[],"CPU or memory limits set too low;",{"_3634":473,"_31331":423,"_21707":52580,"_5":14945,"_28497":52464,"_3084":52581},[],"an incomplete prior migration.",{"_3634":474,"_31331":423,"_21707":52583,"_5":14945,"_28497":52464,"_3084":52584},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3634":475,"_31331":423,"_21707":52586,"_5":14945,"_28497":52464,"_3084":52587},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3634":476,"_31331":423,"_21707":52589,"_5":14945,"_28497":52464,"_3084":52590},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3634":477,"_31331":423,"_21707":52592,"_5":14945,"_28497":52468,"_3084":52593},[],"Domain and audit events depend on the bus publisher:",{"_3634":478,"_31331":423,"_21707":52595,"_5":14945,"_28497":52468,"_3084":52596},[],"verify it is enabled in the emitting service;",{"_3634":479,"_31331":423,"_21707":52598,"_5":14945,"_28497":52468,"_3084":52599},[],"check AMQP connectivity and credentials;",{"_3634":480,"_31331":423,"_21707":52601,"_5":14945,"_28497":52468,"_3084":52602},[],"review exchange, routing key, queues and consumers;",{"_3634":481,"_31331":423,"_21707":52604,"_5":14945,"_28497":52468,"_3084":52605},[],"inspect dead-letter queues;",{"_3634":482,"_31331":423,"_21707":52607,"_5":14945,"_28497":52468,"_3084":52608},[],"alert on orphan durable queues and backlog growth.",{"_3634":483,"_31331":423,"_21707":52610,"_5":14945,"_28497":52468,"_3084":52611},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3634":484,"_31331":423,"_21707":52613,"_5":14945,"_28497":52468,"_3084":52614},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3634":485,"_31331":423,"_21707":52616,"_5":14945,"_28497":52468,"_3084":52617},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3634":486,"_31331":423,"_21707":52619,"_5":14945,"_28497":52468,"_3084":52620},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3634":487,"_31331":423,"_21707":52622,"_5":14945,"_28497":52468,"_3084":52623},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3634":488,"_31331":423,"_21707":52625,"_5":14945,"_28497":52468,"_3084":52626},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3634":489,"_31331":423,"_21707":52628,"_5":14945,"_28497":52468,"_3084":52629},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3634":490,"_31331":423,"_21707":52631,"_5":14945,"_28497":52472,"_3084":52632},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3634":491,"_31331":423,"_21707":52634,"_5":14945,"_28497":52472,"_3084":52635},[],"Before closing an incident, record:",{"_3634":492,"_31331":423,"_21707":52637,"_5":14945,"_28497":52472,"_3084":52638},[],"the confirmed cause;",{"_3634":493,"_31331":423,"_21707":52640,"_5":14945,"_28497":52472,"_3084":52641},[],"the time scope and affected resources;",{"_3634":494,"_31331":423,"_21707":52643,"_5":14945,"_28497":52472,"_3084":52644},[],"the commands or queries used;",{"_3634":495,"_31331":423,"_21707":52646,"_5":14945,"_28497":52472,"_3084":52647},[],"the applied change and how to revert it;",{"_3634":496,"_31331":423,"_21707":52649,"_5":14945,"_28497":52472,"_3084":52650},[],"validation from a consumer;",{"_3634":497,"_31331":423,"_21707":52652,"_5":14945,"_28497":52472,"_3084":52653},[],"the preventive action and its owner.",{"_3634":498,"_31331":498,"_5":15305,"_3084":52655,"_31690":52656,"_21707":52660,"_28497":498},"Data model",[51145,52657,52658,52659],"Platform","Administration","Access control",[],{"_3634":499,"_31331":498,"_21707":52662,"_5":14945,"_28497":498,"_3084":52663},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3634":500,"_31331":498,"_5":31687,"_21707":52665,"_28497":52666,"_3084":52667},[],"/docs/pr-preview/pr-81/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3634":501,"_31331":498,"_5":31687,"_21707":52669,"_28497":52670,"_3084":52671},[],"/docs/pr-preview/pr-81/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3634":502,"_31331":498,"_21707":52673,"_5":14945,"_28497":498,"_3084":52674},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3634":503,"_31331":498,"_21707":52676,"_5":14945,"_28497":52666,"_3084":52677},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3634":504,"_31331":498,"_21707":52679,"_5":14945,"_28497":52666,"_3084":52680},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3634":505,"_31331":498,"_21707":52682,"_5":14945,"_28497":52666,"_3084":52683},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3634":506,"_31331":498,"_21707":52685,"_5":14945,"_28497":52670,"_3084":52686},[],"Entity (`schema_name.entity_type`)",{"_3634":507,"_31331":498,"_21707":52688,"_5":14945,"_28497":52670,"_3084":52689},[],"Table (`table_name`)",{"_3634":508,"_31331":498,"_21707":52691,"_5":14945,"_28497":52670,"_3084":52692},[],"Key (`primary_key`)",{"_3634":509,"_31331":498,"_21707":52694,"_5":14945,"_28497":52670,"_3084":52695},[],"`alerts.event`",{"_3634":510,"_31331":498,"_21707":52697,"_5":14945,"_28497":52670,"_3084":52698},[],"`events`",{"_3634":511,"_31331":498,"_21707":52700,"_5":14945,"_28497":52670,"_3084":52701},[],"`event_type`",{"_3634":512,"_31331":498,"_21707":52703,"_5":14945,"_28497":52670,"_3084":52704},[],"`alerts.subscription`",{"_3634":513,"_31331":498,"_21707":52706,"_5":14945,"_28497":52670,"_3084":52707},[],"`subscriptions`",{"_3634":514,"_31331":498,"_21707":52709,"_5":14945,"_28497":52670,"_3084":52710},[],"`id`",{"_3634":515,"_31331":498,"_21707":52712,"_5":14945,"_28497":52670,"_3084":52713},[],"`ca.ca_certificate`",{"_3634":516,"_31331":498,"_21707":52715,"_5":14945,"_28497":52670,"_3084":52716},[],"`ca_certificates`",{"_3634":517,"_31331":498,"_21707":52718,"_5":14945,"_28497":52670,"_3084":52710},[],{"_3634":518,"_31331":498,"_21707":52720,"_5":14945,"_28497":52670,"_3084":52721},[],"`ca.certificate`",{"_3634":519,"_31331":498,"_21707":52723,"_5":14945,"_28497":52670,"_3084":52724},[],"`certificates`",{"_3634":520,"_31331":498,"_21707":52726,"_5":14945,"_28497":52670,"_3084":52727},[],"`serial_number`",{"_3634":521,"_31331":498,"_21707":52729,"_5":14945,"_28497":52670,"_3084":52730},[],"`ca.issuance_profile`",{"_3634":522,"_31331":498,"_21707":52732,"_5":14945,"_28497":52670,"_3084":52733},[],"`issuance_profiles`",{"_3634":523,"_31331":498,"_21707":52735,"_5":14945,"_28497":52670,"_3084":52710},[],{"_3634":524,"_31331":498,"_21707":52737,"_5":14945,"_28497":52670,"_3084":52738},[],"`devicemanager.device_group`",{"_3634":525,"_31331":498,"_21707":52740,"_5":14945,"_28497":52670,"_3084":52741},[],"`device_groups`",{"_3634":526,"_31331":498,"_21707":52743,"_5":14945,"_28497":52670,"_3084":52710},[],{"_3634":527,"_31331":498,"_21707":52745,"_5":14945,"_28497":52670,"_3084":52746},[],"`devicemanager.device`",{"_3634":528,"_31331":498,"_21707":52748,"_5":14945,"_28497":52670,"_3084":52749},[],"`devices`",{"_3634":529,"_31331":498,"_21707":52751,"_5":14945,"_28497":52670,"_3084":52710},[],{"_3634":530,"_31331":498,"_21707":52753,"_5":14945,"_28497":52670,"_3084":52754},[],"`dmsmanager.dms`",{"_3634":531,"_31331":498,"_21707":52756,"_5":14945,"_28497":52670,"_3084":52757},[],"`dms`",{"_3634":532,"_31331":498,"_21707":52759,"_5":14945,"_28497":52670,"_3084":52710},[],{"_3634":533,"_31331":498,"_21707":52761,"_5":14945,"_28497":52670,"_3084":52762},[],"`kms.kms_key`",{"_3634":534,"_31331":498,"_21707":52764,"_5":14945,"_28497":52670,"_3084":52765},[],"`kms_keys`",{"_3634":535,"_31331":498,"_21707":52767,"_5":14945,"_28497":52670,"_3084":52768},[],"`key_id`, `engine_id`",{"_3634":536,"_31331":498,"_21707":52770,"_5":14945,"_28497":52670,"_3084":52771},[],"`va.crl_settings`",{"_3634":537,"_31331":498,"_21707":52773,"_5":14945,"_28497":52670,"_3084":52774},[],"`crl_settings`",{"_3634":538,"_31331":498,"_21707":52776,"_5":14945,"_28497":52670,"_3084":52777},[],"`ca_id`",{"_3634":539,"_31331":498,"_21707":52779,"_5":14945,"_28497":52670,"_3084":52780},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3634":540,"_31331":498,"_21707":52782,"_5":14945,"_28497":52670,"_3084":52783},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3634":541,"_31331":498,"_21707":52785,"_5":14945,"_28497":52670,"_3084":52786},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3634":542,"_31331":542,"_5":15305,"_3084":52788,"_31690":52789,"_21707":52790,"_28497":542},"Access control overview",[51145,52657,52658,52659],[],{"_3634":543,"_31331":542,"_21707":52792,"_5":14945,"_28497":542,"_3084":52793},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3634":544,"_31331":542,"_5":31687,"_21707":52795,"_28497":52796,"_3084":52797},[],"/docs/pr-preview/pr-81/platform/administration/access-control#essential-concepts","Essential concepts",{"_3634":545,"_31331":542,"_5":31687,"_21707":52799,"_28497":52800,"_3084":52801},[],"/docs/pr-preview/pr-81/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3634":546,"_31331":542,"_5":31687,"_21707":52803,"_28497":52804,"_3084":52805},[],"/docs/pr-preview/pr-81/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3634":547,"_31331":542,"_5":31687,"_21707":52807,"_28497":52808,"_3084":52809},[],"/docs/pr-preview/pr-81/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3634":548,"_31331":542,"_5":31687,"_21707":52811,"_28497":52812,"_3084":52813},[],"/docs/pr-preview/pr-81/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3634":549,"_31331":542,"_5":31687,"_21707":52815,"_28497":52816,"_3084":52817},[],"/docs/pr-preview/pr-81/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3634":550,"_31331":542,"_5":31687,"_21707":52819,"_28497":52820,"_3084":52821},[],"/docs/pr-preview/pr-81/platform/administration/access-control#oidc-principals","OIDC principals",{"_3634":551,"_31331":542,"_5":31687,"_21707":52823,"_28497":52824,"_3084":52825},[],"/docs/pr-preview/pr-81/platform/administration/access-control#x509-principals","X.509 principals",{"_3634":552,"_31331":542,"_5":31687,"_21707":52827,"_28497":52828,"_3084":52829},[],"/docs/pr-preview/pr-81/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3634":553,"_31331":542,"_5":31687,"_21707":52831,"_28497":52832,"_3084":52833},[],"/docs/pr-preview/pr-81/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3634":554,"_31331":542,"_5":31687,"_21707":52835,"_28497":52836,"_3084":52837},[],"/docs/pr-preview/pr-81/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3634":555,"_31331":542,"_5":31687,"_21707":52839,"_28497":52840,"_3084":52841},[],"/docs/pr-preview/pr-81/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3634":556,"_31331":542,"_5":31687,"_21707":52843,"_28497":52844,"_3084":52845},[],"/docs/pr-preview/pr-81/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3634":557,"_31331":542,"_5":31687,"_21707":52847,"_28497":52848,"_3084":52849},[],"/docs/pr-preview/pr-81/platform/administration/access-control#http-rules","HTTP rules",{"_3634":558,"_31331":542,"_5":31687,"_21707":52851,"_28497":52852,"_3084":52853},[],"/docs/pr-preview/pr-81/platform/administration/access-control#included-policies","Included policies",{"_3634":559,"_31331":542,"_5":31687,"_21707":52855,"_28497":52856,"_3084":51795},[],"/docs/pr-preview/pr-81/platform/administration/access-control#provision-the-first-administrator",{"_3634":560,"_31331":542,"_5":31687,"_21707":52858,"_28497":52859,"_3084":52860},[],"/docs/pr-preview/pr-81/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3634":561,"_31331":542,"_5":31687,"_21707":52862,"_28497":52863,"_3084":52864},[],"/docs/pr-preview/pr-81/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3634":562,"_31331":542,"_5":31687,"_21707":52866,"_28497":52867,"_3084":52868},[],"/docs/pr-preview/pr-81/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3634":563,"_31331":542,"_5":31687,"_21707":52870,"_28497":52871,"_3084":52872},[],"/docs/pr-preview/pr-81/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3634":564,"_31331":542,"_5":31687,"_21707":52874,"_28497":52875,"_3084":52876},[],"/docs/pr-preview/pr-81/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3634":565,"_31331":542,"_5":31687,"_21707":52878,"_28497":52879,"_3084":52880},[],"/docs/pr-preview/pr-81/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3634":566,"_31331":542,"_5":31687,"_21707":52882,"_28497":52883,"_3084":52884},[],"/docs/pr-preview/pr-81/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3634":567,"_31331":542,"_5":31687,"_21707":52886,"_28497":52887,"_3084":52888},[],"/docs/pr-preview/pr-81/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3634":568,"_31331":542,"_5":31687,"_21707":52890,"_28497":52891,"_3084":52892},[],"/docs/pr-preview/pr-81/platform/administration/access-control#operational-checklist","Operational checklist",{"_3634":569,"_31331":542,"_5":31687,"_21707":52894,"_28497":52895,"_3084":52896},[],"/docs/pr-preview/pr-81/platform/administration/access-control#diagnostics","Diagnostics",{"_3634":570,"_31331":542,"_5":31687,"_21707":52898,"_28497":52899,"_3084":52900},[],"/docs/pr-preview/pr-81/platform/administration/access-control#the-response-is-401","The response is 401",{"_3634":571,"_31331":542,"_5":31687,"_21707":52902,"_28497":52903,"_3084":52904},[],"/docs/pr-preview/pr-81/platform/administration/access-control#the-response-is-403","The response is 403",{"_3634":572,"_31331":542,"_5":31687,"_21707":52906,"_28497":52907,"_3084":52908},[],"/docs/pr-preview/pr-81/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3634":573,"_31331":542,"_5":31687,"_21707":52910,"_28497":52911,"_3084":52912},[],"/docs/pr-preview/pr-81/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3634":574,"_31331":542,"_5":31687,"_21707":52914,"_28497":52915,"_3084":52916},[],"/docs/pr-preview/pr-81/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3634":575,"_31331":542,"_21707":52918,"_5":14945,"_28497":542,"_3084":52919},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3634":576,"_31331":542,"_21707":52921,"_5":14945,"_28497":542,"_3084":52922},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3634":577,"_31331":542,"_21707":52924,"_5":14945,"_28497":542,"_3084":52925},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3634":578,"_31331":542,"_21707":52927,"_5":14945,"_28497":52796,"_3084":52928},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3634":579,"_31331":542,"_21707":52930,"_5":14945,"_28497":52796,"_3084":52931},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3634":580,"_31331":542,"_21707":52933,"_5":14945,"_28497":52796,"_3084":52934},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3634":581,"_31331":542,"_21707":52936,"_5":14945,"_28497":52796,"_3084":52937},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3634":582,"_31331":542,"_21707":52939,"_5":14945,"_28497":52796,"_3084":52940},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3634":583,"_31331":542,"_21707":52942,"_5":14945,"_28497":52796,"_3084":52943},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3634":584,"_31331":542,"_21707":52945,"_5":14945,"_28497":52800,"_3084":52946},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3634":585,"_31331":542,"_21707":52948,"_5":14945,"_28497":52800,"_3084":52949},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3634":586,"_31331":542,"_21707":52951,"_5":14945,"_28497":52804,"_3084":52952},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3634":587,"_31331":542,"_21707":52954,"_5":14945,"_28497":52804,"_3084":52955},[],"The decision is made **before forwarding the request to the service**:",{"_3634":588,"_31331":542,"_21707":52957,"_5":14945,"_28497":52804,"_3084":52958},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3634":589,"_31331":542,"_21707":52960,"_5":14945,"_28497":52804,"_3084":52961},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3634":590,"_31331":542,"_21707":52963,"_5":14945,"_28497":52804,"_3084":52964},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3634":591,"_31331":542,"_21707":52966,"_5":14945,"_28497":52804,"_3084":52967},[],"It separately loads the policies granted to each principal.",{"_3634":592,"_31331":542,"_21707":52969,"_5":14945,"_28497":52804,"_3084":52970},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3634":593,"_31331":542,"_21707":52972,"_5":14945,"_28497":52804,"_3084":52973},[],"`authz` looks for an HTTP rule granting that action.",{"_3634":594,"_31331":542,"_21707":52975,"_5":14945,"_28497":52804,"_3084":52976},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3634":595,"_31331":542,"_21707":52978,"_5":14945,"_28497":52804,"_3084":52979},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3634":596,"_31331":542,"_21707":52981,"_5":14945,"_28497":52804,"_3084":52982},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3634":597,"_31331":542,"_21707":52984,"_5":14945,"_28497":52804,"_3084":52985},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3634":598,"_31331":542,"_21707":52987,"_5":14945,"_28497":52808,"_3084":52988},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3634":599,"_31331":542,"_21707":52990,"_5":14945,"_28497":52808,"_3084":52991},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3634":600,"_31331":542,"_21707":52993,"_5":14945,"_28497":52808,"_3084":52994},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3634":601,"_31331":542,"_21707":52996,"_5":14945,"_28497":52808,"_3084":52997},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3634":602,"_31331":542,"_21707":52999,"_5":14945,"_28497":52808,"_3084":53000},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3634":603,"_31331":542,"_21707":53002,"_5":14945,"_28497":52808,"_3084":53003},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3634":604,"_31331":542,"_21707":53005,"_5":14945,"_28497":52808,"_3084":53006},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3634":605,"_31331":542,"_21707":53008,"_5":14945,"_28497":52808,"_3084":53009},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3634":606,"_31331":542,"_21707":53011,"_5":14945,"_28497":52808,"_3084":53012},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3634":607,"_31331":542,"_21707":53014,"_5":14945,"_28497":52808,"_3084":53015},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3634":608,"_31331":542,"_21707":53017,"_5":14945,"_28497":52812,"_3084":53018},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3634":609,"_31331":542,"_21707":53020,"_5":14945,"_28497":52812,"_3084":53021},[],"The decision is made with the domain operation context:",{"_3634":610,"_31331":542,"_21707":53023,"_5":14945,"_28497":52812,"_3084":53024},[],"The middleware extracts the credential and resolves the matching principals.",{"_3634":611,"_31331":542,"_21707":53026,"_5":14945,"_28497":52812,"_3084":53027},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3634":612,"_31331":542,"_21707":53029,"_5":14945,"_28497":52812,"_3084":53030},[],"`authz` gathers the entity rules of the granted policies.",{"_3634":613,"_31331":542,"_21707":53032,"_5":14945,"_28497":52812,"_3084":53033},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3634":614,"_31331":542,"_21707":53035,"_5":14945,"_28497":52812,"_3084":53036},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3634":615,"_31331":542,"_21707":53038,"_5":14945,"_28497":52812,"_3084":53039},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3634":616,"_31331":542,"_21707":53041,"_5":14945,"_28497":52812,"_3084":53042},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3634":617,"_31331":542,"_21707":53044,"_5":14945,"_28497":52812,"_3084":53045},[],"Actions fall into two groups:",{"_3634":618,"_31331":542,"_21707":53047,"_5":14945,"_28497":52812,"_3084":53048},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3634":619,"_31331":542,"_21707":53050,"_5":14945,"_28497":52812,"_3084":53051},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3634":620,"_31331":542,"_21707":53053,"_5":14945,"_28497":52812,"_3084":53054},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3634":621,"_31331":542,"_21707":53056,"_5":14945,"_28497":52816,"_3084":53057},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3634":622,"_31331":542,"_21707":53059,"_5":14945,"_28497":52816,"_3084":53060},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3634":623,"_31331":542,"_21707":53062,"_5":14945,"_28497":52816,"_3084":53063},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3634":624,"_31331":542,"_21707":53065,"_5":14945,"_28497":52820,"_3084":53066},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3634":625,"_31331":542,"_21707":53068,"_5":14945,"_28497":52820,"_3084":53069},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3634":626,"_31331":542,"_21707":53071,"_5":14945,"_28497":52820,"_3084":53072},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3634":627,"_31331":542,"_21707":53074,"_5":14945,"_28497":52820,"_3084":53075},[],"The implemented operators are:",{"_3634":628,"_31331":542,"_21707":53077,"_5":14945,"_28497":52820,"_3084":53078},[],"`equals`, for exact equality;",{"_3634":629,"_31331":542,"_21707":53080,"_5":14945,"_28497":52820,"_3084":53081},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3634":630,"_31331":542,"_21707":53083,"_5":14945,"_28497":52820,"_3084":53084},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3634":631,"_31331":542,"_21707":53086,"_5":14945,"_28497":52820,"_3084":53087},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3634":632,"_31331":542,"_21707":53089,"_5":14945,"_28497":52824,"_3084":53090},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3634":633,"_31331":542,"_21707":53092,"_5":14945,"_28497":52824,"_3084":53093},[],"The available modes are:",{"_3634":634,"_31331":542,"_21707":53095,"_5":14945,"_28497":52824,"_3084":53096},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3634":635,"_31331":542,"_21707":53098,"_5":14945,"_28497":52824,"_3084":53099},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3634":636,"_31331":542,"_21707":53101,"_5":14945,"_28497":52824,"_3084":53102},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3634":637,"_31331":542,"_21707":53104,"_5":14945,"_28497":52824,"_3084":53105},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3634":638,"_31331":542,"_21707":53107,"_5":14945,"_28497":52824,"_3084":53108},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3634":639,"_31331":542,"_21707":53110,"_5":14945,"_28497":52824,"_3084":53111},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3634":640,"_31331":542,"_21707":53113,"_5":14945,"_28497":52828,"_3084":53114},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3634":641,"_31331":542,"_21707":53116,"_5":14945,"_28497":52828,"_3084":53117},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3634":642,"_31331":542,"_21707":53119,"_5":14945,"_28497":52828,"_3084":53120},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3634":643,"_31331":542,"_21707":53122,"_5":14945,"_28497":52828,"_3084":53123},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3634":644,"_31331":542,"_21707":53125,"_5":14945,"_28497":52836,"_3084":53126},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3634":645,"_31331":542,"_21707":53128,"_5":14945,"_28497":52836,"_3084":53129},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3634":646,"_31331":542,"_21707":53131,"_5":14945,"_28497":52840,"_3084":53132},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3634":647,"_31331":542,"_21707":53134,"_5":14945,"_28497":52840,"_3084":53135},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3634":648,"_31331":542,"_21707":53137,"_5":14945,"_28497":52840,"_3084":53138},[],"The data model shows how the resources used in entity rules are connected.",{"_3634":649,"_31331":542,"_21707":53140,"_5":14945,"_28497":52840,"_3084":53141},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3634":650,"_31331":542,"_21707":53143,"_5":14945,"_28497":52840,"_3084":53144},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3634":651,"_31331":542,"_21707":53146,"_5":14945,"_28497":52844,"_3084":53147},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3634":652,"_31331":542,"_21707":53149,"_5":14945,"_28497":52844,"_3084":53150},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3634":653,"_31331":542,"_21707":53152,"_5":14945,"_28497":52844,"_3084":53153},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3634":654,"_31331":542,"_21707":53155,"_5":14945,"_28497":52848,"_3084":53156},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3634":655,"_31331":542,"_21707":53158,"_5":14945,"_28497":52848,"_3084":53159},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3634":656,"_31331":542,"_21707":53161,"_5":14945,"_28497":52848,"_3084":53162},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3634":657,"_31331":542,"_21707":53164,"_5":14945,"_28497":52848,"_3084":53165},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3634":658,"_31331":542,"_21707":53167,"_5":14945,"_28497":52848,"_3084":53168},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3634":659,"_31331":542,"_21707":53170,"_5":14945,"_28497":52848,"_3084":53171},[],"Note that:",{"_3634":660,"_31331":542,"_21707":53173,"_5":14945,"_28497":52848,"_3084":53174},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3634":661,"_31331":542,"_21707":53176,"_5":14945,"_28497":52848,"_3084":53177},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3634":662,"_31331":542,"_21707":53179,"_5":14945,"_28497":52848,"_3084":53180},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3634":663,"_31331":542,"_21707":53182,"_5":14945,"_28497":52852,"_3084":53183},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3634":664,"_31331":542,"_21707":53185,"_5":14945,"_28497":52852,"_3084":53186},[],"full and read-only access to certificates and authorities;",{"_3634":665,"_31331":542,"_21707":53188,"_5":14945,"_28497":52852,"_3084":53189},[],"full and read-only access to the KMS;",{"_3634":666,"_31331":542,"_21707":53191,"_5":14945,"_28497":52852,"_3084":53192},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3634":667,"_31331":542,"_21707":53194,"_5":14945,"_28497":52852,"_3084":53195},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3634":668,"_31331":542,"_21707":53197,"_5":14945,"_28497":52852,"_3084":53198},[],"console access;",{"_3634":669,"_31331":542,"_21707":53200,"_5":14945,"_28497":52852,"_3084":53201},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3634":670,"_31331":542,"_21707":53203,"_5":14945,"_28497":52852,"_3084":53204},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3634":671,"_31331":542,"_21707":53206,"_5":14945,"_28497":52852,"_3084":53207},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3634":672,"_31331":542,"_21707":53209,"_5":14945,"_28497":52852,"_3084":53210},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3634":673,"_31331":542,"_21707":53212,"_5":14945,"_28497":52852,"_3084":53213},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3634":674,"_31331":542,"_21707":53215,"_5":14945,"_28497":52856,"_3084":53216},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3634":675,"_31331":542,"_21707":53218,"_5":14945,"_28497":52856,"_3084":53219},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3634":676,"_31331":542,"_21707":53221,"_5":14945,"_28497":52856,"_3084":53222},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3634":677,"_31331":542,"_21707":53224,"_5":14945,"_28497":52859,"_3084":53225},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3634":678,"_31331":542,"_21707":53227,"_5":14945,"_28497":52863,"_3084":53228},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3634":679,"_31331":542,"_21707":53230,"_5":14945,"_28497":52863,"_3084":53231},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3634":680,"_31331":542,"_21707":53233,"_5":14945,"_28497":52867,"_3084":53234},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3634":681,"_31331":542,"_21707":53236,"_5":14945,"_28497":52871,"_3084":53237},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3634":682,"_31331":542,"_21707":53239,"_5":14945,"_28497":52875,"_3084":53240},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3634":683,"_31331":542,"_21707":53242,"_5":14945,"_28497":52879,"_3084":53243},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3634":684,"_31331":542,"_21707":53245,"_5":14945,"_28497":52879,"_3084":53246},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3634":685,"_31331":542,"_21707":53248,"_5":14945,"_28497":52883,"_3084":53249},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3634":686,"_31331":542,"_21707":53251,"_5":14945,"_28497":52883,"_3084":53252},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3634":687,"_31331":542,"_21707":53254,"_5":14945,"_28497":52883,"_3084":53255},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3634":688,"_31331":542,"_21707":53257,"_5":14945,"_28497":52883,"_3084":53258},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3634":689,"_31331":542,"_21707":53260,"_5":14945,"_28497":52883,"_3084":53261},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3634":690,"_31331":542,"_21707":53263,"_5":14945,"_28497":52883,"_3084":53264},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3634":691,"_31331":542,"_21707":53266,"_5":14945,"_28497":52883,"_3084":53267},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3634":692,"_31331":542,"_21707":53269,"_5":14945,"_28497":52883,"_3084":53270},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3634":693,"_31331":542,"_21707":53272,"_5":14945,"_28497":52887,"_3084":53273},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3634":694,"_31331":542,"_21707":53275,"_5":14945,"_28497":52887,"_3084":53276},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3634":695,"_31331":542,"_21707":53278,"_5":14945,"_28497":52887,"_3084":53279},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3634":696,"_31331":542,"_21707":53281,"_5":14945,"_28497":52891,"_3084":53282},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3634":697,"_31331":542,"_21707":53284,"_5":14945,"_28497":52891,"_3084":53285},[],"Use groups or stable roles for people and independent identities for automations.",{"_3634":698,"_31331":542,"_21707":53287,"_5":14945,"_28497":52891,"_3084":53288},[],"Keep at least two recovery administrators and test their access periodically.",{"_3634":699,"_31331":542,"_21707":53290,"_5":14945,"_28497":52891,"_3084":53291},[],"Review active principals, their matches and their grants after IdP changes.",{"_3634":700,"_31331":542,"_21707":53293,"_5":14945,"_28497":52891,"_3084":53294},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3634":701,"_31331":542,"_21707":53296,"_5":14945,"_28497":52891,"_3084":53297},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3634":702,"_31331":542,"_21707":53299,"_5":14945,"_28497":52891,"_3084":53300},[],"Always test one allowed and one denied operation for each role.",{"_3634":703,"_31331":542,"_21707":53302,"_5":14945,"_28497":52891,"_3084":53303},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3634":704,"_31331":542,"_21707":53305,"_5":14945,"_28497":52899,"_3084":53306},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3634":705,"_31331":542,"_21707":53308,"_5":14945,"_28497":52903,"_3084":53309},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3634":706,"_31331":542,"_21707":53311,"_5":14945,"_28497":52903,"_3084":53312},[],"that an active principal of the correct type exists;",{"_3634":707,"_31331":542,"_21707":53314,"_5":14945,"_28497":52903,"_3084":53315},[],"that the claim paths and values match the real token exactly;",{"_3634":708,"_31331":542,"_21707":53317,"_5":14945,"_28497":52903,"_3084":53318},[],"that all of the principal's conditions hold;",{"_3634":709,"_31331":542,"_21707":53320,"_5":14945,"_28497":52903,"_3084":53321},[],"that the principal has the expected policy granted;",{"_3634":710,"_31331":542,"_21707":53323,"_5":14945,"_28497":52903,"_3084":53324},[],"that the policy includes the action and the requested resource type or route;",{"_3634":711,"_31331":542,"_21707":53326,"_5":14945,"_28497":52903,"_3084":53327},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3634":712,"_31331":542,"_21707":53329,"_5":14945,"_28497":52903,"_3084":53330},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3634":713,"_31331":542,"_21707":53332,"_5":14945,"_28497":52903,"_3084":53333},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3634":714,"_31331":542,"_21707":53335,"_5":14945,"_28497":52907,"_3084":53336},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3634":715,"_31331":542,"_21707":53338,"_5":14945,"_28497":52911,"_3084":53339},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3634":716,"_31331":542,"_21707":53341,"_5":14945,"_28497":52915,"_3084":53342},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3634":717,"_31331":542,"_21707":53344,"_5":14945,"_28497":52915,"_3084":53345},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3634":718,"_31331":718,"_5":15305,"_3084":53347,"_31690":53348,"_21707":53349,"_28497":718},"Alerts and subscriptions",[51145,52657,52658],[],{"_3634":719,"_31331":718,"_21707":53351,"_5":14945,"_28497":718,"_3084":53352},[],"Send PKI events to people and external systems.",{"_3634":720,"_31331":718,"_5":31687,"_21707":53354,"_28497":53355,"_3084":53356},[],"/docs/pr-preview/pr-81/platform/administration/alerts#how-it-works","How it works",{"_3634":721,"_31331":718,"_5":31687,"_21707":53358,"_28497":53359,"_3084":53360},[],"/docs/pr-preview/pr-81/platform/administration/alerts#available-channels","Available channels",{"_3634":722,"_31331":718,"_5":31687,"_21707":53362,"_28497":53363,"_3084":53364},[],"/docs/pr-preview/pr-81/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3634":723,"_31331":718,"_5":31687,"_21707":53366,"_28497":53367,"_3084":53368},[],"/docs/pr-preview/pr-81/platform/administration/alerts#choose-the-event","Choose the event",{"_3634":724,"_31331":718,"_5":31687,"_21707":53370,"_28497":53371,"_3084":53372},[],"/docs/pr-preview/pr-81/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3634":725,"_31331":718,"_5":31687,"_21707":53374,"_28497":53375,"_3084":53376},[],"/docs/pr-preview/pr-81/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3634":726,"_31331":718,"_5":31687,"_21707":53378,"_28497":53379,"_3084":53380},[],"/docs/pr-preview/pr-81/platform/administration/alerts#review-and-activate","Review and activate",{"_3634":727,"_31331":718,"_5":31687,"_21707":53382,"_28497":53383,"_3084":53384},[],"/docs/pr-preview/pr-81/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3634":728,"_31331":718,"_5":31687,"_21707":53386,"_28497":53387,"_3084":53388},[],"/docs/pr-preview/pr-81/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3634":729,"_31331":718,"_5":31687,"_21707":53390,"_28497":53391,"_3084":53392},[],"/docs/pr-preview/pr-81/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3634":730,"_31331":718,"_5":31687,"_21707":53394,"_28497":53395,"_3084":53396},[],"/docs/pr-preview/pr-81/platform/administration/alerts#event-families","Event families",{"_3634":731,"_31331":718,"_21707":53398,"_5":14945,"_28497":718,"_3084":53399},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3634":732,"_31331":718,"_21707":53401,"_5":14945,"_28497":53355,"_3084":53402},[],"A service publishes a domain event.",{"_3634":733,"_31331":718,"_21707":53404,"_5":14945,"_28497":53355,"_3084":53405},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3634":734,"_31331":718,"_21707":53407,"_5":14945,"_28497":53355,"_3084":53408},[],"Each subscription's filter decides whether it should be notified.",{"_3634":735,"_31331":718,"_21707":53410,"_5":14945,"_28497":53355,"_3084":53411},[],"Lamassu delivers the event to the configured channel.",{"_3634":736,"_31331":718,"_21707":53413,"_5":14945,"_28497":53355,"_3084":53414},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3634":737,"_31331":718,"_21707":53416,"_5":14945,"_28497":53359,"_3084":53417},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3634":738,"_31331":718,"_21707":53419,"_5":14945,"_28497":53359,"_3084":53420},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3634":739,"_31331":718,"_21707":53422,"_5":14945,"_28497":53359,"_3084":53423},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3634":740,"_31331":718,"_21707":53425,"_5":14945,"_28497":53359,"_3084":53426},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3634":741,"_31331":718,"_21707":53428,"_5":14945,"_28497":53359,"_3084":53429},[],"`apikey_options` requires `header` and `key`.",{"_3634":742,"_31331":718,"_21707":53431,"_5":14945,"_28497":53359,"_3084":53432},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3634":743,"_31331":718,"_21707":53434,"_5":14945,"_28497":53359,"_3084":53435},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3634":744,"_31331":718,"_21707":53437,"_5":14945,"_28497":53359,"_3084":53438},[],"The alerts API reference documents the full `http_client` schema.",{"_3634":745,"_31331":718,"_21707":53440,"_5":14945,"_28497":53367,"_3084":53441},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3634":746,"_31331":718,"_21707":53443,"_5":14945,"_28497":53371,"_3084":53444},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3634":747,"_31331":718,"_21707":53446,"_5":14945,"_28497":53375,"_3084":53447},[],"Add a filter if you don't want to receive every instance of the event.",{"_3634":748,"_31331":718,"_21707":53449,"_5":14945,"_28497":53375,"_3084":53450},[],"**None** notifies all instances of the event.",{"_3634":749,"_31331":718,"_21707":53452,"_5":14945,"_28497":53375,"_3084":53453},[],"**JSON Path** evaluates one or more specific fields.",{"_3634":750,"_31331":718,"_21707":53455,"_5":14945,"_28497":53375,"_3084":53456},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3634":751,"_31331":718,"_21707":53458,"_5":14945,"_28497":53375,"_3084":53459},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3634":752,"_31331":718,"_21707":53461,"_5":14945,"_28497":53375,"_3084":53462},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3634":753,"_31331":718,"_21707":53464,"_5":14945,"_28497":53375,"_3084":53465},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3634":754,"_31331":718,"_21707":53467,"_5":14945,"_28497":53379,"_3084":53468},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3634":755,"_31331":718,"_21707":53470,"_5":14945,"_28497":53383,"_3084":53471},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3634":756,"_31331":718,"_21707":53473,"_5":14945,"_28497":53383,"_3084":53474},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3634":757,"_31331":718,"_21707":53476,"_5":14945,"_28497":53383,"_3084":53477},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3634":758,"_31331":718,"_21707":53479,"_5":14945,"_28497":53383,"_3084":53480},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3634":759,"_31331":718,"_21707":53482,"_5":14945,"_28497":53383,"_3084":53483},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3634":760,"_31331":718,"_21707":53485,"_5":14945,"_28497":53383,"_3084":53486},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3634":761,"_31331":718,"_21707":53488,"_5":14945,"_28497":53383,"_3084":53489},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3634":762,"_31331":718,"_21707":53491,"_5":14945,"_28497":53383,"_3084":53492},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3634":763,"_31331":718,"_21707":53494,"_5":14945,"_28497":53387,"_3084":53495},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3634":764,"_31331":718,"_21707":53497,"_5":14945,"_28497":53387,"_3084":53498},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3634":765,"_31331":718,"_21707":53500,"_5":14945,"_28497":53387,"_3084":53501},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3634":766,"_31331":718,"_21707":53503,"_5":14945,"_28497":53387,"_3084":53504},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3634":767,"_31331":718,"_21707":53506,"_5":14945,"_28497":53387,"_3084":53507},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3634":768,"_31331":718,"_21707":53509,"_5":14945,"_28497":53387,"_3084":53510},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3634":769,"_31331":718,"_21707":53512,"_5":14945,"_28497":53387,"_3084":53513},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3634":770,"_31331":718,"_21707":53515,"_5":14945,"_28497":53387,"_3084":53516},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3634":771,"_31331":718,"_21707":53518,"_5":14945,"_28497":53391,"_3084":53519},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3634":772,"_31331":718,"_21707":53521,"_5":14945,"_28497":53391,"_3084":53522},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3634":773,"_31331":718,"_21707":53524,"_5":14945,"_28497":53395,"_3084":53525},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3634":774,"_31331":718,"_21707":53527,"_5":14945,"_28497":53395,"_3084":53528},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3634":775,"_31331":718,"_21707":53530,"_5":14945,"_28497":53395,"_3084":53531},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3634":776,"_31331":718,"_21707":53533,"_5":14945,"_28497":53395,"_3084":53534},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3634":777,"_31331":718,"_21707":53536,"_5":14945,"_28497":53395,"_3084":53537},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3634":778,"_31331":718,"_21707":53539,"_5":14945,"_28497":53395,"_3084":53540},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3634":779,"_31331":718,"_21707":53542,"_5":14945,"_28497":53395,"_3084":53543},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3634":780,"_31331":718,"_21707":53545,"_5":14945,"_28497":53395,"_3084":53546},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3634":781,"_31331":718,"_21707":53548,"_5":14945,"_28497":53395,"_3084":53549},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3634":782,"_31331":718,"_21707":53551,"_5":14945,"_28497":53395,"_3084":53552},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3634":783,"_31331":783,"_5":15305,"_3084":53554,"_31690":53555,"_21707":53556,"_28497":783},"Audit logs",[51145,52657,52658],[],{"_3634":784,"_31331":783,"_21707":53558,"_5":14945,"_28497":783,"_3084":53559},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3634":785,"_31331":783,"_5":31687,"_21707":53561,"_28497":53562,"_3084":53563},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3634":786,"_31331":783,"_5":31687,"_21707":53565,"_28497":53566,"_3084":53567},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#coverage","Coverage",{"_3634":787,"_31331":783,"_5":31687,"_21707":53569,"_28497":53570,"_3084":53571},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3634":788,"_31331":783,"_5":31687,"_21707":53573,"_28497":53574,"_3084":53575},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3634":789,"_31331":783,"_5":31687,"_21707":53577,"_28497":53578,"_3084":53579},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3634":790,"_31331":783,"_5":31687,"_21707":53581,"_28497":53582,"_3084":53583},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3634":791,"_31331":783,"_5":31687,"_21707":53585,"_28497":53586,"_3084":53587},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3634":792,"_31331":783,"_5":31687,"_21707":53589,"_28497":53590,"_3084":53591},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3634":793,"_31331":783,"_5":31687,"_21707":53593,"_28497":53594,"_3084":53595},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3634":794,"_31331":783,"_5":31687,"_21707":53597,"_28497":53598,"_3084":53599},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3634":795,"_31331":783,"_5":31687,"_21707":53601,"_28497":53602,"_3084":53603},[],"/docs/pr-preview/pr-81/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3634":796,"_31331":783,"_21707":53605,"_5":14945,"_28497":783,"_3084":53606},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3634":797,"_31331":783,"_21707":53608,"_5":14945,"_28497":53562,"_3084":53609},[],"The audit body includes:",{"_3634":798,"_31331":783,"_21707":53611,"_5":14945,"_28497":53562,"_3084":53612},[],"input: data received by the operation;",{"_3634":799,"_31331":783,"_21707":53614,"_5":14945,"_28497":53562,"_3084":53615},[],"has\\_error: whether the service returned an error;",{"_3634":800,"_31331":783,"_21707":53617,"_5":14945,"_28497":53562,"_3084":53618},[],"output: produced result or error message;",{"_3634":801,"_31331":783,"_21707":53620,"_5":14945,"_28497":53562,"_3084":53621},[],"principals: identifiers of the principals that matched the request.",{"_3634":802,"_31331":783,"_21707":53623,"_5":14945,"_28497":53562,"_3084":53624},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3634":803,"_31331":783,"_21707":53626,"_5":14945,"_28497":53562,"_3084":53627},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3634":804,"_31331":783,"_21707":53629,"_5":14945,"_28497":53566,"_3084":53630},[],"The backend applies auditing to mutations of:",{"_3634":805,"_31331":783,"_21707":53632,"_5":14945,"_28497":53566,"_3084":53633},[],"authorities, certificates and issuance profiles;",{"_3634":806,"_31331":783,"_21707":53635,"_5":14945,"_28497":53566,"_3084":53636},[],"keys and KMS engines;",{"_3634":807,"_31331":783,"_21707":53638,"_5":14945,"_28497":53566,"_3084":53639},[],"devices and identities;",{"_3634":808,"_31331":783,"_21707":53641,"_5":14945,"_28497":53566,"_3084":53642},[],"DMSs and enrollment operations;",{"_3634":809,"_31331":783,"_21707":53644,"_5":14945,"_28497":53566,"_3084":53645},[],"validation functions and CRL;",{"_3634":810,"_31331":783,"_21707":53647,"_5":14945,"_28497":53566,"_3084":53648},[],"principals, policies and authorization grants.",{"_3634":811,"_31331":783,"_21707":53650,"_5":14945,"_28497":53566,"_3084":53651},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3634":812,"_31331":783,"_21707":53653,"_5":14945,"_28497":53570,"_3084":53654},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3634":813,"_31331":783,"_21707":53656,"_5":14945,"_28497":53570,"_3084":53657},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3634":814,"_31331":783,"_21707":53659,"_5":14945,"_28497":53570,"_3084":53660},[],"Design the consumer to:",{"_3634":815,"_31331":783,"_21707":53662,"_5":14945,"_28497":53570,"_3084":53663},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3634":816,"_31331":783,"_21707":53665,"_5":14945,"_28497":53570,"_3084":53666},[],"keep the complete CloudEvent unmodified;",{"_3634":817,"_31331":783,"_21707":53668,"_5":14945,"_28497":53570,"_3084":53669},[],"record the ingestion time and detect duplicates by ID;",{"_3634":818,"_31331":783,"_21707":53671,"_5":14945,"_28497":53570,"_3084":53672},[],"encrypt in transit and at rest;",{"_3634":819,"_31331":783,"_21707":53674,"_5":14945,"_28497":53570,"_3084":53675},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3634":820,"_31331":783,"_21707":53677,"_5":14945,"_28497":53570,"_3084":53678},[],"apply an explicit retention and legal hold policy;",{"_3634":821,"_31331":783,"_21707":53680,"_5":14945,"_28497":53570,"_3084":53681},[],"alert if it stops consuming or the pending queue grows.",{"_3634":822,"_31331":783,"_21707":53683,"_5":14945,"_28497":53574,"_3084":53684},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3634":823,"_31331":783,"_21707":53686,"_5":14945,"_28497":53574,"_3084":53687},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3634":824,"_31331":783,"_21707":53689,"_5":14945,"_28497":53582,"_3084":53690},[],"Start from the reported time and normalize every source to UTC.",{"_3634":825,"_31331":783,"_21707":53692,"_5":14945,"_28497":53586,"_3084":53693},[],"Filter by event type, service source and resource identifier.",{"_3634":826,"_31331":783,"_21707":53695,"_5":14945,"_28497":53590,"_3084":53696},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3634":827,"_31331":783,"_21707":53698,"_5":14945,"_28497":53594,"_3084":53699},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3634":828,"_31331":783,"_21707":53701,"_5":14945,"_28497":53598,"_3084":53702},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3634":829,"_31331":783,"_21707":53704,"_5":14945,"_28497":53602,"_3084":53705},[],"Generate a controlled mutation in a test environment and check that:",{"_3634":830,"_31331":783,"_21707":53707,"_5":14945,"_28497":53602,"_3084":53708},[],"a successful audit event appears;",{"_3634":831,"_31331":783,"_21707":53710,"_5":14945,"_28497":53602,"_3084":53711},[],"the principal matches the identity used;",{"_3634":832,"_31331":783,"_21707":53713,"_5":14945,"_28497":53602,"_3084":53714},[],"the consumer persists it exactly once;",{"_3634":833,"_31331":783,"_21707":53716,"_5":14945,"_28497":53602,"_3084":53717},[],"it can be retrieved by resource, actor and period;",{"_3634":834,"_31331":783,"_21707":53719,"_5":14945,"_28497":53602,"_3084":53720},[],"a consumer outage raises an alert.",{"_3634":835,"_31331":783,"_21707":53722,"_5":14945,"_28497":53602,"_3084":53723},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3634":836,"_31331":836,"_5":15305,"_3084":53725,"_31690":53726,"_21707":53727,"_28497":836},"Platform architecture",[51145,52657],[],{"_3634":837,"_31331":836,"_21707":53729,"_5":14945,"_28497":836,"_3084":53730},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3634":838,"_31331":836,"_5":31687,"_21707":53732,"_28497":53733,"_3084":53734},[],"/docs/pr-preview/pr-81/platform/concepts/architecture#control-plane","Control plane",{"_3634":839,"_31331":836,"_5":31687,"_21707":53736,"_28497":53737,"_3084":53738},[],"/docs/pr-preview/pr-81/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3634":840,"_31331":836,"_5":31687,"_21707":53740,"_28497":53741,"_3084":53742},[],"/docs/pr-preview/pr-81/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3634":841,"_31331":836,"_5":31687,"_21707":53744,"_28497":53745,"_3084":53746},[],"/docs/pr-preview/pr-81/platform/concepts/architecture#status-and-validation","Status and validation",{"_3634":842,"_31331":836,"_5":31687,"_21707":53748,"_28497":53749,"_3084":53750},[],"/docs/pr-preview/pr-81/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3634":843,"_31331":836,"_21707":53752,"_5":14945,"_28497":836,"_3084":53753},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3634":844,"_31331":836,"_21707":53755,"_5":14945,"_28497":836,"_3084":53756},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3634":845,"_31331":836,"_21707":53758,"_5":14945,"_28497":53733,"_3084":53759},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3634":846,"_31331":836,"_21707":53761,"_5":14945,"_28497":53737,"_3084":53762},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3634":847,"_31331":836,"_21707":53764,"_5":14945,"_28497":53741,"_3084":53765},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3634":848,"_31331":836,"_21707":53767,"_5":14945,"_28497":53745,"_3084":53768},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3634":849,"_31331":836,"_21707":53770,"_5":14945,"_28497":53749,"_3084":53771},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3634":850,"_31331":850,"_5":15305,"_3084":53773,"_31690":53774,"_21707":53775,"_28497":850},"How Lamassu works",[51145,52657],[],{"_3634":851,"_31331":850,"_21707":53777,"_5":14945,"_28497":850,"_3084":53778},[],"The mental model of trust, keys, certificates and devices.",{"_3634":852,"_31331":850,"_5":31687,"_21707":53780,"_28497":53781,"_3084":53782},[],"/docs/pr-preview/pr-81/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3634":853,"_31331":850,"_5":31687,"_21707":53784,"_28497":53785,"_3084":53786},[],"/docs/pr-preview/pr-81/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3634":854,"_31331":850,"_21707":53788,"_5":14945,"_28497":850,"_3084":53789},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3634":855,"_31331":850,"_21707":53791,"_5":14945,"_28497":53781,"_3084":53792},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3634":856,"_31331":850,"_21707":53794,"_5":14945,"_28497":53781,"_3084":53795},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3634":857,"_31331":850,"_21707":53797,"_5":14945,"_28497":53781,"_3084":53798},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3634":858,"_31331":850,"_21707":53800,"_5":14945,"_28497":53781,"_3084":53801},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3634":859,"_31331":850,"_21707":53803,"_5":14945,"_28497":53781,"_3084":53804},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3634":860,"_31331":850,"_21707":53806,"_5":14945,"_28497":53785,"_3084":53807},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3634":861,"_31331":850,"_21707":53809,"_5":14945,"_28497":53785,"_3084":53810},[],"A DMS relates that CA to an enrollment policy.",{"_3634":862,"_31331":850,"_21707":53812,"_5":14945,"_28497":53785,"_3084":53813},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3634":863,"_31331":850,"_21707":53815,"_5":14945,"_28497":53785,"_3084":53816},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3634":864,"_31331":850,"_21707":53818,"_5":14945,"_28497":53785,"_3084":53819},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3634":865,"_31331":850,"_21707":53821,"_5":14945,"_28497":53785,"_3084":53822},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3634":866,"_31331":850,"_21707":53824,"_5":14945,"_28497":53785,"_3084":53825},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3634":867,"_31331":867,"_5":15305,"_3084":53827,"_31690":53828,"_21707":53830,"_28497":867},"Devices and identities",[51145,52657,53829,53827],"IoT Fleets",[],{"_3634":868,"_31331":867,"_21707":53832,"_5":14945,"_28497":867,"_3084":53833},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3634":869,"_31331":867,"_5":31687,"_21707":53835,"_28497":53836,"_3084":53837},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#device-states","Device states",{"_3634":870,"_31331":867,"_5":31687,"_21707":53839,"_28497":53840,"_3084":53841},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3634":871,"_31331":867,"_5":31687,"_21707":53843,"_28497":53844,"_3084":53845},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3634":872,"_31331":867,"_5":31687,"_21707":53847,"_28497":53848,"_3084":53849},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3634":873,"_31331":867,"_5":31687,"_21707":53851,"_28497":53852,"_3084":53853},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3634":874,"_31331":867,"_5":31687,"_21707":53855,"_28497":53856,"_3084":53857},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3634":875,"_31331":867,"_5":31687,"_21707":53859,"_28497":53860,"_3084":53861},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3634":876,"_31331":867,"_5":31687,"_21707":53863,"_28497":53864,"_3084":53865},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3634":877,"_31331":867,"_5":31687,"_21707":53867,"_28497":53868,"_3084":53869},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3634":878,"_31331":867,"_5":31687,"_21707":53871,"_28497":53872,"_3084":53873},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3634":879,"_31331":867,"_5":31687,"_21707":53875,"_28497":53876,"_3084":53877},[],"/docs/pr-preview/pr-81/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3634":880,"_31331":867,"_21707":53879,"_5":14945,"_28497":867,"_3084":53880},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3634":881,"_31331":867,"_21707":53882,"_5":14945,"_28497":867,"_3084":53883},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3634":882,"_31331":867,"_21707":53885,"_5":14945,"_28497":53836,"_3084":53886},[],"Operational view",{"_3634":883,"_31331":867,"_21707":53888,"_5":14945,"_28497":53836,"_3084":53889},[],"Meaning",{"_3634":884,"_31331":867,"_21707":53891,"_5":14945,"_28497":53836,"_3084":53892},[],"**No Identity**",{"_3634":885,"_31331":867,"_21707":53894,"_5":14945,"_28497":53836,"_3084":53895},[],"A record exists without an associated identity.",{"_3634":886,"_31331":867,"_21707":53897,"_5":14945,"_28497":53836,"_3084":53898},[],"**Active**",{"_3634":887,"_31331":867,"_21707":53900,"_5":14945,"_28497":53836,"_3084":53901},[],"The slot is active; also check certificate dates, status and usages.",{"_3634":888,"_31331":867,"_21707":53903,"_5":14945,"_28497":53836,"_3084":53904},[],"**Renewal Pending**",{"_3634":889,"_31331":867,"_21707":53906,"_5":14945,"_28497":53836,"_3084":53907},[],"The identity is in the operational renewal window.",{"_3634":890,"_31331":867,"_21707":53909,"_5":14945,"_28497":53836,"_3084":53910},[],"**Expiring Soon**",{"_3634":891,"_31331":867,"_21707":53912,"_5":14945,"_28497":53836,"_3084":53913},[],"Expiration is approaching according to configured thresholds.",{"_3634":892,"_31331":867,"_21707":53915,"_5":14945,"_28497":53836,"_3084":53916},[],"**Expired**",{"_3634":893,"_31331":867,"_21707":53918,"_5":14945,"_28497":53836,"_3084":53919},[],"The identity has expired.",{"_3634":894,"_31331":867,"_21707":53921,"_5":14945,"_28497":53836,"_3084":53922},[],"**Revoked**",{"_3634":895,"_31331":867,"_21707":53924,"_5":14945,"_28497":53836,"_3084":53925},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3634":896,"_31331":867,"_21707":53927,"_5":14945,"_28497":53836,"_3084":53928},[],"**Decommissioned**",{"_3634":897,"_31331":867,"_21707":53930,"_5":14945,"_28497":53836,"_3084":53931},[],"The record is retired and ordinary updates do not restore operation.",{"_3634":898,"_31331":867,"_21707":53933,"_5":14945,"_28497":53836,"_3084":53934},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3634":899,"_31331":867,"_21707":53936,"_5":14945,"_28497":53840,"_3084":53937},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3634":900,"_31331":867,"_21707":53939,"_5":14945,"_28497":53840,"_3084":53940},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3634":901,"_31331":867,"_21707":53942,"_5":14945,"_28497":53840,"_3084":53943},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3634":902,"_31331":867,"_21707":53945,"_5":14945,"_28497":53840,"_3084":53946},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3634":903,"_31331":867,"_21707":53948,"_5":14945,"_28497":53844,"_3084":53949},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3634":904,"_31331":867,"_21707":53951,"_5":14945,"_28497":53848,"_3084":53952},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3634":905,"_31331":867,"_21707":53954,"_5":14945,"_28497":53852,"_3084":53955},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3634":906,"_31331":867,"_21707":53957,"_5":14945,"_28497":53856,"_3084":53958},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3634":907,"_31331":867,"_21707":53960,"_5":14945,"_28497":53860,"_3084":53961},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3634":908,"_31331":867,"_21707":53963,"_5":14945,"_28497":53860,"_3084":53964},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3634":909,"_31331":867,"_21707":53966,"_5":14945,"_28497":53864,"_3084":53967},[],"From **No Identity**, use **Assign Identity**:",{"_3634":910,"_31331":867,"_21707":53969,"_5":14945,"_28497":53864,"_3084":53970},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3634":911,"_31331":867,"_21707":53972,"_5":14945,"_28497":53864,"_3084":53973},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3634":912,"_31331":867,"_21707":53975,"_5":14945,"_28497":53864,"_3084":53976},[],"Confirm and read the serial, active version and history again.",{"_3634":913,"_31331":867,"_21707":53978,"_5":14945,"_28497":53864,"_3084":53979},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3634":914,"_31331":867,"_21707":53981,"_5":14945,"_28497":53864,"_3084":53982},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3634":915,"_31331":867,"_21707":53984,"_5":14945,"_28497":53868,"_3084":53985},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3634":916,"_31331":867,"_21707":53987,"_5":14945,"_28497":53868,"_3084":53988},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3634":917,"_31331":867,"_21707":53990,"_5":14945,"_28497":53868,"_3084":53991},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3634":918,"_31331":867,"_21707":53993,"_5":14945,"_28497":53872,"_3084":53994},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3634":919,"_31331":867,"_21707":53996,"_5":14945,"_28497":53872,"_3084":53997},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3634":920,"_31331":867,"_21707":53999,"_5":14945,"_28497":53872,"_3084":54000},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3634":921,"_31331":867,"_21707":54002,"_5":14945,"_28497":53872,"_3084":54003},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3634":922,"_31331":867,"_21707":54005,"_5":14945,"_28497":53876,"_3084":54006},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":923,"_31331":867,"_21707":54008,"_5":14945,"_28497":53876,"_3084":54009},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":924,"_31331":924,"_5":15305,"_3084":54011,"_31690":54012,"_21707":54014,"_28497":924},"Bootstrap identity and authentication",[51145,52657,53829,53827,54013],"Enrollment with PKI",[],{"_3634":925,"_31331":924,"_21707":54016,"_5":14945,"_28497":924,"_3084":54017},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3634":926,"_31331":924,"_5":31687,"_21707":54019,"_28497":54020,"_3084":54021},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3634":927,"_31331":924,"_5":31687,"_21707":54023,"_28497":54024,"_3084":54025},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3634":928,"_31331":924,"_5":31687,"_21707":54027,"_28497":54028,"_3084":54029},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3634":929,"_31331":924,"_5":31687,"_21707":54031,"_28497":54032,"_3084":54033},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3634":930,"_31331":924,"_5":31687,"_21707":54035,"_28497":54036,"_3084":54037},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3634":931,"_31331":924,"_21707":54039,"_5":14945,"_28497":924,"_3084":54040},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3634":932,"_31331":924,"_21707":54042,"_5":14945,"_28497":54020,"_3084":54043},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3634":933,"_31331":924,"_21707":54045,"_5":14945,"_28497":54020,"_3084":54046},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3634":934,"_31331":924,"_21707":54048,"_5":14945,"_28497":54024,"_3084":54049},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3634":935,"_31331":924,"_21707":54051,"_5":14945,"_28497":54024,"_3084":54052},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3634":936,"_31331":924,"_21707":54054,"_5":14945,"_28497":54024,"_3084":54055},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3634":937,"_31331":924,"_21707":54057,"_5":14945,"_28497":54028,"_3084":54058},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3634":938,"_31331":924,"_21707":54060,"_5":14945,"_28497":54028,"_3084":54061},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3634":939,"_31331":924,"_21707":54063,"_5":14945,"_28497":54032,"_3084":54064},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3634":940,"_31331":924,"_21707":54066,"_5":14945,"_28497":54032,"_3084":54067},[],"Example body:",{"_3634":941,"_31331":924,"_21707":54069,"_5":14945,"_28497":54032,"_3084":54070},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3634":942,"_31331":924,"_21707":54072,"_5":14945,"_28497":54032,"_3084":54073},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3634":943,"_31331":924,"_21707":54075,"_5":14945,"_28497":54032,"_3084":54076},[],"Continuation requires a successful HTTP response and JSON:",{"_3634":944,"_31331":924,"_21707":54078,"_5":14945,"_28497":54032,"_3084":54079},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3634":945,"_31331":924,"_21707":54081,"_5":14945,"_28497":54036,"_3084":54082},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3634":946,"_31331":924,"_21707":54084,"_5":14945,"_28497":54036,"_3084":54085},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3634":947,"_31331":924,"_21707":54087,"_5":14945,"_28497":54036,"_3084":54088},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3634":948,"_31331":924,"_21707":54090,"_5":14945,"_28497":54036,"_3084":54091},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3634":949,"_31331":949,"_5":15305,"_3084":54093,"_31690":54094,"_21707":54095,"_28497":949},"Configure and operate the DMS",[51145,52657,53829,53827,54013],[],{"_3634":950,"_31331":949,"_21707":54097,"_5":14945,"_28497":949,"_3084":54098},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3634":951,"_31331":949,"_5":31687,"_21707":54100,"_28497":54101,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3634":952,"_31331":949,"_5":31687,"_21707":54103,"_28497":54104,"_3084":54105},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3634":953,"_31331":949,"_5":31687,"_21707":54107,"_28497":54108,"_3084":54109},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3634":954,"_31331":949,"_5":31687,"_21707":54111,"_28497":54112,"_3084":54113},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3634":955,"_31331":949,"_5":31687,"_21707":54115,"_28497":54116,"_3084":54117},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3634":956,"_31331":949,"_5":31687,"_21707":54119,"_28497":54120,"_3084":54121},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3634":957,"_31331":949,"_5":31687,"_21707":54123,"_28497":54124,"_3084":54125},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3634":958,"_31331":949,"_5":31687,"_21707":54127,"_28497":54128,"_3084":54129},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3634":959,"_31331":949,"_5":31687,"_21707":54131,"_28497":54132,"_3084":54133},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3634":960,"_31331":949,"_5":31687,"_21707":54135,"_28497":54136,"_3084":54137},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3634":961,"_31331":949,"_5":31687,"_21707":54139,"_28497":54140,"_3084":54141},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3634":962,"_31331":949,"_5":31687,"_21707":54143,"_28497":54144,"_3084":54145},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3634":963,"_31331":949,"_5":31687,"_21707":54147,"_28497":54148,"_3084":54149},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3634":964,"_31331":949,"_5":31687,"_21707":54151,"_28497":54152,"_3084":54153},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3634":965,"_31331":949,"_5":31687,"_21707":54155,"_28497":54156,"_3084":54157},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3634":966,"_31331":949,"_5":31687,"_21707":54159,"_28497":54160,"_3084":54161},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3634":967,"_31331":949,"_5":31687,"_21707":54163,"_28497":54164,"_3084":54165},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3634":968,"_31331":949,"_5":31687,"_21707":54167,"_28497":54168,"_3084":54169},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3634":969,"_31331":949,"_21707":54171,"_5":14945,"_28497":949,"_3084":54172},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3634":970,"_31331":949,"_21707":54174,"_5":14945,"_28497":54101,"_3084":54175},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3634":971,"_31331":949,"_21707":54177,"_5":14945,"_28497":54101,"_3084":54178},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3634":972,"_31331":949,"_21707":54180,"_5":14945,"_28497":54108,"_3084":54181},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3634":973,"_31331":949,"_21707":54183,"_5":14945,"_28497":54112,"_3084":54184},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3634":974,"_31331":949,"_21707":54186,"_5":14945,"_28497":54116,"_3084":54187},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3634":975,"_31331":949,"_21707":54189,"_5":14945,"_28497":54120,"_3084":54190},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3634":976,"_31331":949,"_21707":54192,"_5":14945,"_28497":54124,"_3084":54193},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3634":977,"_31331":949,"_21707":54195,"_5":14945,"_28497":54132,"_3084":54196},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3634":978,"_31331":949,"_21707":54198,"_5":14945,"_28497":54132,"_3084":54199},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3634":979,"_31331":949,"_21707":54201,"_5":14945,"_28497":54136,"_3084":54202},[],"`settings.enrollment_settings` field",{"_3634":980,"_31331":949,"_21707":54204,"_5":14945,"_28497":54136,"_3084":54205},[],"Decision",{"_3634":981,"_31331":949,"_21707":54207,"_5":14945,"_28497":54136,"_3084":54208},[],"`protocol`",{"_3634":982,"_31331":949,"_21707":54210,"_5":14945,"_28497":54136,"_3084":54211},[],"`EST_RFC7030` for these operations.",{"_3634":983,"_31331":949,"_21707":54213,"_5":14945,"_28497":54136,"_3084":54214},[],"`enrollment_ca`",{"_3634":984,"_31331":949,"_21707":54216,"_5":14945,"_28497":54136,"_3084":54217},[],"ID of the signing CA.",{"_3634":985,"_31331":949,"_21707":54219,"_5":14945,"_28497":54136,"_3084":54220},[],"`verify_csr_signature`",{"_3634":986,"_31331":949,"_21707":54222,"_5":14945,"_28497":54136,"_3084":54223},[],"Keep `true` to verify CSR key possession.",{"_3634":987,"_31331":949,"_21707":54225,"_5":14945,"_28497":54136,"_3084":54226},[],"`enable_replaceable_enrollment`",{"_3634":988,"_31331":949,"_21707":54228,"_5":14945,"_28497":54136,"_3084":54229},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3634":989,"_31331":949,"_21707":54231,"_5":14945,"_28497":54136,"_3084":54232},[],"`est_rfc7030_settings.auth_mode`",{"_3634":990,"_31331":949,"_21707":54234,"_5":14945,"_28497":54136,"_3084":54235},[],"One of the four authentication modes.",{"_3634":991,"_31331":949,"_21707":54237,"_5":14945,"_28497":54136,"_3084":54238},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3634":992,"_31331":949,"_21707":54240,"_5":14945,"_28497":54140,"_3084":54241},[],"The blocks are independent:",{"_3634":993,"_31331":949,"_21707":54243,"_5":14945,"_28497":54140,"_3084":54244},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3634":994,"_31331":949,"_21707":54246,"_5":14945,"_28497":54140,"_3084":54247},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3634":995,"_31331":949,"_21707":54249,"_5":14945,"_28497":54140,"_3084":54250},[],"`auth_mode`",{"_3634":996,"_31331":949,"_21707":54252,"_5":14945,"_28497":54140,"_3084":54253},[],"Control applied in the configured operation",{"_3634":997,"_31331":949,"_21707":54255,"_5":14945,"_28497":54140,"_3084":54256},[],"`CLIENT_CERTIFICATE`",{"_3634":998,"_31331":949,"_21707":54258,"_5":14945,"_28497":54140,"_3084":54259},[],"Presented certificate validation.",{"_3634":999,"_31331":949,"_21707":54261,"_5":14945,"_28497":54140,"_3084":54262},[],"`EXTERNAL_WEBHOOK`",{"_3634":1000,"_31331":949,"_21707":54264,"_5":14945,"_28497":54140,"_3084":54265},[],"Configured webhook authorization.",{"_3634":1001,"_31331":949,"_21707":54267,"_5":14945,"_28497":54140,"_3084":54268},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3634":1002,"_31331":949,"_21707":54270,"_5":14945,"_28497":54140,"_3084":54271},[],"Certificate validation followed by webhook approval.",{"_3634":1003,"_31331":949,"_21707":54273,"_5":14945,"_28497":54140,"_3084":54274},[],"`NO_AUTH`",{"_3634":1004,"_31331":949,"_21707":54276,"_5":14945,"_28497":54140,"_3084":54277},[],"No DMS requester authentication.",{"_3634":1005,"_31331":949,"_21707":54279,"_5":14945,"_28497":54140,"_3084":54280},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3634":1006,"_31331":949,"_21707":54282,"_5":14945,"_28497":54140,"_3084":54283},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3634":1007,"_31331":949,"_21707":54285,"_5":14945,"_28497":54140,"_3084":54286},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3634":1008,"_31331":949,"_21707":54288,"_5":14945,"_28497":54140,"_3084":54289},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3634":1009,"_31331":949,"_21707":54291,"_5":14945,"_28497":54140,"_3084":54292},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3634":1010,"_31331":949,"_21707":54294,"_5":14945,"_28497":54144,"_3084":54295},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3634":1011,"_31331":949,"_21707":54297,"_5":14945,"_28497":54144,"_3084":54298},[],"`external_webhook_settings` field",{"_3634":1012,"_31331":949,"_21707":54300,"_5":14945,"_28497":54144,"_3084":54205},[],{"_3634":1013,"_31331":949,"_21707":54302,"_5":14945,"_28497":54144,"_3084":54303},[],"`url`",{"_3634":1014,"_31331":949,"_21707":54305,"_5":14945,"_28497":54144,"_3084":54306},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3634":1015,"_31331":949,"_21707":54308,"_5":14945,"_28497":54144,"_3084":54309},[],"`method`",{"_3634":1016,"_31331":949,"_21707":54311,"_5":14945,"_28497":54144,"_3084":54312},[],"`POST` or `PUT`; `POST` by default.",{"_3634":1017,"_31331":949,"_21707":54314,"_5":14945,"_28497":54144,"_3084":54315},[],"`name`",{"_3634":1018,"_31331":949,"_21707":54317,"_5":14945,"_28497":54144,"_3084":54318},[],"Label used in service logs.",{"_3634":1019,"_31331":949,"_21707":54320,"_5":14945,"_28497":54144,"_3084":54321},[],"`config.auth_mode`",{"_3634":1020,"_31331":949,"_21707":54323,"_5":14945,"_28497":54144,"_3084":54324},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3634":1021,"_31331":949,"_21707":54326,"_5":14945,"_28497":54144,"_3084":54327},[],"`config.log_level`",{"_3634":1022,"_31331":949,"_21707":54329,"_5":14945,"_28497":54144,"_3084":54330},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3634":1023,"_31331":949,"_21707":54332,"_5":14945,"_28497":54144,"_3084":54333},[],"`config.apikey_options`",{"_3634":1024,"_31331":949,"_21707":54335,"_5":14945,"_28497":54144,"_3084":54336},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3634":1025,"_31331":949,"_21707":54338,"_5":14945,"_28497":54144,"_3084":54339},[],"`config.jwt_options`",{"_3634":1026,"_31331":949,"_21707":54341,"_5":14945,"_28497":54144,"_3084":54342},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3634":1027,"_31331":949,"_21707":54344,"_5":14945,"_28497":54144,"_3084":54345},[],"`config.mtls_options`",{"_3634":1028,"_31331":949,"_21707":54347,"_5":14945,"_28497":54144,"_3084":54348},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3634":1029,"_31331":949,"_21707":54350,"_5":14945,"_28497":54144,"_3084":54351},[],"`config.insecure_skip_verify`",{"_3634":1030,"_31331":949,"_21707":54353,"_5":14945,"_28497":54144,"_3084":54354},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3634":1031,"_31331":949,"_21707":54356,"_5":14945,"_28497":54144,"_3084":54357},[],"`config.call_timeout`",{"_3634":1032,"_31331":949,"_21707":54359,"_5":14945,"_28497":54144,"_3084":54360},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3634":1033,"_31331":949,"_21707":54362,"_5":14945,"_28497":54144,"_3084":54363},[],"Rules for that configuration:",{"_3634":1034,"_31331":949,"_21707":54365,"_5":14945,"_28497":54144,"_3084":54366},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3634":1035,"_31331":949,"_21707":54368,"_5":14945,"_28497":54144,"_3084":54369},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3634":1036,"_31331":949,"_21707":54371,"_5":14945,"_28497":54144,"_3084":54372},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3634":1037,"_31331":949,"_21707":54374,"_5":14945,"_28497":54144,"_3084":54375},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3634":1038,"_31331":949,"_21707":54377,"_5":14945,"_28497":54144,"_3084":54378},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3634":1039,"_31331":949,"_21707":54380,"_5":14945,"_28497":54144,"_3084":54381},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3634":1040,"_31331":949,"_21707":54383,"_5":14945,"_28497":54144,"_3084":54384},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3634":1041,"_31331":949,"_21707":54386,"_5":14945,"_28497":54144,"_3084":54387},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3634":1042,"_31331":949,"_21707":54389,"_5":14945,"_28497":54144,"_3084":54390},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3634":1043,"_31331":949,"_21707":54392,"_5":14945,"_28497":54148,"_3084":54393},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3634":1044,"_31331":949,"_21707":54395,"_5":14945,"_28497":54152,"_3084":54396},[],"`settings.reenrollment_settings` field",{"_3634":1045,"_31331":949,"_21707":54398,"_5":14945,"_28497":54152,"_3084":51535},[],{"_3634":1046,"_31331":949,"_21707":54400,"_5":14945,"_28497":54152,"_3084":54401},[],"`reenrollment_delta`",{"_3634":1047,"_31331":949,"_21707":54403,"_5":14945,"_28497":54152,"_3084":54404},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3634":1048,"_31331":949,"_21707":54406,"_5":14945,"_28497":54152,"_3084":54407},[],"`preventive_delta`",{"_3634":1049,"_31331":949,"_21707":54409,"_5":14945,"_28497":54152,"_3084":54410},[],"Preventive operational monitoring threshold.",{"_3634":1050,"_31331":949,"_21707":54412,"_5":14945,"_28497":54152,"_3084":54413},[],"`critical_delta`",{"_3634":1051,"_31331":949,"_21707":54415,"_5":14945,"_28497":54152,"_3084":54416},[],"Critical operational monitoring threshold.",{"_3634":1052,"_31331":949,"_21707":54418,"_5":14945,"_28497":54152,"_3084":54419},[],"`enable_expired_renewal`",{"_3634":1053,"_31331":949,"_21707":54421,"_5":14945,"_28497":54152,"_3084":54422},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3634":1054,"_31331":949,"_21707":54424,"_5":14945,"_28497":54152,"_3084":54425},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3634":1055,"_31331":949,"_21707":54427,"_5":14945,"_28497":54152,"_3084":54428},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3634":1056,"_31331":949,"_21707":54430,"_5":14945,"_28497":54152,"_3084":54431},[],"`revoke_on_reenrollment`",{"_3634":1057,"_31331":949,"_21707":54433,"_5":14945,"_28497":54152,"_3084":54434},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3634":1058,"_31331":949,"_21707":54436,"_5":14945,"_28497":54152,"_3084":54437},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3634":1059,"_31331":949,"_21707":54439,"_5":14945,"_28497":54156,"_3084":54440},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3634":1060,"_31331":949,"_21707":54442,"_5":14945,"_28497":54160,"_3084":51529},[],{"_3634":1061,"_31331":949,"_21707":54444,"_5":14945,"_28497":54160,"_3084":54445},[],"Published material",{"_3634":1062,"_31331":949,"_21707":54447,"_5":14945,"_28497":54160,"_3084":54448},[],"**Include Lamassu System CA**",{"_3634":1063,"_31331":949,"_21707":54450,"_5":14945,"_28497":54160,"_3084":54451},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3634":1064,"_31331":949,"_21707":54453,"_5":14945,"_28497":54160,"_3084":54454},[],"**Include Enrollment CA**",{"_3634":1065,"_31331":949,"_21707":54456,"_5":14945,"_28497":54160,"_3084":54457},[],"Selected issuing CA certificate.",{"_3634":1066,"_31331":949,"_21707":54459,"_5":14945,"_28497":54160,"_3084":54460},[],"**Managed CAs**",{"_3634":1067,"_31331":949,"_21707":54462,"_5":14945,"_28497":54160,"_3084":54463},[],"Explicitly selected CA certificates.",{"_3634":1068,"_31331":949,"_21707":54465,"_5":14945,"_28497":54160,"_3084":54466},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3634":1069,"_31331":949,"_21707":54468,"_5":14945,"_28497":54164,"_3084":54469},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3634":1070,"_31331":949,"_21707":54471,"_5":14945,"_28497":54164,"_3084":54472},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3634":1071,"_31331":949,"_21707":54474,"_5":14945,"_28497":54164,"_3084":54475},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3634":1072,"_31331":949,"_21707":54477,"_5":14945,"_28497":54168,"_3084":54478},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3634":1073,"_31331":1073,"_5":15305,"_3084":54480,"_31690":54481,"_21707":54482,"_28497":1073},"Integrate the EST client",[51145,52657,53829,53827,54013],[],{"_3634":1074,"_31331":1073,"_21707":54484,"_5":14945,"_28497":1073,"_3084":54485},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3634":1075,"_31331":1073,"_5":31687,"_21707":54487,"_28497":54488,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3634":1076,"_31331":1073,"_5":31687,"_21707":54490,"_28497":54491,"_3084":54492},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3634":1077,"_31331":1073,"_5":31687,"_21707":54494,"_28497":54495,"_3084":54496},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3634":1078,"_31331":1073,"_5":31687,"_21707":54498,"_28497":54499,"_3084":54500},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3634":1079,"_31331":1073,"_5":31687,"_21707":54502,"_28497":54503,"_3084":54504},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3634":1080,"_31331":1073,"_5":31687,"_21707":54506,"_28497":54507,"_3084":54508},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3634":1081,"_31331":1073,"_21707":54510,"_5":14945,"_28497":1073,"_3084":54511},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3634":1082,"_31331":1073,"_21707":54513,"_5":14945,"_28497":54488,"_3084":54514},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3634":1083,"_31331":1073,"_21707":54516,"_5":14945,"_28497":54488,"_3084":54517},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3634":1084,"_31331":1073,"_21707":54519,"_5":14945,"_28497":54488,"_3084":54520},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3634":1085,"_31331":1073,"_21707":54522,"_5":14945,"_28497":54491,"_3084":54523},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3634":1086,"_31331":1073,"_21707":54525,"_5":14945,"_28497":54491,"_3084":54526},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3634":1087,"_31331":1073,"_21707":54528,"_5":14945,"_28497":54495,"_3084":54529},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3634":1088,"_31331":1073,"_21707":54531,"_5":14945,"_28497":54495,"_3084":54532},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3634":1089,"_31331":1073,"_21707":54534,"_5":14945,"_28497":54499,"_3084":54535},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3634":1090,"_31331":1073,"_21707":54537,"_5":14945,"_28497":54499,"_3084":54538},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3634":1091,"_31331":1073,"_21707":54540,"_5":14945,"_28497":54503,"_3084":54541},[],"For a root that issues directly:",{"_3634":1092,"_31331":1073,"_21707":54543,"_5":14945,"_28497":54503,"_3084":54544},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3634":1093,"_31331":1073,"_21707":54546,"_5":14945,"_28497":54503,"_3084":54547},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3634":1094,"_31331":1073,"_21707":54549,"_5":14945,"_28497":54507,"_3084":54550},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3634":1095,"_31331":1095,"_5":15305,"_3084":54552,"_31690":54553,"_21707":54554,"_28497":1095},"EST reference",[51145,52657,53829,53827,54013],[],{"_3634":1096,"_31331":1095,"_21707":54556,"_5":14945,"_28497":1095,"_3084":54557},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3634":1097,"_31331":1095,"_5":31687,"_21707":54559,"_28497":54560,"_3084":54561},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3634":1098,"_31331":1095,"_5":31687,"_21707":54563,"_28497":54564,"_3084":23510},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3634":1099,"_31331":1095,"_5":31687,"_21707":54566,"_28497":54567,"_3084":27024},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3634":1100,"_31331":1095,"_5":31687,"_21707":54569,"_28497":54570,"_3084":27031},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3634":1101,"_31331":1095,"_5":31687,"_21707":54572,"_28497":54573,"_3084":26288},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3634":1102,"_31331":1095,"_5":31687,"_21707":54575,"_28497":54576,"_3084":54577},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3634":1103,"_31331":1095,"_5":31687,"_21707":54579,"_28497":54580,"_3084":54581},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3634":1104,"_31331":1095,"_5":31687,"_21707":54583,"_28497":54584,"_3084":54585},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3634":1105,"_31331":1095,"_21707":54587,"_5":14945,"_28497":1095,"_3084":54588},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3634":1106,"_31331":1095,"_21707":54590,"_5":14945,"_28497":54560,"_3084":54591},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3634":1107,"_31331":1095,"_21707":54593,"_5":14945,"_28497":54560,"_3084":54594},[],"Operation",{"_3634":1108,"_31331":1095,"_21707":54596,"_5":14945,"_28497":54560,"_3084":54597},[],"Method",{"_3634":1109,"_31331":1095,"_21707":54599,"_5":14945,"_28497":54560,"_3084":54600},[],"Authentication and condition",{"_3634":1110,"_31331":1095,"_21707":54602,"_5":14945,"_28497":54560,"_3084":54603},[],"`/cacerts`",{"_3634":1111,"_31331":1095,"_21707":54605,"_5":14945,"_28497":54560,"_3084":54606},[],"GET",{"_3634":1112,"_31331":1095,"_21707":54608,"_5":14945,"_28497":54560,"_3084":54609},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3634":1113,"_31331":1095,"_21707":54611,"_5":14945,"_28497":54560,"_3084":54612},[],"`/simpleenroll`",{"_3634":1114,"_31331":1095,"_21707":54614,"_5":14945,"_28497":54560,"_3084":54615},[],"POST",{"_3634":1115,"_31331":1095,"_21707":54617,"_5":14945,"_28497":54560,"_3084":54618},[],"Initial authentication and DMS registration/replacement policy.",{"_3634":1116,"_31331":1095,"_21707":54620,"_5":14945,"_28497":54560,"_3084":54621},[],"`/simplereenroll`",{"_3634":1117,"_31331":1095,"_21707":54623,"_5":14945,"_28497":54560,"_3084":54615},[],{"_3634":1118,"_31331":1095,"_21707":54625,"_5":14945,"_28497":54560,"_3084":54626},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3634":1119,"_31331":1095,"_21707":54628,"_5":14945,"_28497":54560,"_3084":54629},[],"`/serverkeygen`",{"_3634":1120,"_31331":1095,"_21707":54631,"_5":14945,"_28497":54560,"_3084":54615},[],{"_3634":1121,"_31331":1095,"_21707":54633,"_5":14945,"_28497":54560,"_3084":54634},[],"Initial authentication and admission; server generation enabled.",{"_3634":1122,"_31331":1095,"_21707":54636,"_5":14945,"_28497":54560,"_3084":54637},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3634":1123,"_31331":1095,"_21707":54639,"_5":14945,"_28497":54564,"_3084":54640},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3634":1124,"_31331":1095,"_21707":54642,"_5":14945,"_28497":54564,"_3084":54643},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3634":1125,"_31331":1095,"_21707":54645,"_5":14945,"_28497":54567,"_3084":54646},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3634":1126,"_31331":1095,"_21707":54648,"_5":14945,"_28497":54567,"_3084":54649},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3634":1127,"_31331":1095,"_21707":54651,"_5":14945,"_28497":54570,"_3084":54652},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3634":1128,"_31331":1095,"_21707":54654,"_5":14945,"_28497":54570,"_3084":54655},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3634":1129,"_31331":1095,"_21707":54657,"_5":14945,"_28497":54573,"_3084":54658},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3634":1130,"_31331":1095,"_21707":54660,"_5":14945,"_28497":54573,"_3084":54661},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3634":1131,"_31331":1095,"_21707":54663,"_5":14945,"_28497":54576,"_3084":54664},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3634":1132,"_31331":1095,"_21707":54666,"_5":14945,"_28497":54576,"_3084":54667},[],"Part",{"_3634":1133,"_31331":1095,"_21707":54669,"_5":14945,"_28497":54576,"_3084":54670},[],"Content after decoding its Base64",{"_3634":1134,"_31331":1095,"_21707":54672,"_5":14945,"_28497":54576,"_3084":54673},[],"`application/pkcs8`",{"_3634":1135,"_31331":1095,"_21707":54675,"_5":14945,"_28497":54576,"_3084":54676},[],"Unencrypted DER PKCS#8 private key.",{"_3634":1136,"_31331":1095,"_21707":54678,"_5":14945,"_28497":54576,"_3084":54679},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3634":1137,"_31331":1095,"_21707":54681,"_5":14945,"_28497":54576,"_3084":54682},[],"DER PKCS#7 containing the issued certificate.",{"_3634":1138,"_31331":1095,"_21707":54684,"_5":14945,"_28497":54576,"_3084":54685},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3634":1139,"_31331":1095,"_21707":54687,"_5":14945,"_28497":54580,"_3084":54688},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3634":1140,"_31331":1095,"_21707":54690,"_5":14945,"_28497":54580,"_3084":54691},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3634":1141,"_31331":1095,"_21707":54693,"_5":14945,"_28497":54580,"_3084":54694},[],"Convert and check the result:",{"_3634":1142,"_31331":1095,"_21707":54696,"_5":14945,"_28497":54580,"_3084":54697},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3634":1143,"_31331":1095,"_21707":54699,"_5":14945,"_28497":54584,"_3084":54700},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3634":1144,"_31331":1095,"_21707":54702,"_5":14945,"_28497":54584,"_3084":54703},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3634":1145,"_31331":1145,"_5":15305,"_3084":54013,"_31690":54705,"_21707":54706,"_28497":1145},[51145,52657,53829,53827,54013],[],{"_3634":1146,"_31331":1145,"_21707":54708,"_5":14945,"_28497":1145,"_3084":54709},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3634":1147,"_31331":1145,"_5":31687,"_21707":54711,"_28497":54712,"_3084":54713},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3634":1148,"_31331":1145,"_5":31687,"_21707":54715,"_28497":54716,"_3084":54717},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3634":1149,"_31331":1145,"_5":31687,"_21707":54719,"_28497":54720,"_3084":54721},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3634":1150,"_31331":1145,"_21707":54723,"_5":14945,"_28497":1145,"_3084":54724},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3634":1151,"_31331":1145,"_21707":54726,"_5":14945,"_28497":54712,"_3084":54727},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3634":1152,"_31331":1145,"_21707":54729,"_5":14945,"_28497":54712,"_3084":54730},[],"The integrator installs initial EST server trust and an admission credential.",{"_3634":1153,"_31331":1145,"_21707":54732,"_5":14945,"_28497":54712,"_3084":54733},[],"The client requests an identity for its `Device ID` through EST.",{"_3634":1154,"_31331":1145,"_21707":54735,"_5":14945,"_28497":54712,"_3084":54736},[],"Certificate, device binding and key/certificate installation are checked.",{"_3634":1155,"_31331":1145,"_21707":54738,"_5":14945,"_28497":54712,"_3084":54739},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3634":1156,"_31331":1145,"_21707":54741,"_5":14945,"_28497":54712,"_3084":54742},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3634":1157,"_31331":1145,"_21707":54744,"_5":14945,"_28497":54716,"_3084":54745},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3634":1158,"_31331":1145,"_21707":54747,"_5":14945,"_28497":54716,"_3084":54748},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":1159,"_31331":1145,"_21707":54750,"_5":14945,"_28497":54716,"_3084":54751},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3634":1160,"_31331":1145,"_21707":54753,"_5":14945,"_28497":54716,"_3084":54754},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3634":1161,"_31331":1145,"_21707":54756,"_5":14945,"_28497":54720,"_3084":54757},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":1162,"_31331":1145,"_21707":54759,"_5":14945,"_28497":54720,"_3084":54760},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":1163,"_31331":1145,"_21707":54762,"_5":14945,"_28497":54720,"_3084":54763},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3634":1164,"_31331":1145,"_21707":54765,"_5":14945,"_28497":54720,"_3084":54766},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3634":1165,"_31331":1145,"_21707":54768,"_5":14945,"_28497":54720,"_3084":54769},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3634":1166,"_31331":1166,"_5":15305,"_3084":54771,"_31690":54772,"_21707":54773,"_28497":1166},"Provisioning strategies",[51145,52657,53829,53827,54013],[],{"_3634":1167,"_31331":1166,"_21707":54775,"_5":14945,"_28497":1166,"_3084":54776},[],"Choose device registration, identity authorization and key generation.",{"_3634":1168,"_31331":1166,"_5":31687,"_21707":54778,"_28497":54779,"_3084":54780},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3634":1169,"_31331":1166,"_5":31687,"_21707":54782,"_28497":54783,"_3084":54784},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3634":1170,"_31331":1166,"_5":31687,"_21707":54786,"_28497":54787,"_3084":54788},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3634":1171,"_31331":1166,"_5":31687,"_21707":54790,"_28497":54791,"_3084":54792},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3634":1172,"_31331":1166,"_5":31687,"_21707":54794,"_28497":54795,"_3084":54796},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3634":1173,"_31331":1166,"_21707":54798,"_5":14945,"_28497":1166,"_3084":54799},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3634":1174,"_31331":1166,"_21707":54801,"_5":14945,"_28497":54779,"_3084":54802},[],"Path",{"_3634":1175,"_31331":1166,"_21707":54804,"_5":14945,"_28497":54779,"_3084":54805},[],"When the device exists",{"_3634":1176,"_31331":1166,"_21707":54807,"_5":14945,"_28497":54779,"_3084":54808},[],"What to check",{"_3634":1177,"_31331":1166,"_21707":54810,"_5":14945,"_28497":54779,"_3084":54811},[],"Manual assignment",{"_3634":1178,"_31331":1166,"_21707":54813,"_5":14945,"_28497":54779,"_3084":54814},[],"An operator creates it before associating a certificate.",{"_3634":1179,"_31331":1166,"_21707":54816,"_5":14945,"_28497":54779,"_3084":54817},[],"ID, owning DMS, certificate CN and bound serial.",{"_3634":1180,"_31331":1166,"_21707":54819,"_5":14945,"_28497":54779,"_3084":54820},[],"EST with `JITP`",{"_3634":1181,"_31331":1166,"_21707":54822,"_5":14945,"_28497":54779,"_3084":54823},[],"Created for an unknown CN during `/simpleenroll`.",{"_3634":1182,"_31331":1166,"_21707":54825,"_5":14945,"_28497":54779,"_3084":54826},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3634":1183,"_31331":1166,"_21707":54828,"_5":14945,"_28497":54779,"_3084":54829},[],"EST with `PRE_REGISTRATION`",{"_3634":1184,"_31331":1166,"_21707":54831,"_5":14945,"_28497":54779,"_3084":54832},[],"Must exist before `/simpleenroll`.",{"_3634":1185,"_31331":1166,"_21707":54834,"_5":14945,"_28497":54779,"_3084":54835},[],"Approved record, same DMS and replacement conditions for your version.",{"_3634":1186,"_31331":1166,"_21707":54837,"_5":14945,"_28497":54779,"_3084":54838},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3634":1187,"_31331":1166,"_21707":54840,"_5":14945,"_28497":54779,"_3084":54841},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3634":1188,"_31331":1166,"_21707":54843,"_5":14945,"_28497":54783,"_3084":54844},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3634":1189,"_31331":1166,"_21707":54846,"_5":14945,"_28497":54783,"_3084":54847},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3634":1190,"_31331":1166,"_21707":54849,"_5":14945,"_28497":54783,"_3084":54850},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3634":1191,"_31331":1166,"_21707":54852,"_5":14945,"_28497":54787,"_3084":54853},[],"Decide initial enrollment and re-enrollment separately:",{"_3634":1192,"_31331":1166,"_21707":54855,"_5":14945,"_28497":54787,"_3084":54856},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3634":1193,"_31331":1166,"_21707":54858,"_5":14945,"_28497":54787,"_3084":54859},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3634":1194,"_31331":1166,"_21707":54861,"_5":14945,"_28497":54787,"_3084":54862},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3634":1195,"_31331":1166,"_21707":54864,"_5":14945,"_28497":54787,"_3084":54865},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3634":1196,"_31331":1166,"_21707":54867,"_5":14945,"_28497":54787,"_3084":54868},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3634":1197,"_31331":1166,"_21707":54870,"_5":14945,"_28497":54791,"_3084":51529},[],{"_3634":1198,"_31331":1166,"_21707":54872,"_5":14945,"_28497":54791,"_3084":54873},[],"Material crossing EST",{"_3634":1199,"_31331":1166,"_21707":54875,"_5":14945,"_28497":54791,"_3084":54876},[],"Device-generated key",{"_3634":1200,"_31331":1166,"_21707":54878,"_5":14945,"_28497":54791,"_3084":54879},[],"Public CSR and certificate; the key stays on the client.",{"_3634":1201,"_31331":1166,"_21707":54881,"_5":14945,"_28497":54791,"_3084":54882},[],"Existing device key",{"_3634":1202,"_31331":1166,"_21707":54884,"_5":14945,"_28497":54791,"_3084":54885},[],"CSR signed with that key and a new certificate.",{"_3634":1203,"_31331":1166,"_21707":54887,"_5":14945,"_28497":54791,"_3084":54157},[],{"_3634":1204,"_31331":1166,"_21707":54889,"_5":14945,"_28497":54791,"_3084":54890},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3634":1205,"_31331":1166,"_21707":54892,"_5":14945,"_28497":54791,"_3084":54893},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3634":1206,"_31331":1166,"_21707":54895,"_5":14945,"_28497":54795,"_3084":54896},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3634":1207,"_31331":1207,"_5":15305,"_3084":54898,"_31690":54899,"_21707":54900,"_28497":1207},"Renewal and recovery",[51145,52657,53829,53827,54013],[],{"_3634":1208,"_31331":1207,"_21707":54902,"_5":14945,"_28497":1207,"_3084":54903},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3634":1209,"_31331":1207,"_5":31687,"_21707":54905,"_28497":54906,"_3084":54907},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3634":1210,"_31331":1207,"_5":31687,"_21707":54909,"_28497":54910,"_3084":54911},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3634":1211,"_31331":1207,"_5":31687,"_21707":54913,"_28497":54914,"_3084":54915},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3634":1212,"_31331":1207,"_5":31687,"_21707":54917,"_28497":54918,"_3084":54919},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3634":1213,"_31331":1207,"_5":31687,"_21707":54921,"_28497":54922,"_3084":54923},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3634":1214,"_31331":1207,"_21707":54925,"_5":14945,"_28497":1207,"_3084":54926},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3634":1215,"_31331":1207,"_21707":54928,"_5":14945,"_28497":54906,"_3084":54929},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3634":1216,"_31331":1207,"_21707":54931,"_5":14945,"_28497":54906,"_3084":54932},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3634":1217,"_31331":1207,"_21707":54934,"_5":14945,"_28497":54906,"_3084":54935},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3634":1218,"_31331":1207,"_21707":54937,"_5":14945,"_28497":54906,"_3084":54938},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3634":1219,"_31331":1207,"_21707":54940,"_5":14945,"_28497":54910,"_3084":54941},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3634":1220,"_31331":1207,"_21707":54943,"_5":14945,"_28497":54910,"_3084":54944},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3634":1221,"_31331":1207,"_21707":54946,"_5":14945,"_28497":54914,"_3084":54947},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3634":1222,"_31331":1207,"_21707":54949,"_5":14945,"_28497":54914,"_3084":54950},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3634":1223,"_31331":1207,"_21707":54952,"_5":14945,"_28497":54914,"_3084":54953},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3634":1224,"_31331":1207,"_21707":54955,"_5":14945,"_28497":54918,"_3084":54956},[],"Situation",{"_3634":1225,"_31331":1207,"_21707":54958,"_5":14945,"_28497":54918,"_3084":54959},[],"Procedure",{"_3634":1226,"_31331":1207,"_21707":54961,"_5":14945,"_28497":54918,"_3084":54962},[],"Valid certificate, outside the window",{"_3634":1227,"_31331":1207,"_21707":54964,"_5":14945,"_28497":54918,"_3084":54965},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3634":1228,"_31331":1207,"_21707":54967,"_5":14945,"_28497":54918,"_3084":54968},[],"Expired certificate, key available",{"_3634":1229,"_31331":1207,"_21707":54970,"_5":14945,"_28497":54918,"_3084":54971},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3634":1230,"_31331":1207,"_21707":54973,"_5":14945,"_28497":54918,"_3084":54974},[],"Renewal through webhook or `NO_AUTH`",{"_3634":1231,"_31331":1207,"_21707":54976,"_5":14945,"_28497":54918,"_3084":54977},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3634":1232,"_31331":1207,"_21707":54979,"_5":14945,"_28497":54918,"_3084":54980},[],"Lost or inaccessible key",{"_3634":1233,"_31331":1207,"_21707":54982,"_5":14945,"_28497":54918,"_3084":54983},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3634":1234,"_31331":1207,"_21707":54985,"_5":14945,"_28497":54918,"_3084":54986},[],"Current identity revoked",{"_3634":1235,"_31331":1207,"_21707":54988,"_5":14945,"_28497":54918,"_3084":54989},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3634":1236,"_31331":1207,"_21707":54991,"_5":14945,"_28497":54918,"_3084":54992},[],"Device without an identity",{"_3634":1237,"_31331":1207,"_21707":54994,"_5":14945,"_28497":54918,"_3084":54995},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3634":1238,"_31331":1207,"_21707":54997,"_5":14945,"_28497":54918,"_3084":54998},[],"Retired device",{"_3634":1239,"_31331":1207,"_21707":55000,"_5":14945,"_28497":54918,"_3084":55001},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3634":1240,"_31331":1207,"_21707":55003,"_5":14945,"_28497":54918,"_3084":55004},[],"Timeout, HTTP 500 or installation failure",{"_3634":1241,"_31331":1207,"_21707":55006,"_5":14945,"_28497":54918,"_3084":55007},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3634":1242,"_31331":1207,"_21707":55009,"_5":14945,"_28497":54922,"_3084":55010},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3634":1243,"_31331":1207,"_21707":55012,"_5":14945,"_28497":54922,"_3084":55013},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3634":1244,"_31331":1244,"_5":15305,"_3084":55015,"_31690":55016,"_21707":55017,"_28497":1244},"Enrollment troubleshooting",[51145,52657,53829,53827,54013],[],{"_3634":1245,"_31331":1244,"_21707":55019,"_5":14945,"_28497":1244,"_3084":55020},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3634":1246,"_31331":1244,"_5":31687,"_21707":55022,"_28497":55023,"_3084":55024},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3634":1247,"_31331":1244,"_5":31687,"_21707":55026,"_28497":55027,"_3084":55028},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3634":1248,"_31331":1244,"_5":31687,"_21707":55030,"_28497":55031,"_3084":54585},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3634":1249,"_31331":1244,"_5":31687,"_21707":55033,"_28497":55034,"_3084":55035},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3634":1250,"_31331":1244,"_21707":55037,"_5":14945,"_28497":1244,"_3084":55038},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3634":1251,"_31331":1244,"_21707":55040,"_5":14945,"_28497":55027,"_3084":55041},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3634":1252,"_31331":1244,"_21707":55043,"_5":14945,"_28497":55027,"_3084":55044},[],"Symptom or message",{"_3634":1253,"_31331":1244,"_21707":55046,"_5":14945,"_28497":55027,"_3084":54808},[],{"_3634":1254,"_31331":1244,"_21707":55048,"_5":14945,"_28497":55027,"_3084":55049},[],"curl rejects TLS, name or issuer",{"_3634":1255,"_31331":1244,"_21707":55051,"_5":14945,"_28497":55027,"_3084":55052},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3634":1256,"_31331":1244,"_21707":55054,"_5":14945,"_28497":55027,"_3084":55055},[],"404 or missing APS",{"_3634":1257,"_31331":1244,"_21707":55057,"_5":14945,"_28497":55027,"_3084":55058},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3634":1258,"_31331":1244,"_21707":55060,"_5":14945,"_28497":55027,"_3084":55061},[],"400, CSR or format error",{"_3634":1259,"_31331":1244,"_21707":55063,"_5":14945,"_28497":55027,"_3084":55064},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3634":1260,"_31331":1244,"_21707":55066,"_5":14945,"_28497":55027,"_3084":55067},[],"Missing credential or invalid certificate",{"_3634":1261,"_31331":1244,"_21707":55069,"_5":14945,"_28497":55027,"_3084":55070},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3634":1262,"_31331":1244,"_21707":55072,"_5":14945,"_28497":55027,"_3084":55073},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3634":1263,"_31331":1244,"_21707":55075,"_5":14945,"_28497":55027,"_3084":55076},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3634":1264,"_31331":1244,"_21707":55078,"_5":14945,"_28497":55027,"_3084":55079},[],"Webhook denies, times out or responds without authorization",{"_3634":1265,"_31331":1244,"_21707":55081,"_5":14945,"_28497":55027,"_3084":55082},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3634":1266,"_31331":1244,"_21707":55084,"_5":14945,"_28497":55027,"_3084":55085},[],"`unexpected status code: <n>: redirects are not followed`",{"_3634":1267,"_31331":1244,"_21707":55087,"_5":14945,"_28497":55027,"_3084":55088},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3634":1268,"_31331":1244,"_21707":55090,"_5":14945,"_28497":55027,"_3084":55091},[],"`webhook response exceeds 1048576 bytes`",{"_3634":1269,"_31331":1244,"_21707":55093,"_5":14945,"_28497":55027,"_3084":55094},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3634":1270,"_31331":1244,"_21707":55096,"_5":14945,"_28497":55027,"_3084":55097},[],"`webhook config must not reference files`",{"_3634":1271,"_31331":1244,"_21707":55099,"_5":14945,"_28497":55027,"_3084":55100},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3634":1272,"_31331":1244,"_21707":55102,"_5":14945,"_28497":55027,"_3084":55103},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3634":1273,"_31331":1244,"_21707":55105,"_5":14945,"_28497":55027,"_3084":55106},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3634":1274,"_31331":1244,"_21707":55108,"_5":14945,"_28497":55027,"_3084":55109},[],"`webhook mTLS certificate and key are invalid: …`",{"_3634":1275,"_31331":1244,"_21707":55111,"_5":14945,"_28497":55027,"_3084":55112},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3634":1276,"_31331":1244,"_21707":55114,"_5":14945,"_28497":55027,"_3084":55115},[],"400 `struct validation error` creating or updating a DMS",{"_3634":1277,"_31331":1244,"_21707":55117,"_5":14945,"_28497":55027,"_3084":55118},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3634":1278,"_31331":1244,"_21707":55120,"_5":14945,"_28497":55027,"_3084":55121},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3634":1279,"_31331":1244,"_21707":55123,"_5":14945,"_28497":55027,"_3084":55124},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3634":1280,"_31331":1244,"_21707":55126,"_5":14945,"_28497":55027,"_3084":55127},[],"`device not preregistered`",{"_3634":1281,"_31331":1244,"_21707":55129,"_5":14945,"_28497":55027,"_3084":55130},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3634":1282,"_31331":1244,"_21707":55132,"_5":14945,"_28497":55027,"_3084":55133},[],"`forbiddenNewEnrollment`",{"_3634":1283,"_31331":1244,"_21707":55135,"_5":14945,"_28497":55027,"_3084":55136},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3634":1284,"_31331":1244,"_21707":55138,"_5":14945,"_28497":55027,"_3084":55139},[],"Different owning DMS",{"_3634":1285,"_31331":1244,"_21707":55141,"_5":14945,"_28497":55027,"_3084":55142},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3634":1286,"_31331":1244,"_21707":55144,"_5":14945,"_28497":55027,"_3084":55145},[],"`invalid RawSubject bytes`",{"_3634":1287,"_31331":1244,"_21707":55147,"_5":14945,"_28497":55027,"_3084":55148},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3634":1288,"_31331":1244,"_21707":55150,"_5":14945,"_28497":55027,"_3084":55151},[],"`invalid reenroll window`",{"_3634":1289,"_31331":1244,"_21707":55153,"_5":14945,"_28497":55027,"_3084":55154},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3634":1290,"_31331":1244,"_21707":55156,"_5":14945,"_28497":55027,"_3084":55157},[],"Current certificate revoked",{"_3634":1291,"_31331":1244,"_21707":55159,"_5":14945,"_28497":55027,"_3084":55160},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3634":1292,"_31331":1244,"_21707":55162,"_5":14945,"_28497":55027,"_3084":55163},[],"CA, profile or signing error",{"_3634":1293,"_31331":1244,"_21707":55165,"_5":14945,"_28497":55027,"_3084":55166},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3634":1294,"_31331":1244,"_21707":55168,"_5":14945,"_28497":55027,"_3084":55169},[],"HTTP 200 without a device connection",{"_3634":1295,"_31331":1244,"_21707":55171,"_5":14945,"_28497":55027,"_3084":55172},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3634":1296,"_31331":1244,"_21707":55174,"_5":14945,"_28497":55027,"_3084":55175},[],"Timeout or error after issuance",{"_3634":1297,"_31331":1244,"_21707":55177,"_5":14945,"_28497":55027,"_3084":55178},[],"New certificates, current slot and previous identity's state before retrying.",{"_3634":1298,"_31331":1244,"_21707":55180,"_5":14945,"_28497":55031,"_3084":55181},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3634":1299,"_31331":1244,"_21707":55183,"_5":14945,"_28497":55031,"_3084":55184},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3634":1300,"_31331":1244,"_21707":55186,"_5":14945,"_28497":55034,"_3084":55187},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3634":1301,"_31331":1244,"_21707":55189,"_5":14945,"_28497":55034,"_3084":55190},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3634":1302,"_31331":1244,"_21707":55192,"_5":14945,"_28497":55034,"_3084":55193},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3634":1303,"_31331":1244,"_21707":55195,"_5":14945,"_28497":55034,"_3084":55196},[],"Make one request, save headers/body and query the device and certificates.",{"_3634":1304,"_31331":1244,"_21707":55198,"_5":14945,"_28497":55034,"_3084":55199},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3634":1305,"_31331":1244,"_21707":55201,"_5":14945,"_28497":55034,"_3084":55202},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3634":1306,"_31331":1244,"_21707":55204,"_5":14945,"_28497":55034,"_3084":55205},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3634":1307,"_31331":1307,"_5":15305,"_3084":55207,"_31690":55208,"_21707":55209,"_28497":1307},"Trust distribution and updates",[51145,52657,53829,53827,54013],[],{"_3634":1308,"_31331":1307,"_21707":55211,"_5":14945,"_28497":1307,"_3084":55212},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3634":1309,"_31331":1307,"_5":31687,"_21707":55214,"_28497":55215,"_3084":55216},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3634":1310,"_31331":1307,"_5":31687,"_21707":55218,"_28497":55219,"_3084":55220},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3634":1311,"_31331":1307,"_5":31687,"_21707":55222,"_28497":55223,"_3084":55224},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3634":1312,"_31331":1307,"_5":31687,"_21707":55226,"_28497":55227,"_3084":55228},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3634":1313,"_31331":1307,"_5":31687,"_21707":55230,"_28497":55231,"_3084":55232},[],"/docs/pr-preview/pr-81/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3634":1314,"_31331":1307,"_21707":55234,"_5":14945,"_28497":1307,"_3084":55235},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3634":1315,"_31331":1307,"_21707":55237,"_5":14945,"_28497":55215,"_3084":55238},[],"Relationship",{"_3634":1316,"_31331":1307,"_21707":55240,"_5":14945,"_28497":55215,"_3084":55241},[],"Material prepared by its owner",{"_3634":1317,"_31331":1307,"_21707":55243,"_5":14945,"_28497":55215,"_3084":55244},[],"Device → EST server",{"_3634":1318,"_31331":1307,"_21707":55246,"_5":14945,"_28497":55215,"_3084":55247},[],"Previously verified server root, chain or pin and TLS name.",{"_3634":1319,"_31331":1307,"_21707":55249,"_5":14945,"_28497":55215,"_3084":55250},[],"DMS → requester",{"_3634":1320,"_31331":1307,"_21707":55252,"_5":14945,"_28497":55215,"_3084":55253},[],"CAs and rules authorizing initial or renewal credentials.",{"_3634":1321,"_31331":1307,"_21707":55255,"_5":14945,"_28497":55215,"_3084":55256},[],"Consumer → device",{"_3634":1322,"_31331":1307,"_21707":55258,"_5":14945,"_28497":55215,"_3084":55259},[],"Operational identity roots, intermediates, validation and permissions.",{"_3634":1323,"_31331":1307,"_21707":55261,"_5":14945,"_28497":55215,"_3084":55262},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3634":1324,"_31331":1307,"_21707":55264,"_5":14945,"_28497":55219,"_3084":55265},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3634":1325,"_31331":1307,"_21707":55267,"_5":14945,"_28497":55219,"_3084":55268},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3634":1326,"_31331":1307,"_21707":55270,"_5":14945,"_28497":55223,"_3084":55271},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3634":1327,"_31331":1307,"_21707":55273,"_5":14945,"_28497":55223,"_3084":55274},[],"Select policy-approved roots as anchors.",{"_3634":1328,"_31331":1307,"_21707":55276,"_5":14945,"_28497":55223,"_3084":55277},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3634":1329,"_31331":1307,"_21707":55279,"_5":14945,"_28497":55223,"_3084":55280},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3634":1330,"_31331":1307,"_21707":55282,"_5":14945,"_28497":55223,"_3084":55283},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3634":1331,"_31331":1307,"_21707":55285,"_5":14945,"_28497":55223,"_3084":55286},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3634":1332,"_31331":1307,"_21707":55288,"_5":14945,"_28497":55227,"_3084":55289},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3634":1333,"_31331":1307,"_21707":55291,"_5":14945,"_28497":55227,"_3084":55292},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3634":1334,"_31331":1307,"_21707":55294,"_5":14945,"_28497":55227,"_3084":55295},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3634":1335,"_31331":1307,"_21707":55297,"_5":14945,"_28497":55231,"_3084":55298},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3634":1336,"_31331":1336,"_5":15305,"_3084":55300,"_31690":55301,"_21707":55303,"_28497":1336},"AWS IoT Core",[51145,52657,53829,53827,55302],"Integrations",[],{"_3634":1337,"_31331":1336,"_21707":55305,"_5":14945,"_28497":1336,"_3084":55306},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3634":1338,"_31331":1336,"_5":31687,"_21707":55308,"_28497":55309,"_3084":55310},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3634":1339,"_31331":1336,"_5":31687,"_21707":55312,"_28497":55313,"_3084":55314},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3634":1340,"_31331":1336,"_5":31687,"_21707":55316,"_28497":55317,"_3084":55318},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3634":1341,"_31331":1336,"_5":31687,"_21707":55320,"_28497":55321,"_3084":55322},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3634":1342,"_31331":1336,"_5":31687,"_21707":55324,"_28497":55325,"_3084":55326},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3634":1343,"_31331":1336,"_5":31687,"_21707":55328,"_28497":55329,"_3084":55330},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3634":1344,"_31331":1336,"_5":31687,"_21707":55332,"_28497":55333,"_3084":55334},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3634":1345,"_31331":1336,"_5":31687,"_21707":55336,"_28497":55337,"_3084":55338},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3634":1346,"_31331":1336,"_5":31687,"_21707":55340,"_28497":55341,"_3084":55342},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3634":1347,"_31331":1336,"_5":31687,"_21707":55344,"_28497":55345,"_3084":55346},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3634":1348,"_31331":1336,"_5":31687,"_21707":55348,"_28497":55349,"_3084":55350},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3634":1349,"_31331":1336,"_5":31687,"_21707":55352,"_28497":55353,"_3084":55354},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3634":1350,"_31331":1336,"_5":31687,"_21707":55356,"_28497":55357,"_3084":55358},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3634":1351,"_31331":1336,"_5":31687,"_21707":55360,"_28497":55361,"_3084":55362},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3634":1352,"_31331":1336,"_5":31687,"_21707":55364,"_28497":55365,"_3084":55366},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3634":1353,"_31331":1336,"_5":31687,"_21707":55368,"_28497":55369,"_3084":55370},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3634":1354,"_31331":1336,"_5":31687,"_21707":55372,"_28497":55373,"_3084":55374},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3634":1355,"_31331":1336,"_5":31687,"_21707":55376,"_28497":55377,"_3084":55378},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3634":1356,"_31331":1336,"_5":31687,"_21707":55380,"_28497":55381,"_3084":55382},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3634":1357,"_31331":1336,"_5":31687,"_21707":55384,"_28497":55385,"_3084":55386},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3634":1358,"_31331":1336,"_5":31687,"_21707":55388,"_28497":55389,"_3084":55390},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3634":1359,"_31331":1336,"_5":31687,"_21707":55392,"_28497":55393,"_3084":55394},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3634":1360,"_31331":1336,"_5":31687,"_21707":55396,"_28497":55397,"_3084":55398},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3634":1361,"_31331":1336,"_5":31687,"_21707":55400,"_28497":55401,"_3084":55402},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3634":1362,"_31331":1336,"_5":31687,"_21707":55404,"_28497":55405,"_3084":55406},[],"/docs/pr-preview/pr-81/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3634":1363,"_31331":1336,"_21707":55408,"_5":14945,"_28497":1336,"_3084":55409},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3634":1364,"_31331":1336,"_21707":55411,"_5":14945,"_28497":1336,"_3084":55412},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3634":1365,"_31331":1336,"_21707":55414,"_5":14945,"_28497":1336,"_3084":55415},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3634":1366,"_31331":1336,"_21707":55417,"_5":14945,"_28497":55309,"_3084":55418},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3634":1367,"_31331":1336,"_21707":55420,"_5":14945,"_28497":55309,"_3084":55421},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3634":1368,"_31331":1336,"_21707":55423,"_5":14945,"_28497":55309,"_3084":55424},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3634":1369,"_31331":1336,"_21707":55426,"_5":14945,"_28497":55309,"_3084":55427},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3634":1370,"_31331":1336,"_21707":55429,"_5":14945,"_28497":55313,"_3084":55430},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3634":1371,"_31331":1336,"_21707":55432,"_5":14945,"_28497":55317,"_3084":55433},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3634":1372,"_31331":1336,"_21707":55435,"_5":14945,"_28497":55317,"_3084":55436},[],"IAM action",{"_3634":1373,"_31331":1336,"_21707":55438,"_5":14945,"_28497":55317,"_3084":51535},[],{"_3634":1374,"_31331":1336,"_21707":55440,"_5":14945,"_28497":55317,"_3084":55441},[],"`iot:GetRegistrationCode`",{"_3634":1375,"_31331":1336,"_21707":55443,"_5":14945,"_28497":55317,"_3084":55444},[],"Obtain the verification code for CA registration in the Primary Account",{"_3634":1376,"_31331":1336,"_21707":55446,"_5":14945,"_28497":55317,"_3084":55447},[],"`iot:RegisterCACertificate`",{"_3634":1377,"_31331":1336,"_21707":55449,"_5":14945,"_28497":55317,"_3084":55450},[],"Register the CA in AWS IoT",{"_3634":1378,"_31331":1336,"_21707":55452,"_5":14945,"_28497":55317,"_3084":55453},[],"`iot:DescribeCACertificate`",{"_3634":1379,"_31331":1336,"_21707":55455,"_5":14945,"_28497":55317,"_3084":55456},[],"Check the CA registration status",{"_3634":1380,"_31331":1336,"_21707":55458,"_5":14945,"_28497":55317,"_3084":55459},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3634":1381,"_31331":1336,"_21707":55461,"_5":14945,"_28497":55317,"_3084":55462},[],"Create or update Things in IoT Core",{"_3634":1382,"_31331":1336,"_21707":55464,"_5":14945,"_28497":55317,"_3084":55465},[],"`iot:RegisterThing`",{"_3634":1383,"_31331":1336,"_21707":55467,"_5":14945,"_28497":55317,"_3084":55468},[],"Provision Things through a template",{"_3634":1384,"_31331":1336,"_21707":55470,"_5":14945,"_28497":55317,"_3084":55471},[],"`iot:RegisterCertificate`",{"_3634":1385,"_31331":1336,"_21707":55473,"_5":14945,"_28497":55317,"_3084":55474},[],"Register device certificates",{"_3634":1386,"_31331":1336,"_21707":55476,"_5":14945,"_28497":55317,"_3084":55477},[],"`iot:UpdateCertificate`",{"_3634":1387,"_31331":1336,"_21707":55479,"_5":14945,"_28497":55317,"_3084":55480},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3634":1388,"_31331":1336,"_21707":55482,"_5":14945,"_28497":55317,"_3084":55483},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3634":1389,"_31331":1336,"_21707":55485,"_5":14945,"_28497":55317,"_3084":55486},[],"Create and attach IoT policies",{"_3634":1390,"_31331":1336,"_21707":55488,"_5":14945,"_28497":55317,"_3084":55489},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3634":1391,"_31331":1336,"_21707":55491,"_5":14945,"_28497":55317,"_3084":55492},[],"Manage Thing groups",{"_3634":1392,"_31331":1336,"_21707":55494,"_5":14945,"_28497":55317,"_3084":55495},[],"`iot:CreateProvisioningTemplate`",{"_3634":1393,"_31331":1336,"_21707":55497,"_5":14945,"_28497":55317,"_3084":55498},[],"Create JITP templates",{"_3634":1394,"_31331":1336,"_21707":55500,"_5":14945,"_28497":55317,"_3084":55501},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3634":1395,"_31331":1336,"_21707":55503,"_5":14945,"_28497":55317,"_3084":55504},[],"Read and write the Device Shadow",{"_3634":1396,"_31331":1336,"_21707":55506,"_5":14945,"_28497":55317,"_3084":55507},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3634":1397,"_31331":1336,"_21707":55509,"_5":14945,"_28497":55321,"_3084":55510},[],"Parameter",{"_3634":1398,"_31331":1336,"_21707":55512,"_5":14945,"_28497":55321,"_3084":55513},[],"Type",{"_3634":1399,"_31331":1336,"_21707":55515,"_5":14945,"_28497":55321,"_3084":55516},[],"Required",{"_3634":1400,"_31331":1336,"_21707":55518,"_5":14945,"_28497":55321,"_3084":55519},[],"Description",{"_3634":1401,"_31331":1336,"_21707":55521,"_5":14945,"_28497":55321,"_3084":55522},[],"`connector_id`",{"_3634":1402,"_31331":1336,"_21707":55524,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1403,"_31331":1336,"_21707":55526,"_5":14945,"_28497":55321,"_3084":55527},[],"Yes",{"_3634":1404,"_31331":1336,"_21707":55529,"_5":14945,"_28497":55321,"_3084":55530},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3634":1405,"_31331":1336,"_21707":55532,"_5":14945,"_28497":55321,"_3084":55533},[],"`aws_config.region`",{"_3634":1406,"_31331":1336,"_21707":55535,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1407,"_31331":1336,"_21707":55537,"_5":14945,"_28497":55321,"_3084":55527},[],{"_3634":1408,"_31331":1336,"_21707":55539,"_5":14945,"_28497":55321,"_3084":55540},[],"AWS region where the connector operates.",{"_3634":1409,"_31331":1336,"_21707":55542,"_5":14945,"_28497":55321,"_3084":55543},[],"`aws_config.auth_method`",{"_3634":1410,"_31331":1336,"_21707":55545,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1411,"_31331":1336,"_21707":55547,"_5":14945,"_28497":55321,"_3084":55527},[],{"_3634":1412,"_31331":1336,"_21707":55549,"_5":14945,"_28497":55321,"_3084":55550},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3634":1413,"_31331":1336,"_21707":55552,"_5":14945,"_28497":55321,"_3084":55553},[],"`aws_config.access_key_id`",{"_3634":1414,"_31331":1336,"_21707":55555,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1415,"_31331":1336,"_21707":55557,"_5":14945,"_28497":55321,"_3084":55558},[],"Only with `auth_method=static`",{"_3634":1416,"_31331":1336,"_21707":55560,"_5":14945,"_28497":55321,"_3084":55561},[],"AWS access key.",{"_3634":1417,"_31331":1336,"_21707":55563,"_5":14945,"_28497":55321,"_3084":55564},[],"`aws_config.secret_access_key`",{"_3634":1418,"_31331":1336,"_21707":55566,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1419,"_31331":1336,"_21707":55568,"_5":14945,"_28497":55321,"_3084":55558},[],{"_3634":1420,"_31331":1336,"_21707":55570,"_5":14945,"_28497":55321,"_3084":55571},[],"AWS secret key.",{"_3634":1421,"_31331":1336,"_21707":55573,"_5":14945,"_28497":55321,"_3084":55574},[],"`aws_config.session_token`",{"_3634":1422,"_31331":1336,"_21707":55576,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1423,"_31331":1336,"_21707":55578,"_5":14945,"_28497":55321,"_3084":55579},[],"No",{"_3634":1424,"_31331":1336,"_21707":55581,"_5":14945,"_28497":55321,"_3084":55582},[],"Session token (with `auth_method=static`).",{"_3634":1425,"_31331":1336,"_21707":55584,"_5":14945,"_28497":55321,"_3084":55585},[],"`aws_config.role_arn`",{"_3634":1426,"_31331":1336,"_21707":55587,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1427,"_31331":1336,"_21707":55589,"_5":14945,"_28497":55321,"_3084":55590},[],"Only with `auth_method=role`",{"_3634":1428,"_31331":1336,"_21707":55592,"_5":14945,"_28497":55321,"_3084":55593},[],"ARN of the role to assume.",{"_3634":1429,"_31331":1336,"_21707":55595,"_5":14945,"_28497":55321,"_3084":55596},[],"`aws_config.endpoint_url`",{"_3634":1430,"_31331":1336,"_21707":55598,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1431,"_31331":1336,"_21707":55600,"_5":14945,"_28497":55321,"_3084":55579},[],{"_3634":1432,"_31331":1336,"_21707":55602,"_5":14945,"_28497":55321,"_3084":55603},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3634":1433,"_31331":1336,"_21707":55605,"_5":14945,"_28497":55321,"_3084":55606},[],"`subscriber_event_bus`",{"_3634":1434,"_31331":1336,"_21707":55608,"_5":14945,"_28497":55321,"_3084":18290},[],{"_3634":1435,"_31331":1336,"_21707":55610,"_5":14945,"_28497":55321,"_3084":55527},[],{"_3634":1436,"_31331":1336,"_21707":55612,"_5":14945,"_28497":55321,"_3084":55613},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3634":1437,"_31331":1336,"_21707":55615,"_5":14945,"_28497":55321,"_3084":55616},[],"`dms_manager_client`",{"_3634":1438,"_31331":1336,"_21707":55618,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1439,"_31331":1336,"_21707":55620,"_5":14945,"_28497":55321,"_3084":55527},[],{"_3634":1440,"_31331":1336,"_21707":55622,"_5":14945,"_28497":55321,"_3084":55623},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3634":1441,"_31331":1336,"_21707":55625,"_5":14945,"_28497":55321,"_3084":55626},[],"`device_manager_client`",{"_3634":1442,"_31331":1336,"_21707":55628,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1443,"_31331":1336,"_21707":55630,"_5":14945,"_28497":55321,"_3084":55527},[],{"_3634":1444,"_31331":1336,"_21707":55632,"_5":14945,"_28497":55321,"_3084":55633},[],"HTTP URL of Lamassu's Device Manager.",{"_3634":1445,"_31331":1336,"_21707":55635,"_5":14945,"_28497":55321,"_3084":55636},[],"`ca_client`",{"_3634":1446,"_31331":1336,"_21707":55638,"_5":14945,"_28497":55321,"_3084":25888},[],{"_3634":1447,"_31331":1336,"_21707":55640,"_5":14945,"_28497":55321,"_3084":55527},[],{"_3634":1448,"_31331":1336,"_21707":55642,"_5":14945,"_28497":55321,"_3084":55643},[],"HTTP URL of Lamassu's CA service.",{"_3634":1449,"_31331":1336,"_21707":55645,"_5":14945,"_28497":55325,"_3084":55646},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3634":1450,"_31331":1336,"_21707":55648,"_5":14945,"_28497":55325,"_3084":55649},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3634":1451,"_31331":1336,"_21707":55651,"_5":14945,"_28497":55325,"_3084":55652},[],"CloudEvent type",{"_3634":1452,"_31331":1336,"_21707":55654,"_5":14945,"_28497":55325,"_3084":55655},[],"Lamassu resource",{"_3634":1453,"_31331":1336,"_21707":55657,"_5":14945,"_28497":55325,"_3084":55658},[],"AWS Resource",{"_3634":1454,"_31331":1336,"_21707":55660,"_5":14945,"_28497":55325,"_3084":55661},[],"IAM actions",{"_3634":1455,"_31331":1336,"_21707":55663,"_5":14945,"_28497":55325,"_3084":55664},[],"AWS calls and effect",{"_3634":1456,"_31331":1336,"_21707":55666,"_5":14945,"_28497":55325,"_3084":55667},[],"Where in this page",{"_3634":1457,"_31331":1336,"_21707":55669,"_5":14945,"_28497":55325,"_3084":55670},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3634":1458,"_31331":1336,"_21707":55672,"_5":14945,"_28497":55325,"_3084":55673},[],"CA",{"_3634":1459,"_31331":1336,"_21707":55675,"_5":14945,"_28497":55325,"_3084":55676},[],"`IoTCore/CACertificate`",{"_3634":1460,"_31331":1336,"_21707":55678,"_5":14945,"_28497":55325,"_3084":55679},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3634":1461,"_31331":1336,"_21707":55681,"_5":14945,"_28497":55325,"_3084":55682},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3634":1462,"_31331":1336,"_21707":55684,"_5":14945,"_28497":55325,"_3084":55338},[],{"_3634":1463,"_31331":1336,"_21707":55686,"_5":14945,"_28497":55325,"_3084":55687},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3634":1464,"_31331":1336,"_21707":55689,"_5":14945,"_28497":55325,"_3084":55690},[],"DMS",{"_3634":1465,"_31331":1336,"_21707":55692,"_5":14945,"_28497":55325,"_3084":55693},[],"`IoTCore/ProvisioningTemplate`",{"_3634":1466,"_31331":1336,"_21707":55695,"_5":14945,"_28497":55325,"_3084":55696},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3634":1467,"_31331":1336,"_21707":55698,"_5":14945,"_28497":55325,"_3084":55699},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3634":1468,"_31331":1336,"_21707":55701,"_5":14945,"_28497":55325,"_3084":55366},[],{"_3634":1469,"_31331":1336,"_21707":55703,"_5":14945,"_28497":55325,"_3084":55704},[],"`EventBindDeviceIdentityKey`",{"_3634":1470,"_31331":1336,"_21707":55706,"_5":14945,"_28497":55325,"_3084":55707},[],"Device",{"_3634":1471,"_31331":1336,"_21707":55709,"_5":14945,"_28497":55325,"_3084":55710},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3634":1472,"_31331":1336,"_21707":55712,"_5":14945,"_28497":55325,"_3084":55713},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3634":1473,"_31331":1336,"_21707":55715,"_5":14945,"_28497":55325,"_3084":55716},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3634":1474,"_31331":1336,"_21707":55718,"_5":14945,"_28497":55325,"_3084":55374},[],{"_3634":1475,"_31331":1336,"_21707":55720,"_5":14945,"_28497":55325,"_3084":55721},[],"`EventUpdateCertificateStatusKey`",{"_3634":1476,"_31331":1336,"_21707":55723,"_5":14945,"_28497":55325,"_3084":55724},[],"Certificate",{"_3634":1477,"_31331":1336,"_21707":55726,"_5":14945,"_28497":55325,"_3084":55727},[],"`IoTCore/Certificate`",{"_3634":1478,"_31331":1336,"_21707":55729,"_5":14945,"_28497":55325,"_3084":55730},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3634":1479,"_31331":1336,"_21707":55732,"_5":14945,"_28497":55325,"_3084":55733},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3634":1480,"_31331":1336,"_21707":55735,"_5":14945,"_28497":55325,"_3084":55386},[],{"_3634":1481,"_31331":1336,"_21707":55737,"_5":14945,"_28497":55325,"_3084":55738},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3634":1482,"_31331":1336,"_21707":55740,"_5":14945,"_28497":55325,"_3084":55741},[],"Certificate / Device",{"_3634":1483,"_31331":1336,"_21707":55743,"_5":14945,"_28497":55325,"_3084":55744},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3634":1484,"_31331":1336,"_21707":55746,"_5":14945,"_28497":55325,"_3084":51541},[],{"_3634":1485,"_31331":1336,"_21707":55748,"_5":14945,"_28497":55325,"_3084":55749},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3634":1486,"_31331":1336,"_21707":55751,"_5":14945,"_28497":55325,"_3084":55394},[],{"_3634":1487,"_31331":1336,"_21707":55753,"_5":14945,"_28497":55329,"_3084":55754},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3634":1488,"_31331":1336,"_21707":55756,"_5":14945,"_28497":55333,"_3084":55757},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3634":1489,"_31331":1336,"_21707":55759,"_5":14945,"_28497":55333,"_3084":55760},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3634":1490,"_31331":1336,"_21707":55762,"_5":14945,"_28497":55337,"_3084":55763},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3634":1491,"_31331":1336,"_21707":55765,"_5":14945,"_28497":55337,"_3084":55766},[],"Transition",{"_3634":1492,"_31331":1336,"_21707":55768,"_5":14945,"_28497":55337,"_3084":55769},[],"AWS calls",{"_3634":1493,"_31331":1336,"_21707":55771,"_5":14945,"_28497":55337,"_3084":55772},[],"`NotRegistered` → `Requested`",{"_3634":1494,"_31331":1336,"_21707":55774,"_5":14945,"_28497":55337,"_3084":55775},[],"none (metadata write only)",{"_3634":1495,"_31331":1336,"_21707":55777,"_5":14945,"_28497":55337,"_3084":55778},[],"`Requested` → `Registering`",{"_3634":1496,"_31331":1336,"_21707":55780,"_5":14945,"_28497":55337,"_3084":55781},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3634":1497,"_31331":1336,"_21707":55783,"_5":14945,"_28497":55337,"_3084":55784},[],"`Registering` → `Succeeded`",{"_3634":1498,"_31331":1336,"_21707":55786,"_5":14945,"_28497":55337,"_3084":55787},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3634":1499,"_31331":1336,"_21707":55789,"_5":14945,"_28497":55337,"_3084":55790},[],"`Registering` → `Failed`",{"_3634":1500,"_31331":1336,"_21707":55792,"_5":14945,"_28497":55337,"_3084":55793},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3634":1501,"_31331":1336,"_21707":55795,"_5":14945,"_28497":55337,"_3084":55796},[],"`Failed` / `Succeeded` → `Requested`",{"_3634":1502,"_31331":1336,"_21707":55798,"_5":14945,"_28497":55337,"_3084":55799},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3634":1503,"_31331":1336,"_21707":55801,"_5":14945,"_28497":55341,"_3084":55802},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3634":1504,"_31331":1336,"_21707":55804,"_5":14945,"_28497":55341,"_3084":55805},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3634":1505,"_31331":1336,"_21707":55807,"_5":14945,"_28497":55341,"_3084":55808},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3634":1506,"_31331":1336,"_21707":55810,"_5":14945,"_28497":55341,"_3084":55811},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3634":1507,"_31331":1336,"_21707":55813,"_5":14945,"_28497":55341,"_3084":55814},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3634":1508,"_31331":1336,"_21707":55816,"_5":14945,"_28497":55341,"_3084":55817},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3634":1509,"_31331":1336,"_21707":55819,"_5":14945,"_28497":55345,"_3084":55820},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3634":1510,"_31331":1336,"_21707":55822,"_5":14945,"_28497":55349,"_3084":55823},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3634":1511,"_31331":1336,"_21707":55825,"_5":14945,"_28497":55349,"_3084":55826},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3634":1512,"_31331":1336,"_21707":55828,"_5":14945,"_28497":55353,"_3084":55829},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3634":1513,"_31331":1336,"_21707":55831,"_5":14945,"_28497":55357,"_3084":55832},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3634":1514,"_31331":1336,"_21707":55834,"_5":14945,"_28497":55357,"_3084":55835},[],"Creates or updates the IoT policies configured in the DMS.",{"_3634":1515,"_31331":1336,"_21707":55837,"_5":14945,"_28497":55357,"_3084":55838},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3634":1516,"_31331":1336,"_21707":55840,"_5":14945,"_28497":55357,"_3084":55841},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3634":1517,"_31331":1336,"_21707":55843,"_5":14945,"_28497":55357,"_3084":55844},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3634":1518,"_31331":1336,"_21707":55846,"_5":14945,"_28497":55357,"_3084":55847},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3634":1519,"_31331":1336,"_21707":55849,"_5":14945,"_28497":55357,"_3084":55850},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3634":1520,"_31331":1336,"_21707":55852,"_5":14945,"_28497":55361,"_3084":55853},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3634":1521,"_31331":1336,"_21707":55855,"_5":14945,"_28497":55361,"_3084":55856},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3634":1522,"_31331":1336,"_21707":55858,"_5":14945,"_28497":55361,"_3084":55859},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3634":1523,"_31331":1336,"_21707":55861,"_5":14945,"_28497":55361,"_3084":55862},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3634":1524,"_31331":1336,"_21707":55864,"_5":14945,"_28497":55361,"_3084":55865},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3634":1525,"_31331":1336,"_21707":55867,"_5":14945,"_28497":55365,"_3084":55868},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3634":1526,"_31331":1336,"_21707":55870,"_5":14945,"_28497":55365,"_3084":55766},[],{"_3634":1527,"_31331":1336,"_21707":55872,"_5":14945,"_28497":55365,"_3084":55769},[],{"_3634":1528,"_31331":1336,"_21707":55874,"_5":14945,"_28497":55365,"_3084":55875},[],"`Unconfigured` → `None` / `Auto`",{"_3634":1529,"_31331":1336,"_21707":55877,"_5":14945,"_28497":55365,"_3084":55878},[],"none (configuration only)",{"_3634":1530,"_31331":1336,"_21707":55880,"_5":14945,"_28497":55365,"_3084":55881},[],"`None` ↔ `Auto`",{"_3634":1531,"_31331":1336,"_21707":55883,"_5":14945,"_28497":55365,"_3084":55878},[],{"_3634":1532,"_31331":1336,"_21707":55885,"_5":14945,"_28497":55365,"_3084":55886},[],"Any → `Jitp`",{"_3634":1533,"_31331":1336,"_21707":55888,"_5":14945,"_28497":55365,"_3084":55889},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3634":1534,"_31331":1336,"_21707":55891,"_5":14945,"_28497":55365,"_3084":55892},[],"`Jitp` → `None` / `Auto`",{"_3634":1535,"_31331":1336,"_21707":55894,"_5":14945,"_28497":55365,"_3084":55895},[],"none (the template stays in the AWS account)",{"_3634":1536,"_31331":1336,"_21707":55897,"_5":14945,"_28497":55369,"_3084":55898},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3634":1537,"_31331":1336,"_21707":55900,"_5":14945,"_28497":55369,"_3084":55901},[],"The full flow from the device's perspective is:",{"_3634":1538,"_31331":1336,"_21707":55903,"_5":14945,"_28497":55369,"_3084":55904},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3634":1539,"_31331":1336,"_21707":55906,"_5":14945,"_28497":55373,"_3084":55907},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3634":1540,"_31331":1336,"_21707":55909,"_5":14945,"_28497":55373,"_3084":55766},[],{"_3634":1541,"_31331":1336,"_21707":55911,"_5":14945,"_28497":55373,"_3084":55769},[],{"_3634":1542,"_31331":1336,"_21707":55913,"_5":14945,"_28497":55373,"_3084":55914},[],"`Absent` → `Provisioned`",{"_3634":1543,"_31331":1336,"_21707":55916,"_5":14945,"_28497":55373,"_3084":55917},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3634":1544,"_31331":1336,"_21707":55919,"_5":14945,"_28497":55373,"_3084":55920},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3634":1545,"_31331":1336,"_21707":55922,"_5":14945,"_28497":55373,"_3084":55923},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3634":1546,"_31331":1336,"_21707":55925,"_5":14945,"_28497":55373,"_3084":55926},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3634":1547,"_31331":1336,"_21707":55928,"_5":14945,"_28497":55377,"_3084":55929},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3634":1548,"_31331":1336,"_21707":55931,"_5":14945,"_28497":55377,"_3084":55932},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3634":1549,"_31331":1336,"_21707":55934,"_5":14945,"_28497":55377,"_3084":55935},[],"For the JITP flow to work correctly:",{"_3634":1550,"_31331":1336,"_21707":55937,"_5":14945,"_28497":55377,"_3084":55938},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3634":1551,"_31331":1336,"_21707":55940,"_5":14945,"_28497":55377,"_3084":55941},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3634":1552,"_31331":1336,"_21707":55943,"_5":14945,"_28497":55377,"_3084":55944},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3634":1553,"_31331":1336,"_21707":55946,"_5":14945,"_28497":55377,"_3084":55947},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3634":1554,"_31331":1336,"_21707":55949,"_5":14945,"_28497":55381,"_3084":55950},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3634":1555,"_31331":1336,"_21707":55952,"_5":14945,"_28497":55381,"_3084":55953},[],"Status in Lamassu",{"_3634":1556,"_31331":1336,"_21707":55955,"_5":14945,"_28497":55381,"_3084":55956},[],"Revocation reason",{"_3634":1557,"_31331":1336,"_21707":55958,"_5":14945,"_28497":55381,"_3084":55959},[],"Status in AWS IoT Core",{"_3634":1558,"_31331":1336,"_21707":55961,"_5":14945,"_28497":55381,"_3084":55962},[],"`Active`",{"_3634":1559,"_31331":1336,"_21707":55964,"_5":14945,"_28497":55381,"_3084":55965},[],"None",{"_3634":1560,"_31331":1336,"_21707":55967,"_5":14945,"_28497":55381,"_3084":55968},[],"`ACTIVE`",{"_3634":1561,"_31331":1336,"_21707":55970,"_5":14945,"_28497":55381,"_3084":55971},[],"`Revoked`",{"_3634":1562,"_31331":1336,"_21707":55973,"_5":14945,"_28497":55381,"_3084":55974},[],"`certificateHold`",{"_3634":1563,"_31331":1336,"_21707":55976,"_5":14945,"_28497":55381,"_3084":55977},[],"`INACTIVE`",{"_3634":1564,"_31331":1336,"_21707":55979,"_5":14945,"_28497":55381,"_3084":55971},[],{"_3634":1565,"_31331":1336,"_21707":55981,"_5":14945,"_28497":55381,"_3084":55982},[],"Any other reason",{"_3634":1566,"_31331":1336,"_21707":55984,"_5":14945,"_28497":55381,"_3084":55985},[],"`REVOKED`",{"_3634":1567,"_31331":1336,"_21707":55987,"_5":14945,"_28497":55381,"_3084":55988},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3634":1568,"_31331":1336,"_21707":55990,"_5":14945,"_28497":55385,"_3084":55991},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3634":1569,"_31331":1336,"_21707":55993,"_5":14945,"_28497":55385,"_3084":55766},[],{"_3634":1570,"_31331":1336,"_21707":55995,"_5":14945,"_28497":55385,"_3084":55769},[],{"_3634":1571,"_31331":1336,"_21707":55997,"_5":14945,"_28497":55385,"_3084":55998},[],"`NotSynced` → `Active`",{"_3634":1572,"_31331":1336,"_21707":56000,"_5":14945,"_28497":55385,"_3084":55477},[],{"_3634":1573,"_31331":1336,"_21707":56002,"_5":14945,"_28497":55385,"_3084":56003},[],"`Active` → `Inactive`",{"_3634":1574,"_31331":1336,"_21707":56005,"_5":14945,"_28497":55385,"_3084":56006},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3634":1575,"_31331":1336,"_21707":56008,"_5":14945,"_28497":55385,"_3084":56009},[],"`Active` → `Revoked`",{"_3634":1576,"_31331":1336,"_21707":56011,"_5":14945,"_28497":55385,"_3084":56006},[],{"_3634":1577,"_31331":1336,"_21707":56013,"_5":14945,"_28497":55385,"_3084":56014},[],"`Inactive` / `Revoked` → `Active`",{"_3634":1578,"_31331":1336,"_21707":56016,"_5":14945,"_28497":55385,"_3084":55477},[],{"_3634":1579,"_31331":1336,"_21707":56018,"_5":14945,"_28497":55385,"_3084":56019},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3634":1580,"_31331":1336,"_21707":56021,"_5":14945,"_28497":55385,"_3084":56022},[],"none (these states are not synced to AWS)",{"_3634":1581,"_31331":1336,"_21707":56024,"_5":14945,"_28497":55389,"_3084":56025},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3634":1582,"_31331":1336,"_21707":56027,"_5":14945,"_28497":55389,"_3084":56028},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3634":1583,"_31331":1336,"_21707":56030,"_5":14945,"_28497":55389,"_3084":56031},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3634":1584,"_31331":1336,"_21707":56033,"_5":14945,"_28497":55393,"_3084":56034},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3634":1585,"_31331":1336,"_21707":56036,"_5":14945,"_28497":55393,"_3084":56037},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3634":1586,"_31331":1336,"_21707":56039,"_5":14945,"_28497":55397,"_3084":56040},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3634":1587,"_31331":1336,"_21707":56042,"_5":14945,"_28497":55397,"_3084":56043},[],"There are two action types:",{"_3634":1588,"_31331":1336,"_21707":56045,"_5":14945,"_28497":55397,"_3084":56046},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3634":1589,"_31331":1336,"_21707":56048,"_5":14945,"_28497":55397,"_3084":56049},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3634":1590,"_31331":1336,"_21707":56051,"_5":14945,"_28497":55397,"_3084":56052},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3634":1591,"_31331":1336,"_21707":56054,"_5":14945,"_28497":55401,"_3084":56055},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3634":1592,"_31331":1336,"_21707":56057,"_5":14945,"_28497":55401,"_3084":56058},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3634":1593,"_31331":1336,"_21707":56060,"_5":14945,"_28497":55401,"_3084":56061},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3634":1594,"_31331":1336,"_21707":56063,"_5":14945,"_28497":55405,"_3084":56064},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3634":1595,"_31331":1336,"_21707":56066,"_5":14945,"_28497":55405,"_3084":56067},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3634":1596,"_31331":1336,"_21707":56069,"_5":14945,"_28497":55405,"_3084":56070},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3634":1597,"_31331":1336,"_21707":56072,"_5":14945,"_28497":55405,"_3084":56073},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3634":1598,"_31331":1336,"_21707":56075,"_5":14945,"_28497":55405,"_3084":56076},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3634":1599,"_31331":1336,"_21707":56078,"_5":14945,"_28497":55405,"_3084":56079},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3634":1600,"_31331":1336,"_21707":56081,"_5":14945,"_28497":55405,"_3084":56082},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3634":1601,"_31331":1336,"_21707":56084,"_5":14945,"_28497":55405,"_3084":56085},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3634":1602,"_31331":1336,"_21707":56087,"_5":14945,"_28497":55405,"_3084":56088},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3634":1603,"_31331":1336,"_21707":56090,"_5":14945,"_28497":55405,"_3084":56091},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3634":1604,"_31331":1336,"_21707":56093,"_5":14945,"_28497":55405,"_3084":56094},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3634":1605,"_31331":1336,"_21707":56096,"_5":14945,"_28497":55405,"_3084":56097},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3634":1606,"_31331":1336,"_21707":56099,"_5":14945,"_28497":55405,"_3084":56100},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3634":1607,"_31331":1336,"_21707":56102,"_5":14945,"_28497":55405,"_3084":56103},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3634":1608,"_31331":1336,"_21707":56105,"_5":14945,"_28497":55405,"_3084":56106},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3634":1609,"_31331":1336,"_21707":56108,"_5":14945,"_28497":55405,"_3084":56109},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3634":1610,"_31331":1336,"_21707":56111,"_5":14945,"_28497":55405,"_3084":56112},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3634":1611,"_31331":1336,"_21707":56114,"_5":14945,"_28497":55405,"_3084":56115},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3634":1612,"_31331":1336,"_21707":56117,"_5":14945,"_28497":55405,"_3084":56118},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3634":1613,"_31331":1336,"_21707":56120,"_5":14945,"_28497":55405,"_3084":56121},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3634":1614,"_31331":1336,"_21707":56123,"_5":14945,"_28497":55405,"_3084":56124},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3634":1615,"_31331":1336,"_21707":56126,"_5":14945,"_28497":55405,"_3084":56127},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":1616,"_31331":1336,"_21707":56129,"_5":14945,"_28497":55405,"_3084":56130},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3634":1617,"_31331":1336,"_21707":56132,"_5":14945,"_28497":55405,"_3084":56133},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3634":1618,"_31331":1618,"_5":15305,"_3084":53829,"_31690":56135,"_21707":56136,"_28497":1618},[51145,52657,53829],[],{"_3634":1619,"_31331":1618,"_21707":56138,"_5":14945,"_28497":1618,"_3084":56139},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3634":1620,"_31331":1618,"_5":31687,"_21707":56141,"_28497":56142,"_3084":56143},[],"/docs/pr-preview/pr-81/platform/iot-fleets/overview#start-here","Start here",{"_3634":1621,"_31331":1618,"_5":31687,"_21707":56145,"_28497":56146,"_3084":53827},[],"/docs/pr-preview/pr-81/platform/iot-fleets/overview#devices-and-identities",{"_3634":1622,"_31331":1618,"_5":31687,"_21707":56148,"_28497":56149,"_3084":54013},[],"/docs/pr-preview/pr-81/platform/iot-fleets/overview#enrollment-with-pki",{"_3634":1623,"_31331":1618,"_5":31687,"_21707":56151,"_28497":56152,"_3084":55302},[],"/docs/pr-preview/pr-81/platform/iot-fleets/overview#integrations",{"_3634":1624,"_31331":1618,"_5":31687,"_21707":56154,"_28497":56155,"_3084":56156},[],"/docs/pr-preview/pr-81/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3634":1625,"_31331":1618,"_21707":56158,"_5":14945,"_28497":1618,"_3084":56159},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3634":1626,"_31331":1618,"_21707":56161,"_5":14945,"_28497":56142,"_3084":56162},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3634":1627,"_31331":1618,"_21707":56164,"_5":14945,"_28497":56142,"_3084":56165},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3634":1628,"_31331":1618,"_21707":56167,"_5":14945,"_28497":56146,"_3084":56168},[],"Resource",{"_3634":1629,"_31331":1618,"_21707":56170,"_5":14945,"_28497":56146,"_3084":56171},[],"What it represents",{"_3634":1630,"_31331":1618,"_21707":56173,"_5":14945,"_28497":56146,"_3084":56174},[],"**Device**",{"_3634":1631,"_31331":1618,"_21707":56176,"_5":14945,"_28497":56146,"_3084":56177},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3634":1632,"_31331":1618,"_21707":56179,"_5":14945,"_28497":56146,"_3084":56180},[],"**Identity**",{"_3634":1633,"_31331":1618,"_21707":56182,"_5":14945,"_28497":56146,"_3084":56183},[],"The device's association with its certificates: an active version and a history.",{"_3634":1634,"_31331":1618,"_21707":56185,"_5":14945,"_28497":56146,"_3084":56186},[],"**DMS**",{"_3634":1635,"_31331":1618,"_21707":56188,"_5":14945,"_28497":56146,"_3084":56189},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3634":1636,"_31331":1618,"_21707":56191,"_5":14945,"_28497":56146,"_3084":56192},[],"**Fleet**",{"_3634":1637,"_31331":1618,"_21707":56194,"_5":14945,"_28497":56146,"_3084":56195},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3634":1638,"_31331":1618,"_21707":56197,"_5":14945,"_28497":56146,"_3084":56198},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3634":1639,"_31331":1618,"_21707":56200,"_5":14945,"_28497":56146,"_3084":56201},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3634":1640,"_31331":1618,"_21707":56203,"_5":14945,"_28497":56149,"_3084":56204},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3634":1641,"_31331":1618,"_21707":56206,"_5":14945,"_28497":56149,"_3084":56207},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3634":1642,"_31331":1618,"_21707":56209,"_5":14945,"_28497":56149,"_3084":56210},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3634":1643,"_31331":1618,"_21707":56212,"_5":14945,"_28497":56149,"_3084":56213},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3634":1644,"_31331":1618,"_21707":56215,"_5":14945,"_28497":56149,"_3084":56216},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3634":1645,"_31331":1618,"_21707":56218,"_5":14945,"_28497":56149,"_3084":56219},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3634":1646,"_31331":1618,"_21707":56221,"_5":14945,"_28497":56149,"_3084":56222},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":1647,"_31331":1618,"_21707":56224,"_5":14945,"_28497":56149,"_3084":56225},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":1648,"_31331":1618,"_21707":56227,"_5":14945,"_28497":56152,"_3084":56228},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3634":1649,"_31331":1618,"_21707":56230,"_5":14945,"_28497":56152,"_3084":56231},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3634":1650,"_31331":1618,"_21707":56233,"_5":14945,"_28497":56155,"_3084":56234},[],"Participant",{"_3634":1651,"_31331":1618,"_21707":56236,"_5":14945,"_28497":56155,"_3084":56237},[],"Responsibility",{"_3634":1652,"_31331":1618,"_21707":56239,"_5":14945,"_28497":56155,"_3084":56240},[],"PKI administrator",{"_3634":1653,"_31331":1618,"_21707":56242,"_5":14945,"_28497":56155,"_3084":56243},[],"CA, issuance profile, chain and revocation publication.",{"_3634":1654,"_31331":1618,"_21707":56245,"_5":14945,"_28497":56155,"_3084":56246},[],"Provisioning administrator",{"_3634":1655,"_31331":1618,"_21707":56248,"_5":14945,"_28497":56155,"_3084":56249},[],"DMS, admission, authentication per operation and inventory.",{"_3634":1656,"_31331":1618,"_21707":56251,"_5":14945,"_28497":56155,"_3084":56252},[],"Device integrator",{"_3634":1657,"_31331":1618,"_21707":56254,"_5":14945,"_28497":56155,"_3084":56255},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3634":1658,"_31331":1618,"_21707":56257,"_5":14945,"_28497":56155,"_3084":56258},[],"Consumer integrator",{"_3634":1659,"_31331":1618,"_21707":56260,"_5":14945,"_28497":56155,"_3084":56261},[],"Trusted issuers, validation and device permissions in the destination.",{"_3634":1660,"_31331":1618,"_21707":56263,"_5":14945,"_28497":56155,"_3084":56264},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3634":1661,"_31331":1661,"_5":15305,"_3084":56266,"_31690":56267,"_21707":56269,"_28497":1661},"Enroll and connect your first device",[51145,52657,53829,56268],"Getting started",[],{"_3634":1662,"_31331":1661,"_21707":56271,"_5":14945,"_28497":1661,"_3084":56272},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3634":1663,"_31331":1661,"_5":31687,"_21707":56274,"_28497":56275,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3634":1664,"_31331":1661,"_5":31687,"_21707":56277,"_28497":56278,"_3084":56279},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3634":1665,"_31331":1661,"_5":31687,"_21707":56281,"_28497":56282,"_3084":56283},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3634":1666,"_31331":1661,"_5":31687,"_21707":56285,"_28497":56286,"_3084":56287},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3634":1667,"_31331":1661,"_5":31687,"_21707":56289,"_28497":56290,"_3084":56291},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3634":1668,"_31331":1661,"_5":31687,"_21707":56293,"_28497":56294,"_3084":56295},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3634":1669,"_31331":1661,"_5":31687,"_21707":56297,"_28497":56298,"_3084":56299},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3634":1670,"_31331":1661,"_5":31687,"_21707":56301,"_28497":56302,"_3084":56303},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3634":1671,"_31331":1661,"_21707":56305,"_5":14945,"_28497":1661,"_3084":56306},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3634":1672,"_31331":1661,"_21707":56308,"_5":14945,"_28497":56275,"_3084":56309},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3634":1673,"_31331":1661,"_21707":56311,"_5":14945,"_28497":56275,"_3084":56312},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3634":1674,"_31331":1661,"_21707":56314,"_5":14945,"_28497":56275,"_3084":56315},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3634":1675,"_31331":1661,"_21707":56317,"_5":14945,"_28497":56275,"_3084":56318},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3634":1676,"_31331":1661,"_21707":56320,"_5":14945,"_28497":56275,"_3084":56321},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3634":1677,"_31331":1661,"_21707":56323,"_5":14945,"_28497":56278,"_3084":56324},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3634":1678,"_31331":1661,"_21707":56326,"_5":14945,"_28497":56278,"_3084":56327},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3634":1679,"_31331":1661,"_21707":56329,"_5":14945,"_28497":56282,"_3084":56330},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3634":1680,"_31331":1661,"_21707":56332,"_5":14945,"_28497":56282,"_3084":56333},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3634":1681,"_31331":1661,"_21707":56335,"_5":14945,"_28497":56282,"_3084":56336},[],"Setting",{"_3634":1682,"_31331":1661,"_21707":56338,"_5":14945,"_28497":56282,"_3084":56339},[],"Evaluation value",{"_3634":1683,"_31331":1661,"_21707":56341,"_5":14945,"_28497":56282,"_3084":56342},[],"Enrollment CA",{"_3634":1684,"_31331":1661,"_21707":56344,"_5":14945,"_28497":56282,"_3084":56345},[],"Issuing root from `device-root.pem`.",{"_3634":1685,"_31331":1661,"_21707":56347,"_5":14945,"_28497":56282,"_3084":54149},[],{"_3634":1686,"_31331":1661,"_21707":56349,"_5":14945,"_28497":56282,"_3084":56350},[],"The 1-hour leaf profile you just prepared.",{"_3634":1687,"_31331":1661,"_21707":56352,"_5":14945,"_28497":56282,"_3084":56353},[],"Protocol / Registration Mode",{"_3634":1688,"_31331":1661,"_21707":56355,"_5":14945,"_28497":56282,"_3084":56356},[],"`EST_RFC7030` / `JITP`.",{"_3634":1689,"_31331":1661,"_21707":56358,"_5":14945,"_28497":56282,"_3084":56359},[],"Verify CSR Signature",{"_3634":1690,"_31331":1661,"_21707":56361,"_5":14945,"_28497":56282,"_3084":56362},[],"Enabled.",{"_3634":1691,"_31331":1661,"_21707":56364,"_5":14945,"_28497":56282,"_3084":56365},[],"Enable Replaceable Enrollment",{"_3634":1692,"_31331":1661,"_21707":56367,"_5":14945,"_28497":56282,"_3084":56368},[],"Disabled; the ID must be new.",{"_3634":1693,"_31331":1661,"_21707":56370,"_5":14945,"_28497":56282,"_3084":56371},[],"Initial authentication",{"_3634":1694,"_31331":1661,"_21707":56373,"_5":14945,"_28497":56282,"_3084":56374},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3634":1695,"_31331":1661,"_21707":56376,"_5":14945,"_28497":56282,"_3084":56377},[],"Renewal authentication",{"_3634":1696,"_31331":1661,"_21707":56379,"_5":14945,"_28497":56282,"_3084":56380},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3634":1697,"_31331":1661,"_21707":56382,"_5":14945,"_28497":56282,"_3084":56383},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3634":1698,"_31331":1661,"_21707":56385,"_5":14945,"_28497":56282,"_3084":56386},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3634":1699,"_31331":1661,"_21707":56388,"_5":14945,"_28497":56282,"_3084":56389},[],"Re-enrollment Delta",{"_3634":1700,"_31331":1661,"_21707":56391,"_5":14945,"_28497":56282,"_3084":56392},[],"1 hour.",{"_3634":1701,"_31331":1661,"_21707":56394,"_5":14945,"_28497":56282,"_3084":56395},[],"Preventive / Critical Delta",{"_3634":1702,"_31331":1661,"_21707":56397,"_5":14945,"_28497":56282,"_3084":56398},[],"30 minutes / 10 minutes.",{"_3634":1703,"_31331":1661,"_21707":56400,"_5":14945,"_28497":56282,"_3084":56401},[],"Revoke on Re-enrollment",{"_3634":1704,"_31331":1661,"_21707":56403,"_5":14945,"_28497":56282,"_3084":56404},[],"Disabled to test the successor before retiring the previous identity.",{"_3634":1705,"_31331":1661,"_21707":56406,"_5":14945,"_28497":56282,"_3084":54157},[],{"_3634":1706,"_31331":1661,"_21707":56408,"_5":14945,"_28497":56282,"_3084":56409},[],"Disabled; the operational key is generated in the client.",{"_3634":1707,"_31331":1661,"_21707":56411,"_5":14945,"_28497":56282,"_3084":56412},[],"CA Distribution",{"_3634":1708,"_31331":1661,"_21707":56414,"_5":14945,"_28497":56282,"_3084":56415},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3634":1709,"_31331":1661,"_21707":56417,"_5":14945,"_28497":56282,"_3084":56418},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3634":1710,"_31331":1661,"_21707":56420,"_5":14945,"_28497":56286,"_3084":56421},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3634":1711,"_31331":1661,"_21707":56423,"_5":14945,"_28497":56286,"_3084":56424},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3634":1712,"_31331":1661,"_21707":56426,"_5":14945,"_28497":56290,"_3084":56427},[],"Generate a new key and CSR with the selected identifier:",{"_3634":1713,"_31331":1661,"_21707":56429,"_5":14945,"_28497":56290,"_3084":56430},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3634":1714,"_31331":1661,"_21707":56432,"_5":14945,"_28497":56290,"_3084":56433},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3634":1715,"_31331":1661,"_21707":56435,"_5":14945,"_28497":56294,"_3084":56436},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3634":1716,"_31331":1661,"_21707":56438,"_5":14945,"_28497":56294,"_3084":56439},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3634":1717,"_31331":1661,"_21707":56441,"_5":14945,"_28497":56298,"_3084":56442},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3634":1718,"_31331":1661,"_21707":56444,"_5":14945,"_28497":56298,"_3084":56445},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3634":1719,"_31331":1661,"_21707":56447,"_5":14945,"_28497":56298,"_3084":56448},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3634":1720,"_31331":1661,"_21707":56450,"_5":14945,"_28497":56298,"_3084":56451},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3634":1721,"_31331":1661,"_21707":56453,"_5":14945,"_28497":56298,"_3084":56454},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3634":1722,"_31331":1661,"_21707":56456,"_5":14945,"_28497":56302,"_3084":56457},[],"Check",{"_3634":1723,"_31331":1661,"_21707":56459,"_5":14945,"_28497":56302,"_3084":56460},[],"Expected result",{"_3634":1724,"_31331":1661,"_21707":56462,"_5":14945,"_28497":56302,"_3084":56463},[],"Registration",{"_3634":1725,"_31331":1661,"_21707":56465,"_5":14945,"_28497":56302,"_3084":56466},[],"ID created automatically and correct DMS.",{"_3634":1726,"_31331":1661,"_21707":56468,"_5":14945,"_28497":56302,"_3084":55724},[],{"_3634":1727,"_31331":1661,"_21707":56470,"_5":14945,"_28497":56302,"_3084":56471},[],"CN, profile, serial and key verified.",{"_3634":1728,"_31331":1661,"_21707":56473,"_5":14945,"_28497":56302,"_3084":56474},[],"Inventory",{"_3634":1729,"_31331":1661,"_21707":56476,"_5":14945,"_28497":56302,"_3084":56477},[],"Received serial visible as the current identity and in history.",{"_3634":1730,"_31331":1661,"_21707":56479,"_5":14945,"_28497":56302,"_3084":56480},[],"Consumer",{"_3634":1731,"_31331":1661,"_21707":56482,"_5":14945,"_28497":56302,"_3084":56483},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3634":1732,"_31331":1661,"_21707":56485,"_5":14945,"_28497":56302,"_3084":56486},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3634":1733,"_31331":1661,"_21707":56488,"_5":14945,"_28497":56302,"_3084":56489},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3634":1734,"_31331":1734,"_5":15305,"_3084":53845,"_31690":56491,"_21707":56492,"_28497":1734},[51145,52657,53829,56268],[],{"_3634":1735,"_31331":1734,"_21707":56494,"_5":14945,"_28497":1734,"_3084":56495},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3634":1736,"_31331":1734,"_5":31687,"_21707":56497,"_28497":56498,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3634":1737,"_31331":1734,"_5":31687,"_21707":56500,"_28497":56501,"_3084":56502},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3634":1738,"_31331":1734,"_5":31687,"_21707":56504,"_28497":56505,"_3084":56506},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3634":1739,"_31331":1734,"_5":31687,"_21707":56508,"_28497":56509,"_3084":56510},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3634":1740,"_31331":1734,"_5":31687,"_21707":56512,"_28497":56513,"_3084":56514},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3634":1741,"_31331":1734,"_5":31687,"_21707":56516,"_28497":56517,"_3084":56518},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3634":1742,"_31331":1734,"_5":31687,"_21707":56520,"_28497":56521,"_3084":56460},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3634":1743,"_31331":1734,"_5":31687,"_21707":56523,"_28497":56524,"_3084":56525},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3634":1744,"_31331":1734,"_5":31687,"_21707":56527,"_28497":56528,"_3084":56529},[],"/docs/pr-preview/pr-81/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3634":1745,"_31331":1734,"_21707":56531,"_5":14945,"_28497":1734,"_3084":56532},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3634":1746,"_31331":1734,"_21707":56534,"_5":14945,"_28497":1734,"_3084":56535},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3634":1747,"_31331":1734,"_21707":56537,"_5":14945,"_28497":56498,"_3084":56538},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3634":1748,"_31331":1734,"_21707":56540,"_5":14945,"_28497":56498,"_3084":56541},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3634":1749,"_31331":1734,"_21707":56543,"_5":14945,"_28497":56498,"_3084":56544},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3634":1750,"_31331":1734,"_21707":56546,"_5":14945,"_28497":56498,"_3084":56547},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3634":1751,"_31331":1734,"_21707":56549,"_5":14945,"_28497":56501,"_3084":56550},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3634":1752,"_31331":1734,"_21707":56552,"_5":14945,"_28497":56501,"_3084":56553},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3634":1753,"_31331":1734,"_21707":56555,"_5":14945,"_28497":56501,"_3084":56556},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3634":1754,"_31331":1734,"_21707":56558,"_5":14945,"_28497":56501,"_3084":56559},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3634":1755,"_31331":1734,"_21707":56561,"_5":14945,"_28497":56501,"_3084":56562},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3634":1756,"_31331":1734,"_21707":56564,"_5":14945,"_28497":56501,"_3084":56565},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3634":1757,"_31331":1734,"_21707":56567,"_5":14945,"_28497":56501,"_3084":56568},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3634":1758,"_31331":1734,"_21707":56570,"_5":14945,"_28497":56501,"_3084":56571},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3634":1759,"_31331":1734,"_21707":56573,"_5":14945,"_28497":56505,"_3084":56574},[],"Open **Managed Devices** and the registration action. Complete:",{"_3634":1760,"_31331":1734,"_21707":56576,"_5":14945,"_28497":56505,"_3084":56577},[],"**Device ID**: `device-001`.",{"_3634":1761,"_31331":1734,"_21707":56579,"_5":14945,"_28497":56505,"_3084":56580},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3634":1762,"_31331":1734,"_21707":56582,"_5":14945,"_28497":56505,"_3084":56583},[],"**Icon** and **Tags**: optional classification.",{"_3634":1763,"_31331":1734,"_21707":56585,"_5":14945,"_28497":56505,"_3084":56586},[],"Confirm registration.",{"_3634":1764,"_31331":1734,"_21707":56588,"_5":14945,"_28497":56509,"_3084":56589},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3634":1765,"_31331":1734,"_21707":56591,"_5":14945,"_28497":56509,"_3084":56592},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3634":1766,"_31331":1734,"_21707":56594,"_5":14945,"_28497":56513,"_3084":56595},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3634":1767,"_31331":1734,"_21707":56597,"_5":14945,"_28497":56513,"_3084":56598},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3634":1768,"_31331":1734,"_21707":56600,"_5":14945,"_28497":56517,"_3084":56601},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3634":1769,"_31331":1734,"_21707":56603,"_5":14945,"_28497":56517,"_3084":56604},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3634":1770,"_31331":1734,"_21707":56606,"_5":14945,"_28497":56521,"_3084":56457},[],{"_3634":1771,"_31331":1734,"_21707":56608,"_5":14945,"_28497":56521,"_3084":56609},[],"Result",{"_3634":1772,"_31331":1734,"_21707":56611,"_5":14945,"_28497":56521,"_3084":55707},[],{"_3634":1773,"_31331":1734,"_21707":56613,"_5":14945,"_28497":56521,"_3084":56614},[],"`device-001` appears in inventory with the expected DMS.",{"_3634":1774,"_31331":1734,"_21707":56616,"_5":14945,"_28497":56521,"_3084":56617},[],"Current identity",{"_3634":1775,"_31331":1734,"_21707":56619,"_5":14945,"_28497":56521,"_3084":56620},[],"The associated certificate matches the one you verified in PKI.",{"_3634":1776,"_31331":1734,"_21707":56622,"_5":14945,"_28497":56521,"_3084":56623},[],"History",{"_3634":1777,"_31331":1734,"_21707":56625,"_5":14945,"_28497":56521,"_3084":56626},[],"The associated issuance appears with its serial number and dates.",{"_3634":1778,"_31331":1734,"_21707":56628,"_5":14945,"_28497":56521,"_3084":56629},[],"Key and certificate",{"_3634":1779,"_31331":1734,"_21707":56631,"_5":14945,"_28497":56521,"_3084":56632},[],"You have the verified pair ready to install on the device.",{"_3634":1780,"_31331":1734,"_21707":56634,"_5":14945,"_28497":56524,"_3084":56635},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3634":1781,"_31331":1734,"_21707":56637,"_5":14945,"_28497":56524,"_3084":56638},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3634":1782,"_31331":1734,"_21707":56640,"_5":14945,"_28497":56524,"_3084":56641},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3634":1783,"_31331":1734,"_21707":56643,"_5":14945,"_28497":56524,"_3084":56644},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3634":1784,"_31331":1734,"_21707":56646,"_5":14945,"_28497":56528,"_3084":56647},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3634":1785,"_31331":1734,"_21707":56649,"_5":14945,"_28497":56528,"_3084":56650},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3634":1786,"_31331":1734,"_21707":56652,"_5":14945,"_28497":56528,"_3084":56653},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3634":1787,"_31331":1787,"_5":15305,"_3084":56655,"_31690":56656,"_21707":56657,"_28497":1787},"Lamassu IoT Platform",[51145,52657],[],{"_3634":1788,"_31331":1787,"_21707":56659,"_5":14945,"_28497":1787,"_3084":56660},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3634":1789,"_31331":1787,"_5":31687,"_21707":56662,"_28497":56663,"_3084":56143},[],"/docs/pr-preview/pr-81/platform/overview#start-here",{"_3634":1790,"_31331":1787,"_5":31687,"_21707":56665,"_28497":56666,"_3084":56667},[],"/docs/pr-preview/pr-81/platform/overview#choose-your-path","Choose your path",{"_3634":1791,"_31331":1787,"_5":31687,"_21707":56669,"_28497":56670,"_3084":56671},[],"/docs/pr-preview/pr-81/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3634":1792,"_31331":1787,"_5":31687,"_21707":56673,"_28497":56674,"_3084":56675},[],"/docs/pr-preview/pr-81/platform/overview#core-capabilities","Core capabilities",{"_3634":1793,"_31331":1787,"_5":31687,"_21707":56677,"_28497":56678,"_3084":56679},[],"/docs/pr-preview/pr-81/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3634":1794,"_31331":1787,"_5":31687,"_21707":56681,"_28497":56682,"_3084":56683},[],"/docs/pr-preview/pr-81/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3634":1795,"_31331":1787,"_5":31687,"_21707":56685,"_28497":56686,"_3084":56687},[],"/docs/pr-preview/pr-81/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3634":1796,"_31331":1787,"_5":31687,"_21707":56689,"_28497":56690,"_3084":56691},[],"/docs/pr-preview/pr-81/platform/overview#automate-device-identities","Automate device identities",{"_3634":1797,"_31331":1787,"_5":31687,"_21707":56693,"_28497":56694,"_3084":56695},[],"/docs/pr-preview/pr-81/platform/overview#publish-validation-status","Publish validation status",{"_3634":1798,"_31331":1787,"_5":31687,"_21707":56697,"_28497":56698,"_3084":56699},[],"/docs/pr-preview/pr-81/platform/overview#react-to-events","React to events",{"_3634":1799,"_31331":1787,"_5":31687,"_21707":56701,"_28497":56702,"_3084":56703},[],"/docs/pr-preview/pr-81/platform/overview#operational-reference","Operational reference",{"_3634":1800,"_31331":1787,"_21707":56705,"_5":14945,"_28497":1787,"_3084":56706},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3634":1801,"_31331":1787,"_21707":56708,"_5":14945,"_28497":56663,"_3084":56709},[],"Choose the result you need:",{"_3634":1802,"_31331":1787,"_21707":56711,"_5":14945,"_28497":56663,"_3084":56712},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":1803,"_31331":1787,"_21707":56714,"_5":14945,"_28497":56663,"_3084":56715},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":1804,"_31331":1787,"_21707":56717,"_5":14945,"_28497":56663,"_3084":56718},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3634":1805,"_31331":1787,"_21707":56720,"_5":14945,"_28497":56666,"_3084":56721},[],"Section",{"_3634":1806,"_31331":1787,"_21707":56723,"_5":14945,"_28497":56666,"_3084":56724},[],"What you manage",{"_3634":1807,"_31331":1787,"_21707":56726,"_5":14945,"_28497":56666,"_3084":56727},[],"Entry point",{"_3634":1808,"_31331":1787,"_21707":56729,"_5":14945,"_28497":56666,"_3084":56730},[],"**PKI**",{"_3634":1809,"_31331":1787,"_21707":56732,"_5":14945,"_28497":56666,"_3084":56733},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3634":1810,"_31331":1787,"_21707":56735,"_5":14945,"_28497":56666,"_3084":56736},[],"PKI overview",{"_3634":1811,"_31331":1787,"_21707":56738,"_5":14945,"_28497":56666,"_3084":56739},[],"**IoT Fleets**",{"_3634":1812,"_31331":1787,"_21707":56741,"_5":14945,"_28497":56666,"_3084":56742},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3634":1813,"_31331":1787,"_21707":56744,"_5":14945,"_28497":56666,"_3084":56745},[],"IoT Fleets overview",{"_3634":1814,"_31331":1787,"_21707":56747,"_5":14945,"_28497":56666,"_3084":56748},[],"**Administration**",{"_3634":1815,"_31331":1787,"_21707":56750,"_5":14945,"_28497":56666,"_3084":56751},[],"Operator permissions, audit and event subscriptions.",{"_3634":1816,"_31331":1787,"_21707":56753,"_5":14945,"_28497":56666,"_3084":52659},[],{"_3634":1817,"_31331":1787,"_21707":56755,"_5":14945,"_28497":56666,"_3084":56756},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3634":1818,"_31331":1787,"_21707":56758,"_5":14945,"_28497":56670,"_3084":56759},[],"An identity's journey connects four responsibilities:",{"_3634":1819,"_31331":1787,"_21707":56761,"_5":14945,"_28497":56670,"_3084":56762},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3634":1820,"_31331":1787,"_21707":56764,"_5":14945,"_28497":56670,"_3084":56765},[],"The provisioning administrator configures the DMS and initial trust.",{"_3634":1821,"_31331":1787,"_21707":56767,"_5":14945,"_28497":56670,"_3084":56768},[],"The device client requests a certificate and installs it with the matching key.",{"_3634":1822,"_31331":1787,"_21707":56770,"_5":14945,"_28497":56670,"_3084":56771},[],"The consumer validates the identity and applies its access permissions.",{"_3634":1823,"_31331":1787,"_21707":56773,"_5":14945,"_28497":56670,"_3084":56774},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3634":1824,"_31331":1787,"_21707":56776,"_5":14945,"_28497":56678,"_3084":56777},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3634":1825,"_31331":1787,"_21707":56779,"_5":14945,"_28497":56682,"_3084":56780},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3634":1826,"_31331":1787,"_21707":56782,"_5":14945,"_28497":56686,"_3084":56783},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3634":1827,"_31331":1787,"_21707":56785,"_5":14945,"_28497":56690,"_3084":56786},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3634":1828,"_31331":1787,"_21707":56788,"_5":14945,"_28497":56694,"_3084":56789},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3634":1829,"_31331":1787,"_21707":56791,"_5":14945,"_28497":56698,"_3084":56792},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3634":1830,"_31331":1787,"_21707":56794,"_5":14945,"_28497":56702,"_3084":56237},[],{"_3634":1831,"_31331":1787,"_21707":56796,"_5":14945,"_28497":56702,"_3084":56797},[],"What it prepares or checks",{"_3634":1832,"_31331":1787,"_21707":56799,"_5":14945,"_28497":56702,"_3084":56240},[],{"_3634":1833,"_31331":1787,"_21707":56801,"_5":14945,"_28497":56702,"_3084":56802},[],"Key custody, CA hierarchy, profiles and validation.",{"_3634":1834,"_31331":1787,"_21707":56804,"_5":14945,"_28497":56702,"_3084":56805},[],"Fleet administrator",{"_3634":1835,"_31331":1787,"_21707":56807,"_5":14945,"_28497":56702,"_3084":56808},[],"DMS, device admission, renewal policy and inventory.",{"_3634":1836,"_31331":1787,"_21707":56810,"_5":14945,"_28497":56702,"_3084":56252},[],{"_3634":1837,"_31331":1787,"_21707":56812,"_5":14945,"_28497":56702,"_3084":56813},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3634":1838,"_31331":1787,"_21707":56815,"_5":14945,"_28497":56702,"_3084":56258},[],{"_3634":1839,"_31331":1787,"_21707":56817,"_5":14945,"_28497":56702,"_3084":56818},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3634":1840,"_31331":1787,"_21707":56820,"_5":14945,"_28497":56702,"_3084":56821},[],"Infrastructure operator",{"_3634":1841,"_31331":1787,"_21707":56823,"_5":14945,"_28497":56702,"_3084":56824},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3634":1842,"_31331":1787,"_21707":56826,"_5":14945,"_28497":56702,"_3084":56827},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3634":1843,"_31331":1843,"_5":15305,"_3084":56829,"_31690":56830,"_21707":56833,"_28497":1843},"CA hierarchy and rotation",[51145,52657,56831,56832],"PKI","Keys, authorities and certificates",[],{"_3634":1844,"_31331":1843,"_21707":56835,"_5":14945,"_28497":1843,"_3084":56836},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3634":1845,"_31331":1843,"_5":31687,"_21707":56838,"_28497":56839,"_3084":56840},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3634":1846,"_31331":1843,"_5":31687,"_21707":56842,"_28497":56843,"_3084":56844},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3634":1847,"_31331":1843,"_5":31687,"_21707":56846,"_28497":56847,"_3084":56848},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3634":1848,"_31331":1843,"_5":31687,"_21707":56850,"_28497":56851,"_3084":56852},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3634":1849,"_31331":1843,"_5":31687,"_21707":56854,"_28497":56855,"_3084":56856},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3634":1850,"_31331":1843,"_5":31687,"_21707":56858,"_28497":56859,"_3084":56860},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3634":1851,"_31331":1843,"_5":31687,"_21707":56862,"_28497":56863,"_3084":56864},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3634":1852,"_31331":1843,"_5":31687,"_21707":56866,"_28497":56867,"_3084":56868},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3634":1853,"_31331":1843,"_5":31687,"_21707":56870,"_28497":56871,"_3084":56872},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3634":1854,"_31331":1843,"_5":31687,"_21707":56874,"_28497":56875,"_3084":56876},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3634":1855,"_31331":1843,"_5":31687,"_21707":56878,"_28497":56879,"_3084":56880},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3634":1856,"_31331":1843,"_5":31687,"_21707":56882,"_28497":56883,"_3084":56884},[],"/docs/pr-preview/pr-81/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3634":1857,"_31331":1843,"_21707":56886,"_5":14945,"_28497":1843,"_3084":56887},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3634":1858,"_31331":1843,"_21707":56889,"_5":14945,"_28497":1843,"_3084":56890},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3634":1859,"_31331":1843,"_21707":56892,"_5":14945,"_28497":56839,"_3084":56893},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3634":1860,"_31331":1843,"_21707":56895,"_5":14945,"_28497":56839,"_3084":56896},[],"environment, such as production and preproduction;",{"_3634":1861,"_31331":1843,"_21707":56898,"_5":14945,"_28497":56839,"_3084":56899},[],"owner or operating team;",{"_3634":1862,"_31331":1843,"_21707":56901,"_5":14945,"_28497":56839,"_3084":56902},[],"device family or manufacturing process;",{"_3634":1863,"_31331":1843,"_21707":56904,"_5":14945,"_28497":56839,"_3084":56905},[],"region or regulatory requirement;",{"_3634":1864,"_31331":1843,"_21707":56907,"_5":14945,"_28497":56839,"_3084":56908},[],"cryptographic engine or key policy;",{"_3634":1865,"_31331":1843,"_21707":56910,"_5":14945,"_28497":56839,"_3084":56911},[],"maintenance window and renewal cadence.",{"_3634":1866,"_31331":1843,"_21707":56913,"_5":14945,"_28497":56839,"_3084":56914},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3634":1867,"_31331":1843,"_21707":56916,"_5":14945,"_28497":56839,"_3084":56917},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3634":1868,"_31331":1843,"_21707":56919,"_5":14945,"_28497":56843,"_3084":56920},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3634":1869,"_31331":1843,"_21707":56922,"_5":14945,"_28497":56843,"_3084":56923},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3634":1870,"_31331":1843,"_21707":56925,"_5":14945,"_28497":56843,"_3084":56926},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3634":1871,"_31331":1843,"_21707":56928,"_5":14945,"_28497":56843,"_3084":56929},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3634":1872,"_31331":1843,"_21707":56931,"_5":14945,"_28497":56847,"_3084":56932},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3634":1873,"_31331":1843,"_21707":56934,"_5":14945,"_28497":56847,"_3084":56935},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3634":1874,"_31331":1843,"_21707":56937,"_5":14945,"_28497":56847,"_3084":56938},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3634":1875,"_31331":1843,"_21707":56940,"_5":14945,"_28497":56847,"_3084":56941},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3634":1876,"_31331":1843,"_21707":56943,"_5":14945,"_28497":56855,"_3084":56944},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3634":1877,"_31331":1843,"_21707":56946,"_5":14945,"_28497":56859,"_3084":56947},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3634":1878,"_31331":1843,"_21707":56949,"_5":14945,"_28497":56863,"_3084":56950},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3634":1879,"_31331":1843,"_21707":56952,"_5":14945,"_28497":56867,"_3084":56953},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3634":1880,"_31331":1843,"_21707":56955,"_5":14945,"_28497":56871,"_3084":56956},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3634":1881,"_31331":1843,"_21707":56958,"_5":14945,"_28497":56875,"_3084":56959},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3634":1882,"_31331":1843,"_21707":56961,"_5":14945,"_28497":56879,"_3084":56962},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3634":1883,"_31331":1843,"_21707":56964,"_5":14945,"_28497":56879,"_3084":56965},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3634":1884,"_31331":1843,"_21707":56967,"_5":14945,"_28497":56879,"_3084":56968},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3634":1885,"_31331":1843,"_21707":56970,"_5":14945,"_28497":56879,"_3084":56971},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3634":1886,"_31331":1843,"_21707":56973,"_5":14945,"_28497":56883,"_3084":56974},[],"The new chain ends in an anchor installed by the consumer.",{"_3634":1887,"_31331":1843,"_21707":56976,"_5":14945,"_28497":56883,"_3084":56977},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3634":1888,"_31331":1843,"_21707":56979,"_5":14945,"_28497":56883,"_3084":56980},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3634":1889,"_31331":1843,"_21707":56982,"_5":14945,"_28497":56883,"_3084":56983},[],"Re-enrollment accepts the old identity during the planned period.",{"_3634":1890,"_31331":1843,"_21707":56985,"_5":14945,"_28497":56883,"_3084":56986},[],"OCSP and CRL respond for the authorities that remain active.",{"_3634":1891,"_31331":1843,"_21707":56988,"_5":14945,"_28497":56883,"_3084":56989},[],"No DMS is left accidentally issuing from the old CA.",{"_3634":1892,"_31331":1843,"_21707":56991,"_5":14945,"_28497":56883,"_3084":56992},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3634":1893,"_31331":1893,"_5":15305,"_3084":56994,"_31690":56995,"_21707":56996,"_28497":1893},"Certification authorities",[51145,52657,56831,56832],[],{"_3634":1894,"_31331":1893,"_21707":56998,"_5":14945,"_28497":1893,"_3084":56999},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3634":1895,"_31331":1893,"_5":31687,"_21707":57001,"_28497":57002,"_3084":57003},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3634":1896,"_31331":1893,"_5":31687,"_21707":57005,"_28497":57006,"_3084":57007},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3634":1897,"_31331":1893,"_5":31687,"_21707":57009,"_28497":57010,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#before-you-begin",{"_3634":1898,"_31331":1893,"_5":31687,"_21707":57012,"_28497":57013,"_3084":57014},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3634":1899,"_31331":1893,"_5":31687,"_21707":57016,"_28497":57017,"_3084":57018},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3634":1900,"_31331":1893,"_5":31687,"_21707":57020,"_28497":57021,"_3084":57022},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3634":1901,"_31331":1893,"_5":31687,"_21707":57024,"_28497":57025,"_3084":57026},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3634":1902,"_31331":1893,"_5":31687,"_21707":57028,"_28497":57029,"_3084":57030},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3634":1903,"_31331":1893,"_5":31687,"_21707":57032,"_28497":57033,"_3084":57034},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3634":1904,"_31331":1893,"_5":31687,"_21707":57036,"_28497":57037,"_3084":57038},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3634":1905,"_31331":1893,"_5":31687,"_21707":57040,"_28497":57041,"_3084":57042},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3634":1906,"_31331":1893,"_5":31687,"_21707":57044,"_28497":57045,"_3084":57046},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3634":1907,"_31331":1893,"_5":31687,"_21707":57048,"_28497":57049,"_3084":57050},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3634":1908,"_31331":1893,"_5":31687,"_21707":57052,"_28497":57053,"_3084":57054},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3634":1909,"_31331":1893,"_5":31687,"_21707":57056,"_28497":57057,"_3084":57058},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3634":1910,"_31331":1893,"_5":31687,"_21707":57060,"_28497":57061,"_3084":57062},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#ca-states","CA states",{"_3634":1911,"_31331":1893,"_5":31687,"_21707":57064,"_28497":57065,"_3084":57066},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3634":1912,"_31331":1893,"_5":31687,"_21707":57068,"_28497":57069,"_3084":57070},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3634":1913,"_31331":1893,"_5":31687,"_21707":57072,"_28497":57073,"_3084":57074},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3634":1914,"_31331":1893,"_5":31687,"_21707":57076,"_28497":57077,"_3084":57078},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3634":1915,"_31331":1893,"_5":31687,"_21707":57080,"_28497":57081,"_3084":57082},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3634":1916,"_31331":1893,"_5":31687,"_21707":57084,"_28497":57085,"_3084":57086},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3634":1917,"_31331":1893,"_5":31687,"_21707":57088,"_28497":57089,"_3084":57090},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3634":1918,"_31331":1893,"_5":31687,"_21707":57092,"_28497":57093,"_3084":57094},[],"/docs/pr-preview/pr-81/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3634":1919,"_31331":1893,"_21707":57096,"_5":14945,"_28497":1893,"_3084":57097},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3634":1920,"_31331":1893,"_21707":57099,"_5":14945,"_28497":1893,"_3084":57100},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3634":1921,"_31331":1893,"_21707":57102,"_5":14945,"_28497":1893,"_3084":57103},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3634":1922,"_31331":1893,"_21707":57105,"_5":14945,"_28497":57002,"_3084":57106},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3634":1923,"_31331":1893,"_21707":57108,"_5":14945,"_28497":57002,"_3084":57109},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3634":1924,"_31331":1893,"_21707":57111,"_5":14945,"_28497":57002,"_3084":57112},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3634":1925,"_31331":1893,"_21707":57114,"_5":14945,"_28497":57002,"_3084":57115},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3634":1926,"_31331":1893,"_21707":57117,"_5":14945,"_28497":57002,"_3084":57118},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3634":1927,"_31331":1893,"_21707":57120,"_5":14945,"_28497":57010,"_3084":57121},[],"Decide whether the CA will be a root or an intermediate.",{"_3634":1928,"_31331":1893,"_21707":57123,"_5":14945,"_28497":57010,"_3084":57124},[],"Choose the engine that will keep the key.",{"_3634":1929,"_31331":1893,"_21707":57126,"_5":14945,"_28497":57010,"_3084":57127},[],"Define a validity longer than that of the certificates it will issue.",{"_3634":1930,"_31331":1893,"_21707":57129,"_5":14945,"_28497":57010,"_3084":57130},[],"For an intermediate CA, make sure the parent CA is active.",{"_3634":1931,"_31331":1893,"_21707":57132,"_5":14945,"_28497":57013,"_3084":57133},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3634":1932,"_31331":1893,"_21707":57135,"_5":14945,"_28497":57017,"_3084":57136},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3634":1933,"_31331":1893,"_21707":57138,"_5":14945,"_28497":57017,"_3084":57139},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3634":1934,"_31331":1893,"_21707":57141,"_5":14945,"_28497":57021,"_3084":57142},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3634":1935,"_31331":1893,"_21707":57144,"_5":14945,"_28497":57025,"_3084":57145},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3634":1936,"_31331":1893,"_21707":57147,"_5":14945,"_28497":57025,"_3084":57148},[],"`C`: two-letter ISO 3166-1 country code.",{"_3634":1937,"_31331":1893,"_21707":57150,"_5":14945,"_28497":57025,"_3084":57151},[],"`ST`: state or province.",{"_3634":1938,"_31331":1893,"_21707":57153,"_5":14945,"_28497":57025,"_3084":57154},[],"`L`: locality.",{"_3634":1939,"_31331":1893,"_21707":57156,"_5":14945,"_28497":57025,"_3084":57157},[],"`O`: organization.",{"_3634":1940,"_31331":1893,"_21707":57159,"_5":14945,"_28497":57025,"_3084":57160},[],"`OU`: organizational unit.",{"_3634":1941,"_31331":1893,"_21707":57162,"_5":14945,"_28497":57025,"_3084":57163},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3634":1942,"_31331":1893,"_21707":57165,"_5":14945,"_28497":57029,"_3084":57166},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3634":1943,"_31331":1893,"_21707":57168,"_5":14945,"_28497":57029,"_3084":57169},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3634":1944,"_31331":1893,"_21707":57171,"_5":14945,"_28497":57033,"_3084":57172},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3634":1945,"_31331":1893,"_21707":57174,"_5":14945,"_28497":57033,"_3084":57175},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3634":1946,"_31331":1893,"_21707":57177,"_5":14945,"_28497":57037,"_3084":57178},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3634":1947,"_31331":1893,"_21707":57180,"_5":14945,"_28497":57037,"_3084":57181},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3634":1948,"_31331":1893,"_21707":57183,"_5":14945,"_28497":57041,"_3084":57184},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3634":1949,"_31331":1893,"_21707":57186,"_5":14945,"_28497":57041,"_3084":57187},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3634":1950,"_31331":1893,"_21707":57189,"_5":14945,"_28497":57041,"_3084":57190},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3634":1951,"_31331":1893,"_21707":57192,"_5":14945,"_28497":57041,"_3084":57193},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3634":1952,"_31331":1893,"_21707":57195,"_5":14945,"_28497":57045,"_3084":57196},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3634":1953,"_31331":1893,"_21707":57198,"_5":14945,"_28497":57049,"_3084":57199},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3634":1954,"_31331":1893,"_21707":57201,"_5":14945,"_28497":57049,"_3084":57202},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3634":1955,"_31331":1893,"_21707":57204,"_5":14945,"_28497":57053,"_3084":57205},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3634":1956,"_31331":1893,"_21707":57207,"_5":14945,"_28497":57057,"_3084":57208},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3634":1957,"_31331":1893,"_21707":57210,"_5":14945,"_28497":57057,"_3084":57211},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3634":1958,"_31331":1893,"_21707":57213,"_5":14945,"_28497":57057,"_3084":57214},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3634":1959,"_31331":1893,"_21707":57216,"_5":14945,"_28497":57061,"_3084":57217},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3634":1960,"_31331":1893,"_21707":57219,"_5":14945,"_28497":57061,"_3084":57220},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3634":1961,"_31331":1893,"_21707":57222,"_5":14945,"_28497":57061,"_3084":57223},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3634":1962,"_31331":1893,"_21707":57225,"_5":14945,"_28497":57061,"_3084":57226},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3634":1963,"_31331":1893,"_21707":57228,"_5":14945,"_28497":57065,"_3084":57229},[],"Open a CA from the inventory to review:",{"_3634":1964,"_31331":1893,"_21707":57231,"_5":14945,"_28497":57065,"_3084":57232},[],"Status and validity period.",{"_3634":1965,"_31331":1893,"_21707":57234,"_5":14945,"_28497":57065,"_3084":57235},[],"Certificate and chain in PEM format.",{"_3634":1966,"_31331":1893,"_21707":57237,"_5":14945,"_28497":57065,"_3084":57238},[],"Number of active, expired and revoked certificates.",{"_3634":1967,"_31331":1893,"_21707":57240,"_5":14945,"_28497":57065,"_3084":57241},[],"Certificates issued in **Issued Certificates**.",{"_3634":1968,"_31331":1893,"_21707":57243,"_5":14945,"_28497":57065,"_3084":57244},[],"The CRL linked to the authority.",{"_3634":1969,"_31331":1893,"_21707":57246,"_5":14945,"_28497":57065,"_3084":57247},[],"Metadata and the associated cryptographic engine.",{"_3634":1970,"_31331":1893,"_21707":57249,"_5":14945,"_28497":57065,"_3084":57250},[],"You can filter the inventory by name, status and CA type.",{"_3634":1971,"_31331":1893,"_21707":57252,"_5":14945,"_28497":57069,"_3084":57253},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3634":1972,"_31331":1893,"_21707":57255,"_5":14945,"_28497":57069,"_3084":57256},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3634":1973,"_31331":1893,"_21707":57258,"_5":14945,"_28497":57069,"_3084":57259},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3634":1974,"_31331":1893,"_21707":57261,"_5":14945,"_28497":57069,"_3084":57262},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3634":1975,"_31331":1893,"_21707":57264,"_5":14945,"_28497":57069,"_3084":57265},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3634":1976,"_31331":1893,"_21707":57267,"_5":14945,"_28497":57069,"_3084":57268},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3634":1977,"_31331":1893,"_21707":57270,"_5":14945,"_28497":57073,"_3084":57271},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3634":1978,"_31331":1893,"_21707":57273,"_5":14945,"_28497":57077,"_3084":57274},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3634":1979,"_31331":1893,"_21707":57276,"_5":14945,"_28497":57081,"_3084":57277},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3634":1980,"_31331":1893,"_21707":57279,"_5":14945,"_28497":57085,"_3084":57280},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3634":1981,"_31331":1893,"_21707":57282,"_5":14945,"_28497":57089,"_3084":57283},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3634":1982,"_31331":1893,"_21707":57285,"_5":14945,"_28497":57093,"_3084":57286},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3634":1983,"_31331":1893,"_21707":57288,"_5":14945,"_28497":57093,"_3084":57289},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3634":1984,"_31331":1893,"_21707":57291,"_5":14945,"_28497":57093,"_3084":57292},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3634":1985,"_31331":1893,"_21707":57294,"_5":14945,"_28497":57093,"_3084":57295},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3634":1986,"_31331":1893,"_21707":57297,"_5":14945,"_28497":57093,"_3084":57298},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3634":1987,"_31331":1987,"_5":15305,"_3084":57300,"_31690":57301,"_21707":57302,"_28497":1987},"Certificate profiles",[51145,52657,56831,56832],[],{"_3634":1988,"_31331":1987,"_21707":57304,"_5":14945,"_28497":1987,"_3084":57305},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3634":1989,"_31331":1987,"_5":31687,"_21707":57307,"_28497":57308,"_3084":57309},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3634":1990,"_31331":1987,"_5":31687,"_21707":57311,"_28497":57312,"_3084":57313},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#validity","Validity",{"_3634":1991,"_31331":1987,"_5":31687,"_21707":57315,"_28497":57316,"_3084":57317},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3634":1992,"_31331":1987,"_5":31687,"_21707":57319,"_28497":57320,"_3084":57321},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3634":1993,"_31331":1987,"_5":31687,"_21707":57323,"_28497":57324,"_3084":57325},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#subject","Subject",{"_3634":1994,"_31331":1987,"_5":31687,"_21707":57327,"_28497":57328,"_3084":57329},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3634":1995,"_31331":1987,"_5":31687,"_21707":57331,"_28497":57332,"_3084":57333},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3634":1996,"_31331":1987,"_5":31687,"_21707":57335,"_28497":57336,"_3084":57337},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3634":1997,"_31331":1987,"_5":31687,"_21707":57339,"_28497":57340,"_3084":57341},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3634":1998,"_31331":1987,"_5":31687,"_21707":57343,"_28497":57344,"_3084":57345},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3634":1999,"_31331":1987,"_5":31687,"_21707":57347,"_28497":57348,"_3084":57349},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3634":2000,"_31331":1987,"_5":31687,"_21707":57351,"_28497":57352,"_3084":57353},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3634":2001,"_31331":1987,"_5":31687,"_21707":57355,"_28497":57356,"_3084":57357},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3634":2002,"_31331":1987,"_5":31687,"_21707":57359,"_28497":57360,"_3084":57361},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3634":2003,"_31331":1987,"_5":31687,"_21707":57363,"_28497":57364,"_3084":57365},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#design-examples","Design examples",{"_3634":2004,"_31331":1987,"_5":31687,"_21707":57367,"_28497":57368,"_3084":57369},[],"/docs/pr-preview/pr-81/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3634":2005,"_31331":1987,"_21707":57371,"_5":14945,"_28497":1987,"_3084":57372},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3634":2006,"_31331":1987,"_21707":57374,"_5":14945,"_28497":1987,"_3084":57375},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3634":2007,"_31331":1987,"_21707":57377,"_5":14945,"_28497":57312,"_3084":57378},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3634":2008,"_31331":1987,"_21707":57380,"_5":14945,"_28497":57312,"_3084":57381},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3634":2009,"_31331":1987,"_21707":57383,"_5":14945,"_28497":57316,"_3084":57384},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3634":2010,"_31331":1987,"_21707":57386,"_5":14945,"_28497":57320,"_3084":57387},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3634":2011,"_31331":1987,"_21707":57389,"_5":14945,"_28497":57320,"_3084":57390},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3634":2012,"_31331":1987,"_21707":57392,"_5":14945,"_28497":57320,"_3084":57393},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3634":2013,"_31331":1987,"_21707":57395,"_5":14945,"_28497":57324,"_3084":57396},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3634":2014,"_31331":1987,"_21707":57398,"_5":14945,"_28497":57328,"_3084":57399},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3634":2015,"_31331":1987,"_21707":57401,"_5":14945,"_28497":57328,"_3084":57402},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3634":2016,"_31331":1987,"_21707":57404,"_5":14945,"_28497":57332,"_3084":57405},[],"The cryptographic enforcement can:",{"_3634":2017,"_31331":1987,"_21707":57407,"_5":14945,"_28497":57332,"_3084":57408},[],"allow or block RSA keys;",{"_3634":2018,"_31331":1987,"_21707":57410,"_5":14945,"_28497":57332,"_3084":57411},[],"limit the supported RSA sizes;",{"_3634":2019,"_31331":1987,"_21707":57413,"_5":14945,"_28497":57332,"_3084":57414},[],"allow or block ECDSA keys;",{"_3634":2020,"_31331":1987,"_21707":57416,"_5":14945,"_28497":57332,"_3084":57417},[],"limit the supported ECDSA sizes or curves.",{"_3634":2021,"_31331":1987,"_21707":57419,"_5":14945,"_28497":57332,"_3084":57420},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3634":2022,"_31331":1987,"_21707":57422,"_5":14945,"_28497":57336,"_3084":57423},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3634":2023,"_31331":1987,"_21707":57425,"_5":14945,"_28497":57336,"_3084":54594},[],{"_3634":2024,"_31331":1987,"_21707":57427,"_5":14945,"_28497":57336,"_3084":57428},[],"First choice",{"_3634":2025,"_31331":1987,"_21707":57430,"_5":14945,"_28497":57336,"_3084":57431},[],"Second choice",{"_3634":2026,"_31331":1987,"_21707":57433,"_5":14945,"_28497":57336,"_3084":57434},[],"If neither is supplied",{"_3634":2027,"_31331":1987,"_21707":57436,"_5":14945,"_28497":57336,"_3084":57437},[],"Direct signing with a CA",{"_3634":2028,"_31331":1987,"_21707":57439,"_5":14945,"_28497":57336,"_3084":57440},[],"`issuance_profile` embedded in the request",{"_3634":2029,"_31331":1987,"_21707":57442,"_5":14945,"_28497":57336,"_3084":57443},[],"Request `issuance_profile_id`",{"_3634":2030,"_31331":1987,"_21707":57445,"_5":14945,"_28497":57336,"_3084":57446},[],"CA default profile (`profile_id`).",{"_3634":2031,"_31331":1987,"_21707":57448,"_5":14945,"_28497":57336,"_3084":57449},[],"Issuance through a DMS",{"_3634":2032,"_31331":1987,"_21707":57451,"_5":14945,"_28497":57336,"_3084":57452},[],"`settings.issuance_profile_id`",{"_3634":2033,"_31331":1987,"_21707":57454,"_5":14945,"_28497":57336,"_3084":57455},[],"`settings.issuance_profile` embedded in the DMS",{"_3634":2034,"_31331":1987,"_21707":57457,"_5":14945,"_28497":57336,"_3084":57458},[],"Enrollment CA default profile.",{"_3634":2035,"_31331":1987,"_21707":57460,"_5":14945,"_28497":57336,"_3084":57461},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3634":2036,"_31331":1987,"_21707":57463,"_5":14945,"_28497":57336,"_3084":57464},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3634":2037,"_31331":1987,"_21707":57466,"_5":14945,"_28497":57344,"_3084":57467},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3634":2038,"_31331":1987,"_21707":57469,"_5":14945,"_28497":57348,"_3084":57470},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3634":2039,"_31331":1987,"_21707":57472,"_5":14945,"_28497":57352,"_3084":57473},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3634":2040,"_31331":1987,"_21707":57475,"_5":14945,"_28497":57356,"_3084":57476},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3634":2041,"_31331":1987,"_21707":57478,"_5":14945,"_28497":57360,"_3084":57479},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3634":2042,"_31331":1987,"_21707":57481,"_5":14945,"_28497":57360,"_3084":57482},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3634":2043,"_31331":1987,"_21707":57484,"_5":14945,"_28497":57364,"_3084":57485},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3634":2044,"_31331":1987,"_21707":57487,"_5":14945,"_28497":57364,"_3084":57488},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3634":2045,"_31331":1987,"_21707":57490,"_5":14945,"_28497":57364,"_3084":57491},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3634":2046,"_31331":1987,"_21707":57493,"_5":14945,"_28497":57364,"_3084":57494},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3634":2047,"_31331":1987,"_21707":57496,"_5":14945,"_28497":57368,"_3084":57497},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3634":2048,"_31331":1987,"_21707":57499,"_5":14945,"_28497":57368,"_3084":57500},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3634":2049,"_31331":2049,"_5":15305,"_3084":57502,"_31690":57503,"_21707":57505,"_28497":2049},"Certificate validation",[51145,52657,56831,57504],"Validation",[],{"_3634":2050,"_31331":2049,"_21707":57507,"_5":14945,"_28497":2049,"_3084":57508},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3634":2051,"_31331":2049,"_5":31687,"_21707":57510,"_28497":57511,"_3084":57512},[],"/docs/pr-preview/pr-81/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3634":2052,"_31331":2049,"_5":31687,"_21707":57514,"_28497":57515,"_3084":57516},[],"/docs/pr-preview/pr-81/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3634":2053,"_31331":2049,"_5":31687,"_21707":57518,"_28497":57519,"_3084":57520},[],"/docs/pr-preview/pr-81/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3634":2054,"_31331":2049,"_21707":57522,"_5":14945,"_28497":2049,"_3084":57523},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3634":2055,"_31331":2049,"_21707":57525,"_5":14945,"_28497":57511,"_3084":57526},[],"Verify these criteria together:",{"_3634":2056,"_31331":2049,"_21707":57528,"_5":14945,"_28497":57511,"_3084":56457},[],{"_3634":2057,"_31331":2049,"_21707":57530,"_5":14945,"_28497":57511,"_3084":57531},[],"Required result",{"_3634":2058,"_31331":2049,"_21707":57533,"_5":14945,"_28497":57511,"_3084":57534},[],"Chain and signature",{"_3634":2059,"_31331":2049,"_21707":57536,"_5":14945,"_28497":57511,"_3084":57537},[],"Valid chain to a root deliberately installed in the consumer.",{"_3634":2060,"_31331":2049,"_21707":57539,"_5":14945,"_28497":57511,"_3084":57540},[],"Dates",{"_3634":2061,"_31331":2049,"_21707":57542,"_5":14945,"_28497":57511,"_3084":57543},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3634":2062,"_31331":2049,"_21707":57545,"_5":14945,"_28497":57511,"_3084":52326},[],{"_3634":2063,"_31331":2049,"_21707":57547,"_5":14945,"_28497":57511,"_3084":57548},[],"Name, SAN or identifier matches the expected peer.",{"_3634":2064,"_31331":2049,"_21707":57550,"_5":14945,"_28497":57511,"_3084":51535},[],{"_3634":2065,"_31331":2049,"_21707":57552,"_5":14945,"_28497":57511,"_3084":57553},[],"KU, EKU and constraints permit the specific operation.",{"_3634":2066,"_31331":2049,"_21707":57555,"_5":14945,"_28497":57511,"_3084":57556},[],"Revocation",{"_3634":2067,"_31331":2049,"_21707":57558,"_5":14945,"_28497":57511,"_3084":57559},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3634":2068,"_31331":2049,"_21707":57561,"_5":14945,"_28497":57511,"_3084":57562},[],"Authorization",{"_3634":2069,"_31331":2049,"_21707":57564,"_5":14945,"_28497":57511,"_3084":57565},[],"The application permits that identity to perform the action.",{"_3634":2070,"_31331":2049,"_21707":57567,"_5":14945,"_28497":57511,"_3084":57568},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3634":2071,"_31331":2049,"_21707":57570,"_5":14945,"_28497":57515,"_3084":57571},[],"Mechanism",{"_3634":2072,"_31331":2049,"_21707":57573,"_5":14945,"_28497":57515,"_3084":57574},[],"When to use it",{"_3634":2073,"_31331":2049,"_21707":57576,"_5":14945,"_28497":57515,"_3084":57577},[],"What you must maintain",{"_3634":2074,"_31331":2049,"_21707":57579,"_5":14945,"_28497":57515,"_3084":57580},[],"OCSP",{"_3634":2075,"_31331":2049,"_21707":57582,"_5":14945,"_28497":57515,"_3084":57583},[],"Status query for a specific certificate.",{"_3634":2076,"_31331":2049,"_21707":57585,"_5":14945,"_28497":57515,"_3084":57586},[],"Responder access, signature verification and cache/freshness policy.",{"_3634":2077,"_31331":2049,"_21707":57588,"_5":14945,"_28497":57515,"_3084":57589},[],"CRL",{"_3634":2078,"_31331":2049,"_21707":57591,"_5":14945,"_28497":57515,"_3084":57592},[],"Local checks for many certificates or offline operation.",{"_3634":2079,"_31331":2049,"_21707":57594,"_5":14945,"_28497":57515,"_3084":57595},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3634":2080,"_31331":2049,"_21707":57597,"_5":14945,"_28497":57515,"_3084":57598},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3634":2081,"_31331":2049,"_21707":57600,"_5":14945,"_28497":57515,"_3084":57601},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3634":2082,"_31331":2049,"_21707":57603,"_5":14945,"_28497":57519,"_3084":57604},[],"Accept a current, authorized certificate with a known chain.",{"_3634":2083,"_31331":2049,"_21707":57606,"_5":14945,"_28497":57519,"_3084":57607},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3634":2084,"_31331":2049,"_21707":57609,"_5":14945,"_28497":57519,"_3084":57610},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3634":2085,"_31331":2049,"_21707":57612,"_5":14945,"_28497":57519,"_3084":57613},[],"Check that a new connection with that identity is rejected.",{"_3634":2086,"_31331":2049,"_21707":57615,"_5":14945,"_28497":57519,"_3084":57616},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3634":2087,"_31331":2049,"_21707":57618,"_5":14945,"_28497":57519,"_3084":57619},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3634":2088,"_31331":2049,"_21707":57621,"_5":14945,"_28497":57519,"_3084":57622},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3634":2089,"_31331":2049,"_21707":57624,"_5":14945,"_28497":57519,"_3084":57625},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":2090,"_31331":2049,"_21707":57627,"_5":14945,"_28497":57519,"_3084":57628},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3634":2091,"_31331":2091,"_5":15305,"_3084":57630,"_31690":57631,"_21707":57632,"_28497":2091},"Certificates",[51145,52657,56831,56832],[],{"_3634":2092,"_31331":2091,"_21707":57634,"_5":14945,"_28497":2091,"_3084":57635},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3634":2093,"_31331":2091,"_5":31687,"_21707":57637,"_28497":57638,"_3084":57639},[],"/docs/pr-preview/pr-81/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3634":2094,"_31331":2091,"_5":31687,"_21707":57641,"_28497":57642,"_3084":57643},[],"/docs/pr-preview/pr-81/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3634":2095,"_31331":2091,"_5":31687,"_21707":57645,"_28497":57646,"_3084":57647},[],"/docs/pr-preview/pr-81/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3634":2096,"_31331":2091,"_5":31687,"_21707":57649,"_28497":57650,"_3084":57651},[],"/docs/pr-preview/pr-81/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3634":2097,"_31331":2091,"_5":31687,"_21707":57653,"_28497":57654,"_3084":57655},[],"/docs/pr-preview/pr-81/platform/pki/certificates#open-the-action","Open the action",{"_3634":2098,"_31331":2091,"_5":31687,"_21707":57657,"_28497":57658,"_3084":57659},[],"/docs/pr-preview/pr-81/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3634":2099,"_31331":2091,"_5":31687,"_21707":57661,"_28497":57662,"_3084":57663},[],"/docs/pr-preview/pr-81/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3634":2100,"_31331":2091,"_5":31687,"_21707":57665,"_28497":57666,"_3084":57667},[],"/docs/pr-preview/pr-81/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3634":2101,"_31331":2091,"_5":31687,"_21707":57669,"_28497":57670,"_3084":57671},[],"/docs/pr-preview/pr-81/platform/pki/certificates#continue","Continue",{"_3634":2102,"_31331":2091,"_21707":57673,"_5":14945,"_28497":2091,"_3084":57674},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3634":2103,"_31331":2091,"_21707":57676,"_5":14945,"_28497":57638,"_3084":57677},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3634":2104,"_31331":2091,"_21707":57679,"_5":14945,"_28497":57638,"_3084":57680},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3634":2105,"_31331":2091,"_21707":57682,"_5":14945,"_28497":57638,"_3084":57683},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3634":2106,"_31331":2091,"_21707":57685,"_5":14945,"_28497":57638,"_3084":57686},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3634":2107,"_31331":2091,"_21707":57688,"_5":14945,"_28497":57638,"_3084":57689},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3634":2108,"_31331":2091,"_21707":57691,"_5":14945,"_28497":57638,"_3084":57692},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3634":2109,"_31331":2091,"_21707":57694,"_5":14945,"_28497":57638,"_3084":57695},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3634":2110,"_31331":2091,"_21707":57697,"_5":14945,"_28497":57642,"_3084":57698},[],"Download the PEM and inspect it:",{"_3634":2111,"_31331":2091,"_21707":57700,"_5":14945,"_28497":57642,"_3084":57701},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3634":2112,"_31331":2091,"_21707":57703,"_5":14945,"_28497":57646,"_3084":57704},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3634":2113,"_31331":2091,"_21707":57706,"_5":14945,"_28497":57646,"_3084":57707},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3634":2114,"_31331":2091,"_21707":57709,"_5":14945,"_28497":57646,"_3084":57710},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3634":2115,"_31331":2091,"_21707":57712,"_5":14945,"_28497":57646,"_3084":57713},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3634":2116,"_31331":2091,"_21707":57715,"_5":14945,"_28497":57646,"_3084":57716},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3634":2117,"_31331":2091,"_21707":57718,"_5":14945,"_28497":57646,"_3084":57719},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3634":2118,"_31331":2091,"_21707":57721,"_5":14945,"_28497":57646,"_3084":57722},[],"For browser key generation, follow Issue your first certificate.",{"_3634":2119,"_31331":2091,"_21707":57724,"_5":14945,"_28497":57650,"_3084":57725},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3634":2120,"_31331":2091,"_21707":57727,"_5":14945,"_28497":57654,"_3084":57728},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3634":2121,"_31331":2091,"_21707":57730,"_5":14945,"_28497":57658,"_3084":57731},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3634":2122,"_31331":2091,"_21707":57733,"_5":14945,"_28497":57662,"_3084":57734},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3634":2123,"_31331":2091,"_21707":57736,"_5":14945,"_28497":57662,"_3084":57737},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3634":2124,"_31331":2091,"_21707":57739,"_5":14945,"_28497":57662,"_3084":57740},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3634":2125,"_31331":2091,"_21707":57742,"_5":14945,"_28497":57666,"_3084":57743},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3634":2126,"_31331":2091,"_21707":57745,"_5":14945,"_28497":57666,"_3084":57746},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3634":2127,"_31331":2091,"_21707":57748,"_5":14945,"_28497":57666,"_3084":57749},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3634":2128,"_31331":2091,"_21707":57751,"_5":14945,"_28497":57670,"_3084":57752},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":2129,"_31331":2091,"_21707":57754,"_5":14945,"_28497":57670,"_3084":57755},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3634":2130,"_31331":2130,"_5":15305,"_3084":57757,"_31690":57758,"_21707":57760,"_28497":2130},"Certificate lifecycle",[51145,52657,56831,57759],"Concepts",[],{"_3634":2131,"_31331":2130,"_21707":57762,"_5":14945,"_28497":2130,"_3084":57763},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3634":2132,"_31331":2130,"_5":31687,"_21707":57765,"_28497":57766,"_3084":57767},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3634":2133,"_31331":2130,"_5":31687,"_21707":57769,"_28497":57770,"_3084":57771},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3634":2134,"_31331":2130,"_5":31687,"_21707":57773,"_28497":57774,"_3084":57775},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3634":2135,"_31331":2130,"_5":31687,"_21707":57777,"_28497":57778,"_3084":57779},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3634":2136,"_31331":2130,"_5":31687,"_21707":57781,"_28497":57782,"_3084":57783},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3634":2137,"_31331":2130,"_5":31687,"_21707":57785,"_28497":57786,"_3084":57787},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3634":2138,"_31331":2130,"_5":31687,"_21707":57789,"_28497":57790,"_3084":57791},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3634":2139,"_31331":2130,"_5":31687,"_21707":57793,"_28497":57794,"_3084":57795},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3634":2140,"_31331":2130,"_5":31687,"_21707":57797,"_28497":57798,"_3084":57799},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3634":2141,"_31331":2130,"_5":31687,"_21707":57801,"_28497":57802,"_3084":57803},[],"/docs/pr-preview/pr-81/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3634":2142,"_31331":2130,"_21707":57805,"_5":14945,"_28497":2130,"_3084":57806},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3634":2143,"_31331":2130,"_21707":57808,"_5":14945,"_28497":57770,"_3084":57809},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3634":2144,"_31331":2130,"_21707":57811,"_5":14945,"_28497":57774,"_3084":57812},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3634":2145,"_31331":2130,"_21707":57814,"_5":14945,"_28497":57778,"_3084":57815},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3634":2146,"_31331":2130,"_21707":57817,"_5":14945,"_28497":57782,"_3084":57818},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3634":2147,"_31331":2130,"_21707":57820,"_5":14945,"_28497":57786,"_3084":57821},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3634":2148,"_31331":2130,"_21707":57823,"_5":14945,"_28497":57790,"_3084":57824},[],"Lamassu persists four X.509 states:",{"_3634":2149,"_31331":2130,"_21707":57826,"_5":14945,"_28497":57790,"_3084":57827},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3634":2150,"_31331":2130,"_21707":57829,"_5":14945,"_28497":57790,"_3084":57830},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3634":2151,"_31331":2130,"_21707":57832,"_5":14945,"_28497":57790,"_3084":57833},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3634":2152,"_31331":2130,"_21707":57835,"_5":14945,"_28497":57790,"_3084":57836},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3634":2153,"_31331":2130,"_21707":57838,"_5":14945,"_28497":57790,"_3084":57839},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3634":2154,"_31331":2130,"_21707":57841,"_5":14945,"_28497":57794,"_3084":57842},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3634":2155,"_31331":2130,"_21707":57844,"_5":14945,"_28497":57794,"_3084":57845},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3634":2156,"_31331":2130,"_21707":57847,"_5":14945,"_28497":57794,"_3084":57848},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3634":2157,"_31331":2130,"_21707":57850,"_5":14945,"_28497":57798,"_3084":57851},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3634":2158,"_31331":2130,"_21707":57853,"_5":14945,"_28497":57798,"_3084":57854},[],"Before confirming:",{"_3634":2159,"_31331":2130,"_21707":57856,"_5":14945,"_28497":57798,"_3084":57857},[],"Identify DMSs, devices and services that trust that chain.",{"_3634":2160,"_31331":2130,"_21707":57859,"_5":14945,"_28497":57798,"_3084":57860},[],"Distribute the new chain of trust.",{"_3634":2161,"_31331":2130,"_21707":57862,"_5":14945,"_28497":57798,"_3084":57863},[],"Reissue the necessary identities.",{"_3634":2162,"_31331":2130,"_21707":57865,"_5":14945,"_28497":57798,"_3084":57866},[],"Check OCSP and CRL from a real consumer.",{"_3634":2163,"_31331":2130,"_21707":57868,"_5":14945,"_28497":57798,"_3084":57869},[],"Revoke the old CA once no legitimate traffic remains.",{"_3634":2164,"_31331":2130,"_21707":57871,"_5":14945,"_28497":57798,"_3084":57872},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3634":2165,"_31331":2130,"_21707":57874,"_5":14945,"_28497":57802,"_3084":57875},[],"Certificates entering the preventive or critical renewal window.",{"_3634":2166,"_31331":2130,"_21707":57877,"_5":14945,"_28497":57802,"_3084":57878},[],"Repeated enrollment or re-enrollment failures.",{"_3634":2167,"_31331":2130,"_21707":57880,"_5":14945,"_28497":57802,"_3084":57881},[],"Status changes and revocation reasons.",{"_3634":2168,"_31331":2130,"_21707":57883,"_5":14945,"_28497":57802,"_3084":57884},[],"OCSP and CRL publication and validity.",{"_3634":2169,"_31331":2130,"_21707":57886,"_5":14945,"_28497":57802,"_3084":57887},[],"Dependencies still presenting a replaced certificate.",{"_3634":2170,"_31331":2130,"_21707":57889,"_5":14945,"_28497":57802,"_3084":57890},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3634":2171,"_31331":2171,"_5":15305,"_3084":57892,"_31690":57893,"_21707":57894,"_28497":2171},"Trust model",[51145,52657,56831,57759],[],{"_3634":2172,"_31331":2171,"_21707":57896,"_5":14945,"_28497":2171,"_3084":57897},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3634":2173,"_31331":2171,"_5":31687,"_21707":57899,"_28497":57900,"_3084":57901},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3634":2174,"_31331":2171,"_5":31687,"_21707":57903,"_28497":57904,"_3084":57905},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3634":2175,"_31331":2171,"_5":31687,"_21707":57907,"_28497":57908,"_3084":57909},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3634":2176,"_31331":2171,"_5":31687,"_21707":57911,"_28497":57912,"_3084":57913},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3634":2177,"_31331":2171,"_5":31687,"_21707":57915,"_28497":57916,"_3084":57917},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3634":2178,"_31331":2171,"_5":31687,"_21707":57919,"_28497":57920,"_3084":57921},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3634":2179,"_31331":2171,"_5":31687,"_21707":57923,"_28497":57924,"_3084":57925},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3634":2180,"_31331":2171,"_5":31687,"_21707":57927,"_28497":57928,"_3084":57929},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3634":2181,"_31331":2171,"_5":31687,"_21707":57931,"_28497":57932,"_3084":57933},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3634":2182,"_31331":2171,"_5":31687,"_21707":57935,"_28497":57936,"_3084":57937},[],"/docs/pr-preview/pr-81/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3634":2183,"_31331":2171,"_21707":57939,"_5":14945,"_28497":2171,"_3084":57940},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3634":2184,"_31331":2171,"_21707":57942,"_5":14945,"_28497":57904,"_3084":57943},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3634":2185,"_31331":2171,"_21707":57945,"_5":14945,"_28497":57908,"_3084":57946},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3634":2186,"_31331":2171,"_21707":57948,"_5":14945,"_28497":57912,"_3084":57949},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3634":2187,"_31331":2171,"_21707":57951,"_5":14945,"_28497":57916,"_3084":57952},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3634":2188,"_31331":2171,"_21707":57954,"_5":14945,"_28497":57920,"_3084":57955},[],"The device proves it can enroll according to the DMS policy.",{"_3634":2189,"_31331":2171,"_21707":57957,"_5":14945,"_28497":57920,"_3084":57958},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3634":2190,"_31331":2171,"_21707":57960,"_5":14945,"_28497":57920,"_3084":57961},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3634":2191,"_31331":2171,"_21707":57963,"_5":14945,"_28497":57920,"_3084":57964},[],"The device installs the certificate and the chain it needs.",{"_3634":2192,"_31331":2171,"_21707":57966,"_5":14945,"_28497":57920,"_3084":57967},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3634":2193,"_31331":2171,"_21707":57969,"_5":14945,"_28497":57920,"_3084":57970},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3634":2194,"_31331":2171,"_21707":57972,"_5":14945,"_28497":57924,"_3084":57973},[],"A DMS relates three sets that are worth designing separately:",{"_3634":2195,"_31331":2171,"_21707":57975,"_5":14945,"_28497":57924,"_3084":57976},[],"**Enrollment CA:** signs the new identities.",{"_3634":2196,"_31331":2171,"_21707":57978,"_5":14945,"_28497":57924,"_3084":57979},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3634":2197,"_31331":2171,"_21707":57981,"_5":14945,"_28497":57924,"_3084":57982},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3634":2198,"_31331":2171,"_21707":57984,"_5":14945,"_28497":57924,"_3084":57985},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3634":2199,"_31331":2171,"_21707":57987,"_5":14945,"_28497":57928,"_3084":57988},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3634":2200,"_31331":2171,"_21707":57990,"_5":14945,"_28497":57928,"_3084":57991},[],"that the current date is between `Not Before` and `Not After`;",{"_3634":2201,"_31331":2171,"_21707":57993,"_5":14945,"_28497":57928,"_3084":57994},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3634":2202,"_31331":2171,"_21707":57996,"_5":14945,"_28497":57928,"_3084":57997},[],"that names, SANs and subject match the expected identity;",{"_3634":2203,"_31331":2171,"_21707":57999,"_5":14945,"_28497":57928,"_3084":58000},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3634":2204,"_31331":2171,"_21707":58002,"_5":14945,"_28497":57928,"_3084":58003},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3634":2205,"_31331":2171,"_21707":58005,"_5":14945,"_28497":57928,"_3084":58006},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3634":2206,"_31331":2171,"_21707":58008,"_5":14945,"_28497":57932,"_3084":58009},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3634":2207,"_31331":2171,"_21707":58011,"_5":14945,"_28497":57936,"_3084":58012},[],"Keep the root out of daily operations, or with very restricted access.",{"_3634":2208,"_31331":2171,"_21707":58014,"_5":14945,"_28497":57936,"_3084":58015},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3634":2209,"_31331":2171,"_21707":58017,"_5":14945,"_28497":57936,"_3084":58018},[],"Assign explicit profiles to every use case.",{"_3634":2210,"_31331":2171,"_21707":58020,"_5":14945,"_28497":57936,"_3084":58021},[],"Distribute the new trust before starting a rotation.",{"_3634":2211,"_31331":2171,"_21707":58023,"_5":14945,"_28497":57936,"_3084":58024},[],"Keep enough overlap to renew a disconnected fleet.",{"_3634":2212,"_31331":2171,"_21707":58026,"_5":14945,"_28497":57936,"_3084":58027},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3634":2213,"_31331":2171,"_21707":58029,"_5":14945,"_28497":57936,"_3084":58030},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3634":2214,"_31331":2214,"_5":15305,"_3084":58032,"_31690":58033,"_21707":58034,"_28497":2214},"Revocation lists (CRL)",[51145,52657,56831,57504],[],{"_3634":2215,"_31331":2214,"_21707":58036,"_5":14945,"_28497":2214,"_3084":58037},[],"Generate and distribute signed lists to validate certificates offline.",{"_3634":2216,"_31331":2214,"_5":31687,"_21707":58039,"_28497":58040,"_3084":58041},[],"/docs/pr-preview/pr-81/platform/pki/crl#crl-settings","CRL settings",{"_3634":2217,"_31331":2214,"_5":31687,"_21707":58043,"_28497":58044,"_3084":58045},[],"/docs/pr-preview/pr-81/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3634":2218,"_31331":2214,"_5":31687,"_21707":58047,"_28497":58048,"_3084":58049},[],"/docs/pr-preview/pr-81/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3634":2219,"_31331":2214,"_5":31687,"_21707":58051,"_28497":58052,"_3084":58053},[],"/docs/pr-preview/pr-81/platform/pki/crl#crl-contents","CRL contents",{"_3634":2220,"_31331":2214,"_5":31687,"_21707":58055,"_28497":58056,"_3084":58057},[],"/docs/pr-preview/pr-81/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3634":2221,"_31331":2214,"_5":31687,"_21707":58059,"_28497":58060,"_3084":58061},[],"/docs/pr-preview/pr-81/platform/pki/crl#crl-settings-api","CRL settings API",{"_3634":2222,"_31331":2214,"_5":31687,"_21707":58063,"_28497":58064,"_3084":58065},[],"/docs/pr-preview/pr-81/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3634":2223,"_31331":2214,"_5":31687,"_21707":58067,"_28497":58068,"_3084":58069},[],"/docs/pr-preview/pr-81/platform/pki/crl#references","References",{"_3634":2224,"_31331":2214,"_21707":58071,"_5":14945,"_28497":2214,"_3084":58072},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3634":2225,"_31331":2214,"_21707":58074,"_5":14945,"_28497":58040,"_3084":58075},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3634":2226,"_31331":2214,"_21707":58077,"_5":14945,"_28497":58040,"_3084":58078},[],"Field",{"_3634":2227,"_31331":2214,"_21707":58080,"_5":14945,"_28497":58040,"_3084":51535},[],{"_3634":2228,"_31331":2214,"_21707":58082,"_5":14945,"_28497":58040,"_3084":52777},[],{"_3634":2229,"_31331":2214,"_21707":58084,"_5":14945,"_28497":58040,"_3084":58085},[],"ID of the CA the settings belong to.",{"_3634":2230,"_31331":2214,"_21707":58087,"_5":14945,"_28497":58040,"_3084":58088},[],"`status`",{"_3634":2231,"_31331":2214,"_21707":58090,"_5":14945,"_28497":58040,"_3084":58091},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3634":2232,"_31331":2214,"_21707":58093,"_5":14945,"_28497":58040,"_3084":58094},[],"`legacy_ski`",{"_3634":2233,"_31331":2214,"_21707":58096,"_5":14945,"_28497":58040,"_3084":58097},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3634":2234,"_31331":2214,"_21707":58099,"_5":14945,"_28497":58040,"_3084":58100},[],"`latest_crl`",{"_3634":2235,"_31331":2214,"_21707":58102,"_5":14945,"_28497":58040,"_3084":58103},[],"Version, validity start and end of the last published list. Read-only.",{"_3634":2236,"_31331":2214,"_21707":58105,"_5":14945,"_28497":58040,"_3084":58106},[],"`crl_options` field",{"_3634":2237,"_31331":2214,"_21707":58108,"_5":14945,"_28497":58040,"_3084":51535},[],{"_3634":2238,"_31331":2214,"_21707":58110,"_5":14945,"_28497":58040,"_3084":58111},[],"Initial value",{"_3634":2239,"_31331":2214,"_21707":58113,"_5":14945,"_28497":58040,"_3084":58114},[],"`validity`",{"_3634":2240,"_31331":2214,"_21707":58116,"_5":14945,"_28497":58040,"_3084":58117},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3634":2241,"_31331":2214,"_21707":58119,"_5":14945,"_28497":58040,"_3084":58120},[],"7 days.",{"_3634":2242,"_31331":2214,"_21707":58122,"_5":14945,"_28497":58040,"_3084":58123},[],"`refresh_interval`",{"_3634":2243,"_31331":2214,"_21707":58125,"_5":14945,"_28497":58040,"_3084":58126},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3634":2244,"_31331":2214,"_21707":58128,"_5":14945,"_28497":58040,"_3084":58129},[],"6 days and 23 hours.",{"_3634":2245,"_31331":2214,"_21707":58131,"_5":14945,"_28497":58040,"_3084":58132},[],"`regenerate_on_revoke`",{"_3634":2246,"_31331":2214,"_21707":58134,"_5":14945,"_28497":58040,"_3084":58135},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3634":2247,"_31331":2214,"_21707":58137,"_5":14945,"_28497":58040,"_3084":58138},[],"`true`.",{"_3634":2248,"_31331":2214,"_21707":58140,"_5":14945,"_28497":58040,"_3084":58141},[],"`signer_serial_number`",{"_3634":2249,"_31331":2214,"_21707":58143,"_5":14945,"_28497":58040,"_3084":58144},[],"Serial number of the existing certificate that signs the CRL.",{"_3634":2250,"_31331":2214,"_21707":58146,"_5":14945,"_28497":58040,"_3084":58147},[],"Serial number of the CA’s current certificate.",{"_3634":2251,"_31331":2214,"_21707":58149,"_5":14945,"_28497":58040,"_3084":58150},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3634":2252,"_31331":2214,"_21707":58152,"_5":14945,"_28497":58040,"_3084":58153},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3634":2253,"_31331":2214,"_21707":58155,"_5":14945,"_28497":58040,"_3084":58156},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3634":2254,"_31331":2214,"_21707":58158,"_5":14945,"_28497":58040,"_3084":58159},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3634":2255,"_31331":2214,"_21707":58161,"_5":14945,"_28497":58040,"_3084":58162},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3634":2256,"_31331":2214,"_21707":58164,"_5":14945,"_28497":58040,"_3084":58165},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3634":2257,"_31331":2214,"_21707":58167,"_5":14945,"_28497":58040,"_3084":58168},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3634":2258,"_31331":2214,"_21707":58170,"_5":14945,"_28497":58040,"_3084":58171},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3634":2259,"_31331":2214,"_21707":58173,"_5":14945,"_28497":58040,"_3084":58174},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3634":2260,"_31331":2214,"_21707":58176,"_5":14945,"_28497":58040,"_3084":58177},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3634":2261,"_31331":2214,"_21707":58179,"_5":14945,"_28497":58040,"_3084":58180},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3634":2262,"_31331":2214,"_21707":58182,"_5":14945,"_28497":58044,"_3084":58183},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3634":2263,"_31331":2214,"_21707":58185,"_5":14945,"_28497":58044,"_3084":58186},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3634":2264,"_31331":2214,"_21707":58188,"_5":14945,"_28497":58044,"_3084":58189},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3634":2265,"_31331":2214,"_21707":58191,"_5":14945,"_28497":58044,"_3084":58192},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3634":2266,"_31331":2214,"_21707":58194,"_5":14945,"_28497":58048,"_3084":58195},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3634":2267,"_31331":2214,"_21707":58197,"_5":14945,"_28497":58048,"_3084":58198},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3634":2268,"_31331":2214,"_21707":58200,"_5":14945,"_28497":58048,"_3084":58201},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3634":2269,"_31331":2214,"_21707":58203,"_5":14945,"_28497":58048,"_3084":58204},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3634":2270,"_31331":2214,"_21707":58206,"_5":14945,"_28497":58048,"_3084":58207},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3634":2271,"_31331":2214,"_21707":58209,"_5":14945,"_28497":58048,"_3084":58210},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3634":2272,"_31331":2214,"_21707":58212,"_5":14945,"_28497":58048,"_3084":58213},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3634":2273,"_31331":2214,"_21707":58215,"_5":14945,"_28497":58048,"_3084":58216},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3634":2274,"_31331":2214,"_21707":58218,"_5":14945,"_28497":58048,"_3084":58219},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3634":2275,"_31331":2214,"_21707":58221,"_5":14945,"_28497":58052,"_3084":58222},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3634":2276,"_31331":2214,"_21707":58224,"_5":14945,"_28497":58052,"_3084":58225},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3634":2277,"_31331":2214,"_21707":58227,"_5":14945,"_28497":58056,"_3084":58228},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3634":2278,"_31331":2214,"_21707":58230,"_5":14945,"_28497":58056,"_3084":58231},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3634":2279,"_31331":2214,"_21707":58233,"_5":14945,"_28497":58056,"_3084":58234},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3634":2280,"_31331":2214,"_21707":58236,"_5":14945,"_28497":58056,"_3084":58237},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3634":2281,"_31331":2214,"_21707":58239,"_5":14945,"_28497":58056,"_3084":58240},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3634":2282,"_31331":2214,"_21707":58242,"_5":14945,"_28497":58060,"_3084":58243},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3634":2283,"_31331":2214,"_21707":58245,"_5":14945,"_28497":58060,"_3084":54597},[],{"_3634":2284,"_31331":2214,"_21707":58247,"_5":14945,"_28497":58060,"_3084":58248},[],"Relative path",{"_3634":2285,"_31331":2214,"_21707":58250,"_5":14945,"_28497":58060,"_3084":54594},[],{"_3634":2286,"_31331":2214,"_21707":58252,"_5":14945,"_28497":58060,"_3084":58253},[],"`GET`",{"_3634":2287,"_31331":2214,"_21707":58255,"_5":14945,"_28497":58060,"_3084":58256},[],"`/v1/crl-settings`",{"_3634":2288,"_31331":2214,"_21707":58258,"_5":14945,"_28497":58060,"_3084":58259},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3634":2289,"_31331":2214,"_21707":58261,"_5":14945,"_28497":58060,"_3084":58253},[],{"_3634":2290,"_31331":2214,"_21707":58263,"_5":14945,"_28497":58060,"_3084":58264},[],"`/v1/crl-settings/{ca-id}`",{"_3634":2291,"_31331":2214,"_21707":58266,"_5":14945,"_28497":58060,"_3084":58267},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3634":2292,"_31331":2214,"_21707":58269,"_5":14945,"_28497":58060,"_3084":58270},[],"`PUT`",{"_3634":2293,"_31331":2214,"_21707":58272,"_5":14945,"_28497":58060,"_3084":58264},[],{"_3634":2294,"_31331":2214,"_21707":58274,"_5":14945,"_28497":58060,"_3084":58275},[],"Replace the CRL configuration of a CA.",{"_3634":2295,"_31331":2214,"_21707":58277,"_5":14945,"_28497":58060,"_3084":58278},[],"`DELETE`",{"_3634":2296,"_31331":2214,"_21707":58280,"_5":14945,"_28497":58060,"_3084":58264},[],{"_3634":2297,"_31331":2214,"_21707":58282,"_5":14945,"_28497":58060,"_3084":58283},[],"Remove the archived CRL settings of a CA.",{"_3634":2298,"_31331":2214,"_21707":58285,"_5":14945,"_28497":58060,"_3084":58286},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3634":2299,"_31331":2214,"_21707":58288,"_5":14945,"_28497":58060,"_3084":58289},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3634":2300,"_31331":2214,"_21707":58291,"_5":14945,"_28497":58060,"_3084":58292},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3634":2301,"_31331":2214,"_21707":58294,"_5":14945,"_28497":58064,"_3084":58295},[],"Symptom",{"_3634":2302,"_31331":2214,"_21707":58297,"_5":14945,"_28497":58064,"_3084":58298},[],"Cause",{"_3634":2303,"_31331":2214,"_21707":58300,"_5":14945,"_28497":58064,"_3084":58301},[],"Action",{"_3634":2304,"_31331":2214,"_21707":58303,"_5":14945,"_28497":58064,"_3084":58304},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3634":2305,"_31331":2214,"_21707":58306,"_5":14945,"_28497":58064,"_3084":58307},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3634":2306,"_31331":2214,"_21707":58309,"_5":14945,"_28497":58064,"_3084":58310},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3634":2307,"_31331":2214,"_21707":58312,"_5":14945,"_28497":58064,"_3084":58313},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3634":2308,"_31331":2214,"_21707":58315,"_5":14945,"_28497":58064,"_3084":58316},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3634":2309,"_31331":2214,"_21707":58318,"_5":14945,"_28497":58064,"_3084":58319},[],"Delete the CA first; deleting it archives its settings.",{"_3634":2310,"_31331":2214,"_21707":58321,"_5":14945,"_28497":58064,"_3084":58322},[],"`PUT` returns 400.",{"_3634":2311,"_31331":2214,"_21707":58324,"_5":14945,"_28497":58064,"_3084":58325},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3634":2312,"_31331":2214,"_21707":58327,"_5":14945,"_28497":58064,"_3084":58328},[],"Set the serial number of a valid certificate of that CA.",{"_3634":2313,"_31331":2214,"_21707":58330,"_5":14945,"_28497":58064,"_3084":58331},[],"`PUT` returns 404.",{"_3634":2314,"_31331":2214,"_21707":58333,"_5":14945,"_28497":58064,"_3084":58334},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3634":2315,"_31331":2214,"_21707":58336,"_5":14945,"_28497":58064,"_3084":58337},[],"Check the CA ID and the signer serial number.",{"_3634":2316,"_31331":2214,"_21707":58339,"_5":14945,"_28497":58064,"_3084":58340},[],"`PUT` returns 400 from a 3.x client.",{"_3634":2317,"_31331":2214,"_21707":58342,"_5":14945,"_28497":58064,"_3084":58343},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3634":2318,"_31331":2214,"_21707":58345,"_5":14945,"_28497":58064,"_3084":58346},[],"Update the client to send the new field.",{"_3634":2319,"_31331":2214,"_21707":58348,"_5":14945,"_28497":58064,"_3084":58349},[],"The CRL does not change after revoking a certificate.",{"_3634":2320,"_31331":2214,"_21707":58351,"_5":14945,"_28497":58064,"_3084":58352},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3634":2321,"_31331":2214,"_21707":58354,"_5":14945,"_28497":58064,"_3084":58355},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3634":2322,"_31331":2214,"_21707":58357,"_5":14945,"_28497":58064,"_3084":58358},[],"A verifier rejects the CRL because of the issuer.",{"_3634":2323,"_31331":2214,"_21707":58360,"_5":14945,"_28497":58064,"_3084":58361},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3634":2324,"_31331":2214,"_21707":58363,"_5":14945,"_28497":58064,"_3084":58364},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3634":2325,"_31331":2214,"_21707":58366,"_5":14945,"_28497":58068,"_3084":58367},[],"RFC 5280: X.509 and CRL profile.",{"_3634":2326,"_31331":2214,"_21707":58369,"_5":14945,"_28497":58068,"_3084":58370},[],"OpenSSL: openssl-crl.",{"_3634":2327,"_31331":2214,"_21707":58372,"_5":14945,"_28497":58068,"_3084":58373},[],"OpenSSL: openssl-verify.",{"_3634":2328,"_31331":2214,"_21707":58375,"_5":14945,"_28497":58068,"_3084":58376},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":2329,"_31331":2214,"_21707":58378,"_5":14945,"_28497":58068,"_3084":58379},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3634":2330,"_31331":2330,"_5":15305,"_3084":58381,"_31690":58382,"_21707":58383,"_28497":2330},"Keys and cryptographic engines",[51145,52657,56831,56832],[],{"_3634":2331,"_31331":2330,"_21707":58385,"_5":14945,"_28497":2330,"_3084":58386},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3634":2332,"_31331":2330,"_5":31687,"_21707":58388,"_28497":58389,"_3084":58390},[],"/docs/pr-preview/pr-81/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3634":2333,"_31331":2330,"_5":31687,"_21707":58392,"_28497":58393,"_3084":58394},[],"/docs/pr-preview/pr-81/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3634":2334,"_31331":2330,"_5":31687,"_21707":58396,"_28497":58397,"_3084":58398},[],"/docs/pr-preview/pr-81/platform/pki/key-management#file-system","File System",{"_3634":2335,"_31331":2330,"_5":31687,"_21707":58400,"_28497":58401,"_3084":58402},[],"/docs/pr-preview/pr-81/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3634":2336,"_31331":2330,"_5":31687,"_21707":58404,"_28497":58405,"_3084":58406},[],"/docs/pr-preview/pr-81/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3634":2337,"_31331":2330,"_5":31687,"_21707":58408,"_28497":58409,"_3084":58410},[],"/docs/pr-preview/pr-81/platform/pki/key-management#aws-kms","AWS KMS",{"_3634":2338,"_31331":2330,"_5":31687,"_21707":58412,"_28497":58413,"_3084":58414},[],"/docs/pr-preview/pr-81/platform/pki/key-management#pkcs11","PKCS#11",{"_3634":2339,"_31331":2330,"_5":31687,"_21707":58416,"_28497":58417,"_3084":58418},[],"/docs/pr-preview/pr-81/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3634":2340,"_31331":2330,"_5":31687,"_21707":58420,"_28497":58421,"_3084":58422},[],"/docs/pr-preview/pr-81/platform/pki/key-management#key-inventory","Key inventory",{"_3634":2341,"_31331":2330,"_5":31687,"_21707":58424,"_28497":58425,"_3084":58426},[],"/docs/pr-preview/pr-81/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3634":2342,"_31331":2330,"_5":31687,"_21707":58428,"_28497":58429,"_3084":58430},[],"/docs/pr-preview/pr-81/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3634":2343,"_31331":2330,"_5":31687,"_21707":58432,"_28497":58433,"_3084":58434},[],"/docs/pr-preview/pr-81/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3634":2344,"_31331":2330,"_5":31687,"_21707":58436,"_28497":58437,"_3084":58438},[],"/docs/pr-preview/pr-81/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3634":2345,"_31331":2330,"_5":31687,"_21707":58440,"_28497":58441,"_3084":58442},[],"/docs/pr-preview/pr-81/platform/pki/key-management#view-details","View details",{"_3634":2346,"_31331":2330,"_5":31687,"_21707":58444,"_28497":58445,"_3084":58446},[],"/docs/pr-preview/pr-81/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3634":2347,"_31331":2330,"_5":31687,"_21707":58448,"_28497":58449,"_3084":58450},[],"/docs/pr-preview/pr-81/platform/pki/key-management#sign","Sign",{"_3634":2348,"_31331":2330,"_5":31687,"_21707":58452,"_28497":58453,"_3084":58454},[],"/docs/pr-preview/pr-81/platform/pki/key-management#verify","Verify",{"_3634":2349,"_31331":2330,"_5":31687,"_21707":58456,"_28497":58457,"_3084":58458},[],"/docs/pr-preview/pr-81/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3634":2350,"_31331":2330,"_5":31687,"_21707":58460,"_28497":58461,"_3084":58462},[],"/docs/pr-preview/pr-81/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3634":2351,"_31331":2330,"_5":31687,"_21707":58464,"_28497":58465,"_3084":58466},[],"/docs/pr-preview/pr-81/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3634":2352,"_31331":2330,"_21707":58468,"_5":14945,"_28497":2330,"_3084":58469},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3634":2353,"_31331":2330,"_21707":58471,"_5":14945,"_28497":2330,"_3084":58472},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3634":2354,"_31331":2330,"_21707":58474,"_5":14945,"_28497":58389,"_3084":58475},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3634":2355,"_31331":2330,"_21707":58477,"_5":14945,"_28497":58389,"_3084":58478},[],"In practice, it lets you:",{"_3634":2356,"_31331":2330,"_21707":58480,"_5":14945,"_28497":58389,"_3084":58481},[],"Generate new key pairs from Lamassu IoT.",{"_3634":2357,"_31331":2330,"_21707":58483,"_5":14945,"_28497":58389,"_3084":58484},[],"Import keys created externally.",{"_3634":2358,"_31331":2330,"_21707":58486,"_5":14945,"_28497":58389,"_3084":58487},[],"Delegate custody and cryptographic operations to external engines.",{"_3634":2359,"_31331":2330,"_21707":58489,"_5":14945,"_28497":58389,"_3084":58490},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3634":2360,"_31331":2330,"_21707":58492,"_5":14945,"_28497":58393,"_3084":58493},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3634":2361,"_31331":2330,"_21707":58495,"_5":14945,"_28497":58393,"_3084":58496},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3634":2362,"_31331":2330,"_21707":58498,"_5":14945,"_28497":58393,"_3084":58499},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3634":2363,"_31331":2330,"_21707":58501,"_5":14945,"_28497":58397,"_3084":58502},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3634":2364,"_31331":2330,"_21707":58504,"_5":14945,"_28497":58401,"_3084":58505},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3634":2365,"_31331":2330,"_21707":58507,"_5":14945,"_28497":58401,"_3084":58508},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3634":2366,"_31331":2330,"_21707":58510,"_5":14945,"_28497":58405,"_3084":58511},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3634":2367,"_31331":2330,"_21707":58513,"_5":14945,"_28497":58409,"_3084":58514},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3634":2368,"_31331":2330,"_21707":58516,"_5":14945,"_28497":58413,"_3084":58517},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3634":2369,"_31331":2330,"_21707":58519,"_5":14945,"_28497":58417,"_3084":58520},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3634":2370,"_31331":2330,"_21707":58522,"_5":14945,"_28497":58417,"_3084":58523},[],"Lamassu shows the enabled engines in the console.",{"_3634":2371,"_31331":2330,"_21707":58525,"_5":14945,"_28497":58417,"_3084":58526},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3634":2372,"_31331":2330,"_21707":58528,"_5":14945,"_28497":58417,"_3084":58529},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3634":2373,"_31331":2330,"_21707":58531,"_5":14945,"_28497":58421,"_3084":58532},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3634":2374,"_31331":2330,"_21707":58534,"_5":14945,"_28497":58421,"_3084":58535},[],"The table includes the following fields:",{"_3634":2375,"_31331":2330,"_21707":58537,"_5":14945,"_28497":58421,"_3084":58538},[],"**Name**: descriptive name of the key.",{"_3634":2376,"_31331":2330,"_21707":58540,"_5":14945,"_28497":58421,"_3084":58541},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3634":2377,"_31331":2330,"_21707":58543,"_5":14945,"_28497":58421,"_3084":58544},[],"**Strength**: visual indicator of cryptographic strength.",{"_3634":2378,"_31331":2330,"_21707":58546,"_5":14945,"_28497":58421,"_3084":58547},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3634":2379,"_31331":2330,"_21707":58549,"_5":14945,"_28497":58421,"_3084":58550},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3634":2380,"_31331":2330,"_21707":58552,"_5":14945,"_28497":58421,"_3084":58553},[],"**Aliases**: alternative names associated with the key.",{"_3634":2381,"_31331":2330,"_21707":58555,"_5":14945,"_28497":58421,"_3084":58556},[],"**Tags**: labels for classification and search.",{"_3634":2382,"_31331":2330,"_21707":58558,"_5":14945,"_28497":58421,"_3084":58559},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3634":2383,"_31331":2330,"_21707":58561,"_5":14945,"_28497":58421,"_3084":58562},[],"From this view you also reach the most common actions:",{"_3634":2384,"_31331":2330,"_21707":58564,"_5":14945,"_28497":58421,"_3084":58565},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3634":2385,"_31331":2330,"_21707":58567,"_5":14945,"_28497":58421,"_3084":58568},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3634":2386,"_31331":2330,"_21707":58570,"_5":14945,"_28497":58421,"_3084":58571},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3634":2387,"_31331":2330,"_21707":58573,"_5":14945,"_28497":58421,"_3084":58574},[],"**Delete Key** to remove the key from the system.",{"_3634":2388,"_31331":2330,"_21707":58576,"_5":14945,"_28497":58425,"_3084":58577},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3634":2389,"_31331":2330,"_21707":58579,"_5":14945,"_28497":58429,"_3084":58580},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3634":2390,"_31331":2330,"_21707":58582,"_5":14945,"_28497":58429,"_3084":58583},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3634":2391,"_31331":2330,"_21707":58585,"_5":14945,"_28497":58429,"_3084":58586},[],"**Key Name**: unique and descriptive name.",{"_3634":2392,"_31331":2330,"_21707":58588,"_5":14945,"_28497":58429,"_3084":58589},[],"**Crypto Engine**: engine that will keep the key.",{"_3634":2393,"_31331":2330,"_21707":58591,"_5":14945,"_28497":58429,"_3084":58592},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3634":2394,"_31331":2330,"_21707":58594,"_5":14945,"_28497":58429,"_3084":58595},[],"**Tags**: metadata to classify the key.",{"_3634":2395,"_31331":2330,"_21707":58597,"_5":14945,"_28497":58429,"_3084":58598},[],"**Metadata**: additional information for advanced uses.",{"_3634":2396,"_31331":2330,"_21707":58600,"_5":14945,"_28497":58433,"_3084":58601},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3634":2397,"_31331":2330,"_21707":58603,"_5":14945,"_28497":58433,"_3084":58604},[],"When you have an exportable private key and the destination engine supports import.",{"_3634":2398,"_31331":2330,"_21707":58606,"_5":14945,"_28497":58433,"_3084":58607},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3634":2399,"_31331":2330,"_21707":58609,"_5":14945,"_28497":58433,"_3084":58610},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3634":2400,"_31331":2330,"_21707":58612,"_5":14945,"_28497":58433,"_3084":58613},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3634":2401,"_31331":2330,"_21707":58615,"_5":14945,"_28497":58433,"_3084":58616},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3634":2402,"_31331":2330,"_21707":58618,"_5":14945,"_28497":58433,"_3084":58619},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3634":2403,"_31331":2330,"_21707":58621,"_5":14945,"_28497":58433,"_3084":58622},[],"**Tags**: labels for organization and search.",{"_3634":2404,"_31331":2330,"_21707":58624,"_5":14945,"_28497":58433,"_3084":58625},[],"**Metadata**: additional optional information.",{"_3634":2405,"_31331":2330,"_21707":58627,"_5":14945,"_28497":58433,"_3084":58628},[],"**Private Key (PEM)**: private key in PEM format.",{"_3634":2406,"_31331":2330,"_21707":58630,"_5":14945,"_28497":58433,"_3084":58631},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3634":2407,"_31331":2330,"_21707":58633,"_5":14945,"_28497":58437,"_3084":58634},[],"Each registered key has a detail view and several operational actions.",{"_3634":2408,"_31331":2330,"_21707":58636,"_5":14945,"_28497":58441,"_3084":58637},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3634":2409,"_31331":2330,"_21707":58639,"_5":14945,"_28497":58441,"_3084":58640},[],"The **Overview** tab shows, among others, these fields:",{"_3634":2410,"_31331":2330,"_21707":58642,"_5":14945,"_28497":58441,"_3084":58643},[],"**Key Name**: descriptive name.",{"_3634":2411,"_31331":2330,"_21707":58645,"_5":14945,"_28497":58441,"_3084":58646},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3634":2412,"_31331":2330,"_21707":58648,"_5":14945,"_28497":58441,"_3084":58649},[],"**Tags**: associated labels.",{"_3634":2413,"_31331":2330,"_21707":58651,"_5":14945,"_28497":58441,"_3084":58652},[],"**Aliases**: alternative names.",{"_3634":2414,"_31331":2330,"_21707":58654,"_5":14945,"_28497":58441,"_3084":58655},[],"**Crypto Engine**: engine where the key resides.",{"_3634":2415,"_31331":2330,"_21707":58657,"_5":14945,"_28497":58441,"_3084":58658},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3634":2416,"_31331":2330,"_21707":58660,"_5":14945,"_28497":58441,"_3084":58661},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3634":2417,"_31331":2330,"_21707":58663,"_5":14945,"_28497":58441,"_3084":58664},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3634":2418,"_31331":2330,"_21707":58666,"_5":14945,"_28497":58445,"_3084":58667},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3634":2419,"_31331":2330,"_21707":58669,"_5":14945,"_28497":58445,"_3084":58670},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3634":2420,"_31331":2330,"_21707":58672,"_5":14945,"_28497":58445,"_3084":58673},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3634":2421,"_31331":2330,"_21707":58675,"_5":14945,"_28497":58449,"_3084":58676},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3634":2422,"_31331":2330,"_21707":58678,"_5":14945,"_28497":58449,"_3084":58679},[],"Main fields:",{"_3634":2423,"_31331":2330,"_21707":58681,"_5":14945,"_28497":58449,"_3084":58682},[],"**Algorithm**: signing algorithm available for the key type.",{"_3634":2424,"_31331":2330,"_21707":58684,"_5":14945,"_28497":58449,"_3084":58685},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3634":2425,"_31331":2330,"_21707":58687,"_5":14945,"_28497":58449,"_3084":58688},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3634":2426,"_31331":2330,"_21707":58690,"_5":14945,"_28497":58449,"_3084":58691},[],"**Message**: content to sign.",{"_3634":2427,"_31331":2330,"_21707":58693,"_5":14945,"_28497":58449,"_3084":58694},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3634":2428,"_31331":2330,"_21707":58696,"_5":14945,"_28497":58453,"_3084":58697},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3634":2429,"_31331":2330,"_21707":58699,"_5":14945,"_28497":58453,"_3084":58679},[],{"_3634":2430,"_31331":2330,"_21707":58701,"_5":14945,"_28497":58453,"_3084":58702},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3634":2431,"_31331":2330,"_21707":58704,"_5":14945,"_28497":58453,"_3084":58705},[],"**Message Type**: `Raw` or `Digest`.",{"_3634":2432,"_31331":2330,"_21707":58707,"_5":14945,"_28497":58453,"_3084":58708},[],"**Payload Encoding**: encoding of the message.",{"_3634":2433,"_31331":2330,"_21707":58710,"_5":14945,"_28497":58453,"_3084":58711},[],"**Message**: original message or hash.",{"_3634":2434,"_31331":2330,"_21707":58713,"_5":14945,"_28497":58453,"_3084":58714},[],"**Signature**: signature to check.",{"_3634":2435,"_31331":2330,"_21707":58716,"_5":14945,"_28497":58453,"_3084":58717},[],"**Result**: indicator of the validation result.",{"_3634":2436,"_31331":2330,"_21707":58719,"_5":14945,"_28497":58457,"_3084":58720},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3634":2437,"_31331":2330,"_21707":58722,"_5":14945,"_28497":58457,"_3084":58723},[],"This flow is useful for:",{"_3634":2438,"_31331":2330,"_21707":58725,"_5":14945,"_28497":58457,"_3084":58726},[],"Requesting certificates from an external CA.",{"_3634":2439,"_31331":2330,"_21707":58728,"_5":14945,"_28497":58457,"_3084":58729},[],"Renewing an identity while keeping the same key.",{"_3634":2440,"_31331":2330,"_21707":58731,"_5":14945,"_28497":58457,"_3084":58732},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3634":2441,"_31331":2330,"_21707":58734,"_5":14945,"_28497":58457,"_3084":58735},[],"**Common Name (CN)**: main name of the identity.",{"_3634":2442,"_31331":2330,"_21707":58737,"_5":14945,"_28497":58457,"_3084":58738},[],"**Organization (O)**: organization or company.",{"_3634":2443,"_31331":2330,"_21707":58740,"_5":14945,"_28497":58457,"_3084":58741},[],"**Organizational Unit (OU)**: department or unit.",{"_3634":2444,"_31331":2330,"_21707":58743,"_5":14945,"_28497":58457,"_3084":58744},[],"**Country (C)**: two-letter country code.",{"_3634":2445,"_31331":2330,"_21707":58746,"_5":14945,"_28497":58457,"_3084":58747},[],"**State / Province (ST)**: state or province.",{"_3634":2446,"_31331":2330,"_21707":58749,"_5":14945,"_28497":58457,"_3084":58750},[],"**Locality (L)**: city or locality.",{"_3634":2447,"_31331":2330,"_21707":58752,"_5":14945,"_28497":58457,"_3084":58753},[],"**Email Address**: contact email.",{"_3634":2448,"_31331":2330,"_21707":58755,"_5":14945,"_28497":58457,"_3084":58756},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3634":2449,"_31331":2330,"_21707":58758,"_5":14945,"_28497":58457,"_3084":58759},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3634":2450,"_31331":2330,"_21707":58761,"_5":14945,"_28497":58461,"_3084":58762},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3634":2451,"_31331":2330,"_21707":58764,"_5":14945,"_28497":58461,"_3084":58765},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3634":2452,"_31331":2330,"_21707":58767,"_5":14945,"_28497":58465,"_3084":58768},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3634":2453,"_31331":2330,"_21707":58770,"_5":14945,"_28497":58465,"_3084":58771},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3634":2454,"_31331":2454,"_5":15305,"_3084":58773,"_31690":58774,"_21707":58775,"_28497":2454},"Online validation with OCSP",[51145,52657,56831,57504],[],{"_3634":2455,"_31331":2454,"_21707":58777,"_5":14945,"_28497":2454,"_3084":58778},[],"Query signed status and verify the responder’s response.",{"_3634":2456,"_31331":2454,"_5":31687,"_21707":58780,"_28497":58781,"_3084":58782},[],"/docs/pr-preview/pr-81/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3634":2457,"_31331":2454,"_5":31687,"_21707":58784,"_28497":58785,"_3084":58786},[],"/docs/pr-preview/pr-81/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3634":2458,"_31331":2454,"_5":31687,"_21707":58788,"_28497":58789,"_3084":58790},[],"/docs/pr-preview/pr-81/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3634":2459,"_31331":2454,"_5":31687,"_21707":58792,"_28497":58793,"_3084":58794},[],"/docs/pr-preview/pr-81/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3634":2460,"_31331":2454,"_5":31687,"_21707":58796,"_28497":58797,"_3084":58798},[],"/docs/pr-preview/pr-81/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3634":2461,"_31331":2454,"_5":31687,"_21707":58800,"_28497":58801,"_3084":58069},[],"/docs/pr-preview/pr-81/platform/pki/ocsp#references",{"_3634":2462,"_31331":2454,"_21707":58803,"_5":14945,"_28497":2454,"_3084":58804},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3634":2463,"_31331":2454,"_21707":58806,"_5":14945,"_28497":58781,"_3084":58807},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3634":2464,"_31331":2454,"_21707":58809,"_5":14945,"_28497":58781,"_3084":58810},[],"Record status",{"_3634":2465,"_31331":2454,"_21707":58812,"_5":14945,"_28497":58781,"_3084":58813},[],"Signed response",{"_3634":2466,"_31331":2454,"_21707":58815,"_5":14945,"_28497":58781,"_3084":55968},[],{"_3634":2467,"_31331":2454,"_21707":58817,"_5":14945,"_28497":58781,"_3084":58818},[],"`Good`.",{"_3634":2468,"_31331":2454,"_21707":58820,"_5":14945,"_28497":58781,"_3084":55985},[],{"_3634":2469,"_31331":2454,"_21707":58822,"_5":14945,"_28497":58781,"_3084":58823},[],"`Revoked`, with revocation reason and timestamp.",{"_3634":2470,"_31331":2454,"_21707":58825,"_5":14945,"_28497":58781,"_3084":58826},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3634":2471,"_31331":2454,"_21707":58828,"_5":14945,"_28497":58781,"_3084":58829},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3634":2472,"_31331":2454,"_21707":58831,"_5":14945,"_28497":58781,"_3084":58832},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3634":2473,"_31331":2454,"_21707":58834,"_5":14945,"_28497":58781,"_3084":58835},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3634":2474,"_31331":2454,"_21707":58837,"_5":14945,"_28497":58781,"_3084":58838},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3634":2475,"_31331":2454,"_21707":58840,"_5":14945,"_28497":58785,"_3084":58841},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3634":2476,"_31331":2454,"_21707":58843,"_5":14945,"_28497":58785,"_3084":58844},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3634":2477,"_31331":2454,"_21707":58846,"_5":14945,"_28497":58789,"_3084":58847},[],"The service accepts:",{"_3634":2478,"_31331":2454,"_21707":58849,"_5":14945,"_28497":58789,"_3084":54597},[],{"_3634":2479,"_31331":2454,"_21707":58851,"_5":14945,"_28497":58789,"_3084":58852},[],"VA service path",{"_3634":2480,"_31331":2454,"_21707":58854,"_5":14945,"_28497":58789,"_3084":58855},[],"Format",{"_3634":2481,"_31331":2454,"_21707":58857,"_5":14945,"_28497":58789,"_3084":58858},[],"`POST`",{"_3634":2482,"_31331":2454,"_21707":58860,"_5":14945,"_28497":58789,"_3084":58861},[],"`/ocsp`",{"_3634":2483,"_31331":2454,"_21707":58863,"_5":14945,"_28497":58789,"_3084":58864},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3634":2484,"_31331":2454,"_21707":58866,"_5":14945,"_28497":58789,"_3084":58253},[],{"_3634":2485,"_31331":2454,"_21707":58868,"_5":14945,"_28497":58789,"_3084":58869},[],"`/ocsp/{ocsp_request}`",{"_3634":2486,"_31331":2454,"_21707":58871,"_5":14945,"_28497":58789,"_3084":58872},[],"DER request encoded using padded URL Base64.",{"_3634":2487,"_31331":2454,"_21707":58874,"_5":14945,"_28497":58789,"_3084":58875},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3634":2488,"_31331":2454,"_21707":58877,"_5":14945,"_28497":58793,"_3084":58878},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3634":2489,"_31331":2454,"_21707":58880,"_5":14945,"_28497":58793,"_3084":58881},[],"Generate the request:",{"_3634":2490,"_31331":2454,"_21707":58883,"_5":14945,"_28497":58793,"_3084":58884},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3634":2491,"_31331":2454,"_21707":58886,"_5":14945,"_28497":58793,"_3084":58887},[],"Replace the example URL with the inspected endpoint:",{"_3634":2492,"_31331":2454,"_21707":58889,"_5":14945,"_28497":58793,"_3084":58890},[],"Verify the returned DER:",{"_3634":2493,"_31331":2454,"_21707":58892,"_5":14945,"_28497":58793,"_3084":58893},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3634":2494,"_31331":2454,"_21707":58895,"_5":14945,"_28497":58797,"_3084":58896},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3634":2495,"_31331":2454,"_21707":58898,"_5":14945,"_28497":58797,"_3084":58899},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3634":2496,"_31331":2454,"_21707":58901,"_5":14945,"_28497":58801,"_3084":58902},[],"RFC 6960: OCSP.",{"_3634":2497,"_31331":2454,"_21707":58904,"_5":14945,"_28497":58801,"_3084":58905},[],"OpenSSL: openssl-ocsp.",{"_3634":2498,"_31331":2454,"_21707":58907,"_5":14945,"_28497":58801,"_3084":58908},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3634":2499,"_31331":2454,"_21707":58910,"_5":14945,"_28497":58801,"_3084":58379},[],{"_3634":2500,"_31331":2500,"_5":15305,"_3084":56831,"_31690":58912,"_21707":58913,"_28497":2500},[51145,52657,56831],[],{"_3634":2501,"_31331":2500,"_21707":58915,"_5":14945,"_28497":2500,"_3084":58916},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3634":2502,"_31331":2500,"_5":31687,"_21707":58918,"_28497":58919,"_3084":56143},[],"/docs/pr-preview/pr-81/platform/pki/overview#start-here",{"_3634":2503,"_31331":2500,"_5":31687,"_21707":58921,"_28497":58922,"_3084":58923},[],"/docs/pr-preview/pr-81/platform/pki/overview#what-you-need","What you need",{"_3634":2504,"_31331":2500,"_5":31687,"_21707":58925,"_28497":58926,"_3084":56675},[],"/docs/pr-preview/pr-81/platform/pki/overview#core-capabilities",{"_3634":2505,"_31331":2500,"_5":31687,"_21707":58928,"_28497":58929,"_3084":56679},[],"/docs/pr-preview/pr-81/platform/pki/overview#build-your-trust-hierarchy",{"_3634":2506,"_31331":2500,"_5":31687,"_21707":58931,"_28497":58932,"_3084":56683},[],"/docs/pr-preview/pr-81/platform/pki/overview#protect-cryptographic-keys",{"_3634":2507,"_31331":2500,"_5":31687,"_21707":58934,"_28497":58935,"_3084":56687},[],"/docs/pr-preview/pr-81/platform/pki/overview#issue-and-control-certificates",{"_3634":2508,"_31331":2500,"_5":31687,"_21707":58937,"_28497":58938,"_3084":56695},[],"/docs/pr-preview/pr-81/platform/pki/overview#publish-validation-status",{"_3634":2509,"_31331":2500,"_5":31687,"_21707":58940,"_28497":58941,"_3084":58942},[],"/docs/pr-preview/pr-81/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3634":2510,"_31331":2500,"_5":31687,"_21707":58944,"_28497":58945,"_3084":57671},[],"/docs/pr-preview/pr-81/platform/pki/overview#continue",{"_3634":2511,"_31331":2500,"_21707":58947,"_5":14945,"_28497":2500,"_3084":58948},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3634":2512,"_31331":2500,"_21707":58950,"_5":14945,"_28497":58919,"_3084":58951},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3634":2513,"_31331":2500,"_21707":58953,"_5":14945,"_28497":58919,"_3084":58954},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3634":2514,"_31331":2500,"_21707":58956,"_5":14945,"_28497":58922,"_3084":58957},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3634":2515,"_31331":2500,"_21707":58959,"_5":14945,"_28497":58922,"_3084":58960},[],"An available cryptographic engine to keep the authority's key.",{"_3634":2516,"_31331":2500,"_21707":58962,"_5":14945,"_28497":58922,"_3084":58963},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3634":2517,"_31331":2500,"_21707":58965,"_5":14945,"_28497":58922,"_3084":58966},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3634":2518,"_31331":2500,"_21707":58968,"_5":14945,"_28497":58922,"_3084":58969},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3634":2519,"_31331":2500,"_21707":58971,"_5":14945,"_28497":58929,"_3084":58972},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3634":2520,"_31331":2500,"_21707":58974,"_5":14945,"_28497":58932,"_3084":58975},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3634":2521,"_31331":2500,"_21707":58977,"_5":14945,"_28497":58935,"_3084":58978},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3634":2522,"_31331":2500,"_21707":58980,"_5":14945,"_28497":58938,"_3084":58981},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3634":2523,"_31331":2500,"_21707":58983,"_5":14945,"_28497":58941,"_3084":58984},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3634":2524,"_31331":2500,"_21707":58986,"_5":14945,"_28497":58941,"_3084":58987},[],"its subject and extensions identify the expected client;",{"_3634":2525,"_31331":2500,"_21707":58989,"_5":14945,"_28497":58941,"_3084":58990},[],"its public key matches the client's private key;",{"_3634":2526,"_31331":2500,"_21707":58992,"_5":14945,"_28497":58941,"_3084":58993},[],"its chain reaches a root trusted by the consumer;",{"_3634":2527,"_31331":2500,"_21707":58995,"_5":14945,"_28497":58941,"_3084":58996},[],"its dates and usages allow the operation;",{"_3634":2528,"_31331":2500,"_21707":58998,"_5":14945,"_28497":58941,"_3084":58999},[],"the consumer applies revocation checks and authorization.",{"_3634":2529,"_31331":2500,"_21707":59001,"_5":14945,"_28497":58941,"_3084":59002},[],"The issuance path includes the first independent checks.",{"_3634":2530,"_31331":2500,"_21707":59004,"_5":14945,"_28497":58945,"_3084":59005},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":2531,"_31331":2500,"_21707":59007,"_5":14945,"_28497":58945,"_3084":59008},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3634":2532,"_31331":2500,"_21707":59010,"_5":14945,"_28497":58945,"_3084":59011},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3634":2533,"_31331":2533,"_5":15305,"_3084":59013,"_31690":59014,"_21707":59015,"_28497":2533},"Create your first CA",[51145,52657,56831,56268],[],{"_3634":2534,"_31331":2533,"_21707":59017,"_5":14945,"_28497":2533,"_3084":59018},[],"Create an evaluation root and check its certificate before issuing.",{"_3634":2535,"_31331":2533,"_5":31687,"_21707":59020,"_28497":59021,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3634":2536,"_31331":2533,"_5":31687,"_21707":59023,"_28497":59024,"_3084":59025},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3634":2537,"_31331":2533,"_5":31687,"_21707":59027,"_28497":59028,"_3084":59029},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3634":2538,"_31331":2533,"_5":31687,"_21707":59031,"_28497":59032,"_3084":59033},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3634":2539,"_31331":2533,"_5":31687,"_21707":59035,"_28497":59036,"_3084":59037},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3634":2540,"_31331":2533,"_5":31687,"_21707":59039,"_28497":59040,"_3084":59041},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3634":2541,"_31331":2533,"_5":31687,"_21707":59043,"_28497":59044,"_3084":59045},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3634":2542,"_31331":2533,"_5":31687,"_21707":59047,"_28497":59048,"_3084":56525},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3634":2543,"_31331":2533,"_5":31687,"_21707":59050,"_28497":59051,"_3084":51179},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3634":2544,"_31331":2533,"_21707":59053,"_5":14945,"_28497":2533,"_3084":59054},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3634":2545,"_31331":2533,"_21707":59056,"_5":14945,"_28497":59021,"_3084":59057},[],"Console access and permission to create keys and authorities.",{"_3634":2546,"_31331":2533,"_21707":59059,"_5":14945,"_28497":59021,"_3084":59060},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3634":2547,"_31331":2533,"_21707":59062,"_5":14945,"_28497":59021,"_3084":59063},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3634":2548,"_31331":2533,"_21707":59065,"_5":14945,"_28497":59021,"_3084":59066},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3634":2549,"_31331":2533,"_21707":59068,"_5":14945,"_28497":59024,"_3084":59069},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3634":2550,"_31331":2533,"_21707":59071,"_5":14945,"_28497":59024,"_3084":59072},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3634":2551,"_31331":2533,"_21707":59074,"_5":14945,"_28497":59028,"_3084":59075},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3634":2552,"_31331":2533,"_21707":59077,"_5":14945,"_28497":59028,"_3084":59078},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3634":2553,"_31331":2533,"_21707":59080,"_5":14945,"_28497":59032,"_3084":59081},[],"Select **Root CA** and complete:",{"_3634":2554,"_31331":2533,"_21707":59083,"_5":14945,"_28497":59032,"_3084":59084},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3634":2555,"_31331":2533,"_21707":59086,"_5":14945,"_28497":59032,"_3084":59087},[],"**Subject**: organization and country details for your evaluation.",{"_3634":2556,"_31331":2533,"_21707":59089,"_5":14945,"_28497":59032,"_3084":59090},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3634":2557,"_31331":2533,"_21707":59092,"_5":14945,"_28497":59032,"_3084":59093},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3634":2558,"_31331":2533,"_21707":59095,"_5":14945,"_28497":59032,"_3084":59096},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3634":2559,"_31331":2533,"_21707":59098,"_5":14945,"_28497":59036,"_3084":59099},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3634":2560,"_31331":2533,"_21707":59101,"_5":14945,"_28497":59040,"_3084":59102},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3634":2561,"_31331":2533,"_21707":59104,"_5":14945,"_28497":59040,"_3084":59105},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3634":2562,"_31331":2533,"_21707":59107,"_5":14945,"_28497":59044,"_3084":59108},[],"Run from the directory where you saved `ca.pem`:",{"_3634":2563,"_31331":2533,"_21707":59110,"_5":14945,"_28497":59044,"_3084":59111},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3634":2564,"_31331":2533,"_21707":59113,"_5":14945,"_28497":59044,"_3084":59114},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3634":2565,"_31331":2533,"_21707":59116,"_5":14945,"_28497":59048,"_3084":59117},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3634":2566,"_31331":2533,"_21707":59119,"_5":14945,"_28497":59048,"_3084":59120},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3634":2567,"_31331":2533,"_21707":59122,"_5":14945,"_28497":59048,"_3084":59123},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3634":2568,"_31331":2533,"_21707":59125,"_5":14945,"_28497":59048,"_3084":59126},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3634":2569,"_31331":2533,"_21707":59128,"_5":14945,"_28497":59051,"_3084":59129},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3634":2570,"_31331":2570,"_5":15305,"_3084":59131,"_31690":59132,"_21707":59133,"_28497":2570},"Issue and verify a certificate",[51145,52657,56831,56268],[],{"_3634":2571,"_31331":2570,"_21707":59135,"_5":14945,"_28497":2570,"_3084":59136},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3634":2572,"_31331":2570,"_5":31687,"_21707":59138,"_28497":59139,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3634":2573,"_31331":2570,"_5":31687,"_21707":59141,"_28497":59142,"_3084":59143},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3634":2574,"_31331":2570,"_5":31687,"_21707":59145,"_28497":59146,"_3084":59147},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3634":2575,"_31331":2570,"_5":31687,"_21707":59149,"_28497":59150,"_3084":59151},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3634":2576,"_31331":2570,"_5":31687,"_21707":59153,"_28497":59154,"_3084":59155},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3634":2577,"_31331":2570,"_5":31687,"_21707":59157,"_28497":59158,"_3084":59159},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3634":2578,"_31331":2570,"_5":31687,"_21707":59161,"_28497":59162,"_3084":59163},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3634":2579,"_31331":2570,"_5":31687,"_21707":59165,"_28497":59166,"_3084":59167},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3634":2580,"_31331":2570,"_5":31687,"_21707":59169,"_28497":59170,"_3084":59171},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3634":2581,"_31331":2570,"_5":31687,"_21707":59173,"_28497":59174,"_3084":59175},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3634":2582,"_31331":2570,"_5":31687,"_21707":59177,"_28497":59178,"_3084":56525},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3634":2583,"_31331":2570,"_5":31687,"_21707":59180,"_28497":59181,"_3084":51179},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/issue-certificate#next-step",{"_3634":2584,"_31331":2570,"_21707":59183,"_5":14945,"_28497":2570,"_3084":59184},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3634":2585,"_31331":2570,"_21707":59186,"_5":14945,"_28497":59139,"_3084":59187},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3634":2586,"_31331":2570,"_21707":59189,"_5":14945,"_28497":59139,"_3084":59190},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3634":2587,"_31331":2570,"_21707":59192,"_5":14945,"_28497":59139,"_3084":59193},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3634":2588,"_31331":2570,"_21707":59195,"_5":14945,"_28497":59139,"_3084":59196},[],"A client identifier: here we use `device-001`.",{"_3634":2589,"_31331":2570,"_21707":59198,"_5":14945,"_28497":59139,"_3084":59199},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3634":2590,"_31331":2570,"_21707":59201,"_5":14945,"_28497":59142,"_3084":59202},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3634":2591,"_31331":2570,"_21707":59204,"_5":14945,"_28497":59146,"_3084":59205},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3634":2592,"_31331":2570,"_21707":59207,"_5":14945,"_28497":59146,"_3084":59208},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3634":2593,"_31331":2570,"_21707":59210,"_5":14945,"_28497":59150,"_3084":59211},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3634":2594,"_31331":2570,"_21707":59213,"_5":14945,"_28497":59150,"_3084":59214},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3634":2595,"_31331":2570,"_21707":59216,"_5":14945,"_28497":59154,"_3084":59217},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3634":2596,"_31331":2570,"_21707":59219,"_5":14945,"_28497":59154,"_3084":59220},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3634":2597,"_31331":2570,"_21707":59222,"_5":14945,"_28497":59158,"_3084":59223},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3634":2598,"_31331":2570,"_21707":59225,"_5":14945,"_28497":59162,"_3084":59226},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3634":2599,"_31331":2570,"_21707":59228,"_5":14945,"_28497":59166,"_3084":59229},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3634":2600,"_31331":2570,"_21707":59231,"_5":14945,"_28497":59170,"_3084":59232},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3634":2601,"_31331":2570,"_21707":59234,"_5":14945,"_28497":59170,"_3084":59235},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3634":2602,"_31331":2570,"_21707":59237,"_5":14945,"_28497":59170,"_3084":59238},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3634":2603,"_31331":2570,"_21707":59240,"_5":14945,"_28497":59174,"_3084":59241},[],"In Bash, compare the two public-key digests:",{"_3634":2604,"_31331":2570,"_21707":59243,"_5":14945,"_28497":59174,"_3084":59244},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3634":2605,"_31331":2570,"_21707":59246,"_5":14945,"_28497":59174,"_3084":59247},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3634":2606,"_31331":2570,"_21707":59249,"_5":14945,"_28497":59178,"_3084":56609},[],{"_3634":2607,"_31331":2570,"_21707":59251,"_5":14945,"_28497":59178,"_3084":59252},[],"What to review",{"_3634":2608,"_31331":2570,"_21707":59254,"_5":14945,"_28497":59178,"_3084":59255},[],"The CA rejects issuance",{"_3634":2609,"_31331":2570,"_21707":59257,"_5":14945,"_28497":59178,"_3084":59258},[],"Permissions, CA state and key, algorithm and profile.",{"_3634":2610,"_31331":2570,"_21707":59260,"_5":14945,"_28497":59178,"_3084":59261},[],"Different subject or usages",{"_3634":2611,"_31331":2570,"_21707":59263,"_5":14945,"_28497":59178,"_3084":59264},[],"Applied profile and requested values.",{"_3634":2612,"_31331":2570,"_21707":59266,"_5":14945,"_28497":59178,"_3084":59267},[],"Issuer cannot be found",{"_3634":2613,"_31331":2570,"_21707":59269,"_5":14945,"_28497":59178,"_3084":59270},[],"Downloaded CA and required intermediate chain.",{"_3634":2614,"_31331":2570,"_21707":59272,"_5":14945,"_28497":59178,"_3084":59273},[],"Validity fails",{"_3634":2615,"_31331":2570,"_21707":59275,"_5":14945,"_28497":59178,"_3084":59276},[],"Certificate and CA dates, and the computer's clock.",{"_3634":2616,"_31331":2570,"_21707":59278,"_5":14945,"_28497":59178,"_3084":59279},[],"Public-key digests differ",{"_3634":2617,"_31331":2570,"_21707":59281,"_5":14945,"_28497":59178,"_3084":59282},[],"Certificate and key files from the same issuance.",{"_3634":2618,"_31331":2570,"_21707":59284,"_5":14945,"_28497":59178,"_3084":59285},[],"See PKI diagnostics to narrow an issuance failure.",{"_3634":2619,"_31331":2570,"_21707":59287,"_5":14945,"_28497":59181,"_3084":59288},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3634":2620,"_31331":2570,"_21707":59290,"_5":14945,"_28497":59181,"_3084":59291},[],"Manage certificates for inspection, status and revocation.",{"_3634":2621,"_31331":2570,"_21707":59293,"_5":14945,"_28497":59181,"_3084":59294},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3634":2622,"_31331":2570,"_21707":59296,"_5":14945,"_28497":59181,"_3084":59297},[],"Prepare EST for the device to request its next identities.",{"_3634":2623,"_31331":2570,"_21707":59299,"_5":14945,"_28497":59181,"_3084":59300},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3634":2624,"_31331":2624,"_5":15305,"_3084":59302,"_31690":59303,"_21707":59304,"_28497":2624},"PKI getting started",[51145,52657,56831,56268],[],{"_3634":2625,"_31331":2624,"_21707":59306,"_5":14945,"_28497":2624,"_3084":59307},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3634":2626,"_31331":2624,"_5":31687,"_21707":59309,"_28497":59310,"_3084":51155},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/overview#before-you-begin",{"_3634":2627,"_31331":2624,"_5":31687,"_21707":59312,"_28497":59313,"_3084":59314},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3634":2628,"_31331":2624,"_5":31687,"_21707":59316,"_28497":59317,"_3084":56460},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/overview#expected-result",{"_3634":2629,"_31331":2624,"_5":31687,"_21707":59319,"_28497":59320,"_3084":59321},[],"/docs/pr-preview/pr-81/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3634":2630,"_31331":2624,"_21707":59323,"_5":14945,"_28497":2624,"_3084":59324},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3634":2631,"_31331":2624,"_21707":59326,"_5":14945,"_28497":59310,"_3084":59327},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3634":2632,"_31331":2624,"_21707":59329,"_5":14945,"_28497":59310,"_3084":59330},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3634":2633,"_31331":2624,"_21707":59332,"_5":14945,"_28497":59310,"_3084":59333},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3634":2634,"_31331":2624,"_21707":59335,"_5":14945,"_28497":59310,"_3084":59336},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3634":2635,"_31331":2624,"_21707":59338,"_5":14945,"_28497":59310,"_3084":59339},[],"A working directory with restricted access for the downloaded key.",{"_3634":2636,"_31331":2624,"_21707":59341,"_5":14945,"_28497":59313,"_3084":59342},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3634":2637,"_31331":2624,"_21707":59344,"_5":14945,"_28497":59313,"_3084":59345},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3634":2638,"_31331":2624,"_21707":59347,"_5":14945,"_28497":59313,"_3084":59348},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3634":2639,"_31331":2624,"_21707":59350,"_5":14945,"_28497":59313,"_3084":59351},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3634":2640,"_31331":2624,"_21707":59353,"_5":14945,"_28497":59317,"_3084":59354},[],"File or resource",{"_3634":2641,"_31331":2624,"_21707":59356,"_5":14945,"_28497":59317,"_3084":56457},[],{"_3634":2642,"_31331":2624,"_21707":59358,"_5":14945,"_28497":59317,"_3084":59359},[],"Active root CA and `ca.pem`",{"_3634":2643,"_31331":2624,"_21707":59361,"_5":14945,"_28497":59317,"_3084":59362},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3634":2644,"_31331":2624,"_21707":59364,"_5":14945,"_28497":59317,"_3084":59365},[],"End-entity certificate and `device.crt`",{"_3634":2645,"_31331":2624,"_21707":59367,"_5":14945,"_28497":59317,"_3084":59368},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3634":2646,"_31331":2624,"_21707":59370,"_5":14945,"_28497":59317,"_3084":59371},[],"Private key `device.key`",{"_3634":2647,"_31331":2624,"_21707":59373,"_5":14945,"_28497":59317,"_3084":59374},[],"Its public key matches the one included in `device.crt`.",{"_3634":2648,"_31331":2624,"_21707":59376,"_5":14945,"_28497":59317,"_3084":59377},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3634":2649,"_31331":2624,"_21707":59379,"_5":14945,"_28497":59320,"_3084":59380},[],"To operate certificates, continue with Certificates and Validation.",{"_3634":2650,"_31331":2624,"_21707":59382,"_5":14945,"_28497":59320,"_3084":59383},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3634":2651,"_31331":2624,"_21707":59385,"_5":14945,"_28497":59320,"_3084":59386},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3634":2652,"_31331":2652,"_5":15305,"_3084":59388,"_31690":59389,"_21707":59390,"_28497":2652},"PKI troubleshooting",[51145,52657,56831,55406],[],{"_3634":2653,"_31331":2652,"_21707":59392,"_5":14945,"_28497":2652,"_3084":59393},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3634":2654,"_31331":2652,"_5":31687,"_21707":59395,"_28497":59396,"_3084":59397},[],"/docs/pr-preview/pr-81/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3634":2655,"_31331":2652,"_5":31687,"_21707":59399,"_28497":59400,"_3084":59401},[],"/docs/pr-preview/pr-81/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3634":2656,"_31331":2652,"_5":31687,"_21707":59403,"_28497":59404,"_3084":59405},[],"/docs/pr-preview/pr-81/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3634":2657,"_31331":2652,"_21707":59407,"_5":14945,"_28497":2652,"_3084":59408},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3634":2658,"_31331":2652,"_21707":59410,"_5":14945,"_28497":2652,"_3084":59411},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3634":2659,"_31331":2652,"_21707":59413,"_5":14945,"_28497":59396,"_3084":56457},[],{"_3634":2660,"_31331":2652,"_21707":59415,"_5":14945,"_28497":59396,"_3084":59416},[],"What to inspect",{"_3634":2661,"_31331":2652,"_21707":59418,"_5":14945,"_28497":59396,"_3084":51179},[],{"_3634":2662,"_31331":2652,"_21707":59420,"_5":14945,"_28497":59396,"_3084":55673},[],{"_3634":2663,"_31331":2652,"_21707":59422,"_5":14945,"_28497":59396,"_3084":59423},[],"Exists, is active and has usable dates.",{"_3634":2664,"_31331":2652,"_21707":59425,"_5":14945,"_28497":59396,"_3084":59426},[],"Authorities.",{"_3634":2665,"_31331":2652,"_21707":59428,"_5":14945,"_28497":59396,"_3084":59429},[],"Key",{"_3634":2666,"_31331":2652,"_21707":59431,"_5":14945,"_28497":59396,"_3084":59432},[],"The record has a usable private key and the engine can sign.",{"_3634":2667,"_31331":2652,"_21707":59434,"_5":14945,"_28497":59396,"_3084":59435},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3634":2668,"_31331":2652,"_21707":59437,"_5":14945,"_28497":59396,"_3084":59438},[],"CSR",{"_3634":2669,"_31331":2652,"_21707":59440,"_5":14945,"_28497":59396,"_3084":59441},[],"Correct PEM and verifiable signature.",{"_3634":2670,"_31331":2652,"_21707":59443,"_5":14945,"_28497":59396,"_3084":59444},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3634":2671,"_31331":2652,"_21707":59446,"_5":14945,"_28497":59396,"_3084":59447},[],"Profile",{"_3634":2672,"_31331":2652,"_21707":59449,"_5":14945,"_28497":59396,"_3084":59450},[],"Selected source, existing ID, allowed algorithm and size.",{"_3634":2673,"_31331":2652,"_21707":59452,"_5":14945,"_28497":59396,"_3084":59453},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3634":2674,"_31331":2652,"_21707":59455,"_5":14945,"_28497":59396,"_3084":56609},[],{"_3634":2675,"_31331":2652,"_21707":59457,"_5":14945,"_28497":59396,"_3084":59458},[],"Appropriate subject, SAN, usages and dates.",{"_3634":2676,"_31331":2652,"_21707":59460,"_5":14945,"_28497":59396,"_3084":59461},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3634":2677,"_31331":2652,"_21707":59463,"_5":14945,"_28497":59396,"_3084":59464},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3634":2678,"_31331":2652,"_21707":59466,"_5":14945,"_28497":59396,"_3084":59467},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3634":2679,"_31331":2652,"_21707":59469,"_5":14945,"_28497":59396,"_3084":59470},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3634":2680,"_31331":2652,"_21707":59472,"_5":14945,"_28497":59400,"_3084":59473},[],"Check each boundary independently:",{"_3634":2681,"_31331":2652,"_21707":59475,"_5":14945,"_28497":59400,"_3084":59476},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3634":2682,"_31331":2652,"_21707":59478,"_5":14945,"_28497":59400,"_3084":59479},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3634":2683,"_31331":2652,"_21707":59481,"_5":14945,"_28497":59400,"_3084":59482},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3634":2684,"_31331":2652,"_21707":59484,"_5":14945,"_28497":59400,"_3084":59485},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3634":2685,"_31331":2652,"_21707":59487,"_5":14945,"_28497":59400,"_3084":59488},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3634":2686,"_31331":2652,"_21707":59490,"_5":14945,"_28497":59400,"_3084":59491},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3634":2687,"_31331":2652,"_21707":59493,"_5":14945,"_28497":59404,"_3084":59494},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3634":2688,"_31331":2652,"_21707":59496,"_5":14945,"_28497":59404,"_3084":59497},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3634":2689,"_31331":2689,"_5":15305,"_3084":59499,"_31690":59500,"_21707":59501,"_28497":2689},"Security",[51145],[],{"_3634":2690,"_31331":2689,"_21707":59503,"_5":14945,"_28497":2689,"_3084":59504},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3634":2691,"_31331":2689,"_5":31687,"_21707":59506,"_28497":59507,"_3084":59508},[],"/docs/pr-preview/pr-81/security#report-a-vulnerability","Report a vulnerability",{"_3634":2692,"_31331":2689,"_5":31687,"_21707":59510,"_28497":59511,"_3084":59512},[],"/docs/pr-preview/pr-81/security#what-to-include-in-a-report","What to include in a report",{"_3634":2693,"_31331":2689,"_5":31687,"_21707":59514,"_28497":59515,"_3084":59516},[],"/docs/pr-preview/pr-81/security#supported-versions","Supported versions",{"_3634":2694,"_31331":2689,"_5":31687,"_21707":59518,"_28497":59519,"_3084":59520},[],"/docs/pr-preview/pr-81/security#responsible-disclosure","Responsible disclosure",{"_3634":2695,"_31331":2689,"_21707":59522,"_5":14945,"_28497":2689,"_3084":59523},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3634":2696,"_31331":2689,"_21707":59525,"_5":14945,"_28497":59507,"_3084":59526},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3634":2697,"_31331":2689,"_21707":59528,"_5":14945,"_28497":59507,"_3084":59529},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3634":2698,"_31331":2689,"_21707":59531,"_5":14945,"_28497":59507,"_3084":15584},[],{"_3634":2699,"_31331":2689,"_21707":59533,"_5":14945,"_28497":59507,"_3084":15513},[],{"_3634":2700,"_31331":2689,"_21707":59535,"_5":14945,"_28497":59507,"_3084":15571},[],{"_3634":2701,"_31331":2689,"_21707":59537,"_5":14945,"_28497":59507,"_3084":59538},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3634":2702,"_31331":2689,"_21707":59540,"_5":14945,"_28497":59507,"_3084":59541},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3634":2703,"_31331":2689,"_21707":59543,"_5":14945,"_28497":59511,"_3084":59544},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3634":2704,"_31331":2689,"_21707":59546,"_5":14945,"_28497":59511,"_3084":59547},[],"Do not include in the report:",{"_3634":2705,"_31331":2689,"_21707":59549,"_5":14945,"_28497":59511,"_3084":59550},[],"Credentials, tokens, or private keys",{"_3634":2706,"_31331":2689,"_21707":59552,"_5":14945,"_28497":59511,"_3084":59553},[],"Customer data or customer-identifiable information",{"_3634":2707,"_31331":2689,"_21707":59555,"_5":14945,"_28497":59511,"_3084":59556},[],"Confidential architecture or internal infrastructure details",{"_3634":2708,"_31331":2689,"_21707":59558,"_5":14945,"_28497":59515,"_3084":59559},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3634":2709,"_31331":2689,"_21707":59561,"_5":14945,"_28497":59515,"_3084":59562},[],"For upgrade guidance, see Upgrades.",{"_3634":2710,"_31331":2689,"_21707":59564,"_5":14945,"_28497":59519,"_3084":59565},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3634":2711,"_31331":2689,"_21707":59567,"_5":14945,"_28497":59519,"_3084":59568},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3634":2712,"_31331":2689,"_21707":59570,"_5":14945,"_28497":59519,"_3084":59571},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3634":2713,"_31331":2689,"_21707":59573,"_5":14945,"_28497":59519,"_3084":59574},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3634":2714,"_31331":2689,"_21707":59576,"_5":14945,"_28497":59519,"_3084":59577},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3634":2715,"_31331":2715,"_5":15305,"_3084":59579,"_31690":59580,"_21707":59582,"_28497":2715},"3.8.0 to 4.0.0",[51145,59581],"Upgrades",[],{"_3634":2716,"_31331":2715,"_21707":59584,"_5":14945,"_28497":2715,"_3084":59585},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3634":2717,"_31331":2715,"_5":31687,"_21707":59587,"_28497":59588,"_3084":59589},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3634":2718,"_31331":2715,"_5":31687,"_21707":59591,"_28497":59592,"_3084":59593},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3634":2719,"_31331":2715,"_5":31687,"_21707":59595,"_28497":59596,"_3084":59597},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3634":2720,"_31331":2715,"_5":31687,"_21707":59599,"_28497":59600,"_3084":59601},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3634":2721,"_31331":2715,"_5":31687,"_21707":59603,"_28497":59604,"_3084":59605},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3634":2722,"_31331":2715,"_5":31687,"_21707":59607,"_28497":59608,"_3084":59609},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3634":2723,"_31331":2715,"_5":31687,"_21707":59611,"_28497":59612,"_3084":59613},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3634":2724,"_31331":2715,"_5":31687,"_21707":59615,"_28497":59616,"_3084":59617},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3634":2725,"_31331":2715,"_5":31687,"_21707":59619,"_28497":59620,"_3084":59621},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3634":2726,"_31331":2715,"_5":31687,"_21707":59623,"_28497":59624,"_3084":59625},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3634":2727,"_31331":2715,"_5":31687,"_21707":59627,"_28497":59628,"_3084":51783},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3634":2728,"_31331":2715,"_5":31687,"_21707":59630,"_28497":59631,"_3084":59632},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3634":2729,"_31331":2715,"_5":31687,"_21707":59634,"_28497":59635,"_3084":59636},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3634":2730,"_31331":2715,"_5":31687,"_21707":59638,"_28497":59639,"_3084":59640},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3634":2731,"_31331":2715,"_5":31687,"_21707":59642,"_28497":59643,"_3084":59644},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3634":2732,"_31331":2715,"_5":31687,"_21707":59646,"_28497":59647,"_3084":59648},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3634":2733,"_31331":2715,"_5":31687,"_21707":59650,"_28497":59651,"_3084":59652},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3634":2734,"_31331":2715,"_5":31687,"_21707":59654,"_28497":59655,"_3084":59656},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3634":2735,"_31331":2715,"_5":31687,"_21707":59658,"_28497":59659,"_3084":59660},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3634":2736,"_31331":2715,"_5":31687,"_21707":59662,"_28497":59663,"_3084":59664},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3634":2737,"_31331":2715,"_5":31687,"_21707":59666,"_28497":59667,"_3084":59668},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3634":2738,"_31331":2715,"_5":31687,"_21707":59670,"_28497":59671,"_3084":59672},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3634":2739,"_31331":2715,"_5":31687,"_21707":59674,"_28497":59675,"_3084":59676},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3634":2740,"_31331":2715,"_5":31687,"_21707":59678,"_28497":59679,"_3084":59680},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3634":2741,"_31331":2715,"_5":31687,"_21707":59682,"_28497":59683,"_3084":59684},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3634":2742,"_31331":2715,"_5":31687,"_21707":59686,"_28497":59687,"_3084":59688},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3634":2743,"_31331":2715,"_5":31687,"_21707":59690,"_28497":59691,"_3084":59692},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3634":2744,"_31331":2715,"_5":31687,"_21707":59694,"_28497":59695,"_3084":59696},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3634":2745,"_31331":2715,"_5":31687,"_21707":59698,"_28497":59699,"_3084":59700},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3634":2746,"_31331":2715,"_5":31687,"_21707":59702,"_28497":59703,"_3084":59704},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3634":2747,"_31331":2715,"_5":31687,"_21707":59706,"_28497":59707,"_3084":59708},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3634":2748,"_31331":2715,"_5":31687,"_21707":59710,"_28497":59711,"_3084":59712},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3634":2749,"_31331":2715,"_5":31687,"_21707":59714,"_28497":59715,"_3084":59716},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3634":2750,"_31331":2715,"_5":31687,"_21707":59718,"_28497":59719,"_3084":59720},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3634":2751,"_31331":2715,"_5":31687,"_21707":59722,"_28497":59723,"_3084":59716},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3634":2752,"_31331":2715,"_5":31687,"_21707":59725,"_28497":59726,"_3084":59727},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3634":2753,"_31331":2715,"_5":31687,"_21707":59729,"_28497":59730,"_3084":59731},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3634":2754,"_31331":2715,"_5":31687,"_21707":59733,"_28497":59734,"_3084":59735},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3634":2755,"_31331":2715,"_5":31687,"_21707":59737,"_28497":59738,"_3084":59739},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3634":2756,"_31331":2715,"_5":31687,"_21707":59741,"_28497":59742,"_3084":59743},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3634":2757,"_31331":2715,"_5":31687,"_21707":59745,"_28497":59746,"_3084":59747},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3634":2758,"_31331":2715,"_5":31687,"_21707":59749,"_28497":59750,"_3084":59751},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3634":2759,"_31331":2715,"_5":31687,"_21707":59753,"_28497":59754,"_3084":59755},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3634":2760,"_31331":2715,"_5":31687,"_21707":59757,"_28497":59758,"_3084":59759},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3634":2761,"_31331":2715,"_5":31687,"_21707":59761,"_28497":59762,"_3084":55406},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3634":2762,"_31331":2715,"_5":31687,"_21707":59764,"_28497":59765,"_3084":59766},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3634":2763,"_31331":2715,"_5":31687,"_21707":59768,"_28497":59769,"_3084":59770},[],"/docs/pr-preview/pr-81/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3634":2764,"_31331":2715,"_21707":59772,"_5":14945,"_28497":2715,"_3084":59773},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3634":2765,"_31331":2715,"_21707":59775,"_5":14945,"_28497":2715,"_3084":59776},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3634":2766,"_31331":2715,"_21707":59778,"_5":14945,"_28497":2715,"_3084":59779},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3634":2767,"_31331":2715,"_21707":59781,"_5":14945,"_28497":2715,"_3084":59782},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3634":2768,"_31331":2715,"_21707":59784,"_5":14945,"_28497":2715,"_3084":59785},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3634":2769,"_31331":2715,"_21707":59787,"_5":14945,"_28497":2715,"_3084":59788},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3634":2770,"_31331":2715,"_21707":59790,"_5":14945,"_28497":2715,"_3084":59791},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3634":2771,"_31331":2715,"_21707":59793,"_5":14945,"_28497":59592,"_3084":59794},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3634":2772,"_31331":2715,"_21707":59796,"_5":14945,"_28497":59592,"_3084":59797},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3634":2773,"_31331":2715,"_21707":59799,"_5":14945,"_28497":59596,"_3084":59800},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3634":2774,"_31331":2715,"_21707":59802,"_5":14945,"_28497":59596,"_3084":59803},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3634":2775,"_31331":2715,"_21707":59805,"_5":14945,"_28497":59600,"_3084":59806},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own AMQP queue, which on AMQP the broker removes automatically when the instance stops (see Device events).",{"_3634":2776,"_31331":2715,"_21707":59808,"_5":14945,"_28497":59604,"_3084":59809},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3634":2777,"_31331":2715,"_21707":59811,"_5":14945,"_28497":59604,"_3084":59812},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3634":2778,"_31331":2715,"_21707":59814,"_5":14945,"_28497":59604,"_3084":59815},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3634":2779,"_31331":2715,"_21707":59817,"_5":14945,"_28497":59604,"_3084":59818},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3634":2780,"_31331":2715,"_21707":59820,"_5":14945,"_28497":59604,"_3084":59821},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3634":2781,"_31331":2715,"_21707":59823,"_5":14945,"_28497":59608,"_3084":59824},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3634":2782,"_31331":2715,"_21707":59826,"_5":14945,"_28497":59608,"_3084":59827},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3634":2783,"_31331":2715,"_21707":59829,"_5":14945,"_28497":59608,"_3084":59830},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3634":2784,"_31331":2715,"_21707":59832,"_5":14945,"_28497":59608,"_3084":59833},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3634":2785,"_31331":2715,"_21707":59835,"_5":14945,"_28497":59608,"_3084":59836},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3634":2786,"_31331":2715,"_21707":59838,"_5":14945,"_28497":59608,"_3084":59839},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3634":2787,"_31331":2715,"_21707":59841,"_5":14945,"_28497":59612,"_3084":59842},[],"Change",{"_3634":2788,"_31331":2715,"_21707":59844,"_5":14945,"_28497":59612,"_3084":59845},[],"Who is affected",{"_3634":2789,"_31331":2715,"_21707":59847,"_5":14945,"_28497":59612,"_3084":59848},[],"Severity",{"_3634":2790,"_31331":2715,"_21707":59850,"_5":14945,"_28497":59612,"_3084":58301},[],{"_3634":2791,"_31331":2715,"_21707":59852,"_5":14945,"_28497":59612,"_3084":59621},[],{"_3634":2792,"_31331":2715,"_21707":59854,"_5":14945,"_28497":59612,"_3084":59855},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3634":2793,"_31331":2715,"_21707":59857,"_5":14945,"_28497":59612,"_3084":59858},[],"High: KMS and VA start on empty volumes",{"_3634":2794,"_31331":2715,"_21707":59860,"_5":14945,"_28497":59612,"_3084":59861},[],"Copy the data into the new volumes",{"_3634":2795,"_31331":2715,"_21707":59863,"_5":14945,"_28497":59612,"_3084":59625},[],{"_3634":2796,"_31331":2715,"_21707":59865,"_5":14945,"_28497":59612,"_3084":59866},[],"Every Helm release",{"_3634":2797,"_31331":2715,"_21707":59868,"_5":14945,"_28497":59612,"_3084":59869},[],"High: `helm upgrade` fails",{"_3634":2798,"_31331":2715,"_21707":59871,"_5":14945,"_28497":59612,"_3084":59872},[],"Remove or rename legacy keys",{"_3634":2799,"_31331":2715,"_21707":59874,"_5":14945,"_28497":59612,"_3084":51783},[],{"_3634":2800,"_31331":2715,"_21707":59876,"_5":14945,"_28497":59612,"_3084":59866},[],{"_3634":2801,"_31331":2715,"_21707":59878,"_5":14945,"_28497":59612,"_3084":59879},[],"High: `helm upgrade` fails on inline credentials",{"_3634":2802,"_31331":2715,"_21707":59881,"_5":14945,"_28497":59612,"_3084":59882},[],"Create the Secrets first; see Step 2",{"_3634":2803,"_31331":2715,"_21707":59884,"_5":14945,"_28497":59612,"_3084":59632},[],{"_3634":2804,"_31331":2715,"_21707":59886,"_5":14945,"_28497":59612,"_3084":59887},[],"Every deployment",{"_3634":2805,"_31331":2715,"_21707":59889,"_5":14945,"_28497":59612,"_3084":59890},[],"High: without a bootstrap principal there is no administrator",{"_3634":2806,"_31331":2715,"_21707":59892,"_5":14945,"_28497":59612,"_3084":59893},[],"Configure `services.authz`",{"_3634":2807,"_31331":2715,"_21707":59895,"_5":14945,"_28497":59612,"_3084":59636},[],{"_3634":2808,"_31331":2715,"_21707":59897,"_5":14945,"_28497":59612,"_3084":59866},[],{"_3634":2809,"_31331":2715,"_21707":59899,"_5":14945,"_28497":59612,"_3084":59900},[],"High: `helm upgrade` fails on the old keys",{"_3634":2810,"_31331":2715,"_21707":59902,"_5":14945,"_28497":59612,"_3084":59903},[],"Move JWKS and roles into `services.authz`",{"_3634":2811,"_31331":2715,"_21707":59905,"_5":14945,"_28497":59612,"_3084":59656},[],{"_3634":2812,"_31331":2715,"_21707":59907,"_5":14945,"_28497":59612,"_3084":59908},[],"3.8.0 deployments with per-service databases",{"_3634":2813,"_31331":2715,"_21707":59910,"_5":14945,"_28497":59612,"_3084":59911},[],"High: services find no data, or a migration aborts",{"_3634":2814,"_31331":2715,"_21707":59913,"_5":14945,"_28497":59612,"_3084":59914},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3634":2815,"_31331":2715,"_21707":59916,"_5":14945,"_28497":59612,"_3084":59660},[],{"_3634":2816,"_31331":2715,"_21707":59918,"_5":14945,"_28497":59612,"_3084":59919},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3634":2817,"_31331":2715,"_21707":59921,"_5":14945,"_28497":59612,"_3084":59922},[],"High: the backend no longer starts with them",{"_3634":2818,"_31331":2715,"_21707":59924,"_5":14945,"_28497":59612,"_3084":59925},[],"Move to PostgreSQL before upgrading",{"_3634":2819,"_31331":2715,"_21707":59927,"_5":14945,"_28497":59612,"_3084":59708},[],{"_3634":2820,"_31331":2715,"_21707":59929,"_5":14945,"_28497":59612,"_3084":59930},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3634":2821,"_31331":2715,"_21707":59932,"_5":14945,"_28497":59612,"_3084":59933},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3634":2822,"_31331":2715,"_21707":59935,"_5":14945,"_28497":59612,"_3084":59936},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3634":2823,"_31331":2715,"_21707":59938,"_5":14945,"_28497":59612,"_3084":59939},[],"Webhooks with file references",{"_3634":2824,"_31331":2715,"_21707":59941,"_5":14945,"_28497":59612,"_3084":59942},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3634":2825,"_31331":2715,"_21707":59944,"_5":14945,"_28497":59612,"_3084":59945},[],"High: enrollments calling the webhook fail",{"_3634":2826,"_31331":2715,"_21707":59947,"_5":14945,"_28497":59612,"_3084":59948},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3634":2827,"_31331":2715,"_21707":59950,"_5":14945,"_28497":59612,"_3084":59640},[],{"_3634":2828,"_31331":2715,"_21707":59952,"_5":14945,"_28497":59612,"_3084":59953},[],"Releases with per-service identity overrides or mounted key material",{"_3634":2829,"_31331":2715,"_21707":59955,"_5":14945,"_28497":59612,"_3084":59956},[],"Medium: services cannot read their files",{"_3634":2830,"_31331":2715,"_21707":59958,"_5":14945,"_28497":59612,"_3084":59959},[],"Remove the overrides and fix volume ownership",{"_3634":2831,"_31331":2715,"_21707":59961,"_5":14945,"_28497":59612,"_3084":59644},[],{"_3634":2832,"_31331":2715,"_21707":59963,"_5":14945,"_28497":59612,"_3084":59964},[],"Releases that set `amqp.tls`",{"_3634":2833,"_31331":2715,"_21707":59966,"_5":14945,"_28497":59612,"_3084":59967},[],"Medium: clients connect to the wrong port",{"_3634":2834,"_31331":2715,"_21707":59969,"_5":14945,"_28497":59612,"_3084":59970},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3634":2835,"_31331":2715,"_21707":59972,"_5":14945,"_28497":59612,"_3084":59664},[],{"_3634":2836,"_31331":2715,"_21707":59974,"_5":14945,"_28497":59612,"_3084":59975},[],"Installations whose CA keys predate the KMS",{"_3634":2837,"_31331":2715,"_21707":59977,"_5":14945,"_28497":59612,"_3084":59978},[],"Medium: CA keys stay unmanaged",{"_3634":2838,"_31331":2715,"_21707":59980,"_5":14945,"_28497":59612,"_3084":59981},[],"Run the CA-to-KMS migration",{"_3634":2839,"_31331":2715,"_21707":59983,"_5":14945,"_28497":59612,"_3084":59984},[],"Receiver certificate verification",{"_3634":2840,"_31331":2715,"_21707":59986,"_5":14945,"_28497":59612,"_3084":59987},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3634":2841,"_31331":2715,"_21707":59989,"_5":14945,"_28497":59612,"_3084":59990},[],"Medium: credentials go to an unverified receiver",{"_3634":2842,"_31331":2715,"_21707":59992,"_5":14945,"_28497":59612,"_3084":59993},[],"Set `insecure_skip_verify` to `false`",{"_3634":2843,"_31331":2715,"_21707":59995,"_5":14945,"_28497":59612,"_3084":59680},[],{"_3634":2844,"_31331":2715,"_21707":59997,"_5":14945,"_28497":59612,"_3084":59998},[],"Scripts and consoles that edit DMSs through the API",{"_3634":2845,"_31331":2715,"_21707":60000,"_5":14945,"_28497":59612,"_3084":60001},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3634":2846,"_31331":2715,"_21707":60003,"_5":14945,"_28497":59612,"_3084":60004},[],"Read the DMS before editing and use the new field",{"_3634":2847,"_31331":2715,"_21707":60006,"_5":14945,"_28497":59612,"_3084":59684},[],{"_3634":2848,"_31331":2715,"_21707":60008,"_5":14945,"_28497":59612,"_3084":60009},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3634":2849,"_31331":2715,"_21707":60011,"_5":14945,"_28497":59612,"_3084":60012},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3634":2850,"_31331":2715,"_21707":60014,"_5":14945,"_28497":59612,"_3084":60015},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3634":2851,"_31331":2715,"_21707":60017,"_5":14945,"_28497":59612,"_3084":59704},[],{"_3634":2852,"_31331":2715,"_21707":60019,"_5":14945,"_28497":59612,"_3084":60020},[],"Clients that create or update CRL settings through the API",{"_3634":2853,"_31331":2715,"_21707":60022,"_5":14945,"_28497":59612,"_3084":60023},[],"Medium: requests with the old field return an error",{"_3634":2854,"_31331":2715,"_21707":60025,"_5":14945,"_28497":59612,"_3084":60026},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3634":2855,"_31331":2715,"_21707":60028,"_5":14945,"_28497":59612,"_3084":59712},[],{"_3634":2856,"_31331":2715,"_21707":60030,"_5":14945,"_28497":59612,"_3084":60031},[],"Alert subscriptions and consumers of the VA events",{"_3634":2857,"_31331":2715,"_21707":60033,"_5":14945,"_28497":59612,"_3084":60034},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3634":2858,"_31331":2715,"_21707":60036,"_5":14945,"_28497":59612,"_3084":60037},[],"Review conditions filtering on the old event payload or subject",{"_3634":2859,"_31331":2715,"_21707":60039,"_5":14945,"_28497":59612,"_3084":59716},[],{"_3634":2860,"_31331":2715,"_21707":60041,"_5":14945,"_28497":59612,"_3084":60042},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3634":2861,"_31331":2715,"_21707":60044,"_5":14945,"_28497":59612,"_3084":60045},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3634":2862,"_31331":2715,"_21707":60047,"_5":14945,"_28497":59612,"_3084":60048},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3634":2863,"_31331":2715,"_21707":60050,"_5":14945,"_28497":59612,"_3084":59700},[],{"_3634":2864,"_31331":2715,"_21707":60052,"_5":14945,"_28497":59612,"_3084":60053},[],"Consumers that read the device `events` field",{"_3634":2865,"_31331":2715,"_21707":60055,"_5":14945,"_28497":59612,"_3084":60056},[],"Medium: the field disappears",{"_3634":2866,"_31331":2715,"_21707":60058,"_5":14945,"_28497":59612,"_3084":60059},[],"Use the new event endpoints",{"_3634":2867,"_31331":2715,"_21707":60061,"_5":14945,"_28497":59612,"_3084":59727},[],{"_3634":2868,"_31331":2715,"_21707":60063,"_5":14945,"_28497":59612,"_3084":60064},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3634":2869,"_31331":2715,"_21707":60066,"_5":14945,"_28497":59612,"_3084":60067},[],"Medium: the VA migration aborts",{"_3634":2870,"_31331":2715,"_21707":60069,"_5":14945,"_28497":59612,"_3084":60070},[],"Fix the affected roles before upgrading",{"_3634":2871,"_31331":2715,"_21707":60072,"_5":14945,"_28497":59612,"_3084":59648},[],{"_3634":2872,"_31331":2715,"_21707":60074,"_5":14945,"_28497":59612,"_3084":60075},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3634":2873,"_31331":2715,"_21707":60077,"_5":14945,"_28497":59612,"_3084":60078},[],"Low to medium: validation errors or changed defaults",{"_3634":2874,"_31331":2715,"_21707":60080,"_5":14945,"_28497":59612,"_3084":60081},[],"Update the values file",{"_3634":2875,"_31331":2715,"_21707":60083,"_5":14945,"_28497":59612,"_3084":59692},[],{"_3634":2876,"_31331":2715,"_21707":60085,"_5":14945,"_28497":59612,"_3084":60086},[],"Clients that send the DMS ID in the update body",{"_3634":2877,"_31331":2715,"_21707":60088,"_5":14945,"_28497":59612,"_3084":60089},[],"Low: the ID in the URL wins",{"_3634":2878,"_31331":2715,"_21707":60091,"_5":14945,"_28497":59612,"_3084":60092},[],"Send the ID in the URL",{"_3634":2879,"_31331":2715,"_21707":60094,"_5":14945,"_28497":59612,"_3084":59720},[],{"_3634":2880,"_31331":2715,"_21707":60096,"_5":14945,"_28497":59612,"_3084":60097},[],"Clients that send an `id` when creating or importing CAs",{"_3634":2881,"_31331":2715,"_21707":60099,"_5":14945,"_28497":59612,"_3084":60100},[],"Low: the ID in the body is ignored, and the field is removed",{"_3634":2882,"_31331":2715,"_21707":60102,"_5":14945,"_28497":59612,"_3084":60103},[],"Let the backend assign the ID and use the returned one",{"_3634":2883,"_31331":2715,"_21707":60105,"_5":14945,"_28497":59612,"_3084":59716},[],{"_3634":2884,"_31331":2715,"_21707":60107,"_5":14945,"_28497":59612,"_3084":60108},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3634":2885,"_31331":2715,"_21707":60110,"_5":14945,"_28497":59612,"_3084":60111},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3634":2886,"_31331":2715,"_21707":60113,"_5":14945,"_28497":59612,"_3084":60114},[],"Use the KMS `sign` and `verify` operations",{"_3634":2887,"_31331":2715,"_21707":60116,"_5":14945,"_28497":59612,"_3084":59696},[],{"_3634":2888,"_31331":2715,"_21707":60118,"_5":14945,"_28497":59612,"_3084":60119},[],"Consumers that match on certificate `type`",{"_3634":2889,"_31331":2715,"_21707":60121,"_5":14945,"_28497":59612,"_3084":60122},[],"Low: two values are renamed",{"_3634":2890,"_31331":2715,"_21707":60124,"_5":14945,"_28497":59612,"_3084":60125},[],"Adapt consumers",{"_3634":2891,"_31331":2715,"_21707":60127,"_5":14945,"_28497":59612,"_3084":59688},[],{"_3634":2892,"_31331":2715,"_21707":60129,"_5":14945,"_28497":59612,"_3084":60130},[],"Any DMS",{"_3634":2893,"_31331":2715,"_21707":60132,"_5":14945,"_28497":59612,"_3084":60133},[],"Low: informational",{"_3634":2894,"_31331":2715,"_21707":60135,"_5":14945,"_28497":59612,"_3084":60136},[],"Read both blocks before editing",{"_3634":2895,"_31331":2715,"_21707":60138,"_5":14945,"_28497":59620,"_3084":60139},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3634":2896,"_31331":2715,"_21707":60141,"_5":14945,"_28497":59620,"_3084":60142},[],"Step 4 of the migration guide copies the data.",{"_3634":2897,"_31331":2715,"_21707":60144,"_5":14945,"_28497":59624,"_3084":60145},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3634":2898,"_31331":2715,"_21707":60147,"_5":14945,"_28497":59628,"_3084":60148},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3634":2899,"_31331":2715,"_21707":60150,"_5":14945,"_28497":59628,"_3084":60151},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3634":2900,"_31331":2715,"_21707":60153,"_5":14945,"_28497":59631,"_3084":60154},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3634":2901,"_31331":2715,"_21707":60156,"_5":14945,"_28497":59635,"_3084":60157},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3634":2902,"_31331":2715,"_21707":60159,"_5":14945,"_28497":59639,"_3084":60160},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3634":2903,"_31331":2715,"_21707":60162,"_5":14945,"_28497":59639,"_3084":60163},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3634":2904,"_31331":2715,"_21707":60165,"_5":14945,"_28497":59639,"_3084":60166},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3634":2905,"_31331":2715,"_21707":60168,"_5":14945,"_28497":59643,"_3084":60169},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3634":2906,"_31331":2715,"_21707":60171,"_5":14945,"_28497":59647,"_3084":60172},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3634":2907,"_31331":2715,"_21707":60174,"_5":14945,"_28497":59647,"_3084":60175},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3634":2908,"_31331":2715,"_21707":60177,"_5":14945,"_28497":59647,"_3084":60178},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3634":2909,"_31331":2715,"_21707":60180,"_5":14945,"_28497":59647,"_3084":60181},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3634":2910,"_31331":2715,"_21707":60183,"_5":14945,"_28497":59647,"_3084":60184},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3634":2911,"_31331":2715,"_21707":60186,"_5":14945,"_28497":59647,"_3084":60187},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3634":2912,"_31331":2715,"_21707":60189,"_5":14945,"_28497":59655,"_3084":60190},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3634":2913,"_31331":2715,"_21707":60192,"_5":14945,"_28497":59655,"_3084":60193},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3634":2914,"_31331":2715,"_21707":60195,"_5":14945,"_28497":59655,"_3084":60196},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3634":2915,"_31331":2715,"_21707":60198,"_5":14945,"_28497":59655,"_3084":60199},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3634":2916,"_31331":2715,"_21707":60201,"_5":14945,"_28497":59655,"_3084":60202},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3634":2917,"_31331":2715,"_21707":60204,"_5":14945,"_28497":59659,"_3084":60205},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3634":2918,"_31331":2715,"_21707":60207,"_5":14945,"_28497":59663,"_3084":60208},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3634":2919,"_31331":2715,"_21707":60210,"_5":14945,"_28497":59663,"_3084":60211},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3634":2920,"_31331":2715,"_21707":60213,"_5":14945,"_28497":59663,"_3084":60214},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3634":2921,"_31331":2715,"_21707":60216,"_5":14945,"_28497":59663,"_3084":60217},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3634":2922,"_31331":2715,"_21707":60219,"_5":14945,"_28497":59663,"_3084":60220},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3634":2923,"_31331":2715,"_21707":60222,"_5":14945,"_28497":59663,"_3084":60223},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3634":2924,"_31331":2715,"_21707":60225,"_5":14945,"_28497":59663,"_3084":60226},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3634":2925,"_31331":2715,"_21707":60228,"_5":14945,"_28497":59663,"_3084":60229},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3634":2926,"_31331":2715,"_21707":60231,"_5":14945,"_28497":59667,"_3084":60232},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3634":2927,"_31331":2715,"_21707":60234,"_5":14945,"_28497":59675,"_3084":60235},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3634":2928,"_31331":2715,"_21707":60237,"_5":14945,"_28497":59675,"_3084":60238},[],"Field in 3.8.0",{"_3634":2929,"_31331":2715,"_21707":60240,"_5":14945,"_28497":59675,"_3084":60241},[],"Field in 4.0.0",{"_3634":2930,"_31331":2715,"_21707":60243,"_5":14945,"_28497":59675,"_3084":60244},[],"`validate_server_cert`",{"_3634":2931,"_31331":2715,"_21707":60246,"_5":14945,"_28497":59675,"_3084":60247},[],"`insecure_skip_verify` (value negated)",{"_3634":2932,"_31331":2715,"_21707":60249,"_5":14945,"_28497":59675,"_3084":60250},[],"`oidc`",{"_3634":2933,"_31331":2715,"_21707":60252,"_5":14945,"_28497":59675,"_3084":60253},[],"`jwt_options`",{"_3634":2934,"_31331":2715,"_21707":60255,"_5":14945,"_28497":59675,"_3084":60256},[],"`apikey`",{"_3634":2935,"_31331":2715,"_21707":60258,"_5":14945,"_28497":59675,"_3084":60259},[],"`apikey_options`",{"_3634":2936,"_31331":2715,"_21707":60261,"_5":14945,"_28497":59675,"_3084":60262},[],"`mtls`",{"_3634":2937,"_31331":2715,"_21707":60264,"_5":14945,"_28497":59675,"_3084":60265},[],"`mtls_options`",{"_3634":2938,"_31331":2715,"_21707":60267,"_5":14945,"_28497":59675,"_3084":60268},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3634":2939,"_31331":2715,"_21707":60270,"_5":14945,"_28497":59675,"_3084":60271},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3634":2940,"_31331":2715,"_21707":60273,"_5":14945,"_28497":59675,"_3084":60274},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3634":2941,"_31331":2715,"_21707":60276,"_5":14945,"_28497":59679,"_3084":60277},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3634":2942,"_31331":2715,"_21707":60279,"_5":14945,"_28497":59679,"_3084":60280},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3634":2943,"_31331":2715,"_21707":60282,"_5":14945,"_28497":59679,"_3084":60283},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3634":2944,"_31331":2715,"_21707":60285,"_5":14945,"_28497":59683,"_3084":60286},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3634":2945,"_31331":2715,"_21707":60288,"_5":14945,"_28497":59683,"_3084":60289},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3634":2946,"_31331":2715,"_21707":60291,"_5":14945,"_28497":59687,"_3084":60292},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3634":2947,"_31331":2715,"_21707":60294,"_5":14945,"_28497":59691,"_3084":60295},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3634":2948,"_31331":2715,"_21707":60297,"_5":14945,"_28497":59695,"_3084":60298},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3634":2949,"_31331":2715,"_21707":60300,"_5":14945,"_28497":59699,"_3084":60301},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3634":2950,"_31331":2715,"_21707":60303,"_5":14945,"_28497":59699,"_3084":60304},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3634":2951,"_31331":2715,"_21707":60306,"_5":14945,"_28497":59699,"_3084":60307},[],"`POST /v1/devices/:id/events` creates an event.",{"_3634":2952,"_31331":2715,"_21707":60309,"_5":14945,"_28497":59699,"_3084":60310},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Delivery is best effort: events emitted while no client is connected are not replayed on the next connection. The server closes each stream after a maximum lifetime, 10 minutes by default and configurable with the Device Manager `sse_max_stream_duration` setting, and the client reconnects to keep receiving events. When an instance has reached its subscriber limit, set by the Device Manager `sse_max_subscribers` setting (default 1000 and shared by all streams of the instance), new streams receive a `503` response with a `Retry-After` header. Each stream also re-checks the reader's permission to read the device, and closes it when the permission is revoked or cannot be verified; reconnecting goes through the regular authorization checks again.",{"_3634":2953,"_31331":2715,"_21707":60312,"_5":14945,"_28497":59699,"_3084":60313},[],"On AMQP, each Device Manager instance binds a subscriber queue named after its service ID, `device-manager-sse-<uuid>`. The queue is durable and auto-delete, with a one-hour expiration (`x-expires`), so the broker removes it when the instance stops or its connection dies and no cleanup policy is needed. Only on event-bus providers without ephemeral-subscriber support can a per-process durable queue linger after its instance stops; check those providers if you observe leftover queues.",{"_3634":2954,"_31331":2715,"_21707":60315,"_5":14945,"_28497":59703,"_3084":60316},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3634":2955,"_31331":2715,"_21707":60318,"_5":14945,"_28497":59707,"_3084":60319},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3634":2956,"_31331":2715,"_21707":60321,"_5":14945,"_28497":59707,"_3084":60322},[],"Route",{"_3634":2957,"_31331":2715,"_21707":60324,"_5":14945,"_28497":59707,"_3084":54594},[],{"_3634":2958,"_31331":2715,"_21707":60326,"_5":14945,"_28497":59707,"_3084":60327},[],"`GET /v1/crl-settings`",{"_3634":2959,"_31331":2715,"_21707":60329,"_5":14945,"_28497":59707,"_3084":60330},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3634":2960,"_31331":2715,"_21707":60332,"_5":14945,"_28497":59707,"_3084":60333},[],"`GET /v1/crl-settings/{ca-id}`",{"_3634":2961,"_31331":2715,"_21707":60335,"_5":14945,"_28497":59707,"_3084":60336},[],"Reads the settings of a CA.",{"_3634":2962,"_31331":2715,"_21707":60338,"_5":14945,"_28497":59707,"_3084":60339},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3634":2963,"_31331":2715,"_21707":60341,"_5":14945,"_28497":59707,"_3084":60342},[],"Replaces `crl_options`.",{"_3634":2964,"_31331":2715,"_21707":60344,"_5":14945,"_28497":59707,"_3084":60345},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3634":2965,"_31331":2715,"_21707":60347,"_5":14945,"_28497":59707,"_3084":60348},[],"Removes the archived settings of a CA.",{"_3634":2966,"_31331":2715,"_21707":60350,"_5":14945,"_28497":59707,"_3084":60351},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3634":2967,"_31331":2715,"_21707":60353,"_5":14945,"_28497":59707,"_3084":60354},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3634":2968,"_31331":2715,"_21707":60356,"_5":14945,"_28497":59707,"_3084":60357},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3634":2969,"_31331":2715,"_21707":60359,"_5":14945,"_28497":59707,"_3084":60360},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3634":2970,"_31331":2715,"_21707":60362,"_5":14945,"_28497":59707,"_3084":60363},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3634":2971,"_31331":2715,"_21707":60365,"_5":14945,"_28497":59707,"_3084":60366},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3634":2972,"_31331":2715,"_21707":60368,"_5":14945,"_28497":59707,"_3084":60369},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3634":2973,"_31331":2715,"_21707":60371,"_5":14945,"_28497":59707,"_3084":60372},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3634":2974,"_31331":2715,"_21707":60374,"_5":14945,"_28497":59707,"_3084":60375},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3634":2975,"_31331":2715,"_21707":60377,"_5":14945,"_28497":59707,"_3084":60378},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3634":2976,"_31331":2715,"_21707":60380,"_5":14945,"_28497":59707,"_3084":60381},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3634":2977,"_31331":2715,"_21707":60383,"_5":14945,"_28497":59711,"_3084":60384},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3634":2978,"_31331":2715,"_21707":60386,"_5":14945,"_28497":59715,"_3084":60387},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3634":2979,"_31331":2715,"_21707":60389,"_5":14945,"_28497":59719,"_3084":60390},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3634":2980,"_31331":2715,"_21707":60392,"_5":14945,"_28497":59723,"_3084":60393},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3634":2981,"_31331":2715,"_21707":60395,"_5":14945,"_28497":59723,"_3084":60396},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3634":2982,"_31331":2715,"_21707":60398,"_5":14945,"_28497":59726,"_3084":60399},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3634":2983,"_31331":2715,"_21707":60401,"_5":14945,"_28497":59730,"_3084":60402},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3634":2984,"_31331":2715,"_21707":60404,"_5":14945,"_28497":59734,"_3084":60405},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3634":2985,"_31331":2715,"_21707":60407,"_5":14945,"_28497":59734,"_3084":60408},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3634":2986,"_31331":2715,"_21707":60410,"_5":14945,"_28497":59734,"_3084":60411},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3634":2987,"_31331":2715,"_21707":60413,"_5":14945,"_28497":59734,"_3084":60414},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3634":2988,"_31331":2715,"_21707":60416,"_5":14945,"_28497":59734,"_3084":60417},[],"Record the names of your local-storage PVCs:",{"_3634":2989,"_31331":2715,"_21707":60419,"_5":14945,"_28497":59734,"_3084":60420},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3634":2990,"_31331":2715,"_21707":60422,"_5":14945,"_28497":59738,"_3084":60423},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3634":2991,"_31331":2715,"_21707":60425,"_5":14945,"_28497":59738,"_3084":60426},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3634":2992,"_31331":2715,"_21707":60428,"_5":14945,"_28497":59738,"_3084":60429},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3634":2993,"_31331":2715,"_21707":60431,"_5":14945,"_28497":59738,"_3084":60432},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3634":2994,"_31331":2715,"_21707":60434,"_5":14945,"_28497":59738,"_3084":60435},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3634":2995,"_31331":2715,"_21707":60437,"_5":14945,"_28497":59742,"_3084":60438},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3634":2996,"_31331":2715,"_21707":60440,"_5":14945,"_28497":59742,"_3084":60441},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3634":2997,"_31331":2715,"_21707":60443,"_5":14945,"_28497":59742,"_3084":60444},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3634":2998,"_31331":2715,"_21707":60446,"_5":14945,"_28497":59742,"_3084":60447},[],"Secret (`existingSecret`)",{"_3634":2999,"_31331":2715,"_21707":60449,"_5":14945,"_28497":59742,"_3084":60450},[],"Required data keys",{"_3634":3000,"_31331":2715,"_21707":60452,"_5":14945,"_28497":59742,"_3084":60453},[],"When",{"_3634":3001,"_31331":2715,"_21707":60455,"_5":14945,"_28497":59742,"_3084":60456},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3634":3002,"_31331":2715,"_21707":60458,"_5":14945,"_28497":59742,"_3084":60459},[],"`username`, `password`",{"_3634":3003,"_31331":2715,"_21707":60461,"_5":14945,"_28497":59742,"_3084":60462},[],"Always",{"_3634":3004,"_31331":2715,"_21707":60464,"_5":14945,"_28497":59742,"_3084":60465},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3634":3005,"_31331":2715,"_21707":60467,"_5":14945,"_28497":59742,"_3084":60459},[],{"_3634":3006,"_31331":2715,"_21707":60469,"_5":14945,"_28497":59742,"_3084":60462},[],{"_3634":3007,"_31331":2715,"_21707":60471,"_5":14945,"_28497":59742,"_3084":60472},[],"`services.alerts.smtp_server.existingSecret`",{"_3634":3008,"_31331":2715,"_21707":60474,"_5":14945,"_28497":59742,"_3084":60459},[],{"_3634":3009,"_31331":2715,"_21707":60476,"_5":14945,"_28497":59742,"_3084":60477},[],"Only when SMTP authentication is enabled",{"_3634":3010,"_31331":2715,"_21707":60479,"_5":14945,"_28497":59742,"_3084":60480},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3634":3011,"_31331":2715,"_21707":60482,"_5":14945,"_28497":59742,"_3084":60483},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3634":3012,"_31331":2715,"_21707":60485,"_5":14945,"_28497":59742,"_3084":60486},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3634":3013,"_31331":2715,"_21707":60488,"_5":14945,"_28497":59742,"_3084":60489},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3634":3014,"_31331":2715,"_21707":60491,"_5":14945,"_28497":59742,"_3084":60492},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3634":3015,"_31331":2715,"_21707":60494,"_5":14945,"_28497":59742,"_3084":60495},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3634":3016,"_31331":2715,"_21707":60497,"_5":14945,"_28497":59742,"_3084":60498},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3634":3017,"_31331":2715,"_21707":60500,"_5":14945,"_28497":59742,"_3084":60501},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3634":3018,"_31331":2715,"_21707":60503,"_5":14945,"_28497":59742,"_3084":60504},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3634":3019,"_31331":2715,"_21707":60506,"_5":14945,"_28497":59742,"_3084":60507},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3634":3020,"_31331":2715,"_21707":60509,"_5":14945,"_28497":59742,"_3084":60510},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3634":3021,"_31331":2715,"_21707":60512,"_5":14945,"_28497":59742,"_3084":60513},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3634":3022,"_31331":2715,"_21707":60515,"_5":14945,"_28497":59742,"_3084":60516},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3634":3023,"_31331":2715,"_21707":60518,"_5":14945,"_28497":59742,"_3084":60519},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3634":3024,"_31331":2715,"_21707":60521,"_5":14945,"_28497":59742,"_3084":60522},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3634":3025,"_31331":2715,"_21707":60524,"_5":14945,"_28497":59746,"_3084":60525},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3634":3026,"_31331":2715,"_21707":60527,"_5":14945,"_28497":59746,"_3084":60528},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3634":3027,"_31331":2715,"_21707":60530,"_5":14945,"_28497":59750,"_3084":60531},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3634":3028,"_31331":2715,"_21707":60533,"_5":14945,"_28497":59750,"_3084":60534},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3634":3029,"_31331":2715,"_21707":60536,"_5":14945,"_28497":59750,"_3084":60537},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3634":3030,"_31331":2715,"_21707":60539,"_5":14945,"_28497":59750,"_3084":60540},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3634":3031,"_31331":2715,"_21707":60542,"_5":14945,"_28497":59750,"_3084":60543},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3634":3032,"_31331":2715,"_21707":60545,"_5":14945,"_28497":59750,"_3084":60546},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3634":3033,"_31331":2715,"_21707":60548,"_5":14945,"_28497":59750,"_3084":60549},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3634":3034,"_31331":2715,"_21707":60551,"_5":14945,"_28497":59750,"_3084":60552},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3634":3035,"_31331":2715,"_21707":60554,"_5":14945,"_28497":59750,"_3084":60555},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3634":3036,"_31331":2715,"_21707":60557,"_5":14945,"_28497":59750,"_3084":60558},[],"**Remove the helper and restore the recorded replica counts:**",{"_3634":3037,"_31331":2715,"_21707":60560,"_5":14945,"_28497":59750,"_3084":60561},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3634":3038,"_31331":2715,"_21707":60563,"_5":14945,"_28497":59754,"_3084":60564},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3634":3039,"_31331":2715,"_21707":60566,"_5":14945,"_28497":59754,"_3084":60567},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3634":3040,"_31331":2715,"_21707":60569,"_5":14945,"_28497":59758,"_3084":60570},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3634":3041,"_31331":2715,"_21707":60572,"_5":14945,"_28497":59758,"_3084":60573},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3634":3042,"_31331":2715,"_21707":60575,"_5":14945,"_28497":59758,"_3084":60576},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3634":3043,"_31331":2715,"_21707":60578,"_5":14945,"_28497":59758,"_3084":60579},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3634":3044,"_31331":2715,"_21707":60581,"_5":14945,"_28497":59758,"_3084":60582},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3634":3045,"_31331":2715,"_21707":60584,"_5":14945,"_28497":59758,"_3084":60585},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3634":3046,"_31331":2715,"_21707":60587,"_5":14945,"_28497":59758,"_3084":60588},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3634":3047,"_31331":2715,"_21707":60590,"_5":14945,"_28497":59758,"_3084":60591},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3634":3048,"_31331":2715,"_21707":60593,"_5":14945,"_28497":59762,"_3084":60594},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3634":3049,"_31331":2715,"_21707":60596,"_5":14945,"_28497":59762,"_3084":60597},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3634":3050,"_31331":2715,"_21707":60599,"_5":14945,"_28497":59762,"_3084":60600},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3634":3051,"_31331":2715,"_21707":60602,"_5":14945,"_28497":59762,"_3084":60603},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3634":3052,"_31331":2715,"_21707":60605,"_5":14945,"_28497":59762,"_3084":60606},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3634":3053,"_31331":2715,"_21707":60608,"_5":14945,"_28497":59762,"_3084":60609},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3634":3054,"_31331":2715,"_21707":60611,"_5":14945,"_28497":59762,"_3084":60612},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3634":3055,"_31331":2715,"_21707":60614,"_5":14945,"_28497":59762,"_3084":60615},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3634":3056,"_31331":2715,"_21707":60617,"_5":14945,"_28497":59762,"_3084":60618},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3634":3057,"_31331":2715,"_21707":60620,"_5":14945,"_28497":59762,"_3084":60621},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3634":3058,"_31331":2715,"_21707":60623,"_5":14945,"_28497":59762,"_3084":60624},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3634":3059,"_31331":2715,"_21707":60626,"_5":14945,"_28497":59765,"_3084":60627},[],"After the upgrade, check in this order:",{"_3634":3060,"_31331":2715,"_21707":60629,"_5":14945,"_28497":59765,"_3084":60630},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3634":3061,"_31331":2715,"_21707":60632,"_5":14945,"_28497":59765,"_3084":60633},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3634":3062,"_31331":2715,"_21707":60635,"_5":14945,"_28497":59765,"_3084":60636},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3634":3063,"_31331":2715,"_21707":60638,"_5":14945,"_28497":59765,"_3084":60639},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3634":3064,"_31331":2715,"_21707":60641,"_5":14945,"_28497":59765,"_3084":60642},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3634":3065,"_31331":2715,"_21707":60644,"_5":14945,"_28497":59765,"_3084":60645},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3634":3066,"_31331":2715,"_21707":60647,"_5":14945,"_28497":59765,"_3084":60648},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3634":3067,"_31331":2715,"_21707":60650,"_5":14945,"_28497":59765,"_3084":60651},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3634":3068,"_31331":2715,"_21707":60653,"_5":14945,"_28497":59765,"_3084":60654},[],"**AMQP.** The backend connects to the broker with the expected TLS settings. On AMQP the SSE subscriber queues are auto-delete and disappear when their instance stops; on event-bus providers without ephemeral-subscriber support, check that leftover per-process SSE queues are not accumulating.",{"_3634":3069,"_31331":2715,"_21707":60656,"_5":14945,"_28497":59765,"_3084":60657},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3634":3070,"_31331":2715,"_21707":60659,"_5":14945,"_28497":59765,"_3084":60660},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3634":3071,"_31331":2715,"_21707":60662,"_5":14945,"_28497":59765,"_3084":60663},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3634":3072,"_31331":2715,"_21707":60665,"_5":14945,"_28497":59765,"_3084":60666},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3634":3073,"_31331":2715,"_21707":60668,"_5":14945,"_28497":59765,"_3084":60669},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3634":3074,"_31331":2715,"_21707":60671,"_5":14945,"_28497":59765,"_3084":60672},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3634":3075,"_31331":2715,"_21707":60674,"_5":14945,"_28497":59769,"_3084":60675},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3634":3076,"_31331":2715,"_21707":60677,"_5":14945,"_28497":59769,"_3084":60678},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3634":3077,"_31331":2715,"_21707":60680,"_5":14945,"_28497":59769,"_3084":60681},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":3078,"_31331":2715,"_21707":60683,"_5":14945,"_28497":59769,"_3084":60684},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3634":3079,"_31331":2715,"_21707":60686,"_5":14945,"_28497":59769,"_3084":60687},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60690":60691,"_60692":60693,"_60694":60695,"_60696":60697,"_18814":3119,"_72971":3119},"language","english","sortableProperties",[3084,31331,5,28497],"sortablePropertiesWithTypes",{"_3084":25888,"_31331":25888,"_5":25888,"_28497":25888},"sorts",{"_3084":60698,"_31331":63767,"_5":66835,"_28497":69903},{"_4838":60699,"_60700":60701,"_5":25888},{"_15026":3396,"_15405":7977,"_15424":3252,"_30326":4041,"_15411":7277,"_20619":12949,"_15047":7038,"_15054":7939,"_30263":4175,"_30676":5051,"_30708":3586,"_30302":7508,"_35747":3340,"_30405":7841,"_30752":5633,"_35754":15476,"_35757":5356,"_35760":6257,"_35763":13639,"_31154":9858,"_35768":3383,"_35770":7256,"_31189":4768,"_15