893":130381,"_41895":130383,"_41897":130385,"_41899":130388,"_41901":130391,"_41903":130394,"_41905":130397,"_41907":130400,"_41909":130403,"_41911":130406,"_41913":130409,"_41915":130412,"_41917":130415,"_41919":130418,"_41921":130421,"_41923":130424,"_41925":130427,"_41927":130430,"_41929":130433,"_41931":130436,"_41933":130439,"_41935":130442,"_41937":130445,"_41939":130448,"_41942":130451,"_41944":130454,"_41946":130457,"_41948":130460,"_41950":130463,"_41952":130466,"_41954":130469,"_41956":130472,"_41958":130475,"_41960":130478,"_41962":130481,"_41964":130484,"_41966":130487,"_41968":130490,"_41971":130493,"_41973":130496,"_41975":130499,"_41977":130502,"_41979":130505,"_41981":130508,"_41983":130511,"_41985":130514,"_41987":130517,"_41989":130520,"_41991":130523,"_41993":130526,"_41995":130529,"_41997":130532,"_41999":130535,"_42001":130538,"_42003":130541,"_42005":130544,"_42007":130547,"_42009":130550,"_42011":130553,"_42013":130556,"_42015":130559,"_42017":130562,"_42019":130565,"_42021":130568,"_42023":130571,"_42025":130574,"_42027":130577,"_42029":130580,"_42031":130583,"_42033":130586,"_31347":130589,"_42037":130592,"_42039":130595},{"_3706":73249,"_31461":73249,"_5":15367,"_3094":121261,"_31820":121262,"_21806":121265,"_28616":73249},"Despliega desde AWS Marketplace",[51344,121263,121264],"Despliegue","Otros modelos",[],{"_3706":73250,"_31461":73249,"_21806":121267,"_5":15007,"_28616":73249,"_3094":121268},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3706":73251,"_31461":73249,"_5":31817,"_21806":121270,"_28616":121271,"_3094":121272},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3706":73252,"_31461":73249,"_5":31817,"_21806":121274,"_28616":121275,"_3094":121276},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3706":73253,"_31461":73249,"_5":31817,"_21806":121278,"_28616":121279,"_3094":121280},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3706":73254,"_31461":73249,"_5":31817,"_21806":121282,"_28616":121283,"_3094":121284},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3706":73255,"_31461":73249,"_5":31817,"_21806":121286,"_28616":121287,"_3094":121288},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3706":73256,"_31461":73249,"_5":31817,"_21806":121290,"_28616":121291,"_3094":121292},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3706":73257,"_31461":73249,"_5":31817,"_21806":121294,"_28616":121295,"_3094":121296},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3706":73258,"_31461":73249,"_21806":121298,"_5":15007,"_28616":73249,"_3094":121299},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3706":73259,"_31461":73249,"_21806":121301,"_5":15007,"_28616":121271,"_3094":121302},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3706":73260,"_31461":73249,"_21806":121304,"_5":15007,"_28616":121271,"_3094":121305},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3706":73261,"_31461":73249,"_21806":121307,"_5":15007,"_28616":121271,"_3094":121308},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3706":73262,"_31461":73249,"_21806":121310,"_5":15007,"_28616":121275,"_3094":121311},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3706":73263,"_31461":73249,"_21806":121313,"_5":15007,"_28616":121275,"_3094":121314},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3706":73264,"_31461":73249,"_21806":121316,"_5":15007,"_28616":121275,"_3094":121317},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3706":73265,"_31461":73249,"_21806":121319,"_5":15007,"_28616":121279,"_3094":121320},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3706":73266,"_31461":73249,"_21806":121322,"_5":15007,"_28616":121283,"_3094":121323},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3706":73267,"_31461":73249,"_21806":121325,"_5":15007,"_28616":121287,"_3094":121326},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3706":73268,"_31461":73249,"_21806":121328,"_5":15007,"_28616":121291,"_3094":121329},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3706":73269,"_31461":73249,"_21806":121331,"_5":15007,"_28616":121295,"_3094":121332},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3706":73270,"_31461":73270,"_5":15367,"_3094":121334,"_31820":121335,"_21806":121336,"_28616":73270},"Despliega Lamassu",[51344,121263],[],{"_3706":73271,"_31461":73270,"_21806":121338,"_5":15007,"_28616":73270,"_3094":121339},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3706":73272,"_31461":73270,"_5":31817,"_21806":121341,"_28616":121342,"_3094":121343},[],"/docs/pr-preview/pr-81/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3706":73273,"_31461":73270,"_5":31817,"_21806":121345,"_28616":121346,"_3094":121347},[],"/docs/pr-preview/pr-81/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3706":73274,"_31461":73270,"_5":31817,"_21806":121349,"_28616":121350,"_3094":121351},[],"/docs/pr-preview/pr-81/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3706":73275,"_31461":73270,"_21806":121353,"_5":15007,"_28616":73270,"_3094":121354},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3706":73276,"_31461":73270,"_21806":121356,"_5":15007,"_28616":121342,"_3094":121357},[],"Modelo",{"_3706":73277,"_31461":73270,"_21806":121359,"_5":15007,"_28616":121342,"_3094":121360},[],"Recomendado para",{"_3706":73278,"_31461":73270,"_21806":121362,"_5":15007,"_28616":121342,"_3094":121363},[],"Quién opera la infraestructura",{"_3706":73279,"_31461":73270,"_21806":121365,"_5":15007,"_28616":121342,"_3094":121366},[],"Punto de partida",{"_3706":73280,"_31461":73270,"_21806":121368,"_5":15007,"_28616":121342,"_3094":51451},[],{"_3706":73281,"_31461":73270,"_21806":121370,"_5":15007,"_28616":121342,"_3094":121371},[],"Producción, entornos regulados y despliegues personalizados",{"_3706":73282,"_31461":73270,"_21806":121373,"_5":15007,"_28616":121342,"_3094":121374},[],"Tu equipo",{"_3706":73283,"_31461":73270,"_21806":121376,"_5":15007,"_28616":121342,"_3094":121377},[],"Helm o Fastlane",{"_3706":73284,"_31461":73270,"_21806":121379,"_5":15007,"_28616":121342,"_3094":51463},[],{"_3706":73285,"_31461":73270,"_21806":121381,"_5":15007,"_28616":121342,"_3094":121382},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3706":73286,"_31461":73270,"_21806":121384,"_5":15007,"_28616":121342,"_3094":121374},[],{"_3706":73287,"_31461":73270,"_21806":121386,"_5":15007,"_28616":121342,"_3094":121387},[],"Imagen preconfigurada en EC2",{"_3706":73288,"_31461":73270,"_21806":121389,"_5":15007,"_28616":121342,"_3094":51474},[],{"_3706":73289,"_31461":73270,"_21806":121391,"_5":15007,"_28616":121342,"_3094":121392},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3706":73290,"_31461":73270,"_21806":121394,"_5":15007,"_28616":121342,"_3094":51480},[],{"_3706":73291,"_31461":73270,"_21806":121396,"_5":15007,"_28616":121342,"_3094":121397},[],"Suscripción gestionada",{"_3706":73292,"_31461":73270,"_21806":121399,"_5":15007,"_28616":121342,"_3094":121400},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3706":73293,"_31461":73270,"_21806":121402,"_5":15007,"_28616":121342,"_3094":121403},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3706":73294,"_31461":73270,"_21806":121405,"_5":15007,"_28616":121342,"_3094":121406},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3706":73295,"_31461":73270,"_21806":121408,"_5":15007,"_28616":121346,"_3094":121409},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3706":73296,"_31461":73270,"_21806":121411,"_5":15007,"_28616":121350,"_3094":121412},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3706":73297,"_31461":73297,"_5":15367,"_3094":121414,"_31820":121415,"_21806":121416,"_28616":73297},"Utiliza Lamassu como SaaS",[51344,121263,121264],[],{"_3706":73298,"_31461":73297,"_21806":121418,"_5":15007,"_28616":73297,"_3094":121419},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3706":73299,"_31461":73297,"_5":31817,"_21806":121421,"_28616":121422,"_3094":121423},[],"/docs/pr-preview/pr-81/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3706":73300,"_31461":73297,"_5":31817,"_21806":121425,"_28616":121426,"_3094":121427},[],"/docs/pr-preview/pr-81/es/deployment/saas#planes","Planes",{"_3706":73301,"_31461":73297,"_5":31817,"_21806":121429,"_28616":121430,"_3094":121431},[],"/docs/pr-preview/pr-81/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3706":73302,"_31461":73297,"_21806":121433,"_5":15007,"_28616":73297,"_3094":121434},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3706":73303,"_31461":73297,"_21806":121436,"_5":15007,"_28616":121422,"_3094":121437},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3706":73304,"_31461":73297,"_21806":121439,"_5":15007,"_28616":121422,"_3094":121440},[],"Copias de seguridad automáticas.",{"_3706":73305,"_31461":73297,"_21806":121442,"_5":15007,"_28616":121422,"_3094":121443},[],"Actualizaciones de versión.",{"_3706":73306,"_31461":73297,"_21806":121445,"_5":15007,"_28616":121422,"_3094":121446},[],"Soporte técnico y SLA según el plan contratado.",{"_3706":73307,"_31461":73297,"_21806":121448,"_5":15007,"_28616":121426,"_3094":51535},[],{"_3706":73308,"_31461":73297,"_21806":121450,"_5":15007,"_28616":121426,"_3094":121451},[],"Dispositivos",{"_3706":73309,"_31461":73297,"_21806":121453,"_5":15007,"_28616":121426,"_3094":121454},[],"Soporte",{"_3706":73310,"_31461":73297,"_21806":121456,"_5":15007,"_28616":121426,"_3094":51544},[],{"_3706":73311,"_31461":73297,"_21806":121458,"_5":15007,"_28616":121426,"_3094":51547},[],{"_3706":73312,"_31461":73297,"_21806":121460,"_5":15007,"_28616":121426,"_3094":121461},[],"Hasta 1.000",{"_3706":73313,"_31461":73297,"_21806":121463,"_5":15007,"_28616":121426,"_3094":51553},[],{"_3706":73314,"_31461":73297,"_21806":121465,"_5":15007,"_28616":121426,"_3094":121466},[],"99,5 %",{"_3706":73315,"_31461":73297,"_21806":121468,"_5":15007,"_28616":121426,"_3094":51559},[],{"_3706":73316,"_31461":73297,"_21806":121470,"_5":15007,"_28616":121426,"_3094":121471},[],"Hasta 10.000",{"_3706":73317,"_31461":73297,"_21806":121473,"_5":15007,"_28616":121426,"_3094":121474},[],"Email y chat",{"_3706":73318,"_31461":73297,"_21806":121476,"_5":15007,"_28616":121426,"_3094":121477},[],"99,9 %",{"_3706":73319,"_31461":73297,"_21806":121479,"_5":15007,"_28616":121426,"_3094":51571},[],{"_3706":73320,"_31461":73297,"_21806":121481,"_5":15007,"_28616":121426,"_3094":121482},[],"Ilimitados",{"_3706":73321,"_31461":73297,"_21806":121484,"_5":15007,"_28616":121426,"_3094":121485},[],"Dedicado",{"_3706":73322,"_31461":73297,"_21806":121487,"_5":15007,"_28616":121426,"_3094":121488},[],"99,99 %",{"_3706":73323,"_31461":73297,"_21806":121490,"_5":15007,"_28616":121430,"_3094":121491},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3706":73324,"_31461":73297,"_21806":121493,"_5":15007,"_28616":121430,"_3094":121494},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3706":73325,"_31461":73325,"_5":15367,"_3094":51588,"_31820":121496,"_21806":121498,"_28616":73325},[51344,121263,121497],"Kubernetes autogestionado",[],{"_3706":73326,"_31461":73325,"_21806":121500,"_5":15007,"_28616":73325,"_3094":121501},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3706":73327,"_31461":73325,"_5":31817,"_21806":121503,"_28616":121504,"_3094":121505},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3706":73328,"_31461":73325,"_5":31817,"_21806":121507,"_28616":121508,"_3094":121509},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3706":73329,"_31461":73325,"_5":31817,"_21806":121511,"_28616":121512,"_3094":121513},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3706":73330,"_31461":73325,"_5":31817,"_21806":121515,"_28616":121516,"_3094":121517},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3706":73331,"_31461":73325,"_5":31817,"_21806":121519,"_28616":121520,"_3094":121521},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3706":73332,"_31461":73325,"_5":31817,"_21806":121523,"_28616":121524,"_3094":121525},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3706":73333,"_31461":73325,"_5":31817,"_21806":121527,"_28616":121528,"_3094":121529},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3706":73334,"_31461":73325,"_5":31817,"_21806":121531,"_28616":121532,"_3094":121533},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3706":73335,"_31461":73325,"_5":31817,"_21806":121535,"_28616":121536,"_3094":121537},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3706":73336,"_31461":73325,"_5":31817,"_21806":121539,"_28616":121540,"_3094":121541},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3706":73337,"_31461":73325,"_5":31817,"_21806":121543,"_28616":121544,"_3094":121545},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3706":73338,"_31461":73325,"_21806":121547,"_5":15007,"_28616":121504,"_3094":121548},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3706":73339,"_31461":73325,"_21806":121550,"_5":15007,"_28616":121504,"_3094":121551},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3706":73340,"_31461":73325,"_21806":121553,"_5":15007,"_28616":121508,"_3094":121554},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3706":73341,"_31461":73325,"_21806":121556,"_5":15007,"_28616":121508,"_3094":121557},[],"Fastlane instala o configura",{"_3706":73342,"_31461":73325,"_21806":121559,"_5":15007,"_28616":121508,"_3094":121560},[],"Tú sigues proporcionando",{"_3706":73343,"_31461":73325,"_21806":121562,"_5":15007,"_28616":121508,"_3094":121563},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3706":73344,"_31461":73325,"_21806":121565,"_5":15007,"_28616":121508,"_3094":121566},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3706":73345,"_31461":73325,"_21806":121568,"_5":15007,"_28616":121508,"_3094":121569},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3706":73346,"_31461":73325,"_21806":121571,"_5":15007,"_28616":121508,"_3094":121572},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3706":73347,"_31461":73325,"_21806":121574,"_5":15007,"_28616":121508,"_3094":121575},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3706":73348,"_31461":73325,"_21806":121577,"_5":15007,"_28616":121508,"_3094":121578},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3706":73349,"_31461":73325,"_21806":121580,"_5":15007,"_28616":121508,"_3094":121581},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3706":73350,"_31461":73325,"_21806":121583,"_5":15007,"_28616":121508,"_3094":121584},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3706":73351,"_31461":73325,"_21806":121586,"_5":15007,"_28616":121508,"_3094":121587},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3706":73352,"_31461":73325,"_21806":121589,"_5":15007,"_28616":121512,"_3094":121590},[],"Necesitas:",{"_3706":73353,"_31461":73325,"_21806":121592,"_5":15007,"_28616":121512,"_3094":121593},[],"un clúster Kubernetes existente",{"_3706":73354,"_31461":73325,"_21806":121595,"_5":15007,"_28616":121512,"_3094":121596},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3706":73355,"_31461":73325,"_21806":121598,"_5":15007,"_28616":121512,"_3094":51690},[],{"_3706":73356,"_31461":73325,"_21806":121600,"_5":15007,"_28616":121512,"_3094":24613},[],{"_3706":73357,"_31461":73325,"_21806":121602,"_5":15007,"_28616":121512,"_3094":121603},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3706":73358,"_31461":73325,"_21806":121605,"_5":15007,"_28616":121512,"_3094":121606},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3706":73359,"_31461":73325,"_21806":121608,"_5":15007,"_28616":121512,"_3094":121609},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3706":73360,"_31461":73325,"_21806":121611,"_5":15007,"_28616":121512,"_3094":121612},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3706":73361,"_31461":73325,"_21806":121614,"_5":15007,"_28616":121512,"_3094":121615},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3706":73362,"_31461":73325,"_21806":121617,"_5":15007,"_28616":121516,"_3094":121618},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3706":73363,"_31461":73325,"_21806":121620,"_5":15007,"_28616":121516,"_3094":121621},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3706":73364,"_31461":73325,"_21806":121623,"_5":15007,"_28616":121520,"_3094":121624},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3706":73365,"_31461":73325,"_21806":121626,"_5":15007,"_28616":121520,"_3094":121627},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3706":73366,"_31461":73325,"_21806":121629,"_5":15007,"_28616":121520,"_3094":121630},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3706":73367,"_31461":73325,"_21806":121632,"_5":15007,"_28616":121520,"_3094":121633},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3706":73368,"_31461":73325,"_21806":121635,"_5":15007,"_28616":121524,"_3094":121636},[],"Opción",{"_3706":73369,"_31461":73325,"_21806":121638,"_5":15007,"_28616":121524,"_3094":121639},[],"Valor predeterminado",{"_3706":73370,"_31461":73325,"_21806":121641,"_5":15007,"_28616":121524,"_3094":121642},[],"Propósito",{"_3706":73371,"_31461":73325,"_21806":121644,"_5":15007,"_28616":121524,"_3094":51737},[],{"_3706":73372,"_31461":73325,"_21806":121646,"_5":15007,"_28616":121524,"_3094":51740},[],{"_3706":73373,"_31461":73325,"_21806":121648,"_5":15007,"_28616":121524,"_3094":121649},[],"Muestra la ayuda",{"_3706":73374,"_31461":73325,"_21806":121651,"_5":15007,"_28616":121524,"_3094":51746},[],{"_3706":73375,"_31461":73325,"_21806":121653,"_5":15007,"_28616":121524,"_3094":121654},[],"contexto actual",{"_3706":73376,"_31461":73325,"_21806":121656,"_5":15007,"_28616":121524,"_3094":121657},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3706":73377,"_31461":73325,"_21806":121659,"_5":15007,"_28616":121524,"_3094":51755},[],{"_3706":73378,"_31461":73325,"_21806":121661,"_5":15007,"_28616":121524,"_3094":6849},[],{"_3706":73379,"_31461":73325,"_21806":121663,"_5":15007,"_28616":121524,"_3094":121664},[],"Omite prompts y genera credenciales para las dependencias",{"_3706":73380,"_31461":73325,"_21806":121666,"_5":15007,"_28616":121524,"_3094":51763},[],{"_3706":73381,"_31461":73325,"_21806":121668,"_5":15007,"_28616":121524,"_3094":51766},[],{"_3706":73382,"_31461":73325,"_21806":121670,"_5":15007,"_28616":121524,"_3094":121671},[],"Namespace de la instalación",{"_3706":73383,"_31461":73325,"_21806":121673,"_5":15007,"_28616":121524,"_3094":51772},[],{"_3706":73384,"_31461":73325,"_21806":121675,"_5":15007,"_28616":121524,"_3094":51775},[],{"_3706":73385,"_31461":73325,"_21806":121677,"_5":15007,"_28616":121524,"_3094":121678},[],"Dominio usado por la UI, OIDC y el certificado",{"_3706":73386,"_31461":73325,"_21806":121680,"_5":15007,"_28616":121524,"_3094":51781},[],{"_3706":73387,"_31461":73325,"_21806":121682,"_5":15007,"_28616":121524,"_3094":15719},[],{"_3706":73388,"_31461":73325,"_21806":121684,"_5":15007,"_28616":121524,"_3094":121685},[],"Versión del chart de Lamassu",{"_3706":73389,"_31461":73325,"_21806":121687,"_5":15007,"_28616":121524,"_3094":51789},[],{"_3706":73390,"_31461":73325,"_21806":121689,"_5":15007,"_28616":121524,"_3094":51792},[],{"_3706":73391,"_31461":73325,"_21806":121691,"_5":15007,"_28616":121524,"_3094":121692},[],"Puerto del listener HTTPS",{"_3706":73392,"_31461":73325,"_21806":121694,"_5":15007,"_28616":121524,"_3094":51798},[],{"_3706":73393,"_31461":73325,"_21806":121696,"_5":15007,"_28616":121524,"_3094":51801},[],{"_3706":73394,"_31461":73325,"_21806":121698,"_5":15007,"_28616":121524,"_3094":121699},[],"Puerto del listener HTTP",{"_3706":73395,"_31461":73325,"_21806":121701,"_5":15007,"_28616":121524,"_3094":51807},[],{"_3706":73396,"_31461":73325,"_21806":121703,"_5":15007,"_28616":121524,"_3094":51740},[],{"_3706":73397,"_31461":73325,"_21806":121705,"_5":15007,"_28616":121524,"_3094":121706},[],"Certificado PEM para TLS downstream",{"_3706":73398,"_31461":73325,"_21806":121708,"_5":15007,"_28616":121524,"_3094":51815},[],{"_3706":73399,"_31461":73325,"_21806":121710,"_5":15007,"_28616":121524,"_3094":51740},[],{"_3706":73400,"_31461":73325,"_21806":121712,"_5":15007,"_28616":121524,"_3094":121713},[],"Clave privada PEM para TLS downstream",{"_3706":73401,"_31461":73325,"_21806":121715,"_5":15007,"_28616":121524,"_3094":51823},[],{"_3706":73402,"_31461":73325,"_21806":121717,"_5":15007,"_28616":121524,"_3094":121718},[],"chart del repositorio",{"_3706":73403,"_31461":73325,"_21806":121720,"_5":15007,"_28616":121524,"_3094":121721},[],"Usa un chart local de Lamassu sin empaquetar",{"_3706":73404,"_31461":73325,"_21806":121723,"_5":15007,"_28616":121524,"_3094":51832},[],{"_3706":73405,"_31461":73325,"_21806":121725,"_5":15007,"_28616":121524,"_3094":121726},[],"detección automática",{"_3706":73406,"_31461":73325,"_21806":121728,"_5":15007,"_28616":121524,"_3094":121729},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3706":73407,"_31461":73325,"_21806":121731,"_5":15007,"_28616":121524,"_3094":51840},[],{"_3706":73408,"_31461":73325,"_21806":121733,"_5":15007,"_28616":121524,"_3094":6849},[],{"_3706":73409,"_31461":73325,"_21806":121735,"_5":15007,"_28616":121524,"_3094":121736},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3706":73410,"_31461":73325,"_21806":121738,"_5":15007,"_28616":121524,"_3094":51848},[],{"_3706":73411,"_31461":73325,"_21806":121740,"_5":15007,"_28616":121524,"_3094":6849},[],{"_3706":73412,"_31461":73325,"_21806":121742,"_5":15007,"_28616":121524,"_3094":121743},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3706":73413,"_31461":73325,"_21806":121745,"_5":15007,"_28616":121524,"_3094":51856},[],{"_3706":73414,"_31461":73325,"_21806":121747,"_5":15007,"_28616":121524,"_3094":6849},[],{"_3706":73415,"_31461":73325,"_21806":121749,"_5":15007,"_28616":121524,"_3094":121750},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3706":73416,"_31461":73325,"_21806":121752,"_5":15007,"_28616":121524,"_3094":51864},[],{"_3706":73417,"_31461":73325,"_21806":121754,"_5":15007,"_28616":121524,"_3094":6849},[],{"_3706":73418,"_31461":73325,"_21806":121756,"_5":15007,"_28616":121524,"_3094":121757},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3706":73419,"_31461":73325,"_21806":121759,"_5":15007,"_28616":121524,"_3094":51872},[],{"_3706":73420,"_31461":73325,"_21806":121761,"_5":15007,"_28616":121524,"_3094":51875},[],{"_3706":73421,"_31461":73325,"_21806":121763,"_5":15007,"_28616":121524,"_3094":121764},[],"Usa otro chart local de SoftHSM",{"_3706":73422,"_31461":73325,"_21806":121766,"_5":15007,"_28616":121524,"_3094":121767},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3706":73423,"_31461":73325,"_21806":121769,"_5":15007,"_28616":121528,"_3094":121770},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3706":73424,"_31461":73325,"_21806":121772,"_5":15007,"_28616":121528,"_3094":121773},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3706":73425,"_31461":73325,"_21806":121775,"_5":15007,"_28616":121528,"_3094":121776},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3706":73426,"_31461":73325,"_21806":121778,"_5":15007,"_28616":121528,"_3094":121779},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3706":73427,"_31461":73325,"_21806":121781,"_5":15007,"_28616":121528,"_3094":121782},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3706":73428,"_31461":73325,"_21806":121784,"_5":15007,"_28616":121528,"_3094":121785},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3706":73429,"_31461":73325,"_21806":121787,"_5":15007,"_28616":121532,"_3094":51902},[],{"_3706":73430,"_31461":73325,"_21806":121789,"_5":15007,"_28616":121532,"_3094":121790},[],"valida las herramientas locales y el clúster seleccionado",{"_3706":73431,"_31461":73325,"_21806":121792,"_5":15007,"_28616":121532,"_3094":121793},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3706":73432,"_31461":73325,"_21806":121795,"_5":15007,"_28616":121532,"_3094":121796},[],"crea el namespace",{"_3706":73433,"_31461":73325,"_21806":121798,"_5":15007,"_28616":121532,"_3094":121799},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3706":73434,"_31461":73325,"_21806":121801,"_5":15007,"_28616":121532,"_3094":121802},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3706":73435,"_31461":73325,"_21806":121804,"_5":15007,"_28616":121532,"_3094":121805},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3706":73436,"_31461":73325,"_21806":121807,"_5":15007,"_28616":121532,"_3094":121808},[],"instala RabbitMQ",{"_3706":73437,"_31461":73325,"_21806":121810,"_5":15007,"_28616":121532,"_3094":121811},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3706":73438,"_31461":73325,"_21806":121813,"_5":15007,"_28616":121532,"_3094":121814},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3706":73439,"_31461":73325,"_21806":121816,"_5":15007,"_28616":121532,"_3094":121817},[],"carga datos de ejemplo opcionalmente",{"_3706":73440,"_31461":73325,"_21806":121819,"_5":15007,"_28616":121532,"_3094":121820},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3706":73441,"_31461":73325,"_21806":121822,"_5":15007,"_28616":121536,"_3094":121823},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3706":73442,"_31461":73325,"_21806":121825,"_5":15007,"_28616":121536,"_3094":121826},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3706":73443,"_31461":73325,"_21806":121828,"_5":15007,"_28616":121540,"_3094":121829},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3706":73444,"_31461":73325,"_21806":121831,"_5":15007,"_28616":121540,"_3094":121832},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3706":73445,"_31461":73325,"_21806":121834,"_5":15007,"_28616":121540,"_3094":121835},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3706":73446,"_31461":73325,"_21806":121837,"_5":15007,"_28616":121540,"_3094":121838},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3706":73447,"_31461":73325,"_21806":121840,"_5":15007,"_28616":121544,"_3094":121841},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3706":73448,"_31461":73448,"_5":15367,"_3094":121843,"_31820":121844,"_21806":121845,"_28616":73448},"Instala con Helm",[51344,121263,121497],[],{"_3706":73449,"_31461":73448,"_21806":121847,"_5":15007,"_28616":73448,"_3094":121848},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3706":73450,"_31461":73448,"_5":31817,"_21806":121850,"_28616":121851,"_3094":121852},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3706":73451,"_31461":73448,"_5":31817,"_21806":121854,"_28616":121855,"_3094":121513},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3706":73452,"_31461":73448,"_5":31817,"_21806":121857,"_28616":121858,"_3094":121859},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3706":73453,"_31461":73448,"_5":31817,"_21806":121861,"_28616":121862,"_3094":121863},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3706":73454,"_31461":73448,"_5":31817,"_21806":121865,"_28616":121866,"_3094":121867},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3706":73455,"_31461":73448,"_5":31817,"_21806":121869,"_28616":121870,"_3094":121871},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3706":73456,"_31461":73448,"_5":31817,"_21806":121873,"_28616":121874,"_3094":121875},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3706":73457,"_31461":73448,"_5":31817,"_21806":121877,"_28616":121878,"_3094":121879},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#flujo-de-eventos-de-dispositivo-sse","Flujo de eventos de dispositivo (SSE)",{"_3706":73458,"_31461":73448,"_5":31817,"_21806":121881,"_28616":121882,"_3094":121883},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3706":73459,"_31461":73448,"_5":31817,"_21806":121885,"_28616":121886,"_3094":121887},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3706":73460,"_31461":73448,"_5":31817,"_21806":121889,"_28616":121890,"_3094":121891},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3706":73461,"_31461":73448,"_5":31817,"_21806":121893,"_28616":121894,"_3094":121895},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3706":73462,"_31461":73448,"_5":31817,"_21806":121897,"_28616":121898,"_3094":121899},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3706":73463,"_31461":73448,"_5":31817,"_21806":121901,"_28616":121902,"_3094":121903},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3706":73464,"_31461":73448,"_21806":121905,"_5":15007,"_28616":121851,"_3094":121906},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3706":73465,"_31461":73448,"_21806":121908,"_5":15007,"_28616":121855,"_3094":121909},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3706":73466,"_31461":73448,"_21806":121911,"_5":15007,"_28616":121855,"_3094":121912},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3706":73467,"_31461":73448,"_21806":121914,"_5":15007,"_28616":121855,"_3094":121915},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3706":73468,"_31461":73448,"_21806":121917,"_5":15007,"_28616":121855,"_3094":121918},[],"un broker RabbitMQ accesible y sus credenciales",{"_3706":73469,"_31461":73448,"_21806":121920,"_5":15007,"_28616":121855,"_3094":121921},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3706":73470,"_31461":73448,"_21806":121923,"_5":15007,"_28616":121855,"_3094":121924},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3706":73471,"_31461":73448,"_21806":121926,"_5":15007,"_28616":121855,"_3094":121927},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3706":73472,"_31461":73448,"_21806":121929,"_5":15007,"_28616":121855,"_3094":121930},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3706":73473,"_31461":73448,"_21806":121932,"_5":15007,"_28616":121855,"_3094":121933},[],"una StorageClass y un diseño de tráfico externo",{"_3706":73474,"_31461":73448,"_21806":121935,"_5":15007,"_28616":121855,"_3094":121936},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3706":73475,"_31461":73448,"_21806":121938,"_5":15007,"_28616":121855,"_3094":121939},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3706":73476,"_31461":73448,"_21806":121941,"_5":15007,"_28616":121855,"_3094":121942},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3706":73477,"_31461":73448,"_21806":121944,"_5":15007,"_28616":121858,"_3094":121945},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3706":73478,"_31461":73448,"_21806":121947,"_5":15007,"_28616":121858,"_3094":121948},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3706":73479,"_31461":73448,"_21806":121950,"_5":15007,"_28616":121858,"_3094":121951},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3706":73480,"_31461":73448,"_21806":121953,"_5":15007,"_28616":121862,"_3094":121954},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3706":73481,"_31461":73448,"_21806":121956,"_5":15007,"_28616":121862,"_3094":121957},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3706":73482,"_31461":73448,"_21806":121959,"_5":15007,"_28616":121862,"_3094":121960},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3706":73483,"_31461":73448,"_21806":121962,"_5":15007,"_28616":121862,"_3094":121963},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3706":73484,"_31461":73448,"_21806":121965,"_5":15007,"_28616":121866,"_3094":121966},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3706":73485,"_31461":73448,"_21806":121968,"_5":15007,"_28616":121866,"_3094":121969},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3706":73486,"_31461":73448,"_21806":121971,"_5":15007,"_28616":121866,"_3094":121972},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3706":73487,"_31461":73448,"_21806":121974,"_5":15007,"_28616":121866,"_3094":121975},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3706":73488,"_31461":73448,"_21806":121977,"_5":15007,"_28616":121866,"_3094":121978},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3706":73489,"_31461":73448,"_21806":121980,"_5":15007,"_28616":121866,"_3094":121981},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3706":73490,"_31461":73448,"_21806":121983,"_5":15007,"_28616":121866,"_3094":121984},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3706":73491,"_31461":73448,"_21806":121986,"_5":15007,"_28616":121866,"_3094":121987},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3706":73492,"_31461":73448,"_21806":121989,"_5":15007,"_28616":121870,"_3094":121990},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3706":73493,"_31461":73448,"_21806":121992,"_5":15007,"_28616":121874,"_3094":121993},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3706":73494,"_31461":73448,"_21806":121995,"_5":15007,"_28616":121874,"_3094":121996},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3706":73495,"_31461":73448,"_21806":121998,"_5":15007,"_28616":121874,"_3094":121999},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3706":73496,"_31461":73448,"_21806":122001,"_5":15007,"_28616":121874,"_3094":122002},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3706":73497,"_31461":73448,"_21806":122004,"_5":15007,"_28616":121874,"_3094":122005},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3706":73498,"_31461":73448,"_21806":122007,"_5":15007,"_28616":121874,"_3094":122008},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3706":73499,"_31461":73448,"_21806":122010,"_5":15007,"_28616":121874,"_3094":122011},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3706":73500,"_31461":73448,"_21806":122013,"_5":15007,"_28616":121878,"_3094":122014},[],"`services.deviceManager.sseEnabled` (por defecto `true`) controla si Device Manager sirve su flujo de eventos de dispositivo mediante Server-Sent Events (SSE). Con el valor por defecto, el chart renderiza una regla de gateway dedicada para el endpoint de eventos de dispositivo con un timeout de petición de 11 minutos, porque el timeout de petición por defecto del Gateway es demasiado corto para estos flujos, que el servicio mantiene abiertos hasta unos diez minutos. Las llamadas a Device Manager que no son peticiones SSE conservan el timeout por defecto del Gateway.",{"_3706":73501,"_31461":73448,"_21806":122016,"_5":15007,"_28616":121878,"_3094":122017},[],"Defínelo como `false` para deshabilitar el flujo: el chart renderiza entonces `sse_enabled: false` en la configuración de Device Manager y omite la regla de gateway, y las peticiones SSE al endpoint de eventos de dispositivo fallan. Consulta Eventos de dispositivo en la guía de actualización de 3.8.0 a 4.0.0.",{"_3706":73502,"_31461":73448,"_21806":122019,"_5":15007,"_28616":121882,"_3094":122020},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3706":73503,"_31461":73448,"_21806":122022,"_5":15007,"_28616":121882,"_3094":122023},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3706":73504,"_31461":73448,"_21806":122025,"_5":15007,"_28616":121882,"_3094":122026},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3706":73505,"_31461":73448,"_21806":122028,"_5":15007,"_28616":121882,"_3094":122029},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3706":73506,"_31461":73448,"_21806":122031,"_5":15007,"_28616":121886,"_3094":122032},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3706":73507,"_31461":73448,"_21806":122034,"_5":15007,"_28616":121886,"_3094":122035},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3706":73508,"_31461":73448,"_21806":122037,"_5":15007,"_28616":121886,"_3094":122038},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3706":73509,"_31461":73448,"_21806":122040,"_5":15007,"_28616":121886,"_3094":122041},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3706":73510,"_31461":73448,"_21806":122043,"_5":15007,"_28616":121890,"_3094":122044},[],"Para instalar un checkout local:",{"_3706":73511,"_31461":73448,"_21806":122046,"_5":15007,"_28616":121894,"_3094":122047},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3706":73512,"_31461":73448,"_21806":122049,"_5":15007,"_28616":121894,"_3094":122050},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3706":73513,"_31461":73448,"_21806":122052,"_5":15007,"_28616":121898,"_3094":122053},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3706":73514,"_31461":73448,"_21806":122055,"_5":15007,"_28616":121898,"_3094":122056},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3706":73515,"_31461":73448,"_21806":122058,"_5":15007,"_28616":121898,"_3094":122059},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3706":73516,"_31461":73448,"_21806":122061,"_5":15007,"_28616":121898,"_3094":122062},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3706":73517,"_31461":73448,"_21806":122064,"_5":15007,"_28616":121898,"_3094":122065},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3706":73518,"_31461":73448,"_21806":122067,"_5":15007,"_28616":121902,"_3094":122068},[],"Antes de pasar a producción, revisa:",{"_3706":73519,"_31461":73448,"_21806":122070,"_5":15007,"_28616":121902,"_3094":122071},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3706":73520,"_31461":73448,"_21806":122073,"_5":15007,"_28616":121902,"_3094":122074},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3706":73521,"_31461":73448,"_21806":122076,"_5":15007,"_28616":121902,"_3094":122077},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3706":73522,"_31461":73448,"_21806":122079,"_5":15007,"_28616":121902,"_3094":122080},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3706":73523,"_31461":73448,"_21806":122082,"_5":15007,"_28616":121902,"_3094":122083},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3706":73524,"_31461":73448,"_21806":122085,"_5":15007,"_28616":121902,"_3094":122086},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3706":73525,"_31461":73448,"_21806":122088,"_5":15007,"_28616":121902,"_3094":122089},[],"SMTP, observabilidad y entrega de alertas",{"_3706":73526,"_31461":73448,"_21806":122091,"_5":15007,"_28616":121902,"_3094":122092},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3706":73527,"_31461":73448,"_21806":122094,"_5":15007,"_28616":121902,"_3094":122095},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3706":73528,"_31461":73528,"_5":15367,"_3094":122097,"_31820":122098,"_21806":122099,"_28616":73528},"Expón el Gateway",[51344,121263,121497],[],{"_3706":73529,"_31461":73528,"_21806":122101,"_5":15007,"_28616":73528,"_3094":122102},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3706":73530,"_31461":73528,"_5":31817,"_21806":122104,"_28616":122105,"_3094":122106},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3706":73531,"_31461":73528,"_5":31817,"_21806":122108,"_28616":122109,"_3094":122110},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3706":73532,"_31461":73528,"_5":31817,"_21806":122112,"_28616":122113,"_3094":122114},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3706":73533,"_31461":73528,"_5":31817,"_21806":122116,"_28616":122117,"_3094":52233},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#k3s",{"_3706":73534,"_31461":73528,"_5":31817,"_21806":122119,"_28616":122120,"_3094":122121},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3706":73535,"_31461":73528,"_5":31817,"_21806":122123,"_28616":122124,"_3094":122125},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3706":73536,"_31461":73528,"_5":31817,"_21806":122127,"_28616":122128,"_3094":122129},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3706":73537,"_31461":73528,"_5":31817,"_21806":122131,"_28616":122132,"_3094":122133},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3706":73538,"_31461":73528,"_5":31817,"_21806":122135,"_28616":122136,"_3094":122137},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3706":73539,"_31461":73528,"_5":31817,"_21806":122139,"_28616":122140,"_3094":122141},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3706":73540,"_31461":73528,"_5":31817,"_21806":122143,"_28616":122144,"_3094":122145},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3706":73541,"_31461":73528,"_21806":122147,"_5":15007,"_28616":122105,"_3094":122148},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3706":73542,"_31461":73528,"_21806":122150,"_5":15007,"_28616":122105,"_3094":122151},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3706":73543,"_31461":73528,"_21806":122153,"_5":15007,"_28616":122109,"_3094":122154},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3706":73544,"_31461":73528,"_21806":122156,"_5":15007,"_28616":122109,"_3094":122157},[],"Defínelo únicamente cuando:",{"_3706":73545,"_31461":73528,"_21806":122159,"_5":15007,"_28616":122109,"_3094":122160},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3706":73546,"_31461":73528,"_21806":122162,"_5":15007,"_28616":122109,"_3094":122163},[],"esa dirección está asignada a este Gateway",{"_3706":73547,"_31461":73528,"_21806":122165,"_5":15007,"_28616":122109,"_3094":122166},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3706":73548,"_31461":73528,"_21806":122168,"_5":15007,"_28616":122109,"_3094":122169},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3706":73549,"_31461":73528,"_21806":122171,"_5":15007,"_28616":122109,"_3094":122172},[],"No confundas estos valores:",{"_3706":73550,"_31461":73528,"_21806":122174,"_5":15007,"_28616":122109,"_3094":122175},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3706":73551,"_31461":73528,"_21806":122177,"_5":15007,"_28616":122109,"_3094":122178},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3706":73552,"_31461":73528,"_21806":122180,"_5":15007,"_28616":122109,"_3094":122181},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3706":73553,"_31461":73528,"_21806":122183,"_5":15007,"_28616":122113,"_3094":122184},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3706":73554,"_31461":73528,"_21806":122186,"_5":15007,"_28616":122113,"_3094":122187},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3706":73555,"_31461":73528,"_21806":122189,"_5":15007,"_28616":122117,"_3094":122190},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3706":73556,"_31461":73528,"_21806":122192,"_5":15007,"_28616":122117,"_3094":122193},[],"Para el diseño recomendado:",{"_3706":73557,"_31461":73528,"_21806":122195,"_5":15007,"_28616":122117,"_3094":122196},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3706":73558,"_31461":73528,"_21806":122198,"_5":15007,"_28616":122117,"_3094":122199},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3706":73559,"_31461":73528,"_21806":122201,"_5":15007,"_28616":122117,"_3094":122202},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3706":73560,"_31461":73528,"_21806":122204,"_5":15007,"_28616":122117,"_3094":122205},[],"Apunta DNS a la dirección accesible de la VM.",{"_3706":73561,"_31461":73528,"_21806":122207,"_5":15007,"_28616":122117,"_3094":122208},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3706":73562,"_31461":73528,"_21806":122210,"_5":15007,"_28616":122120,"_3094":122211},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3706":73563,"_31461":73528,"_21806":122213,"_5":15007,"_28616":122124,"_3094":122214},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3706":73564,"_31461":73528,"_21806":122216,"_5":15007,"_28616":122124,"_3094":122217},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3706":73565,"_31461":73528,"_21806":122219,"_5":15007,"_28616":122128,"_3094":122220},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3706":73566,"_31461":73528,"_21806":122222,"_5":15007,"_28616":122128,"_3094":122223},[],"Requisito",{"_3706":73567,"_31461":73528,"_21806":122225,"_5":15007,"_28616":122128,"_3094":122226},[],"Diseño recomendado",{"_3706":73568,"_31461":73528,"_21806":122228,"_5":15007,"_28616":122128,"_3094":122229},[],"Consecuencia",{"_3706":73569,"_31461":73528,"_21806":122231,"_5":15007,"_28616":122128,"_3094":122232},[],"Varias URL o servicios de Lamassu",{"_3706":73570,"_31461":73528,"_21806":122234,"_5":15007,"_28616":122128,"_3094":122235},[],"Un Gateway con varias rutas",{"_3706":73571,"_31461":73528,"_21806":122237,"_5":15007,"_28616":122128,"_3094":122238},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3706":73572,"_31461":73528,"_21806":122240,"_5":15007,"_28616":122128,"_3094":122241},[],"Gateways independientes e IP externas distintas",{"_3706":73573,"_31461":73528,"_21806":122243,"_5":15007,"_28616":122128,"_3094":122244},[],"Una VIP por Gateway",{"_3706":73574,"_31461":73528,"_21806":122246,"_5":15007,"_28616":122128,"_3094":122247},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3706":73575,"_31461":73528,"_21806":122249,"_5":15007,"_28616":122128,"_3094":122250},[],"Gateways independientes, un nodo y una IP",{"_3706":73576,"_31461":73528,"_21806":122252,"_5":15007,"_28616":122128,"_3094":122253},[],"Puertos externos diferentes",{"_3706":73577,"_31461":73528,"_21806":122255,"_5":15007,"_28616":122128,"_3094":122256},[],"Los clientes deben indicar puertos no estándar",{"_3706":73578,"_31461":73528,"_21806":122258,"_5":15007,"_28616":122128,"_3094":122259},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3706":73579,"_31461":73528,"_21806":122261,"_5":15007,"_28616":122128,"_3094":122262},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3706":73580,"_31461":73528,"_21806":122264,"_5":15007,"_28616":122128,"_3094":122265},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3706":73581,"_31461":73528,"_21806":122267,"_5":15007,"_28616":122128,"_3094":122268},[],"Recursos Gateway separados pero proxy compartido",{"_3706":73582,"_31461":73528,"_21806":122270,"_5":15007,"_28616":122128,"_3094":122271},[],"Modo merged Gateway de Envoy",{"_3706":73583,"_31461":73528,"_21806":122273,"_5":15007,"_28616":122128,"_3094":122274},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3706":73584,"_31461":73528,"_21806":122276,"_5":15007,"_28616":122128,"_3094":122277},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3706":73585,"_31461":73528,"_21806":122279,"_5":15007,"_28616":122128,"_3094":122280},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3706":73586,"_31461":73528,"_21806":122282,"_5":15007,"_28616":122128,"_3094":122283},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3706":73587,"_31461":73528,"_21806":122285,"_5":15007,"_28616":122128,"_3094":122286},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3706":73588,"_31461":73528,"_21806":122288,"_5":15007,"_28616":122132,"_3094":122289},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3706":73589,"_31461":73528,"_21806":122291,"_5":15007,"_28616":122136,"_3094":122292},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3706":73590,"_31461":73528,"_21806":122294,"_5":15007,"_28616":122136,"_3094":122295},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3706":73591,"_31461":73528,"_21806":122297,"_5":15007,"_28616":122136,"_3094":122298},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3706":73592,"_31461":73528,"_21806":122300,"_5":15007,"_28616":122136,"_3094":122301},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3706":73593,"_31461":73528,"_21806":122303,"_5":15007,"_28616":122136,"_3094":122304},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3706":73594,"_31461":73528,"_21806":122306,"_5":15007,"_28616":122140,"_3094":122307},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3706":73595,"_31461":73528,"_21806":122309,"_5":15007,"_28616":122140,"_3094":122310},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3706":73596,"_31461":73528,"_21806":122312,"_5":15007,"_28616":122144,"_3094":122313},[],"Comprueba, en orden:",{"_3706":73597,"_31461":73528,"_21806":122315,"_5":15007,"_28616":122144,"_3094":122316},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3706":73598,"_31461":73528,"_21806":122318,"_5":15007,"_28616":122144,"_3094":122319},[],"Su estado contiene la dirección esperada.",{"_3706":73599,"_31461":73528,"_21806":122321,"_5":15007,"_28616":122144,"_3094":122322},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3706":73600,"_31461":73528,"_21806":122324,"_5":15007,"_28616":122144,"_3094":122325},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3706":73601,"_31461":73528,"_21806":122327,"_5":15007,"_28616":122144,"_3094":122328},[],"DNS resuelve al endpoint accesible externamente.",{"_3706":73602,"_31461":73528,"_21806":122330,"_5":15007,"_28616":122144,"_3094":122331},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3706":73603,"_31461":73528,"_21806":122333,"_5":15007,"_28616":122144,"_3094":122334},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3706":73604,"_31461":73604,"_5":15367,"_3094":51451,"_31820":122336,"_21806":122337,"_28616":73604},[51344,121263,121497],[],{"_3706":73605,"_31461":73604,"_21806":122339,"_5":15007,"_28616":73604,"_3094":122340},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3706":73606,"_31461":73604,"_5":31817,"_21806":122342,"_28616":122343,"_3094":122344},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3706":73607,"_31461":73604,"_5":31817,"_21806":122346,"_28616":122347,"_3094":122348},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3706":73608,"_31461":73604,"_5":31817,"_21806":122350,"_28616":122351,"_3094":122352},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3706":73609,"_31461":73604,"_5":31817,"_21806":122354,"_28616":122355,"_3094":122356},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3706":73610,"_31461":73604,"_5":31817,"_21806":122358,"_28616":122359,"_3094":122360},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3706":73611,"_31461":73604,"_5":31817,"_21806":122362,"_28616":122363,"_3094":122364},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3706":73612,"_31461":73604,"_21806":122366,"_5":15007,"_28616":122343,"_3094":122367},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3706":73613,"_31461":73604,"_21806":122369,"_5":15007,"_28616":122347,"_3094":122370},[],"Flujo",{"_3706":73614,"_31461":73604,"_21806":122372,"_5":15007,"_28616":122347,"_3094":122373},[],"Úsalo para",{"_3706":73615,"_31461":73604,"_21806":122375,"_5":15007,"_28616":122347,"_3094":122376},[],"Qué instala",{"_3706":73616,"_31461":73604,"_21806":122378,"_5":15007,"_28616":122347,"_3094":52495},[],{"_3706":73617,"_31461":73604,"_21806":122380,"_5":15007,"_28616":122347,"_3094":122381},[],"Producción y entornos controlados",{"_3706":73618,"_31461":73604,"_21806":122383,"_5":15007,"_28616":122347,"_3094":122384},[],"Servicios de Lamassu y recursos de Gateway API",{"_3706":73619,"_31461":73604,"_21806":122386,"_5":15007,"_28616":122347,"_3094":51588},[],{"_3706":73620,"_31461":73604,"_21806":122388,"_5":15007,"_28616":122347,"_3094":122389},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3706":73621,"_31461":73604,"_21806":122391,"_5":15007,"_28616":122347,"_3094":122392},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3706":73622,"_31461":73604,"_21806":122394,"_5":15007,"_28616":122351,"_3094":122395},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3706":73623,"_31461":73604,"_21806":122397,"_5":15007,"_28616":122351,"_3094":122398},[],"Área",{"_3706":73624,"_31461":73604,"_21806":122400,"_5":15007,"_28616":122351,"_3094":122401},[],"El chart de Lamassu proporciona",{"_3706":73625,"_31461":73604,"_21806":122403,"_5":15007,"_28616":122351,"_3094":122404},[],"Tú proporcionas",{"_3706":73626,"_31461":73604,"_21806":122406,"_5":15007,"_28616":122351,"_3094":122407},[],"Aplicaciones Lamassu",{"_3706":73627,"_31461":73604,"_21806":122409,"_5":15007,"_28616":122351,"_3094":122410},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3706":73628,"_31461":73604,"_21806":122412,"_5":15007,"_28616":122351,"_3094":122413},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3706":73629,"_31461":73604,"_21806":122415,"_5":15007,"_28616":122351,"_3094":122416},[],"Datos PostgreSQL",{"_3706":73630,"_31461":73604,"_21806":122418,"_5":15007,"_28616":122351,"_3094":122419},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3706":73631,"_31461":73604,"_21806":122421,"_5":15007,"_28616":122351,"_3094":122422},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3706":73632,"_31461":73604,"_21806":122424,"_5":15007,"_28616":122351,"_3094":122425},[],"Mensajería",{"_3706":73633,"_31461":73604,"_21806":122427,"_5":15007,"_28616":122351,"_3094":122428},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3706":73634,"_31461":73604,"_21806":122430,"_5":15007,"_28616":122351,"_3094":122431},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3706":73635,"_31461":73604,"_21806":122433,"_5":15007,"_28616":122351,"_3094":122434},[],"Identidad",{"_3706":73636,"_31461":73604,"_21806":122436,"_5":15007,"_28616":122351,"_3094":122437},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3706":73637,"_31461":73604,"_21806":122439,"_5":15007,"_28616":122351,"_3094":122440},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3706":73638,"_31461":73604,"_21806":122442,"_5":15007,"_28616":122351,"_3094":122443},[],"Enrutamiento externo",{"_3706":73639,"_31461":73604,"_21806":122445,"_5":15007,"_28616":122351,"_3094":122446},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3706":73640,"_31461":73604,"_21806":122448,"_5":15007,"_28616":122351,"_3094":122449},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3706":73641,"_31461":73604,"_21806":122451,"_5":15007,"_28616":122351,"_3094":52569},[],{"_3706":73642,"_31461":73604,"_21806":122453,"_5":15007,"_28616":122351,"_3094":122454},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3706":73643,"_31461":73604,"_21806":122456,"_5":15007,"_28616":122351,"_3094":122457},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3706":73644,"_31461":73604,"_21806":122459,"_5":15007,"_28616":122351,"_3094":122460},[],"Datos persistentes de la aplicación",{"_3706":73645,"_31461":73604,"_21806":122462,"_5":15007,"_28616":122351,"_3094":122463},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3706":73646,"_31461":73604,"_21806":122465,"_5":15007,"_28616":122351,"_3094":122466},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3706":73647,"_31461":73604,"_21806":122468,"_5":15007,"_28616":122351,"_3094":122469},[],"Integraciones opcionales",{"_3706":73648,"_31461":73604,"_21806":122471,"_5":15007,"_28616":122351,"_3094":122472},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3706":73649,"_31461":73604,"_21806":122474,"_5":15007,"_28616":122351,"_3094":122475},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3706":73650,"_31461":73604,"_21806":122477,"_5":15007,"_28616":122351,"_3094":122478},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3706":73651,"_31461":73604,"_21806":122480,"_5":15007,"_28616":122351,"_3094":122481},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3706":73652,"_31461":73604,"_21806":122483,"_5":15007,"_28616":122355,"_3094":122484},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3706":73653,"_31461":73604,"_21806":122486,"_5":15007,"_28616":122355,"_3094":122487},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3706":73654,"_31461":73604,"_21806":122489,"_5":15007,"_28616":122359,"_3094":122490},[],"Kubernetes 1.24 o posterior",{"_3706":73655,"_31461":73604,"_21806":122492,"_5":15007,"_28616":122359,"_3094":122493},[],"Helm 3.2 o posterior",{"_3706":73656,"_31461":73604,"_21806":122495,"_5":15007,"_28616":122359,"_3094":122496},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3706":73657,"_31461":73604,"_21806":122498,"_5":15007,"_28616":122359,"_3094":122499},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3706":73658,"_31461":73604,"_21806":122501,"_5":15007,"_28616":122359,"_3094":122502},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3706":73659,"_31461":73604,"_21806":122504,"_5":15007,"_28616":122359,"_3094":122505},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3706":73660,"_31461":73604,"_21806":122507,"_5":15007,"_28616":122359,"_3094":122508},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3706":73661,"_31461":73604,"_21806":122510,"_5":15007,"_28616":122363,"_3094":122511},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3706":73662,"_31461":73604,"_21806":122513,"_5":15007,"_28616":122363,"_3094":122514},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3706":73663,"_31461":73604,"_21806":122516,"_5":15007,"_28616":122363,"_3094":122517},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3706":73664,"_31461":73604,"_21806":122519,"_5":15007,"_28616":122363,"_3094":122520},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3706":73665,"_31461":73665,"_5":15367,"_3094":122522,"_31820":122523,"_21806":122525,"_28616":73665},"Resolución de problemas de despliegue",[51344,121263,122524],"Operación",[],{"_3706":73666,"_31461":73665,"_21806":122527,"_5":15007,"_28616":73665,"_3094":122528},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3706":73667,"_31461":73665,"_5":31817,"_21806":122530,"_28616":122531,"_3094":122532},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3706":73668,"_31461":73665,"_5":31817,"_21806":122534,"_28616":122535,"_3094":122536},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3706":73669,"_31461":73665,"_5":31817,"_21806":122538,"_28616":122539,"_3094":122540},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3706":73670,"_31461":73665,"_5":31817,"_21806":122542,"_28616":122543,"_3094":122544},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3706":73671,"_31461":73665,"_5":31817,"_21806":122546,"_28616":122547,"_3094":122548},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3706":73672,"_31461":73665,"_5":31817,"_21806":122550,"_28616":122551,"_3094":122552},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3706":73673,"_31461":73665,"_5":31817,"_21806":122554,"_28616":122555,"_3094":122556},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3706":73674,"_31461":73665,"_5":31817,"_21806":122558,"_28616":122559,"_3094":122560},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3706":73675,"_31461":73665,"_5":31817,"_21806":122562,"_28616":122563,"_3094":122564},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3706":73676,"_31461":73665,"_5":31817,"_21806":122566,"_28616":122567,"_3094":122568},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3706":73677,"_31461":73665,"_5":31817,"_21806":122570,"_28616":122571,"_3094":122572},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3706":73678,"_31461":73665,"_5":31817,"_21806":122574,"_28616":122575,"_3094":122576},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3706":73679,"_31461":73665,"_5":31817,"_21806":122578,"_28616":122579,"_3094":122580},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3706":73680,"_31461":73665,"_21806":122582,"_5":15007,"_28616":73665,"_3094":122583},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3706":73681,"_31461":73665,"_21806":122585,"_5":15007,"_28616":122535,"_3094":122586},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3706":73682,"_31461":73665,"_21806":122588,"_5":15007,"_28616":122539,"_3094":122589},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3706":73683,"_31461":73665,"_21806":122591,"_5":15007,"_28616":122543,"_3094":122592},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3706":73684,"_31461":73665,"_21806":122594,"_5":15007,"_28616":122547,"_3094":122595},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3706":73685,"_31461":73665,"_21806":122597,"_5":15007,"_28616":122551,"_3094":122598},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3706":73686,"_31461":73665,"_21806":122600,"_5":15007,"_28616":122555,"_3094":122601},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3706":73687,"_31461":73665,"_21806":122603,"_5":15007,"_28616":122555,"_3094":122604},[],"Ejecuta también la prueba de conectividad del chart:",{"_3706":73688,"_31461":73665,"_21806":122606,"_5":15007,"_28616":122555,"_3094":122607},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3706":73689,"_31461":73665,"_21806":122609,"_5":15007,"_28616":122555,"_3094":122610},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3706":73690,"_31461":73665,"_21806":122612,"_5":15007,"_28616":122559,"_3094":122613},[],"Si recibes un 401:",{"_3706":73691,"_31461":73665,"_21806":122615,"_5":15007,"_28616":122559,"_3094":122616},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3706":73692,"_31461":73665,"_21806":122618,"_5":15007,"_28616":122559,"_3094":122619},[],"verifica emisor, audiencia y expiración del token;",{"_3706":73693,"_31461":73665,"_21806":122621,"_5":15007,"_28616":122559,"_3094":122622},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3706":73694,"_31461":73665,"_21806":122624,"_5":15007,"_28616":122559,"_3094":122625},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3706":73695,"_31461":73665,"_21806":122627,"_5":15007,"_28616":122559,"_3094":122628},[],"Si el login termina pero las APIs devuelven 403:",{"_3706":73696,"_31461":73665,"_21806":122630,"_5":15007,"_28616":122559,"_3094":122631},[],"inspecciona los claims reales del token;",{"_3706":73697,"_31461":73665,"_21806":122633,"_5":15007,"_28616":122559,"_3094":122634},[],"confirma que coinciden con un principal activo;",{"_3706":73698,"_31461":73665,"_21806":122636,"_5":15007,"_28616":122559,"_3094":122637},[],"revisa las políticas concedidas al principal;",{"_3706":73699,"_31461":73665,"_21806":122639,"_5":15007,"_28616":122559,"_3094":122640},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3706":73700,"_31461":73665,"_21806":122642,"_5":15007,"_28616":122559,"_3094":122643},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3706":73701,"_31461":73665,"_21806":122645,"_5":15007,"_28616":122563,"_3094":122646},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3706":73702,"_31461":73665,"_21806":122648,"_5":15007,"_28616":122563,"_3094":122649},[],"Localiza el pod y Service de authz.",{"_3706":73703,"_31461":73665,"_21806":122651,"_5":15007,"_28616":122563,"_3094":122652},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3706":73704,"_31461":73665,"_21806":122654,"_5":15007,"_28616":122563,"_3094":122655},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3706":73705,"_31461":73665,"_21806":122657,"_5":15007,"_28616":122563,"_3094":122658},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3706":73706,"_31461":73665,"_21806":122660,"_5":15007,"_28616":122563,"_3094":122661},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3706":73707,"_31461":73665,"_21806":122663,"_5":15007,"_28616":122567,"_3094":122664},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3706":73708,"_31461":73665,"_21806":122666,"_5":15007,"_28616":122571,"_3094":122667},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3706":73709,"_31461":73665,"_21806":122669,"_5":15007,"_28616":122571,"_3094":122670},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3706":73710,"_31461":73665,"_21806":122672,"_5":15007,"_28616":122571,"_3094":122673},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3706":73711,"_31461":73665,"_21806":122675,"_5":15007,"_28616":122571,"_3094":122676},[],"volumen persistente sin enlazar;",{"_3706":73712,"_31461":73665,"_21806":122678,"_5":15007,"_28616":122571,"_3094":122679},[],"imagen inaccesible o política de pull incorrecta;",{"_3706":73713,"_31461":73665,"_21806":122681,"_5":15007,"_28616":122571,"_3094":122682},[],"configuración inválida del motor criptográfico;",{"_3706":73714,"_31461":73665,"_21806":122684,"_5":15007,"_28616":122571,"_3094":122685},[],"límites de CPU o memoria demasiado bajos;",{"_3706":73715,"_31461":73665,"_21806":122687,"_5":15007,"_28616":122571,"_3094":122688},[],"migración previa incompleta.",{"_3706":73716,"_31461":73665,"_21806":122690,"_5":15007,"_28616":122571,"_3094":122691},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3706":73717,"_31461":73665,"_21806":122693,"_5":15007,"_28616":122571,"_3094":122694},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3706":73718,"_31461":73665,"_21806":122696,"_5":15007,"_28616":122571,"_3094":122697},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3706":73719,"_31461":73665,"_21806":122699,"_5":15007,"_28616":122575,"_3094":122700},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3706":73720,"_31461":73665,"_21806":122702,"_5":15007,"_28616":122575,"_3094":122703},[],"verifica que esté habilitado en el servicio emisor;",{"_3706":73721,"_31461":73665,"_21806":122705,"_5":15007,"_28616":122575,"_3094":122706},[],"comprueba conectividad y credenciales AMQP;",{"_3706":73722,"_31461":73665,"_21806":122708,"_5":15007,"_28616":122575,"_3094":122709},[],"revisa exchange, routing key, colas y consumidores;",{"_3706":73723,"_31461":73665,"_21806":122711,"_5":15007,"_28616":122575,"_3094":122712},[],"inspecciona dead-letter queues;",{"_3706":73724,"_31461":73665,"_21806":122714,"_5":15007,"_28616":122575,"_3094":122715},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3706":73725,"_31461":73665,"_21806":122717,"_5":15007,"_28616":122575,"_3094":122718},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3706":73726,"_31461":73665,"_21806":122720,"_5":15007,"_28616":122575,"_3094":122721},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3706":73727,"_31461":73665,"_21806":122723,"_5":15007,"_28616":122575,"_3094":122724},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3706":73728,"_31461":73665,"_21806":122726,"_5":15007,"_28616":122575,"_3094":122727},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3706":73729,"_31461":73665,"_21806":122729,"_5":15007,"_28616":122575,"_3094":122730},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3706":73730,"_31461":73665,"_21806":122732,"_5":15007,"_28616":122575,"_3094":122733},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3706":73731,"_31461":73665,"_21806":122735,"_5":15007,"_28616":122575,"_3094":122736},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3706":73732,"_31461":73665,"_21806":122738,"_5":15007,"_28616":122579,"_3094":122739},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3706":73733,"_31461":73665,"_21806":122741,"_5":15007,"_28616":122579,"_3094":122742},[],"Antes de cerrar una incidencia, guarda:",{"_3706":73734,"_31461":73665,"_21806":122744,"_5":15007,"_28616":122579,"_3094":122745},[],"causa confirmada;",{"_3706":73735,"_31461":73665,"_21806":122747,"_5":15007,"_28616":122579,"_3094":122748},[],"alcance temporal y recursos afectados;",{"_3706":73736,"_31461":73665,"_21806":122750,"_5":15007,"_28616":122579,"_3094":122751},[],"comandos o consultas utilizados;",{"_3706":73737,"_31461":73665,"_21806":122753,"_5":15007,"_28616":122579,"_3094":122754},[],"cambio aplicado y forma de revertirlo;",{"_3706":73738,"_31461":73665,"_21806":122756,"_5":15007,"_28616":122579,"_3094":122757},[],"validación desde un consumidor;",{"_3706":73739,"_31461":73665,"_21806":122759,"_5":15007,"_28616":122579,"_3094":122760},[],"acción preventiva y propietario.",{"_3706":73740,"_31461":73740,"_5":15367,"_3094":122762,"_31820":122763,"_21806":122767,"_28616":73740},"Modelo de datos",[51344,122764,122765,122766],"Plataforma","Administración","Control de acceso",[],{"_3706":73741,"_31461":73740,"_21806":122769,"_5":15007,"_28616":73740,"_3094":122770},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3706":73742,"_31461":73740,"_5":31817,"_21806":122772,"_28616":122773,"_3094":122774},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3706":73743,"_31461":73740,"_5":31817,"_21806":122776,"_28616":122777,"_3094":122778},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3706":73744,"_31461":73740,"_21806":122780,"_5":15007,"_28616":73740,"_3094":122781},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3706":73745,"_31461":73740,"_21806":122783,"_5":15007,"_28616":122773,"_3094":122784},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3706":73746,"_31461":73740,"_21806":122786,"_5":15007,"_28616":122773,"_3094":122787},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3706":73747,"_31461":73740,"_21806":122789,"_5":15007,"_28616":122773,"_3094":122790},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3706":73748,"_31461":73740,"_21806":122792,"_5":15007,"_28616":122777,"_3094":122793},[],"Entidad (`schema_name.entity_type`)",{"_3706":73749,"_31461":73740,"_21806":122795,"_5":15007,"_28616":122777,"_3094":122796},[],"Tabla (`table_name`)",{"_3706":73750,"_31461":73740,"_21806":122798,"_5":15007,"_28616":122777,"_3094":122799},[],"Clave (`primary_key`)",{"_3706":73751,"_31461":73740,"_21806":122801,"_5":15007,"_28616":122777,"_3094":52920},[],{"_3706":73752,"_31461":73740,"_21806":122803,"_5":15007,"_28616":122777,"_3094":52923},[],{"_3706":73753,"_31461":73740,"_21806":122805,"_5":15007,"_28616":122777,"_3094":52926},[],{"_3706":73754,"_31461":73740,"_21806":122807,"_5":15007,"_28616":122777,"_3094":52929},[],{"_3706":73755,"_31461":73740,"_21806":122809,"_5":15007,"_28616":122777,"_3094":52932},[],{"_3706":73756,"_31461":73740,"_21806":122811,"_5":15007,"_28616":122777,"_3094":52935},[],{"_3706":73757,"_31461":73740,"_21806":122813,"_5":15007,"_28616":122777,"_3094":52938},[],{"_3706":73758,"_31461":73740,"_21806":122815,"_5":15007,"_28616":122777,"_3094":52941},[],{"_3706":73759,"_31461":73740,"_21806":122817,"_5":15007,"_28616":122777,"_3094":52935},[],{"_3706":73760,"_31461":73740,"_21806":122819,"_5":15007,"_28616":122777,"_3094":52946},[],{"_3706":73761,"_31461":73740,"_21806":122821,"_5":15007,"_28616":122777,"_3094":52949},[],{"_3706":73762,"_31461":73740,"_21806":122823,"_5":15007,"_28616":122777,"_3094":52952},[],{"_3706":73763,"_31461":73740,"_21806":122825,"_5":15007,"_28616":122777,"_3094":52955},[],{"_3706":73764,"_31461":73740,"_21806":122827,"_5":15007,"_28616":122777,"_3094":52958},[],{"_3706":73765,"_31461":73740,"_21806":122829,"_5":15007,"_28616":122777,"_3094":52935},[],{"_3706":73766,"_31461":73740,"_21806":122831,"_5":15007,"_28616":122777,"_3094":52963},[],{"_3706":73767,"_31461":73740,"_21806":122833,"_5":15007,"_28616":122777,"_3094":52966},[],{"_3706":73768,"_31461":73740,"_21806":122835,"_5":15007,"_28616":122777,"_3094":52935},[],{"_3706":73769,"_31461":73740,"_21806":122837,"_5":15007,"_28616":122777,"_3094":52971},[],{"_3706":73770,"_31461":73740,"_21806":122839,"_5":15007,"_28616":122777,"_3094":52974},[],{"_3706":73771,"_31461":73740,"_21806":122841,"_5":15007,"_28616":122777,"_3094":52935},[],{"_3706":73772,"_31461":73740,"_21806":122843,"_5":15007,"_28616":122777,"_3094":52979},[],{"_3706":73773,"_31461":73740,"_21806":122845,"_5":15007,"_28616":122777,"_3094":52982},[],{"_3706":73774,"_31461":73740,"_21806":122847,"_5":15007,"_28616":122777,"_3094":52935},[],{"_3706":73775,"_31461":73740,"_21806":122849,"_5":15007,"_28616":122777,"_3094":52987},[],{"_3706":73776,"_31461":73740,"_21806":122851,"_5":15007,"_28616":122777,"_3094":52990},[],{"_3706":73777,"_31461":73740,"_21806":122853,"_5":15007,"_28616":122777,"_3094":52993},[],{"_3706":73778,"_31461":73740,"_21806":122855,"_5":15007,"_28616":122777,"_3094":52996},[],{"_3706":73779,"_31461":73740,"_21806":122857,"_5":15007,"_28616":122777,"_3094":52999},[],{"_3706":73780,"_31461":73740,"_21806":122859,"_5":15007,"_28616":122777,"_3094":53002},[],{"_3706":73781,"_31461":73740,"_21806":122861,"_5":15007,"_28616":122777,"_3094":122862},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3706":73782,"_31461":73740,"_21806":122864,"_5":15007,"_28616":122777,"_3094":122865},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3706":73783,"_31461":73740,"_21806":122867,"_5":15007,"_28616":122777,"_3094":122868},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3706":73784,"_31461":73784,"_5":15367,"_3094":122870,"_31820":122871,"_21806":122872,"_28616":73784},"Visión general del control de acceso",[51344,122764,122765,122766],[],{"_3706":73785,"_31461":73784,"_21806":122874,"_5":15007,"_28616":73784,"_3094":122875},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3706":73786,"_31461":73784,"_5":31817,"_21806":122877,"_28616":122878,"_3094":122879},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3706":73787,"_31461":73784,"_5":31817,"_21806":122881,"_28616":122882,"_3094":122883},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3706":73788,"_31461":73784,"_5":31817,"_21806":122885,"_28616":122886,"_3094":122887},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3706":73789,"_31461":73784,"_5":31817,"_21806":122889,"_28616":122890,"_3094":122891},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3706":73790,"_31461":73784,"_5":31817,"_21806":122893,"_28616":122894,"_3094":122895},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3706":73791,"_31461":73784,"_5":31817,"_21806":122897,"_28616":122898,"_3094":122899},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3706":73792,"_31461":73784,"_5":31817,"_21806":122901,"_28616":122902,"_3094":122903},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3706":73793,"_31461":73784,"_5":31817,"_21806":122905,"_28616":122906,"_3094":122907},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3706":73794,"_31461":73784,"_5":31817,"_21806":122909,"_28616":122910,"_3094":122911},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3706":73795,"_31461":73784,"_5":31817,"_21806":122913,"_28616":122914,"_3094":122915},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3706":73796,"_31461":73784,"_5":31817,"_21806":122917,"_28616":122918,"_3094":122919},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3706":73797,"_31461":73784,"_5":31817,"_21806":122921,"_28616":122922,"_3094":122923},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3706":73798,"_31461":73784,"_5":31817,"_21806":122925,"_28616":122926,"_3094":122927},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3706":73799,"_31461":73784,"_5":31817,"_21806":122929,"_28616":122930,"_3094":122931},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3706":73800,"_31461":73784,"_5":31817,"_21806":122933,"_28616":122934,"_3094":122935},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3706":73801,"_31461":73784,"_5":31817,"_21806":122937,"_28616":122938,"_3094":121883},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3706":73802,"_31461":73784,"_5":31817,"_21806":122940,"_28616":122941,"_3094":122942},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3706":73803,"_31461":73784,"_5":31817,"_21806":122944,"_28616":122945,"_3094":122946},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3706":73804,"_31461":73784,"_5":31817,"_21806":122948,"_28616":122949,"_3094":122950},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3706":73805,"_31461":73784,"_5":31817,"_21806":122952,"_28616":122953,"_3094":122954},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3706":73806,"_31461":73784,"_5":31817,"_21806":122956,"_28616":122957,"_3094":122958},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3706":73807,"_31461":73784,"_5":31817,"_21806":122960,"_28616":122961,"_3094":122962},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3706":73808,"_31461":73784,"_5":31817,"_21806":122964,"_28616":122965,"_3094":122966},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3706":73809,"_31461":73784,"_5":31817,"_21806":122968,"_28616":122969,"_3094":122970},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3706":73810,"_31461":73784,"_5":31817,"_21806":122972,"_28616":122973,"_3094":122974},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3706":73811,"_31461":73784,"_5":31817,"_21806":122976,"_28616":122977,"_3094":122978},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3706":73812,"_31461":73784,"_5":31817,"_21806":122980,"_28616":122981,"_3094":122982},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3706":73813,"_31461":73784,"_5":31817,"_21806":122984,"_28616":122985,"_3094":122986},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3706":73814,"_31461":73784,"_5":31817,"_21806":122988,"_28616":122989,"_3094":122990},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3706":73815,"_31461":73784,"_5":31817,"_21806":122992,"_28616":122993,"_3094":122994},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3706":73816,"_31461":73784,"_5":31817,"_21806":122996,"_28616":122997,"_3094":122998},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3706":73817,"_31461":73784,"_21806":123000,"_5":15007,"_28616":73784,"_3094":123001},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3706":73818,"_31461":73784,"_21806":123003,"_5":15007,"_28616":73784,"_3094":123004},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3706":73819,"_31461":73784,"_21806":123006,"_5":15007,"_28616":73784,"_3094":123007},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3706":73820,"_31461":73784,"_21806":123009,"_5":15007,"_28616":122878,"_3094":123010},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3706":73821,"_31461":73784,"_21806":123012,"_5":15007,"_28616":122878,"_3094":123013},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3706":73822,"_31461":73784,"_21806":123015,"_5":15007,"_28616":122878,"_3094":123016},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3706":73823,"_31461":73784,"_21806":123018,"_5":15007,"_28616":122878,"_3094":123019},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3706":73824,"_31461":73784,"_21806":123021,"_5":15007,"_28616":122878,"_3094":123022},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3706":73825,"_31461":73784,"_21806":123024,"_5":15007,"_28616":122878,"_3094":123025},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3706":73826,"_31461":73784,"_21806":123027,"_5":15007,"_28616":122882,"_3094":123028},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3706":73827,"_31461":73784,"_21806":123030,"_5":15007,"_28616":122882,"_3094":123031},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3706":73828,"_31461":73784,"_21806":123033,"_5":15007,"_28616":122886,"_3094":123034},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3706":73829,"_31461":73784,"_21806":123036,"_5":15007,"_28616":122886,"_3094":123037},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3706":73830,"_31461":73784,"_21806":123039,"_5":15007,"_28616":122886,"_3094":123040},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3706":73831,"_31461":73784,"_21806":123042,"_5":15007,"_28616":122886,"_3094":123043},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3706":73832,"_31461":73784,"_21806":123045,"_5":15007,"_28616":122886,"_3094":123046},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3706":73833,"_31461":73784,"_21806":123048,"_5":15007,"_28616":122886,"_3094":123049},[],"Carga por separado las políticas concedidas a cada principal.",{"_3706":73834,"_31461":73784,"_21806":123051,"_5":15007,"_28616":122886,"_3094":123052},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3706":73835,"_31461":73784,"_21806":123054,"_5":15007,"_28616":122886,"_3094":123055},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3706":73836,"_31461":73784,"_21806":123057,"_5":15007,"_28616":122886,"_3094":123058},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3706":73837,"_31461":73784,"_21806":123060,"_5":15007,"_28616":122886,"_3094":123061},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3706":73838,"_31461":73784,"_21806":123063,"_5":15007,"_28616":122886,"_3094":123064},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3706":73839,"_31461":73784,"_21806":123066,"_5":15007,"_28616":122886,"_3094":123067},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3706":73840,"_31461":73784,"_21806":123069,"_5":15007,"_28616":122890,"_3094":123070},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3706":73841,"_31461":73784,"_21806":123072,"_5":15007,"_28616":122890,"_3094":123073},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3706":73842,"_31461":73784,"_21806":123075,"_5":15007,"_28616":122890,"_3094":123076},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3706":73843,"_31461":73784,"_21806":123078,"_5":15007,"_28616":122890,"_3094":123079},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3706":73844,"_31461":73784,"_21806":123081,"_5":15007,"_28616":122890,"_3094":123082},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3706":73845,"_31461":73784,"_21806":123084,"_5":15007,"_28616":122890,"_3094":123085},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3706":73846,"_31461":73784,"_21806":123087,"_5":15007,"_28616":122890,"_3094":123088},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3706":73847,"_31461":73784,"_21806":123090,"_5":15007,"_28616":122890,"_3094":123091},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3706":73848,"_31461":73784,"_21806":123093,"_5":15007,"_28616":122890,"_3094":123094},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3706":73849,"_31461":73784,"_21806":123096,"_5":15007,"_28616":122890,"_3094":123097},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3706":73850,"_31461":73784,"_21806":123099,"_5":15007,"_28616":122894,"_3094":123100},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3706":73851,"_31461":73784,"_21806":123102,"_5":15007,"_28616":122894,"_3094":123103},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3706":73852,"_31461":73784,"_21806":123105,"_5":15007,"_28616":122894,"_3094":123106},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3706":73853,"_31461":73784,"_21806":123108,"_5":15007,"_28616":122894,"_3094":123109},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3706":73854,"_31461":73784,"_21806":123111,"_5":15007,"_28616":122894,"_3094":123112},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3706":73855,"_31461":73784,"_21806":123114,"_5":15007,"_28616":122894,"_3094":123115},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3706":73856,"_31461":73784,"_21806":123117,"_5":15007,"_28616":122894,"_3094":123118},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3706":73857,"_31461":73784,"_21806":123120,"_5":15007,"_28616":122894,"_3094":123121},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3706":73858,"_31461":73784,"_21806":123123,"_5":15007,"_28616":122894,"_3094":123124},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3706":73859,"_31461":73784,"_21806":123126,"_5":15007,"_28616":122894,"_3094":123127},[],"Las acciones se dividen en dos grupos:",{"_3706":73860,"_31461":73784,"_21806":123129,"_5":15007,"_28616":122894,"_3094":123130},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3706":73861,"_31461":73784,"_21806":123132,"_5":15007,"_28616":122894,"_3094":123133},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3706":73862,"_31461":73784,"_21806":123135,"_5":15007,"_28616":122894,"_3094":123136},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3706":73863,"_31461":73784,"_21806":123138,"_5":15007,"_28616":122898,"_3094":123139},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3706":73864,"_31461":73784,"_21806":123141,"_5":15007,"_28616":122898,"_3094":123142},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3706":73865,"_31461":73784,"_21806":123144,"_5":15007,"_28616":122898,"_3094":123145},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3706":73866,"_31461":73784,"_21806":123147,"_5":15007,"_28616":122902,"_3094":123148},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3706":73867,"_31461":73784,"_21806":123150,"_5":15007,"_28616":122902,"_3094":123151},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3706":73868,"_31461":73784,"_21806":123153,"_5":15007,"_28616":122902,"_3094":123154},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3706":73869,"_31461":73784,"_21806":123156,"_5":15007,"_28616":122902,"_3094":123157},[],"Los operadores implementados son:",{"_3706":73870,"_31461":73784,"_21806":123159,"_5":15007,"_28616":122902,"_3094":123160},[],"`equals`, para igualdad exacta;",{"_3706":73871,"_31461":73784,"_21806":123162,"_5":15007,"_28616":122902,"_3094":123163},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3706":73872,"_31461":73784,"_21806":123165,"_5":15007,"_28616":122902,"_3094":123166},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3706":73873,"_31461":73784,"_21806":123168,"_5":15007,"_28616":122902,"_3094":123169},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3706":73874,"_31461":73784,"_21806":123171,"_5":15007,"_28616":122906,"_3094":123172},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3706":73875,"_31461":73784,"_21806":123174,"_5":15007,"_28616":122906,"_3094":123175},[],"Los modos disponibles son:",{"_3706":73876,"_31461":73784,"_21806":123177,"_5":15007,"_28616":122906,"_3094":123178},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3706":73877,"_31461":73784,"_21806":123180,"_5":15007,"_28616":122906,"_3094":123181},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3706":73878,"_31461":73784,"_21806":123183,"_5":15007,"_28616":122906,"_3094":123184},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3706":73879,"_31461":73784,"_21806":123186,"_5":15007,"_28616":122906,"_3094":123187},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3706":73880,"_31461":73784,"_21806":123189,"_5":15007,"_28616":122906,"_3094":123190},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3706":73881,"_31461":73784,"_21806":123192,"_5":15007,"_28616":122906,"_3094":123193},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3706":73882,"_31461":73784,"_21806":123195,"_5":15007,"_28616":122910,"_3094":123196},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3706":73883,"_31461":73784,"_21806":123198,"_5":15007,"_28616":122910,"_3094":123199},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3706":73884,"_31461":73784,"_21806":123201,"_5":15007,"_28616":122910,"_3094":123202},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3706":73885,"_31461":73784,"_21806":123204,"_5":15007,"_28616":122910,"_3094":123205},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3706":73886,"_31461":73784,"_21806":123207,"_5":15007,"_28616":122918,"_3094":123208},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3706":73887,"_31461":73784,"_21806":123210,"_5":15007,"_28616":122918,"_3094":123211},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3706":73888,"_31461":73784,"_21806":123213,"_5":15007,"_28616":122922,"_3094":123214},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3706":73889,"_31461":73784,"_21806":123216,"_5":15007,"_28616":122922,"_3094":123217},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3706":73890,"_31461":73784,"_21806":123219,"_5":15007,"_28616":122922,"_3094":123220},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3706":73891,"_31461":73784,"_21806":123222,"_5":15007,"_28616":122922,"_3094":123223},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3706":73892,"_31461":73784,"_21806":123225,"_5":15007,"_28616":122922,"_3094":123226},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3706":73893,"_31461":73784,"_21806":123228,"_5":15007,"_28616":122926,"_3094":123229},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3706":73894,"_31461":73784,"_21806":123231,"_5":15007,"_28616":122926,"_3094":123232},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3706":73895,"_31461":73784,"_21806":123234,"_5":15007,"_28616":122926,"_3094":123235},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3706":73896,"_31461":73784,"_21806":123237,"_5":15007,"_28616":122930,"_3094":123238},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3706":73897,"_31461":73784,"_21806":123240,"_5":15007,"_28616":122930,"_3094":123241},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3706":73898,"_31461":73784,"_21806":123243,"_5":15007,"_28616":122930,"_3094":123244},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3706":73899,"_31461":73784,"_21806":123246,"_5":15007,"_28616":122930,"_3094":123247},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3706":73900,"_31461":73784,"_21806":123249,"_5":15007,"_28616":122930,"_3094":123250},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3706":73901,"_31461":73784,"_21806":123252,"_5":15007,"_28616":122930,"_3094":123253},[],"Ten en cuenta que:",{"_3706":73902,"_31461":73784,"_21806":123255,"_5":15007,"_28616":122930,"_3094":123256},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3706":73903,"_31461":73784,"_21806":123258,"_5":15007,"_28616":122930,"_3094":123259},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3706":73904,"_31461":73784,"_21806":123261,"_5":15007,"_28616":122930,"_3094":123262},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3706":73905,"_31461":73784,"_21806":123264,"_5":15007,"_28616":122934,"_3094":123265},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3706":73906,"_31461":73784,"_21806":123267,"_5":15007,"_28616":122934,"_3094":123268},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3706":73907,"_31461":73784,"_21806":123270,"_5":15007,"_28616":122934,"_3094":123271},[],"acceso completo y de solo lectura a KMS;",{"_3706":73908,"_31461":73784,"_21806":123273,"_5":15007,"_28616":122934,"_3094":123274},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3706":73909,"_31461":73784,"_21806":123276,"_5":15007,"_28616":122934,"_3094":123277},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3706":73910,"_31461":73784,"_21806":123279,"_5":15007,"_28616":122934,"_3094":123280},[],"acceso a la interfaz;",{"_3706":73911,"_31461":73784,"_21806":123282,"_5":15007,"_28616":122934,"_3094":123283},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3706":73912,"_31461":73784,"_21806":123285,"_5":15007,"_28616":122934,"_3094":123286},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3706":73913,"_31461":73784,"_21806":123288,"_5":15007,"_28616":122934,"_3094":123289},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3706":73914,"_31461":73784,"_21806":123291,"_5":15007,"_28616":122934,"_3094":123292},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3706":73915,"_31461":73784,"_21806":123294,"_5":15007,"_28616":122934,"_3094":123295},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3706":73916,"_31461":73784,"_21806":123297,"_5":15007,"_28616":122938,"_3094":123298},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3706":73917,"_31461":73784,"_21806":123300,"_5":15007,"_28616":122938,"_3094":123301},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3706":73918,"_31461":73784,"_21806":123303,"_5":15007,"_28616":122938,"_3094":123304},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3706":73919,"_31461":73784,"_21806":123306,"_5":15007,"_28616":122941,"_3094":123307},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3706":73920,"_31461":73784,"_21806":123309,"_5":15007,"_28616":122945,"_3094":123310},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3706":73921,"_31461":73784,"_21806":123312,"_5":15007,"_28616":122945,"_3094":123313},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3706":73922,"_31461":73784,"_21806":123315,"_5":15007,"_28616":122949,"_3094":123316},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3706":73923,"_31461":73784,"_21806":123318,"_5":15007,"_28616":122953,"_3094":123319},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3706":73924,"_31461":73784,"_21806":123321,"_5":15007,"_28616":122957,"_3094":123322},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3706":73925,"_31461":73784,"_21806":123324,"_5":15007,"_28616":122961,"_3094":123325},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3706":73926,"_31461":73784,"_21806":123327,"_5":15007,"_28616":122961,"_3094":123328},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3706":73927,"_31461":73784,"_21806":123330,"_5":15007,"_28616":122965,"_3094":123331},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3706":73928,"_31461":73784,"_21806":123333,"_5":15007,"_28616":122965,"_3094":123334},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3706":73929,"_31461":73784,"_21806":123336,"_5":15007,"_28616":122965,"_3094":123337},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3706":73930,"_31461":73784,"_21806":123339,"_5":15007,"_28616":122965,"_3094":123340},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3706":73931,"_31461":73784,"_21806":123342,"_5":15007,"_28616":122965,"_3094":123343},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3706":73932,"_31461":73784,"_21806":123345,"_5":15007,"_28616":122965,"_3094":123346},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3706":73933,"_31461":73784,"_21806":123348,"_5":15007,"_28616":122965,"_3094":123349},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3706":73934,"_31461":73784,"_21806":123351,"_5":15007,"_28616":122965,"_3094":123352},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3706":73935,"_31461":73784,"_21806":123354,"_5":15007,"_28616":122969,"_3094":123355},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3706":73936,"_31461":73784,"_21806":123357,"_5":15007,"_28616":122969,"_3094":123358},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3706":73937,"_31461":73784,"_21806":123360,"_5":15007,"_28616":122969,"_3094":123361},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3706":73938,"_31461":73784,"_21806":123363,"_5":15007,"_28616":122973,"_3094":123364},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3706":73939,"_31461":73784,"_21806":123366,"_5":15007,"_28616":122973,"_3094":123367},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3706":73940,"_31461":73784,"_21806":123369,"_5":15007,"_28616":122973,"_3094":123370},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3706":73941,"_31461":73784,"_21806":123372,"_5":15007,"_28616":122973,"_3094":123373},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3706":73942,"_31461":73784,"_21806":123375,"_5":15007,"_28616":122973,"_3094":123376},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3706":73943,"_31461":73784,"_21806":123378,"_5":15007,"_28616":122973,"_3094":123379},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3706":73944,"_31461":73784,"_21806":123381,"_5":15007,"_28616":122973,"_3094":123382},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3706":73945,"_31461":73784,"_21806":123384,"_5":15007,"_28616":122973,"_3094":123385},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3706":73946,"_31461":73784,"_21806":123387,"_5":15007,"_28616":122981,"_3094":123388},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3706":73947,"_31461":73784,"_21806":123390,"_5":15007,"_28616":122985,"_3094":123391},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3706":73948,"_31461":73784,"_21806":123393,"_5":15007,"_28616":122985,"_3094":123394},[],"que exista un principal activo del tipo correcto;",{"_3706":73949,"_31461":73784,"_21806":123396,"_5":15007,"_28616":122985,"_3094":123397},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3706":73950,"_31461":73784,"_21806":123399,"_5":15007,"_28616":122985,"_3094":123400},[],"que todas las condiciones del principal se cumplan;",{"_3706":73951,"_31461":73784,"_21806":123402,"_5":15007,"_28616":122985,"_3094":123403},[],"que el principal tenga concedida la política esperada;",{"_3706":73952,"_31461":73784,"_21806":123405,"_5":15007,"_28616":122985,"_3094":123406},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3706":73953,"_31461":73784,"_21806":123408,"_5":15007,"_28616":122985,"_3094":123409},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3706":73954,"_31461":73784,"_21806":123411,"_5":15007,"_28616":122985,"_3094":123412},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3706":73955,"_31461":73784,"_21806":123414,"_5":15007,"_28616":122985,"_3094":123415},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3706":73956,"_31461":73784,"_21806":123417,"_5":15007,"_28616":122989,"_3094":123418},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3706":73957,"_31461":73784,"_21806":123420,"_5":15007,"_28616":122993,"_3094":123421},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3706":73958,"_31461":73784,"_21806":123423,"_5":15007,"_28616":122997,"_3094":123424},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3706":73959,"_31461":73784,"_21806":123426,"_5":15007,"_28616":122997,"_3094":123427},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3706":73960,"_31461":73960,"_5":15367,"_3094":123429,"_31820":123430,"_21806":123431,"_28616":73960},"Alertas y suscripciones",[51344,122764,122765],[],{"_3706":73961,"_31461":73960,"_21806":123433,"_5":15007,"_28616":73960,"_3094":123434},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3706":73962,"_31461":73960,"_5":31817,"_21806":123436,"_28616":123437,"_3094":123438},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3706":73963,"_31461":73960,"_5":31817,"_21806":123440,"_28616":123441,"_3094":123442},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3706":73964,"_31461":73960,"_5":31817,"_21806":123444,"_28616":123445,"_3094":123446},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3706":73965,"_31461":73960,"_5":31817,"_21806":123448,"_28616":123449,"_3094":123450},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3706":73966,"_31461":73960,"_5":31817,"_21806":123452,"_28616":123453,"_3094":123454},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3706":73967,"_31461":73960,"_5":31817,"_21806":123456,"_28616":123457,"_3094":123458},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3706":73968,"_31461":73960,"_5":31817,"_21806":123460,"_28616":123461,"_3094":123462},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3706":73969,"_31461":73960,"_5":31817,"_21806":123464,"_28616":123465,"_3094":123466},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3706":73970,"_31461":73960,"_5":31817,"_21806":123468,"_28616":123469,"_3094":123470},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3706":73971,"_31461":73960,"_5":31817,"_21806":123472,"_28616":123473,"_3094":123474},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3706":73972,"_31461":73960,"_5":31817,"_21806":123476,"_28616":123477,"_3094":123478},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3706":73973,"_31461":73960,"_21806":123480,"_5":15007,"_28616":73960,"_3094":123481},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3706":73974,"_31461":73960,"_21806":123483,"_5":15007,"_28616":123437,"_3094":123484},[],"Un servicio publica un evento de dominio.",{"_3706":73975,"_31461":73960,"_21806":123486,"_5":15007,"_28616":123437,"_3094":123487},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3706":73976,"_31461":73960,"_21806":123489,"_5":15007,"_28616":123437,"_3094":123490},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3706":73977,"_31461":73960,"_21806":123492,"_5":15007,"_28616":123437,"_3094":123493},[],"Lamassu entrega el evento al canal configurado.",{"_3706":73978,"_31461":73960,"_21806":123495,"_5":15007,"_28616":123437,"_3094":123496},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3706":73979,"_31461":73960,"_21806":123498,"_5":15007,"_28616":123441,"_3094":123499},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3706":73980,"_31461":73960,"_21806":123501,"_5":15007,"_28616":123441,"_3094":123502},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3706":73981,"_31461":73960,"_21806":123504,"_5":15007,"_28616":123441,"_3094":123505},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3706":73982,"_31461":73960,"_21806":123507,"_5":15007,"_28616":123441,"_3094":123508},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3706":73983,"_31461":73960,"_21806":123510,"_5":15007,"_28616":123441,"_3094":123511},[],"`apikey_options` necesita `header` y `key`.",{"_3706":73984,"_31461":73960,"_21806":123513,"_5":15007,"_28616":123441,"_3094":123514},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3706":73985,"_31461":73960,"_21806":123516,"_5":15007,"_28616":123441,"_3094":123517},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3706":73986,"_31461":73960,"_21806":123519,"_5":15007,"_28616":123441,"_3094":123520},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3706":73987,"_31461":73960,"_21806":123522,"_5":15007,"_28616":123449,"_3094":123523},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3706":73988,"_31461":73960,"_21806":123525,"_5":15007,"_28616":123453,"_3094":123526},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3706":73989,"_31461":73960,"_21806":123528,"_5":15007,"_28616":123457,"_3094":123529},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3706":73990,"_31461":73960,"_21806":123531,"_5":15007,"_28616":123457,"_3094":123532},[],"**None** notifica todas las instancias del evento.",{"_3706":73991,"_31461":73960,"_21806":123534,"_5":15007,"_28616":123457,"_3094":123535},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3706":73992,"_31461":73960,"_21806":123537,"_5":15007,"_28616":123457,"_3094":123538},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3706":73993,"_31461":73960,"_21806":123540,"_5":15007,"_28616":123457,"_3094":123541},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3706":73994,"_31461":73960,"_21806":123543,"_5":15007,"_28616":123457,"_3094":123544},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3706":73995,"_31461":73960,"_21806":123546,"_5":15007,"_28616":123457,"_3094":123547},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3706":73996,"_31461":73960,"_21806":123549,"_5":15007,"_28616":123461,"_3094":123550},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3706":73997,"_31461":73960,"_21806":123552,"_5":15007,"_28616":123465,"_3094":123553},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3706":73998,"_31461":73960,"_21806":123555,"_5":15007,"_28616":123465,"_3094":123556},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3706":73999,"_31461":73960,"_21806":123558,"_5":15007,"_28616":123465,"_3094":123559},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3706":74000,"_31461":73960,"_21806":123561,"_5":15007,"_28616":123465,"_3094":123562},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3706":74001,"_31461":73960,"_21806":123564,"_5":15007,"_28616":123465,"_3094":123565},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3706":74002,"_31461":73960,"_21806":123567,"_5":15007,"_28616":123465,"_3094":123568},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3706":74003,"_31461":73960,"_21806":123570,"_5":15007,"_28616":123465,"_3094":123571},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3706":74004,"_31461":73960,"_21806":123573,"_5":15007,"_28616":123465,"_3094":123574},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3706":74005,"_31461":73960,"_21806":123576,"_5":15007,"_28616":123469,"_3094":123577},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3706":74006,"_31461":73960,"_21806":123579,"_5":15007,"_28616":123469,"_3094":123580},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3706":74007,"_31461":73960,"_21806":123582,"_5":15007,"_28616":123469,"_3094":123583},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3706":74008,"_31461":73960,"_21806":123585,"_5":15007,"_28616":123469,"_3094":123586},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3706":74009,"_31461":73960,"_21806":123588,"_5":15007,"_28616":123469,"_3094":123589},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3706":74010,"_31461":73960,"_21806":123591,"_5":15007,"_28616":123469,"_3094":123592},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3706":74011,"_31461":73960,"_21806":123594,"_5":15007,"_28616":123469,"_3094":123595},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3706":74012,"_31461":73960,"_21806":123597,"_5":15007,"_28616":123469,"_3094":123598},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3706":74013,"_31461":73960,"_21806":123600,"_5":15007,"_28616":123473,"_3094":123601},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3706":74014,"_31461":73960,"_21806":123603,"_5":15007,"_28616":123473,"_3094":123604},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3706":74015,"_31461":73960,"_21806":123606,"_5":15007,"_28616":123477,"_3094":123607},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3706":74016,"_31461":73960,"_21806":123609,"_5":15007,"_28616":123477,"_3094":123610},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3706":74017,"_31461":73960,"_21806":123612,"_5":15007,"_28616":123477,"_3094":123613},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3706":74018,"_31461":73960,"_21806":123615,"_5":15007,"_28616":123477,"_3094":123616},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3706":74019,"_31461":73960,"_21806":123618,"_5":15007,"_28616":123477,"_3094":123619},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3706":74020,"_31461":73960,"_21806":123621,"_5":15007,"_28616":123477,"_3094":123622},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3706":74021,"_31461":73960,"_21806":123624,"_5":15007,"_28616":123477,"_3094":123625},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3706":74022,"_31461":73960,"_21806":123627,"_5":15007,"_28616":123477,"_3094":123628},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3706":74023,"_31461":73960,"_21806":123630,"_5":15007,"_28616":123477,"_3094":123631},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3706":74024,"_31461":73960,"_21806":123633,"_5":15007,"_28616":123477,"_3094":123634},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3706":74025,"_31461":74025,"_5":15367,"_3094":123636,"_31820":123637,"_21806":123638,"_28616":74025},"Registros de auditoría",[51344,122764,122765],[],{"_3706":74026,"_31461":74025,"_21806":123640,"_5":15007,"_28616":74025,"_3094":123641},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3706":74027,"_31461":74025,"_5":31817,"_21806":123643,"_28616":123644,"_3094":123645},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3706":74028,"_31461":74025,"_5":31817,"_21806":123647,"_28616":123648,"_3094":123649},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3706":74029,"_31461":74025,"_5":31817,"_21806":123651,"_28616":123652,"_3094":123653},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3706":74030,"_31461":74025,"_5":31817,"_21806":123655,"_28616":123656,"_3094":123657},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3706":74031,"_31461":74025,"_5":31817,"_21806":123659,"_28616":123660,"_3094":123661},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3706":74032,"_31461":74025,"_5":31817,"_21806":123663,"_28616":123664,"_3094":123665},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3706":74033,"_31461":74025,"_5":31817,"_21806":123667,"_28616":123668,"_3094":123669},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3706":74034,"_31461":74025,"_5":31817,"_21806":123671,"_28616":123672,"_3094":123673},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3706":74035,"_31461":74025,"_5":31817,"_21806":123675,"_28616":123676,"_3094":123677},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3706":74036,"_31461":74025,"_5":31817,"_21806":123679,"_28616":123680,"_3094":123681},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3706":74037,"_31461":74025,"_5":31817,"_21806":123683,"_28616":123684,"_3094":123685},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3706":74038,"_31461":74025,"_21806":123687,"_5":15007,"_28616":74025,"_3094":123688},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3706":74039,"_31461":74025,"_21806":123690,"_5":15007,"_28616":123644,"_3094":123691},[],"El cuerpo de auditoría incluye:",{"_3706":74040,"_31461":74025,"_21806":123693,"_5":15007,"_28616":123644,"_3094":123694},[],"input: datos recibidos por la operación;",{"_3706":74041,"_31461":74025,"_21806":123696,"_5":15007,"_28616":123644,"_3094":123697},[],"has\\_error: indica si el servicio devolvió un error;",{"_3706":74042,"_31461":74025,"_21806":123699,"_5":15007,"_28616":123644,"_3094":123700},[],"output: resultado producido o mensaje de error;",{"_3706":74043,"_31461":74025,"_21806":123702,"_5":15007,"_28616":123644,"_3094":123703},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3706":74044,"_31461":74025,"_21806":123705,"_5":15007,"_28616":123644,"_3094":123706},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3706":74045,"_31461":74025,"_21806":123708,"_5":15007,"_28616":123644,"_3094":123709},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3706":74046,"_31461":74025,"_21806":123711,"_5":15007,"_28616":123648,"_3094":123712},[],"El backend aplica auditoría a mutaciones de:",{"_3706":74047,"_31461":74025,"_21806":123714,"_5":15007,"_28616":123648,"_3094":123715},[],"autoridades, certificados y perfiles de emisión;",{"_3706":74048,"_31461":74025,"_21806":123717,"_5":15007,"_28616":123648,"_3094":123718},[],"claves y motores KMS;",{"_3706":74049,"_31461":74025,"_21806":123720,"_5":15007,"_28616":123648,"_3094":123721},[],"dispositivos e identidades;",{"_3706":74050,"_31461":74025,"_21806":123723,"_5":15007,"_28616":123648,"_3094":123724},[],"DMS y operaciones de enrolamiento;",{"_3706":74051,"_31461":74025,"_21806":123726,"_5":15007,"_28616":123648,"_3094":123727},[],"funciones de validación y CRL;",{"_3706":74052,"_31461":74025,"_21806":123729,"_5":15007,"_28616":123648,"_3094":123730},[],"principales, políticas y concesiones de autorización.",{"_3706":74053,"_31461":74025,"_21806":123732,"_5":15007,"_28616":123648,"_3094":123733},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3706":74054,"_31461":74025,"_21806":123735,"_5":15007,"_28616":123652,"_3094":123736},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3706":74055,"_31461":74025,"_21806":123738,"_5":15007,"_28616":123652,"_3094":123739},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3706":74056,"_31461":74025,"_21806":123741,"_5":15007,"_28616":123652,"_3094":123742},[],"Diseña el consumidor para:",{"_3706":74057,"_31461":74025,"_21806":123744,"_5":15007,"_28616":123652,"_3094":123745},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3706":74058,"_31461":74025,"_21806":123747,"_5":15007,"_28616":123652,"_3094":123748},[],"conservar el CloudEvent completo sin modificar;",{"_3706":74059,"_31461":74025,"_21806":123750,"_5":15007,"_28616":123652,"_3094":123751},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3706":74060,"_31461":74025,"_21806":123753,"_5":15007,"_28616":123652,"_3094":123754},[],"cifrar en tránsito y en reposo;",{"_3706":74061,"_31461":74025,"_21806":123756,"_5":15007,"_28616":123652,"_3094":123757},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3706":74062,"_31461":74025,"_21806":123759,"_5":15007,"_28616":123652,"_3094":123760},[],"aplicar una política explícita de retención y legal hold;",{"_3706":74063,"_31461":74025,"_21806":123762,"_5":15007,"_28616":123652,"_3094":123763},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3706":74064,"_31461":74025,"_21806":123765,"_5":15007,"_28616":123656,"_3094":123766},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3706":74065,"_31461":74025,"_21806":123768,"_5":15007,"_28616":123656,"_3094":123769},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3706":74066,"_31461":74025,"_21806":123771,"_5":15007,"_28616":123664,"_3094":123772},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3706":74067,"_31461":74025,"_21806":123774,"_5":15007,"_28616":123668,"_3094":123775},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3706":74068,"_31461":74025,"_21806":123777,"_5":15007,"_28616":123672,"_3094":123778},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3706":74069,"_31461":74025,"_21806":123780,"_5":15007,"_28616":123676,"_3094":123781},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3706":74070,"_31461":74025,"_21806":123783,"_5":15007,"_28616":123680,"_3094":123784},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3706":74071,"_31461":74025,"_21806":123786,"_5":15007,"_28616":123684,"_3094":123787},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3706":74072,"_31461":74025,"_21806":123789,"_5":15007,"_28616":123684,"_3094":123790},[],"aparece un evento de auditoría correcto;",{"_3706":74073,"_31461":74025,"_21806":123792,"_5":15007,"_28616":123684,"_3094":123793},[],"el principal coincide con la identidad utilizada;",{"_3706":74074,"_31461":74025,"_21806":123795,"_5":15007,"_28616":123684,"_3094":123796},[],"el consumidor lo persiste una sola vez;",{"_3706":74075,"_31461":74025,"_21806":123798,"_5":15007,"_28616":123684,"_3094":123799},[],"puede recuperarse por recurso, actor y periodo;",{"_3706":74076,"_31461":74025,"_21806":123801,"_5":15007,"_28616":123684,"_3094":123802},[],"una interrupción del consumidor produce una alerta.",{"_3706":74077,"_31461":74025,"_21806":123804,"_5":15007,"_28616":123684,"_3094":123805},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3706":74078,"_31461":74078,"_5":15367,"_3094":123807,"_31820":123808,"_21806":123809,"_28616":74078},"Arquitectura de la plataforma",[51344,122764],[],{"_3706":74079,"_31461":74078,"_21806":123811,"_5":15007,"_28616":74078,"_3094":123812},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3706":74080,"_31461":74078,"_5":31817,"_21806":123814,"_28616":123815,"_3094":123816},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3706":74081,"_31461":74078,"_5":31817,"_21806":123818,"_28616":123819,"_3094":123820},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3706":74082,"_31461":74078,"_5":31817,"_21806":123822,"_28616":123823,"_3094":123824},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3706":74083,"_31461":74078,"_5":31817,"_21806":123826,"_28616":123827,"_3094":123828},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3706":74084,"_31461":74078,"_5":31817,"_21806":123830,"_28616":123831,"_3094":123832},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3706":74085,"_31461":74078,"_21806":123834,"_5":15007,"_28616":74078,"_3094":123835},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3706":74086,"_31461":74078,"_21806":123837,"_5":15007,"_28616":74078,"_3094":123838},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3706":74087,"_31461":74078,"_21806":123840,"_5":15007,"_28616":123815,"_3094":123841},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3706":74088,"_31461":74078,"_21806":123843,"_5":15007,"_28616":123819,"_3094":123844},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3706":74089,"_31461":74078,"_21806":123846,"_5":15007,"_28616":123823,"_3094":123847},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3706":74090,"_31461":74078,"_21806":123849,"_5":15007,"_28616":123827,"_3094":123850},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3706":74091,"_31461":74078,"_21806":123852,"_5":15007,"_28616":123831,"_3094":123853},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3706":74092,"_31461":74092,"_5":15367,"_3094":123855,"_31820":123856,"_21806":123857,"_28616":74092},"Cómo funciona Lamassu",[51344,122764],[],{"_3706":74093,"_31461":74092,"_21806":123859,"_5":15007,"_28616":74092,"_3094":123860},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3706":74094,"_31461":74092,"_5":31817,"_21806":123862,"_28616":123863,"_3094":123864},[],"/docs/pr-preview/pr-81/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3706":74095,"_31461":74092,"_5":31817,"_21806":123866,"_28616":123867,"_3094":123868},[],"/docs/pr-preview/pr-81/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3706":74096,"_31461":74092,"_21806":123870,"_5":15007,"_28616":74092,"_3094":123871},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3706":74097,"_31461":74092,"_21806":123873,"_5":15007,"_28616":123863,"_3094":123874},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3706":74098,"_31461":74092,"_21806":123876,"_5":15007,"_28616":123863,"_3094":123877},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3706":74099,"_31461":74092,"_21806":123879,"_5":15007,"_28616":123863,"_3094":123880},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3706":74100,"_31461":74092,"_21806":123882,"_5":15007,"_28616":123863,"_3094":123883},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3706":74101,"_31461":74092,"_21806":123885,"_5":15007,"_28616":123863,"_3094":123886},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3706":74102,"_31461":74092,"_21806":123888,"_5":15007,"_28616":123867,"_3094":123889},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3706":74103,"_31461":74092,"_21806":123891,"_5":15007,"_28616":123867,"_3094":123892},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3706":74104,"_31461":74092,"_21806":123894,"_5":15007,"_28616":123867,"_3094":123895},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3706":74105,"_31461":74092,"_21806":123897,"_5":15007,"_28616":123867,"_3094":123898},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3706":74106,"_31461":74092,"_21806":123900,"_5":15007,"_28616":123867,"_3094":123901},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3706":74107,"_31461":74092,"_21806":123903,"_5":15007,"_28616":123867,"_3094":123904},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3706":74108,"_31461":74092,"_21806":123906,"_5":15007,"_28616":123867,"_3094":123907},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3706":74109,"_31461":74109,"_5":15367,"_3094":123909,"_31820":123910,"_21806":123911,"_28616":74109},"Dispositivos e identidades",[51344,122764,54054,123909],[],{"_3706":74110,"_31461":74109,"_21806":123913,"_5":15007,"_28616":74109,"_3094":123914},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3706":74111,"_31461":74109,"_5":31817,"_21806":123916,"_28616":123917,"_3094":123918},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3706":74112,"_31461":74109,"_5":31817,"_21806":123920,"_28616":123921,"_3094":123922},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3706":74113,"_31461":74109,"_5":31817,"_21806":123924,"_28616":123925,"_3094":123926},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3706":74114,"_31461":74109,"_5":31817,"_21806":123928,"_28616":123929,"_3094":123930},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3706":74115,"_31461":74109,"_5":31817,"_21806":123932,"_28616":123933,"_3094":123934},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3706":74116,"_31461":74109,"_5":31817,"_21806":123936,"_28616":123937,"_3094":123938},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3706":74117,"_31461":74109,"_5":31817,"_21806":123940,"_28616":123941,"_3094":123942},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3706":74118,"_31461":74109,"_5":31817,"_21806":123944,"_28616":123945,"_3094":123946},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3706":74119,"_31461":74109,"_5":31817,"_21806":123948,"_28616":123949,"_3094":123950},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3706":74120,"_31461":74109,"_5":31817,"_21806":123952,"_28616":123953,"_3094":123954},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3706":74121,"_31461":74109,"_5":31817,"_21806":123956,"_28616":123957,"_3094":123958},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3706":74122,"_31461":74109,"_21806":123960,"_5":15007,"_28616":74109,"_3094":123961},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3706":74123,"_31461":74109,"_21806":123963,"_5":15007,"_28616":74109,"_3094":123964},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3706":74124,"_31461":74109,"_21806":123966,"_5":15007,"_28616":123917,"_3094":123967},[],"Vista operativa",{"_3706":74125,"_31461":74109,"_21806":123969,"_5":15007,"_28616":123917,"_3094":123970},[],"Interpretación",{"_3706":74126,"_31461":74109,"_21806":123972,"_5":15007,"_28616":123917,"_3094":54117},[],{"_3706":74127,"_31461":74109,"_21806":123974,"_5":15007,"_28616":123917,"_3094":123975},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3706":74128,"_31461":74109,"_21806":123977,"_5":15007,"_28616":123917,"_3094":54123},[],{"_3706":74129,"_31461":74109,"_21806":123979,"_5":15007,"_28616":123917,"_3094":123980},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3706":74130,"_31461":74109,"_21806":123982,"_5":15007,"_28616":123917,"_3094":54129},[],{"_3706":74131,"_31461":74109,"_21806":123984,"_5":15007,"_28616":123917,"_3094":123985},[],"La identidad está en la ventana operativa de renovación.",{"_3706":74132,"_31461":74109,"_21806":123987,"_5":15007,"_28616":123917,"_3094":54135},[],{"_3706":74133,"_31461":74109,"_21806":123989,"_5":15007,"_28616":123917,"_3094":123990},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3706":74134,"_31461":74109,"_21806":123992,"_5":15007,"_28616":123917,"_3094":54141},[],{"_3706":74135,"_31461":74109,"_21806":123994,"_5":15007,"_28616":123917,"_3094":123995},[],"La identidad ha vencido.",{"_3706":74136,"_31461":74109,"_21806":123997,"_5":15007,"_28616":123917,"_3094":54147},[],{"_3706":74137,"_31461":74109,"_21806":123999,"_5":15007,"_28616":123917,"_3094":124000},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3706":74138,"_31461":74109,"_21806":124002,"_5":15007,"_28616":123917,"_3094":54153},[],{"_3706":74139,"_31461":74109,"_21806":124004,"_5":15007,"_28616":123917,"_3094":124005},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3706":74140,"_31461":74109,"_21806":124007,"_5":15007,"_28616":123917,"_3094":124008},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3706":74141,"_31461":74109,"_21806":124010,"_5":15007,"_28616":123921,"_3094":124011},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3706":74142,"_31461":74109,"_21806":124013,"_5":15007,"_28616":123921,"_3094":124014},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3706":74143,"_31461":74109,"_21806":124016,"_5":15007,"_28616":123921,"_3094":124017},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. En el modo **Live**, sigue automáticamente los eventos nuevos y los cambios del dispositivo (como el estado o el propietario) sin recargar la página, y muestra un indicador **Connected** o **Disconnected**. Tras una interrupción se reconecta y recupera sin huecos ni duplicados, de modo que **Live** muestra el mismo contenido que una recarga de la página. Cuando las actualizaciones en vivo no pueden usarse — falta de permisos, dispositivo no encontrado o actualizaciones en vivo no habilitadas en el servidor —, la línea de tiempo muestra `Live updates unavailable: ...` con el motivo, y la navegación por el historial (**Load more**) sigue funcionando. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3706":74144,"_31461":74109,"_21806":124019,"_5":15007,"_28616":123921,"_3094":124020},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3706":74145,"_31461":74109,"_21806":124022,"_5":15007,"_28616":123925,"_3094":124023},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3706":74146,"_31461":74109,"_21806":124025,"_5":15007,"_28616":123929,"_3094":124026},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3706":74147,"_31461":74109,"_21806":124028,"_5":15007,"_28616":123933,"_3094":124029},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3706":74148,"_31461":74109,"_21806":124031,"_5":15007,"_28616":123937,"_3094":124032},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3706":74149,"_31461":74109,"_21806":124034,"_5":15007,"_28616":123941,"_3094":124035},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3706":74150,"_31461":74109,"_21806":124037,"_5":15007,"_28616":123941,"_3094":124038},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3706":74151,"_31461":74109,"_21806":124040,"_5":15007,"_28616":123945,"_3094":124041},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3706":74152,"_31461":74109,"_21806":124043,"_5":15007,"_28616":123945,"_3094":124044},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3706":74153,"_31461":74109,"_21806":124046,"_5":15007,"_28616":123945,"_3094":124047},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3706":74154,"_31461":74109,"_21806":124049,"_5":15007,"_28616":123945,"_3094":124050},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3706":74155,"_31461":74109,"_21806":124052,"_5":15007,"_28616":123945,"_3094":124053},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3706":74156,"_31461":74109,"_21806":124055,"_5":15007,"_28616":123945,"_3094":124056},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3706":74157,"_31461":74109,"_21806":124058,"_5":15007,"_28616":123949,"_3094":124059},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3706":74158,"_31461":74109,"_21806":124061,"_5":15007,"_28616":123949,"_3094":124062},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3706":74159,"_31461":74109,"_21806":124064,"_5":15007,"_28616":123949,"_3094":124065},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3706":74160,"_31461":74109,"_21806":124067,"_5":15007,"_28616":123953,"_3094":124068},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3706":74161,"_31461":74109,"_21806":124070,"_5":15007,"_28616":123953,"_3094":124071},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3706":74162,"_31461":74109,"_21806":124073,"_5":15007,"_28616":123953,"_3094":124074},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3706":74163,"_31461":74109,"_21806":124076,"_5":15007,"_28616":123953,"_3094":124077},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3706":74164,"_31461":74109,"_21806":124079,"_5":15007,"_28616":123957,"_3094":124080},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3706":74165,"_31461":74109,"_21806":124082,"_5":15007,"_28616":123957,"_3094":124083},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3706":74166,"_31461":74166,"_5":15367,"_3094":124085,"_31820":124086,"_21806":124088,"_28616":74166},"Identidad inicial y autenticación",[51344,122764,54054,123909,124087],"Enrolamiento con PKI",[],{"_3706":74167,"_31461":74166,"_21806":124090,"_5":15007,"_28616":74166,"_3094":124091},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3706":74168,"_31461":74166,"_5":31817,"_21806":124093,"_28616":124094,"_3094":124095},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3706":74169,"_31461":74166,"_5":31817,"_21806":124097,"_28616":124098,"_3094":124099},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3706":74170,"_31461":74166,"_5":31817,"_21806":124101,"_28616":124102,"_3094":124103},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3706":74171,"_31461":74166,"_5":31817,"_21806":124105,"_28616":124106,"_3094":124107},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3706":74172,"_31461":74166,"_5":31817,"_21806":124109,"_28616":124110,"_3094":124111},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3706":74173,"_31461":74166,"_21806":124113,"_5":15007,"_28616":74166,"_3094":124114},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3706":74174,"_31461":74166,"_21806":124116,"_5":15007,"_28616":124094,"_3094":124117},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3706":74175,"_31461":74166,"_21806":124119,"_5":15007,"_28616":124094,"_3094":124120},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3706":74176,"_31461":74166,"_21806":124122,"_5":15007,"_28616":124098,"_3094":124123},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3706":74177,"_31461":74166,"_21806":124125,"_5":15007,"_28616":124098,"_3094":124126},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3706":74178,"_31461":74166,"_21806":124128,"_5":15007,"_28616":124098,"_3094":124129},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3706":74179,"_31461":74166,"_21806":124131,"_5":15007,"_28616":124102,"_3094":124132},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3706":74180,"_31461":74166,"_21806":124134,"_5":15007,"_28616":124102,"_3094":124135},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3706":74181,"_31461":74166,"_21806":124137,"_5":15007,"_28616":124106,"_3094":124138},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3706":74182,"_31461":74166,"_21806":124140,"_5":15007,"_28616":124106,"_3094":124141},[],"Ejemplo de cuerpo:",{"_3706":74183,"_31461":74166,"_21806":124143,"_5":15007,"_28616":124106,"_3094":124144},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3706":74184,"_31461":74166,"_21806":124146,"_5":15007,"_28616":124106,"_3094":124147},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3706":74185,"_31461":74166,"_21806":124149,"_5":15007,"_28616":124106,"_3094":124150},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3706":74186,"_31461":74166,"_21806":124152,"_5":15007,"_28616":124106,"_3094":124153},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3706":74187,"_31461":74166,"_21806":124155,"_5":15007,"_28616":124110,"_3094":124156},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3706":74188,"_31461":74166,"_21806":124158,"_5":15007,"_28616":124110,"_3094":124159},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3706":74189,"_31461":74166,"_21806":124161,"_5":15007,"_28616":124110,"_3094":124162},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3706":74190,"_31461":74166,"_21806":124164,"_5":15007,"_28616":124110,"_3094":124165},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3706":74191,"_31461":74191,"_5":15367,"_3094":124167,"_31820":124168,"_21806":124169,"_28616":74191},"Configura y opera el DMS",[51344,122764,54054,123909,124087],[],{"_3706":74192,"_31461":74191,"_21806":124171,"_5":15007,"_28616":74191,"_3094":124172},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3706":74193,"_31461":74191,"_5":31817,"_21806":124174,"_28616":124175,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3706":74194,"_31461":74191,"_5":31817,"_21806":124177,"_28616":124178,"_3094":124179},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3706":74195,"_31461":74191,"_5":31817,"_21806":124181,"_28616":124182,"_3094":124183},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3706":74196,"_31461":74191,"_5":31817,"_21806":124185,"_28616":124186,"_3094":124187},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3706":74197,"_31461":74191,"_5":31817,"_21806":124189,"_28616":124190,"_3094":124191},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3706":74198,"_31461":74191,"_5":31817,"_21806":124193,"_28616":124194,"_3094":124195},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3706":74199,"_31461":74191,"_5":31817,"_21806":124197,"_28616":124198,"_3094":124199},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3706":74200,"_31461":74191,"_5":31817,"_21806":124201,"_28616":124202,"_3094":124203},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3706":74201,"_31461":74191,"_5":31817,"_21806":124205,"_28616":124206,"_3094":54358},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3706":74202,"_31461":74191,"_5":31817,"_21806":124208,"_28616":124209,"_3094":54362},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3706":74203,"_31461":74191,"_5":31817,"_21806":124211,"_28616":124212,"_3094":124213},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3706":74204,"_31461":74191,"_5":31817,"_21806":124215,"_28616":124216,"_3094":124217},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3706":74205,"_31461":74191,"_5":31817,"_21806":124219,"_28616":124220,"_3094":124221},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3706":74206,"_31461":74191,"_5":31817,"_21806":124223,"_28616":124224,"_3094":124225},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3706":74207,"_31461":74191,"_5":31817,"_21806":124227,"_28616":124228,"_3094":54382},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3706":74208,"_31461":74191,"_5":31817,"_21806":124230,"_28616":124231,"_3094":124232},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3706":74209,"_31461":74191,"_5":31817,"_21806":124234,"_28616":124235,"_3094":124236},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3706":74210,"_31461":74191,"_5":31817,"_21806":124238,"_28616":124239,"_3094":124240},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3706":74211,"_31461":74191,"_21806":124242,"_5":15007,"_28616":74191,"_3094":124243},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3706":74212,"_31461":74191,"_21806":124245,"_5":15007,"_28616":124175,"_3094":124246},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3706":74213,"_31461":74191,"_21806":124248,"_5":15007,"_28616":124175,"_3094":124249},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3706":74214,"_31461":74191,"_21806":124251,"_5":15007,"_28616":124182,"_3094":124252},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3706":74215,"_31461":74191,"_21806":124254,"_5":15007,"_28616":124186,"_3094":124255},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3706":74216,"_31461":74191,"_21806":124257,"_5":15007,"_28616":124190,"_3094":124258},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3706":74217,"_31461":74191,"_21806":124260,"_5":15007,"_28616":124194,"_3094":124261},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3706":74218,"_31461":74191,"_21806":124263,"_5":15007,"_28616":124198,"_3094":124264},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3706":74219,"_31461":74191,"_21806":124266,"_5":15007,"_28616":124206,"_3094":124267},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3706":74220,"_31461":74191,"_21806":124269,"_5":15007,"_28616":124206,"_3094":124270},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3706":74221,"_31461":74191,"_21806":124272,"_5":15007,"_28616":124209,"_3094":124273},[],"Campo de `settings.enrollment_settings`",{"_3706":74222,"_31461":74191,"_21806":124275,"_5":15007,"_28616":124209,"_3094":124276},[],"Decisión",{"_3706":74223,"_31461":74191,"_21806":124278,"_5":15007,"_28616":124209,"_3094":54433},[],{"_3706":74224,"_31461":74191,"_21806":124280,"_5":15007,"_28616":124209,"_3094":124281},[],"`EST_RFC7030` para estas operaciones.",{"_3706":74225,"_31461":74191,"_21806":124283,"_5":15007,"_28616":124209,"_3094":54439},[],{"_3706":74226,"_31461":74191,"_21806":124285,"_5":15007,"_28616":124209,"_3094":124286},[],"ID de la CA que firmará.",{"_3706":74227,"_31461":74191,"_21806":124288,"_5":15007,"_28616":124209,"_3094":54445},[],{"_3706":74228,"_31461":74191,"_21806":124290,"_5":15007,"_28616":124209,"_3094":124291},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3706":74229,"_31461":74191,"_21806":124293,"_5":15007,"_28616":124209,"_3094":54451},[],{"_3706":74230,"_31461":74191,"_21806":124295,"_5":15007,"_28616":124209,"_3094":124296},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3706":74231,"_31461":74191,"_21806":124298,"_5":15007,"_28616":124209,"_3094":54457},[],{"_3706":74232,"_31461":74191,"_21806":124300,"_5":15007,"_28616":124209,"_3094":124301},[],"Uno de los cuatro modos de autenticación.",{"_3706":74233,"_31461":74191,"_21806":124303,"_5":15007,"_28616":124209,"_3094":124304},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3706":74234,"_31461":74191,"_21806":124306,"_5":15007,"_28616":124212,"_3094":124307},[],"Los bloques son independientes:",{"_3706":74235,"_31461":74191,"_21806":124309,"_5":15007,"_28616":124212,"_3094":124310},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3706":74236,"_31461":74191,"_21806":124312,"_5":15007,"_28616":124212,"_3094":124313},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3706":74237,"_31461":74191,"_21806":124315,"_5":15007,"_28616":124212,"_3094":54475},[],{"_3706":74238,"_31461":74191,"_21806":124317,"_5":15007,"_28616":124212,"_3094":124318},[],"Control aplicado en la operación configurada",{"_3706":74239,"_31461":74191,"_21806":124320,"_5":15007,"_28616":124212,"_3094":54481},[],{"_3706":74240,"_31461":74191,"_21806":124322,"_5":15007,"_28616":124212,"_3094":124323},[],"Validación del certificado presentado.",{"_3706":74241,"_31461":74191,"_21806":124325,"_5":15007,"_28616":124212,"_3094":54487},[],{"_3706":74242,"_31461":74191,"_21806":124327,"_5":15007,"_28616":124212,"_3094":124328},[],"Autorización del webhook configurado.",{"_3706":74243,"_31461":74191,"_21806":124330,"_5":15007,"_28616":124212,"_3094":54493},[],{"_3706":74244,"_31461":74191,"_21806":124332,"_5":15007,"_28616":124212,"_3094":124333},[],"Validación del certificado y, después, aprobación del webhook.",{"_3706":74245,"_31461":74191,"_21806":124335,"_5":15007,"_28616":124212,"_3094":54499},[],{"_3706":74246,"_31461":74191,"_21806":124337,"_5":15007,"_28616":124212,"_3094":124338},[],"Sin autenticación del solicitante por el DMS.",{"_3706":74247,"_31461":74191,"_21806":124340,"_5":15007,"_28616":124212,"_3094":124341},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3706":74248,"_31461":74191,"_21806":124343,"_5":15007,"_28616":124212,"_3094":124344},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3706":74249,"_31461":74191,"_21806":124346,"_5":15007,"_28616":124212,"_3094":124347},[],"El editor de autenticación ofrece el interruptor **Allow certificates without revocation information** (`allow_unverifiable_revocation`, desactivado por defecto). Cuando está activado, se aceptan certificados — y CAs intermedias de la cadena — que Lamassu no gestiona y que no declaran ningún endpoint OCSP o CRL; las respuestas de revocación inaccesibles, obsoletas o no concluyentes se rechazan siempre. Mientras el interruptor esté activado, la consola muestra una alerta de aviso: **Revocation will not be verified** — un certificado revocado sin endpoint OCSP o CRL, y no gestionado por Lamassu, será aceptado, y esto se aplica también a las CAs intermedias de la cadena.",{"_3706":74250,"_31461":74191,"_21806":124349,"_5":15007,"_28616":124212,"_3094":124350},[],"El mismo interruptor se ofrece tanto en el editor de autenticación de enrolamiento como en el de reenrolamiento, y se almacena por bloque dentro de `est_rfc7030_settings.client_certificate_settings`; un DMS almacenado antes de que existiera el campo se carga con el interruptor desactivado. La consola también muestra una alerta de aviso siempre que una opción de autenticación esté en su estado inseguro — **Allow expired certificates** activado, **Allow expired renewal** activado o **Verify CSR signature** desactivado — y la nota de No authentication se presenta también como alerta de aviso.",{"_3706":74251,"_31461":74191,"_21806":124352,"_5":15007,"_28616":124212,"_3094":124353},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3706":74252,"_31461":74191,"_21806":124355,"_5":15007,"_28616":124212,"_3094":124356},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3706":74253,"_31461":74191,"_21806":124358,"_5":15007,"_28616":124212,"_3094":124359},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3706":74254,"_31461":74191,"_21806":124361,"_5":15007,"_28616":124216,"_3094":124362},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3706":74255,"_31461":74191,"_21806":124364,"_5":15007,"_28616":124216,"_3094":124365},[],"Campo de `external_webhook_settings`",{"_3706":74256,"_31461":74191,"_21806":124367,"_5":15007,"_28616":124216,"_3094":124276},[],{"_3706":74257,"_31461":74191,"_21806":124369,"_5":15007,"_28616":124216,"_3094":54534},[],{"_3706":74258,"_31461":74191,"_21806":124371,"_5":15007,"_28616":124216,"_3094":124372},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3706":74259,"_31461":74191,"_21806":124374,"_5":15007,"_28616":124216,"_3094":54540},[],{"_3706":74260,"_31461":74191,"_21806":124376,"_5":15007,"_28616":124216,"_3094":124377},[],"`POST` o `PUT`; `POST` por defecto.",{"_3706":74261,"_31461":74191,"_21806":124379,"_5":15007,"_28616":124216,"_3094":54546},[],{"_3706":74262,"_31461":74191,"_21806":124381,"_5":15007,"_28616":124216,"_3094":124382},[],"Etiqueta usada en los logs del servicio.",{"_3706":74263,"_31461":74191,"_21806":124384,"_5":15007,"_28616":124216,"_3094":54552},[],{"_3706":74264,"_31461":74191,"_21806":124386,"_5":15007,"_28616":124216,"_3094":124387},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3706":74265,"_31461":74191,"_21806":124389,"_5":15007,"_28616":124216,"_3094":54558},[],{"_3706":74266,"_31461":74191,"_21806":124391,"_5":15007,"_28616":124216,"_3094":124392},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3706":74267,"_31461":74191,"_21806":124394,"_5":15007,"_28616":124216,"_3094":54564},[],{"_3706":74268,"_31461":74191,"_21806":124396,"_5":15007,"_28616":124216,"_3094":124397},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3706":74269,"_31461":74191,"_21806":124399,"_5":15007,"_28616":124216,"_3094":54570},[],{"_3706":74270,"_31461":74191,"_21806":124401,"_5":15007,"_28616":124216,"_3094":124402},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3706":74271,"_31461":74191,"_21806":124404,"_5":15007,"_28616":124216,"_3094":54576},[],{"_3706":74272,"_31461":74191,"_21806":124406,"_5":15007,"_28616":124216,"_3094":124407},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3706":74273,"_31461":74191,"_21806":124409,"_5":15007,"_28616":124216,"_3094":54582},[],{"_3706":74274,"_31461":74191,"_21806":124411,"_5":15007,"_28616":124216,"_3094":124412},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3706":74275,"_31461":74191,"_21806":124414,"_5":15007,"_28616":124216,"_3094":54588},[],{"_3706":74276,"_31461":74191,"_21806":124416,"_5":15007,"_28616":124216,"_3094":124417},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3706":74277,"_31461":74191,"_21806":124419,"_5":15007,"_28616":124216,"_3094":124420},[],"Reglas de esa configuración:",{"_3706":74278,"_31461":74191,"_21806":124422,"_5":15007,"_28616":124216,"_3094":124423},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3706":74279,"_31461":74191,"_21806":124425,"_5":15007,"_28616":124216,"_3094":124426},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3706":74280,"_31461":74191,"_21806":124428,"_5":15007,"_28616":124216,"_3094":124429},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3706":74281,"_31461":74191,"_21806":124431,"_5":15007,"_28616":124216,"_3094":124432},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3706":74282,"_31461":74191,"_21806":124434,"_5":15007,"_28616":124216,"_3094":124435},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3706":74283,"_31461":74191,"_21806":124437,"_5":15007,"_28616":124216,"_3094":124438},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3706":74284,"_31461":74191,"_21806":124440,"_5":15007,"_28616":124216,"_3094":124441},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3706":74285,"_31461":74191,"_21806":124443,"_5":15007,"_28616":124216,"_3094":124444},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3706":74286,"_31461":74191,"_21806":124446,"_5":15007,"_28616":124216,"_3094":124447},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3706":74287,"_31461":74191,"_21806":124449,"_5":15007,"_28616":124220,"_3094":124450},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3706":74288,"_31461":74191,"_21806":124452,"_5":15007,"_28616":124224,"_3094":124453},[],"Campo de `settings.reenrollment_settings`",{"_3706":74289,"_31461":74191,"_21806":124455,"_5":15007,"_28616":124224,"_3094":124456},[],"Función",{"_3706":74290,"_31461":74191,"_21806":124458,"_5":15007,"_28616":124224,"_3094":54632},[],{"_3706":74291,"_31461":74191,"_21806":124460,"_5":15007,"_28616":124224,"_3094":124461},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3706":74292,"_31461":74191,"_21806":124463,"_5":15007,"_28616":124224,"_3094":54638},[],{"_3706":74293,"_31461":74191,"_21806":124465,"_5":15007,"_28616":124224,"_3094":124466},[],"Umbral operativo preventivo de monitorización.",{"_3706":74294,"_31461":74191,"_21806":124468,"_5":15007,"_28616":124224,"_3094":54644},[],{"_3706":74295,"_31461":74191,"_21806":124470,"_5":15007,"_28616":124224,"_3094":124471},[],"Umbral operativo crítico de monitorización.",{"_3706":74296,"_31461":74191,"_21806":124473,"_5":15007,"_28616":124224,"_3094":54650},[],{"_3706":74297,"_31461":74191,"_21806":124475,"_5":15007,"_28616":124224,"_3094":124476},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3706":74298,"_31461":74191,"_21806":124478,"_5":15007,"_28616":124224,"_3094":54656},[],{"_3706":74299,"_31461":74191,"_21806":124480,"_5":15007,"_28616":124224,"_3094":124481},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3706":74300,"_31461":74191,"_21806":124483,"_5":15007,"_28616":124224,"_3094":54662},[],{"_3706":74301,"_31461":74191,"_21806":124485,"_5":15007,"_28616":124224,"_3094":124486},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3706":74302,"_31461":74191,"_21806":124488,"_5":15007,"_28616":124224,"_3094":124489},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3706":74303,"_31461":74191,"_21806":124491,"_5":15007,"_28616":124228,"_3094":124492},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3706":74304,"_31461":74191,"_21806":124494,"_5":15007,"_28616":124231,"_3094":121636},[],{"_3706":74305,"_31461":74191,"_21806":124496,"_5":15007,"_28616":124231,"_3094":124497},[],"Qué publica",{"_3706":74306,"_31461":74191,"_21806":124499,"_5":15007,"_28616":124231,"_3094":54679},[],{"_3706":74307,"_31461":74191,"_21806":124501,"_5":15007,"_28616":124231,"_3094":124502},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3706":74308,"_31461":74191,"_21806":124504,"_5":15007,"_28616":124231,"_3094":54685},[],{"_3706":74309,"_31461":74191,"_21806":124506,"_5":15007,"_28616":124231,"_3094":124507},[],"Certificado de la CA emisora seleccionada.",{"_3706":74310,"_31461":74191,"_21806":124509,"_5":15007,"_28616":124231,"_3094":54691},[],{"_3706":74311,"_31461":74191,"_21806":124511,"_5":15007,"_28616":124231,"_3094":124512},[],"Certificados de las CAs elegidas explícitamente.",{"_3706":74312,"_31461":74191,"_21806":124514,"_5":15007,"_28616":124231,"_3094":124515},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3706":74313,"_31461":74191,"_21806":124517,"_5":15007,"_28616":124235,"_3094":124518},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3706":74314,"_31461":74191,"_21806":124520,"_5":15007,"_28616":124235,"_3094":124521},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3706":74315,"_31461":74191,"_21806":124523,"_5":15007,"_28616":124235,"_3094":124524},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3706":74316,"_31461":74191,"_21806":124526,"_5":15007,"_28616":124239,"_3094":124527},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3706":74317,"_31461":74317,"_5":15367,"_3094":124529,"_31820":124530,"_21806":124531,"_28616":74317},"Integra el cliente EST",[51344,122764,54054,123909,124087],[],{"_3706":74318,"_31461":74317,"_21806":124533,"_5":15007,"_28616":74317,"_3094":124534},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3706":74319,"_31461":74317,"_5":31817,"_21806":124536,"_28616":124537,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3706":74320,"_31461":74317,"_5":31817,"_21806":124539,"_28616":124540,"_3094":124541},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3706":74321,"_31461":74317,"_5":31817,"_21806":124543,"_28616":124544,"_3094":124545},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3706":74322,"_31461":74317,"_5":31817,"_21806":124547,"_28616":124548,"_3094":124549},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3706":74323,"_31461":74317,"_5":31817,"_21806":124551,"_28616":124552,"_3094":124553},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3706":74324,"_31461":74317,"_5":31817,"_21806":124555,"_28616":124556,"_3094":124557},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3706":74325,"_31461":74317,"_21806":124559,"_5":15007,"_28616":74317,"_3094":124560},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3706":74326,"_31461":74317,"_21806":124562,"_5":15007,"_28616":124537,"_3094":124563},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3706":74327,"_31461":74317,"_21806":124565,"_5":15007,"_28616":124537,"_3094":124566},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3706":74328,"_31461":74317,"_21806":124568,"_5":15007,"_28616":124537,"_3094":124569},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3706":74329,"_31461":74317,"_21806":124571,"_5":15007,"_28616":124540,"_3094":124572},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3706":74330,"_31461":74317,"_21806":124574,"_5":15007,"_28616":124540,"_3094":124575},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3706":74331,"_31461":74317,"_21806":124577,"_5":15007,"_28616":124544,"_3094":124578},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3706":74332,"_31461":74317,"_21806":124580,"_5":15007,"_28616":124544,"_3094":124581},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3706":74333,"_31461":74317,"_21806":124583,"_5":15007,"_28616":124548,"_3094":124584},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3706":74334,"_31461":74317,"_21806":124586,"_5":15007,"_28616":124548,"_3094":124587},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3706":74335,"_31461":74317,"_21806":124589,"_5":15007,"_28616":124552,"_3094":124590},[],"Para el caso de una raíz que emite directamente:",{"_3706":74336,"_31461":74317,"_21806":124592,"_5":15007,"_28616":124552,"_3094":124593},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3706":74337,"_31461":74317,"_21806":124595,"_5":15007,"_28616":124552,"_3094":124596},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3706":74338,"_31461":74317,"_21806":124598,"_5":15007,"_28616":124556,"_3094":124599},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3706":74339,"_31461":74339,"_5":15367,"_3094":124601,"_31820":124602,"_21806":124603,"_28616":74339},"Referencia EST",[51344,122764,54054,123909,124087],[],{"_3706":74340,"_31461":74339,"_21806":124605,"_5":15007,"_28616":74339,"_3094":124606},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3706":74341,"_31461":74339,"_5":31817,"_21806":124608,"_28616":124609,"_3094":124610},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3706":74342,"_31461":74339,"_5":31817,"_21806":124612,"_28616":124613,"_3094":23609},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3706":74343,"_31461":74339,"_5":31817,"_21806":124615,"_28616":124616,"_3094":27123},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3706":74344,"_31461":74339,"_5":31817,"_21806":124618,"_28616":124619,"_3094":27130},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3706":74345,"_31461":74339,"_5":31817,"_21806":124621,"_28616":124622,"_3094":26387},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3706":74346,"_31461":74339,"_5":31817,"_21806":124624,"_28616":124625,"_3094":124626},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3706":74347,"_31461":74339,"_5":31817,"_21806":124628,"_28616":124629,"_3094":124630},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3706":74348,"_31461":74339,"_5":31817,"_21806":124632,"_28616":124633,"_3094":124634},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3706":74349,"_31461":74339,"_21806":124636,"_5":15007,"_28616":74339,"_3094":124637},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3706":74350,"_31461":74339,"_21806":124639,"_5":15007,"_28616":124609,"_3094":124640},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3706":74351,"_31461":74339,"_21806":124642,"_5":15007,"_28616":124609,"_3094":122524},[],{"_3706":74352,"_31461":74339,"_21806":124644,"_5":15007,"_28616":124609,"_3094":124645},[],"Método",{"_3706":74353,"_31461":74339,"_21806":124647,"_5":15007,"_28616":124609,"_3094":124648},[],"Autenticación y condición",{"_3706":74354,"_31461":74339,"_21806":124650,"_5":15007,"_28616":124609,"_3094":54834},[],{"_3706":74355,"_31461":74339,"_21806":124652,"_5":15007,"_28616":124609,"_3094":54837},[],{"_3706":74356,"_31461":74339,"_21806":124654,"_5":15007,"_28616":124609,"_3094":124655},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3706":74357,"_31461":74339,"_21806":124657,"_5":15007,"_28616":124609,"_3094":54843},[],{"_3706":74358,"_31461":74339,"_21806":124659,"_5":15007,"_28616":124609,"_3094":54846},[],{"_3706":74359,"_31461":74339,"_21806":124661,"_5":15007,"_28616":124609,"_3094":124662},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3706":74360,"_31461":74339,"_21806":124664,"_5":15007,"_28616":124609,"_3094":54852},[],{"_3706":74361,"_31461":74339,"_21806":124666,"_5":15007,"_28616":124609,"_3094":54846},[],{"_3706":74362,"_31461":74339,"_21806":124668,"_5":15007,"_28616":124609,"_3094":124669},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3706":74363,"_31461":74339,"_21806":124671,"_5":15007,"_28616":124609,"_3094":54860},[],{"_3706":74364,"_31461":74339,"_21806":124673,"_5":15007,"_28616":124609,"_3094":54846},[],{"_3706":74365,"_31461":74339,"_21806":124675,"_5":15007,"_28616":124609,"_3094":124676},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3706":74366,"_31461":74339,"_21806":124678,"_5":15007,"_28616":124609,"_3094":124679},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3706":74367,"_31461":74339,"_21806":124681,"_5":15007,"_28616":124613,"_3094":124682},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3706":74368,"_31461":74339,"_21806":124684,"_5":15007,"_28616":124613,"_3094":124685},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3706":74369,"_31461":74339,"_21806":124687,"_5":15007,"_28616":124616,"_3094":124688},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3706":74370,"_31461":74339,"_21806":124690,"_5":15007,"_28616":124616,"_3094":124691},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3706":74371,"_31461":74339,"_21806":124693,"_5":15007,"_28616":124619,"_3094":124694},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3706":74372,"_31461":74339,"_21806":124696,"_5":15007,"_28616":124619,"_3094":124697},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3706":74373,"_31461":74339,"_21806":124699,"_5":15007,"_28616":124622,"_3094":124700},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3706":74374,"_31461":74339,"_21806":124702,"_5":15007,"_28616":124622,"_3094":124703},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3706":74375,"_31461":74339,"_21806":124705,"_5":15007,"_28616":124625,"_3094":124706},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3706":74376,"_31461":74339,"_21806":124708,"_5":15007,"_28616":124625,"_3094":124709},[],"Parte",{"_3706":74377,"_31461":74339,"_21806":124711,"_5":15007,"_28616":124625,"_3094":124712},[],"Contenido tras decodificar su Base64",{"_3706":74378,"_31461":74339,"_21806":124714,"_5":15007,"_28616":124625,"_3094":54904},[],{"_3706":74379,"_31461":74339,"_21806":124716,"_5":15007,"_28616":124625,"_3094":124717},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3706":74380,"_31461":74339,"_21806":124719,"_5":15007,"_28616":124625,"_3094":54910},[],{"_3706":74381,"_31461":74339,"_21806":124721,"_5":15007,"_28616":124625,"_3094":124722},[],"PKCS#7 DER con el certificado emitido.",{"_3706":74382,"_31461":74339,"_21806":124724,"_5":15007,"_28616":124625,"_3094":124725},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3706":74383,"_31461":74339,"_21806":124727,"_5":15007,"_28616":124629,"_3094":124728},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3706":74384,"_31461":74339,"_21806":124730,"_5":15007,"_28616":124629,"_3094":124731},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3706":74385,"_31461":74339,"_21806":124733,"_5":15007,"_28616":124629,"_3094":124734},[],"Convierte y comprueba el resultado:",{"_3706":74386,"_31461":74339,"_21806":124736,"_5":15007,"_28616":124629,"_3094":124737},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3706":74387,"_31461":74339,"_21806":124739,"_5":15007,"_28616":124633,"_3094":124740},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3706":74388,"_31461":74339,"_21806":124742,"_5":15007,"_28616":124633,"_3094":124743},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3706":74389,"_31461":74389,"_5":15367,"_3094":124087,"_31820":124745,"_21806":124746,"_28616":74389},[51344,122764,54054,123909,124087],[],{"_3706":74390,"_31461":74389,"_21806":124748,"_5":15007,"_28616":74389,"_3094":124749},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3706":74391,"_31461":74389,"_5":31817,"_21806":124751,"_28616":124752,"_3094":124753},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3706":74392,"_31461":74389,"_5":31817,"_21806":124755,"_28616":124756,"_3094":124757},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3706":74393,"_31461":74389,"_5":31817,"_21806":124759,"_28616":124760,"_3094":124761},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3706":74394,"_31461":74389,"_21806":124763,"_5":15007,"_28616":74389,"_3094":124764},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3706":74395,"_31461":74389,"_21806":124766,"_5":15007,"_28616":124752,"_3094":124767},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3706":74396,"_31461":74389,"_21806":124769,"_5":15007,"_28616":124752,"_3094":124770},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3706":74397,"_31461":74389,"_21806":124772,"_5":15007,"_28616":124752,"_3094":124773},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3706":74398,"_31461":74389,"_21806":124775,"_5":15007,"_28616":124752,"_3094":124776},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3706":74399,"_31461":74389,"_21806":124778,"_5":15007,"_28616":124752,"_3094":124779},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3706":74400,"_31461":74389,"_21806":124781,"_5":15007,"_28616":124752,"_3094":124782},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3706":74401,"_31461":74389,"_21806":124784,"_5":15007,"_28616":124756,"_3094":124785},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3706":74402,"_31461":74389,"_21806":124787,"_5":15007,"_28616":124756,"_3094":124788},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3706":74403,"_31461":74389,"_21806":124790,"_5":15007,"_28616":124756,"_3094":124791},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3706":74404,"_31461":74389,"_21806":124793,"_5":15007,"_28616":124756,"_3094":124794},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3706":74405,"_31461":74389,"_21806":124796,"_5":15007,"_28616":124760,"_3094":124797},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3706":74406,"_31461":74389,"_21806":124799,"_5":15007,"_28616":124760,"_3094":124800},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3706":74407,"_31461":74389,"_21806":124802,"_5":15007,"_28616":124760,"_3094":124803},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3706":74408,"_31461":74389,"_21806":124805,"_5":15007,"_28616":124760,"_3094":124806},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3706":74409,"_31461":74389,"_21806":124808,"_5":15007,"_28616":124760,"_3094":124809},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3706":74410,"_31461":74410,"_5":15367,"_3094":124811,"_31820":124812,"_21806":124813,"_28616":74410},"Estrategias de aprovisionamiento",[51344,122764,54054,123909,124087],[],{"_3706":74411,"_31461":74410,"_21806":124815,"_5":15007,"_28616":74410,"_3094":124816},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3706":74412,"_31461":74410,"_5":31817,"_21806":124818,"_28616":124819,"_3094":124820},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3706":74413,"_31461":74410,"_5":31817,"_21806":124822,"_28616":124823,"_3094":124824},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3706":74414,"_31461":74410,"_5":31817,"_21806":124826,"_28616":124827,"_3094":124828},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3706":74415,"_31461":74410,"_5":31817,"_21806":124830,"_28616":124831,"_3094":124832},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3706":74416,"_31461":74410,"_5":31817,"_21806":124834,"_28616":124835,"_3094":124836},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3706":74417,"_31461":74410,"_21806":124838,"_5":15007,"_28616":74410,"_3094":124839},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3706":74418,"_31461":74410,"_21806":124841,"_5":15007,"_28616":124819,"_3094":124842},[],"Recorrido",{"_3706":74419,"_31461":74410,"_21806":124844,"_5":15007,"_28616":124819,"_3094":124845},[],"Cuándo existe el dispositivo",{"_3706":74420,"_31461":74410,"_21806":124847,"_5":15007,"_28616":124819,"_3094":124848},[],"Qué compruebas",{"_3706":74421,"_31461":74410,"_21806":124850,"_5":15007,"_28616":124819,"_3094":124851},[],"Asignación manual",{"_3706":74422,"_31461":74410,"_21806":124853,"_5":15007,"_28616":124819,"_3094":124854},[],"El operador lo crea antes de asociar un certificado.",{"_3706":74423,"_31461":74410,"_21806":124856,"_5":15007,"_28616":124819,"_3094":124857},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3706":74424,"_31461":74410,"_21806":124859,"_5":15007,"_28616":124819,"_3094":124860},[],"EST con `JITP`",{"_3706":74425,"_31461":74410,"_21806":124862,"_5":15007,"_28616":124819,"_3094":124863},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3706":74426,"_31461":74410,"_21806":124865,"_5":15007,"_28616":124819,"_3094":124866},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3706":74427,"_31461":74410,"_21806":124868,"_5":15007,"_28616":124819,"_3094":124869},[],"EST con `PRE_REGISTRATION`",{"_3706":74428,"_31461":74410,"_21806":124871,"_5":15007,"_28616":124819,"_3094":124872},[],"Debe existir antes de `/simpleenroll`.",{"_3706":74429,"_31461":74410,"_21806":124874,"_5":15007,"_28616":124819,"_3094":124875},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3706":74430,"_31461":74410,"_21806":124877,"_5":15007,"_28616":124819,"_3094":124878},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3706":74431,"_31461":74410,"_21806":124880,"_5":15007,"_28616":124819,"_3094":124881},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3706":74432,"_31461":74410,"_21806":124883,"_5":15007,"_28616":124823,"_3094":124884},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3706":74433,"_31461":74410,"_21806":124886,"_5":15007,"_28616":124823,"_3094":124887},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3706":74434,"_31461":74410,"_21806":124889,"_5":15007,"_28616":124823,"_3094":124890},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3706":74435,"_31461":74410,"_21806":124892,"_5":15007,"_28616":124827,"_3094":124893},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3706":74436,"_31461":74410,"_21806":124895,"_5":15007,"_28616":124827,"_3094":124896},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3706":74437,"_31461":74410,"_21806":124898,"_5":15007,"_28616":124827,"_3094":124899},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3706":74438,"_31461":74410,"_21806":124901,"_5":15007,"_28616":124827,"_3094":124902},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3706":74439,"_31461":74410,"_21806":124904,"_5":15007,"_28616":124827,"_3094":124905},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3706":74440,"_31461":74410,"_21806":124907,"_5":15007,"_28616":124827,"_3094":124908},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3706":74441,"_31461":74410,"_21806":124910,"_5":15007,"_28616":124831,"_3094":121636},[],{"_3706":74442,"_31461":74410,"_21806":124912,"_5":15007,"_28616":124831,"_3094":124913},[],"Material que atraviesa EST",{"_3706":74443,"_31461":74410,"_21806":124915,"_5":15007,"_28616":124831,"_3094":124916},[],"Clave generada por el dispositivo",{"_3706":74444,"_31461":74410,"_21806":124918,"_5":15007,"_28616":124831,"_3094":124919},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3706":74445,"_31461":74410,"_21806":124921,"_5":15007,"_28616":124831,"_3094":124922},[],"Clave ya disponible en el dispositivo",{"_3706":74446,"_31461":74410,"_21806":124924,"_5":15007,"_28616":124831,"_3094":124925},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3706":74447,"_31461":74410,"_21806":124927,"_5":15007,"_28616":124831,"_3094":54382},[],{"_3706":74448,"_31461":74410,"_21806":124929,"_5":15007,"_28616":124831,"_3094":124930},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3706":74449,"_31461":74410,"_21806":124932,"_5":15007,"_28616":124831,"_3094":124933},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3706":74450,"_31461":74410,"_21806":124935,"_5":15007,"_28616":124835,"_3094":124936},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3706":74451,"_31461":74451,"_5":15367,"_3094":124938,"_31820":124939,"_21806":124940,"_28616":74451},"Renovación y recuperación",[51344,122764,54054,123909,124087],[],{"_3706":74452,"_31461":74451,"_21806":124942,"_5":15007,"_28616":74451,"_3094":124943},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3706":74453,"_31461":74451,"_5":31817,"_21806":124945,"_28616":124946,"_3094":124947},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3706":74454,"_31461":74451,"_5":31817,"_21806":124949,"_28616":124950,"_3094":124951},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3706":74455,"_31461":74451,"_5":31817,"_21806":124953,"_28616":124954,"_3094":124955},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3706":74456,"_31461":74451,"_5":31817,"_21806":124957,"_28616":124958,"_3094":124959},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3706":74457,"_31461":74451,"_5":31817,"_21806":124961,"_28616":124962,"_3094":124963},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3706":74458,"_31461":74451,"_21806":124965,"_5":15007,"_28616":74451,"_3094":124966},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3706":74459,"_31461":74451,"_21806":124968,"_5":15007,"_28616":124946,"_3094":124969},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3706":74460,"_31461":74451,"_21806":124971,"_5":15007,"_28616":124946,"_3094":124972},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3706":74461,"_31461":74451,"_21806":124974,"_5":15007,"_28616":124946,"_3094":124975},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3706":74462,"_31461":74451,"_21806":124977,"_5":15007,"_28616":124946,"_3094":124978},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3706":74463,"_31461":74451,"_21806":124980,"_5":15007,"_28616":124950,"_3094":124981},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3706":74464,"_31461":74451,"_21806":124983,"_5":15007,"_28616":124950,"_3094":124984},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3706":74465,"_31461":74451,"_21806":124986,"_5":15007,"_28616":124954,"_3094":124987},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3706":74466,"_31461":74451,"_21806":124989,"_5":15007,"_28616":124954,"_3094":124990},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3706":74467,"_31461":74451,"_21806":124992,"_5":15007,"_28616":124954,"_3094":124993},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3706":74468,"_31461":74451,"_21806":124995,"_5":15007,"_28616":124958,"_3094":124996},[],"Situación",{"_3706":74469,"_31461":74451,"_21806":124998,"_5":15007,"_28616":124958,"_3094":124999},[],"Procedimiento",{"_3706":74470,"_31461":74451,"_21806":125001,"_5":15007,"_28616":124958,"_3094":125002},[],"Certificado vigente, fuera de ventana",{"_3706":74471,"_31461":74451,"_21806":125004,"_5":15007,"_28616":124958,"_3094":125005},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3706":74472,"_31461":74451,"_21806":125007,"_5":15007,"_28616":124958,"_3094":125008},[],"Certificado vencido, clave disponible",{"_3706":74473,"_31461":74451,"_21806":125010,"_5":15007,"_28616":124958,"_3094":125011},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3706":74474,"_31461":74451,"_21806":125013,"_5":15007,"_28616":124958,"_3094":125014},[],"Renovación por webhook o `NO_AUTH`",{"_3706":74475,"_31461":74451,"_21806":125016,"_5":15007,"_28616":124958,"_3094":125017},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3706":74476,"_31461":74451,"_21806":125019,"_5":15007,"_28616":124958,"_3094":125020},[],"Clave perdida o inaccesible",{"_3706":74477,"_31461":74451,"_21806":125022,"_5":15007,"_28616":124958,"_3094":125023},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3706":74478,"_31461":74451,"_21806":125025,"_5":15007,"_28616":124958,"_3094":125026},[],"Identidad actual revocada",{"_3706":74479,"_31461":74451,"_21806":125028,"_5":15007,"_28616":124958,"_3094":125029},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3706":74480,"_31461":74451,"_21806":125031,"_5":15007,"_28616":124958,"_3094":125032},[],"Dispositivo sin identidad",{"_3706":74481,"_31461":74451,"_21806":125034,"_5":15007,"_28616":124958,"_3094":125035},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3706":74482,"_31461":74451,"_21806":125037,"_5":15007,"_28616":124958,"_3094":125038},[],"Dispositivo retirado",{"_3706":74483,"_31461":74451,"_21806":125040,"_5":15007,"_28616":124958,"_3094":125041},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3706":74484,"_31461":74451,"_21806":125043,"_5":15007,"_28616":124958,"_3094":125044},[],"Timeout, HTTP 500 o fallo de instalación",{"_3706":74485,"_31461":74451,"_21806":125046,"_5":15007,"_28616":124958,"_3094":125047},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3706":74486,"_31461":74451,"_21806":125049,"_5":15007,"_28616":124962,"_3094":125050},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3706":74487,"_31461":74451,"_21806":125052,"_5":15007,"_28616":124962,"_3094":125053},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3706":74488,"_31461":74488,"_5":15367,"_3094":125055,"_31820":125056,"_21806":125057,"_28616":74488},"Diagnóstico de enrolamiento",[51344,122764,54054,123909,124087],[],{"_3706":74489,"_31461":74488,"_21806":125059,"_5":15007,"_28616":74488,"_3094":125060},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3706":74490,"_31461":74488,"_5":31817,"_21806":125062,"_28616":125063,"_3094":125064},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3706":74491,"_31461":74488,"_5":31817,"_21806":125066,"_28616":125067,"_3094":125068},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3706":74492,"_31461":74488,"_5":31817,"_21806":125070,"_28616":125071,"_3094":124634},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3706":74493,"_31461":74488,"_5":31817,"_21806":125073,"_28616":125074,"_3094":125075},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3706":74494,"_31461":74488,"_21806":125077,"_5":15007,"_28616":74488,"_3094":125078},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3706":74495,"_31461":74488,"_21806":125080,"_5":15007,"_28616":125067,"_3094":125081},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3706":74496,"_31461":74488,"_21806":125083,"_5":15007,"_28616":125067,"_3094":125084},[],"Síntoma o mensaje",{"_3706":74497,"_31461":74488,"_21806":125086,"_5":15007,"_28616":125067,"_3094":125087},[],"Qué revisar",{"_3706":74498,"_31461":74488,"_21806":125089,"_5":15007,"_28616":125067,"_3094":125090},[],"curl rechaza TLS, nombre o emisor",{"_3706":74499,"_31461":74488,"_21806":125092,"_5":15007,"_28616":125067,"_3094":125093},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3706":74500,"_31461":74488,"_21806":125095,"_5":15007,"_28616":125067,"_3094":125096},[],"404 o APS ausente",{"_3706":74501,"_31461":74488,"_21806":125098,"_5":15007,"_28616":125067,"_3094":125099},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3706":74502,"_31461":74488,"_21806":125101,"_5":15007,"_28616":125067,"_3094":125102},[],"400, error de CSR o formato",{"_3706":74503,"_31461":74488,"_21806":125104,"_5":15007,"_28616":125067,"_3094":125105},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3706":74504,"_31461":74488,"_21806":125107,"_5":15007,"_28616":125067,"_3094":125108},[],"Credencial ausente o certificado no válido",{"_3706":74505,"_31461":74488,"_21806":125110,"_5":15007,"_28616":125067,"_3094":125111},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3706":74506,"_31461":74488,"_21806":125113,"_5":15007,"_28616":125067,"_3094":125114},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3706":74507,"_31461":74488,"_21806":125116,"_5":15007,"_28616":125067,"_3094":125117},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3706":74508,"_31461":74488,"_21806":125119,"_5":15007,"_28616":125067,"_3094":125120},[],"Webhook deniega, expira o responde sin autorización",{"_3706":74509,"_31461":74488,"_21806":125122,"_5":15007,"_28616":125067,"_3094":125123},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3706":74510,"_31461":74488,"_21806":125125,"_5":15007,"_28616":125067,"_3094":55316},[],{"_3706":74511,"_31461":74488,"_21806":125127,"_5":15007,"_28616":125067,"_3094":125128},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3706":74512,"_31461":74488,"_21806":125130,"_5":15007,"_28616":125067,"_3094":55322},[],{"_3706":74513,"_31461":74488,"_21806":125132,"_5":15007,"_28616":125067,"_3094":125133},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3706":74514,"_31461":74488,"_21806":125135,"_5":15007,"_28616":125067,"_3094":55328},[],{"_3706":74515,"_31461":74488,"_21806":125137,"_5":15007,"_28616":125067,"_3094":125138},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3706":74516,"_31461":74488,"_21806":125140,"_5":15007,"_28616":125067,"_3094":55334},[],{"_3706":74517,"_31461":74488,"_21806":125142,"_5":15007,"_28616":125067,"_3094":125143},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3706":74518,"_31461":74488,"_21806":125145,"_5":15007,"_28616":125067,"_3094":55340},[],{"_3706":74519,"_31461":74488,"_21806":125147,"_5":15007,"_28616":125067,"_3094":125148},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3706":74520,"_31461":74488,"_21806":125150,"_5":15007,"_28616":125067,"_3094":125151},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3706":74521,"_31461":74488,"_21806":125153,"_5":15007,"_28616":125067,"_3094":125154},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3706":74522,"_31461":74488,"_21806":125156,"_5":15007,"_28616":125067,"_3094":125157},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3706":74523,"_31461":74488,"_21806":125159,"_5":15007,"_28616":125067,"_3094":125160},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3706":74524,"_31461":74488,"_21806":125162,"_5":15007,"_28616":125067,"_3094":55358},[],{"_3706":74525,"_31461":74488,"_21806":125164,"_5":15007,"_28616":125067,"_3094":125165},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3706":74526,"_31461":74488,"_21806":125167,"_5":15007,"_28616":125067,"_3094":55364},[],{"_3706":74527,"_31461":74488,"_21806":125169,"_5":15007,"_28616":125067,"_3094":125170},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3706":74528,"_31461":74488,"_21806":125172,"_5":15007,"_28616":125067,"_3094":125173},[],"DMS propietario distinto",{"_3706":74529,"_31461":74488,"_21806":125175,"_5":15007,"_28616":125067,"_3094":125176},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3706":74530,"_31461":74488,"_21806":125178,"_5":15007,"_28616":125067,"_3094":55376},[],{"_3706":74531,"_31461":74488,"_21806":125180,"_5":15007,"_28616":125067,"_3094":125181},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3706":74532,"_31461":74488,"_21806":125183,"_5":15007,"_28616":125067,"_3094":55382},[],{"_3706":74533,"_31461":74488,"_21806":125185,"_5":15007,"_28616":125067,"_3094":125186},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3706":74534,"_31461":74488,"_21806":125188,"_5":15007,"_28616":125067,"_3094":125189},[],"Certificado actual revocado",{"_3706":74535,"_31461":74488,"_21806":125191,"_5":15007,"_28616":125067,"_3094":125192},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3706":74536,"_31461":74488,"_21806":125194,"_5":15007,"_28616":125067,"_3094":125195},[],"Error de CA, perfil o firma",{"_3706":74537,"_31461":74488,"_21806":125197,"_5":15007,"_28616":125067,"_3094":125198},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3706":74538,"_31461":74488,"_21806":125200,"_5":15007,"_28616":125067,"_3094":125201},[],"HTTP 200 sin conexión del dispositivo",{"_3706":74539,"_31461":74488,"_21806":125203,"_5":15007,"_28616":125067,"_3094":125204},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3706":74540,"_31461":74488,"_21806":125206,"_5":15007,"_28616":125067,"_3094":125207},[],"Timeout o error después de emitir",{"_3706":74541,"_31461":74488,"_21806":125209,"_5":15007,"_28616":125067,"_3094":125210},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3706":74542,"_31461":74488,"_21806":125212,"_5":15007,"_28616":125071,"_3094":125213},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3706":74543,"_31461":74488,"_21806":125215,"_5":15007,"_28616":125071,"_3094":125216},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3706":74544,"_31461":74488,"_21806":125218,"_5":15007,"_28616":125074,"_3094":125219},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3706":74545,"_31461":74488,"_21806":125221,"_5":15007,"_28616":125074,"_3094":125222},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3706":74546,"_31461":74488,"_21806":125224,"_5":15007,"_28616":125074,"_3094":125225},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3706":74547,"_31461":74488,"_21806":125227,"_5":15007,"_28616":125074,"_3094":125228},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3706":74548,"_31461":74488,"_21806":125230,"_5":15007,"_28616":125074,"_3094":125231},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3706":74549,"_31461":74488,"_21806":125233,"_5":15007,"_28616":125074,"_3094":125234},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3706":74550,"_31461":74488,"_21806":125236,"_5":15007,"_28616":125074,"_3094":125237},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3706":74551,"_31461":74551,"_5":15367,"_3094":125239,"_31820":125240,"_21806":125241,"_28616":74551},"Distribución y actualización de confianza",[51344,122764,54054,123909,124087],[],{"_3706":74552,"_31461":74551,"_21806":125243,"_5":15007,"_28616":74551,"_3094":125244},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3706":74553,"_31461":74551,"_5":31817,"_21806":125246,"_28616":125247,"_3094":125248},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3706":74554,"_31461":74551,"_5":31817,"_21806":125250,"_28616":125251,"_3094":125252},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3706":74555,"_31461":74551,"_5":31817,"_21806":125254,"_28616":125255,"_3094":125256},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3706":74556,"_31461":74551,"_5":31817,"_21806":125258,"_28616":125259,"_3094":125260},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3706":74557,"_31461":74551,"_5":31817,"_21806":125262,"_28616":125263,"_3094":125264},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3706":74558,"_31461":74551,"_21806":125266,"_5":15007,"_28616":74551,"_3094":125267},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3706":74559,"_31461":74551,"_21806":125269,"_5":15007,"_28616":125247,"_3094":125270},[],"Relación",{"_3706":74560,"_31461":74551,"_21806":125272,"_5":15007,"_28616":125247,"_3094":125273},[],"Material que prepara el responsable",{"_3706":74561,"_31461":74551,"_21806":125275,"_5":15007,"_28616":125247,"_3094":125276},[],"Dispositivo → servidor EST",{"_3706":74562,"_31461":74551,"_21806":125278,"_5":15007,"_28616":125247,"_3094":125279},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3706":74563,"_31461":74551,"_21806":125281,"_5":15007,"_28616":125247,"_3094":125282},[],"DMS → solicitante",{"_3706":74564,"_31461":74551,"_21806":125284,"_5":15007,"_28616":125247,"_3094":125285},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3706":74565,"_31461":74551,"_21806":125287,"_5":15007,"_28616":125247,"_3094":125288},[],"Consumidor → dispositivo",{"_3706":74566,"_31461":74551,"_21806":125290,"_5":15007,"_28616":125247,"_3094":125291},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3706":74567,"_31461":74551,"_21806":125293,"_5":15007,"_28616":125247,"_3094":125294},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3706":74568,"_31461":74551,"_21806":125296,"_5":15007,"_28616":125251,"_3094":125297},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3706":74569,"_31461":74551,"_21806":125299,"_5":15007,"_28616":125251,"_3094":125300},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3706":74570,"_31461":74551,"_21806":125302,"_5":15007,"_28616":125255,"_3094":125303},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3706":74571,"_31461":74551,"_21806":125305,"_5":15007,"_28616":125255,"_3094":125306},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3706":74572,"_31461":74551,"_21806":125308,"_5":15007,"_28616":125255,"_3094":125309},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3706":74573,"_31461":74551,"_21806":125311,"_5":15007,"_28616":125255,"_3094":125312},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3706":74574,"_31461":74551,"_21806":125314,"_5":15007,"_28616":125255,"_3094":125315},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3706":74575,"_31461":74551,"_21806":125317,"_5":15007,"_28616":125255,"_3094":125318},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3706":74576,"_31461":74551,"_21806":125320,"_5":15007,"_28616":125259,"_3094":125321},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3706":74577,"_31461":74551,"_21806":125323,"_5":15007,"_28616":125259,"_3094":125324},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3706":74578,"_31461":74551,"_21806":125326,"_5":15007,"_28616":125259,"_3094":125327},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3706":74579,"_31461":74551,"_21806":125329,"_5":15007,"_28616":125263,"_3094":125330},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3706":74580,"_31461":74580,"_5":15367,"_3094":55531,"_31820":125332,"_21806":125334,"_28616":74580},[51344,122764,54054,123909,125333],"Integraciones",[],{"_3706":74581,"_31461":74580,"_21806":125336,"_5":15007,"_28616":74580,"_3094":125337},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3706":74582,"_31461":74580,"_5":31817,"_21806":125339,"_28616":125340,"_3094":125341},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3706":74583,"_31461":74580,"_5":31817,"_21806":125343,"_28616":125344,"_3094":125345},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3706":74584,"_31461":74580,"_5":31817,"_21806":125347,"_28616":125348,"_3094":125349},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3706":74585,"_31461":74580,"_5":31817,"_21806":125351,"_28616":125352,"_3094":125353},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3706":74586,"_31461":74580,"_5":31817,"_21806":125355,"_28616":125356,"_3094":125357},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3706":74587,"_31461":74580,"_5":31817,"_21806":125359,"_28616":125360,"_3094":125361},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3706":74588,"_31461":74580,"_5":31817,"_21806":125363,"_28616":125364,"_3094":125365},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3706":74589,"_31461":74580,"_5":31817,"_21806":125367,"_28616":125368,"_3094":125369},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3706":74590,"_31461":74580,"_5":31817,"_21806":125371,"_28616":125372,"_3094":55573},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3706":74591,"_31461":74580,"_5":31817,"_21806":125374,"_28616":125375,"_3094":55577},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3706":74592,"_31461":74580,"_5":31817,"_21806":125377,"_28616":125378,"_3094":125379},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3706":74593,"_31461":74580,"_5":31817,"_21806":125381,"_28616":125382,"_3094":125383},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3706":74594,"_31461":74580,"_5":31817,"_21806":125385,"_28616":125386,"_3094":125387},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3706":74595,"_31461":74580,"_5":31817,"_21806":125389,"_28616":125390,"_3094":125391},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3706":74596,"_31461":74580,"_5":31817,"_21806":125393,"_28616":125394,"_3094":125395},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3706":74597,"_31461":74580,"_5":31817,"_21806":125397,"_28616":125398,"_3094":125399},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3706":74598,"_31461":74580,"_5":31817,"_21806":125401,"_28616":125402,"_3094":125403},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3706":74599,"_31461":74580,"_5":31817,"_21806":125405,"_28616":125406,"_3094":125407},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3706":74600,"_31461":74580,"_5":31817,"_21806":125409,"_28616":125410,"_3094":125411},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3706":74601,"_31461":74580,"_5":31817,"_21806":125413,"_28616":125414,"_3094":125415},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3706":74602,"_31461":74580,"_5":31817,"_21806":125417,"_28616":125418,"_3094":125419},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3706":74603,"_31461":74580,"_5":31817,"_21806":125421,"_28616":125422,"_3094":125423},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3706":74604,"_31461":74580,"_5":31817,"_21806":125425,"_28616":125426,"_3094":125427},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3706":74605,"_31461":74580,"_5":31817,"_21806":125429,"_28616":125430,"_3094":125431},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3706":74606,"_31461":74580,"_5":31817,"_21806":125433,"_28616":125434,"_3094":125435},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3706":74607,"_31461":74580,"_21806":125437,"_5":15007,"_28616":74580,"_3094":125438},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3706":74608,"_31461":74580,"_21806":125440,"_5":15007,"_28616":74580,"_3094":125441},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3706":74609,"_31461":74580,"_21806":125443,"_5":15007,"_28616":74580,"_3094":125444},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3706":74610,"_31461":74580,"_21806":125446,"_5":15007,"_28616":125340,"_3094":125447},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3706":74611,"_31461":74580,"_21806":125449,"_5":15007,"_28616":125340,"_3094":125450},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3706":74612,"_31461":74580,"_21806":125452,"_5":15007,"_28616":125340,"_3094":125453},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3706":74613,"_31461":74580,"_21806":125455,"_5":15007,"_28616":125340,"_3094":125456},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3706":74614,"_31461":74580,"_21806":125458,"_5":15007,"_28616":125344,"_3094":125459},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3706":74615,"_31461":74580,"_21806":125461,"_5":15007,"_28616":125348,"_3094":125462},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3706":74616,"_31461":74580,"_21806":125464,"_5":15007,"_28616":125348,"_3094":125465},[],"Acción IAM",{"_3706":74617,"_31461":74580,"_21806":125467,"_5":15007,"_28616":125348,"_3094":121642},[],{"_3706":74618,"_31461":74580,"_21806":125469,"_5":15007,"_28616":125348,"_3094":55672},[],{"_3706":74619,"_31461":74580,"_21806":125471,"_5":15007,"_28616":125348,"_3094":125472},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3706":74620,"_31461":74580,"_21806":125474,"_5":15007,"_28616":125348,"_3094":55678},[],{"_3706":74621,"_31461":74580,"_21806":125476,"_5":15007,"_28616":125348,"_3094":125477},[],"Registrar la CA en AWS IoT",{"_3706":74622,"_31461":74580,"_21806":125479,"_5":15007,"_28616":125348,"_3094":55684},[],{"_3706":74623,"_31461":74580,"_21806":125481,"_5":15007,"_28616":125348,"_3094":125482},[],"Consultar el estado del registro de la CA",{"_3706":74624,"_31461":74580,"_21806":125484,"_5":15007,"_28616":125348,"_3094":55690},[],{"_3706":74625,"_31461":74580,"_21806":125486,"_5":15007,"_28616":125348,"_3094":125487},[],"Crear o actualizar Things en IoT Core",{"_3706":74626,"_31461":74580,"_21806":125489,"_5":15007,"_28616":125348,"_3094":55696},[],{"_3706":74627,"_31461":74580,"_21806":125491,"_5":15007,"_28616":125348,"_3094":125492},[],"Aprovisionar Things mediante plantilla",{"_3706":74628,"_31461":74580,"_21806":125494,"_5":15007,"_28616":125348,"_3094":55702},[],{"_3706":74629,"_31461":74580,"_21806":125496,"_5":15007,"_28616":125348,"_3094":125497},[],"Registrar certificados de dispositivo",{"_3706":74630,"_31461":74580,"_21806":125499,"_5":15007,"_28616":125348,"_3094":55708},[],{"_3706":74631,"_31461":74580,"_21806":125501,"_5":15007,"_28616":125348,"_3094":125502},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3706":74632,"_31461":74580,"_21806":125504,"_5":15007,"_28616":125348,"_3094":55714},[],{"_3706":74633,"_31461":74580,"_21806":125506,"_5":15007,"_28616":125348,"_3094":125507},[],"Crear y adjuntar políticas IoT",{"_3706":74634,"_31461":74580,"_21806":125509,"_5":15007,"_28616":125348,"_3094":55720},[],{"_3706":74635,"_31461":74580,"_21806":125511,"_5":15007,"_28616":125348,"_3094":125512},[],"Gestionar grupos de Things",{"_3706":74636,"_31461":74580,"_21806":125514,"_5":15007,"_28616":125348,"_3094":55726},[],{"_3706":74637,"_31461":74580,"_21806":125516,"_5":15007,"_28616":125348,"_3094":125517},[],"Crear plantillas JITP",{"_3706":74638,"_31461":74580,"_21806":125519,"_5":15007,"_28616":125348,"_3094":55732},[],{"_3706":74639,"_31461":74580,"_21806":125521,"_5":15007,"_28616":125348,"_3094":125522},[],"Leer y escribir el Device Shadow",{"_3706":74640,"_31461":74580,"_21806":125524,"_5":15007,"_28616":125348,"_3094":125525},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3706":74641,"_31461":74580,"_21806":125527,"_5":15007,"_28616":125352,"_3094":125528},[],"Parámetro",{"_3706":74642,"_31461":74580,"_21806":125530,"_5":15007,"_28616":125352,"_3094":125531},[],"Tipo",{"_3706":74643,"_31461":74580,"_21806":125533,"_5":15007,"_28616":125352,"_3094":125534},[],"Requerido",{"_3706":74644,"_31461":74580,"_21806":125536,"_5":15007,"_28616":125352,"_3094":125537},[],"Descripción",{"_3706":74645,"_31461":74580,"_21806":125539,"_5":15007,"_28616":125352,"_3094":55753},[],{"_3706":74646,"_31461":74580,"_21806":125541,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74647,"_31461":74580,"_21806":125543,"_5":15007,"_28616":125352,"_3094":125544},[],"Sí",{"_3706":74648,"_31461":74580,"_21806":125546,"_5":15007,"_28616":125352,"_3094":125547},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3706":74649,"_31461":74580,"_21806":125549,"_5":15007,"_28616":125352,"_3094":55764},[],{"_3706":74650,"_31461":74580,"_21806":125551,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74651,"_31461":74580,"_21806":125553,"_5":15007,"_28616":125352,"_3094":125544},[],{"_3706":74652,"_31461":74580,"_21806":125555,"_5":15007,"_28616":125352,"_3094":125556},[],"Región AWS donde opera el conector.",{"_3706":74653,"_31461":74580,"_21806":125558,"_5":15007,"_28616":125352,"_3094":55774},[],{"_3706":74654,"_31461":74580,"_21806":125560,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74655,"_31461":74580,"_21806":125562,"_5":15007,"_28616":125352,"_3094":125544},[],{"_3706":74656,"_31461":74580,"_21806":125564,"_5":15007,"_28616":125352,"_3094":125565},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3706":74657,"_31461":74580,"_21806":125567,"_5":15007,"_28616":125352,"_3094":55784},[],{"_3706":74658,"_31461":74580,"_21806":125569,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74659,"_31461":74580,"_21806":125571,"_5":15007,"_28616":125352,"_3094":125572},[],"Solo con `auth_method=static`",{"_3706":74660,"_31461":74580,"_21806":125574,"_5":15007,"_28616":125352,"_3094":125575},[],"Clave de acceso AWS.",{"_3706":74661,"_31461":74580,"_21806":125577,"_5":15007,"_28616":125352,"_3094":55795},[],{"_3706":74662,"_31461":74580,"_21806":125579,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74663,"_31461":74580,"_21806":125581,"_5":15007,"_28616":125352,"_3094":125572},[],{"_3706":74664,"_31461":74580,"_21806":125583,"_5":15007,"_28616":125352,"_3094":125584},[],"Clave secreta AWS.",{"_3706":74665,"_31461":74580,"_21806":125586,"_5":15007,"_28616":125352,"_3094":55805},[],{"_3706":74666,"_31461":74580,"_21806":125588,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74667,"_31461":74580,"_21806":125590,"_5":15007,"_28616":125352,"_3094":55810},[],{"_3706":74668,"_31461":74580,"_21806":125592,"_5":15007,"_28616":125352,"_3094":125593},[],"Token de sesión (con `auth_method=static`).",{"_3706":74669,"_31461":74580,"_21806":125595,"_5":15007,"_28616":125352,"_3094":55816},[],{"_3706":74670,"_31461":74580,"_21806":125597,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74671,"_31461":74580,"_21806":125599,"_5":15007,"_28616":125352,"_3094":125600},[],"Solo con `auth_method=role`",{"_3706":74672,"_31461":74580,"_21806":125602,"_5":15007,"_28616":125352,"_3094":125603},[],"ARN del rol a asumir.",{"_3706":74673,"_31461":74580,"_21806":125605,"_5":15007,"_28616":125352,"_3094":55827},[],{"_3706":74674,"_31461":74580,"_21806":125607,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74675,"_31461":74580,"_21806":125609,"_5":15007,"_28616":125352,"_3094":55810},[],{"_3706":74676,"_31461":74580,"_21806":125611,"_5":15007,"_28616":125352,"_3094":125612},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3706":74677,"_31461":74580,"_21806":125614,"_5":15007,"_28616":125352,"_3094":55837},[],{"_3706":74678,"_31461":74580,"_21806":125616,"_5":15007,"_28616":125352,"_3094":93653},[],{"_3706":74679,"_31461":74580,"_21806":125618,"_5":15007,"_28616":125352,"_3094":125544},[],{"_3706":74680,"_31461":74580,"_21806":125620,"_5":15007,"_28616":125352,"_3094":125621},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3706":74681,"_31461":74580,"_21806":125623,"_5":15007,"_28616":125352,"_3094":55847},[],{"_3706":74682,"_31461":74580,"_21806":125625,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74683,"_31461":74580,"_21806":125627,"_5":15007,"_28616":125352,"_3094":125544},[],{"_3706":74684,"_31461":74580,"_21806":125629,"_5":15007,"_28616":125352,"_3094":125630},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3706":74685,"_31461":74580,"_21806":125632,"_5":15007,"_28616":125352,"_3094":55857},[],{"_3706":74686,"_31461":74580,"_21806":125634,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74687,"_31461":74580,"_21806":125636,"_5":15007,"_28616":125352,"_3094":125544},[],{"_3706":74688,"_31461":74580,"_21806":125638,"_5":15007,"_28616":125352,"_3094":125639},[],"URL HTTP del Device Manager de Lamassu.",{"_3706":74689,"_31461":74580,"_21806":125641,"_5":15007,"_28616":125352,"_3094":55867},[],{"_3706":74690,"_31461":74580,"_21806":125643,"_5":15007,"_28616":125352,"_3094":26007},[],{"_3706":74691,"_31461":74580,"_21806":125645,"_5":15007,"_28616":125352,"_3094":125544},[],{"_3706":74692,"_31461":74580,"_21806":125647,"_5":15007,"_28616":125352,"_3094":125648},[],"URL HTTP del servicio de CA de Lamassu.",{"_3706":74693,"_31461":74580,"_21806":125650,"_5":15007,"_28616":125356,"_3094":125651},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3706":74694,"_31461":74580,"_21806":125653,"_5":15007,"_28616":125356,"_3094":125654},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3706":74695,"_31461":74580,"_21806":125656,"_5":15007,"_28616":125356,"_3094":125657},[],"Tipo de CloudEvent",{"_3706":74696,"_31461":74580,"_21806":125659,"_5":15007,"_28616":125356,"_3094":125660},[],"Recurso en Lamassu",{"_3706":74697,"_31461":74580,"_21806":125662,"_5":15007,"_28616":125356,"_3094":125663},[],"Recurso AWS",{"_3706":74698,"_31461":74580,"_21806":125665,"_5":15007,"_28616":125356,"_3094":125666},[],"Acciones IAM",{"_3706":74699,"_31461":74580,"_21806":125668,"_5":15007,"_28616":125356,"_3094":125669},[],"Llamadas AWS y efecto",{"_3706":74700,"_31461":74580,"_21806":125671,"_5":15007,"_28616":125356,"_3094":125672},[],"Dónde en esta página",{"_3706":74701,"_31461":74580,"_21806":125674,"_5":15007,"_28616":125356,"_3094":55901},[],{"_3706":74702,"_31461":74580,"_21806":125676,"_5":15007,"_28616":125356,"_3094":55904},[],{"_3706":74703,"_31461":74580,"_21806":125678,"_5":15007,"_28616":125356,"_3094":55907},[],{"_3706":74704,"_31461":74580,"_21806":125680,"_5":15007,"_28616":125356,"_3094":55910},[],{"_3706":74705,"_31461":74580,"_21806":125682,"_5":15007,"_28616":125356,"_3094":125683},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3706":74706,"_31461":74580,"_21806":125685,"_5":15007,"_28616":125356,"_3094":125369},[],{"_3706":74707,"_31461":74580,"_21806":125687,"_5":15007,"_28616":125356,"_3094":55918},[],{"_3706":74708,"_31461":74580,"_21806":125689,"_5":15007,"_28616":125356,"_3094":55921},[],{"_3706":74709,"_31461":74580,"_21806":125691,"_5":15007,"_28616":125356,"_3094":55924},[],{"_3706":74710,"_31461":74580,"_21806":125693,"_5":15007,"_28616":125356,"_3094":55927},[],{"_3706":74711,"_31461":74580,"_21806":125695,"_5":15007,"_28616":125356,"_3094":125696},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3706":74712,"_31461":74580,"_21806":125698,"_5":15007,"_28616":125356,"_3094":125395},[],{"_3706":74713,"_31461":74580,"_21806":125700,"_5":15007,"_28616":125356,"_3094":55935},[],{"_3706":74714,"_31461":74580,"_21806":125702,"_5":15007,"_28616":125356,"_3094":125703},[],"Dispositivo",{"_3706":74715,"_31461":74580,"_21806":125705,"_5":15007,"_28616":125356,"_3094":55941},[],{"_3706":74716,"_31461":74580,"_21806":125707,"_5":15007,"_28616":125356,"_3094":55944},[],{"_3706":74717,"_31461":74580,"_21806":125709,"_5":15007,"_28616":125356,"_3094":125710},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3706":74718,"_31461":74580,"_21806":125712,"_5":15007,"_28616":125356,"_3094":125403},[],{"_3706":74719,"_31461":74580,"_21806":125714,"_5":15007,"_28616":125356,"_3094":55952},[],{"_3706":74720,"_31461":74580,"_21806":125716,"_5":15007,"_28616":125356,"_3094":125717},[],"Certificado",{"_3706":74721,"_31461":74580,"_21806":125719,"_5":15007,"_28616":125356,"_3094":55958},[],{"_3706":74722,"_31461":74580,"_21806":125721,"_5":15007,"_28616":125356,"_3094":125722},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3706":74723,"_31461":74580,"_21806":125724,"_5":15007,"_28616":125356,"_3094":125725},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3706":74724,"_31461":74580,"_21806":125727,"_5":15007,"_28616":125356,"_3094":125415},[],{"_3706":74725,"_31461":74580,"_21806":125729,"_5":15007,"_28616":125356,"_3094":55969},[],{"_3706":74726,"_31461":74580,"_21806":125731,"_5":15007,"_28616":125356,"_3094":125732},[],"Certificado / Dispositivo",{"_3706":74727,"_31461":74580,"_21806":125734,"_5":15007,"_28616":125356,"_3094":55975},[],{"_3706":74728,"_31461":74580,"_21806":125736,"_5":15007,"_28616":125356,"_3094":51740},[],{"_3706":74729,"_31461":74580,"_21806":125738,"_5":15007,"_28616":125356,"_3094":125739},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3706":74730,"_31461":74580,"_21806":125741,"_5":15007,"_28616":125356,"_3094":125423},[],{"_3706":74731,"_31461":74580,"_21806":125743,"_5":15007,"_28616":125360,"_3094":125744},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3706":74732,"_31461":74580,"_21806":125746,"_5":15007,"_28616":125364,"_3094":125747},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3706":74733,"_31461":74580,"_21806":125749,"_5":15007,"_28616":125364,"_3094":125750},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3706":74734,"_31461":74580,"_21806":125752,"_5":15007,"_28616":125368,"_3094":125753},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3706":74735,"_31461":74580,"_21806":125755,"_5":15007,"_28616":125368,"_3094":125756},[],"Transición",{"_3706":74736,"_31461":74580,"_21806":125758,"_5":15007,"_28616":125368,"_3094":125759},[],"Llamadas AWS",{"_3706":74737,"_31461":74580,"_21806":125761,"_5":15007,"_28616":125368,"_3094":125762},[],"`NoRegistrada` → `Solicitada`",{"_3706":74738,"_31461":74580,"_21806":125764,"_5":15007,"_28616":125368,"_3094":125765},[],"ninguna (solo escritura de metadatos)",{"_3706":74739,"_31461":74580,"_21806":125767,"_5":15007,"_28616":125368,"_3094":125768},[],"`Solicitada` → `Registrando`",{"_3706":74740,"_31461":74580,"_21806":125770,"_5":15007,"_28616":125368,"_3094":125771},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3706":74741,"_31461":74580,"_21806":125773,"_5":15007,"_28616":125368,"_3094":125774},[],"`Registrando` → `Completada`",{"_3706":74742,"_31461":74580,"_21806":125776,"_5":15007,"_28616":125368,"_3094":125777},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3706":74743,"_31461":74580,"_21806":125779,"_5":15007,"_28616":125368,"_3094":125780},[],"`Registrando` → `Fallida`",{"_3706":74744,"_31461":74580,"_21806":125782,"_5":15007,"_28616":125368,"_3094":125783},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3706":74745,"_31461":74580,"_21806":125785,"_5":15007,"_28616":125368,"_3094":125786},[],"`Fallida` / `Completada` → `Solicitada`",{"_3706":74746,"_31461":74580,"_21806":125788,"_5":15007,"_28616":125368,"_3094":125789},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3706":74747,"_31461":74580,"_21806":125791,"_5":15007,"_28616":125372,"_3094":125792},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3706":74748,"_31461":74580,"_21806":125794,"_5":15007,"_28616":125372,"_3094":125795},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3706":74749,"_31461":74580,"_21806":125797,"_5":15007,"_28616":125372,"_3094":125798},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3706":74750,"_31461":74580,"_21806":125800,"_5":15007,"_28616":125372,"_3094":125801},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3706":74751,"_31461":74580,"_21806":125803,"_5":15007,"_28616":125372,"_3094":125804},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3706":74752,"_31461":74580,"_21806":125806,"_5":15007,"_28616":125372,"_3094":125807},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3706":74753,"_31461":74580,"_21806":125809,"_5":15007,"_28616":125375,"_3094":125810},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3706":74754,"_31461":74580,"_21806":125812,"_5":15007,"_28616":125378,"_3094":125813},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3706":74755,"_31461":74580,"_21806":125815,"_5":15007,"_28616":125378,"_3094":125816},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3706":74756,"_31461":74580,"_21806":125818,"_5":15007,"_28616":125382,"_3094":125819},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3706":74757,"_31461":74580,"_21806":125821,"_5":15007,"_28616":125386,"_3094":125822},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3706":74758,"_31461":74580,"_21806":125824,"_5":15007,"_28616":125386,"_3094":125825},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3706":74759,"_31461":74580,"_21806":125827,"_5":15007,"_28616":125386,"_3094":125828},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3706":74760,"_31461":74580,"_21806":125830,"_5":15007,"_28616":125386,"_3094":125831},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3706":74761,"_31461":74580,"_21806":125833,"_5":15007,"_28616":125386,"_3094":125834},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3706":74762,"_31461":74580,"_21806":125836,"_5":15007,"_28616":125386,"_3094":125837},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3706":74763,"_31461":74580,"_21806":125839,"_5":15007,"_28616":125390,"_3094":125840},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3706":74764,"_31461":74580,"_21806":125842,"_5":15007,"_28616":125390,"_3094":125843},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3706":74765,"_31461":74580,"_21806":125845,"_5":15007,"_28616":125390,"_3094":125846},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3706":74766,"_31461":74580,"_21806":125848,"_5":15007,"_28616":125390,"_3094":125849},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3706":74767,"_31461":74580,"_21806":125851,"_5":15007,"_28616":125390,"_3094":125852},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3706":74768,"_31461":74580,"_21806":125854,"_5":15007,"_28616":125394,"_3094":125855},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3706":74769,"_31461":74580,"_21806":125857,"_5":15007,"_28616":125394,"_3094":125756},[],{"_3706":74770,"_31461":74580,"_21806":125859,"_5":15007,"_28616":125394,"_3094":125759},[],{"_3706":74771,"_31461":74580,"_21806":125861,"_5":15007,"_28616":125394,"_3094":125862},[],"`SinConfigurar` → `None` / `Auto`",{"_3706":74772,"_31461":74580,"_21806":125864,"_5":15007,"_28616":125394,"_3094":125865},[],"ninguna (solo configuración)",{"_3706":74773,"_31461":74580,"_21806":125867,"_5":15007,"_28616":125394,"_3094":56112},[],{"_3706":74774,"_31461":74580,"_21806":125869,"_5":15007,"_28616":125394,"_3094":125865},[],{"_3706":74775,"_31461":74580,"_21806":125871,"_5":15007,"_28616":125394,"_3094":125872},[],"Cualquiera → `Jitp`",{"_3706":74776,"_31461":74580,"_21806":125874,"_5":15007,"_28616":125394,"_3094":125875},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3706":74777,"_31461":74580,"_21806":125877,"_5":15007,"_28616":125394,"_3094":56123},[],{"_3706":74778,"_31461":74580,"_21806":125879,"_5":15007,"_28616":125394,"_3094":125880},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3706":74779,"_31461":74580,"_21806":125882,"_5":15007,"_28616":125398,"_3094":125883},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3706":74780,"_31461":74580,"_21806":125885,"_5":15007,"_28616":125398,"_3094":125886},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3706":74781,"_31461":74580,"_21806":125888,"_5":15007,"_28616":125398,"_3094":125889},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3706":74782,"_31461":74580,"_21806":125891,"_5":15007,"_28616":125402,"_3094":125892},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3706":74783,"_31461":74580,"_21806":125894,"_5":15007,"_28616":125402,"_3094":125756},[],{"_3706":74784,"_31461":74580,"_21806":125896,"_5":15007,"_28616":125402,"_3094":125759},[],{"_3706":74785,"_31461":74580,"_21806":125898,"_5":15007,"_28616":125402,"_3094":125899},[],"`Ausente` → `Aprovisionado`",{"_3706":74786,"_31461":74580,"_21806":125901,"_5":15007,"_28616":125402,"_3094":125902},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3706":74787,"_31461":74580,"_21806":125904,"_5":15007,"_28616":125402,"_3094":125905},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3706":74788,"_31461":74580,"_21806":125907,"_5":15007,"_28616":125402,"_3094":125908},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3706":74789,"_31461":74580,"_21806":125910,"_5":15007,"_28616":125402,"_3094":125911},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3706":74790,"_31461":74580,"_21806":125913,"_5":15007,"_28616":125406,"_3094":125914},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3706":74791,"_31461":74580,"_21806":125916,"_5":15007,"_28616":125406,"_3094":125917},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3706":74792,"_31461":74580,"_21806":125919,"_5":15007,"_28616":125406,"_3094":125920},[],"Para que el flujo JITP funcione correctamente:",{"_3706":74793,"_31461":74580,"_21806":125922,"_5":15007,"_28616":125406,"_3094":125923},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3706":74794,"_31461":74580,"_21806":125925,"_5":15007,"_28616":125406,"_3094":125926},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3706":74795,"_31461":74580,"_21806":125928,"_5":15007,"_28616":125406,"_3094":125929},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3706":74796,"_31461":74580,"_21806":125931,"_5":15007,"_28616":125406,"_3094":125932},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3706":74797,"_31461":74580,"_21806":125934,"_5":15007,"_28616":125410,"_3094":125935},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3706":74798,"_31461":74580,"_21806":125937,"_5":15007,"_28616":125410,"_3094":125938},[],"Estado en Lamassu",{"_3706":74799,"_31461":74580,"_21806":125940,"_5":15007,"_28616":125410,"_3094":125941},[],"Razón de revocación",{"_3706":74800,"_31461":74580,"_21806":125943,"_5":15007,"_28616":125410,"_3094":125944},[],"Estado en AWS IoT Core",{"_3706":74801,"_31461":74580,"_21806":125946,"_5":15007,"_28616":125410,"_3094":56193},[],{"_3706":74802,"_31461":74580,"_21806":125948,"_5":15007,"_28616":125410,"_3094":125949},[],"Ninguna",{"_3706":74803,"_31461":74580,"_21806":125951,"_5":15007,"_28616":125410,"_3094":56199},[],{"_3706":74804,"_31461":74580,"_21806":125953,"_5":15007,"_28616":125410,"_3094":56202},[],{"_3706":74805,"_31461":74580,"_21806":125955,"_5":15007,"_28616":125410,"_3094":56205},[],{"_3706":74806,"_31461":74580,"_21806":125957,"_5":15007,"_28616":125410,"_3094":56208},[],{"_3706":74807,"_31461":74580,"_21806":125959,"_5":15007,"_28616":125410,"_3094":56202},[],{"_3706":74808,"_31461":74580,"_21806":125961,"_5":15007,"_28616":125410,"_3094":125962},[],"Cualquier otra razón",{"_3706":74809,"_31461":74580,"_21806":125964,"_5":15007,"_28616":125410,"_3094":56216},[],{"_3706":74810,"_31461":74580,"_21806":125966,"_5":15007,"_28616":125410,"_3094":125967},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3706":74811,"_31461":74580,"_21806":125969,"_5":15007,"_28616":125414,"_3094":125970},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3706":74812,"_31461":74580,"_21806":125972,"_5":15007,"_28616":125414,"_3094":125756},[],{"_3706":74813,"_31461":74580,"_21806":125974,"_5":15007,"_28616":125414,"_3094":125759},[],{"_3706":74814,"_31461":74580,"_21806":125976,"_5":15007,"_28616":125414,"_3094":125977},[],"`NoSincronizado` → `Active`",{"_3706":74815,"_31461":74580,"_21806":125979,"_5":15007,"_28616":125414,"_3094":55708},[],{"_3706":74816,"_31461":74580,"_21806":125981,"_5":15007,"_28616":125414,"_3094":56234},[],{"_3706":74817,"_31461":74580,"_21806":125983,"_5":15007,"_28616":125414,"_3094":125984},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3706":74818,"_31461":74580,"_21806":125986,"_5":15007,"_28616":125414,"_3094":56240},[],{"_3706":74819,"_31461":74580,"_21806":125988,"_5":15007,"_28616":125414,"_3094":125984},[],{"_3706":74820,"_31461":74580,"_21806":125990,"_5":15007,"_28616":125414,"_3094":56245},[],{"_3706":74821,"_31461":74580,"_21806":125992,"_5":15007,"_28616":125414,"_3094":55708},[],{"_3706":74822,"_31461":74580,"_21806":125994,"_5":15007,"_28616":125414,"_3094":56250},[],{"_3706":74823,"_31461":74580,"_21806":125996,"_5":15007,"_28616":125414,"_3094":125997},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3706":74824,"_31461":74580,"_21806":125999,"_5":15007,"_28616":125418,"_3094":126000},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3706":74825,"_31461":74580,"_21806":126002,"_5":15007,"_28616":125418,"_3094":126003},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3706":74826,"_31461":74580,"_21806":126005,"_5":15007,"_28616":125418,"_3094":126006},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3706":74827,"_31461":74580,"_21806":126008,"_5":15007,"_28616":125422,"_3094":126009},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3706":74828,"_31461":74580,"_21806":126011,"_5":15007,"_28616":125422,"_3094":126012},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3706":74829,"_31461":74580,"_21806":126014,"_5":15007,"_28616":125426,"_3094":126015},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3706":74830,"_31461":74580,"_21806":126017,"_5":15007,"_28616":125426,"_3094":126018},[],"Existen dos tipos de acciones:",{"_3706":74831,"_31461":74580,"_21806":126020,"_5":15007,"_28616":125426,"_3094":126021},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3706":74832,"_31461":74580,"_21806":126023,"_5":15007,"_28616":125426,"_3094":126024},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3706":74833,"_31461":74580,"_21806":126026,"_5":15007,"_28616":125426,"_3094":126027},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3706":74834,"_31461":74580,"_21806":126029,"_5":15007,"_28616":125430,"_3094":126030},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3706":74835,"_31461":74580,"_21806":126032,"_5":15007,"_28616":125430,"_3094":126033},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3706":74836,"_31461":74580,"_21806":126035,"_5":15007,"_28616":125430,"_3094":126036},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3706":74837,"_31461":74580,"_21806":126038,"_5":15007,"_28616":125434,"_3094":126039},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3706":74838,"_31461":74580,"_21806":126041,"_5":15007,"_28616":125434,"_3094":126042},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3706":74839,"_31461":74580,"_21806":126044,"_5":15007,"_28616":125434,"_3094":126045},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3706":74840,"_31461":74580,"_21806":126047,"_5":15007,"_28616":125434,"_3094":126048},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3706":74841,"_31461":74580,"_21806":126050,"_5":15007,"_28616":125434,"_3094":126051},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3706":74842,"_31461":74580,"_21806":126053,"_5":15007,"_28616":125434,"_3094":126054},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3706":74843,"_31461":74580,"_21806":126056,"_5":15007,"_28616":125434,"_3094":126057},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3706":74844,"_31461":74580,"_21806":126059,"_5":15007,"_28616":125434,"_3094":126060},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3706":74845,"_31461":74580,"_21806":126062,"_5":15007,"_28616":125434,"_3094":126063},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3706":74846,"_31461":74580,"_21806":126065,"_5":15007,"_28616":125434,"_3094":126066},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3706":74847,"_31461":74580,"_21806":126068,"_5":15007,"_28616":125434,"_3094":126069},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3706":74848,"_31461":74580,"_21806":126071,"_5":15007,"_28616":125434,"_3094":126072},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3706":74849,"_31461":74580,"_21806":126074,"_5":15007,"_28616":125434,"_3094":126075},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3706":74850,"_31461":74580,"_21806":126077,"_5":15007,"_28616":125434,"_3094":126078},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3706":74851,"_31461":74580,"_21806":126080,"_5":15007,"_28616":125434,"_3094":126081},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3706":74852,"_31461":74580,"_21806":126083,"_5":15007,"_28616":125434,"_3094":126084},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3706":74853,"_31461":74580,"_21806":126086,"_5":15007,"_28616":125434,"_3094":126087},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3706":74854,"_31461":74580,"_21806":126089,"_5":15007,"_28616":125434,"_3094":126090},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3706":74855,"_31461":74580,"_21806":126092,"_5":15007,"_28616":125434,"_3094":126093},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3706":74856,"_31461":74580,"_21806":126095,"_5":15007,"_28616":125434,"_3094":126096},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3706":74857,"_31461":74580,"_21806":126098,"_5":15007,"_28616":125434,"_3094":126099},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3706":74858,"_31461":74580,"_21806":126101,"_5":15007,"_28616":125434,"_3094":126102},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3706":74859,"_31461":74580,"_21806":126104,"_5":15007,"_28616":125434,"_3094":126105},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3706":74860,"_31461":74580,"_21806":126107,"_5":15007,"_28616":125434,"_3094":126108},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3706":74861,"_31461":74861,"_5":15367,"_3094":54054,"_31820":126110,"_21806":126111,"_28616":74861},[51344,122764,54054],[],{"_3706":74862,"_31461":74861,"_21806":126113,"_5":15007,"_28616":74861,"_3094":126114},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3706":74863,"_31461":74861,"_5":31817,"_21806":126116,"_28616":126117,"_3094":126118},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3706":74864,"_31461":74861,"_5":31817,"_21806":126120,"_28616":126121,"_3094":123909},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3706":74865,"_31461":74861,"_5":31817,"_21806":126123,"_28616":126124,"_3094":124087},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3706":74866,"_31461":74861,"_5":31817,"_21806":126126,"_28616":126127,"_3094":125333},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#integraciones",{"_3706":74867,"_31461":74861,"_5":31817,"_21806":126129,"_28616":126130,"_3094":126131},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3706":74868,"_31461":74861,"_21806":126133,"_5":15007,"_28616":74861,"_3094":126134},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3706":74869,"_31461":74861,"_21806":126136,"_5":15007,"_28616":126117,"_3094":126137},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3706":74870,"_31461":74861,"_21806":126139,"_5":15007,"_28616":126117,"_3094":126140},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3706":74871,"_31461":74861,"_21806":126142,"_5":15007,"_28616":126121,"_3094":126143},[],"Recurso",{"_3706":74872,"_31461":74861,"_21806":126145,"_5":15007,"_28616":126121,"_3094":126146},[],"Qué representa",{"_3706":74873,"_31461":74861,"_21806":126148,"_5":15007,"_28616":126121,"_3094":126149},[],"**Dispositivo**",{"_3706":74874,"_31461":74861,"_21806":126151,"_5":15007,"_28616":126121,"_3094":126152},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3706":74875,"_31461":74861,"_21806":126154,"_5":15007,"_28616":126121,"_3094":126155},[],"**Identidad**",{"_3706":74876,"_31461":74861,"_21806":126157,"_5":15007,"_28616":126121,"_3094":126158},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3706":74877,"_31461":74861,"_21806":126160,"_5":15007,"_28616":126121,"_3094":56417},[],{"_3706":74878,"_31461":74861,"_21806":126162,"_5":15007,"_28616":126121,"_3094":126163},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3706":74879,"_31461":74861,"_21806":126165,"_5":15007,"_28616":126121,"_3094":126166},[],"**Flota**",{"_3706":74880,"_31461":74861,"_21806":126168,"_5":15007,"_28616":126121,"_3094":126169},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3706":74881,"_31461":74861,"_21806":126171,"_5":15007,"_28616":126121,"_3094":126172},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3706":74882,"_31461":74861,"_21806":126174,"_5":15007,"_28616":126121,"_3094":126175},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3706":74883,"_31461":74861,"_21806":126177,"_5":15007,"_28616":126124,"_3094":126178},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3706":74884,"_31461":74861,"_21806":126180,"_5":15007,"_28616":126124,"_3094":126181},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3706":74885,"_31461":74861,"_21806":126183,"_5":15007,"_28616":126124,"_3094":126184},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3706":74886,"_31461":74861,"_21806":126186,"_5":15007,"_28616":126124,"_3094":126187},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3706":74887,"_31461":74861,"_21806":126189,"_5":15007,"_28616":126124,"_3094":126190},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3706":74888,"_31461":74861,"_21806":126192,"_5":15007,"_28616":126124,"_3094":126193},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3706":74889,"_31461":74861,"_21806":126195,"_5":15007,"_28616":126124,"_3094":126196},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3706":74890,"_31461":74861,"_21806":126198,"_5":15007,"_28616":126124,"_3094":126199},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3706":74891,"_31461":74861,"_21806":126201,"_5":15007,"_28616":126127,"_3094":126202},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3706":74892,"_31461":74861,"_21806":126204,"_5":15007,"_28616":126127,"_3094":126205},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3706":74893,"_31461":74861,"_21806":126207,"_5":15007,"_28616":126130,"_3094":126208},[],"Participante",{"_3706":74894,"_31461":74861,"_21806":126210,"_5":15007,"_28616":126130,"_3094":126211},[],"Responsabilidad",{"_3706":74895,"_31461":74861,"_21806":126213,"_5":15007,"_28616":126130,"_3094":126214},[],"Administrador PKI",{"_3706":74896,"_31461":74861,"_21806":126216,"_5":15007,"_28616":126130,"_3094":126217},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3706":74897,"_31461":74861,"_21806":126219,"_5":15007,"_28616":126130,"_3094":126220},[],"Administrador del aprovisionamiento",{"_3706":74898,"_31461":74861,"_21806":126222,"_5":15007,"_28616":126130,"_3094":126223},[],"DMS, admisión, autenticación por operación e inventario.",{"_3706":74899,"_31461":74861,"_21806":126225,"_5":15007,"_28616":126130,"_3094":126226},[],"Integrador del dispositivo",{"_3706":74900,"_31461":74861,"_21806":126228,"_5":15007,"_28616":126130,"_3094":126229},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3706":74901,"_31461":74861,"_21806":126231,"_5":15007,"_28616":126130,"_3094":126232},[],"Integrador del consumidor",{"_3706":74902,"_31461":74861,"_21806":126234,"_5":15007,"_28616":126130,"_3094":126235},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3706":74903,"_31461":74861,"_21806":126237,"_5":15007,"_28616":126130,"_3094":126238},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3706":74904,"_31461":74904,"_5":15367,"_3094":126240,"_31820":126241,"_21806":126243,"_28616":74904},"Enrola y conecta tu primer dispositivo",[51344,122764,54054,126242],"Primeros pasos",[],{"_3706":74905,"_31461":74904,"_21806":126245,"_5":15007,"_28616":74904,"_3094":126246},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3706":74906,"_31461":74904,"_5":31817,"_21806":126248,"_28616":126249,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3706":74907,"_31461":74904,"_5":31817,"_21806":126251,"_28616":126252,"_3094":126253},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3706":74908,"_31461":74904,"_5":31817,"_21806":126255,"_28616":126256,"_3094":126257},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3706":74909,"_31461":74904,"_5":31817,"_21806":126259,"_28616":126260,"_3094":126261},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3706":74910,"_31461":74904,"_5":31817,"_21806":126263,"_28616":126264,"_3094":126265},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3706":74911,"_31461":74904,"_5":31817,"_21806":126267,"_28616":126268,"_3094":126269},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3706":74912,"_31461":74904,"_5":31817,"_21806":126271,"_28616":126272,"_3094":126273},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3706":74913,"_31461":74904,"_5":31817,"_21806":126275,"_28616":126276,"_3094":126277},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3706":74914,"_31461":74904,"_21806":126279,"_5":15007,"_28616":74904,"_3094":126280},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3706":74915,"_31461":74904,"_21806":126282,"_5":15007,"_28616":126249,"_3094":126283},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3706":74916,"_31461":74904,"_21806":126285,"_5":15007,"_28616":126249,"_3094":126286},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3706":74917,"_31461":74904,"_21806":126288,"_5":15007,"_28616":126249,"_3094":126289},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3706":74918,"_31461":74904,"_21806":126291,"_5":15007,"_28616":126249,"_3094":126292},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3706":74919,"_31461":74904,"_21806":126294,"_5":15007,"_28616":126249,"_3094":126295},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3706":74920,"_31461":74904,"_21806":126297,"_5":15007,"_28616":126252,"_3094":126298},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3706":74921,"_31461":74904,"_21806":126300,"_5":15007,"_28616":126252,"_3094":126301},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3706":74922,"_31461":74904,"_21806":126303,"_5":15007,"_28616":126256,"_3094":126304},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3706":74923,"_31461":74904,"_21806":126306,"_5":15007,"_28616":126256,"_3094":126307},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3706":74924,"_31461":74904,"_21806":126309,"_5":15007,"_28616":126256,"_3094":126310},[],"Ajuste",{"_3706":74925,"_31461":74904,"_21806":126312,"_5":15007,"_28616":126256,"_3094":126313},[],"Valor de evaluación",{"_3706":74926,"_31461":74904,"_21806":126315,"_5":15007,"_28616":126256,"_3094":56573},[],{"_3706":74927,"_31461":74904,"_21806":126317,"_5":15007,"_28616":126256,"_3094":126318},[],"Raíz emisora de `device-root.pem`.",{"_3706":74928,"_31461":74904,"_21806":126320,"_5":15007,"_28616":126256,"_3094":124221},[],{"_3706":74929,"_31461":74904,"_21806":126322,"_5":15007,"_28616":126256,"_3094":126323},[],"Perfil final de 1 hora que acabas de preparar.",{"_3706":74930,"_31461":74904,"_21806":126325,"_5":15007,"_28616":126256,"_3094":56584},[],{"_3706":74931,"_31461":74904,"_21806":126327,"_5":15007,"_28616":126256,"_3094":56587},[],{"_3706":74932,"_31461":74904,"_21806":126329,"_5":15007,"_28616":126256,"_3094":56590},[],{"_3706":74933,"_31461":74904,"_21806":126331,"_5":15007,"_28616":126256,"_3094":126332},[],"Habilitado.",{"_3706":74934,"_31461":74904,"_21806":126334,"_5":15007,"_28616":126256,"_3094":56596},[],{"_3706":74935,"_31461":74904,"_21806":126336,"_5":15007,"_28616":126256,"_3094":126337},[],"Deshabilitado; el ID debe ser nuevo.",{"_3706":74936,"_31461":74904,"_21806":126339,"_5":15007,"_28616":126256,"_3094":126340},[],"Autenticación inicial",{"_3706":74937,"_31461":74904,"_21806":126342,"_5":15007,"_28616":126256,"_3094":126343},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3706":74938,"_31461":74904,"_21806":126345,"_5":15007,"_28616":126256,"_3094":126346},[],"Autenticación de renovación",{"_3706":74939,"_31461":74904,"_21806":126348,"_5":15007,"_28616":126256,"_3094":126349},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3706":74940,"_31461":74904,"_21806":126351,"_5":15007,"_28616":126256,"_3094":56614},[],{"_3706":74941,"_31461":74904,"_21806":126353,"_5":15007,"_28616":126256,"_3094":126354},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3706":74942,"_31461":74904,"_21806":126356,"_5":15007,"_28616":126256,"_3094":56620},[],{"_3706":74943,"_31461":74904,"_21806":126358,"_5":15007,"_28616":126256,"_3094":126359},[],"1 hora.",{"_3706":74944,"_31461":74904,"_21806":126361,"_5":15007,"_28616":126256,"_3094":56626},[],{"_3706":74945,"_31461":74904,"_21806":126363,"_5":15007,"_28616":126256,"_3094":126364},[],"30 minutos / 10 minutos.",{"_3706":74946,"_31461":74904,"_21806":126366,"_5":15007,"_28616":126256,"_3094":56632},[],{"_3706":74947,"_31461":74904,"_21806":126368,"_5":15007,"_28616":126256,"_3094":126369},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3706":74948,"_31461":74904,"_21806":126371,"_5":15007,"_28616":126256,"_3094":54382},[],{"_3706":74949,"_31461":74904,"_21806":126373,"_5":15007,"_28616":126256,"_3094":126374},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3706":74950,"_31461":74904,"_21806":126376,"_5":15007,"_28616":126256,"_3094":56643},[],{"_3706":74951,"_31461":74904,"_21806":126378,"_5":15007,"_28616":126256,"_3094":126379},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3706":74952,"_31461":74904,"_21806":126381,"_5":15007,"_28616":126256,"_3094":126382},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3706":74953,"_31461":74904,"_21806":126384,"_5":15007,"_28616":126260,"_3094":126385},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3706":74954,"_31461":74904,"_21806":126387,"_5":15007,"_28616":126260,"_3094":126388},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3706":74955,"_31461":74904,"_21806":126390,"_5":15007,"_28616":126264,"_3094":126391},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3706":74956,"_31461":74904,"_21806":126393,"_5":15007,"_28616":126264,"_3094":126394},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3706":74957,"_31461":74904,"_21806":126396,"_5":15007,"_28616":126264,"_3094":126397},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3706":74958,"_31461":74904,"_21806":126399,"_5":15007,"_28616":126268,"_3094":126400},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3706":74959,"_31461":74904,"_21806":126402,"_5":15007,"_28616":126268,"_3094":126403},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3706":74960,"_31461":74904,"_21806":126405,"_5":15007,"_28616":126272,"_3094":126406},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3706":74961,"_31461":74904,"_21806":126408,"_5":15007,"_28616":126272,"_3094":126409},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3706":74962,"_31461":74904,"_21806":126411,"_5":15007,"_28616":126272,"_3094":126412},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3706":74963,"_31461":74904,"_21806":126414,"_5":15007,"_28616":126272,"_3094":126415},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3706":74964,"_31461":74904,"_21806":126417,"_5":15007,"_28616":126272,"_3094":126418},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3706":74965,"_31461":74904,"_21806":126420,"_5":15007,"_28616":126276,"_3094":126421},[],"Comprobación",{"_3706":74966,"_31461":74904,"_21806":126423,"_5":15007,"_28616":126276,"_3094":126424},[],"Resultado esperado",{"_3706":74967,"_31461":74904,"_21806":126426,"_5":15007,"_28616":126276,"_3094":126427},[],"Registro",{"_3706":74968,"_31461":74904,"_21806":126429,"_5":15007,"_28616":126276,"_3094":126430},[],"ID creado automáticamente y DMS correcto.",{"_3706":74969,"_31461":74904,"_21806":126432,"_5":15007,"_28616":126276,"_3094":125717},[],{"_3706":74970,"_31461":74904,"_21806":126434,"_5":15007,"_28616":126276,"_3094":126435},[],"CN, perfil, serie y clave verificados.",{"_3706":74971,"_31461":74904,"_21806":126437,"_5":15007,"_28616":126276,"_3094":126438},[],"Inventario",{"_3706":74972,"_31461":74904,"_21806":126440,"_5":15007,"_28616":126276,"_3094":126441},[],"Serie recibida visible como identidad actual y en el historial.",{"_3706":74973,"_31461":74904,"_21806":126443,"_5":15007,"_28616":126276,"_3094":126444},[],"Consumidor",{"_3706":74974,"_31461":74904,"_21806":126446,"_5":15007,"_28616":126276,"_3094":126447},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3706":74975,"_31461":74904,"_21806":126449,"_5":15007,"_28616":126276,"_3094":126450},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3706":74976,"_31461":74904,"_21806":126452,"_5":15007,"_28616":126276,"_3094":126453},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3706":74977,"_31461":74977,"_5":15367,"_3094":123926,"_31820":126455,"_21806":126456,"_28616":74977},[51344,122764,54054,126242],[],{"_3706":74978,"_31461":74977,"_21806":126458,"_5":15007,"_28616":74977,"_3094":126459},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3706":74979,"_31461":74977,"_5":31817,"_21806":126461,"_28616":126462,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3706":74980,"_31461":74977,"_5":31817,"_21806":126464,"_28616":126465,"_3094":126466},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3706":74981,"_31461":74977,"_5":31817,"_21806":126468,"_28616":126469,"_3094":126470},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3706":74982,"_31461":74977,"_5":31817,"_21806":126472,"_28616":126473,"_3094":126474},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3706":74983,"_31461":74977,"_5":31817,"_21806":126476,"_28616":126477,"_3094":126478},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3706":74984,"_31461":74977,"_5":31817,"_21806":126480,"_28616":126481,"_3094":126482},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3706":74985,"_31461":74977,"_5":31817,"_21806":126484,"_28616":126485,"_3094":126424},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3706":74986,"_31461":74977,"_5":31817,"_21806":126487,"_28616":126488,"_3094":126489},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3706":74987,"_31461":74977,"_5":31817,"_21806":126491,"_28616":126492,"_3094":126493},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3706":74988,"_31461":74977,"_21806":126495,"_5":15007,"_28616":74977,"_3094":126496},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3706":74989,"_31461":74977,"_21806":126498,"_5":15007,"_28616":74977,"_3094":126499},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3706":74990,"_31461":74977,"_21806":126501,"_5":15007,"_28616":126462,"_3094":126502},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3706":74991,"_31461":74977,"_21806":126504,"_5":15007,"_28616":126462,"_3094":126505},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3706":74992,"_31461":74977,"_21806":126507,"_5":15007,"_28616":126462,"_3094":126508},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3706":74993,"_31461":74977,"_21806":126510,"_5":15007,"_28616":126462,"_3094":126511},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3706":74994,"_31461":74977,"_21806":126513,"_5":15007,"_28616":126465,"_3094":126514},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3706":74995,"_31461":74977,"_21806":126516,"_5":15007,"_28616":126465,"_3094":126517},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3706":74996,"_31461":74977,"_21806":126519,"_5":15007,"_28616":126465,"_3094":126520},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3706":74997,"_31461":74977,"_21806":126522,"_5":15007,"_28616":126465,"_3094":126523},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3706":74998,"_31461":74977,"_21806":126525,"_5":15007,"_28616":126465,"_3094":126526},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3706":74999,"_31461":74977,"_21806":126528,"_5":15007,"_28616":126465,"_3094":126529},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3706":75000,"_31461":74977,"_21806":126531,"_5":15007,"_28616":126465,"_3094":126532},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3706":75001,"_31461":74977,"_21806":126534,"_5":15007,"_28616":126465,"_3094":126535},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3706":75002,"_31461":74977,"_21806":126537,"_5":15007,"_28616":126469,"_3094":126538},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3706":75003,"_31461":74977,"_21806":126540,"_5":15007,"_28616":126469,"_3094":56808},[],{"_3706":75004,"_31461":74977,"_21806":126542,"_5":15007,"_28616":126469,"_3094":126543},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3706":75005,"_31461":74977,"_21806":126545,"_5":15007,"_28616":126469,"_3094":126546},[],"**Icon** y **Tags**: clasificación opcional.",{"_3706":75006,"_31461":74977,"_21806":126548,"_5":15007,"_28616":126469,"_3094":126549},[],"Confirma el registro.",{"_3706":75007,"_31461":74977,"_21806":126551,"_5":15007,"_28616":126473,"_3094":126552},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3706":75008,"_31461":74977,"_21806":126554,"_5":15007,"_28616":126473,"_3094":126555},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3706":75009,"_31461":74977,"_21806":126557,"_5":15007,"_28616":126477,"_3094":126558},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3706":75010,"_31461":74977,"_21806":126560,"_5":15007,"_28616":126477,"_3094":126561},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3706":75011,"_31461":74977,"_21806":126563,"_5":15007,"_28616":126481,"_3094":126564},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3706":75012,"_31461":74977,"_21806":126566,"_5":15007,"_28616":126481,"_3094":126567},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3706":75013,"_31461":74977,"_21806":126569,"_5":15007,"_28616":126485,"_3094":126421},[],{"_3706":75014,"_31461":74977,"_21806":126571,"_5":15007,"_28616":126485,"_3094":126572},[],"Resultado",{"_3706":75015,"_31461":74977,"_21806":126574,"_5":15007,"_28616":126485,"_3094":125703},[],{"_3706":75016,"_31461":74977,"_21806":126576,"_5":15007,"_28616":126485,"_3094":126577},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3706":75017,"_31461":74977,"_21806":126579,"_5":15007,"_28616":126485,"_3094":126580},[],"Identidad actual",{"_3706":75018,"_31461":74977,"_21806":126582,"_5":15007,"_28616":126485,"_3094":126583},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3706":75019,"_31461":74977,"_21806":126585,"_5":15007,"_28616":126485,"_3094":126586},[],"Historial",{"_3706":75020,"_31461":74977,"_21806":126588,"_5":15007,"_28616":126485,"_3094":126589},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3706":75021,"_31461":74977,"_21806":126591,"_5":15007,"_28616":126485,"_3094":126592},[],"Clave y certificado",{"_3706":75022,"_31461":74977,"_21806":126594,"_5":15007,"_28616":126485,"_3094":126595},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3706":75023,"_31461":74977,"_21806":126597,"_5":15007,"_28616":126488,"_3094":126598},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3706":75024,"_31461":74977,"_21806":126600,"_5":15007,"_28616":126488,"_3094":126601},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3706":75025,"_31461":74977,"_21806":126603,"_5":15007,"_28616":126488,"_3094":126604},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3706":75026,"_31461":74977,"_21806":126606,"_5":15007,"_28616":126488,"_3094":126607},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3706":75027,"_31461":74977,"_21806":126609,"_5":15007,"_28616":126492,"_3094":126610},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3706":75028,"_31461":74977,"_21806":126612,"_5":15007,"_28616":126492,"_3094":126613},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3706":75029,"_31461":74977,"_21806":126615,"_5":15007,"_28616":126492,"_3094":126616},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3706":75030,"_31461":75030,"_5":15367,"_3094":126618,"_31820":126619,"_21806":126620,"_28616":75030},"Plataforma Lamassu IoT",[51344,122764],[],{"_3706":75031,"_31461":75030,"_21806":126622,"_5":15007,"_28616":75030,"_3094":126623},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3706":75032,"_31461":75030,"_5":31817,"_21806":126625,"_28616":126626,"_3094":126118},[],"/docs/pr-preview/pr-81/es/platform/overview#empieza-aquí",{"_3706":75033,"_31461":75030,"_5":31817,"_21806":126628,"_28616":126629,"_3094":126630},[],"/docs/pr-preview/pr-81/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3706":75034,"_31461":75030,"_5":31817,"_21806":126632,"_28616":126633,"_3094":126634},[],"/docs/pr-preview/pr-81/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3706":75035,"_31461":75030,"_5":31817,"_21806":126636,"_28616":126637,"_3094":126638},[],"/docs/pr-preview/pr-81/es/platform/overview#capacidades-principales","Capacidades principales",{"_3706":75036,"_31461":75030,"_5":31817,"_21806":126640,"_28616":126641,"_3094":126642},[],"/docs/pr-preview/pr-81/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3706":75037,"_31461":75030,"_5":31817,"_21806":126644,"_28616":126645,"_3094":126646},[],"/docs/pr-preview/pr-81/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3706":75038,"_31461":75030,"_5":31817,"_21806":126648,"_28616":126649,"_3094":126650},[],"/docs/pr-preview/pr-81/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3706":75039,"_31461":75030,"_5":31817,"_21806":126652,"_28616":126653,"_3094":126654},[],"/docs/pr-preview/pr-81/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3706":75040,"_31461":75030,"_5":31817,"_21806":126656,"_28616":126657,"_3094":126658},[],"/docs/pr-preview/pr-81/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3706":75041,"_31461":75030,"_5":31817,"_21806":126660,"_28616":126661,"_3094":126662},[],"/docs/pr-preview/pr-81/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3706":75042,"_31461":75030,"_5":31817,"_21806":126664,"_28616":126665,"_3094":126666},[],"/docs/pr-preview/pr-81/es/platform/overview#referencia-operativa","Referencia operativa",{"_3706":75043,"_31461":75030,"_21806":126668,"_5":15007,"_28616":75030,"_3094":126669},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3706":75044,"_31461":75030,"_21806":126671,"_5":15007,"_28616":126626,"_3094":126672},[],"Elige el resultado que necesitas obtener:",{"_3706":75045,"_31461":75030,"_21806":126674,"_5":15007,"_28616":126626,"_3094":126675},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3706":75046,"_31461":75030,"_21806":126677,"_5":15007,"_28616":126626,"_3094":126678},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3706":75047,"_31461":75030,"_21806":126680,"_5":15007,"_28616":126626,"_3094":126681},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3706":75048,"_31461":75030,"_21806":126683,"_5":15007,"_28616":126629,"_3094":126684},[],"Bloque",{"_3706":75049,"_31461":75030,"_21806":126686,"_5":15007,"_28616":126629,"_3094":126687},[],"Qué gestionas",{"_3706":75050,"_31461":75030,"_21806":126689,"_5":15007,"_28616":126629,"_3094":126690},[],"Punto de entrada",{"_3706":75051,"_31461":75030,"_21806":126692,"_5":15007,"_28616":126629,"_3094":56961},[],{"_3706":75052,"_31461":75030,"_21806":126694,"_5":15007,"_28616":126629,"_3094":126695},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3706":75053,"_31461":75030,"_21806":126697,"_5":15007,"_28616":126629,"_3094":126698},[],"Visión general de PKI",{"_3706":75054,"_31461":75030,"_21806":126700,"_5":15007,"_28616":126629,"_3094":56970},[],{"_3706":75055,"_31461":75030,"_21806":126702,"_5":15007,"_28616":126629,"_3094":126703},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3706":75056,"_31461":75030,"_21806":126705,"_5":15007,"_28616":126629,"_3094":126706},[],"Visión general de IoT Fleets",{"_3706":75057,"_31461":75030,"_21806":126708,"_5":15007,"_28616":126629,"_3094":126709},[],"**Administración**",{"_3706":75058,"_31461":75030,"_21806":126711,"_5":15007,"_28616":126629,"_3094":126712},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3706":75059,"_31461":75030,"_21806":126714,"_5":15007,"_28616":126629,"_3094":122766},[],{"_3706":75060,"_31461":75030,"_21806":126716,"_5":15007,"_28616":126629,"_3094":126717},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3706":75061,"_31461":75030,"_21806":126719,"_5":15007,"_28616":126633,"_3094":126720},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3706":75062,"_31461":75030,"_21806":126722,"_5":15007,"_28616":126633,"_3094":126723},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3706":75063,"_31461":75030,"_21806":126725,"_5":15007,"_28616":126633,"_3094":126726},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3706":75064,"_31461":75030,"_21806":126728,"_5":15007,"_28616":126633,"_3094":126729},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3706":75065,"_31461":75030,"_21806":126731,"_5":15007,"_28616":126633,"_3094":126732},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3706":75066,"_31461":75030,"_21806":126734,"_5":15007,"_28616":126633,"_3094":126735},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3706":75067,"_31461":75030,"_21806":126737,"_5":15007,"_28616":126641,"_3094":126738},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3706":75068,"_31461":75030,"_21806":126740,"_5":15007,"_28616":126645,"_3094":126741},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3706":75069,"_31461":75030,"_21806":126743,"_5":15007,"_28616":126649,"_3094":126744},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3706":75070,"_31461":75030,"_21806":126746,"_5":15007,"_28616":126653,"_3094":126747},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3706":75071,"_31461":75030,"_21806":126749,"_5":15007,"_28616":126657,"_3094":126750},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3706":75072,"_31461":75030,"_21806":126752,"_5":15007,"_28616":126661,"_3094":126753},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3706":75073,"_31461":75030,"_21806":126755,"_5":15007,"_28616":126665,"_3094":126211},[],{"_3706":75074,"_31461":75030,"_21806":126757,"_5":15007,"_28616":126665,"_3094":126758},[],"Qué prepara o comprueba",{"_3706":75075,"_31461":75030,"_21806":126760,"_5":15007,"_28616":126665,"_3094":126214},[],{"_3706":75076,"_31461":75030,"_21806":126762,"_5":15007,"_28616":126665,"_3094":126763},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3706":75077,"_31461":75030,"_21806":126765,"_5":15007,"_28616":126665,"_3094":126766},[],"Administrador de la flota",{"_3706":75078,"_31461":75030,"_21806":126768,"_5":15007,"_28616":126665,"_3094":126769},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3706":75079,"_31461":75030,"_21806":126771,"_5":15007,"_28616":126665,"_3094":126226},[],{"_3706":75080,"_31461":75030,"_21806":126773,"_5":15007,"_28616":126665,"_3094":126774},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3706":75081,"_31461":75030,"_21806":126776,"_5":15007,"_28616":126665,"_3094":126232},[],{"_3706":75082,"_31461":75030,"_21806":126778,"_5":15007,"_28616":126665,"_3094":126779},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3706":75083,"_31461":75030,"_21806":126781,"_5":15007,"_28616":126665,"_3094":126782},[],"Operador de infraestructura",{"_3706":75084,"_31461":75030,"_21806":126784,"_5":15007,"_28616":126665,"_3094":126785},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3706":75085,"_31461":75030,"_21806":126787,"_5":15007,"_28616":126665,"_3094":126788},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3706":75086,"_31461":75086,"_5":15367,"_3094":126790,"_31820":126791,"_21806":126793,"_28616":75086},"Jerarquía y rotación de CAs",[51344,122764,57062,126792],"Claves, autoridades y certificados",[],{"_3706":75087,"_31461":75086,"_21806":126795,"_5":15007,"_28616":75086,"_3094":126796},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3706":75088,"_31461":75086,"_5":31817,"_21806":126798,"_28616":126799,"_3094":126800},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3706":75089,"_31461":75086,"_5":31817,"_21806":126802,"_28616":126803,"_3094":126804},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3706":75090,"_31461":75086,"_5":31817,"_21806":126806,"_28616":126807,"_3094":126808},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3706":75091,"_31461":75086,"_5":31817,"_21806":126810,"_28616":126811,"_3094":126812},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3706":75092,"_31461":75086,"_5":31817,"_21806":126814,"_28616":126815,"_3094":126816},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3706":75093,"_31461":75086,"_5":31817,"_21806":126818,"_28616":126819,"_3094":126820},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3706":75094,"_31461":75086,"_5":31817,"_21806":126822,"_28616":126823,"_3094":126824},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3706":75095,"_31461":75086,"_5":31817,"_21806":126826,"_28616":126827,"_3094":126828},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3706":75096,"_31461":75086,"_5":31817,"_21806":126830,"_28616":126831,"_3094":126832},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3706":75097,"_31461":75086,"_5":31817,"_21806":126834,"_28616":126835,"_3094":126836},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3706":75098,"_31461":75086,"_5":31817,"_21806":126838,"_28616":126839,"_3094":126840},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3706":75099,"_31461":75086,"_5":31817,"_21806":126842,"_28616":126843,"_3094":126844},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3706":75100,"_31461":75086,"_21806":126846,"_5":15007,"_28616":75086,"_3094":126847},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3706":75101,"_31461":75086,"_21806":126849,"_5":15007,"_28616":75086,"_3094":126850},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3706":75102,"_31461":75086,"_21806":126852,"_5":15007,"_28616":126799,"_3094":126853},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3706":75103,"_31461":75086,"_21806":126855,"_5":15007,"_28616":126799,"_3094":126856},[],"entorno, como producción y preproducción;",{"_3706":75104,"_31461":75086,"_21806":126858,"_5":15007,"_28616":126799,"_3094":126859},[],"propietario o equipo operador;",{"_3706":75105,"_31461":75086,"_21806":126861,"_5":15007,"_28616":126799,"_3094":126862},[],"familia de dispositivos o proceso de fabricación;",{"_3706":75106,"_31461":75086,"_21806":126864,"_5":15007,"_28616":126799,"_3094":126865},[],"región o requisito regulatorio;",{"_3706":75107,"_31461":75086,"_21806":126867,"_5":15007,"_28616":126799,"_3094":126868},[],"motor criptográfico o política de clave;",{"_3706":75108,"_31461":75086,"_21806":126870,"_5":15007,"_28616":126799,"_3094":126871},[],"ventana de mantenimiento y ritmo de renovación.",{"_3706":75109,"_31461":75086,"_21806":126873,"_5":15007,"_28616":126799,"_3094":126874},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3706":75110,"_31461":75086,"_21806":126876,"_5":15007,"_28616":126799,"_3094":126877},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3706":75111,"_31461":75086,"_21806":126879,"_5":15007,"_28616":126803,"_3094":126880},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3706":75112,"_31461":75086,"_21806":126882,"_5":15007,"_28616":126803,"_3094":126883},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3706":75113,"_31461":75086,"_21806":126885,"_5":15007,"_28616":126803,"_3094":126886},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3706":75114,"_31461":75086,"_21806":126888,"_5":15007,"_28616":126803,"_3094":126889},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3706":75115,"_31461":75086,"_21806":126891,"_5":15007,"_28616":126807,"_3094":126892},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3706":75116,"_31461":75086,"_21806":126894,"_5":15007,"_28616":126807,"_3094":126895},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3706":75117,"_31461":75086,"_21806":126897,"_5":15007,"_28616":126807,"_3094":126898},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3706":75118,"_31461":75086,"_21806":126900,"_5":15007,"_28616":126807,"_3094":126901},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3706":75119,"_31461":75086,"_21806":126903,"_5":15007,"_28616":126815,"_3094":126904},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3706":75120,"_31461":75086,"_21806":126906,"_5":15007,"_28616":126819,"_3094":126907},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3706":75121,"_31461":75086,"_21806":126909,"_5":15007,"_28616":126823,"_3094":126910},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3706":75122,"_31461":75086,"_21806":126912,"_5":15007,"_28616":126827,"_3094":126913},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3706":75123,"_31461":75086,"_21806":126915,"_5":15007,"_28616":126831,"_3094":126916},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3706":75124,"_31461":75086,"_21806":126918,"_5":15007,"_28616":126835,"_3094":126919},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3706":75125,"_31461":75086,"_21806":126921,"_5":15007,"_28616":126839,"_3094":126922},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3706":75126,"_31461":75086,"_21806":126924,"_5":15007,"_28616":126839,"_3094":126925},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3706":75127,"_31461":75086,"_21806":126927,"_5":15007,"_28616":126839,"_3094":126928},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3706":75128,"_31461":75086,"_21806":126930,"_5":15007,"_28616":126839,"_3094":126931},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3706":75129,"_31461":75086,"_21806":126933,"_5":15007,"_28616":126843,"_3094":126934},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3706":75130,"_31461":75086,"_21806":126936,"_5":15007,"_28616":126843,"_3094":126937},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3706":75131,"_31461":75086,"_21806":126939,"_5":15007,"_28616":126843,"_3094":126940},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3706":75132,"_31461":75086,"_21806":126942,"_5":15007,"_28616":126843,"_3094":126943},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3706":75133,"_31461":75086,"_21806":126945,"_5":15007,"_28616":126843,"_3094":126946},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3706":75134,"_31461":75086,"_21806":126948,"_5":15007,"_28616":126843,"_3094":126949},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3706":75135,"_31461":75086,"_21806":126951,"_5":15007,"_28616":126843,"_3094":126952},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3706":75136,"_31461":75136,"_5":15367,"_3094":126954,"_31820":126955,"_21806":126956,"_28616":75136},"Autoridades de certificación",[51344,122764,57062,126792],[],{"_3706":75137,"_31461":75136,"_21806":126958,"_5":15007,"_28616":75136,"_3094":126959},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3706":75138,"_31461":75136,"_5":31817,"_21806":126961,"_28616":126962,"_3094":126963},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3706":75139,"_31461":75136,"_5":31817,"_21806":126965,"_28616":126966,"_3094":126967},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3706":75140,"_31461":75136,"_5":31817,"_21806":126969,"_28616":126970,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3706":75141,"_31461":75136,"_5":31817,"_21806":126972,"_28616":126973,"_3094":126974},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3706":75142,"_31461":75136,"_5":31817,"_21806":126976,"_28616":126977,"_3094":126978},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3706":75143,"_31461":75136,"_5":31817,"_21806":126980,"_28616":126981,"_3094":126982},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3706":75144,"_31461":75136,"_5":31817,"_21806":126984,"_28616":126985,"_3094":126986},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3706":75145,"_31461":75136,"_5":31817,"_21806":126988,"_28616":126989,"_3094":126990},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3706":75146,"_31461":75136,"_5":31817,"_21806":126992,"_28616":126993,"_3094":126994},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3706":75147,"_31461":75136,"_5":31817,"_21806":126996,"_28616":126997,"_3094":126998},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3706":75148,"_31461":75136,"_5":31817,"_21806":127000,"_28616":127001,"_3094":127002},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3706":75149,"_31461":75136,"_5":31817,"_21806":127004,"_28616":127005,"_3094":127006},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3706":75150,"_31461":75136,"_5":31817,"_21806":127008,"_28616":127009,"_3094":127010},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3706":75151,"_31461":75136,"_5":31817,"_21806":127012,"_28616":127013,"_3094":127014},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3706":75152,"_31461":75136,"_5":31817,"_21806":127016,"_28616":127017,"_3094":127018},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3706":75153,"_31461":75136,"_5":31817,"_21806":127020,"_28616":127021,"_3094":127022},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3706":75154,"_31461":75136,"_5":31817,"_21806":127024,"_28616":127025,"_3094":127026},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3706":75155,"_31461":75136,"_5":31817,"_21806":127028,"_28616":127029,"_3094":127030},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3706":75156,"_31461":75136,"_5":31817,"_21806":127032,"_28616":127033,"_3094":127034},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3706":75157,"_31461":75136,"_5":31817,"_21806":127036,"_28616":127037,"_3094":127038},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3706":75158,"_31461":75136,"_5":31817,"_21806":127040,"_28616":127041,"_3094":127042},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3706":75159,"_31461":75136,"_5":31817,"_21806":127044,"_28616":127045,"_3094":127046},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3706":75160,"_31461":75136,"_5":31817,"_21806":127048,"_28616":127049,"_3094":127050},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3706":75161,"_31461":75136,"_5":31817,"_21806":127052,"_28616":127053,"_3094":127054},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3706":75162,"_31461":75136,"_21806":127056,"_5":15007,"_28616":75136,"_3094":127057},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3706":75163,"_31461":75136,"_21806":127059,"_5":15007,"_28616":75136,"_3094":127060},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3706":75164,"_31461":75136,"_21806":127062,"_5":15007,"_28616":75136,"_3094":127063},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3706":75165,"_31461":75136,"_21806":127065,"_5":15007,"_28616":126962,"_3094":127066},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3706":75166,"_31461":75136,"_21806":127068,"_5":15007,"_28616":126962,"_3094":127069},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3706":75167,"_31461":75136,"_21806":127071,"_5":15007,"_28616":126962,"_3094":127072},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3706":75168,"_31461":75136,"_21806":127074,"_5":15007,"_28616":126962,"_3094":127075},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3706":75169,"_31461":75136,"_21806":127077,"_5":15007,"_28616":126962,"_3094":127078},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3706":75170,"_31461":75136,"_21806":127080,"_5":15007,"_28616":126970,"_3094":127081},[],"Decide si la CA será raíz o intermedia.",{"_3706":75171,"_31461":75136,"_21806":127083,"_5":15007,"_28616":126970,"_3094":127084},[],"Elige el motor que custodiará la clave.",{"_3706":75172,"_31461":75136,"_21806":127086,"_5":15007,"_28616":126970,"_3094":127087},[],"Define una validez superior a la de los certificados que emitirá.",{"_3706":75173,"_31461":75136,"_21806":127089,"_5":15007,"_28616":126970,"_3094":127090},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3706":75174,"_31461":75136,"_21806":127092,"_5":15007,"_28616":126973,"_3094":127093},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3706":75175,"_31461":75136,"_21806":127095,"_5":15007,"_28616":126977,"_3094":127096},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3706":75176,"_31461":75136,"_21806":127098,"_5":15007,"_28616":126977,"_3094":127099},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3706":75177,"_31461":75136,"_21806":127101,"_5":15007,"_28616":126981,"_3094":127102},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3706":75178,"_31461":75136,"_21806":127104,"_5":15007,"_28616":126985,"_3094":127105},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3706":75179,"_31461":75136,"_21806":127107,"_5":15007,"_28616":126985,"_3094":127108},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3706":75180,"_31461":75136,"_21806":127110,"_5":15007,"_28616":126985,"_3094":127111},[],"`ST`: estado o provincia.",{"_3706":75181,"_31461":75136,"_21806":127113,"_5":15007,"_28616":126985,"_3094":127114},[],"`L`: localidad.",{"_3706":75182,"_31461":75136,"_21806":127116,"_5":15007,"_28616":126985,"_3094":127117},[],"`O`: organización.",{"_3706":75183,"_31461":75136,"_21806":127119,"_5":15007,"_28616":126985,"_3094":127120},[],"`OU`: unidad organizativa.",{"_3706":75184,"_31461":75136,"_21806":127122,"_5":15007,"_28616":126985,"_3094":127123},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3706":75185,"_31461":75136,"_21806":127125,"_5":15007,"_28616":126989,"_3094":127126},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3706":75186,"_31461":75136,"_21806":127128,"_5":15007,"_28616":126989,"_3094":127129},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3706":75187,"_31461":75136,"_21806":127131,"_5":15007,"_28616":126993,"_3094":127132},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3706":75188,"_31461":75136,"_21806":127134,"_5":15007,"_28616":126993,"_3094":127135},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3706":75189,"_31461":75136,"_21806":127137,"_5":15007,"_28616":126997,"_3094":127138},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3706":75190,"_31461":75136,"_21806":127140,"_5":15007,"_28616":126997,"_3094":127141},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3706":75191,"_31461":75136,"_21806":127143,"_5":15007,"_28616":127001,"_3094":127144},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3706":75192,"_31461":75136,"_21806":127146,"_5":15007,"_28616":127001,"_3094":127147},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3706":75193,"_31461":75136,"_21806":127149,"_5":15007,"_28616":127001,"_3094":127150},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3706":75194,"_31461":75136,"_21806":127152,"_5":15007,"_28616":127001,"_3094":127153},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3706":75195,"_31461":75136,"_21806":127155,"_5":15007,"_28616":127005,"_3094":127156},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3706":75196,"_31461":75136,"_21806":127158,"_5":15007,"_28616":127009,"_3094":127159},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3706":75197,"_31461":75136,"_21806":127161,"_5":15007,"_28616":127009,"_3094":127162},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3706":75198,"_31461":75136,"_21806":127164,"_5":15007,"_28616":127013,"_3094":127165},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3706":75199,"_31461":75136,"_21806":127167,"_5":15007,"_28616":127017,"_3094":127168},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3706":75200,"_31461":75136,"_21806":127170,"_5":15007,"_28616":127017,"_3094":127171},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3706":75201,"_31461":75136,"_21806":127173,"_5":15007,"_28616":127017,"_3094":127174},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3706":75202,"_31461":75136,"_21806":127176,"_5":15007,"_28616":127021,"_3094":127177},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3706":75203,"_31461":75136,"_21806":127179,"_5":15007,"_28616":127021,"_3094":127180},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3706":75204,"_31461":75136,"_21806":127182,"_5":15007,"_28616":127021,"_3094":127183},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3706":75205,"_31461":75136,"_21806":127185,"_5":15007,"_28616":127021,"_3094":127186},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3706":75206,"_31461":75136,"_21806":127188,"_5":15007,"_28616":127025,"_3094":127189},[],"Abre una CA desde el inventario para consultar:",{"_3706":75207,"_31461":75136,"_21806":127191,"_5":15007,"_28616":127025,"_3094":127192},[],"Estado y periodo de validez.",{"_3706":75208,"_31461":75136,"_21806":127194,"_5":15007,"_28616":127025,"_3094":127195},[],"Certificado y cadena en formato PEM.",{"_3706":75209,"_31461":75136,"_21806":127197,"_5":15007,"_28616":127025,"_3094":127198},[],"Número de certificados activos, expirados y revocados.",{"_3706":75210,"_31461":75136,"_21806":127200,"_5":15007,"_28616":127025,"_3094":127201},[],"Certificados emitidos en **Issued Certificates**.",{"_3706":75211,"_31461":75136,"_21806":127203,"_5":15007,"_28616":127025,"_3094":127204},[],"CRL vinculada a la autoridad.",{"_3706":75212,"_31461":75136,"_21806":127206,"_5":15007,"_28616":127025,"_3094":127207},[],"Metadatos y motor criptográfico asociado.",{"_3706":75213,"_31461":75136,"_21806":127209,"_5":15007,"_28616":127025,"_3094":127210},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3706":75214,"_31461":75136,"_21806":127212,"_5":15007,"_28616":127029,"_3094":127213},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3706":75215,"_31461":75136,"_21806":127215,"_5":15007,"_28616":127029,"_3094":127216},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3706":75216,"_31461":75136,"_21806":127218,"_5":15007,"_28616":127029,"_3094":127219},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3706":75217,"_31461":75136,"_21806":127221,"_5":15007,"_28616":127029,"_3094":127222},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3706":75218,"_31461":75136,"_21806":127224,"_5":15007,"_28616":127029,"_3094":127225},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3706":75219,"_31461":75136,"_21806":127227,"_5":15007,"_28616":127029,"_3094":127228},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3706":75220,"_31461":75136,"_21806":127230,"_5":15007,"_28616":127033,"_3094":127231},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3706":75221,"_31461":75136,"_21806":127233,"_5":15007,"_28616":127037,"_3094":127234},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3706":75222,"_31461":75136,"_21806":127236,"_5":15007,"_28616":127041,"_3094":127237},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3706":75223,"_31461":75136,"_21806":127239,"_5":15007,"_28616":127045,"_3094":127240},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3706":75224,"_31461":75136,"_21806":127242,"_5":15007,"_28616":127049,"_3094":127243},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3706":75225,"_31461":75136,"_21806":127245,"_5":15007,"_28616":127053,"_3094":127246},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3706":75226,"_31461":75136,"_21806":127248,"_5":15007,"_28616":127053,"_3094":127249},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3706":75227,"_31461":75136,"_21806":127251,"_5":15007,"_28616":127053,"_3094":127252},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3706":75228,"_31461":75136,"_21806":127254,"_5":15007,"_28616":127053,"_3094":127255},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3706":75229,"_31461":75136,"_21806":127257,"_5":15007,"_28616":127053,"_3094":127258},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3706":75230,"_31461":75230,"_5":15367,"_3094":127260,"_31820":127261,"_21806":127262,"_28616":75230},"Perfiles de certificado",[51344,122764,57062,126792],[],{"_3706":75231,"_31461":75230,"_21806":127264,"_5":15007,"_28616":75230,"_3094":127265},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3706":75232,"_31461":75230,"_5":31817,"_21806":127267,"_28616":127268,"_3094":127269},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3706":75233,"_31461":75230,"_5":31817,"_21806":127271,"_28616":127272,"_3094":127273},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#validez","Validez",{"_3706":75234,"_31461":75230,"_5":31817,"_21806":127275,"_28616":127276,"_3094":127277},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3706":75235,"_31461":75230,"_5":31817,"_21806":127279,"_28616":127280,"_3094":127281},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3706":75236,"_31461":75230,"_5":31817,"_21806":127283,"_28616":127284,"_3094":127285},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3706":75237,"_31461":75230,"_5":31817,"_21806":127287,"_28616":127288,"_3094":127289},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3706":75238,"_31461":75230,"_5":31817,"_21806":127291,"_28616":127292,"_3094":127293},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3706":75239,"_31461":75230,"_5":31817,"_21806":127295,"_28616":127296,"_3094":127297},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3706":75240,"_31461":75230,"_5":31817,"_21806":127299,"_28616":127300,"_3094":127301},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3706":75241,"_31461":75230,"_5":31817,"_21806":127303,"_28616":127304,"_3094":127305},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3706":75242,"_31461":75230,"_5":31817,"_21806":127307,"_28616":127308,"_3094":127309},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3706":75243,"_31461":75230,"_5":31817,"_21806":127311,"_28616":127312,"_3094":127313},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3706":75244,"_31461":75230,"_5":31817,"_21806":127315,"_28616":127316,"_3094":127317},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3706":75245,"_31461":75230,"_5":31817,"_21806":127319,"_28616":127320,"_3094":127321},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3706":75246,"_31461":75230,"_5":31817,"_21806":127323,"_28616":127324,"_3094":127325},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3706":75247,"_31461":75230,"_5":31817,"_21806":127327,"_28616":127328,"_3094":127329},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3706":75248,"_31461":75230,"_21806":127331,"_5":15007,"_28616":75230,"_3094":127332},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3706":75249,"_31461":75230,"_21806":127334,"_5":15007,"_28616":75230,"_3094":127335},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3706":75250,"_31461":75230,"_21806":127337,"_5":15007,"_28616":127272,"_3094":127338},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3706":75251,"_31461":75230,"_21806":127340,"_5":15007,"_28616":127272,"_3094":127341},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3706":75252,"_31461":75230,"_21806":127343,"_5":15007,"_28616":127276,"_3094":127344},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3706":75253,"_31461":75230,"_21806":127346,"_5":15007,"_28616":127280,"_3094":127347},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3706":75254,"_31461":75230,"_21806":127349,"_5":15007,"_28616":127280,"_3094":127350},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3706":75255,"_31461":75230,"_21806":127352,"_5":15007,"_28616":127280,"_3094":127353},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3706":75256,"_31461":75230,"_21806":127355,"_5":15007,"_28616":127284,"_3094":127356},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3706":75257,"_31461":75230,"_21806":127358,"_5":15007,"_28616":127288,"_3094":127359},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3706":75258,"_31461":75230,"_21806":127361,"_5":15007,"_28616":127288,"_3094":127362},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3706":75259,"_31461":75230,"_21806":127364,"_5":15007,"_28616":127292,"_3094":127365},[],"La aplicación criptográfica puede:",{"_3706":75260,"_31461":75230,"_21806":127367,"_5":15007,"_28616":127292,"_3094":127368},[],"permitir o bloquear claves RSA;",{"_3706":75261,"_31461":75230,"_21806":127370,"_5":15007,"_28616":127292,"_3094":127371},[],"limitar los tamaños RSA admitidos;",{"_3706":75262,"_31461":75230,"_21806":127373,"_5":15007,"_28616":127292,"_3094":127374},[],"permitir o bloquear claves ECDSA;",{"_3706":75263,"_31461":75230,"_21806":127376,"_5":15007,"_28616":127292,"_3094":127377},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3706":75264,"_31461":75230,"_21806":127379,"_5":15007,"_28616":127292,"_3094":127380},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3706":75265,"_31461":75230,"_21806":127382,"_5":15007,"_28616":127296,"_3094":127383},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3706":75266,"_31461":75230,"_21806":127385,"_5":15007,"_28616":127296,"_3094":122524},[],{"_3706":75267,"_31461":75230,"_21806":127387,"_5":15007,"_28616":127296,"_3094":127388},[],"Primera opción",{"_3706":75268,"_31461":75230,"_21806":127390,"_5":15007,"_28616":127296,"_3094":127391},[],"Segunda opción",{"_3706":75269,"_31461":75230,"_21806":127393,"_5":15007,"_28616":127296,"_3094":127394},[],"Si no hay ninguna",{"_3706":75270,"_31461":75230,"_21806":127396,"_5":15007,"_28616":127296,"_3094":127397},[],"Firma directa con una CA",{"_3706":75271,"_31461":75230,"_21806":127399,"_5":15007,"_28616":127296,"_3094":127400},[],"`issuance_profile` incluido en la solicitud",{"_3706":75272,"_31461":75230,"_21806":127402,"_5":15007,"_28616":127296,"_3094":127403},[],"`issuance_profile_id` de la solicitud",{"_3706":75273,"_31461":75230,"_21806":127405,"_5":15007,"_28616":127296,"_3094":127406},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3706":75274,"_31461":75230,"_21806":127408,"_5":15007,"_28616":127296,"_3094":127409},[],"Emisión mediante DMS",{"_3706":75275,"_31461":75230,"_21806":127411,"_5":15007,"_28616":127296,"_3094":57683},[],{"_3706":75276,"_31461":75230,"_21806":127413,"_5":15007,"_28616":127296,"_3094":127414},[],"`settings.issuance_profile` incluido en el DMS",{"_3706":75277,"_31461":75230,"_21806":127416,"_5":15007,"_28616":127296,"_3094":127417},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3706":75278,"_31461":75230,"_21806":127419,"_5":15007,"_28616":127296,"_3094":127420},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3706":75279,"_31461":75230,"_21806":127422,"_5":15007,"_28616":127296,"_3094":127423},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3706":75280,"_31461":75230,"_21806":127425,"_5":15007,"_28616":127304,"_3094":127426},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3706":75281,"_31461":75230,"_21806":127428,"_5":15007,"_28616":127308,"_3094":127429},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3706":75282,"_31461":75230,"_21806":127431,"_5":15007,"_28616":127312,"_3094":127432},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3706":75283,"_31461":75230,"_21806":127434,"_5":15007,"_28616":127316,"_3094":127435},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3706":75284,"_31461":75230,"_21806":127437,"_5":15007,"_28616":127320,"_3094":127438},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3706":75285,"_31461":75230,"_21806":127440,"_5":15007,"_28616":127320,"_3094":127441},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3706":75286,"_31461":75230,"_21806":127443,"_5":15007,"_28616":127324,"_3094":127444},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3706":75287,"_31461":75230,"_21806":127446,"_5":15007,"_28616":127324,"_3094":127447},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3706":75288,"_31461":75230,"_21806":127449,"_5":15007,"_28616":127324,"_3094":127450},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3706":75289,"_31461":75230,"_21806":127452,"_5":15007,"_28616":127324,"_3094":127453},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3706":75290,"_31461":75230,"_21806":127455,"_5":15007,"_28616":127328,"_3094":127456},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3706":75291,"_31461":75230,"_21806":127458,"_5":15007,"_28616":127328,"_3094":127459},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3706":75292,"_31461":75292,"_5":15367,"_3094":127461,"_31820":127462,"_21806":127464,"_28616":75292},"Validación de certificados",[51344,122764,57062,127463],"Validación",[],{"_3706":75293,"_31461":75292,"_21806":127466,"_5":15007,"_28616":75292,"_3094":127467},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3706":75294,"_31461":75292,"_5":31817,"_21806":127469,"_28616":127470,"_3094":127471},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3706":75295,"_31461":75292,"_5":31817,"_21806":127473,"_28616":127474,"_3094":127475},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3706":75296,"_31461":75292,"_5":31817,"_21806":127477,"_28616":127478,"_3094":127479},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3706":75297,"_31461":75292,"_21806":127481,"_5":15007,"_28616":75292,"_3094":127482},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3706":75298,"_31461":75292,"_21806":127484,"_5":15007,"_28616":127470,"_3094":127485},[],"Verifica estos criterios juntos:",{"_3706":75299,"_31461":75292,"_21806":127487,"_5":15007,"_28616":127470,"_3094":126421},[],{"_3706":75300,"_31461":75292,"_21806":127489,"_5":15007,"_28616":127470,"_3094":127490},[],"Resultado necesario",{"_3706":75301,"_31461":75292,"_21806":127492,"_5":15007,"_28616":127470,"_3094":127493},[],"Cadena y firma",{"_3706":75302,"_31461":75292,"_21806":127495,"_5":15007,"_28616":127470,"_3094":127496},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3706":75303,"_31461":75292,"_21806":127498,"_5":15007,"_28616":127470,"_3094":127499},[],"Fechas",{"_3706":75304,"_31461":75292,"_21806":127501,"_5":15007,"_28616":127470,"_3094":127502},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3706":75305,"_31461":75292,"_21806":127504,"_5":15007,"_28616":127470,"_3094":122434},[],{"_3706":75306,"_31461":75292,"_21806":127506,"_5":15007,"_28616":127470,"_3094":127507},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3706":75307,"_31461":75292,"_21806":127509,"_5":15007,"_28616":127470,"_3094":127510},[],"Uso",{"_3706":75308,"_31461":75292,"_21806":127512,"_5":15007,"_28616":127470,"_3094":127513},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3706":75309,"_31461":75292,"_21806":127515,"_5":15007,"_28616":127470,"_3094":127516},[],"Revocación",{"_3706":75310,"_31461":75292,"_21806":127518,"_5":15007,"_28616":127470,"_3094":127519},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3706":75311,"_31461":75292,"_21806":127521,"_5":15007,"_28616":127470,"_3094":127522},[],"Autorización",{"_3706":75312,"_31461":75292,"_21806":127524,"_5":15007,"_28616":127470,"_3094":127525},[],"La aplicación permite la acción a esa identidad.",{"_3706":75313,"_31461":75292,"_21806":127527,"_5":15007,"_28616":127470,"_3094":127528},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3706":75314,"_31461":75292,"_21806":127530,"_5":15007,"_28616":127474,"_3094":127531},[],"Mecanismo",{"_3706":75315,"_31461":75292,"_21806":127533,"_5":15007,"_28616":127474,"_3094":127534},[],"Cuándo utilizarlo",{"_3706":75316,"_31461":75292,"_21806":127536,"_5":15007,"_28616":127474,"_3094":127537},[],"Qué debes mantener",{"_3706":75317,"_31461":75292,"_21806":127539,"_5":15007,"_28616":127474,"_3094":57811},[],{"_3706":75318,"_31461":75292,"_21806":127541,"_5":15007,"_28616":127474,"_3094":127542},[],"Consulta del estado de un certificado concreto.",{"_3706":75319,"_31461":75292,"_21806":127544,"_5":15007,"_28616":127474,"_3094":127545},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3706":75320,"_31461":75292,"_21806":127547,"_5":15007,"_28616":127474,"_3094":57820},[],{"_3706":75321,"_31461":75292,"_21806":127549,"_5":15007,"_28616":127474,"_3094":127550},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3706":75322,"_31461":75292,"_21806":127552,"_5":15007,"_28616":127474,"_3094":127553},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3706":75323,"_31461":75292,"_21806":127555,"_5":15007,"_28616":127474,"_3094":127556},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3706":75324,"_31461":75292,"_21806":127558,"_5":15007,"_28616":127474,"_3094":127559},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3706":75325,"_31461":75292,"_21806":127561,"_5":15007,"_28616":127478,"_3094":127562},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3706":75326,"_31461":75292,"_21806":127564,"_5":15007,"_28616":127478,"_3094":127565},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3706":75327,"_31461":75292,"_21806":127567,"_5":15007,"_28616":127478,"_3094":127568},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3706":75328,"_31461":75292,"_21806":127570,"_5":15007,"_28616":127478,"_3094":127571},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3706":75329,"_31461":75292,"_21806":127573,"_5":15007,"_28616":127478,"_3094":127574},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3706":75330,"_31461":75292,"_21806":127576,"_5":15007,"_28616":127478,"_3094":127577},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3706":75331,"_31461":75292,"_21806":127579,"_5":15007,"_28616":127478,"_3094":127580},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3706":75332,"_31461":75292,"_21806":127582,"_5":15007,"_28616":127478,"_3094":127583},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3706":75333,"_31461":75292,"_21806":127585,"_5":15007,"_28616":127478,"_3094":127586},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3706":75334,"_31461":75334,"_5":15367,"_3094":127588,"_31820":127589,"_21806":127590,"_28616":75334},"Certificados",[51344,122764,57062,126792],[],{"_3706":75335,"_31461":75334,"_21806":127592,"_5":15007,"_28616":75334,"_3094":127593},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3706":75336,"_31461":75334,"_5":31817,"_21806":127595,"_28616":127596,"_3094":127597},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3706":75337,"_31461":75334,"_5":31817,"_21806":127599,"_28616":127600,"_3094":127601},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3706":75338,"_31461":75334,"_5":31817,"_21806":127603,"_28616":127604,"_3094":127605},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3706":75339,"_31461":75334,"_5":31817,"_21806":127607,"_28616":127608,"_3094":127609},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3706":75340,"_31461":75334,"_5":31817,"_21806":127611,"_28616":127612,"_3094":127613},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3706":75341,"_31461":75334,"_5":31817,"_21806":127615,"_28616":127616,"_3094":127617},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3706":75342,"_31461":75334,"_5":31817,"_21806":127619,"_28616":127620,"_3094":127621},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3706":75343,"_31461":75334,"_5":31817,"_21806":127623,"_28616":127624,"_3094":127625},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3706":75344,"_31461":75334,"_5":31817,"_21806":127627,"_28616":127628,"_3094":127629},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#continúa","Continúa",{"_3706":75345,"_31461":75334,"_21806":127631,"_5":15007,"_28616":75334,"_3094":127632},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3706":75346,"_31461":75334,"_21806":127634,"_5":15007,"_28616":127596,"_3094":127635},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3706":75347,"_31461":75334,"_21806":127637,"_5":15007,"_28616":127596,"_3094":127638},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3706":75348,"_31461":75334,"_21806":127640,"_5":15007,"_28616":127596,"_3094":127641},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3706":75349,"_31461":75334,"_21806":127643,"_5":15007,"_28616":127596,"_3094":127644},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3706":75350,"_31461":75334,"_21806":127646,"_5":15007,"_28616":127596,"_3094":127647},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3706":75351,"_31461":75334,"_21806":127649,"_5":15007,"_28616":127596,"_3094":127650},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3706":75352,"_31461":75334,"_21806":127652,"_5":15007,"_28616":127596,"_3094":127653},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3706":75353,"_31461":75334,"_21806":127655,"_5":15007,"_28616":127600,"_3094":127656},[],"Descarga el PEM e inspecciónalo:",{"_3706":75354,"_31461":75334,"_21806":127658,"_5":15007,"_28616":127600,"_3094":127659},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3706":75355,"_31461":75334,"_21806":127661,"_5":15007,"_28616":127604,"_3094":127662},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3706":75356,"_31461":75334,"_21806":127664,"_5":15007,"_28616":127604,"_3094":127665},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3706":75357,"_31461":75334,"_21806":127667,"_5":15007,"_28616":127604,"_3094":127668},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3706":75358,"_31461":75334,"_21806":127670,"_5":15007,"_28616":127604,"_3094":127671},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3706":75359,"_31461":75334,"_21806":127673,"_5":15007,"_28616":127604,"_3094":127674},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3706":75360,"_31461":75334,"_21806":127676,"_5":15007,"_28616":127604,"_3094":127677},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3706":75361,"_31461":75334,"_21806":127679,"_5":15007,"_28616":127604,"_3094":127680},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3706":75362,"_31461":75334,"_21806":127682,"_5":15007,"_28616":127608,"_3094":127683},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3706":75363,"_31461":75334,"_21806":127685,"_5":15007,"_28616":127612,"_3094":127686},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3706":75364,"_31461":75334,"_21806":127688,"_5":15007,"_28616":127616,"_3094":127689},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3706":75365,"_31461":75334,"_21806":127691,"_5":15007,"_28616":127620,"_3094":127692},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3706":75366,"_31461":75334,"_21806":127694,"_5":15007,"_28616":127620,"_3094":127695},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3706":75367,"_31461":75334,"_21806":127697,"_5":15007,"_28616":127620,"_3094":127698},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3706":75368,"_31461":75334,"_21806":127700,"_5":15007,"_28616":127624,"_3094":127701},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3706":75369,"_31461":75334,"_21806":127703,"_5":15007,"_28616":127624,"_3094":127704},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3706":75370,"_31461":75334,"_21806":127706,"_5":15007,"_28616":127624,"_3094":127707},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3706":75371,"_31461":75334,"_21806":127709,"_5":15007,"_28616":127628,"_3094":127710},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3706":75372,"_31461":75334,"_21806":127712,"_5":15007,"_28616":127628,"_3094":127713},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3706":75373,"_31461":75373,"_5":15367,"_3094":127715,"_31820":127716,"_21806":127718,"_28616":75373},"Ciclo de vida de un certificado",[51344,122764,57062,127717],"Conceptos",[],{"_3706":75374,"_31461":75373,"_21806":127720,"_5":15007,"_28616":75373,"_3094":127721},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3706":75375,"_31461":75373,"_5":31817,"_21806":127723,"_28616":127724,"_3094":127725},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3706":75376,"_31461":75373,"_5":31817,"_21806":127727,"_28616":127728,"_3094":127729},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3706":75377,"_31461":75373,"_5":31817,"_21806":127731,"_28616":127732,"_3094":127733},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3706":75378,"_31461":75373,"_5":31817,"_21806":127735,"_28616":127736,"_3094":127737},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3706":75379,"_31461":75373,"_5":31817,"_21806":127739,"_28616":127740,"_3094":127741},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3706":75380,"_31461":75373,"_5":31817,"_21806":127743,"_28616":127744,"_3094":127745},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3706":75381,"_31461":75373,"_5":31817,"_21806":127747,"_28616":127748,"_3094":125415},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3706":75382,"_31461":75373,"_5":31817,"_21806":127750,"_28616":127751,"_3094":127752},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3706":75383,"_31461":75373,"_5":31817,"_21806":127754,"_28616":127755,"_3094":127756},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3706":75384,"_31461":75373,"_5":31817,"_21806":127758,"_28616":127759,"_3094":127760},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3706":75385,"_31461":75373,"_21806":127762,"_5":15007,"_28616":75373,"_3094":127763},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3706":75386,"_31461":75373,"_21806":127765,"_5":15007,"_28616":127728,"_3094":127766},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3706":75387,"_31461":75373,"_21806":127768,"_5":15007,"_28616":127732,"_3094":127769},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3706":75388,"_31461":75373,"_21806":127771,"_5":15007,"_28616":127736,"_3094":127772},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3706":75389,"_31461":75373,"_21806":127774,"_5":15007,"_28616":127740,"_3094":127775},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3706":75390,"_31461":75373,"_21806":127777,"_5":15007,"_28616":127744,"_3094":127778},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3706":75391,"_31461":75373,"_21806":127780,"_5":15007,"_28616":127748,"_3094":127781},[],"Lamassu persiste cuatro estados X.509:",{"_3706":75392,"_31461":75373,"_21806":127783,"_5":15007,"_28616":127748,"_3094":127784},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3706":75393,"_31461":75373,"_21806":127786,"_5":15007,"_28616":127748,"_3094":127787},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3706":75394,"_31461":75373,"_21806":127789,"_5":15007,"_28616":127748,"_3094":127790},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3706":75395,"_31461":75373,"_21806":127792,"_5":15007,"_28616":127748,"_3094":127793},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3706":75396,"_31461":75373,"_21806":127795,"_5":15007,"_28616":127748,"_3094":127796},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3706":75397,"_31461":75373,"_21806":127798,"_5":15007,"_28616":127751,"_3094":127799},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3706":75398,"_31461":75373,"_21806":127801,"_5":15007,"_28616":127751,"_3094":127802},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3706":75399,"_31461":75373,"_21806":127804,"_5":15007,"_28616":127751,"_3094":127805},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3706":75400,"_31461":75373,"_21806":127807,"_5":15007,"_28616":127755,"_3094":127808},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3706":75401,"_31461":75373,"_21806":127810,"_5":15007,"_28616":127755,"_3094":127811},[],"Antes de confirmar:",{"_3706":75402,"_31461":75373,"_21806":127813,"_5":15007,"_28616":127755,"_3094":127814},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3706":75403,"_31461":75373,"_21806":127816,"_5":15007,"_28616":127755,"_3094":127817},[],"Distribuye la nueva cadena de confianza.",{"_3706":75404,"_31461":75373,"_21806":127819,"_5":15007,"_28616":127755,"_3094":127820},[],"Reemite las identidades necesarias.",{"_3706":75405,"_31461":75373,"_21806":127822,"_5":15007,"_28616":127755,"_3094":127823},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3706":75406,"_31461":75373,"_21806":127825,"_5":15007,"_28616":127755,"_3094":127826},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3706":75407,"_31461":75373,"_21806":127828,"_5":15007,"_28616":127755,"_3094":127829},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3706":75408,"_31461":75373,"_21806":127831,"_5":15007,"_28616":127759,"_3094":127832},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3706":75409,"_31461":75373,"_21806":127834,"_5":15007,"_28616":127759,"_3094":127835},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3706":75410,"_31461":75373,"_21806":127837,"_5":15007,"_28616":127759,"_3094":127838},[],"Cambios de estado y razones de revocación.",{"_3706":75411,"_31461":75373,"_21806":127840,"_5":15007,"_28616":127759,"_3094":127841},[],"Publicación y vigencia de OCSP y CRLs.",{"_3706":75412,"_31461":75373,"_21806":127843,"_5":15007,"_28616":127759,"_3094":127844},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3706":75413,"_31461":75373,"_21806":127846,"_5":15007,"_28616":127759,"_3094":127847},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3706":75414,"_31461":75414,"_5":15367,"_3094":127849,"_31820":127850,"_21806":127851,"_28616":75414},"Modelo de confianza",[51344,122764,57062,127717],[],{"_3706":75415,"_31461":75414,"_21806":127853,"_5":15007,"_28616":75414,"_3094":127854},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3706":75416,"_31461":75414,"_5":31817,"_21806":127856,"_28616":127857,"_3094":127858},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3706":75417,"_31461":75414,"_5":31817,"_21806":127860,"_28616":127861,"_3094":127862},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3706":75418,"_31461":75414,"_5":31817,"_21806":127864,"_28616":127865,"_3094":127866},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3706":75419,"_31461":75414,"_5":31817,"_21806":127868,"_28616":127869,"_3094":127870},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3706":75420,"_31461":75414,"_5":31817,"_21806":127872,"_28616":127873,"_3094":127874},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3706":75421,"_31461":75414,"_5":31817,"_21806":127876,"_28616":127877,"_3094":127878},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3706":75422,"_31461":75414,"_5":31817,"_21806":127880,"_28616":127881,"_3094":127882},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3706":75423,"_31461":75414,"_5":31817,"_21806":127884,"_28616":127885,"_3094":127886},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3706":75424,"_31461":75414,"_5":31817,"_21806":127888,"_28616":127889,"_3094":127890},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3706":75425,"_31461":75414,"_5":31817,"_21806":127892,"_28616":127893,"_3094":127894},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3706":75426,"_31461":75414,"_21806":127896,"_5":15007,"_28616":75414,"_3094":127897},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3706":75427,"_31461":75414,"_21806":127899,"_5":15007,"_28616":127861,"_3094":127900},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3706":75428,"_31461":75414,"_21806":127902,"_5":15007,"_28616":127865,"_3094":127903},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3706":75429,"_31461":75414,"_21806":127905,"_5":15007,"_28616":127869,"_3094":127906},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3706":75430,"_31461":75414,"_21806":127908,"_5":15007,"_28616":127873,"_3094":127909},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3706":75431,"_31461":75414,"_21806":127911,"_5":15007,"_28616":127877,"_3094":127912},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3706":75432,"_31461":75414,"_21806":127914,"_5":15007,"_28616":127877,"_3094":127915},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3706":75433,"_31461":75414,"_21806":127917,"_5":15007,"_28616":127877,"_3094":127918},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3706":75434,"_31461":75414,"_21806":127920,"_5":15007,"_28616":127877,"_3094":127921},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3706":75435,"_31461":75414,"_21806":127923,"_5":15007,"_28616":127877,"_3094":127924},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3706":75436,"_31461":75414,"_21806":127926,"_5":15007,"_28616":127877,"_3094":127927},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3706":75437,"_31461":75414,"_21806":127929,"_5":15007,"_28616":127881,"_3094":127930},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3706":75438,"_31461":75414,"_21806":127932,"_5":15007,"_28616":127881,"_3094":127933},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3706":75439,"_31461":75414,"_21806":127935,"_5":15007,"_28616":127881,"_3094":127936},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3706":75440,"_31461":75414,"_21806":127938,"_5":15007,"_28616":127881,"_3094":127939},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3706":75441,"_31461":75414,"_21806":127941,"_5":15007,"_28616":127881,"_3094":127942},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3706":75442,"_31461":75414,"_21806":127944,"_5":15007,"_28616":127885,"_3094":127945},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3706":75443,"_31461":75414,"_21806":127947,"_5":15007,"_28616":127885,"_3094":127948},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3706":75444,"_31461":75414,"_21806":127950,"_5":15007,"_28616":127885,"_3094":127951},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3706":75445,"_31461":75414,"_21806":127953,"_5":15007,"_28616":127885,"_3094":127954},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3706":75446,"_31461":75414,"_21806":127956,"_5":15007,"_28616":127885,"_3094":127957},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3706":75447,"_31461":75414,"_21806":127959,"_5":15007,"_28616":127885,"_3094":127960},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3706":75448,"_31461":75414,"_21806":127962,"_5":15007,"_28616":127885,"_3094":127963},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3706":75449,"_31461":75414,"_21806":127965,"_5":15007,"_28616":127889,"_3094":127966},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3706":75450,"_31461":75414,"_21806":127968,"_5":15007,"_28616":127893,"_3094":127969},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3706":75451,"_31461":75414,"_21806":127971,"_5":15007,"_28616":127893,"_3094":127972},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3706":75452,"_31461":75414,"_21806":127974,"_5":15007,"_28616":127893,"_3094":127975},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3706":75453,"_31461":75414,"_21806":127977,"_5":15007,"_28616":127893,"_3094":127978},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3706":75454,"_31461":75414,"_21806":127980,"_5":15007,"_28616":127893,"_3094":127981},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3706":75455,"_31461":75414,"_21806":127983,"_5":15007,"_28616":127893,"_3094":127984},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3706":75456,"_31461":75414,"_21806":127986,"_5":15007,"_28616":127893,"_3094":127987},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3706":75457,"_31461":75457,"_5":15367,"_3094":127989,"_31820":127990,"_21806":127991,"_28616":75457},"Listas de revocación (CRL)",[51344,122764,57062,127463],[],{"_3706":75458,"_31461":75457,"_21806":127993,"_5":15007,"_28616":75457,"_3094":127994},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3706":75459,"_31461":75457,"_5":31817,"_21806":127996,"_28616":127997,"_3094":127998},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3706":75460,"_31461":75457,"_5":31817,"_21806":128000,"_28616":128001,"_3094":128002},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3706":75461,"_31461":75457,"_5":31817,"_21806":128004,"_28616":128005,"_3094":128006},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3706":75462,"_31461":75457,"_5":31817,"_21806":128008,"_28616":128009,"_3094":128010},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3706":75463,"_31461":75457,"_5":31817,"_21806":128012,"_28616":128013,"_3094":128014},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3706":75464,"_31461":75457,"_5":31817,"_21806":128016,"_28616":128017,"_3094":128018},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3706":75465,"_31461":75457,"_5":31817,"_21806":128020,"_28616":128021,"_3094":128022},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3706":75466,"_31461":75457,"_5":31817,"_21806":128024,"_28616":128025,"_3094":128026},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#referencias","Referencias",{"_3706":75467,"_31461":75457,"_21806":128028,"_5":15007,"_28616":75457,"_3094":128029},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3706":75468,"_31461":75457,"_21806":128031,"_5":15007,"_28616":127997,"_3094":128032},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3706":75469,"_31461":75457,"_21806":128034,"_5":15007,"_28616":127997,"_3094":128035},[],"Campo",{"_3706":75470,"_31461":75457,"_21806":128037,"_5":15007,"_28616":127997,"_3094":124456},[],{"_3706":75471,"_31461":75457,"_21806":128039,"_5":15007,"_28616":127997,"_3094":53002},[],{"_3706":75472,"_31461":75457,"_21806":128041,"_5":15007,"_28616":127997,"_3094":128042},[],"ID de la CA a la que pertenecen los ajustes.",{"_3706":75473,"_31461":75457,"_21806":128044,"_5":15007,"_28616":127997,"_3094":58319},[],{"_3706":75474,"_31461":75457,"_21806":128046,"_5":15007,"_28616":127997,"_3094":128047},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3706":75475,"_31461":75457,"_21806":128049,"_5":15007,"_28616":127997,"_3094":58325},[],{"_3706":75476,"_31461":75457,"_21806":128051,"_5":15007,"_28616":127997,"_3094":128052},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3706":75477,"_31461":75457,"_21806":128054,"_5":15007,"_28616":127997,"_3094":58331},[],{"_3706":75478,"_31461":75457,"_21806":128056,"_5":15007,"_28616":127997,"_3094":128057},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3706":75479,"_31461":75457,"_21806":128059,"_5":15007,"_28616":127997,"_3094":128060},[],"Campo de `crl_options`",{"_3706":75480,"_31461":75457,"_21806":128062,"_5":15007,"_28616":127997,"_3094":124456},[],{"_3706":75481,"_31461":75457,"_21806":128064,"_5":15007,"_28616":127997,"_3094":128065},[],"Valor inicial",{"_3706":75482,"_31461":75457,"_21806":128067,"_5":15007,"_28616":127997,"_3094":58345},[],{"_3706":75483,"_31461":75457,"_21806":128069,"_5":15007,"_28616":127997,"_3094":128070},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3706":75484,"_31461":75457,"_21806":128072,"_5":15007,"_28616":127997,"_3094":128073},[],"7 días.",{"_3706":75485,"_31461":75457,"_21806":128075,"_5":15007,"_28616":127997,"_3094":58354},[],{"_3706":75486,"_31461":75457,"_21806":128077,"_5":15007,"_28616":127997,"_3094":128078},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3706":75487,"_31461":75457,"_21806":128080,"_5":15007,"_28616":127997,"_3094":128081},[],"6 días y 23 horas.",{"_3706":75488,"_31461":75457,"_21806":128083,"_5":15007,"_28616":127997,"_3094":58363},[],{"_3706":75489,"_31461":75457,"_21806":128085,"_5":15007,"_28616":127997,"_3094":128086},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3706":75490,"_31461":75457,"_21806":128088,"_5":15007,"_28616":127997,"_3094":58369},[],{"_3706":75491,"_31461":75457,"_21806":128090,"_5":15007,"_28616":127997,"_3094":58372},[],{"_3706":75492,"_31461":75457,"_21806":128092,"_5":15007,"_28616":127997,"_3094":128093},[],"Número de serie del certificado existente que firma la CRL.",{"_3706":75493,"_31461":75457,"_21806":128095,"_5":15007,"_28616":127997,"_3094":128096},[],"Número de serie del certificado actual de la CA.",{"_3706":75494,"_31461":75457,"_21806":128098,"_5":15007,"_28616":127997,"_3094":128099},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3706":75495,"_31461":75457,"_21806":128101,"_5":15007,"_28616":127997,"_3094":128102},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3706":75496,"_31461":75457,"_21806":128104,"_5":15007,"_28616":127997,"_3094":128105},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3706":75497,"_31461":75457,"_21806":128107,"_5":15007,"_28616":127997,"_3094":128108},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3706":75498,"_31461":75457,"_21806":128110,"_5":15007,"_28616":127997,"_3094":128111},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3706":75499,"_31461":75457,"_21806":128113,"_5":15007,"_28616":127997,"_3094":128114},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3706":75500,"_31461":75457,"_21806":128116,"_5":15007,"_28616":127997,"_3094":128117},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3706":75501,"_31461":75457,"_21806":128119,"_5":15007,"_28616":127997,"_3094":128120},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3706":75502,"_31461":75457,"_21806":128122,"_5":15007,"_28616":127997,"_3094":128123},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3706":75503,"_31461":75457,"_21806":128125,"_5":15007,"_28616":127997,"_3094":128126},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3706":75504,"_31461":75457,"_21806":128128,"_5":15007,"_28616":127997,"_3094":128129},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3706":75505,"_31461":75457,"_21806":128131,"_5":15007,"_28616":128001,"_3094":128132},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3706":75506,"_31461":75457,"_21806":128134,"_5":15007,"_28616":128001,"_3094":128135},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3706":75507,"_31461":75457,"_21806":128137,"_5":15007,"_28616":128001,"_3094":128138},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3706":75508,"_31461":75457,"_21806":128140,"_5":15007,"_28616":128001,"_3094":128141},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3706":75509,"_31461":75457,"_21806":128143,"_5":15007,"_28616":128005,"_3094":128144},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3706":75510,"_31461":75457,"_21806":128146,"_5":15007,"_28616":128005,"_3094":128147},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3706":75511,"_31461":75457,"_21806":128149,"_5":15007,"_28616":128005,"_3094":128150},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3706":75512,"_31461":75457,"_21806":128152,"_5":15007,"_28616":128005,"_3094":128153},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3706":75513,"_31461":75457,"_21806":128155,"_5":15007,"_28616":128005,"_3094":128156},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3706":75514,"_31461":75457,"_21806":128158,"_5":15007,"_28616":128005,"_3094":128159},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3706":75515,"_31461":75457,"_21806":128161,"_5":15007,"_28616":128005,"_3094":128162},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3706":75516,"_31461":75457,"_21806":128164,"_5":15007,"_28616":128005,"_3094":128165},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3706":75517,"_31461":75457,"_21806":128167,"_5":15007,"_28616":128005,"_3094":128168},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3706":75518,"_31461":75457,"_21806":128170,"_5":15007,"_28616":128009,"_3094":128171},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3706":75519,"_31461":75457,"_21806":128173,"_5":15007,"_28616":128009,"_3094":128174},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3706":75520,"_31461":75457,"_21806":128176,"_5":15007,"_28616":128013,"_3094":128177},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3706":75521,"_31461":75457,"_21806":128179,"_5":15007,"_28616":128013,"_3094":128180},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3706":75522,"_31461":75457,"_21806":128182,"_5":15007,"_28616":128013,"_3094":128183},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3706":75523,"_31461":75457,"_21806":128185,"_5":15007,"_28616":128013,"_3094":128186},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3706":75524,"_31461":75457,"_21806":128188,"_5":15007,"_28616":128013,"_3094":128189},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3706":75525,"_31461":75457,"_21806":128191,"_5":15007,"_28616":128017,"_3094":128192},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3706":75526,"_31461":75457,"_21806":128194,"_5":15007,"_28616":128017,"_3094":124645},[],{"_3706":75527,"_31461":75457,"_21806":128196,"_5":15007,"_28616":128017,"_3094":128197},[],"Path relativo",{"_3706":75528,"_31461":75457,"_21806":128199,"_5":15007,"_28616":128017,"_3094":122524},[],{"_3706":75529,"_31461":75457,"_21806":128201,"_5":15007,"_28616":128017,"_3094":58484},[],{"_3706":75530,"_31461":75457,"_21806":128203,"_5":15007,"_28616":128017,"_3094":58487},[],{"_3706":75531,"_31461":75457,"_21806":128205,"_5":15007,"_28616":128017,"_3094":128206},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3706":75532,"_31461":75457,"_21806":128208,"_5":15007,"_28616":128017,"_3094":58484},[],{"_3706":75533,"_31461":75457,"_21806":128210,"_5":15007,"_28616":128017,"_3094":58495},[],{"_3706":75534,"_31461":75457,"_21806":128212,"_5":15007,"_28616":128017,"_3094":128213},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3706":75535,"_31461":75457,"_21806":128215,"_5":15007,"_28616":128017,"_3094":58501},[],{"_3706":75536,"_31461":75457,"_21806":128217,"_5":15007,"_28616":128017,"_3094":58495},[],{"_3706":75537,"_31461":75457,"_21806":128219,"_5":15007,"_28616":128017,"_3094":128220},[],"Sustituir la configuración de CRL de una CA.",{"_3706":75538,"_31461":75457,"_21806":128222,"_5":15007,"_28616":128017,"_3094":58509},[],{"_3706":75539,"_31461":75457,"_21806":128224,"_5":15007,"_28616":128017,"_3094":58495},[],{"_3706":75540,"_31461":75457,"_21806":128226,"_5":15007,"_28616":128017,"_3094":128227},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3706":75541,"_31461":75457,"_21806":128229,"_5":15007,"_28616":128017,"_3094":128230},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3706":75542,"_31461":75457,"_21806":128232,"_5":15007,"_28616":128017,"_3094":128233},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3706":75543,"_31461":75457,"_21806":128235,"_5":15007,"_28616":128017,"_3094":128236},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3706":75544,"_31461":75457,"_21806":128238,"_5":15007,"_28616":128021,"_3094":128239},[],"Síntoma",{"_3706":75545,"_31461":75457,"_21806":128241,"_5":15007,"_28616":128021,"_3094":128242},[],"Causa",{"_3706":75546,"_31461":75457,"_21806":128244,"_5":15007,"_28616":128021,"_3094":128245},[],"Acción",{"_3706":75547,"_31461":75457,"_21806":128247,"_5":15007,"_28616":128021,"_3094":128248},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3706":75548,"_31461":75457,"_21806":128250,"_5":15007,"_28616":128021,"_3094":128251},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3706":75549,"_31461":75457,"_21806":128253,"_5":15007,"_28616":128021,"_3094":128254},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3706":75550,"_31461":75457,"_21806":128256,"_5":15007,"_28616":128021,"_3094":128257},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3706":75551,"_31461":75457,"_21806":128259,"_5":15007,"_28616":128021,"_3094":128260},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3706":75552,"_31461":75457,"_21806":128262,"_5":15007,"_28616":128021,"_3094":128263},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3706":75553,"_31461":75457,"_21806":128265,"_5":15007,"_28616":128021,"_3094":128266},[],"`PUT` devuelve 400.",{"_3706":75554,"_31461":75457,"_21806":128268,"_5":15007,"_28616":128021,"_3094":128269},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3706":75555,"_31461":75457,"_21806":128271,"_5":15007,"_28616":128021,"_3094":128272},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3706":75556,"_31461":75457,"_21806":128274,"_5":15007,"_28616":128021,"_3094":128275},[],"`PUT` devuelve 404.",{"_3706":75557,"_31461":75457,"_21806":128277,"_5":15007,"_28616":128021,"_3094":128278},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3706":75558,"_31461":75457,"_21806":128280,"_5":15007,"_28616":128021,"_3094":128281},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3706":75559,"_31461":75457,"_21806":128283,"_5":15007,"_28616":128021,"_3094":128284},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3706":75560,"_31461":75457,"_21806":128286,"_5":15007,"_28616":128021,"_3094":128287},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3706":75561,"_31461":75457,"_21806":128289,"_5":15007,"_28616":128021,"_3094":128290},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3706":75562,"_31461":75457,"_21806":128292,"_5":15007,"_28616":128021,"_3094":128293},[],"La CRL no cambia tras revocar un certificado.",{"_3706":75563,"_31461":75457,"_21806":128295,"_5":15007,"_28616":128021,"_3094":128296},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3706":75564,"_31461":75457,"_21806":128298,"_5":15007,"_28616":128021,"_3094":128299},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3706":75565,"_31461":75457,"_21806":128301,"_5":15007,"_28616":128021,"_3094":128302},[],"Un verificador rechaza la CRL por el emisor.",{"_3706":75566,"_31461":75457,"_21806":128304,"_5":15007,"_28616":128021,"_3094":128305},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3706":75567,"_31461":75457,"_21806":128307,"_5":15007,"_28616":128021,"_3094":128308},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3706":75568,"_31461":75457,"_21806":128310,"_5":15007,"_28616":128025,"_3094":128311},[],"RFC 5280: perfil X.509 y CRL.",{"_3706":75569,"_31461":75457,"_21806":128313,"_5":15007,"_28616":128025,"_3094":58601},[],{"_3706":75570,"_31461":75457,"_21806":128315,"_5":15007,"_28616":128025,"_3094":58604},[],{"_3706":75571,"_31461":75457,"_21806":128317,"_5":15007,"_28616":128025,"_3094":128318},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3706":75572,"_31461":75457,"_21806":128320,"_5":15007,"_28616":128025,"_3094":128321},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3706":75573,"_31461":75573,"_5":15367,"_3094":128323,"_31820":128324,"_21806":128325,"_28616":75573},"Claves y motores criptográficos",[51344,122764,57062,126792],[],{"_3706":75574,"_31461":75573,"_21806":128327,"_5":15007,"_28616":75573,"_3094":128328},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3706":75575,"_31461":75573,"_5":31817,"_21806":128330,"_28616":128331,"_3094":128332},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3706":75576,"_31461":75573,"_5":31817,"_21806":128334,"_28616":128335,"_3094":128336},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3706":75577,"_31461":75573,"_5":31817,"_21806":128338,"_28616":128339,"_3094":58629},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#file-system",{"_3706":75578,"_31461":75573,"_5":31817,"_21806":128341,"_28616":128342,"_3094":58633},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#hashicorp-vault",{"_3706":75579,"_31461":75573,"_5":31817,"_21806":128344,"_28616":128345,"_3094":58637},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#aws-secrets-manager",{"_3706":75580,"_31461":75573,"_5":31817,"_21806":128347,"_28616":128348,"_3094":58641},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#aws-kms",{"_3706":75581,"_31461":75573,"_5":31817,"_21806":128350,"_28616":128351,"_3094":58645},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#pkcs11",{"_3706":75582,"_31461":75573,"_5":31817,"_21806":128353,"_28616":128354,"_3094":58649},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#azure-key-vault",{"_3706":75583,"_31461":75573,"_5":31817,"_21806":128356,"_28616":128357,"_3094":128358},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3706":75584,"_31461":75573,"_5":31817,"_21806":128360,"_28616":128361,"_3094":128362},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3706":75585,"_31461":75573,"_5":31817,"_21806":128364,"_28616":128365,"_3094":128366},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3706":75586,"_31461":75573,"_5":31817,"_21806":128368,"_28616":128369,"_3094":128370},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3706":75587,"_31461":75573,"_5":31817,"_21806":128372,"_28616":128373,"_3094":128374},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3706":75588,"_31461":75573,"_5":31817,"_21806":128376,"_28616":128377,"_3094":128378},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3706":75589,"_31461":75573,"_5":31817,"_21806":128380,"_28616":128381,"_3094":128382},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3706":75590,"_31461":75573,"_5":31817,"_21806":128384,"_28616":128385,"_3094":58681},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#sign",{"_3706":75591,"_31461":75573,"_5":31817,"_21806":128387,"_28616":128388,"_3094":58685},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#verify",{"_3706":75592,"_31461":75573,"_5":31817,"_21806":128390,"_28616":128391,"_3094":128392},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3706":75593,"_31461":75573,"_5":31817,"_21806":128394,"_28616":128395,"_3094":128396},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3706":75594,"_31461":75573,"_5":31817,"_21806":128398,"_28616":128399,"_3094":128400},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3706":75595,"_31461":75573,"_21806":128402,"_5":15007,"_28616":75573,"_3094":128403},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3706":75596,"_31461":75573,"_21806":128405,"_5":15007,"_28616":75573,"_3094":128406},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3706":75597,"_31461":75573,"_21806":128408,"_5":15007,"_28616":128331,"_3094":128409},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3706":75598,"_31461":75573,"_21806":128411,"_5":15007,"_28616":128331,"_3094":128412},[],"En la práctica, permite:",{"_3706":75599,"_31461":75573,"_21806":128414,"_5":15007,"_28616":128331,"_3094":128415},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3706":75600,"_31461":75573,"_21806":128417,"_5":15007,"_28616":128331,"_3094":128418},[],"Importar claves creadas externamente.",{"_3706":75601,"_31461":75573,"_21806":128420,"_5":15007,"_28616":128331,"_3094":128421},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3706":75602,"_31461":75573,"_21806":128423,"_5":15007,"_28616":128331,"_3094":128424},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3706":75603,"_31461":75573,"_21806":128426,"_5":15007,"_28616":128335,"_3094":128427},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3706":75604,"_31461":75573,"_21806":128429,"_5":15007,"_28616":128335,"_3094":128430},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3706":75605,"_31461":75573,"_21806":128432,"_5":15007,"_28616":128335,"_3094":128433},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3706":75606,"_31461":75573,"_21806":128435,"_5":15007,"_28616":128339,"_3094":128436},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3706":75607,"_31461":75573,"_21806":128438,"_5":15007,"_28616":128342,"_3094":128439},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3706":75608,"_31461":75573,"_21806":128441,"_5":15007,"_28616":128342,"_3094":128442},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3706":75609,"_31461":75573,"_21806":128444,"_5":15007,"_28616":128345,"_3094":128445},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3706":75610,"_31461":75573,"_21806":128447,"_5":15007,"_28616":128348,"_3094":128448},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3706":75611,"_31461":75573,"_21806":128450,"_5":15007,"_28616":128351,"_3094":128451},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3706":75612,"_31461":75573,"_21806":128453,"_5":15007,"_28616":128354,"_3094":128454},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3706":75613,"_31461":75573,"_21806":128456,"_5":15007,"_28616":128354,"_3094":128457},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3706":75614,"_31461":75573,"_21806":128459,"_5":15007,"_28616":128354,"_3094":128460},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3706":75615,"_31461":75573,"_21806":128462,"_5":15007,"_28616":128354,"_3094":128463},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3706":75616,"_31461":75573,"_21806":128465,"_5":15007,"_28616":128357,"_3094":128466},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3706":75617,"_31461":75573,"_21806":128468,"_5":15007,"_28616":128357,"_3094":128469},[],"La tabla incluye los siguientes campos:",{"_3706":75618,"_31461":75573,"_21806":128471,"_5":15007,"_28616":128357,"_3094":128472},[],"**Name**: nombre descriptivo de la clave.",{"_3706":75619,"_31461":75573,"_21806":128474,"_5":15007,"_28616":128357,"_3094":128475},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3706":75620,"_31461":75573,"_21806":128477,"_5":15007,"_28616":128357,"_3094":128478},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3706":75621,"_31461":75573,"_21806":128480,"_5":15007,"_28616":128357,"_3094":128481},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3706":75622,"_31461":75573,"_21806":128483,"_5":15007,"_28616":128357,"_3094":128484},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3706":75623,"_31461":75573,"_21806":128486,"_5":15007,"_28616":128357,"_3094":128487},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3706":75624,"_31461":75573,"_21806":128489,"_5":15007,"_28616":128357,"_3094":128490},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3706":75625,"_31461":75573,"_21806":128492,"_5":15007,"_28616":128357,"_3094":128493},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3706":75626,"_31461":75573,"_21806":128495,"_5":15007,"_28616":128357,"_3094":128496},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3706":75627,"_31461":75573,"_21806":128498,"_5":15007,"_28616":128357,"_3094":128499},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3706":75628,"_31461":75573,"_21806":128501,"_5":15007,"_28616":128357,"_3094":128502},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3706":75629,"_31461":75573,"_21806":128504,"_5":15007,"_28616":128357,"_3094":128505},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3706":75630,"_31461":75573,"_21806":128507,"_5":15007,"_28616":128357,"_3094":128508},[],"**Delete Key** para eliminar la clave del sistema.",{"_3706":75631,"_31461":75573,"_21806":128510,"_5":15007,"_28616":128361,"_3094":128511},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3706":75632,"_31461":75573,"_21806":128513,"_5":15007,"_28616":128365,"_3094":128514},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3706":75633,"_31461":75573,"_21806":128516,"_5":15007,"_28616":128365,"_3094":128517},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3706":75634,"_31461":75573,"_21806":128519,"_5":15007,"_28616":128365,"_3094":128520},[],"**Key Name**: nombre único y descriptivo.",{"_3706":75635,"_31461":75573,"_21806":128522,"_5":15007,"_28616":128365,"_3094":128523},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3706":75636,"_31461":75573,"_21806":128525,"_5":15007,"_28616":128365,"_3094":128526},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3706":75637,"_31461":75573,"_21806":128528,"_5":15007,"_28616":128365,"_3094":128529},[],"**Tags**: metadatos para clasificar la clave.",{"_3706":75638,"_31461":75573,"_21806":128531,"_5":15007,"_28616":128365,"_3094":128532},[],"**Metadata**: información adicional para usos avanzados.",{"_3706":75639,"_31461":75573,"_21806":128534,"_5":15007,"_28616":128369,"_3094":128535},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3706":75640,"_31461":75573,"_21806":128537,"_5":15007,"_28616":128369,"_3094":128538},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3706":75641,"_31461":75573,"_21806":128540,"_5":15007,"_28616":128369,"_3094":128541},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3706":75642,"_31461":75573,"_21806":128543,"_5":15007,"_28616":128369,"_3094":128544},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3706":75643,"_31461":75573,"_21806":128546,"_5":15007,"_28616":128369,"_3094":128547},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3706":75644,"_31461":75573,"_21806":128549,"_5":15007,"_28616":128369,"_3094":128550},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3706":75645,"_31461":75573,"_21806":128552,"_5":15007,"_28616":128369,"_3094":128553},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3706":75646,"_31461":75573,"_21806":128555,"_5":15007,"_28616":128369,"_3094":128556},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3706":75647,"_31461":75573,"_21806":128558,"_5":15007,"_28616":128369,"_3094":128559},[],"**Metadata**: información adicional opcional.",{"_3706":75648,"_31461":75573,"_21806":128561,"_5":15007,"_28616":128369,"_3094":128562},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3706":75649,"_31461":75573,"_21806":128564,"_5":15007,"_28616":128369,"_3094":128565},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3706":75650,"_31461":75573,"_21806":128567,"_5":15007,"_28616":128373,"_3094":128568},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3706":75651,"_31461":75573,"_21806":128570,"_5":15007,"_28616":128377,"_3094":128571},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3706":75652,"_31461":75573,"_21806":128573,"_5":15007,"_28616":128377,"_3094":128574},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3706":75653,"_31461":75573,"_21806":128576,"_5":15007,"_28616":128377,"_3094":128577},[],"**Key Name**: nombre descriptivo.",{"_3706":75654,"_31461":75573,"_21806":128579,"_5":15007,"_28616":128377,"_3094":128580},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3706":75655,"_31461":75573,"_21806":128582,"_5":15007,"_28616":128377,"_3094":128583},[],"**Tags**: etiquetas asociadas.",{"_3706":75656,"_31461":75573,"_21806":128585,"_5":15007,"_28616":128377,"_3094":128586},[],"**Aliases**: nombres alternativos.",{"_3706":75657,"_31461":75573,"_21806":128588,"_5":15007,"_28616":128377,"_3094":128589},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3706":75658,"_31461":75573,"_21806":128591,"_5":15007,"_28616":128377,"_3094":128592},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3706":75659,"_31461":75573,"_21806":128594,"_5":15007,"_28616":128377,"_3094":128595},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3706":75660,"_31461":75573,"_21806":128597,"_5":15007,"_28616":128377,"_3094":128598},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3706":75661,"_31461":75573,"_21806":128600,"_5":15007,"_28616":128381,"_3094":128601},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3706":75662,"_31461":75573,"_21806":128603,"_5":15007,"_28616":128381,"_3094":128604},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3706":75663,"_31461":75573,"_21806":128606,"_5":15007,"_28616":128381,"_3094":128607},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3706":75664,"_31461":75573,"_21806":128609,"_5":15007,"_28616":128385,"_3094":128610},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3706":75665,"_31461":75573,"_21806":128612,"_5":15007,"_28616":128385,"_3094":128613},[],"Campos principales:",{"_3706":75666,"_31461":75573,"_21806":128615,"_5":15007,"_28616":128385,"_3094":128616},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3706":75667,"_31461":75573,"_21806":128618,"_5":15007,"_28616":128385,"_3094":128619},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3706":75668,"_31461":75573,"_21806":128621,"_5":15007,"_28616":128385,"_3094":128622},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3706":75669,"_31461":75573,"_21806":128624,"_5":15007,"_28616":128385,"_3094":128625},[],"**Message**: contenido que se va a firmar.",{"_3706":75670,"_31461":75573,"_21806":128627,"_5":15007,"_28616":128385,"_3094":128628},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3706":75671,"_31461":75573,"_21806":128630,"_5":15007,"_28616":128388,"_3094":128631},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3706":75672,"_31461":75573,"_21806":128633,"_5":15007,"_28616":128388,"_3094":128613},[],{"_3706":75673,"_31461":75573,"_21806":128635,"_5":15007,"_28616":128388,"_3094":128636},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3706":75674,"_31461":75573,"_21806":128638,"_5":15007,"_28616":128388,"_3094":128639},[],"**Message Type**: `Raw` o `Digest`.",{"_3706":75675,"_31461":75573,"_21806":128641,"_5":15007,"_28616":128388,"_3094":128642},[],"**Payload Encoding**: codificación del mensaje.",{"_3706":75676,"_31461":75573,"_21806":128644,"_5":15007,"_28616":128388,"_3094":128645},[],"**Message**: mensaje original o hash.",{"_3706":75677,"_31461":75573,"_21806":128647,"_5":15007,"_28616":128388,"_3094":128648},[],"**Signature**: firma que se desea comprobar.",{"_3706":75678,"_31461":75573,"_21806":128650,"_5":15007,"_28616":128388,"_3094":128651},[],"**Result**: indicador del resultado de la validación.",{"_3706":75679,"_31461":75573,"_21806":128653,"_5":15007,"_28616":128391,"_3094":128654},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3706":75680,"_31461":75573,"_21806":128656,"_5":15007,"_28616":128391,"_3094":128657},[],"Este flujo es útil para:",{"_3706":75681,"_31461":75573,"_21806":128659,"_5":15007,"_28616":128391,"_3094":128660},[],"Solicitar certificados a una CA externa.",{"_3706":75682,"_31461":75573,"_21806":128662,"_5":15007,"_28616":128391,"_3094":128663},[],"Renovar una identidad manteniendo la misma clave.",{"_3706":75683,"_31461":75573,"_21806":128665,"_5":15007,"_28616":128391,"_3094":128666},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3706":75684,"_31461":75573,"_21806":128668,"_5":15007,"_28616":128391,"_3094":128669},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3706":75685,"_31461":75573,"_21806":128671,"_5":15007,"_28616":128391,"_3094":128672},[],"**Organization (O)**: organización o empresa.",{"_3706":75686,"_31461":75573,"_21806":128674,"_5":15007,"_28616":128391,"_3094":128675},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3706":75687,"_31461":75573,"_21806":128677,"_5":15007,"_28616":128391,"_3094":128678},[],"**Country (C)**: código de país de dos letras.",{"_3706":75688,"_31461":75573,"_21806":128680,"_5":15007,"_28616":128391,"_3094":128681},[],"**State / Province (ST)**: estado o provincia.",{"_3706":75689,"_31461":75573,"_21806":128683,"_5":15007,"_28616":128391,"_3094":128684},[],"**Locality (L)**: ciudad o localidad.",{"_3706":75690,"_31461":75573,"_21806":128686,"_5":15007,"_28616":128391,"_3094":128687},[],"**Email Address**: correo de contacto.",{"_3706":75691,"_31461":75573,"_21806":128689,"_5":15007,"_28616":128391,"_3094":128690},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3706":75692,"_31461":75573,"_21806":128692,"_5":15007,"_28616":128391,"_3094":128693},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3706":75693,"_31461":75573,"_21806":128695,"_5":15007,"_28616":128395,"_3094":128696},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3706":75694,"_31461":75573,"_21806":128698,"_5":15007,"_28616":128395,"_3094":128699},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3706":75695,"_31461":75573,"_21806":128701,"_5":15007,"_28616":128399,"_3094":128702},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3706":75696,"_31461":75573,"_21806":128704,"_5":15007,"_28616":128399,"_3094":128705},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3706":75697,"_31461":75697,"_5":15367,"_3094":128707,"_31820":128708,"_21806":128709,"_28616":75697},"Validación online con OCSP",[51344,122764,57062,127463],[],{"_3706":75698,"_31461":75697,"_21806":128711,"_5":15007,"_28616":75697,"_3094":128712},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3706":75699,"_31461":75697,"_5":31817,"_21806":128714,"_28616":128715,"_3094":128716},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3706":75700,"_31461":75697,"_5":31817,"_21806":128718,"_28616":128719,"_3094":128720},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3706":75701,"_31461":75697,"_5":31817,"_21806":128722,"_28616":128723,"_3094":128724},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3706":75702,"_31461":75697,"_5":31817,"_21806":128726,"_28616":128727,"_3094":128728},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3706":75703,"_31461":75697,"_5":31817,"_21806":128730,"_28616":128731,"_3094":128732},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3706":75704,"_31461":75697,"_5":31817,"_21806":128734,"_28616":128735,"_3094":128026},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#referencias",{"_3706":75705,"_31461":75697,"_21806":128737,"_5":15007,"_28616":75697,"_3094":128738},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3706":75706,"_31461":75697,"_21806":128740,"_5":15007,"_28616":128715,"_3094":128741},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3706":75707,"_31461":75697,"_21806":128743,"_5":15007,"_28616":128715,"_3094":128744},[],"Estado del registro",{"_3706":75708,"_31461":75697,"_21806":128746,"_5":15007,"_28616":128715,"_3094":128747},[],"Respuesta firmada",{"_3706":75709,"_31461":75697,"_21806":128749,"_5":15007,"_28616":128715,"_3094":56199},[],{"_3706":75710,"_31461":75697,"_21806":128751,"_5":15007,"_28616":128715,"_3094":59049},[],{"_3706":75711,"_31461":75697,"_21806":128753,"_5":15007,"_28616":128715,"_3094":56216},[],{"_3706":75712,"_31461":75697,"_21806":128755,"_5":15007,"_28616":128715,"_3094":128756},[],"`Revoked`, con razón y fecha de revocación.",{"_3706":75713,"_31461":75697,"_21806":128758,"_5":15007,"_28616":128715,"_3094":128759},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3706":75714,"_31461":75697,"_21806":128761,"_5":15007,"_28616":128715,"_3094":128762},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3706":75715,"_31461":75697,"_21806":128764,"_5":15007,"_28616":128715,"_3094":128765},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3706":75716,"_31461":75697,"_21806":128767,"_5":15007,"_28616":128715,"_3094":128768},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3706":75717,"_31461":75697,"_21806":128770,"_5":15007,"_28616":128715,"_3094":128771},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3706":75718,"_31461":75697,"_21806":128773,"_5":15007,"_28616":128719,"_3094":128774},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3706":75719,"_31461":75697,"_21806":128776,"_5":15007,"_28616":128719,"_3094":128777},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3706":75720,"_31461":75697,"_21806":128779,"_5":15007,"_28616":128723,"_3094":128780},[],"El servicio acepta:",{"_3706":75721,"_31461":75697,"_21806":128782,"_5":15007,"_28616":128723,"_3094":124645},[],{"_3706":75722,"_31461":75697,"_21806":128784,"_5":15007,"_28616":128723,"_3094":128785},[],"Ruta del servicio VA",{"_3706":75723,"_31461":75697,"_21806":128787,"_5":15007,"_28616":128723,"_3094":128788},[],"Formato",{"_3706":75724,"_31461":75697,"_21806":128790,"_5":15007,"_28616":128723,"_3094":59089},[],{"_3706":75725,"_31461":75697,"_21806":128792,"_5":15007,"_28616":128723,"_3094":59092},[],{"_3706":75726,"_31461":75697,"_21806":128794,"_5":15007,"_28616":128723,"_3094":128795},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3706":75727,"_31461":75697,"_21806":128797,"_5":15007,"_28616":128723,"_3094":58484},[],{"_3706":75728,"_31461":75697,"_21806":128799,"_5":15007,"_28616":128723,"_3094":59100},[],{"_3706":75729,"_31461":75697,"_21806":128801,"_5":15007,"_28616":128723,"_3094":128802},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3706":75730,"_31461":75697,"_21806":128804,"_5":15007,"_28616":128723,"_3094":128805},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3706":75731,"_31461":75697,"_21806":128807,"_5":15007,"_28616":128727,"_3094":128808},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3706":75732,"_31461":75697,"_21806":128810,"_5":15007,"_28616":128727,"_3094":128811},[],"Genera la solicitud:",{"_3706":75733,"_31461":75697,"_21806":128813,"_5":15007,"_28616":128727,"_3094":128814},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3706":75734,"_31461":75697,"_21806":128816,"_5":15007,"_28616":128727,"_3094":128817},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3706":75735,"_31461":75697,"_21806":128819,"_5":15007,"_28616":128727,"_3094":128820},[],"Verifica el DER recibido:",{"_3706":75736,"_31461":75697,"_21806":128822,"_5":15007,"_28616":128727,"_3094":128823},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3706":75737,"_31461":75697,"_21806":128825,"_5":15007,"_28616":128731,"_3094":128826},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3706":75738,"_31461":75697,"_21806":128828,"_5":15007,"_28616":128731,"_3094":128829},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3706":75739,"_31461":75697,"_21806":128831,"_5":15007,"_28616":128735,"_3094":59133},[],{"_3706":75740,"_31461":75697,"_21806":128833,"_5":15007,"_28616":128735,"_3094":59136},[],{"_3706":75741,"_31461":75697,"_21806":128835,"_5":15007,"_28616":128735,"_3094":128836},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3706":75742,"_31461":75697,"_21806":128838,"_5":15007,"_28616":128735,"_3094":128321},[],{"_3706":75743,"_31461":75743,"_5":15367,"_3094":57062,"_31820":128840,"_21806":128841,"_28616":75743},[51344,122764,57062],[],{"_3706":75744,"_31461":75743,"_21806":128843,"_5":15007,"_28616":75743,"_3094":128844},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3706":75745,"_31461":75743,"_5":31817,"_21806":128846,"_28616":128847,"_3094":126118},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#empieza-aquí",{"_3706":75746,"_31461":75743,"_5":31817,"_21806":128849,"_28616":128850,"_3094":128851},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3706":75747,"_31461":75743,"_5":31817,"_21806":128853,"_28616":128854,"_3094":126638},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#capacidades-principales",{"_3706":75748,"_31461":75743,"_5":31817,"_21806":128856,"_28616":128857,"_3094":126642},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3706":75749,"_31461":75743,"_5":31817,"_21806":128859,"_28616":128860,"_3094":126646},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3706":75750,"_31461":75743,"_5":31817,"_21806":128862,"_28616":128863,"_3094":126650},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#emite-y-controla-certificados",{"_3706":75751,"_31461":75743,"_5":31817,"_21806":128865,"_28616":128866,"_3094":126658},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#publica-el-estado-de-validación",{"_3706":75752,"_31461":75743,"_5":31817,"_21806":128868,"_28616":128869,"_3094":128870},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3706":75753,"_31461":75743,"_5":31817,"_21806":128872,"_28616":128873,"_3094":127629},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#continúa",{"_3706":75754,"_31461":75743,"_21806":128875,"_5":15007,"_28616":75743,"_3094":128876},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3706":75755,"_31461":75743,"_21806":128878,"_5":15007,"_28616":128847,"_3094":128879},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3706":75756,"_31461":75743,"_21806":128881,"_5":15007,"_28616":128847,"_3094":128882},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3706":75757,"_31461":75743,"_21806":128884,"_5":15007,"_28616":128850,"_3094":128885},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3706":75758,"_31461":75743,"_21806":128887,"_5":15007,"_28616":128850,"_3094":128888},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3706":75759,"_31461":75743,"_21806":128890,"_5":15007,"_28616":128850,"_3094":128891},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3706":75760,"_31461":75743,"_21806":128893,"_5":15007,"_28616":128850,"_3094":128894},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3706":75761,"_31461":75743,"_21806":128896,"_5":15007,"_28616":128850,"_3094":128897},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3706":75762,"_31461":75743,"_21806":128899,"_5":15007,"_28616":128857,"_3094":128900},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3706":75763,"_31461":75743,"_21806":128902,"_5":15007,"_28616":128860,"_3094":128903},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3706":75764,"_31461":75743,"_21806":128905,"_5":15007,"_28616":128863,"_3094":128906},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3706":75765,"_31461":75743,"_21806":128908,"_5":15007,"_28616":128866,"_3094":128909},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3706":75766,"_31461":75743,"_21806":128911,"_5":15007,"_28616":128869,"_3094":128912},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3706":75767,"_31461":75743,"_21806":128914,"_5":15007,"_28616":128869,"_3094":128915},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3706":75768,"_31461":75743,"_21806":128917,"_5":15007,"_28616":128869,"_3094":128918},[],"su clave pública corresponda a la clave privada del cliente;",{"_3706":75769,"_31461":75743,"_21806":128920,"_5":15007,"_28616":128869,"_3094":128921},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3706":75770,"_31461":75743,"_21806":128923,"_5":15007,"_28616":128869,"_3094":128924},[],"sus fechas y usos permitan la operación;",{"_3706":75771,"_31461":75743,"_21806":128926,"_5":15007,"_28616":128869,"_3094":128927},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3706":75772,"_31461":75743,"_21806":128929,"_5":15007,"_28616":128869,"_3094":128930},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3706":75773,"_31461":75743,"_21806":128932,"_5":15007,"_28616":128873,"_3094":128933},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3706":75774,"_31461":75743,"_21806":128935,"_5":15007,"_28616":128873,"_3094":128936},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3706":75775,"_31461":75743,"_21806":128938,"_5":15007,"_28616":128873,"_3094":128939},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3706":75776,"_31461":75776,"_5":15367,"_3094":128941,"_31820":128942,"_21806":128943,"_28616":75776},"Crea tu primera CA",[51344,122764,57062,126242],[],{"_3706":75777,"_31461":75776,"_21806":128945,"_5":15007,"_28616":75776,"_3094":128946},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3706":75778,"_31461":75776,"_5":31817,"_21806":128948,"_28616":128949,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3706":75779,"_31461":75776,"_5":31817,"_21806":128951,"_28616":128952,"_3094":128953},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3706":75780,"_31461":75776,"_5":31817,"_21806":128955,"_28616":128956,"_3094":128957},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3706":75781,"_31461":75776,"_5":31817,"_21806":128959,"_28616":128960,"_3094":128961},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3706":75782,"_31461":75776,"_5":31817,"_21806":128963,"_28616":128964,"_3094":128965},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3706":75783,"_31461":75776,"_5":31817,"_21806":128967,"_28616":128968,"_3094":128969},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3706":75784,"_31461":75776,"_5":31817,"_21806":128971,"_28616":128972,"_3094":128973},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3706":75785,"_31461":75776,"_5":31817,"_21806":128975,"_28616":128976,"_3094":126489},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3706":75786,"_31461":75776,"_5":31817,"_21806":128978,"_28616":128979,"_3094":121296},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3706":75787,"_31461":75776,"_21806":128981,"_5":15007,"_28616":75776,"_3094":128982},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3706":75788,"_31461":75776,"_21806":128984,"_5":15007,"_28616":128949,"_3094":128985},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3706":75789,"_31461":75776,"_21806":128987,"_5":15007,"_28616":128949,"_3094":128988},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3706":75790,"_31461":75776,"_21806":128990,"_5":15007,"_28616":128949,"_3094":128991},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3706":75791,"_31461":75776,"_21806":128993,"_5":15007,"_28616":128949,"_3094":128994},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3706":75792,"_31461":75776,"_21806":128996,"_5":15007,"_28616":128952,"_3094":128997},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3706":75793,"_31461":75776,"_21806":128999,"_5":15007,"_28616":128952,"_3094":129000},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3706":75794,"_31461":75776,"_21806":129002,"_5":15007,"_28616":128956,"_3094":129003},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3706":75795,"_31461":75776,"_21806":129005,"_5":15007,"_28616":128956,"_3094":129006},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3706":75796,"_31461":75776,"_21806":129008,"_5":15007,"_28616":128960,"_3094":129009},[],"Selecciona **Root CA** y completa:",{"_3706":75797,"_31461":75776,"_21806":129011,"_5":15007,"_28616":128960,"_3094":59315},[],{"_3706":75798,"_31461":75776,"_21806":129013,"_5":15007,"_28616":128960,"_3094":129014},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3706":75799,"_31461":75776,"_21806":129016,"_5":15007,"_28616":128960,"_3094":129017},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3706":75800,"_31461":75776,"_21806":129019,"_5":15007,"_28616":128960,"_3094":129020},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3706":75801,"_31461":75776,"_21806":129022,"_5":15007,"_28616":128960,"_3094":129023},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3706":75802,"_31461":75776,"_21806":129025,"_5":15007,"_28616":128964,"_3094":129026},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3706":75803,"_31461":75776,"_21806":129028,"_5":15007,"_28616":128968,"_3094":129029},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3706":75804,"_31461":75776,"_21806":129031,"_5":15007,"_28616":128968,"_3094":129032},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3706":75805,"_31461":75776,"_21806":129034,"_5":15007,"_28616":128972,"_3094":129035},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3706":75806,"_31461":75776,"_21806":129037,"_5":15007,"_28616":128972,"_3094":129038},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3706":75807,"_31461":75776,"_21806":129040,"_5":15007,"_28616":128972,"_3094":129041},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3706":75808,"_31461":75776,"_21806":129043,"_5":15007,"_28616":128976,"_3094":129044},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3706":75809,"_31461":75776,"_21806":129046,"_5":15007,"_28616":128976,"_3094":129047},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3706":75810,"_31461":75776,"_21806":129049,"_5":15007,"_28616":128976,"_3094":129050},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3706":75811,"_31461":75776,"_21806":129052,"_5":15007,"_28616":128976,"_3094":129053},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3706":75812,"_31461":75776,"_21806":129055,"_5":15007,"_28616":128979,"_3094":129056},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3706":75813,"_31461":75813,"_5":15367,"_3094":129058,"_31820":129059,"_21806":129060,"_28616":75813},"Emite y verifica un certificado",[51344,122764,57062,126242],[],{"_3706":75814,"_31461":75813,"_21806":129062,"_5":15007,"_28616":75813,"_3094":129063},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3706":75815,"_31461":75813,"_5":31817,"_21806":129065,"_28616":129066,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3706":75816,"_31461":75813,"_5":31817,"_21806":129068,"_28616":129069,"_3094":129070},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3706":75817,"_31461":75813,"_5":31817,"_21806":129072,"_28616":129073,"_3094":129074},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3706":75818,"_31461":75813,"_5":31817,"_21806":129076,"_28616":129077,"_3094":129078},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3706":75819,"_31461":75813,"_5":31817,"_21806":129080,"_28616":129081,"_3094":129082},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3706":75820,"_31461":75813,"_5":31817,"_21806":129084,"_28616":129085,"_3094":129086},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3706":75821,"_31461":75813,"_5":31817,"_21806":129088,"_28616":129089,"_3094":129090},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3706":75822,"_31461":75813,"_5":31817,"_21806":129092,"_28616":129093,"_3094":129094},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3706":75823,"_31461":75813,"_5":31817,"_21806":129096,"_28616":129097,"_3094":129098},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3706":75824,"_31461":75813,"_5":31817,"_21806":129100,"_28616":129101,"_3094":129102},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3706":75825,"_31461":75813,"_5":31817,"_21806":129104,"_28616":129105,"_3094":126489},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3706":75826,"_31461":75813,"_5":31817,"_21806":129107,"_28616":129108,"_3094":121296},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3706":75827,"_31461":75813,"_21806":129110,"_5":15007,"_28616":75813,"_3094":129111},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3706":75828,"_31461":75813,"_21806":129113,"_5":15007,"_28616":129066,"_3094":129114},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3706":75829,"_31461":75813,"_21806":129116,"_5":15007,"_28616":129066,"_3094":129117},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3706":75830,"_31461":75813,"_21806":129119,"_5":15007,"_28616":129066,"_3094":129120},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3706":75831,"_31461":75813,"_21806":129122,"_5":15007,"_28616":129066,"_3094":129123},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3706":75832,"_31461":75813,"_21806":129125,"_5":15007,"_28616":129066,"_3094":129126},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3706":75833,"_31461":75813,"_21806":129128,"_5":15007,"_28616":129069,"_3094":129129},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3706":75834,"_31461":75813,"_21806":129131,"_5":15007,"_28616":129073,"_3094":129132},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3706":75835,"_31461":75813,"_21806":129134,"_5":15007,"_28616":129073,"_3094":129135},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3706":75836,"_31461":75813,"_21806":129137,"_5":15007,"_28616":129077,"_3094":129138},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3706":75837,"_31461":75813,"_21806":129140,"_5":15007,"_28616":129077,"_3094":129141},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3706":75838,"_31461":75813,"_21806":129143,"_5":15007,"_28616":129081,"_3094":129144},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3706":75839,"_31461":75813,"_21806":129146,"_5":15007,"_28616":129081,"_3094":129147},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3706":75840,"_31461":75813,"_21806":129149,"_5":15007,"_28616":129085,"_3094":129150},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3706":75841,"_31461":75813,"_21806":129152,"_5":15007,"_28616":129089,"_3094":129153},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3706":75842,"_31461":75813,"_21806":129155,"_5":15007,"_28616":129093,"_3094":129156},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3706":75843,"_31461":75813,"_21806":129158,"_5":15007,"_28616":129097,"_3094":129159},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3706":75844,"_31461":75813,"_21806":129161,"_5":15007,"_28616":129097,"_3094":129162},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3706":75845,"_31461":75813,"_21806":129164,"_5":15007,"_28616":129097,"_3094":129165},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3706":75846,"_31461":75813,"_21806":129167,"_5":15007,"_28616":129101,"_3094":129168},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3706":75847,"_31461":75813,"_21806":129170,"_5":15007,"_28616":129101,"_3094":129171},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3706":75848,"_31461":75813,"_21806":129173,"_5":15007,"_28616":129101,"_3094":129174},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3706":75849,"_31461":75813,"_21806":129176,"_5":15007,"_28616":129105,"_3094":126572},[],{"_3706":75850,"_31461":75813,"_21806":129178,"_5":15007,"_28616":129105,"_3094":125087},[],{"_3706":75851,"_31461":75813,"_21806":129180,"_5":15007,"_28616":129105,"_3094":129181},[],"La CA rechaza la emisión",{"_3706":75852,"_31461":75813,"_21806":129183,"_5":15007,"_28616":129105,"_3094":129184},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3706":75853,"_31461":75813,"_21806":129186,"_5":15007,"_28616":129105,"_3094":129187},[],"Sujeto o usos diferentes",{"_3706":75854,"_31461":75813,"_21806":129189,"_5":15007,"_28616":129105,"_3094":129190},[],"Perfil aplicado y valores solicitados.",{"_3706":75855,"_31461":75813,"_21806":129192,"_5":15007,"_28616":129105,"_3094":129193},[],"No se encuentra el emisor",{"_3706":75856,"_31461":75813,"_21806":129195,"_5":15007,"_28616":129105,"_3094":129196},[],"CA descargada y cadena intermedia necesaria.",{"_3706":75857,"_31461":75813,"_21806":129198,"_5":15007,"_28616":129105,"_3094":129199},[],"Falla la vigencia",{"_3706":75858,"_31461":75813,"_21806":129201,"_5":15007,"_28616":129105,"_3094":129202},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3706":75859,"_31461":75813,"_21806":129204,"_5":15007,"_28616":129105,"_3094":129205},[],"Los resúmenes de clave difieren",{"_3706":75860,"_31461":75813,"_21806":129207,"_5":15007,"_28616":129105,"_3094":129208},[],"Archivos de certificado y clave de la misma emisión.",{"_3706":75861,"_31461":75813,"_21806":129210,"_5":15007,"_28616":129105,"_3094":129211},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3706":75862,"_31461":75813,"_21806":129213,"_5":15007,"_28616":129108,"_3094":129214},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3706":75863,"_31461":75813,"_21806":129216,"_5":15007,"_28616":129108,"_3094":129217},[],"Gestionar certificados para inspección, estado y revocación.",{"_3706":75864,"_31461":75813,"_21806":129219,"_5":15007,"_28616":129108,"_3094":129220},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3706":75865,"_31461":75813,"_21806":129222,"_5":15007,"_28616":129108,"_3094":129223},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3706":75866,"_31461":75813,"_21806":129225,"_5":15007,"_28616":129108,"_3094":129226},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3706":75867,"_31461":75867,"_5":15367,"_3094":129228,"_31820":129229,"_21806":129230,"_28616":75867},"Primeros pasos de PKI",[51344,122764,57062,126242],[],{"_3706":75868,"_31461":75867,"_21806":129232,"_5":15007,"_28616":75867,"_3094":129233},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3706":75869,"_31461":75867,"_5":31817,"_21806":129235,"_28616":129236,"_3094":121272},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3706":75870,"_31461":75867,"_5":31817,"_21806":129238,"_28616":129239,"_3094":129240},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3706":75871,"_31461":75867,"_5":31817,"_21806":129242,"_28616":129243,"_3094":126424},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3706":75872,"_31461":75867,"_5":31817,"_21806":129245,"_28616":129246,"_3094":129247},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3706":75873,"_31461":75867,"_21806":129249,"_5":15007,"_28616":75867,"_3094":129250},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3706":75874,"_31461":75867,"_21806":129252,"_5":15007,"_28616":129236,"_3094":129253},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3706":75875,"_31461":75867,"_21806":129255,"_5":15007,"_28616":129236,"_3094":129256},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3706":75876,"_31461":75867,"_21806":129258,"_5":15007,"_28616":129236,"_3094":129259},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3706":75877,"_31461":75867,"_21806":129261,"_5":15007,"_28616":129236,"_3094":129262},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3706":75878,"_31461":75867,"_21806":129264,"_5":15007,"_28616":129236,"_3094":129265},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3706":75879,"_31461":75867,"_21806":129267,"_5":15007,"_28616":129239,"_3094":129268},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3706":75880,"_31461":75867,"_21806":129270,"_5":15007,"_28616":129239,"_3094":129271},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3706":75881,"_31461":75867,"_21806":129273,"_5":15007,"_28616":129239,"_3094":129274},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3706":75882,"_31461":75867,"_21806":129276,"_5":15007,"_28616":129239,"_3094":129277},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3706":75883,"_31461":75867,"_21806":129279,"_5":15007,"_28616":129243,"_3094":129280},[],"Archivo o recurso",{"_3706":75884,"_31461":75867,"_21806":129282,"_5":15007,"_28616":129243,"_3094":126421},[],{"_3706":75885,"_31461":75867,"_21806":129284,"_5":15007,"_28616":129243,"_3094":129285},[],"CA raíz activa y `ca.pem`",{"_3706":75886,"_31461":75867,"_21806":129287,"_5":15007,"_28616":129243,"_3094":129288},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3706":75887,"_31461":75867,"_21806":129290,"_5":15007,"_28616":129243,"_3094":129291},[],"Certificado final y `device.crt`",{"_3706":75888,"_31461":75867,"_21806":129293,"_5":15007,"_28616":129243,"_3094":129294},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3706":75889,"_31461":75867,"_21806":129296,"_5":15007,"_28616":129243,"_3094":129297},[],"Clave privada `device.key`",{"_3706":75890,"_31461":75867,"_21806":129299,"_5":15007,"_28616":129243,"_3094":129300},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3706":75891,"_31461":75867,"_21806":129302,"_5":15007,"_28616":129243,"_3094":129303},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3706":75892,"_31461":75867,"_21806":129305,"_5":15007,"_28616":129246,"_3094":129306},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3706":75893,"_31461":75867,"_21806":129308,"_5":15007,"_28616":129246,"_3094":129309},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3706":75894,"_31461":75867,"_21806":129311,"_5":15007,"_28616":129246,"_3094":129312},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3706":75895,"_31461":75895,"_5":15367,"_3094":129314,"_31820":129315,"_21806":129317,"_28616":75895},"Resolución de problemas PKI",[51344,122764,57062,129316],"Resolución de problemas",[],{"_3706":75896,"_31461":75895,"_21806":129319,"_5":15007,"_28616":75895,"_3094":129320},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3706":75897,"_31461":75895,"_5":31817,"_21806":129322,"_28616":129323,"_3094":129324},[],"/docs/pr-preview/pr-81/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3706":75898,"_31461":75895,"_5":31817,"_21806":129326,"_28616":129327,"_3094":129328},[],"/docs/pr-preview/pr-81/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3706":75899,"_31461":75895,"_5":31817,"_21806":129330,"_28616":129331,"_3094":129332},[],"/docs/pr-preview/pr-81/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3706":75900,"_31461":75895,"_21806":129334,"_5":15007,"_28616":75895,"_3094":129335},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3706":75901,"_31461":75895,"_21806":129337,"_5":15007,"_28616":75895,"_3094":129338},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3706":75902,"_31461":75895,"_21806":129340,"_5":15007,"_28616":129323,"_3094":126421},[],{"_3706":75903,"_31461":75895,"_21806":129342,"_5":15007,"_28616":129323,"_3094":125087},[],{"_3706":75904,"_31461":75895,"_21806":129344,"_5":15007,"_28616":129323,"_3094":121296},[],{"_3706":75905,"_31461":75895,"_21806":129346,"_5":15007,"_28616":129323,"_3094":55904},[],{"_3706":75906,"_31461":75895,"_21806":129348,"_5":15007,"_28616":129323,"_3094":129349},[],"Existe, está activa y sus fechas son utilizables.",{"_3706":75907,"_31461":75895,"_21806":129351,"_5":15007,"_28616":129323,"_3094":129352},[],"Autoridades.",{"_3706":75908,"_31461":75895,"_21806":129354,"_5":15007,"_28616":129323,"_3094":129355},[],"Clave",{"_3706":75909,"_31461":75895,"_21806":129357,"_5":15007,"_28616":129323,"_3094":129358},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3706":75910,"_31461":75895,"_21806":129360,"_5":15007,"_28616":129323,"_3094":129361},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3706":75911,"_31461":75895,"_21806":129363,"_5":15007,"_28616":129323,"_3094":59669},[],{"_3706":75912,"_31461":75895,"_21806":129365,"_5":15007,"_28616":129323,"_3094":129366},[],"PEM correcto y firma verificable.",{"_3706":75913,"_31461":75895,"_21806":129368,"_5":15007,"_28616":129323,"_3094":59675},[],{"_3706":75914,"_31461":75895,"_21806":129370,"_5":15007,"_28616":129323,"_3094":129371},[],"Perfil",{"_3706":75915,"_31461":75895,"_21806":129373,"_5":15007,"_28616":129323,"_3094":129374},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3706":75916,"_31461":75895,"_21806":129376,"_5":15007,"_28616":129323,"_3094":129377},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3706":75917,"_31461":75895,"_21806":129379,"_5":15007,"_28616":129323,"_3094":126572},[],{"_3706":75918,"_31461":75895,"_21806":129381,"_5":15007,"_28616":129323,"_3094":129382},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3706":75919,"_31461":75895,"_21806":129384,"_5":15007,"_28616":129323,"_3094":129385},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3706":75920,"_31461":75895,"_21806":129387,"_5":15007,"_28616":129323,"_3094":129388},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3706":75921,"_31461":75895,"_21806":129390,"_5":15007,"_28616":129323,"_3094":129391},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3706":75922,"_31461":75895,"_21806":129393,"_5":15007,"_28616":129323,"_3094":129394},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3706":75923,"_31461":75895,"_21806":129396,"_5":15007,"_28616":129327,"_3094":129397},[],"Revisa cada frontera por separado:",{"_3706":75924,"_31461":75895,"_21806":129399,"_5":15007,"_28616":129327,"_3094":129400},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3706":75925,"_31461":75895,"_21806":129402,"_5":15007,"_28616":129327,"_3094":129403},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3706":75926,"_31461":75895,"_21806":129405,"_5":15007,"_28616":129327,"_3094":129406},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3706":75927,"_31461":75895,"_21806":129408,"_5":15007,"_28616":129327,"_3094":129409},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3706":75928,"_31461":75895,"_21806":129411,"_5":15007,"_28616":129327,"_3094":129412},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3706":75929,"_31461":75895,"_21806":129414,"_5":15007,"_28616":129327,"_3094":129415},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3706":75930,"_31461":75895,"_21806":129417,"_5":15007,"_28616":129331,"_3094":129418},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3706":75931,"_31461":75895,"_21806":129420,"_5":15007,"_28616":129331,"_3094":129421},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3706":75932,"_31461":75932,"_5":15367,"_3094":129423,"_31820":129424,"_21806":129425,"_28616":75932},"Seguridad",[51344],[],{"_3706":75933,"_31461":75932,"_21806":129427,"_5":15007,"_28616":75932,"_3094":129428},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3706":75934,"_31461":75932,"_5":31817,"_21806":129430,"_28616":129431,"_3094":129432},[],"/docs/pr-preview/pr-81/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3706":75935,"_31461":75932,"_5":31817,"_21806":129434,"_28616":129435,"_3094":129436},[],"/docs/pr-preview/pr-81/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3706":75936,"_31461":75932,"_5":31817,"_21806":129438,"_28616":129439,"_3094":129440},[],"/docs/pr-preview/pr-81/es/security#versiones-soportadas","Versiones soportadas",{"_3706":75937,"_31461":75932,"_5":31817,"_21806":129442,"_28616":129443,"_3094":129444},[],"/docs/pr-preview/pr-81/es/security#divulgación-responsable","Divulgación responsable",{"_3706":75938,"_31461":75932,"_21806":129446,"_5":15007,"_28616":75932,"_3094":129447},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3706":75939,"_31461":75932,"_21806":129449,"_5":15007,"_28616":129431,"_3094":129450},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3706":75940,"_31461":75932,"_21806":129452,"_5":15007,"_28616":129431,"_3094":129453},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3706":75941,"_31461":75932,"_21806":129455,"_5":15007,"_28616":129431,"_3094":15646},[],{"_3706":75942,"_31461":75932,"_21806":129457,"_5":15007,"_28616":129431,"_3094":15575},[],{"_3706":75943,"_31461":75932,"_21806":129459,"_5":15007,"_28616":129431,"_3094":15633},[],{"_3706":75944,"_31461":75932,"_21806":129461,"_5":15007,"_28616":129431,"_3094":129462},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3706":75945,"_31461":75932,"_21806":129464,"_5":15007,"_28616":129431,"_3094":129465},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3706":75946,"_31461":75932,"_21806":129467,"_5":15007,"_28616":129435,"_3094":129468},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3706":75947,"_31461":75932,"_21806":129470,"_5":15007,"_28616":129435,"_3094":129471},[],"No incluyas en el reporte:",{"_3706":75948,"_31461":75932,"_21806":129473,"_5":15007,"_28616":129435,"_3094":129474},[],"Credenciales, tokens o claves privadas",{"_3706":75949,"_31461":75932,"_21806":129476,"_5":15007,"_28616":129435,"_3094":129477},[],"Datos de clientes o información identificable de clientes",{"_3706":75950,"_31461":75932,"_21806":129479,"_5":15007,"_28616":129435,"_3094":129480},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3706":75951,"_31461":75932,"_21806":129482,"_5":15007,"_28616":129439,"_3094":129483},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3706":75952,"_31461":75932,"_21806":129485,"_5":15007,"_28616":129439,"_3094":129486},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3706":75953,"_31461":75932,"_21806":129488,"_5":15007,"_28616":129443,"_3094":129489},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3706":75954,"_31461":75932,"_21806":129491,"_5":15007,"_28616":129443,"_3094":129492},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3706":75955,"_31461":75932,"_21806":129494,"_5":15007,"_28616":129443,"_3094":129495},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3706":75956,"_31461":75932,"_21806":129497,"_5":15007,"_28616":129443,"_3094":129498},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3706":75957,"_31461":75932,"_21806":129500,"_5":15007,"_28616":129443,"_3094":129501},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3706":75958,"_31461":75958,"_5":15367,"_3094":129503,"_31820":129504,"_21806":129506,"_28616":75958},"3.8.0 a 4.0.0",[51344,129505],"Actualizaciones",[],{"_3706":75959,"_31461":75958,"_21806":129508,"_5":15007,"_28616":75958,"_3094":129509},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3706":75960,"_31461":75958,"_5":31817,"_21806":129511,"_28616":129512,"_3094":129513},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3706":75961,"_31461":75958,"_5":31817,"_21806":129515,"_28616":129516,"_3094":129517},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3706":75962,"_31461":75958,"_5":31817,"_21806":129519,"_28616":129520,"_3094":129521},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3706":75963,"_31461":75958,"_5":31817,"_21806":129523,"_28616":129524,"_3094":129525},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3706":75964,"_31461":75958,"_5":31817,"_21806":129527,"_28616":129528,"_3094":129529},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3706":75965,"_31461":75958,"_5":31817,"_21806":129531,"_28616":129532,"_3094":129533},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3706":75966,"_31461":75958,"_5":31817,"_21806":129535,"_28616":129536,"_3094":59844},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3706":75967,"_31461":75958,"_5":31817,"_21806":129538,"_28616":129539,"_3094":129540},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3706":75968,"_31461":75958,"_5":31817,"_21806":129542,"_28616":129543,"_3094":129544},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3706":75969,"_31461":75958,"_5":31817,"_21806":129546,"_28616":129547,"_3094":129548},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3706":75970,"_31461":75958,"_5":31817,"_21806":129550,"_28616":129551,"_3094":121867},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3706":75971,"_31461":75958,"_5":31817,"_21806":129553,"_28616":129554,"_3094":129555},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3706":75972,"_31461":75958,"_5":31817,"_21806":129557,"_28616":129558,"_3094":129559},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3706":75973,"_31461":75958,"_5":31817,"_21806":129561,"_28616":129562,"_3094":129563},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3706":75974,"_31461":75958,"_5":31817,"_21806":129565,"_28616":129566,"_3094":129567},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3706":75975,"_31461":75958,"_5":31817,"_21806":129569,"_28616":129570,"_3094":129571},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3706":75976,"_31461":75958,"_5":31817,"_21806":129573,"_28616":129574,"_3094":129575},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3706":75977,"_31461":75958,"_5":31817,"_21806":129577,"_28616":129578,"_3094":129579},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3706":75978,"_31461":75958,"_5":31817,"_21806":129581,"_28616":129582,"_3094":129583},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3706":75979,"_31461":75958,"_5":31817,"_21806":129585,"_28616":129586,"_3094":129587},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3706":75980,"_31461":75958,"_5":31817,"_21806":129589,"_28616":129590,"_3094":129591},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3706":75981,"_31461":75958,"_5":31817,"_21806":129593,"_28616":129594,"_3094":129595},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3706":75982,"_31461":75958,"_5":31817,"_21806":129597,"_28616":129598,"_3094":129599},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3706":75983,"_31461":75958,"_5":31817,"_21806":129601,"_28616":129602,"_3094":129603},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3706":75984,"_31461":75958,"_5":31817,"_21806":129605,"_28616":129606,"_3094":129607},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3706":75985,"_31461":75958,"_5":31817,"_21806":129609,"_28616":129610,"_3094":129611},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3706":75986,"_31461":75958,"_5":31817,"_21806":129613,"_28616":129614,"_3094":129615},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3706":75987,"_31461":75958,"_5":31817,"_21806":129617,"_28616":129618,"_3094":129619},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3706":75988,"_31461":75958,"_5":31817,"_21806":129621,"_28616":129622,"_3094":129623},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3706":75989,"_31461":75958,"_5":31817,"_21806":129625,"_28616":129626,"_3094":129627},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3706":75990,"_31461":75958,"_5":31817,"_21806":129629,"_28616":129630,"_3094":129631},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3706":75991,"_31461":75958,"_5":31817,"_21806":129633,"_28616":129634,"_3094":129635},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3706":75992,"_31461":75958,"_5":31817,"_21806":129637,"_28616":129638,"_3094":129639},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3706":75993,"_31461":75958,"_5":31817,"_21806":129641,"_28616":129642,"_3094":129643},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3706":75994,"_31461":75958,"_5":31817,"_21806":129645,"_28616":129646,"_3094":129647},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3706":75995,"_31461":75958,"_5":31817,"_21806":129649,"_28616":129650,"_3094":129651},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3706":75996,"_31461":75958,"_5":31817,"_21806":129653,"_28616":129654,"_3094":129655},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3706":75997,"_31461":75958,"_5":31817,"_21806":129657,"_28616":129658,"_3094":129659},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3706":75998,"_31461":75958,"_5":31817,"_21806":129661,"_28616":129662,"_3094":129663},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3706":75999,"_31461":75958,"_5":31817,"_21806":129665,"_28616":129666,"_3094":129667},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3706":76000,"_31461":75958,"_5":31817,"_21806":129669,"_28616":129670,"_3094":129671},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3706":76001,"_31461":75958,"_5":31817,"_21806":129673,"_28616":129674,"_3094":129675},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3706":76002,"_31461":75958,"_5":31817,"_21806":129677,"_28616":129678,"_3094":129679},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3706":76003,"_31461":75958,"_5":31817,"_21806":129681,"_28616":129682,"_3094":129683},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3706":76004,"_31461":75958,"_5":31817,"_21806":129685,"_28616":129686,"_3094":125435},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3706":76005,"_31461":75958,"_5":31817,"_21806":129688,"_28616":129689,"_3094":129690},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3706":76006,"_31461":75958,"_5":31817,"_21806":129692,"_28616":129693,"_3094":129694},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3706":76007,"_31461":75958,"_21806":129696,"_5":15007,"_28616":75958,"_3094":129697},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3706":76008,"_31461":75958,"_21806":129699,"_5":15007,"_28616":75958,"_3094":129700},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3706":76009,"_31461":75958,"_21806":129702,"_5":15007,"_28616":75958,"_3094":129703},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3706":76010,"_31461":75958,"_21806":129705,"_5":15007,"_28616":75958,"_3094":129706},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3706":76011,"_31461":75958,"_21806":129708,"_5":15007,"_28616":75958,"_3094":129709},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3706":76012,"_31461":75958,"_21806":129711,"_5":15007,"_28616":75958,"_3094":129712},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3706":76013,"_31461":75958,"_21806":129714,"_5":15007,"_28616":75958,"_3094":129715},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3706":76014,"_31461":75958,"_21806":129717,"_5":15007,"_28616":129516,"_3094":129718},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3706":76015,"_31461":75958,"_21806":129720,"_5":15007,"_28616":129516,"_3094":129721},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3706":76016,"_31461":75958,"_21806":129723,"_5":15007,"_28616":129520,"_3094":129724},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3706":76017,"_31461":75958,"_21806":129726,"_5":15007,"_28616":129520,"_3094":129727},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3706":76018,"_31461":75958,"_21806":129729,"_5":15007,"_28616":129524,"_3094":129730},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP, que en AMQP el broker elimina automáticamente cuando la instancia se detiene (véase Eventos de dispositivo).",{"_3706":76019,"_31461":75958,"_21806":129732,"_5":15007,"_28616":129528,"_3094":129733},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3706":76020,"_31461":75958,"_21806":129735,"_5":15007,"_28616":129528,"_3094":129736},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3706":76021,"_31461":75958,"_21806":129738,"_5":15007,"_28616":129528,"_3094":129739},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3706":76022,"_31461":75958,"_21806":129741,"_5":15007,"_28616":129528,"_3094":129742},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3706":76023,"_31461":75958,"_21806":129744,"_5":15007,"_28616":129528,"_3094":129745},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3706":76024,"_31461":75958,"_21806":129747,"_5":15007,"_28616":129532,"_3094":129748},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3706":76025,"_31461":75958,"_21806":129750,"_5":15007,"_28616":129532,"_3094":129751},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3706":76026,"_31461":75958,"_21806":129753,"_5":15007,"_28616":129532,"_3094":129754},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3706":76027,"_31461":75958,"_21806":129756,"_5":15007,"_28616":129532,"_3094":129757},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3706":76028,"_31461":75958,"_21806":129759,"_5":15007,"_28616":129532,"_3094":129760},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3706":76029,"_31461":75958,"_21806":129762,"_5":15007,"_28616":129532,"_3094":129763},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3706":76030,"_31461":75958,"_21806":129765,"_5":15007,"_28616":129536,"_3094":129766},[],"Cambio",{"_3706":76031,"_31461":75958,"_21806":129768,"_5":15007,"_28616":129536,"_3094":129769},[],"A quién afecta",{"_3706":76032,"_31461":75958,"_21806":129771,"_5":15007,"_28616":129536,"_3094":129772},[],"Gravedad",{"_3706":76033,"_31461":75958,"_21806":129774,"_5":15007,"_28616":129536,"_3094":128245},[],{"_3706":76034,"_31461":75958,"_21806":129776,"_5":15007,"_28616":129536,"_3094":129544},[],{"_3706":76035,"_31461":75958,"_21806":129778,"_5":15007,"_28616":129536,"_3094":129779},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3706":76036,"_31461":75958,"_21806":129781,"_5":15007,"_28616":129536,"_3094":129782},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3706":76037,"_31461":75958,"_21806":129784,"_5":15007,"_28616":129536,"_3094":129785},[],"Copiar los datos a los volúmenes nuevos",{"_3706":76038,"_31461":75958,"_21806":129787,"_5":15007,"_28616":129536,"_3094":129548},[],{"_3706":76039,"_31461":75958,"_21806":129789,"_5":15007,"_28616":129536,"_3094":129790},[],"Todas las releases de Helm",{"_3706":76040,"_31461":75958,"_21806":129792,"_5":15007,"_28616":129536,"_3094":129793},[],"Alta: `helm upgrade` falla",{"_3706":76041,"_31461":75958,"_21806":129795,"_5":15007,"_28616":129536,"_3094":129796},[],"Eliminar o renombrar las claves heredadas",{"_3706":76042,"_31461":75958,"_21806":129798,"_5":15007,"_28616":129536,"_3094":121867},[],{"_3706":76043,"_31461":75958,"_21806":129800,"_5":15007,"_28616":129536,"_3094":129790},[],{"_3706":76044,"_31461":75958,"_21806":129802,"_5":15007,"_28616":129536,"_3094":129803},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3706":76045,"_31461":75958,"_21806":129805,"_5":15007,"_28616":129536,"_3094":129806},[],"Crear primero los Secrets; consulta el paso 2",{"_3706":76046,"_31461":75958,"_21806":129808,"_5":15007,"_28616":129536,"_3094":129555},[],{"_3706":76047,"_31461":75958,"_21806":129810,"_5":15007,"_28616":129536,"_3094":129811},[],"Todos los despliegues",{"_3706":76048,"_31461":75958,"_21806":129813,"_5":15007,"_28616":129536,"_3094":129814},[],"Alta: sin principal de bootstrap no hay administrador",{"_3706":76049,"_31461":75958,"_21806":129816,"_5":15007,"_28616":129536,"_3094":129817},[],"Configurar `services.authz`",{"_3706":76050,"_31461":75958,"_21806":129819,"_5":15007,"_28616":129536,"_3094":129559},[],{"_3706":76051,"_31461":75958,"_21806":129821,"_5":15007,"_28616":129536,"_3094":129790},[],{"_3706":76052,"_31461":75958,"_21806":129823,"_5":15007,"_28616":129536,"_3094":129824},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3706":76053,"_31461":75958,"_21806":129826,"_5":15007,"_28616":129536,"_3094":129827},[],"Mover JWKS y roles a `services.authz`",{"_3706":76054,"_31461":75958,"_21806":129829,"_5":15007,"_28616":129536,"_3094":129579},[],{"_3706":76055,"_31461":75958,"_21806":129831,"_5":15007,"_28616":129536,"_3094":129832},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3706":76056,"_31461":75958,"_21806":129834,"_5":15007,"_28616":129536,"_3094":129835},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3706":76057,"_31461":75958,"_21806":129837,"_5":15007,"_28616":129536,"_3094":129838},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3706":76058,"_31461":75958,"_21806":129840,"_5":15007,"_28616":129536,"_3094":129583},[],{"_3706":76059,"_31461":75958,"_21806":129842,"_5":15007,"_28616":129536,"_3094":129843},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3706":76060,"_31461":75958,"_21806":129845,"_5":15007,"_28616":129536,"_3094":129846},[],"Alta: el backend ya no arranca con ellos",{"_3706":76061,"_31461":75958,"_21806":129848,"_5":15007,"_28616":129536,"_3094":129849},[],"Pasar a PostgreSQL antes de actualizar",{"_3706":76062,"_31461":75958,"_21806":129851,"_5":15007,"_28616":129536,"_3094":129631},[],{"_3706":76063,"_31461":75958,"_21806":129853,"_5":15007,"_28616":129536,"_3094":129854},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3706":76064,"_31461":75958,"_21806":129856,"_5":15007,"_28616":129536,"_3094":129857},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3706":76065,"_31461":75958,"_21806":129859,"_5":15007,"_28616":129536,"_3094":129860},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3706":76066,"_31461":75958,"_21806":129862,"_5":15007,"_28616":129536,"_3094":129863},[],"Webhooks con referencias a archivos",{"_3706":76067,"_31461":75958,"_21806":129865,"_5":15007,"_28616":129536,"_3094":129866},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3706":76068,"_31461":75958,"_21806":129868,"_5":15007,"_28616":129536,"_3094":129869},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3706":76069,"_31461":75958,"_21806":129871,"_5":15007,"_28616":129536,"_3094":129872},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3706":76070,"_31461":75958,"_21806":129874,"_5":15007,"_28616":129536,"_3094":129563},[],{"_3706":76071,"_31461":75958,"_21806":129876,"_5":15007,"_28616":129536,"_3094":129877},[],"Releases con identidades por servicio o material de claves montado",{"_3706":76072,"_31461":75958,"_21806":129879,"_5":15007,"_28616":129536,"_3094":129880},[],"Media: los servicios no pueden leer sus archivos",{"_3706":76073,"_31461":75958,"_21806":129882,"_5":15007,"_28616":129536,"_3094":129883},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3706":76074,"_31461":75958,"_21806":129885,"_5":15007,"_28616":129536,"_3094":129567},[],{"_3706":76075,"_31461":75958,"_21806":129887,"_5":15007,"_28616":129536,"_3094":129888},[],"Releases que definen `amqp.tls`",{"_3706":76076,"_31461":75958,"_21806":129890,"_5":15007,"_28616":129536,"_3094":129891},[],"Media: los clientes se conectan al puerto equivocado",{"_3706":76077,"_31461":75958,"_21806":129893,"_5":15007,"_28616":129536,"_3094":129894},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3706":76078,"_31461":75958,"_21806":129896,"_5":15007,"_28616":129536,"_3094":129587},[],{"_3706":76079,"_31461":75958,"_21806":129898,"_5":15007,"_28616":129536,"_3094":129899},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3706":76080,"_31461":75958,"_21806":129901,"_5":15007,"_28616":129536,"_3094":129902},[],"Media: las claves de CA quedan sin gestionar",{"_3706":76081,"_31461":75958,"_21806":129904,"_5":15007,"_28616":129536,"_3094":129905},[],"Ejecutar la migración de CA a KMS",{"_3706":76082,"_31461":75958,"_21806":129907,"_5":15007,"_28616":129536,"_3094":129908},[],"Verificación del certificado del receptor",{"_3706":76083,"_31461":75958,"_21806":129910,"_5":15007,"_28616":129536,"_3094":129911},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3706":76084,"_31461":75958,"_21806":129913,"_5":15007,"_28616":129536,"_3094":129914},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3706":76085,"_31461":75958,"_21806":129916,"_5":15007,"_28616":129536,"_3094":129917},[],"Poner `insecure_skip_verify` a `false`",{"_3706":76086,"_31461":75958,"_21806":129919,"_5":15007,"_28616":129536,"_3094":129603},[],{"_3706":76087,"_31461":75958,"_21806":129921,"_5":15007,"_28616":129536,"_3094":129922},[],"Scripts y consolas que editan DMS por API",{"_3706":76088,"_31461":75958,"_21806":129924,"_5":15007,"_28616":129536,"_3094":129925},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3706":76089,"_31461":75958,"_21806":129927,"_5":15007,"_28616":129536,"_3094":129928},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3706":76090,"_31461":75958,"_21806":129930,"_5":15007,"_28616":129536,"_3094":129607},[],{"_3706":76091,"_31461":75958,"_21806":129932,"_5":15007,"_28616":129536,"_3094":129933},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3706":76092,"_31461":75958,"_21806":129935,"_5":15007,"_28616":129536,"_3094":129936},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3706":76093,"_31461":75958,"_21806":129938,"_5":15007,"_28616":129536,"_3094":129939},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3706":76094,"_31461":75958,"_21806":129941,"_5":15007,"_28616":129536,"_3094":129627},[],{"_3706":76095,"_31461":75958,"_21806":129943,"_5":15007,"_28616":129536,"_3094":129944},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3706":76096,"_31461":75958,"_21806":129946,"_5":15007,"_28616":129536,"_3094":129947},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3706":76097,"_31461":75958,"_21806":129949,"_5":15007,"_28616":129536,"_3094":129950},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3706":76098,"_31461":75958,"_21806":129952,"_5":15007,"_28616":129536,"_3094":129635},[],{"_3706":76099,"_31461":75958,"_21806":129954,"_5":15007,"_28616":129536,"_3094":129955},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3706":76100,"_31461":75958,"_21806":129957,"_5":15007,"_28616":129536,"_3094":129958},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3706":76101,"_31461":75958,"_21806":129960,"_5":15007,"_28616":129536,"_3094":129961},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3706":76102,"_31461":75958,"_21806":129963,"_5":15007,"_28616":129536,"_3094":129639},[],{"_3706":76103,"_31461":75958,"_21806":129965,"_5":15007,"_28616":129536,"_3094":129966},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3706":76104,"_31461":75958,"_21806":129968,"_5":15007,"_28616":129536,"_3094":129969},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3706":76105,"_31461":75958,"_21806":129971,"_5":15007,"_28616":129536,"_3094":129972},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3706":76106,"_31461":75958,"_21806":129974,"_5":15007,"_28616":129536,"_3094":129623},[],{"_3706":76107,"_31461":75958,"_21806":129976,"_5":15007,"_28616":129536,"_3094":129977},[],"Consumidores que leen el campo `events` del dispositivo",{"_3706":76108,"_31461":75958,"_21806":129979,"_5":15007,"_28616":129536,"_3094":129980},[],"Media: el campo desaparece",{"_3706":76109,"_31461":75958,"_21806":129982,"_5":15007,"_28616":129536,"_3094":129983},[],"Usar los nuevos endpoints de eventos",{"_3706":76110,"_31461":75958,"_21806":129985,"_5":15007,"_28616":129536,"_3094":129651},[],{"_3706":76111,"_31461":75958,"_21806":129987,"_5":15007,"_28616":129536,"_3094":129988},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3706":76112,"_31461":75958,"_21806":129990,"_5":15007,"_28616":129536,"_3094":129991},[],"Media: la migración de la VA aborta",{"_3706":76113,"_31461":75958,"_21806":129993,"_5":15007,"_28616":129536,"_3094":129994},[],"Corregir los roles afectados antes de actualizar",{"_3706":76114,"_31461":75958,"_21806":129996,"_5":15007,"_28616":129536,"_3094":129571},[],{"_3706":76115,"_31461":75958,"_21806":129998,"_5":15007,"_28616":129536,"_3094":129999},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3706":76116,"_31461":75958,"_21806":130001,"_5":15007,"_28616":129536,"_3094":130002},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3706":76117,"_31461":75958,"_21806":130004,"_5":15007,"_28616":129536,"_3094":130005},[],"Actualizar el archivo de values",{"_3706":76118,"_31461":75958,"_21806":130007,"_5":15007,"_28616":129536,"_3094":129615},[],{"_3706":76119,"_31461":75958,"_21806":130009,"_5":15007,"_28616":129536,"_3094":130010},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3706":76120,"_31461":75958,"_21806":130012,"_5":15007,"_28616":129536,"_3094":130013},[],"Baja: prevalece el ID de la URL",{"_3706":76121,"_31461":75958,"_21806":130015,"_5":15007,"_28616":129536,"_3094":130016},[],"Enviar el ID en la URL",{"_3706":76122,"_31461":75958,"_21806":130018,"_5":15007,"_28616":129536,"_3094":129643},[],{"_3706":76123,"_31461":75958,"_21806":130020,"_5":15007,"_28616":129536,"_3094":130021},[],"Clientes que envían un `id` al crear o importar CAs",{"_3706":76124,"_31461":75958,"_21806":130023,"_5":15007,"_28616":129536,"_3094":130024},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3706":76125,"_31461":75958,"_21806":130026,"_5":15007,"_28616":129536,"_3094":130027},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3706":76126,"_31461":75958,"_21806":130029,"_5":15007,"_28616":129536,"_3094":129647},[],{"_3706":76127,"_31461":75958,"_21806":130031,"_5":15007,"_28616":129536,"_3094":130032},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3706":76128,"_31461":75958,"_21806":130034,"_5":15007,"_28616":129536,"_3094":130035},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3706":76129,"_31461":75958,"_21806":130037,"_5":15007,"_28616":129536,"_3094":130038},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3706":76130,"_31461":75958,"_21806":130040,"_5":15007,"_28616":129536,"_3094":129619},[],{"_3706":76131,"_31461":75958,"_21806":130042,"_5":15007,"_28616":129536,"_3094":130043},[],"Consumidores que comparan el `type` del certificado",{"_3706":76132,"_31461":75958,"_21806":130045,"_5":15007,"_28616":129536,"_3094":130046},[],"Baja: dos valores cambian de nombre",{"_3706":76133,"_31461":75958,"_21806":130048,"_5":15007,"_28616":129536,"_3094":130049},[],"Adaptar los consumidores",{"_3706":76134,"_31461":75958,"_21806":130051,"_5":15007,"_28616":129536,"_3094":129611},[],{"_3706":76135,"_31461":75958,"_21806":130053,"_5":15007,"_28616":129536,"_3094":130054},[],"Cualquier DMS",{"_3706":76136,"_31461":75958,"_21806":130056,"_5":15007,"_28616":129536,"_3094":130057},[],"Baja: solo informativo",{"_3706":76137,"_31461":75958,"_21806":130059,"_5":15007,"_28616":129536,"_3094":130060},[],"Revisar ambos bloques antes de editar",{"_3706":76138,"_31461":75958,"_21806":130062,"_5":15007,"_28616":129543,"_3094":130063},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3706":76139,"_31461":75958,"_21806":130065,"_5":15007,"_28616":129543,"_3094":130066},[],"El paso 4 de la guía de migración copia los datos.",{"_3706":76140,"_31461":75958,"_21806":130068,"_5":15007,"_28616":129547,"_3094":130069},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3706":76141,"_31461":75958,"_21806":130071,"_5":15007,"_28616":129551,"_3094":130072},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3706":76142,"_31461":75958,"_21806":130074,"_5":15007,"_28616":129551,"_3094":130075},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3706":76143,"_31461":75958,"_21806":130077,"_5":15007,"_28616":129554,"_3094":130078},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3706":76144,"_31461":75958,"_21806":130080,"_5":15007,"_28616":129558,"_3094":130081},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3706":76145,"_31461":75958,"_21806":130083,"_5":15007,"_28616":129562,"_3094":130084},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3706":76146,"_31461":75958,"_21806":130086,"_5":15007,"_28616":129562,"_3094":130087},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3706":76147,"_31461":75958,"_21806":130089,"_5":15007,"_28616":129562,"_3094":130090},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3706":76148,"_31461":75958,"_21806":130092,"_5":15007,"_28616":129566,"_3094":130093},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3706":76149,"_31461":75958,"_21806":130095,"_5":15007,"_28616":129570,"_3094":130096},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3706":76150,"_31461":75958,"_21806":130098,"_5":15007,"_28616":129570,"_3094":130099},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3706":76151,"_31461":75958,"_21806":130101,"_5":15007,"_28616":129570,"_3094":130102},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3706":76152,"_31461":75958,"_21806":130104,"_5":15007,"_28616":129570,"_3094":130105},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3706":76153,"_31461":75958,"_21806":130107,"_5":15007,"_28616":129570,"_3094":130108},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3706":76154,"_31461":75958,"_21806":130110,"_5":15007,"_28616":129570,"_3094":130111},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3706":76155,"_31461":75958,"_21806":130113,"_5":15007,"_28616":129578,"_3094":130114},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3706":76156,"_31461":75958,"_21806":130116,"_5":15007,"_28616":129578,"_3094":130117},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3706":76157,"_31461":75958,"_21806":130119,"_5":15007,"_28616":129578,"_3094":130120},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3706":76158,"_31461":75958,"_21806":130122,"_5":15007,"_28616":129578,"_3094":130123},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3706":76159,"_31461":75958,"_21806":130125,"_5":15007,"_28616":129578,"_3094":130126},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3706":76160,"_31461":75958,"_21806":130128,"_5":15007,"_28616":129582,"_3094":130129},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3706":76161,"_31461":75958,"_21806":130131,"_5":15007,"_28616":129586,"_3094":130132},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3706":76162,"_31461":75958,"_21806":130134,"_5":15007,"_28616":129586,"_3094":130135},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3706":76163,"_31461":75958,"_21806":130137,"_5":15007,"_28616":129586,"_3094":130138},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3706":76164,"_31461":75958,"_21806":130140,"_5":15007,"_28616":129586,"_3094":130141},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3706":76165,"_31461":75958,"_21806":130143,"_5":15007,"_28616":129586,"_3094":130144},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3706":76166,"_31461":75958,"_21806":130146,"_5":15007,"_28616":129586,"_3094":130147},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3706":76167,"_31461":75958,"_21806":130149,"_5":15007,"_28616":129586,"_3094":130150},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3706":76168,"_31461":75958,"_21806":130152,"_5":15007,"_28616":129586,"_3094":130153},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3706":76169,"_31461":75958,"_21806":130155,"_5":15007,"_28616":129590,"_3094":130156},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3706":76170,"_31461":75958,"_21806":130158,"_5":15007,"_28616":129598,"_3094":130159},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3706":76171,"_31461":75958,"_21806":130161,"_5":15007,"_28616":129598,"_3094":130162},[],"Campo en 3.8.0",{"_3706":76172,"_31461":75958,"_21806":130164,"_5":15007,"_28616":129598,"_3094":130165},[],"Campo en 4.0.0",{"_3706":76173,"_31461":75958,"_21806":130167,"_5":15007,"_28616":129598,"_3094":60475},[],{"_3706":76174,"_31461":75958,"_21806":130169,"_5":15007,"_28616":129598,"_3094":130170},[],"`insecure_skip_verify` (con el valor negado)",{"_3706":76175,"_31461":75958,"_21806":130172,"_5":15007,"_28616":129598,"_3094":60481},[],{"_3706":76176,"_31461":75958,"_21806":130174,"_5":15007,"_28616":129598,"_3094":60484},[],{"_3706":76177,"_31461":75958,"_21806":130176,"_5":15007,"_28616":129598,"_3094":60487},[],{"_3706":76178,"_31461":75958,"_21806":130178,"_5":15007,"_28616":129598,"_3094":60490},[],{"_3706":76179,"_31461":75958,"_21806":130180,"_5":15007,"_28616":129598,"_3094":60493},[],{"_3706":76180,"_31461":75958,"_21806":130182,"_5":15007,"_28616":129598,"_3094":60496},[],{"_3706":76181,"_31461":75958,"_21806":130184,"_5":15007,"_28616":129598,"_3094":130185},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3706":76182,"_31461":75958,"_21806":130187,"_5":15007,"_28616":129598,"_3094":130188},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3706":76183,"_31461":75958,"_21806":130190,"_5":15007,"_28616":129598,"_3094":130191},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3706":76184,"_31461":75958,"_21806":130193,"_5":15007,"_28616":129602,"_3094":130194},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3706":76185,"_31461":75958,"_21806":130196,"_5":15007,"_28616":129602,"_3094":130197},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3706":76186,"_31461":75958,"_21806":130199,"_5":15007,"_28616":129602,"_3094":130200},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3706":76187,"_31461":75958,"_21806":130202,"_5":15007,"_28616":129606,"_3094":130203},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3706":76188,"_31461":75958,"_21806":130205,"_5":15007,"_28616":129606,"_3094":130206},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3706":76189,"_31461":75958,"_21806":130208,"_5":15007,"_28616":129610,"_3094":130209},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3706":76190,"_31461":75958,"_21806":130211,"_5":15007,"_28616":129614,"_3094":130212},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3706":76191,"_31461":75958,"_21806":130214,"_5":15007,"_28616":129618,"_3094":130215},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3706":76192,"_31461":75958,"_21806":130217,"_5":15007,"_28616":129622,"_3094":130218},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3706":76193,"_31461":75958,"_21806":130220,"_5":15007,"_28616":129622,"_3094":130221},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3706":76194,"_31461":75958,"_21806":130223,"_5":15007,"_28616":129622,"_3094":130224},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3706":76195,"_31461":75958,"_21806":130226,"_5":15007,"_28616":129622,"_3094":130227},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. La entrega es de tipo best effort: los eventos emitidos mientras no hay ningún cliente conectado no se reenvían en la siguiente conexión. El servidor cierra cada stream tras un tiempo de vida máximo, 10 minutos por omisión y configurable con la opción `sse_max_stream_duration` de Device Manager, y el cliente se reconecta para seguir recibiendo eventos. Cuando una instancia alcanza su límite de suscriptores, configurado con la opción `sse_max_subscribers` de Device Manager (1000 por omisión y compartido por todos los streams de la instancia), los nuevos streams reciben una respuesta `503` con una cabecera `Retry-After`. Cada stream vuelve a comprobar el permiso de lectura del dispositivo mientras está activo, y lo cierra cuando el permiso se revoca o no se puede verificar; la reconexión vuelve a pasar por las comprobaciones de autorización habituales. En un despliegue con Helm, define `services.deviceManager.sseEnabled` como `false` para deshabilitar SSE (por defecto `true`); consulta Flujo de eventos de dispositivo (SSE).",{"_3706":76196,"_31461":75958,"_21806":130229,"_5":15007,"_28616":129622,"_3094":130230},[],"En AMQP, cada instancia de Device Manager enlaza una cola de suscriptores con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. La cola es duradera y auto-delete, con una expiración de una hora (`x-expires`), de modo que el broker la elimina cuando la instancia se detiene o su conexión muere, y no hace falta ninguna política de limpieza. Solo en proveedores de event bus sin soporte de suscriptores efímeros puede quedar una cola duradera por proceso tras detenerse su instancia; revisa esos proveedores si observas colas residuales.",{"_3706":76197,"_31461":75958,"_21806":130232,"_5":15007,"_28616":129626,"_3094":130233},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3706":76198,"_31461":75958,"_21806":130235,"_5":15007,"_28616":129630,"_3094":130236},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3706":76199,"_31461":75958,"_21806":130238,"_5":15007,"_28616":129630,"_3094":130239},[],"Ruta",{"_3706":76200,"_31461":75958,"_21806":130241,"_5":15007,"_28616":129630,"_3094":122524},[],{"_3706":76201,"_31461":75958,"_21806":130243,"_5":15007,"_28616":129630,"_3094":60558},[],{"_3706":76202,"_31461":75958,"_21806":130245,"_5":15007,"_28616":129630,"_3094":130246},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3706":76203,"_31461":75958,"_21806":130248,"_5":15007,"_28616":129630,"_3094":60564},[],{"_3706":76204,"_31461":75958,"_21806":130250,"_5":15007,"_28616":129630,"_3094":130251},[],"Lee los ajustes de una CA.",{"_3706":76205,"_31461":75958,"_21806":130253,"_5":15007,"_28616":129630,"_3094":60570},[],{"_3706":76206,"_31461":75958,"_21806":130255,"_5":15007,"_28616":129630,"_3094":130256},[],"Sustituye los `crl_options`.",{"_3706":76207,"_31461":75958,"_21806":130258,"_5":15007,"_28616":129630,"_3094":60576},[],{"_3706":76208,"_31461":75958,"_21806":130260,"_5":15007,"_28616":129630,"_3094":130261},[],"Elimina los ajustes archivados de una CA.",{"_3706":76209,"_31461":75958,"_21806":130263,"_5":15007,"_28616":129630,"_3094":130264},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3706":76210,"_31461":75958,"_21806":130266,"_5":15007,"_28616":129630,"_3094":130267},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3706":76211,"_31461":75958,"_21806":130269,"_5":15007,"_28616":129630,"_3094":130270},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3706":76212,"_31461":75958,"_21806":130272,"_5":15007,"_28616":129630,"_3094":130273},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3706":76213,"_31461":75958,"_21806":130275,"_5":15007,"_28616":129630,"_3094":130276},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3706":76214,"_31461":75958,"_21806":130278,"_5":15007,"_28616":129630,"_3094":130279},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3706":76215,"_31461":75958,"_21806":130281,"_5":15007,"_28616":129630,"_3094":130282},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3706":76216,"_31461":75958,"_21806":130284,"_5":15007,"_28616":129630,"_3094":130285},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3706":76217,"_31461":75958,"_21806":130287,"_5":15007,"_28616":129630,"_3094":130288},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3706":76218,"_31461":75958,"_21806":130290,"_5":15007,"_28616":129630,"_3094":130291},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3706":76219,"_31461":75958,"_21806":130293,"_5":15007,"_28616":129630,"_3094":130294},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3706":76220,"_31461":75958,"_21806":130296,"_5":15007,"_28616":129634,"_3094":130297},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3706":76221,"_31461":75958,"_21806":130299,"_5":15007,"_28616":129638,"_3094":130300},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3706":76222,"_31461":75958,"_21806":130302,"_5":15007,"_28616":129642,"_3094":130303},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3706":76223,"_31461":75958,"_21806":130305,"_5":15007,"_28616":129646,"_3094":130306},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3706":76224,"_31461":75958,"_21806":130308,"_5":15007,"_28616":129646,"_3094":130309},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3706":76225,"_31461":75958,"_21806":130311,"_5":15007,"_28616":129650,"_3094":130312},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3706":76226,"_31461":75958,"_21806":130314,"_5":15007,"_28616":129654,"_3094":130315},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3706":76227,"_31461":75958,"_21806":130317,"_5":15007,"_28616":129658,"_3094":130318},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3706":76228,"_31461":75958,"_21806":130320,"_5":15007,"_28616":129658,"_3094":130321},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3706":76229,"_31461":75958,"_21806":130323,"_5":15007,"_28616":129658,"_3094":130324},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3706":76230,"_31461":75958,"_21806":130326,"_5":15007,"_28616":129658,"_3094":130327},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3706":76231,"_31461":75958,"_21806":130329,"_5":15007,"_28616":129658,"_3094":130330},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3706":76232,"_31461":75958,"_21806":130332,"_5":15007,"_28616":129658,"_3094":130333},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3706":76233,"_31461":75958,"_21806":130335,"_5":15007,"_28616":129662,"_3094":130336},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3706":76234,"_31461":75958,"_21806":130338,"_5":15007,"_28616":129662,"_3094":130339},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3706":76235,"_31461":75958,"_21806":130341,"_5":15007,"_28616":129662,"_3094":130342},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3706":76236,"_31461":75958,"_21806":130344,"_5":15007,"_28616":129662,"_3094":130345},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3706":76237,"_31461":75958,"_21806":130347,"_5":15007,"_28616":129662,"_3094":130348},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3706":76238,"_31461":75958,"_21806":130350,"_5":15007,"_28616":129666,"_3094":130351},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3706":76239,"_31461":75958,"_21806":130353,"_5":15007,"_28616":129666,"_3094":130354},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3706":76240,"_31461":75958,"_21806":130356,"_5":15007,"_28616":129666,"_3094":130357},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3706":76241,"_31461":75958,"_21806":130359,"_5":15007,"_28616":129666,"_3094":60678},[],{"_3706":76242,"_31461":75958,"_21806":130361,"_5":15007,"_28616":129666,"_3094":130362},[],"Claves de datos obligatorias",{"_3706":76243,"_31461":75958,"_21806":130364,"_5":15007,"_28616":129666,"_3094":130365},[],"Cuándo",{"_3706":76244,"_31461":75958,"_21806":130367,"_5":15007,"_28616":129666,"_3094":130368},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3706":76245,"_31461":75958,"_21806":130370,"_5":15007,"_28616":129666,"_3094":60690},[],{"_3706":76246,"_31461":75958,"_21806":130372,"_5":15007,"_28616":129666,"_3094":130373},[],"Siempre",{"_3706":76247,"_31461":75958,"_21806":130375,"_5":15007,"_28616":129666,"_3094":130376},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3706":76248,"_31461":75958,"_21806":130378,"_5":15007,"_28616":129666,"_3094":60690},[],{"_3706":76249,"_31461":75958,"_21806":130380,"_5":15007,"_28616":129666,"_3094":130373},[],{"_3706":76250,"_31461":75958,"_21806":130382,"_5":15007,"_28616":129666,"_3094":60703},[],{"_3706":76251,"_31461":75958,"_21806":130384,"_5":15007,"_28616":129666,"_3094":60690},[],{"_3706":76252,"_31461":75958,"_21806":130386,"_5":15007,"_28616":129666,"_3094":130387},[],"Solo cuando hay autenticación SMTP",{"_3706":76253,"_31461":75958,"_21806":130389,"_5":15007,"_28616":129666,"_3094":130390},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3706":76254,"_31461":75958,"_21806":130392,"_5":15007,"_28616":129666,"_3094":130393},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3706":76255,"_31461":75958,"_21806":130395,"_5":15007,"_28616":129666,"_3094":130396},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3706":76256,"_31461":75958,"_21806":130398,"_5":15007,"_28616":129666,"_3094":130399},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3706":76257,"_31461":75958,"_21806":130401,"_5":15007,"_28616":129666,"_3094":130402},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3706":76258,"_31461":75958,"_21806":130404,"_5":15007,"_28616":129666,"_3094":130405},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3706":76259,"_31461":75958,"_21806":130407,"_5":15007,"_28616":129666,"_3094":130408},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3706":76260,"_31461":75958,"_21806":130410,"_5":15007,"_28616":129666,"_3094":130411},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3706":76261,"_31461":75958,"_21806":130413,"_5":15007,"_28616":129666,"_3094":130414},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3706":76262,"_31461":75958,"_21806":130416,"_5":15007,"_28616":129666,"_3094":130417},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3706":76263,"_31461":75958,"_21806":130419,"_5":15007,"_28616":129666,"_3094":130420},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3706":76264,"_31461":75958,"_21806":130422,"_5":15007,"_28616":129666,"_3094":130423},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3706":76265,"_31461":75958,"_21806":130425,"_5":15007,"_28616":129666,"_3094":130426},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3706":76266,"_31461":75958,"_21806":130428,"_5":15007,"_28616":129666,"_3094":130429},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3706":76267,"_31461":75958,"_21806":130431,"_5":15007,"_28616":129666,"_3094":130432},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3706":76268,"_31461":75958,"_21806":130434,"_5":15007,"_28616":129670,"_3094":130435},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3706":76269,"_31461":75958,"_21806":130437,"_5":15007,"_28616":129670,"_3094":130438},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3706":76270,"_31461":75958,"_21806":130440,"_5":15007,"_28616":129674,"_3094":130441},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3706":76271,"_31461":75958,"_21806":130443,"_5":15007,"_28616":129674,"_3094":130444},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3706":76272,"_31461":75958,"_21806":130446,"_5":15007,"_28616":129674,"_3094":130447},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3706":76273,"_31461":75958,"_21806":130449,"_5":15007,"_28616":129674,"_3094":130450},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3706":76274,"_31461":75958,"_21806":130452,"_5":15007,"_28616":129674,"_3094":130453},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3706":76275,"_31461":75958,"_21806":130455,"_5":15007,"_28616":129674,"_3094":130456},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3706":76276,"_31461":75958,"_21806":130458,"_5":15007,"_28616":129674,"_3094":130459},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3706":76277,"_31461":75958,"_21806":130461,"_5":15007,"_28616":129674,"_3094":130462},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3706":76278,"_31461":75958,"_21806":130464,"_5":15007,"_28616":129674,"_3094":130465},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3706":76279,"_31461":75958,"_21806":130467,"_5":15007,"_28616":129674,"_3094":130468},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3706":76280,"_31461":75958,"_21806":130470,"_5":15007,"_28616":129674,"_3094":130471},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3706":76281,"_31461":75958,"_21806":130473,"_5":15007,"_28616":129678,"_3094":130474},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3706":76282,"_31461":75958,"_21806":130476,"_5":15007,"_28616":129678,"_3094":130477},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3706":76283,"_31461":75958,"_21806":130479,"_5":15007,"_28616":129682,"_3094":130480},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3706":76284,"_31461":75958,"_21806":130482,"_5":15007,"_28616":129682,"_3094":130483},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3706":76285,"_31461":75958,"_21806":130485,"_5":15007,"_28616":129682,"_3094":130486},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3706":76286,"_31461":75958,"_21806":130488,"_5":15007,"_28616":129682,"_3094":130489},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3706":76287,"_31461":75958,"_21806":130491,"_5":15007,"_28616":129682,"_3094":130492},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3706":76288,"_31461":75958,"_21806":130494,"_5":15007,"_28616":129682,"_3094":130495},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3706":76289,"_31461":75958,"_21806":130497,"_5":15007,"_28616":129682,"_3094":130498},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3706":76290,"_31461":75958,"_21806":130500,"_5":15007,"_28616":129682,"_3094":130501},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3706":76291,"_31461":75958,"_21806":130503,"_5":15007,"_28616":129686,"_3094":130504},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3706":76292,"_31461":75958,"_21806":130506,"_5":15007,"_28616":129686,"_3094":130507},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3706":76293,"_31461":75958,"_21806":130509,"_5":15007,"_28616":129686,"_3094":130510},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3706":76294,"_31461":75958,"_21806":130512,"_5":15007,"_28616":129686,"_3094":130513},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3706":76295,"_31461":75958,"_21806":130515,"_5":15007,"_28616":129686,"_3094":130516},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3706":76296,"_31461":75958,"_21806":130518,"_5":15007,"_28616":129686,"_3094":130519},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3706":76297,"_31461":75958,"_21806":130521,"_5":15007,"_28616":129686,"_3094":130522},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3706":76298,"_31461":75958,"_21806":130524,"_5":15007,"_28616":129686,"_3094":130525},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3706":76299,"_31461":75958,"_21806":130527,"_5":15007,"_28616":129686,"_3094":130528},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3706":76300,"_31461":75958,"_21806":130530,"_5":15007,"_28616":129686,"_3094":130531},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3706":76301,"_31461":75958,"_21806":130533,"_5":15007,"_28616":129686,"_3094":130534},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3706":76302,"_31461":75958,"_21806":130536,"_5":15007,"_28616":129689,"_3094":130537},[],"Tras la actualización, comprueba en este orden:",{"_3706":76303,"_31461":75958,"_21806":130539,"_5":15007,"_28616":129689,"_3094":130540},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3706":76304,"_31461":75958,"_21806":130542,"_5":15007,"_28616":129689,"_3094":130543},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3706":76305,"_31461":75958,"_21806":130545,"_5":15007,"_28616":129689,"_3094":130546},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3706":76306,"_31461":75958,"_21806":130548,"_5":15007,"_28616":129689,"_3094":130549},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3706":76307,"_31461":75958,"_21806":130551,"_5":15007,"_28616":129689,"_3094":130552},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3706":76308,"_31461":75958,"_21806":130554,"_5":15007,"_28616":129689,"_3094":130555},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3706":76309,"_31461":75958,"_21806":130557,"_5":15007,"_28616":129689,"_3094":130558},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3706":76310,"_31461":75958,"_21806":130560,"_5":15007,"_28616":129689,"_3094":130561},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3706":76311,"_31461":75958,"_21806":130563,"_5":15007,"_28616":129689,"_3094":130564},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada. En AMQP las colas de suscriptores de SSE son auto-delete y desaparecen cuando su instancia se detiene; en proveedores de event bus sin soporte de suscriptores efímeros, comprueba que no se acumulen colas de SSE por proceso.",{"_3706":76312,"_31461":75958,"_21806":130566,"_5":15007,"_28616":129689,"_3094":130567},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3706":76313,"_31461":75958,"_21806":130569,"_5":15007,"_28616":129689,"_3094":130570},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3706":76314,"_31461":75958,"_21806":130572,"_5":15007,"_28616":129689,"_3094":130573},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3706":76315,"_31461":75958,"_21806":130575,"_5":15007,"_28616":129689,"_3094":130576},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3706":76316,"_31461":75958,"_21806":130578,"_5":15007,"_28616":129689,"_3094":130579},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3706":76317,"_31461":75958,"_21806":130581,"_5":15007,"_28616":129689,"_3094":130582},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3706":76318,"_31461":75958,"_21806":130584,"_5":15007,"_28616":129693,"_3094":130585},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3706":76319,"_31461":75958,"_21806":130587,"_5":15007,"_28616":129693,"_3094":130588},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3706":76320,"_31461":75958,"_21806":130590,"_5":15007,"_28616":129693,"_3094":130591},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3706":76321,"_31461":75958,"_21806":130593,"_5":15007,"_28616":129693,"_3094":130594},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3706":76322,"_31461":75958,"_21806":130596,"_5":15007,"_28616":129693,"_3094":130597},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60921":130599,"_60923":130600,"_60925":130601,"_60927":130602,"_18897":3129,"_73242":3129},"spanish",[3094,31461,5,28616],{"_3094":26007,"_31461":26007,"_5":26007,"_28616":26007},{"_3094":130603,"_31461":133680,"_5":136757,"_28616":139834},{"_4864":130604,"_60931":130605,"_5":26007},{"_15088":3409,"_15467":7854,"_15486":4933,"_30445":7810,"_15473":4811,"_20710":5690,"_15109":5413,"_15116":13462,"_30382":3548,"_30795":6280,"_30827":16735,"_30421":4607,"_35896":5215,"_30524":19847,"_30882":10298,"_35903":5627,"_35906":4248,"_35909":8045,"_35912":3161,"_31284":11454,"_35917":13701,"_35919":7292,"_31319":5386,"_15482":16463,"_35923":7884,"_35926":12896,"_35928":7344,"_30866":5669,"_31304":17870,"_31332":4767,"_35933":21984,"_35935":7991,"_35937":4122,"_30535":8059,"_35940":3594,"_35942":5130,"_35944":7975,"_35946":8060,"_35948":7303,"_30458":7671,"_35951":3848,"_35953":10440,"_30452":16190,"_30903":5816,"_35957":5355,"_35959":7549,"_35962":4609,"_30498":15252,"_35966":8567,"_30373":4445,"_35969":12541,"_30426":3238,"_35972":5185,"_35974":4272,"_35977":7960,"_15476":15546,"_35980":6233,"_35982":6610,"_35985":4583,"_35987":4360,"_35989":11493,"_35991":21560,"_35993":8055,"_20713":3494,"_35996":12161,"_35998":4928,"_30399":4136,"_30860":5408,"_36002":7857,"_36004":3297,"_36006":7409,"_31348":25796,"_36009":3824,"_36011":3775,"_36013":6259,"_31441":4446,"_30919":12402,"_36017":4814,"_36019":7956,"_30436":8292,"_31526":5023,"_36023":3169,"_36025":7357,"_31364":18047,"_30518":6947,"_29893":6301,"_36030":3578,"_36032":10626,"_36034":5221,"_30561":8944,"_36038":4601,"_30854":8943,"_36042":13035,"_36044":5802,"_36046":7074,"_36048":6105,"_36050":3460,"_36052":4937,"_30550":6928,"_30800":13033,"_36056":5358,"_36058":20261,"_36060":4668,"_36063":4980,"_36065":8064,"_36067":10105,"_36069":3622,"_36071":3997,"_36073":3261,"_36075":12724,"_36078":8009,"_36080":5818,"_36082":5773,"_36084":7961,"_36086":5366,"_36089":3177,"_36091":17194,"_36094":