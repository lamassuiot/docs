:120748,"_28497":120749,"_3084":120750},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3634":72981,"_31331":72978,"_5":31687,"_21707":120752,"_28497":120753,"_3084":120754},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3634":72982,"_31331":72978,"_5":31687,"_21707":120756,"_28497":120757,"_3084":120758},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3634":72983,"_31331":72978,"_5":31687,"_21707":120760,"_28497":120761,"_3084":120762},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3634":72984,"_31331":72978,"_5":31687,"_21707":120764,"_28497":120765,"_3084":120766},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3634":72985,"_31331":72978,"_5":31687,"_21707":120768,"_28497":120769,"_3084":120770},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3634":72986,"_31331":72978,"_5":31687,"_21707":120772,"_28497":120773,"_3084":120774},[],"/docs/pr-preview/pr-81/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3634":72987,"_31331":72978,"_21707":120776,"_5":14945,"_28497":72978,"_3084":120777},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3634":72988,"_31331":72978,"_21707":120779,"_5":14945,"_28497":120749,"_3084":120780},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3634":72989,"_31331":72978,"_21707":120782,"_5":14945,"_28497":120749,"_3084":120783},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3634":72990,"_31331":72978,"_21707":120785,"_5":14945,"_28497":120749,"_3084":120786},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3634":72991,"_31331":72978,"_21707":120788,"_5":14945,"_28497":120753,"_3084":120789},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3634":72992,"_31331":72978,"_21707":120791,"_5":14945,"_28497":120753,"_3084":120792},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3634":72993,"_31331":72978,"_21707":120794,"_5":14945,"_28497":120753,"_3084":120795},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3634":72994,"_31331":72978,"_21707":120797,"_5":14945,"_28497":120757,"_3084":120798},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3634":72995,"_31331":72978,"_21707":120800,"_5":14945,"_28497":120761,"_3084":120801},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3634":72996,"_31331":72978,"_21707":120803,"_5":14945,"_28497":120765,"_3084":120804},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3634":72997,"_31331":72978,"_21707":120806,"_5":14945,"_28497":120769,"_3084":120807},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3634":72998,"_31331":72978,"_21707":120809,"_5":14945,"_28497":120773,"_3084":120810},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3634":72999,"_31331":72999,"_5":15305,"_3084":120812,"_31690":120813,"_21707":120814,"_28497":72999},"Despliega Lamassu",[51145,120741],[],{"_3634":73000,"_31331":72999,"_21707":120816,"_5":14945,"_28497":72999,"_3084":120817},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3634":73001,"_31331":72999,"_5":31687,"_21707":120819,"_28497":120820,"_3084":120821},[],"/docs/pr-preview/pr-81/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3634":73002,"_31331":72999,"_5":31687,"_21707":120823,"_28497":120824,"_3084":120825},[],"/docs/pr-preview/pr-81/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3634":73003,"_31331":72999,"_5":31687,"_21707":120827,"_28497":120828,"_3084":120829},[],"/docs/pr-preview/pr-81/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3634":73004,"_31331":72999,"_21707":120831,"_5":14945,"_28497":72999,"_3084":120832},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3634":73005,"_31331":72999,"_21707":120834,"_5":14945,"_28497":120820,"_3084":120835},[],"Modelo",{"_3634":73006,"_31331":72999,"_21707":120837,"_5":14945,"_28497":120820,"_3084":120838},[],"Recomendado para",{"_3634":73007,"_31331":72999,"_21707":120840,"_5":14945,"_28497":120820,"_3084":120841},[],"Quién opera la infraestructura",{"_3634":73008,"_31331":72999,"_21707":120843,"_5":14945,"_28497":120820,"_3084":120844},[],"Punto de partida",{"_3634":73009,"_31331":72999,"_21707":120846,"_5":14945,"_28497":120820,"_3084":51252},[],{"_3634":73010,"_31331":72999,"_21707":120848,"_5":14945,"_28497":120820,"_3084":120849},[],"Producción, entornos regulados y despliegues personalizados",{"_3634":73011,"_31331":72999,"_21707":120851,"_5":14945,"_28497":120820,"_3084":120852},[],"Tu equipo",{"_3634":73012,"_31331":72999,"_21707":120854,"_5":14945,"_28497":120820,"_3084":120855},[],"Helm o Fastlane",{"_3634":73013,"_31331":72999,"_21707":120857,"_5":14945,"_28497":120820,"_3084":51264},[],{"_3634":73014,"_31331":72999,"_21707":120859,"_5":14945,"_28497":120820,"_3084":120860},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3634":73015,"_31331":72999,"_21707":120862,"_5":14945,"_28497":120820,"_3084":120852},[],{"_3634":73016,"_31331":72999,"_21707":120864,"_5":14945,"_28497":120820,"_3084":120865},[],"Imagen preconfigurada en EC2",{"_3634":73017,"_31331":72999,"_21707":120867,"_5":14945,"_28497":120820,"_3084":51275},[],{"_3634":73018,"_31331":72999,"_21707":120869,"_5":14945,"_28497":120820,"_3084":120870},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3634":73019,"_31331":72999,"_21707":120872,"_5":14945,"_28497":120820,"_3084":51281},[],{"_3634":73020,"_31331":72999,"_21707":120874,"_5":14945,"_28497":120820,"_3084":120875},[],"Suscripción gestionada",{"_3634":73021,"_31331":72999,"_21707":120877,"_5":14945,"_28497":120820,"_3084":120878},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3634":73022,"_31331":72999,"_21707":120880,"_5":14945,"_28497":120820,"_3084":120881},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3634":73023,"_31331":72999,"_21707":120883,"_5":14945,"_28497":120820,"_3084":120884},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3634":73024,"_31331":72999,"_21707":120886,"_5":14945,"_28497":120824,"_3084":120887},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3634":73025,"_31331":72999,"_21707":120889,"_5":14945,"_28497":120828,"_3084":120890},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3634":73026,"_31331":73026,"_5":15305,"_3084":120892,"_31690":120893,"_21707":120894,"_28497":73026},"Utiliza Lamassu como SaaS",[51145,120741,120742],[],{"_3634":73027,"_31331":73026,"_21707":120896,"_5":14945,"_28497":73026,"_3084":120897},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3634":73028,"_31331":73026,"_5":31687,"_21707":120899,"_28497":120900,"_3084":120901},[],"/docs/pr-preview/pr-81/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3634":73029,"_31331":73026,"_5":31687,"_21707":120903,"_28497":120904,"_3084":120905},[],"/docs/pr-preview/pr-81/es/deployment/saas#planes","Planes",{"_3634":73030,"_31331":73026,"_5":31687,"_21707":120907,"_28497":120908,"_3084":120909},[],"/docs/pr-preview/pr-81/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3634":73031,"_31331":73026,"_21707":120911,"_5":14945,"_28497":73026,"_3084":120912},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3634":73032,"_31331":73026,"_21707":120914,"_5":14945,"_28497":120900,"_3084":120915},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3634":73033,"_31331":73026,"_21707":120917,"_5":14945,"_28497":120900,"_3084":120918},[],"Copias de seguridad automáticas.",{"_3634":73034,"_31331":73026,"_21707":120920,"_5":14945,"_28497":120900,"_3084":120921},[],"Actualizaciones de versión.",{"_3634":73035,"_31331":73026,"_21707":120923,"_5":14945,"_28497":120900,"_3084":120924},[],"Soporte técnico y SLA según el plan contratado.",{"_3634":73036,"_31331":73026,"_21707":120926,"_5":14945,"_28497":120904,"_3084":51336},[],{"_3634":73037,"_31331":73026,"_21707":120928,"_5":14945,"_28497":120904,"_3084":120929},[],"Dispositivos",{"_3634":73038,"_31331":73026,"_21707":120931,"_5":14945,"_28497":120904,"_3084":120932},[],"Soporte",{"_3634":73039,"_31331":73026,"_21707":120934,"_5":14945,"_28497":120904,"_3084":51345},[],{"_3634":73040,"_31331":73026,"_21707":120936,"_5":14945,"_28497":120904,"_3084":51348},[],{"_3634":73041,"_31331":73026,"_21707":120938,"_5":14945,"_28497":120904,"_3084":120939},[],"Hasta 1.000",{"_3634":73042,"_31331":73026,"_21707":120941,"_5":14945,"_28497":120904,"_3084":51354},[],{"_3634":73043,"_31331":73026,"_21707":120943,"_5":14945,"_28497":120904,"_3084":120944},[],"99,5 %",{"_3634":73044,"_31331":73026,"_21707":120946,"_5":14945,"_28497":120904,"_3084":51360},[],{"_3634":73045,"_31331":73026,"_21707":120948,"_5":14945,"_28497":120904,"_3084":120949},[],"Hasta 10.000",{"_3634":73046,"_31331":73026,"_21707":120951,"_5":14945,"_28497":120904,"_3084":120952},[],"Email y chat",{"_3634":73047,"_31331":73026,"_21707":120954,"_5":14945,"_28497":120904,"_3084":120955},[],"99,9 %",{"_3634":73048,"_31331":73026,"_21707":120957,"_5":14945,"_28497":120904,"_3084":51372},[],{"_3634":73049,"_31331":73026,"_21707":120959,"_5":14945,"_28497":120904,"_3084":120960},[],"Ilimitados",{"_3634":73050,"_31331":73026,"_21707":120962,"_5":14945,"_28497":120904,"_3084":120963},[],"Dedicado",{"_3634":73051,"_31331":73026,"_21707":120965,"_5":14945,"_28497":120904,"_3084":120966},[],"99,99 %",{"_3634":73052,"_31331":73026,"_21707":120968,"_5":14945,"_28497":120908,"_3084":120969},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3634":73053,"_31331":73026,"_21707":120971,"_5":14945,"_28497":120908,"_3084":120972},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3634":73054,"_31331":73054,"_5":15305,"_3084":51389,"_31690":120974,"_21707":120976,"_28497":73054},[51145,120741,120975],"Kubernetes autogestionado",[],{"_3634":73055,"_31331":73054,"_21707":120978,"_5":14945,"_28497":73054,"_3084":120979},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3634":73056,"_31331":73054,"_5":31687,"_21707":120981,"_28497":120982,"_3084":120983},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3634":73057,"_31331":73054,"_5":31687,"_21707":120985,"_28497":120986,"_3084":120987},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3634":73058,"_31331":73054,"_5":31687,"_21707":120989,"_28497":120990,"_3084":120991},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3634":73059,"_31331":73054,"_5":31687,"_21707":120993,"_28497":120994,"_3084":120995},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3634":73060,"_31331":73054,"_5":31687,"_21707":120997,"_28497":120998,"_3084":120999},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3634":73061,"_31331":73054,"_5":31687,"_21707":121001,"_28497":121002,"_3084":121003},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3634":73062,"_31331":73054,"_5":31687,"_21707":121005,"_28497":121006,"_3084":121007},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3634":73063,"_31331":73054,"_5":31687,"_21707":121009,"_28497":121010,"_3084":121011},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3634":73064,"_31331":73054,"_5":31687,"_21707":121013,"_28497":121014,"_3084":121015},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3634":73065,"_31331":73054,"_5":31687,"_21707":121017,"_28497":121018,"_3084":121019},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3634":73066,"_31331":73054,"_5":31687,"_21707":121021,"_28497":121022,"_3084":121023},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3634":73067,"_31331":73054,"_21707":121025,"_5":14945,"_28497":120982,"_3084":121026},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3634":73068,"_31331":73054,"_21707":121028,"_5":14945,"_28497":120982,"_3084":121029},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3634":73069,"_31331":73054,"_21707":121031,"_5":14945,"_28497":120986,"_3084":121032},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3634":73070,"_31331":73054,"_21707":121034,"_5":14945,"_28497":120986,"_3084":121035},[],"Fastlane instala o configura",{"_3634":73071,"_31331":73054,"_21707":121037,"_5":14945,"_28497":120986,"_3084":121038},[],"Tú sigues proporcionando",{"_3634":73072,"_31331":73054,"_21707":121040,"_5":14945,"_28497":120986,"_3084":121041},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3634":73073,"_31331":73054,"_21707":121043,"_5":14945,"_28497":120986,"_3084":121044},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3634":73074,"_31331":73054,"_21707":121046,"_5":14945,"_28497":120986,"_3084":121047},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3634":73075,"_31331":73054,"_21707":121049,"_5":14945,"_28497":120986,"_3084":121050},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3634":73076,"_31331":73054,"_21707":121052,"_5":14945,"_28497":120986,"_3084":121053},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3634":73077,"_31331":73054,"_21707":121055,"_5":14945,"_28497":120986,"_3084":121056},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3634":73078,"_31331":73054,"_21707":121058,"_5":14945,"_28497":120986,"_3084":121059},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3634":73079,"_31331":73054,"_21707":121061,"_5":14945,"_28497":120986,"_3084":121062},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3634":73080,"_31331":73054,"_21707":121064,"_5":14945,"_28497":120986,"_3084":121065},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3634":73081,"_31331":73054,"_21707":121067,"_5":14945,"_28497":120990,"_3084":121068},[],"Necesitas:",{"_3634":73082,"_31331":73054,"_21707":121070,"_5":14945,"_28497":120990,"_3084":121071},[],"un clúster Kubernetes existente",{"_3634":73083,"_31331":73054,"_21707":121073,"_5":14945,"_28497":120990,"_3084":121074},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3634":73084,"_31331":73054,"_21707":121076,"_5":14945,"_28497":120990,"_3084":51491},[],{"_3634":73085,"_31331":73054,"_21707":121078,"_5":14945,"_28497":120990,"_3084":24514},[],{"_3634":73086,"_31331":73054,"_21707":121080,"_5":14945,"_28497":120990,"_3084":121081},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3634":73087,"_31331":73054,"_21707":121083,"_5":14945,"_28497":120990,"_3084":121084},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3634":73088,"_31331":73054,"_21707":121086,"_5":14945,"_28497":120990,"_3084":121087},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3634":73089,"_31331":73054,"_21707":121089,"_5":14945,"_28497":120990,"_3084":121090},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3634":73090,"_31331":73054,"_21707":121092,"_5":14945,"_28497":120990,"_3084":121093},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3634":73091,"_31331":73054,"_21707":121095,"_5":14945,"_28497":120994,"_3084":121096},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3634":73092,"_31331":73054,"_21707":121098,"_5":14945,"_28497":120994,"_3084":121099},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3634":73093,"_31331":73054,"_21707":121101,"_5":14945,"_28497":120998,"_3084":121102},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3634":73094,"_31331":73054,"_21707":121104,"_5":14945,"_28497":120998,"_3084":121105},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3634":73095,"_31331":73054,"_21707":121107,"_5":14945,"_28497":120998,"_3084":121108},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3634":73096,"_31331":73054,"_21707":121110,"_5":14945,"_28497":120998,"_3084":121111},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3634":73097,"_31331":73054,"_21707":121113,"_5":14945,"_28497":121002,"_3084":121114},[],"Opción",{"_3634":73098,"_31331":73054,"_21707":121116,"_5":14945,"_28497":121002,"_3084":121117},[],"Valor predeterminado",{"_3634":73099,"_31331":73054,"_21707":121119,"_5":14945,"_28497":121002,"_3084":121120},[],"Propósito",{"_3634":73100,"_31331":73054,"_21707":121122,"_5":14945,"_28497":121002,"_3084":51538},[],{"_3634":73101,"_31331":73054,"_21707":121124,"_5":14945,"_28497":121002,"_3084":51541},[],{"_3634":73102,"_31331":73054,"_21707":121126,"_5":14945,"_28497":121002,"_3084":121127},[],"Muestra la ayuda",{"_3634":73103,"_31331":73054,"_21707":121129,"_5":14945,"_28497":121002,"_3084":51547},[],{"_3634":73104,"_31331":73054,"_21707":121131,"_5":14945,"_28497":121002,"_3084":121132},[],"contexto actual",{"_3634":73105,"_31331":73054,"_21707":121134,"_5":14945,"_28497":121002,"_3084":121135},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3634":73106,"_31331":73054,"_21707":121137,"_5":14945,"_28497":121002,"_3084":51556},[],{"_3634":73107,"_31331":73054,"_21707":121139,"_5":14945,"_28497":121002,"_3084":6814},[],{"_3634":73108,"_31331":73054,"_21707":121141,"_5":14945,"_28497":121002,"_3084":121142},[],"Omite prompts y genera credenciales para las dependencias",{"_3634":73109,"_31331":73054,"_21707":121144,"_5":14945,"_28497":121002,"_3084":51564},[],{"_3634":73110,"_31331":73054,"_21707":121146,"_5":14945,"_28497":121002,"_3084":51567},[],{"_3634":73111,"_31331":73054,"_21707":121148,"_5":14945,"_28497":121002,"_3084":121149},[],"Namespace de la instalación",{"_3634":73112,"_31331":73054,"_21707":121151,"_5":14945,"_28497":121002,"_3084":51573},[],{"_3634":73113,"_31331":73054,"_21707":121153,"_5":14945,"_28497":121002,"_3084":51576},[],{"_3634":73114,"_31331":73054,"_21707":121155,"_5":14945,"_28497":121002,"_3084":121156},[],"Dominio usado por la UI, OIDC y el certificado",{"_3634":73115,"_31331":73054,"_21707":121158,"_5":14945,"_28497":121002,"_3084":51582},[],{"_3634":73116,"_31331":73054,"_21707":121160,"_5":14945,"_28497":121002,"_3084":15657},[],{"_3634":73117,"_31331":73054,"_21707":121162,"_5":14945,"_28497":121002,"_3084":121163},[],"Versión del chart de Lamassu",{"_3634":73118,"_31331":73054,"_21707":121165,"_5":14945,"_28497":121002,"_3084":51590},[],{"_3634":73119,"_31331":73054,"_21707":121167,"_5":14945,"_28497":121002,"_3084":51593},[],{"_3634":73120,"_31331":73054,"_21707":121169,"_5":14945,"_28497":121002,"_3084":121170},[],"Puerto del listener HTTPS",{"_3634":73121,"_31331":73054,"_21707":121172,"_5":14945,"_28497":121002,"_3084":51599},[],{"_3634":73122,"_31331":73054,"_21707":121174,"_5":14945,"_28497":121002,"_3084":51602},[],{"_3634":73123,"_31331":73054,"_21707":121176,"_5":14945,"_28497":121002,"_3084":121177},[],"Puerto del listener HTTP",{"_3634":73124,"_31331":73054,"_21707":121179,"_5":14945,"_28497":121002,"_3084":51608},[],{"_3634":73125,"_31331":73054,"_21707":121181,"_5":14945,"_28497":121002,"_3084":51541},[],{"_3634":73126,"_31331":73054,"_21707":121183,"_5":14945,"_28497":121002,"_3084":121184},[],"Certificado PEM para TLS downstream",{"_3634":73127,"_31331":73054,"_21707":121186,"_5":14945,"_28497":121002,"_3084":51616},[],{"_3634":73128,"_31331":73054,"_21707":121188,"_5":14945,"_28497":121002,"_3084":51541},[],{"_3634":73129,"_31331":73054,"_21707":121190,"_5":14945,"_28497":121002,"_3084":121191},[],"Clave privada PEM para TLS downstream",{"_3634":73130,"_31331":73054,"_21707":121193,"_5":14945,"_28497":121002,"_3084":51624},[],{"_3634":73131,"_31331":73054,"_21707":121195,"_5":14945,"_28497":121002,"_3084":121196},[],"chart del repositorio",{"_3634":73132,"_31331":73054,"_21707":121198,"_5":14945,"_28497":121002,"_3084":121199},[],"Usa un chart local de Lamassu sin empaquetar",{"_3634":73133,"_31331":73054,"_21707":121201,"_5":14945,"_28497":121002,"_3084":51633},[],{"_3634":73134,"_31331":73054,"_21707":121203,"_5":14945,"_28497":121002,"_3084":121204},[],"detección automática",{"_3634":73135,"_31331":73054,"_21707":121206,"_5":14945,"_28497":121002,"_3084":121207},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3634":73136,"_31331":73054,"_21707":121209,"_5":14945,"_28497":121002,"_3084":51641},[],{"_3634":73137,"_31331":73054,"_21707":121211,"_5":14945,"_28497":121002,"_3084":6814},[],{"_3634":73138,"_31331":73054,"_21707":121213,"_5":14945,"_28497":121002,"_3084":121214},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3634":73139,"_31331":73054,"_21707":121216,"_5":14945,"_28497":121002,"_3084":51649},[],{"_3634":73140,"_31331":73054,"_21707":121218,"_5":14945,"_28497":121002,"_3084":6814},[],{"_3634":73141,"_31331":73054,"_21707":121220,"_5":14945,"_28497":121002,"_3084":121221},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3634":73142,"_31331":73054,"_21707":121223,"_5":14945,"_28497":121002,"_3084":51657},[],{"_3634":73143,"_31331":73054,"_21707":121225,"_5":14945,"_28497":121002,"_3084":6814},[],{"_3634":73144,"_31331":73054,"_21707":121227,"_5":14945,"_28497":121002,"_3084":121228},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3634":73145,"_31331":73054,"_21707":121230,"_5":14945,"_28497":121002,"_3084":51665},[],{"_3634":73146,"_31331":73054,"_21707":121232,"_5":14945,"_28497":121002,"_3084":6814},[],{"_3634":73147,"_31331":73054,"_21707":121234,"_5":14945,"_28497":121002,"_3084":121235},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3634":73148,"_31331":73054,"_21707":121237,"_5":14945,"_28497":121002,"_3084":51673},[],{"_3634":73149,"_31331":73054,"_21707":121239,"_5":14945,"_28497":121002,"_3084":51676},[],{"_3634":73150,"_31331":73054,"_21707":121241,"_5":14945,"_28497":121002,"_3084":121242},[],"Usa otro chart local de SoftHSM",{"_3634":73151,"_31331":73054,"_21707":121244,"_5":14945,"_28497":121002,"_3084":121245},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3634":73152,"_31331":73054,"_21707":121247,"_5":14945,"_28497":121006,"_3084":121248},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3634":73153,"_31331":73054,"_21707":121250,"_5":14945,"_28497":121006,"_3084":121251},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3634":73154,"_31331":73054,"_21707":121253,"_5":14945,"_28497":121006,"_3084":121254},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3634":73155,"_31331":73054,"_21707":121256,"_5":14945,"_28497":121006,"_3084":121257},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3634":73156,"_31331":73054,"_21707":121259,"_5":14945,"_28497":121006,"_3084":121260},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3634":73157,"_31331":73054,"_21707":121262,"_5":14945,"_28497":121006,"_3084":121263},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3634":73158,"_31331":73054,"_21707":121265,"_5":14945,"_28497":121010,"_3084":51703},[],{"_3634":73159,"_31331":73054,"_21707":121267,"_5":14945,"_28497":121010,"_3084":121268},[],"valida las herramientas locales y el clúster seleccionado",{"_3634":73160,"_31331":73054,"_21707":121270,"_5":14945,"_28497":121010,"_3084":121271},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3634":73161,"_31331":73054,"_21707":121273,"_5":14945,"_28497":121010,"_3084":121274},[],"crea el namespace",{"_3634":73162,"_31331":73054,"_21707":121276,"_5":14945,"_28497":121010,"_3084":121277},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3634":73163,"_31331":73054,"_21707":121279,"_5":14945,"_28497":121010,"_3084":121280},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3634":73164,"_31331":73054,"_21707":121282,"_5":14945,"_28497":121010,"_3084":121283},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3634":73165,"_31331":73054,"_21707":121285,"_5":14945,"_28497":121010,"_3084":121286},[],"instala RabbitMQ",{"_3634":73166,"_31331":73054,"_21707":121288,"_5":14945,"_28497":121010,"_3084":121289},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3634":73167,"_31331":73054,"_21707":121291,"_5":14945,"_28497":121010,"_3084":121292},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3634":73168,"_31331":73054,"_21707":121294,"_5":14945,"_28497":121010,"_3084":121295},[],"carga datos de ejemplo opcionalmente",{"_3634":73169,"_31331":73054,"_21707":121297,"_5":14945,"_28497":121010,"_3084":121298},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3634":73170,"_31331":73054,"_21707":121300,"_5":14945,"_28497":121014,"_3084":121301},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3634":73171,"_31331":73054,"_21707":121303,"_5":14945,"_28497":121014,"_3084":121304},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3634":73172,"_31331":73054,"_21707":121306,"_5":14945,"_28497":121018,"_3084":121307},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3634":73173,"_31331":73054,"_21707":121309,"_5":14945,"_28497":121018,"_3084":121310},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3634":73174,"_31331":73054,"_21707":121312,"_5":14945,"_28497":121018,"_3084":121313},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3634":73175,"_31331":73054,"_21707":121315,"_5":14945,"_28497":121018,"_3084":121316},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3634":73176,"_31331":73054,"_21707":121318,"_5":14945,"_28497":121022,"_3084":121319},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3634":73177,"_31331":73177,"_5":15305,"_3084":121321,"_31690":121322,"_21707":121323,"_28497":73177},"Instala con Helm",[51145,120741,120975],[],{"_3634":73178,"_31331":73177,"_21707":121325,"_5":14945,"_28497":73177,"_3084":121326},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3634":73179,"_31331":73177,"_5":31687,"_21707":121328,"_28497":121329,"_3084":121330},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3634":73180,"_31331":73177,"_5":31687,"_21707":121332,"_28497":121333,"_3084":120991},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3634":73181,"_31331":73177,"_5":31687,"_21707":121335,"_28497":121336,"_3084":121337},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3634":73182,"_31331":73177,"_5":31687,"_21707":121339,"_28497":121340,"_3084":121341},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3634":73183,"_31331":73177,"_5":31687,"_21707":121343,"_28497":121344,"_3084":121345},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3634":73184,"_31331":73177,"_5":31687,"_21707":121347,"_28497":121348,"_3084":121349},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3634":73185,"_31331":73177,"_5":31687,"_21707":121351,"_28497":121352,"_3084":121353},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3634":73186,"_31331":73177,"_5":31687,"_21707":121355,"_28497":121356,"_3084":121357},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3634":73187,"_31331":73177,"_5":31687,"_21707":121359,"_28497":121360,"_3084":121361},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3634":73188,"_31331":73177,"_5":31687,"_21707":121363,"_28497":121364,"_3084":121365},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3634":73189,"_31331":73177,"_5":31687,"_21707":121367,"_28497":121368,"_3084":121369},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3634":73190,"_31331":73177,"_5":31687,"_21707":121371,"_28497":121372,"_3084":121373},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3634":73191,"_31331":73177,"_21707":121375,"_5":14945,"_28497":121329,"_3084":121376},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3634":73192,"_31331":73177,"_21707":121378,"_5":14945,"_28497":121333,"_3084":121379},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3634":73193,"_31331":73177,"_21707":121381,"_5":14945,"_28497":121333,"_3084":121382},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3634":73194,"_31331":73177,"_21707":121384,"_5":14945,"_28497":121333,"_3084":121385},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3634":73195,"_31331":73177,"_21707":121387,"_5":14945,"_28497":121333,"_3084":121388},[],"un broker RabbitMQ accesible y sus credenciales",{"_3634":73196,"_31331":73177,"_21707":121390,"_5":14945,"_28497":121333,"_3084":121391},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3634":73197,"_31331":73177,"_21707":121393,"_5":14945,"_28497":121333,"_3084":121394},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3634":73198,"_31331":73177,"_21707":121396,"_5":14945,"_28497":121333,"_3084":121397},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3634":73199,"_31331":73177,"_21707":121399,"_5":14945,"_28497":121333,"_3084":121400},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3634":73200,"_31331":73177,"_21707":121402,"_5":14945,"_28497":121333,"_3084":121403},[],"una StorageClass y un diseño de tráfico externo",{"_3634":73201,"_31331":73177,"_21707":121405,"_5":14945,"_28497":121333,"_3084":121406},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3634":73202,"_31331":73177,"_21707":121408,"_5":14945,"_28497":121333,"_3084":121409},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3634":73203,"_31331":73177,"_21707":121411,"_5":14945,"_28497":121333,"_3084":121412},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3634":73204,"_31331":73177,"_21707":121414,"_5":14945,"_28497":121336,"_3084":121415},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3634":73205,"_31331":73177,"_21707":121417,"_5":14945,"_28497":121336,"_3084":121418},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3634":73206,"_31331":73177,"_21707":121420,"_5":14945,"_28497":121336,"_3084":121421},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3634":73207,"_31331":73177,"_21707":121423,"_5":14945,"_28497":121340,"_3084":121424},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3634":73208,"_31331":73177,"_21707":121426,"_5":14945,"_28497":121340,"_3084":121427},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3634":73209,"_31331":73177,"_21707":121429,"_5":14945,"_28497":121340,"_3084":121430},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3634":73210,"_31331":73177,"_21707":121432,"_5":14945,"_28497":121340,"_3084":121433},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3634":73211,"_31331":73177,"_21707":121435,"_5":14945,"_28497":121344,"_3084":121436},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3634":73212,"_31331":73177,"_21707":121438,"_5":14945,"_28497":121344,"_3084":121439},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3634":73213,"_31331":73177,"_21707":121441,"_5":14945,"_28497":121344,"_3084":121442},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3634":73214,"_31331":73177,"_21707":121444,"_5":14945,"_28497":121344,"_3084":121445},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3634":73215,"_31331":73177,"_21707":121447,"_5":14945,"_28497":121344,"_3084":121448},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3634":73216,"_31331":73177,"_21707":121450,"_5":14945,"_28497":121344,"_3084":121451},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3634":73217,"_31331":73177,"_21707":121453,"_5":14945,"_28497":121344,"_3084":121454},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3634":73218,"_31331":73177,"_21707":121456,"_5":14945,"_28497":121344,"_3084":121457},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3634":73219,"_31331":73177,"_21707":121459,"_5":14945,"_28497":121348,"_3084":121460},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3634":73220,"_31331":73177,"_21707":121462,"_5":14945,"_28497":121352,"_3084":121463},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3634":73221,"_31331":73177,"_21707":121465,"_5":14945,"_28497":121352,"_3084":121466},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3634":73222,"_31331":73177,"_21707":121468,"_5":14945,"_28497":121352,"_3084":121469},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3634":73223,"_31331":73177,"_21707":121471,"_5":14945,"_28497":121352,"_3084":121472},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3634":73224,"_31331":73177,"_21707":121474,"_5":14945,"_28497":121352,"_3084":121475},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3634":73225,"_31331":73177,"_21707":121477,"_5":14945,"_28497":121352,"_3084":121478},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3634":73226,"_31331":73177,"_21707":121480,"_5":14945,"_28497":121352,"_3084":121481},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3634":73227,"_31331":73177,"_21707":121483,"_5":14945,"_28497":121356,"_3084":121484},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3634":73228,"_31331":73177,"_21707":121486,"_5":14945,"_28497":121356,"_3084":121487},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3634":73229,"_31331":73177,"_21707":121489,"_5":14945,"_28497":121356,"_3084":121490},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3634":73230,"_31331":73177,"_21707":121492,"_5":14945,"_28497":121356,"_3084":121493},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3634":73231,"_31331":73177,"_21707":121495,"_5":14945,"_28497":121360,"_3084":121496},[],"Para instalar un checkout local:",{"_3634":73232,"_31331":73177,"_21707":121498,"_5":14945,"_28497":121364,"_3084":121499},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3634":73233,"_31331":73177,"_21707":121501,"_5":14945,"_28497":121364,"_3084":121502},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3634":73234,"_31331":73177,"_21707":121504,"_5":14945,"_28497":121368,"_3084":121505},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3634":73235,"_31331":73177,"_21707":121507,"_5":14945,"_28497":121368,"_3084":121508},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3634":73236,"_31331":73177,"_21707":121510,"_5":14945,"_28497":121368,"_3084":121511},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3634":73237,"_31331":73177,"_21707":121513,"_5":14945,"_28497":121368,"_3084":121514},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3634":73238,"_31331":73177,"_21707":121516,"_5":14945,"_28497":121368,"_3084":121517},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3634":73239,"_31331":73177,"_21707":121519,"_5":14945,"_28497":121372,"_3084":121520},[],"Antes de pasar a producción, revisa:",{"_3634":73240,"_31331":73177,"_21707":121522,"_5":14945,"_28497":121372,"_3084":121523},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3634":73241,"_31331":73177,"_21707":121525,"_5":14945,"_28497":121372,"_3084":121526},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3634":73242,"_31331":73177,"_21707":121528,"_5":14945,"_28497":121372,"_3084":121529},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3634":73243,"_31331":73177,"_21707":121531,"_5":14945,"_28497":121372,"_3084":121532},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3634":73244,"_31331":73177,"_21707":121534,"_5":14945,"_28497":121372,"_3084":121535},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3634":73245,"_31331":73177,"_21707":121537,"_5":14945,"_28497":121372,"_3084":121538},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3634":73246,"_31331":73177,"_21707":121540,"_5":14945,"_28497":121372,"_3084":121541},[],"SMTP, observabilidad y entrega de alertas",{"_3634":73247,"_31331":73177,"_21707":121543,"_5":14945,"_28497":121372,"_3084":121544},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3634":73248,"_31331":73177,"_21707":121546,"_5":14945,"_28497":121372,"_3084":121547},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3634":73249,"_31331":73249,"_5":15305,"_3084":121549,"_31690":121550,"_21707":121551,"_28497":73249},"Expón el Gateway",[51145,120741,120975],[],{"_3634":73250,"_31331":73249,"_21707":121553,"_5":14945,"_28497":73249,"_3084":121554},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3634":73251,"_31331":73249,"_5":31687,"_21707":121556,"_28497":121557,"_3084":121558},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3634":73252,"_31331":73249,"_5":31687,"_21707":121560,"_28497":121561,"_3084":121562},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3634":73253,"_31331":73249,"_5":31687,"_21707":121564,"_28497":121565,"_3084":121566},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3634":73254,"_31331":73249,"_5":31687,"_21707":121568,"_28497":121569,"_3084":52008},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#k3s",{"_3634":73255,"_31331":73249,"_5":31687,"_21707":121571,"_28497":121572,"_3084":121573},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3634":73256,"_31331":73249,"_5":31687,"_21707":121575,"_28497":121576,"_3084":121577},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3634":73257,"_31331":73249,"_5":31687,"_21707":121579,"_28497":121580,"_3084":121581},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3634":73258,"_31331":73249,"_5":31687,"_21707":121583,"_28497":121584,"_3084":121585},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3634":73259,"_31331":73249,"_5":31687,"_21707":121587,"_28497":121588,"_3084":121589},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3634":73260,"_31331":73249,"_5":31687,"_21707":121591,"_28497":121592,"_3084":121593},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3634":73261,"_31331":73249,"_5":31687,"_21707":121595,"_28497":121596,"_3084":121597},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3634":73262,"_31331":73249,"_21707":121599,"_5":14945,"_28497":121557,"_3084":121600},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3634":73263,"_31331":73249,"_21707":121602,"_5":14945,"_28497":121557,"_3084":121603},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3634":73264,"_31331":73249,"_21707":121605,"_5":14945,"_28497":121561,"_3084":121606},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3634":73265,"_31331":73249,"_21707":121608,"_5":14945,"_28497":121561,"_3084":121609},[],"Defínelo únicamente cuando:",{"_3634":73266,"_31331":73249,"_21707":121611,"_5":14945,"_28497":121561,"_3084":121612},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3634":73267,"_31331":73249,"_21707":121614,"_5":14945,"_28497":121561,"_3084":121615},[],"esa dirección está asignada a este Gateway",{"_3634":73268,"_31331":73249,"_21707":121617,"_5":14945,"_28497":121561,"_3084":121618},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3634":73269,"_31331":73249,"_21707":121620,"_5":14945,"_28497":121561,"_3084":121621},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3634":73270,"_31331":73249,"_21707":121623,"_5":14945,"_28497":121561,"_3084":121624},[],"No confundas estos valores:",{"_3634":73271,"_31331":73249,"_21707":121626,"_5":14945,"_28497":121561,"_3084":121627},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3634":73272,"_31331":73249,"_21707":121629,"_5":14945,"_28497":121561,"_3084":121630},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3634":73273,"_31331":73249,"_21707":121632,"_5":14945,"_28497":121561,"_3084":121633},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3634":73274,"_31331":73249,"_21707":121635,"_5":14945,"_28497":121565,"_3084":121636},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3634":73275,"_31331":73249,"_21707":121638,"_5":14945,"_28497":121565,"_3084":121639},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3634":73276,"_31331":73249,"_21707":121641,"_5":14945,"_28497":121569,"_3084":121642},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3634":73277,"_31331":73249,"_21707":121644,"_5":14945,"_28497":121569,"_3084":121645},[],"Para el diseño recomendado:",{"_3634":73278,"_31331":73249,"_21707":121647,"_5":14945,"_28497":121569,"_3084":121648},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3634":73279,"_31331":73249,"_21707":121650,"_5":14945,"_28497":121569,"_3084":121651},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3634":73280,"_31331":73249,"_21707":121653,"_5":14945,"_28497":121569,"_3084":121654},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3634":73281,"_31331":73249,"_21707":121656,"_5":14945,"_28497":121569,"_3084":121657},[],"Apunta DNS a la dirección accesible de la VM.",{"_3634":73282,"_31331":73249,"_21707":121659,"_5":14945,"_28497":121569,"_3084":121660},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3634":73283,"_31331":73249,"_21707":121662,"_5":14945,"_28497":121572,"_3084":121663},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3634":73284,"_31331":73249,"_21707":121665,"_5":14945,"_28497":121576,"_3084":121666},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3634":73285,"_31331":73249,"_21707":121668,"_5":14945,"_28497":121576,"_3084":121669},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3634":73286,"_31331":73249,"_21707":121671,"_5":14945,"_28497":121580,"_3084":121672},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3634":73287,"_31331":73249,"_21707":121674,"_5":14945,"_28497":121580,"_3084":121675},[],"Requisito",{"_3634":73288,"_31331":73249,"_21707":121677,"_5":14945,"_28497":121580,"_3084":121678},[],"Diseño recomendado",{"_3634":73289,"_31331":73249,"_21707":121680,"_5":14945,"_28497":121580,"_3084":121681},[],"Consecuencia",{"_3634":73290,"_31331":73249,"_21707":121683,"_5":14945,"_28497":121580,"_3084":121684},[],"Varias URL o servicios de Lamassu",{"_3634":73291,"_31331":73249,"_21707":121686,"_5":14945,"_28497":121580,"_3084":121687},[],"Un Gateway con varias rutas",{"_3634":73292,"_31331":73249,"_21707":121689,"_5":14945,"_28497":121580,"_3084":121690},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3634":73293,"_31331":73249,"_21707":121692,"_5":14945,"_28497":121580,"_3084":121693},[],"Gateways independientes e IP externas distintas",{"_3634":73294,"_31331":73249,"_21707":121695,"_5":14945,"_28497":121580,"_3084":121696},[],"Una VIP por Gateway",{"_3634":73295,"_31331":73249,"_21707":121698,"_5":14945,"_28497":121580,"_3084":121699},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3634":73296,"_31331":73249,"_21707":121701,"_5":14945,"_28497":121580,"_3084":121702},[],"Gateways independientes, un nodo y una IP",{"_3634":73297,"_31331":73249,"_21707":121704,"_5":14945,"_28497":121580,"_3084":121705},[],"Puertos externos diferentes",{"_3634":73298,"_31331":73249,"_21707":121707,"_5":14945,"_28497":121580,"_3084":121708},[],"Los clientes deben indicar puertos no estándar",{"_3634":73299,"_31331":73249,"_21707":121710,"_5":14945,"_28497":121580,"_3084":121711},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3634":73300,"_31331":73249,"_21707":121713,"_5":14945,"_28497":121580,"_3084":121714},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3634":73301,"_31331":73249,"_21707":121716,"_5":14945,"_28497":121580,"_3084":121717},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3634":73302,"_31331":73249,"_21707":121719,"_5":14945,"_28497":121580,"_3084":121720},[],"Recursos Gateway separados pero proxy compartido",{"_3634":73303,"_31331":73249,"_21707":121722,"_5":14945,"_28497":121580,"_3084":121723},[],"Modo merged Gateway de Envoy",{"_3634":73304,"_31331":73249,"_21707":121725,"_5":14945,"_28497":121580,"_3084":121726},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3634":73305,"_31331":73249,"_21707":121728,"_5":14945,"_28497":121580,"_3084":121729},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3634":73306,"_31331":73249,"_21707":121731,"_5":14945,"_28497":121580,"_3084":121732},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3634":73307,"_31331":73249,"_21707":121734,"_5":14945,"_28497":121580,"_3084":121735},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3634":73308,"_31331":73249,"_21707":121737,"_5":14945,"_28497":121580,"_3084":121738},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3634":73309,"_31331":73249,"_21707":121740,"_5":14945,"_28497":121584,"_3084":121741},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3634":73310,"_31331":73249,"_21707":121743,"_5":14945,"_28497":121588,"_3084":121744},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3634":73311,"_31331":73249,"_21707":121746,"_5":14945,"_28497":121588,"_3084":121747},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3634":73312,"_31331":73249,"_21707":121749,"_5":14945,"_28497":121588,"_3084":121750},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3634":73313,"_31331":73249,"_21707":121752,"_5":14945,"_28497":121588,"_3084":121753},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3634":73314,"_31331":73249,"_21707":121755,"_5":14945,"_28497":121588,"_3084":121756},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3634":73315,"_31331":73249,"_21707":121758,"_5":14945,"_28497":121592,"_3084":121759},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3634":73316,"_31331":73249,"_21707":121761,"_5":14945,"_28497":121592,"_3084":121762},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3634":73317,"_31331":73249,"_21707":121764,"_5":14945,"_28497":121596,"_3084":121765},[],"Comprueba, en orden:",{"_3634":73318,"_31331":73249,"_21707":121767,"_5":14945,"_28497":121596,"_3084":121768},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3634":73319,"_31331":73249,"_21707":121770,"_5":14945,"_28497":121596,"_3084":121771},[],"Su estado contiene la dirección esperada.",{"_3634":73320,"_31331":73249,"_21707":121773,"_5":14945,"_28497":121596,"_3084":121774},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3634":73321,"_31331":73249,"_21707":121776,"_5":14945,"_28497":121596,"_3084":121777},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3634":73322,"_31331":73249,"_21707":121779,"_5":14945,"_28497":121596,"_3084":121780},[],"DNS resuelve al endpoint accesible externamente.",{"_3634":73323,"_31331":73249,"_21707":121782,"_5":14945,"_28497":121596,"_3084":121783},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3634":73324,"_31331":73249,"_21707":121785,"_5":14945,"_28497":121596,"_3084":121786},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3634":73325,"_31331":73325,"_5":15305,"_3084":51252,"_31690":121788,"_21707":121789,"_28497":73325},[51145,120741,120975],[],{"_3634":73326,"_31331":73325,"_21707":121791,"_5":14945,"_28497":73325,"_3084":121792},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3634":73327,"_31331":73325,"_5":31687,"_21707":121794,"_28497":121795,"_3084":121796},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3634":73328,"_31331":73325,"_5":31687,"_21707":121798,"_28497":121799,"_3084":121800},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3634":73329,"_31331":73325,"_5":31687,"_21707":121802,"_28497":121803,"_3084":121804},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3634":73330,"_31331":73325,"_5":31687,"_21707":121806,"_28497":121807,"_3084":121808},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3634":73331,"_31331":73325,"_5":31687,"_21707":121810,"_28497":121811,"_3084":121812},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3634":73332,"_31331":73325,"_5":31687,"_21707":121814,"_28497":121815,"_3084":121816},[],"/docs/pr-preview/pr-81/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3634":73333,"_31331":73325,"_21707":121818,"_5":14945,"_28497":121795,"_3084":121819},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3634":73334,"_31331":73325,"_21707":121821,"_5":14945,"_28497":121799,"_3084":121822},[],"Flujo",{"_3634":73335,"_31331":73325,"_21707":121824,"_5":14945,"_28497":121799,"_3084":121825},[],"Úsalo para",{"_3634":73336,"_31331":73325,"_21707":121827,"_5":14945,"_28497":121799,"_3084":121828},[],"Qué instala",{"_3634":73337,"_31331":73325,"_21707":121830,"_5":14945,"_28497":121799,"_3084":52270},[],{"_3634":73338,"_31331":73325,"_21707":121832,"_5":14945,"_28497":121799,"_3084":121833},[],"Producción y entornos controlados",{"_3634":73339,"_31331":73325,"_21707":121835,"_5":14945,"_28497":121799,"_3084":121836},[],"Servicios de Lamassu y recursos de Gateway API",{"_3634":73340,"_31331":73325,"_21707":121838,"_5":14945,"_28497":121799,"_3084":51389},[],{"_3634":73341,"_31331":73325,"_21707":121840,"_5":14945,"_28497":121799,"_3084":121841},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3634":73342,"_31331":73325,"_21707":121843,"_5":14945,"_28497":121799,"_3084":121844},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3634":73343,"_31331":73325,"_21707":121846,"_5":14945,"_28497":121803,"_3084":121847},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3634":73344,"_31331":73325,"_21707":121849,"_5":14945,"_28497":121803,"_3084":121850},[],"Área",{"_3634":73345,"_31331":73325,"_21707":121852,"_5":14945,"_28497":121803,"_3084":121853},[],"El chart de Lamassu proporciona",{"_3634":73346,"_31331":73325,"_21707":121855,"_5":14945,"_28497":121803,"_3084":121856},[],"Tú proporcionas",{"_3634":73347,"_31331":73325,"_21707":121858,"_5":14945,"_28497":121803,"_3084":121859},[],"Aplicaciones Lamassu",{"_3634":73348,"_31331":73325,"_21707":121861,"_5":14945,"_28497":121803,"_3084":121862},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3634":73349,"_31331":73325,"_21707":121864,"_5":14945,"_28497":121803,"_3084":121865},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3634":73350,"_31331":73325,"_21707":121867,"_5":14945,"_28497":121803,"_3084":121868},[],"Datos PostgreSQL",{"_3634":73351,"_31331":73325,"_21707":121870,"_5":14945,"_28497":121803,"_3084":121871},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3634":73352,"_31331":73325,"_21707":121873,"_5":14945,"_28497":121803,"_3084":121874},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3634":73353,"_31331":73325,"_21707":121876,"_5":14945,"_28497":121803,"_3084":121877},[],"Mensajería",{"_3634":73354,"_31331":73325,"_21707":121879,"_5":14945,"_28497":121803,"_3084":121880},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3634":73355,"_31331":73325,"_21707":121882,"_5":14945,"_28497":121803,"_3084":121883},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3634":73356,"_31331":73325,"_21707":121885,"_5":14945,"_28497":121803,"_3084":121886},[],"Identidad",{"_3634":73357,"_31331":73325,"_21707":121888,"_5":14945,"_28497":121803,"_3084":121889},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3634":73358,"_31331":73325,"_21707":121891,"_5":14945,"_28497":121803,"_3084":121892},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3634":73359,"_31331":73325,"_21707":121894,"_5":14945,"_28497":121803,"_3084":121895},[],"Enrutamiento externo",{"_3634":73360,"_31331":73325,"_21707":121897,"_5":14945,"_28497":121803,"_3084":121898},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3634":73361,"_31331":73325,"_21707":121900,"_5":14945,"_28497":121803,"_3084":121901},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3634":73362,"_31331":73325,"_21707":121903,"_5":14945,"_28497":121803,"_3084":52344},[],{"_3634":73363,"_31331":73325,"_21707":121905,"_5":14945,"_28497":121803,"_3084":121906},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3634":73364,"_31331":73325,"_21707":121908,"_5":14945,"_28497":121803,"_3084":121909},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3634":73365,"_31331":73325,"_21707":121911,"_5":14945,"_28497":121803,"_3084":121912},[],"Datos persistentes de la aplicación",{"_3634":73366,"_31331":73325,"_21707":121914,"_5":14945,"_28497":121803,"_3084":121915},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3634":73367,"_31331":73325,"_21707":121917,"_5":14945,"_28497":121803,"_3084":121918},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3634":73368,"_31331":73325,"_21707":121920,"_5":14945,"_28497":121803,"_3084":121921},[],"Integraciones opcionales",{"_3634":73369,"_31331":73325,"_21707":121923,"_5":14945,"_28497":121803,"_3084":121924},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3634":73370,"_31331":73325,"_21707":121926,"_5":14945,"_28497":121803,"_3084":121927},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3634":73371,"_31331":73325,"_21707":121929,"_5":14945,"_28497":121803,"_3084":121930},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3634":73372,"_31331":73325,"_21707":121932,"_5":14945,"_28497":121803,"_3084":121933},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3634":73373,"_31331":73325,"_21707":121935,"_5":14945,"_28497":121807,"_3084":121936},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3634":73374,"_31331":73325,"_21707":121938,"_5":14945,"_28497":121807,"_3084":121939},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3634":73375,"_31331":73325,"_21707":121941,"_5":14945,"_28497":121811,"_3084":121942},[],"Kubernetes 1.24 o posterior",{"_3634":73376,"_31331":73325,"_21707":121944,"_5":14945,"_28497":121811,"_3084":121945},[],"Helm 3.2 o posterior",{"_3634":73377,"_31331":73325,"_21707":121947,"_5":14945,"_28497":121811,"_3084":121948},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3634":73378,"_31331":73325,"_21707":121950,"_5":14945,"_28497":121811,"_3084":121951},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3634":73379,"_31331":73325,"_21707":121953,"_5":14945,"_28497":121811,"_3084":121954},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3634":73380,"_31331":73325,"_21707":121956,"_5":14945,"_28497":121811,"_3084":121957},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3634":73381,"_31331":73325,"_21707":121959,"_5":14945,"_28497":121811,"_3084":121960},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3634":73382,"_31331":73325,"_21707":121962,"_5":14945,"_28497":121815,"_3084":121963},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":73383,"_31331":73325,"_21707":121965,"_5":14945,"_28497":121815,"_3084":121966},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3634":73384,"_31331":73325,"_21707":121968,"_5":14945,"_28497":121815,"_3084":121969},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3634":73385,"_31331":73325,"_21707":121971,"_5":14945,"_28497":121815,"_3084":121972},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3634":73386,"_31331":73386,"_5":15305,"_3084":121974,"_31690":121975,"_21707":121977,"_28497":73386},"Resolución de problemas de despliegue",[51145,120741,121976],"Operación",[],{"_3634":73387,"_31331":73386,"_21707":121979,"_5":14945,"_28497":73386,"_3084":121980},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3634":73388,"_31331":73386,"_5":31687,"_21707":121982,"_28497":121983,"_3084":121984},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3634":73389,"_31331":73386,"_5":31687,"_21707":121986,"_28497":121987,"_3084":121988},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3634":73390,"_31331":73386,"_5":31687,"_21707":121990,"_28497":121991,"_3084":121992},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3634":73391,"_31331":73386,"_5":31687,"_21707":121994,"_28497":121995,"_3084":121996},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3634":73392,"_31331":73386,"_5":31687,"_21707":121998,"_28497":121999,"_3084":122000},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3634":73393,"_31331":73386,"_5":31687,"_21707":122002,"_28497":122003,"_3084":122004},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3634":73394,"_31331":73386,"_5":31687,"_21707":122006,"_28497":122007,"_3084":122008},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3634":73395,"_31331":73386,"_5":31687,"_21707":122010,"_28497":122011,"_3084":122012},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3634":73396,"_31331":73386,"_5":31687,"_21707":122014,"_28497":122015,"_3084":122016},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3634":73397,"_31331":73386,"_5":31687,"_21707":122018,"_28497":122019,"_3084":122020},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3634":73398,"_31331":73386,"_5":31687,"_21707":122022,"_28497":122023,"_3084":122024},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3634":73399,"_31331":73386,"_5":31687,"_21707":122026,"_28497":122027,"_3084":122028},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3634":73400,"_31331":73386,"_5":31687,"_21707":122030,"_28497":122031,"_3084":122032},[],"/docs/pr-preview/pr-81/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3634":73401,"_31331":73386,"_21707":122034,"_5":14945,"_28497":73386,"_3084":122035},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3634":73402,"_31331":73386,"_21707":122037,"_5":14945,"_28497":121987,"_3084":122038},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3634":73403,"_31331":73386,"_21707":122040,"_5":14945,"_28497":121991,"_3084":122041},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3634":73404,"_31331":73386,"_21707":122043,"_5":14945,"_28497":121995,"_3084":122044},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3634":73405,"_31331":73386,"_21707":122046,"_5":14945,"_28497":121999,"_3084":122047},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3634":73406,"_31331":73386,"_21707":122049,"_5":14945,"_28497":122003,"_3084":122050},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3634":73407,"_31331":73386,"_21707":122052,"_5":14945,"_28497":122007,"_3084":122053},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3634":73408,"_31331":73386,"_21707":122055,"_5":14945,"_28497":122007,"_3084":122056},[],"Ejecuta también la prueba de conectividad del chart:",{"_3634":73409,"_31331":73386,"_21707":122058,"_5":14945,"_28497":122007,"_3084":122059},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3634":73410,"_31331":73386,"_21707":122061,"_5":14945,"_28497":122007,"_3084":122062},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3634":73411,"_31331":73386,"_21707":122064,"_5":14945,"_28497":122011,"_3084":122065},[],"Si recibes un 401:",{"_3634":73412,"_31331":73386,"_21707":122067,"_5":14945,"_28497":122011,"_3084":122068},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3634":73413,"_31331":73386,"_21707":122070,"_5":14945,"_28497":122011,"_3084":122071},[],"verifica emisor, audiencia y expiración del token;",{"_3634":73414,"_31331":73386,"_21707":122073,"_5":14945,"_28497":122011,"_3084":122074},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3634":73415,"_31331":73386,"_21707":122076,"_5":14945,"_28497":122011,"_3084":122077},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3634":73416,"_31331":73386,"_21707":122079,"_5":14945,"_28497":122011,"_3084":122080},[],"Si el login termina pero las APIs devuelven 403:",{"_3634":73417,"_31331":73386,"_21707":122082,"_5":14945,"_28497":122011,"_3084":122083},[],"inspecciona los claims reales del token;",{"_3634":73418,"_31331":73386,"_21707":122085,"_5":14945,"_28497":122011,"_3084":122086},[],"confirma que coinciden con un principal activo;",{"_3634":73419,"_31331":73386,"_21707":122088,"_5":14945,"_28497":122011,"_3084":122089},[],"revisa las políticas concedidas al principal;",{"_3634":73420,"_31331":73386,"_21707":122091,"_5":14945,"_28497":122011,"_3084":122092},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3634":73421,"_31331":73386,"_21707":122094,"_5":14945,"_28497":122011,"_3084":122095},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3634":73422,"_31331":73386,"_21707":122097,"_5":14945,"_28497":122015,"_3084":122098},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3634":73423,"_31331":73386,"_21707":122100,"_5":14945,"_28497":122015,"_3084":122101},[],"Localiza el pod y Service de authz.",{"_3634":73424,"_31331":73386,"_21707":122103,"_5":14945,"_28497":122015,"_3084":122104},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3634":73425,"_31331":73386,"_21707":122106,"_5":14945,"_28497":122015,"_3084":122107},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3634":73426,"_31331":73386,"_21707":122109,"_5":14945,"_28497":122015,"_3084":122110},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3634":73427,"_31331":73386,"_21707":122112,"_5":14945,"_28497":122015,"_3084":122113},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3634":73428,"_31331":73386,"_21707":122115,"_5":14945,"_28497":122019,"_3084":122116},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3634":73429,"_31331":73386,"_21707":122118,"_5":14945,"_28497":122023,"_3084":122119},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3634":73430,"_31331":73386,"_21707":122121,"_5":14945,"_28497":122023,"_3084":122122},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3634":73431,"_31331":73386,"_21707":122124,"_5":14945,"_28497":122023,"_3084":122125},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3634":73432,"_31331":73386,"_21707":122127,"_5":14945,"_28497":122023,"_3084":122128},[],"volumen persistente sin enlazar;",{"_3634":73433,"_31331":73386,"_21707":122130,"_5":14945,"_28497":122023,"_3084":122131},[],"imagen inaccesible o política de pull incorrecta;",{"_3634":73434,"_31331":73386,"_21707":122133,"_5":14945,"_28497":122023,"_3084":122134},[],"configuración inválida del motor criptográfico;",{"_3634":73435,"_31331":73386,"_21707":122136,"_5":14945,"_28497":122023,"_3084":122137},[],"límites de CPU o memoria demasiado bajos;",{"_3634":73436,"_31331":73386,"_21707":122139,"_5":14945,"_28497":122023,"_3084":122140},[],"migración previa incompleta.",{"_3634":73437,"_31331":73386,"_21707":122142,"_5":14945,"_28497":122023,"_3084":122143},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3634":73438,"_31331":73386,"_21707":122145,"_5":14945,"_28497":122023,"_3084":122146},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3634":73439,"_31331":73386,"_21707":122148,"_5":14945,"_28497":122023,"_3084":122149},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3634":73440,"_31331":73386,"_21707":122151,"_5":14945,"_28497":122027,"_3084":122152},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3634":73441,"_31331":73386,"_21707":122154,"_5":14945,"_28497":122027,"_3084":122155},[],"verifica que esté habilitado en el servicio emisor;",{"_3634":73442,"_31331":73386,"_21707":122157,"_5":14945,"_28497":122027,"_3084":122158},[],"comprueba conectividad y credenciales AMQP;",{"_3634":73443,"_31331":73386,"_21707":122160,"_5":14945,"_28497":122027,"_3084":122161},[],"revisa exchange, routing key, colas y consumidores;",{"_3634":73444,"_31331":73386,"_21707":122163,"_5":14945,"_28497":122027,"_3084":122164},[],"inspecciona dead-letter queues;",{"_3634":73445,"_31331":73386,"_21707":122166,"_5":14945,"_28497":122027,"_3084":122167},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3634":73446,"_31331":73386,"_21707":122169,"_5":14945,"_28497":122027,"_3084":122170},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3634":73447,"_31331":73386,"_21707":122172,"_5":14945,"_28497":122027,"_3084":122173},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3634":73448,"_31331":73386,"_21707":122175,"_5":14945,"_28497":122027,"_3084":122176},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3634":73449,"_31331":73386,"_21707":122178,"_5":14945,"_28497":122027,"_3084":122179},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3634":73450,"_31331":73386,"_21707":122181,"_5":14945,"_28497":122027,"_3084":122182},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3634":73451,"_31331":73386,"_21707":122184,"_5":14945,"_28497":122027,"_3084":122185},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3634":73452,"_31331":73386,"_21707":122187,"_5":14945,"_28497":122027,"_3084":122188},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3634":73453,"_31331":73386,"_21707":122190,"_5":14945,"_28497":122031,"_3084":122191},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3634":73454,"_31331":73386,"_21707":122193,"_5":14945,"_28497":122031,"_3084":122194},[],"Antes de cerrar una incidencia, guarda:",{"_3634":73455,"_31331":73386,"_21707":122196,"_5":14945,"_28497":122031,"_3084":122197},[],"causa confirmada;",{"_3634":73456,"_31331":73386,"_21707":122199,"_5":14945,"_28497":122031,"_3084":122200},[],"alcance temporal y recursos afectados;",{"_3634":73457,"_31331":73386,"_21707":122202,"_5":14945,"_28497":122031,"_3084":122203},[],"comandos o consultas utilizados;",{"_3634":73458,"_31331":73386,"_21707":122205,"_5":14945,"_28497":122031,"_3084":122206},[],"cambio aplicado y forma de revertirlo;",{"_3634":73459,"_31331":73386,"_21707":122208,"_5":14945,"_28497":122031,"_3084":122209},[],"validación desde un consumidor;",{"_3634":73460,"_31331":73386,"_21707":122211,"_5":14945,"_28497":122031,"_3084":122212},[],"acción preventiva y propietario.",{"_3634":73461,"_31331":73461,"_5":15305,"_3084":122214,"_31690":122215,"_21707":122219,"_28497":73461},"Modelo de datos",[51145,122216,122217,122218],"Plataforma","Administración","Control de acceso",[],{"_3634":73462,"_31331":73461,"_21707":122221,"_5":14945,"_28497":73461,"_3084":122222},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3634":73463,"_31331":73461,"_5":31687,"_21707":122224,"_28497":122225,"_3084":122226},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3634":73464,"_31331":73461,"_5":31687,"_21707":122228,"_28497":122229,"_3084":122230},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3634":73465,"_31331":73461,"_21707":122232,"_5":14945,"_28497":73461,"_3084":122233},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3634":73466,"_31331":73461,"_21707":122235,"_5":14945,"_28497":122225,"_3084":122236},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3634":73467,"_31331":73461,"_21707":122238,"_5":14945,"_28497":122225,"_3084":122239},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3634":73468,"_31331":73461,"_21707":122241,"_5":14945,"_28497":122225,"_3084":122242},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3634":73469,"_31331":73461,"_21707":122244,"_5":14945,"_28497":122229,"_3084":122245},[],"Entidad (`schema_name.entity_type`)",{"_3634":73470,"_31331":73461,"_21707":122247,"_5":14945,"_28497":122229,"_3084":122248},[],"Tabla (`table_name`)",{"_3634":73471,"_31331":73461,"_21707":122250,"_5":14945,"_28497":122229,"_3084":122251},[],"Clave (`primary_key`)",{"_3634":73472,"_31331":73461,"_21707":122253,"_5":14945,"_28497":122229,"_3084":52695},[],{"_3634":73473,"_31331":73461,"_21707":122255,"_5":14945,"_28497":122229,"_3084":52698},[],{"_3634":73474,"_31331":73461,"_21707":122257,"_5":14945,"_28497":122229,"_3084":52701},[],{"_3634":73475,"_31331":73461,"_21707":122259,"_5":14945,"_28497":122229,"_3084":52704},[],{"_3634":73476,"_31331":73461,"_21707":122261,"_5":14945,"_28497":122229,"_3084":52707},[],{"_3634":73477,"_31331":73461,"_21707":122263,"_5":14945,"_28497":122229,"_3084":52710},[],{"_3634":73478,"_31331":73461,"_21707":122265,"_5":14945,"_28497":122229,"_3084":52713},[],{"_3634":73479,"_31331":73461,"_21707":122267,"_5":14945,"_28497":122229,"_3084":52716},[],{"_3634":73480,"_31331":73461,"_21707":122269,"_5":14945,"_28497":122229,"_3084":52710},[],{"_3634":73481,"_31331":73461,"_21707":122271,"_5":14945,"_28497":122229,"_3084":52721},[],{"_3634":73482,"_31331":73461,"_21707":122273,"_5":14945,"_28497":122229,"_3084":52724},[],{"_3634":73483,"_31331":73461,"_21707":122275,"_5":14945,"_28497":122229,"_3084":52727},[],{"_3634":73484,"_31331":73461,"_21707":122277,"_5":14945,"_28497":122229,"_3084":52730},[],{"_3634":73485,"_31331":73461,"_21707":122279,"_5":14945,"_28497":122229,"_3084":52733},[],{"_3634":73486,"_31331":73461,"_21707":122281,"_5":14945,"_28497":122229,"_3084":52710},[],{"_3634":73487,"_31331":73461,"_21707":122283,"_5":14945,"_28497":122229,"_3084":52738},[],{"_3634":73488,"_31331":73461,"_21707":122285,"_5":14945,"_28497":122229,"_3084":52741},[],{"_3634":73489,"_31331":73461,"_21707":122287,"_5":14945,"_28497":122229,"_3084":52710},[],{"_3634":73490,"_31331":73461,"_21707":122289,"_5":14945,"_28497":122229,"_3084":52746},[],{"_3634":73491,"_31331":73461,"_21707":122291,"_5":14945,"_28497":122229,"_3084":52749},[],{"_3634":73492,"_31331":73461,"_21707":122293,"_5":14945,"_28497":122229,"_3084":52710},[],{"_3634":73493,"_31331":73461,"_21707":122295,"_5":14945,"_28497":122229,"_3084":52754},[],{"_3634":73494,"_31331":73461,"_21707":122297,"_5":14945,"_28497":122229,"_3084":52757},[],{"_3634":73495,"_31331":73461,"_21707":122299,"_5":14945,"_28497":122229,"_3084":52710},[],{"_3634":73496,"_31331":73461,"_21707":122301,"_5":14945,"_28497":122229,"_3084":52762},[],{"_3634":73497,"_31331":73461,"_21707":122303,"_5":14945,"_28497":122229,"_3084":52765},[],{"_3634":73498,"_31331":73461,"_21707":122305,"_5":14945,"_28497":122229,"_3084":52768},[],{"_3634":73499,"_31331":73461,"_21707":122307,"_5":14945,"_28497":122229,"_3084":52771},[],{"_3634":73500,"_31331":73461,"_21707":122309,"_5":14945,"_28497":122229,"_3084":52774},[],{"_3634":73501,"_31331":73461,"_21707":122311,"_5":14945,"_28497":122229,"_3084":52777},[],{"_3634":73502,"_31331":73461,"_21707":122313,"_5":14945,"_28497":122229,"_3084":122314},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3634":73503,"_31331":73461,"_21707":122316,"_5":14945,"_28497":122229,"_3084":122317},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3634":73504,"_31331":73461,"_21707":122319,"_5":14945,"_28497":122229,"_3084":122320},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3634":73505,"_31331":73505,"_5":15305,"_3084":122322,"_31690":122323,"_21707":122324,"_28497":73505},"Visión general del control de acceso",[51145,122216,122217,122218],[],{"_3634":73506,"_31331":73505,"_21707":122326,"_5":14945,"_28497":73505,"_3084":122327},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3634":73507,"_31331":73505,"_5":31687,"_21707":122329,"_28497":122330,"_3084":122331},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3634":73508,"_31331":73505,"_5":31687,"_21707":122333,"_28497":122334,"_3084":122335},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3634":73509,"_31331":73505,"_5":31687,"_21707":122337,"_28497":122338,"_3084":122339},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3634":73510,"_31331":73505,"_5":31687,"_21707":122341,"_28497":122342,"_3084":122343},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3634":73511,"_31331":73505,"_5":31687,"_21707":122345,"_28497":122346,"_3084":122347},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3634":73512,"_31331":73505,"_5":31687,"_21707":122349,"_28497":122350,"_3084":122351},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3634":73513,"_31331":73505,"_5":31687,"_21707":122353,"_28497":122354,"_3084":122355},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3634":73514,"_31331":73505,"_5":31687,"_21707":122357,"_28497":122358,"_3084":122359},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3634":73515,"_31331":73505,"_5":31687,"_21707":122361,"_28497":122362,"_3084":122363},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3634":73516,"_31331":73505,"_5":31687,"_21707":122365,"_28497":122366,"_3084":122367},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3634":73517,"_31331":73505,"_5":31687,"_21707":122369,"_28497":122370,"_3084":122371},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3634":73518,"_31331":73505,"_5":31687,"_21707":122373,"_28497":122374,"_3084":122375},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3634":73519,"_31331":73505,"_5":31687,"_21707":122377,"_28497":122378,"_3084":122379},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3634":73520,"_31331":73505,"_5":31687,"_21707":122381,"_28497":122382,"_3084":122383},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3634":73521,"_31331":73505,"_5":31687,"_21707":122385,"_28497":122386,"_3084":122387},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3634":73522,"_31331":73505,"_5":31687,"_21707":122389,"_28497":122390,"_3084":121357},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3634":73523,"_31331":73505,"_5":31687,"_21707":122392,"_28497":122393,"_3084":122394},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3634":73524,"_31331":73505,"_5":31687,"_21707":122396,"_28497":122397,"_3084":122398},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3634":73525,"_31331":73505,"_5":31687,"_21707":122400,"_28497":122401,"_3084":122402},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3634":73526,"_31331":73505,"_5":31687,"_21707":122404,"_28497":122405,"_3084":122406},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3634":73527,"_31331":73505,"_5":31687,"_21707":122408,"_28497":122409,"_3084":122410},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3634":73528,"_31331":73505,"_5":31687,"_21707":122412,"_28497":122413,"_3084":122414},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3634":73529,"_31331":73505,"_5":31687,"_21707":122416,"_28497":122417,"_3084":122418},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3634":73530,"_31331":73505,"_5":31687,"_21707":122420,"_28497":122421,"_3084":122422},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3634":73531,"_31331":73505,"_5":31687,"_21707":122424,"_28497":122425,"_3084":122426},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3634":73532,"_31331":73505,"_5":31687,"_21707":122428,"_28497":122429,"_3084":122430},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3634":73533,"_31331":73505,"_5":31687,"_21707":122432,"_28497":122433,"_3084":122434},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3634":73534,"_31331":73505,"_5":31687,"_21707":122436,"_28497":122437,"_3084":122438},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3634":73535,"_31331":73505,"_5":31687,"_21707":122440,"_28497":122441,"_3084":122442},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3634":73536,"_31331":73505,"_5":31687,"_21707":122444,"_28497":122445,"_3084":122446},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3634":73537,"_31331":73505,"_5":31687,"_21707":122448,"_28497":122449,"_3084":122450},[],"/docs/pr-preview/pr-81/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3634":73538,"_31331":73505,"_21707":122452,"_5":14945,"_28497":73505,"_3084":122453},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3634":73539,"_31331":73505,"_21707":122455,"_5":14945,"_28497":73505,"_3084":122456},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3634":73540,"_31331":73505,"_21707":122458,"_5":14945,"_28497":73505,"_3084":122459},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3634":73541,"_31331":73505,"_21707":122461,"_5":14945,"_28497":122330,"_3084":122462},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3634":73542,"_31331":73505,"_21707":122464,"_5":14945,"_28497":122330,"_3084":122465},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3634":73543,"_31331":73505,"_21707":122467,"_5":14945,"_28497":122330,"_3084":122468},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3634":73544,"_31331":73505,"_21707":122470,"_5":14945,"_28497":122330,"_3084":122471},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3634":73545,"_31331":73505,"_21707":122473,"_5":14945,"_28497":122330,"_3084":122474},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3634":73546,"_31331":73505,"_21707":122476,"_5":14945,"_28497":122330,"_3084":122477},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3634":73547,"_31331":73505,"_21707":122479,"_5":14945,"_28497":122334,"_3084":122480},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3634":73548,"_31331":73505,"_21707":122482,"_5":14945,"_28497":122334,"_3084":122483},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3634":73549,"_31331":73505,"_21707":122485,"_5":14945,"_28497":122338,"_3084":122486},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3634":73550,"_31331":73505,"_21707":122488,"_5":14945,"_28497":122338,"_3084":122489},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3634":73551,"_31331":73505,"_21707":122491,"_5":14945,"_28497":122338,"_3084":122492},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3634":73552,"_31331":73505,"_21707":122494,"_5":14945,"_28497":122338,"_3084":122495},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3634":73553,"_31331":73505,"_21707":122497,"_5":14945,"_28497":122338,"_3084":122498},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3634":73554,"_31331":73505,"_21707":122500,"_5":14945,"_28497":122338,"_3084":122501},[],"Carga por separado las políticas concedidas a cada principal.",{"_3634":73555,"_31331":73505,"_21707":122503,"_5":14945,"_28497":122338,"_3084":122504},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3634":73556,"_31331":73505,"_21707":122506,"_5":14945,"_28497":122338,"_3084":122507},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3634":73557,"_31331":73505,"_21707":122509,"_5":14945,"_28497":122338,"_3084":122510},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3634":73558,"_31331":73505,"_21707":122512,"_5":14945,"_28497":122338,"_3084":122513},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3634":73559,"_31331":73505,"_21707":122515,"_5":14945,"_28497":122338,"_3084":122516},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3634":73560,"_31331":73505,"_21707":122518,"_5":14945,"_28497":122338,"_3084":122519},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3634":73561,"_31331":73505,"_21707":122521,"_5":14945,"_28497":122342,"_3084":122522},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3634":73562,"_31331":73505,"_21707":122524,"_5":14945,"_28497":122342,"_3084":122525},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3634":73563,"_31331":73505,"_21707":122527,"_5":14945,"_28497":122342,"_3084":122528},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3634":73564,"_31331":73505,"_21707":122530,"_5":14945,"_28497":122342,"_3084":122531},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3634":73565,"_31331":73505,"_21707":122533,"_5":14945,"_28497":122342,"_3084":122534},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3634":73566,"_31331":73505,"_21707":122536,"_5":14945,"_28497":122342,"_3084":122537},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3634":73567,"_31331":73505,"_21707":122539,"_5":14945,"_28497":122342,"_3084":122540},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3634":73568,"_31331":73505,"_21707":122542,"_5":14945,"_28497":122342,"_3084":122543},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3634":73569,"_31331":73505,"_21707":122545,"_5":14945,"_28497":122342,"_3084":122546},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3634":73570,"_31331":73505,"_21707":122548,"_5":14945,"_28497":122342,"_3084":122549},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3634":73571,"_31331":73505,"_21707":122551,"_5":14945,"_28497":122346,"_3084":122552},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3634":73572,"_31331":73505,"_21707":122554,"_5":14945,"_28497":122346,"_3084":122555},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3634":73573,"_31331":73505,"_21707":122557,"_5":14945,"_28497":122346,"_3084":122558},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3634":73574,"_31331":73505,"_21707":122560,"_5":14945,"_28497":122346,"_3084":122561},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3634":73575,"_31331":73505,"_21707":122563,"_5":14945,"_28497":122346,"_3084":122564},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3634":73576,"_31331":73505,"_21707":122566,"_5":14945,"_28497":122346,"_3084":122567},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3634":73577,"_31331":73505,"_21707":122569,"_5":14945,"_28497":122346,"_3084":122570},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3634":73578,"_31331":73505,"_21707":122572,"_5":14945,"_28497":122346,"_3084":122573},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3634":73579,"_31331":73505,"_21707":122575,"_5":14945,"_28497":122346,"_3084":122576},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3634":73580,"_31331":73505,"_21707":122578,"_5":14945,"_28497":122346,"_3084":122579},[],"Las acciones se dividen en dos grupos:",{"_3634":73581,"_31331":73505,"_21707":122581,"_5":14945,"_28497":122346,"_3084":122582},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3634":73582,"_31331":73505,"_21707":122584,"_5":14945,"_28497":122346,"_3084":122585},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3634":73583,"_31331":73505,"_21707":122587,"_5":14945,"_28497":122346,"_3084":122588},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3634":73584,"_31331":73505,"_21707":122590,"_5":14945,"_28497":122350,"_3084":122591},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3634":73585,"_31331":73505,"_21707":122593,"_5":14945,"_28497":122350,"_3084":122594},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3634":73586,"_31331":73505,"_21707":122596,"_5":14945,"_28497":122350,"_3084":122597},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3634":73587,"_31331":73505,"_21707":122599,"_5":14945,"_28497":122354,"_3084":122600},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3634":73588,"_31331":73505,"_21707":122602,"_5":14945,"_28497":122354,"_3084":122603},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3634":73589,"_31331":73505,"_21707":122605,"_5":14945,"_28497":122354,"_3084":122606},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3634":73590,"_31331":73505,"_21707":122608,"_5":14945,"_28497":122354,"_3084":122609},[],"Los operadores implementados son:",{"_3634":73591,"_31331":73505,"_21707":122611,"_5":14945,"_28497":122354,"_3084":122612},[],"`equals`, para igualdad exacta;",{"_3634":73592,"_31331":73505,"_21707":122614,"_5":14945,"_28497":122354,"_3084":122615},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3634":73593,"_31331":73505,"_21707":122617,"_5":14945,"_28497":122354,"_3084":122618},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3634":73594,"_31331":73505,"_21707":122620,"_5":14945,"_28497":122354,"_3084":122621},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3634":73595,"_31331":73505,"_21707":122623,"_5":14945,"_28497":122358,"_3084":122624},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3634":73596,"_31331":73505,"_21707":122626,"_5":14945,"_28497":122358,"_3084":122627},[],"Los modos disponibles son:",{"_3634":73597,"_31331":73505,"_21707":122629,"_5":14945,"_28497":122358,"_3084":122630},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3634":73598,"_31331":73505,"_21707":122632,"_5":14945,"_28497":122358,"_3084":122633},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3634":73599,"_31331":73505,"_21707":122635,"_5":14945,"_28497":122358,"_3084":122636},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3634":73600,"_31331":73505,"_21707":122638,"_5":14945,"_28497":122358,"_3084":122639},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3634":73601,"_31331":73505,"_21707":122641,"_5":14945,"_28497":122358,"_3084":122642},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3634":73602,"_31331":73505,"_21707":122644,"_5":14945,"_28497":122358,"_3084":122645},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3634":73603,"_31331":73505,"_21707":122647,"_5":14945,"_28497":122362,"_3084":122648},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3634":73604,"_31331":73505,"_21707":122650,"_5":14945,"_28497":122362,"_3084":122651},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3634":73605,"_31331":73505,"_21707":122653,"_5":14945,"_28497":122362,"_3084":122654},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3634":73606,"_31331":73505,"_21707":122656,"_5":14945,"_28497":122362,"_3084":122657},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3634":73607,"_31331":73505,"_21707":122659,"_5":14945,"_28497":122370,"_3084":122660},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3634":73608,"_31331":73505,"_21707":122662,"_5":14945,"_28497":122370,"_3084":122663},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3634":73609,"_31331":73505,"_21707":122665,"_5":14945,"_28497":122374,"_3084":122666},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3634":73610,"_31331":73505,"_21707":122668,"_5":14945,"_28497":122374,"_3084":122669},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3634":73611,"_31331":73505,"_21707":122671,"_5":14945,"_28497":122374,"_3084":122672},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3634":73612,"_31331":73505,"_21707":122674,"_5":14945,"_28497":122374,"_3084":122675},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3634":73613,"_31331":73505,"_21707":122677,"_5":14945,"_28497":122374,"_3084":122678},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3634":73614,"_31331":73505,"_21707":122680,"_5":14945,"_28497":122378,"_3084":122681},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3634":73615,"_31331":73505,"_21707":122683,"_5":14945,"_28497":122378,"_3084":122684},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3634":73616,"_31331":73505,"_21707":122686,"_5":14945,"_28497":122378,"_3084":122687},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3634":73617,"_31331":73505,"_21707":122689,"_5":14945,"_28497":122382,"_3084":122690},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3634":73618,"_31331":73505,"_21707":122692,"_5":14945,"_28497":122382,"_3084":122693},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3634":73619,"_31331":73505,"_21707":122695,"_5":14945,"_28497":122382,"_3084":122696},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3634":73620,"_31331":73505,"_21707":122698,"_5":14945,"_28497":122382,"_3084":122699},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3634":73621,"_31331":73505,"_21707":122701,"_5":14945,"_28497":122382,"_3084":122702},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3634":73622,"_31331":73505,"_21707":122704,"_5":14945,"_28497":122382,"_3084":122705},[],"Ten en cuenta que:",{"_3634":73623,"_31331":73505,"_21707":122707,"_5":14945,"_28497":122382,"_3084":122708},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3634":73624,"_31331":73505,"_21707":122710,"_5":14945,"_28497":122382,"_3084":122711},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3634":73625,"_31331":73505,"_21707":122713,"_5":14945,"_28497":122382,"_3084":122714},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3634":73626,"_31331":73505,"_21707":122716,"_5":14945,"_28497":122386,"_3084":122717},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3634":73627,"_31331":73505,"_21707":122719,"_5":14945,"_28497":122386,"_3084":122720},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3634":73628,"_31331":73505,"_21707":122722,"_5":14945,"_28497":122386,"_3084":122723},[],"acceso completo y de solo lectura a KMS;",{"_3634":73629,"_31331":73505,"_21707":122725,"_5":14945,"_28497":122386,"_3084":122726},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3634":73630,"_31331":73505,"_21707":122728,"_5":14945,"_28497":122386,"_3084":122729},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3634":73631,"_31331":73505,"_21707":122731,"_5":14945,"_28497":122386,"_3084":122732},[],"acceso a la interfaz;",{"_3634":73632,"_31331":73505,"_21707":122734,"_5":14945,"_28497":122386,"_3084":122735},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3634":73633,"_31331":73505,"_21707":122737,"_5":14945,"_28497":122386,"_3084":122738},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3634":73634,"_31331":73505,"_21707":122740,"_5":14945,"_28497":122386,"_3084":122741},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3634":73635,"_31331":73505,"_21707":122743,"_5":14945,"_28497":122386,"_3084":122744},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3634":73636,"_31331":73505,"_21707":122746,"_5":14945,"_28497":122386,"_3084":122747},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3634":73637,"_31331":73505,"_21707":122749,"_5":14945,"_28497":122390,"_3084":122750},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3634":73638,"_31331":73505,"_21707":122752,"_5":14945,"_28497":122390,"_3084":122753},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3634":73639,"_31331":73505,"_21707":122755,"_5":14945,"_28497":122390,"_3084":122756},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3634":73640,"_31331":73505,"_21707":122758,"_5":14945,"_28497":122393,"_3084":122759},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3634":73641,"_31331":73505,"_21707":122761,"_5":14945,"_28497":122397,"_3084":122762},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3634":73642,"_31331":73505,"_21707":122764,"_5":14945,"_28497":122397,"_3084":122765},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3634":73643,"_31331":73505,"_21707":122767,"_5":14945,"_28497":122401,"_3084":122768},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3634":73644,"_31331":73505,"_21707":122770,"_5":14945,"_28497":122405,"_3084":122771},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3634":73645,"_31331":73505,"_21707":122773,"_5":14945,"_28497":122409,"_3084":122774},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3634":73646,"_31331":73505,"_21707":122776,"_5":14945,"_28497":122413,"_3084":122777},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3634":73647,"_31331":73505,"_21707":122779,"_5":14945,"_28497":122413,"_3084":122780},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3634":73648,"_31331":73505,"_21707":122782,"_5":14945,"_28497":122417,"_3084":122783},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3634":73649,"_31331":73505,"_21707":122785,"_5":14945,"_28497":122417,"_3084":122786},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3634":73650,"_31331":73505,"_21707":122788,"_5":14945,"_28497":122417,"_3084":122789},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3634":73651,"_31331":73505,"_21707":122791,"_5":14945,"_28497":122417,"_3084":122792},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3634":73652,"_31331":73505,"_21707":122794,"_5":14945,"_28497":122417,"_3084":122795},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3634":73653,"_31331":73505,"_21707":122797,"_5":14945,"_28497":122417,"_3084":122798},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3634":73654,"_31331":73505,"_21707":122800,"_5":14945,"_28497":122417,"_3084":122801},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3634":73655,"_31331":73505,"_21707":122803,"_5":14945,"_28497":122417,"_3084":122804},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3634":73656,"_31331":73505,"_21707":122806,"_5":14945,"_28497":122421,"_3084":122807},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3634":73657,"_31331":73505,"_21707":122809,"_5":14945,"_28497":122421,"_3084":122810},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3634":73658,"_31331":73505,"_21707":122812,"_5":14945,"_28497":122421,"_3084":122813},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3634":73659,"_31331":73505,"_21707":122815,"_5":14945,"_28497":122425,"_3084":122816},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3634":73660,"_31331":73505,"_21707":122818,"_5":14945,"_28497":122425,"_3084":122819},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3634":73661,"_31331":73505,"_21707":122821,"_5":14945,"_28497":122425,"_3084":122822},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3634":73662,"_31331":73505,"_21707":122824,"_5":14945,"_28497":122425,"_3084":122825},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3634":73663,"_31331":73505,"_21707":122827,"_5":14945,"_28497":122425,"_3084":122828},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3634":73664,"_31331":73505,"_21707":122830,"_5":14945,"_28497":122425,"_3084":122831},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3634":73665,"_31331":73505,"_21707":122833,"_5":14945,"_28497":122425,"_3084":122834},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3634":73666,"_31331":73505,"_21707":122836,"_5":14945,"_28497":122425,"_3084":122837},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3634":73667,"_31331":73505,"_21707":122839,"_5":14945,"_28497":122433,"_3084":122840},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3634":73668,"_31331":73505,"_21707":122842,"_5":14945,"_28497":122437,"_3084":122843},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3634":73669,"_31331":73505,"_21707":122845,"_5":14945,"_28497":122437,"_3084":122846},[],"que exista un principal activo del tipo correcto;",{"_3634":73670,"_31331":73505,"_21707":122848,"_5":14945,"_28497":122437,"_3084":122849},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3634":73671,"_31331":73505,"_21707":122851,"_5":14945,"_28497":122437,"_3084":122852},[],"que todas las condiciones del principal se cumplan;",{"_3634":73672,"_31331":73505,"_21707":122854,"_5":14945,"_28497":122437,"_3084":122855},[],"que el principal tenga concedida la política esperada;",{"_3634":73673,"_31331":73505,"_21707":122857,"_5":14945,"_28497":122437,"_3084":122858},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3634":73674,"_31331":73505,"_21707":122860,"_5":14945,"_28497":122437,"_3084":122861},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3634":73675,"_31331":73505,"_21707":122863,"_5":14945,"_28497":122437,"_3084":122864},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3634":73676,"_31331":73505,"_21707":122866,"_5":14945,"_28497":122437,"_3084":122867},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3634":73677,"_31331":73505,"_21707":122869,"_5":14945,"_28497":122441,"_3084":122870},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3634":73678,"_31331":73505,"_21707":122872,"_5":14945,"_28497":122445,"_3084":122873},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3634":73679,"_31331":73505,"_21707":122875,"_5":14945,"_28497":122449,"_3084":122876},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3634":73680,"_31331":73505,"_21707":122878,"_5":14945,"_28497":122449,"_3084":122879},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3634":73681,"_31331":73681,"_5":15305,"_3084":122881,"_31690":122882,"_21707":122883,"_28497":73681},"Alertas y suscripciones",[51145,122216,122217],[],{"_3634":73682,"_31331":73681,"_21707":122885,"_5":14945,"_28497":73681,"_3084":122886},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3634":73683,"_31331":73681,"_5":31687,"_21707":122888,"_28497":122889,"_3084":122890},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3634":73684,"_31331":73681,"_5":31687,"_21707":122892,"_28497":122893,"_3084":122894},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3634":73685,"_31331":73681,"_5":31687,"_21707":122896,"_28497":122897,"_3084":122898},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3634":73686,"_31331":73681,"_5":31687,"_21707":122900,"_28497":122901,"_3084":122902},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3634":73687,"_31331":73681,"_5":31687,"_21707":122904,"_28497":122905,"_3084":122906},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3634":73688,"_31331":73681,"_5":31687,"_21707":122908,"_28497":122909,"_3084":122910},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3634":73689,"_31331":73681,"_5":31687,"_21707":122912,"_28497":122913,"_3084":122914},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3634":73690,"_31331":73681,"_5":31687,"_21707":122916,"_28497":122917,"_3084":122918},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3634":73691,"_31331":73681,"_5":31687,"_21707":122920,"_28497":122921,"_3084":122922},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3634":73692,"_31331":73681,"_5":31687,"_21707":122924,"_28497":122925,"_3084":122926},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3634":73693,"_31331":73681,"_5":31687,"_21707":122928,"_28497":122929,"_3084":122930},[],"/docs/pr-preview/pr-81/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3634":73694,"_31331":73681,"_21707":122932,"_5":14945,"_28497":73681,"_3084":122933},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3634":73695,"_31331":73681,"_21707":122935,"_5":14945,"_28497":122889,"_3084":122936},[],"Un servicio publica un evento de dominio.",{"_3634":73696,"_31331":73681,"_21707":122938,"_5":14945,"_28497":122889,"_3084":122939},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3634":73697,"_31331":73681,"_21707":122941,"_5":14945,"_28497":122889,"_3084":122942},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3634":73698,"_31331":73681,"_21707":122944,"_5":14945,"_28497":122889,"_3084":122945},[],"Lamassu entrega el evento al canal configurado.",{"_3634":73699,"_31331":73681,"_21707":122947,"_5":14945,"_28497":122889,"_3084":122948},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3634":73700,"_31331":73681,"_21707":122950,"_5":14945,"_28497":122893,"_3084":122951},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3634":73701,"_31331":73681,"_21707":122953,"_5":14945,"_28497":122893,"_3084":122954},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3634":73702,"_31331":73681,"_21707":122956,"_5":14945,"_28497":122893,"_3084":122957},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3634":73703,"_31331":73681,"_21707":122959,"_5":14945,"_28497":122893,"_3084":122960},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3634":73704,"_31331":73681,"_21707":122962,"_5":14945,"_28497":122893,"_3084":122963},[],"`apikey_options` necesita `header` y `key`.",{"_3634":73705,"_31331":73681,"_21707":122965,"_5":14945,"_28497":122893,"_3084":122966},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3634":73706,"_31331":73681,"_21707":122968,"_5":14945,"_28497":122893,"_3084":122969},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3634":73707,"_31331":73681,"_21707":122971,"_5":14945,"_28497":122893,"_3084":122972},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3634":73708,"_31331":73681,"_21707":122974,"_5":14945,"_28497":122901,"_3084":122975},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3634":73709,"_31331":73681,"_21707":122977,"_5":14945,"_28497":122905,"_3084":122978},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3634":73710,"_31331":73681,"_21707":122980,"_5":14945,"_28497":122909,"_3084":122981},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3634":73711,"_31331":73681,"_21707":122983,"_5":14945,"_28497":122909,"_3084":122984},[],"**None** notifica todas las instancias del evento.",{"_3634":73712,"_31331":73681,"_21707":122986,"_5":14945,"_28497":122909,"_3084":122987},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3634":73713,"_31331":73681,"_21707":122989,"_5":14945,"_28497":122909,"_3084":122990},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3634":73714,"_31331":73681,"_21707":122992,"_5":14945,"_28497":122909,"_3084":122993},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3634":73715,"_31331":73681,"_21707":122995,"_5":14945,"_28497":122909,"_3084":122996},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3634":73716,"_31331":73681,"_21707":122998,"_5":14945,"_28497":122909,"_3084":122999},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3634":73717,"_31331":73681,"_21707":123001,"_5":14945,"_28497":122913,"_3084":123002},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3634":73718,"_31331":73681,"_21707":123004,"_5":14945,"_28497":122917,"_3084":123005},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3634":73719,"_31331":73681,"_21707":123007,"_5":14945,"_28497":122917,"_3084":123008},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3634":73720,"_31331":73681,"_21707":123010,"_5":14945,"_28497":122917,"_3084":123011},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3634":73721,"_31331":73681,"_21707":123013,"_5":14945,"_28497":122917,"_3084":123014},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3634":73722,"_31331":73681,"_21707":123016,"_5":14945,"_28497":122917,"_3084":123017},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3634":73723,"_31331":73681,"_21707":123019,"_5":14945,"_28497":122917,"_3084":123020},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3634":73724,"_31331":73681,"_21707":123022,"_5":14945,"_28497":122917,"_3084":123023},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3634":73725,"_31331":73681,"_21707":123025,"_5":14945,"_28497":122917,"_3084":123026},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3634":73726,"_31331":73681,"_21707":123028,"_5":14945,"_28497":122921,"_3084":123029},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3634":73727,"_31331":73681,"_21707":123031,"_5":14945,"_28497":122921,"_3084":123032},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3634":73728,"_31331":73681,"_21707":123034,"_5":14945,"_28497":122921,"_3084":123035},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3634":73729,"_31331":73681,"_21707":123037,"_5":14945,"_28497":122921,"_3084":123038},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3634":73730,"_31331":73681,"_21707":123040,"_5":14945,"_28497":122921,"_3084":123041},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3634":73731,"_31331":73681,"_21707":123043,"_5":14945,"_28497":122921,"_3084":123044},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3634":73732,"_31331":73681,"_21707":123046,"_5":14945,"_28497":122921,"_3084":123047},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3634":73733,"_31331":73681,"_21707":123049,"_5":14945,"_28497":122921,"_3084":123050},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3634":73734,"_31331":73681,"_21707":123052,"_5":14945,"_28497":122925,"_3084":123053},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3634":73735,"_31331":73681,"_21707":123055,"_5":14945,"_28497":122925,"_3084":123056},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3634":73736,"_31331":73681,"_21707":123058,"_5":14945,"_28497":122929,"_3084":123059},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3634":73737,"_31331":73681,"_21707":123061,"_5":14945,"_28497":122929,"_3084":123062},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3634":73738,"_31331":73681,"_21707":123064,"_5":14945,"_28497":122929,"_3084":123065},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3634":73739,"_31331":73681,"_21707":123067,"_5":14945,"_28497":122929,"_3084":123068},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3634":73740,"_31331":73681,"_21707":123070,"_5":14945,"_28497":122929,"_3084":123071},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3634":73741,"_31331":73681,"_21707":123073,"_5":14945,"_28497":122929,"_3084":123074},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3634":73742,"_31331":73681,"_21707":123076,"_5":14945,"_28497":122929,"_3084":123077},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3634":73743,"_31331":73681,"_21707":123079,"_5":14945,"_28497":122929,"_3084":123080},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3634":73744,"_31331":73681,"_21707":123082,"_5":14945,"_28497":122929,"_3084":123083},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3634":73745,"_31331":73681,"_21707":123085,"_5":14945,"_28497":122929,"_3084":123086},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3634":73746,"_31331":73746,"_5":15305,"_3084":123088,"_31690":123089,"_21707":123090,"_28497":73746},"Registros de auditoría",[51145,122216,122217],[],{"_3634":73747,"_31331":73746,"_21707":123092,"_5":14945,"_28497":73746,"_3084":123093},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3634":73748,"_31331":73746,"_5":31687,"_21707":123095,"_28497":123096,"_3084":123097},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3634":73749,"_31331":73746,"_5":31687,"_21707":123099,"_28497":123100,"_3084":123101},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3634":73750,"_31331":73746,"_5":31687,"_21707":123103,"_28497":123104,"_3084":123105},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3634":73751,"_31331":73746,"_5":31687,"_21707":123107,"_28497":123108,"_3084":123109},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3634":73752,"_31331":73746,"_5":31687,"_21707":123111,"_28497":123112,"_3084":123113},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3634":73753,"_31331":73746,"_5":31687,"_21707":123115,"_28497":123116,"_3084":123117},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3634":73754,"_31331":73746,"_5":31687,"_21707":123119,"_28497":123120,"_3084":123121},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3634":73755,"_31331":73746,"_5":31687,"_21707":123123,"_28497":123124,"_3084":123125},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3634":73756,"_31331":73746,"_5":31687,"_21707":123127,"_28497":123128,"_3084":123129},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3634":73757,"_31331":73746,"_5":31687,"_21707":123131,"_28497":123132,"_3084":123133},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3634":73758,"_31331":73746,"_5":31687,"_21707":123135,"_28497":123136,"_3084":123137},[],"/docs/pr-preview/pr-81/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3634":73759,"_31331":73746,"_21707":123139,"_5":14945,"_28497":73746,"_3084":123140},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3634":73760,"_31331":73746,"_21707":123142,"_5":14945,"_28497":123096,"_3084":123143},[],"El cuerpo de auditoría incluye:",{"_3634":73761,"_31331":73746,"_21707":123145,"_5":14945,"_28497":123096,"_3084":123146},[],"input: datos recibidos por la operación;",{"_3634":73762,"_31331":73746,"_21707":123148,"_5":14945,"_28497":123096,"_3084":123149},[],"has\\_error: indica si el servicio devolvió un error;",{"_3634":73763,"_31331":73746,"_21707":123151,"_5":14945,"_28497":123096,"_3084":123152},[],"output: resultado producido o mensaje de error;",{"_3634":73764,"_31331":73746,"_21707":123154,"_5":14945,"_28497":123096,"_3084":123155},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3634":73765,"_31331":73746,"_21707":123157,"_5":14945,"_28497":123096,"_3084":123158},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3634":73766,"_31331":73746,"_21707":123160,"_5":14945,"_28497":123096,"_3084":123161},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3634":73767,"_31331":73746,"_21707":123163,"_5":14945,"_28497":123100,"_3084":123164},[],"El backend aplica auditoría a mutaciones de:",{"_3634":73768,"_31331":73746,"_21707":123166,"_5":14945,"_28497":123100,"_3084":123167},[],"autoridades, certificados y perfiles de emisión;",{"_3634":73769,"_31331":73746,"_21707":123169,"_5":14945,"_28497":123100,"_3084":123170},[],"claves y motores KMS;",{"_3634":73770,"_31331":73746,"_21707":123172,"_5":14945,"_28497":123100,"_3084":123173},[],"dispositivos e identidades;",{"_3634":73771,"_31331":73746,"_21707":123175,"_5":14945,"_28497":123100,"_3084":123176},[],"DMS y operaciones de enrolamiento;",{"_3634":73772,"_31331":73746,"_21707":123178,"_5":14945,"_28497":123100,"_3084":123179},[],"funciones de validación y CRL;",{"_3634":73773,"_31331":73746,"_21707":123181,"_5":14945,"_28497":123100,"_3084":123182},[],"principales, políticas y concesiones de autorización.",{"_3634":73774,"_31331":73746,"_21707":123184,"_5":14945,"_28497":123100,"_3084":123185},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3634":73775,"_31331":73746,"_21707":123187,"_5":14945,"_28497":123104,"_3084":123188},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3634":73776,"_31331":73746,"_21707":123190,"_5":14945,"_28497":123104,"_3084":123191},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3634":73777,"_31331":73746,"_21707":123193,"_5":14945,"_28497":123104,"_3084":123194},[],"Diseña el consumidor para:",{"_3634":73778,"_31331":73746,"_21707":123196,"_5":14945,"_28497":123104,"_3084":123197},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3634":73779,"_31331":73746,"_21707":123199,"_5":14945,"_28497":123104,"_3084":123200},[],"conservar el CloudEvent completo sin modificar;",{"_3634":73780,"_31331":73746,"_21707":123202,"_5":14945,"_28497":123104,"_3084":123203},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3634":73781,"_31331":73746,"_21707":123205,"_5":14945,"_28497":123104,"_3084":123206},[],"cifrar en tránsito y en reposo;",{"_3634":73782,"_31331":73746,"_21707":123208,"_5":14945,"_28497":123104,"_3084":123209},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3634":73783,"_31331":73746,"_21707":123211,"_5":14945,"_28497":123104,"_3084":123212},[],"aplicar una política explícita de retención y legal hold;",{"_3634":73784,"_31331":73746,"_21707":123214,"_5":14945,"_28497":123104,"_3084":123215},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3634":73785,"_31331":73746,"_21707":123217,"_5":14945,"_28497":123108,"_3084":123218},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3634":73786,"_31331":73746,"_21707":123220,"_5":14945,"_28497":123108,"_3084":123221},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3634":73787,"_31331":73746,"_21707":123223,"_5":14945,"_28497":123116,"_3084":123224},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3634":73788,"_31331":73746,"_21707":123226,"_5":14945,"_28497":123120,"_3084":123227},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3634":73789,"_31331":73746,"_21707":123229,"_5":14945,"_28497":123124,"_3084":123230},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3634":73790,"_31331":73746,"_21707":123232,"_5":14945,"_28497":123128,"_3084":123233},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3634":73791,"_31331":73746,"_21707":123235,"_5":14945,"_28497":123132,"_3084":123236},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3634":73792,"_31331":73746,"_21707":123238,"_5":14945,"_28497":123136,"_3084":123239},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3634":73793,"_31331":73746,"_21707":123241,"_5":14945,"_28497":123136,"_3084":123242},[],"aparece un evento de auditoría correcto;",{"_3634":73794,"_31331":73746,"_21707":123244,"_5":14945,"_28497":123136,"_3084":123245},[],"el principal coincide con la identidad utilizada;",{"_3634":73795,"_31331":73746,"_21707":123247,"_5":14945,"_28497":123136,"_3084":123248},[],"el consumidor lo persiste una sola vez;",{"_3634":73796,"_31331":73746,"_21707":123250,"_5":14945,"_28497":123136,"_3084":123251},[],"puede recuperarse por recurso, actor y periodo;",{"_3634":73797,"_31331":73746,"_21707":123253,"_5":14945,"_28497":123136,"_3084":123254},[],"una interrupción del consumidor produce una alerta.",{"_3634":73798,"_31331":73746,"_21707":123256,"_5":14945,"_28497":123136,"_3084":123257},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3634":73799,"_31331":73799,"_5":15305,"_3084":123259,"_31690":123260,"_21707":123261,"_28497":73799},"Arquitectura de la plataforma",[51145,122216],[],{"_3634":73800,"_31331":73799,"_21707":123263,"_5":14945,"_28497":73799,"_3084":123264},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3634":73801,"_31331":73799,"_5":31687,"_21707":123266,"_28497":123267,"_3084":123268},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3634":73802,"_31331":73799,"_5":31687,"_21707":123270,"_28497":123271,"_3084":123272},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3634":73803,"_31331":73799,"_5":31687,"_21707":123274,"_28497":123275,"_3084":123276},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3634":73804,"_31331":73799,"_5":31687,"_21707":123278,"_28497":123279,"_3084":123280},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3634":73805,"_31331":73799,"_5":31687,"_21707":123282,"_28497":123283,"_3084":123284},[],"/docs/pr-preview/pr-81/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3634":73806,"_31331":73799,"_21707":123286,"_5":14945,"_28497":73799,"_3084":123287},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3634":73807,"_31331":73799,"_21707":123289,"_5":14945,"_28497":73799,"_3084":123290},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3634":73808,"_31331":73799,"_21707":123292,"_5":14945,"_28497":123267,"_3084":123293},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3634":73809,"_31331":73799,"_21707":123295,"_5":14945,"_28497":123271,"_3084":123296},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3634":73810,"_31331":73799,"_21707":123298,"_5":14945,"_28497":123275,"_3084":123299},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3634":73811,"_31331":73799,"_21707":123301,"_5":14945,"_28497":123279,"_3084":123302},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3634":73812,"_31331":73799,"_21707":123304,"_5":14945,"_28497":123283,"_3084":123305},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3634":73813,"_31331":73813,"_5":15305,"_3084":123307,"_31690":123308,"_21707":123309,"_28497":73813},"Cómo funciona Lamassu",[51145,122216],[],{"_3634":73814,"_31331":73813,"_21707":123311,"_5":14945,"_28497":73813,"_3084":123312},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3634":73815,"_31331":73813,"_5":31687,"_21707":123314,"_28497":123315,"_3084":123316},[],"/docs/pr-preview/pr-81/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3634":73816,"_31331":73813,"_5":31687,"_21707":123318,"_28497":123319,"_3084":123320},[],"/docs/pr-preview/pr-81/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3634":73817,"_31331":73813,"_21707":123322,"_5":14945,"_28497":73813,"_3084":123323},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3634":73818,"_31331":73813,"_21707":123325,"_5":14945,"_28497":123315,"_3084":123326},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3634":73819,"_31331":73813,"_21707":123328,"_5":14945,"_28497":123315,"_3084":123329},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3634":73820,"_31331":73813,"_21707":123331,"_5":14945,"_28497":123315,"_3084":123332},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3634":73821,"_31331":73813,"_21707":123334,"_5":14945,"_28497":123315,"_3084":123335},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3634":73822,"_31331":73813,"_21707":123337,"_5":14945,"_28497":123315,"_3084":123338},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3634":73823,"_31331":73813,"_21707":123340,"_5":14945,"_28497":123319,"_3084":123341},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3634":73824,"_31331":73813,"_21707":123343,"_5":14945,"_28497":123319,"_3084":123344},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3634":73825,"_31331":73813,"_21707":123346,"_5":14945,"_28497":123319,"_3084":123347},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3634":73826,"_31331":73813,"_21707":123349,"_5":14945,"_28497":123319,"_3084":123350},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3634":73827,"_31331":73813,"_21707":123352,"_5":14945,"_28497":123319,"_3084":123353},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3634":73828,"_31331":73813,"_21707":123355,"_5":14945,"_28497":123319,"_3084":123356},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3634":73829,"_31331":73813,"_21707":123358,"_5":14945,"_28497":123319,"_3084":123359},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3634":73830,"_31331":73830,"_5":15305,"_3084":123361,"_31690":123362,"_21707":123363,"_28497":73830},"Dispositivos e identidades",[51145,122216,53829,123361],[],{"_3634":73831,"_31331":73830,"_21707":123365,"_5":14945,"_28497":73830,"_3084":123366},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3634":73832,"_31331":73830,"_5":31687,"_21707":123368,"_28497":123369,"_3084":123370},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3634":73833,"_31331":73830,"_5":31687,"_21707":123372,"_28497":123373,"_3084":123374},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3634":73834,"_31331":73830,"_5":31687,"_21707":123376,"_28497":123377,"_3084":123378},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3634":73835,"_31331":73830,"_5":31687,"_21707":123380,"_28497":123381,"_3084":123382},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3634":73836,"_31331":73830,"_5":31687,"_21707":123384,"_28497":123385,"_3084":123386},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3634":73837,"_31331":73830,"_5":31687,"_21707":123388,"_28497":123389,"_3084":123390},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3634":73838,"_31331":73830,"_5":31687,"_21707":123392,"_28497":123393,"_3084":123394},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3634":73839,"_31331":73830,"_5":31687,"_21707":123396,"_28497":123397,"_3084":123398},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3634":73840,"_31331":73830,"_5":31687,"_21707":123400,"_28497":123401,"_3084":123402},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3634":73841,"_31331":73830,"_5":31687,"_21707":123404,"_28497":123405,"_3084":123406},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3634":73842,"_31331":73830,"_5":31687,"_21707":123408,"_28497":123409,"_3084":123410},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3634":73843,"_31331":73830,"_21707":123412,"_5":14945,"_28497":73830,"_3084":123413},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3634":73844,"_31331":73830,"_21707":123415,"_5":14945,"_28497":73830,"_3084":123416},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3634":73845,"_31331":73830,"_21707":123418,"_5":14945,"_28497":123369,"_3084":123419},[],"Vista operativa",{"_3634":73846,"_31331":73830,"_21707":123421,"_5":14945,"_28497":123369,"_3084":123422},[],"Interpretación",{"_3634":73847,"_31331":73830,"_21707":123424,"_5":14945,"_28497":123369,"_3084":53892},[],{"_3634":73848,"_31331":73830,"_21707":123426,"_5":14945,"_28497":123369,"_3084":123427},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3634":73849,"_31331":73830,"_21707":123429,"_5":14945,"_28497":123369,"_3084":53898},[],{"_3634":73850,"_31331":73830,"_21707":123431,"_5":14945,"_28497":123369,"_3084":123432},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3634":73851,"_31331":73830,"_21707":123434,"_5":14945,"_28497":123369,"_3084":53904},[],{"_3634":73852,"_31331":73830,"_21707":123436,"_5":14945,"_28497":123369,"_3084":123437},[],"La identidad está en la ventana operativa de renovación.",{"_3634":73853,"_31331":73830,"_21707":123439,"_5":14945,"_28497":123369,"_3084":53910},[],{"_3634":73854,"_31331":73830,"_21707":123441,"_5":14945,"_28497":123369,"_3084":123442},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3634":73855,"_31331":73830,"_21707":123444,"_5":14945,"_28497":123369,"_3084":53916},[],{"_3634":73856,"_31331":73830,"_21707":123446,"_5":14945,"_28497":123369,"_3084":123447},[],"La identidad ha vencido.",{"_3634":73857,"_31331":73830,"_21707":123449,"_5":14945,"_28497":123369,"_3084":53922},[],{"_3634":73858,"_31331":73830,"_21707":123451,"_5":14945,"_28497":123369,"_3084":123452},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3634":73859,"_31331":73830,"_21707":123454,"_5":14945,"_28497":123369,"_3084":53928},[],{"_3634":73860,"_31331":73830,"_21707":123456,"_5":14945,"_28497":123369,"_3084":123457},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3634":73861,"_31331":73830,"_21707":123459,"_5":14945,"_28497":123369,"_3084":123460},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3634":73862,"_31331":73830,"_21707":123462,"_5":14945,"_28497":123373,"_3084":123463},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3634":73863,"_31331":73830,"_21707":123465,"_5":14945,"_28497":123373,"_3084":123466},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3634":73864,"_31331":73830,"_21707":123468,"_5":14945,"_28497":123373,"_3084":123469},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3634":73865,"_31331":73830,"_21707":123471,"_5":14945,"_28497":123373,"_3084":123472},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3634":73866,"_31331":73830,"_21707":123474,"_5":14945,"_28497":123377,"_3084":123475},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3634":73867,"_31331":73830,"_21707":123477,"_5":14945,"_28497":123381,"_3084":123478},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3634":73868,"_31331":73830,"_21707":123480,"_5":14945,"_28497":123385,"_3084":123481},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3634":73869,"_31331":73830,"_21707":123483,"_5":14945,"_28497":123389,"_3084":123484},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3634":73870,"_31331":73830,"_21707":123486,"_5":14945,"_28497":123393,"_3084":123487},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3634":73871,"_31331":73830,"_21707":123489,"_5":14945,"_28497":123393,"_3084":123490},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3634":73872,"_31331":73830,"_21707":123492,"_5":14945,"_28497":123397,"_3084":123493},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3634":73873,"_31331":73830,"_21707":123495,"_5":14945,"_28497":123397,"_3084":123496},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3634":73874,"_31331":73830,"_21707":123498,"_5":14945,"_28497":123397,"_3084":123499},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3634":73875,"_31331":73830,"_21707":123501,"_5":14945,"_28497":123397,"_3084":123502},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3634":73876,"_31331":73830,"_21707":123504,"_5":14945,"_28497":123397,"_3084":123505},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3634":73877,"_31331":73830,"_21707":123507,"_5":14945,"_28497":123397,"_3084":123508},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3634":73878,"_31331":73830,"_21707":123510,"_5":14945,"_28497":123401,"_3084":123511},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3634":73879,"_31331":73830,"_21707":123513,"_5":14945,"_28497":123401,"_3084":123514},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3634":73880,"_31331":73830,"_21707":123516,"_5":14945,"_28497":123401,"_3084":123517},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3634":73881,"_31331":73830,"_21707":123519,"_5":14945,"_28497":123405,"_3084":123520},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3634":73882,"_31331":73830,"_21707":123522,"_5":14945,"_28497":123405,"_3084":123523},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3634":73883,"_31331":73830,"_21707":123525,"_5":14945,"_28497":123405,"_3084":123526},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3634":73884,"_31331":73830,"_21707":123528,"_5":14945,"_28497":123405,"_3084":123529},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3634":73885,"_31331":73830,"_21707":123531,"_5":14945,"_28497":123409,"_3084":123532},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":73886,"_31331":73830,"_21707":123534,"_5":14945,"_28497":123409,"_3084":123535},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":73887,"_31331":73887,"_5":15305,"_3084":123537,"_31690":123538,"_21707":123540,"_28497":73887},"Identidad inicial y autenticación",[51145,122216,53829,123361,123539],"Enrolamiento con PKI",[],{"_3634":73888,"_31331":73887,"_21707":123542,"_5":14945,"_28497":73887,"_3084":123543},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3634":73889,"_31331":73887,"_5":31687,"_21707":123545,"_28497":123546,"_3084":123547},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3634":73890,"_31331":73887,"_5":31687,"_21707":123549,"_28497":123550,"_3084":123551},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3634":73891,"_31331":73887,"_5":31687,"_21707":123553,"_28497":123554,"_3084":123555},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3634":73892,"_31331":73887,"_5":31687,"_21707":123557,"_28497":123558,"_3084":123559},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3634":73893,"_31331":73887,"_5":31687,"_21707":123561,"_28497":123562,"_3084":123563},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3634":73894,"_31331":73887,"_21707":123565,"_5":14945,"_28497":73887,"_3084":123566},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3634":73895,"_31331":73887,"_21707":123568,"_5":14945,"_28497":123546,"_3084":123569},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3634":73896,"_31331":73887,"_21707":123571,"_5":14945,"_28497":123546,"_3084":123572},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3634":73897,"_31331":73887,"_21707":123574,"_5":14945,"_28497":123550,"_3084":123575},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3634":73898,"_31331":73887,"_21707":123577,"_5":14945,"_28497":123550,"_3084":123578},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3634":73899,"_31331":73887,"_21707":123580,"_5":14945,"_28497":123550,"_3084":123581},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3634":73900,"_31331":73887,"_21707":123583,"_5":14945,"_28497":123554,"_3084":123584},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3634":73901,"_31331":73887,"_21707":123586,"_5":14945,"_28497":123554,"_3084":123587},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3634":73902,"_31331":73887,"_21707":123589,"_5":14945,"_28497":123558,"_3084":123590},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3634":73903,"_31331":73887,"_21707":123592,"_5":14945,"_28497":123558,"_3084":123593},[],"Ejemplo de cuerpo:",{"_3634":73904,"_31331":73887,"_21707":123595,"_5":14945,"_28497":123558,"_3084":123596},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3634":73905,"_31331":73887,"_21707":123598,"_5":14945,"_28497":123558,"_3084":123599},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3634":73906,"_31331":73887,"_21707":123601,"_5":14945,"_28497":123558,"_3084":123602},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3634":73907,"_31331":73887,"_21707":123604,"_5":14945,"_28497":123558,"_3084":123605},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3634":73908,"_31331":73887,"_21707":123607,"_5":14945,"_28497":123562,"_3084":123608},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3634":73909,"_31331":73887,"_21707":123610,"_5":14945,"_28497":123562,"_3084":123611},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3634":73910,"_31331":73887,"_21707":123613,"_5":14945,"_28497":123562,"_3084":123614},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3634":73911,"_31331":73887,"_21707":123616,"_5":14945,"_28497":123562,"_3084":123617},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3634":73912,"_31331":73912,"_5":15305,"_3084":123619,"_31690":123620,"_21707":123621,"_28497":73912},"Configura y opera el DMS",[51145,122216,53829,123361,123539],[],{"_3634":73913,"_31331":73912,"_21707":123623,"_5":14945,"_28497":73912,"_3084":123624},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3634":73914,"_31331":73912,"_5":31687,"_21707":123626,"_28497":123627,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3634":73915,"_31331":73912,"_5":31687,"_21707":123629,"_28497":123630,"_3084":123631},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3634":73916,"_31331":73912,"_5":31687,"_21707":123633,"_28497":123634,"_3084":123635},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3634":73917,"_31331":73912,"_5":31687,"_21707":123637,"_28497":123638,"_3084":123639},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3634":73918,"_31331":73912,"_5":31687,"_21707":123641,"_28497":123642,"_3084":123643},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3634":73919,"_31331":73912,"_5":31687,"_21707":123645,"_28497":123646,"_3084":123647},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3634":73920,"_31331":73912,"_5":31687,"_21707":123649,"_28497":123650,"_3084":123651},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3634":73921,"_31331":73912,"_5":31687,"_21707":123653,"_28497":123654,"_3084":123655},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3634":73922,"_31331":73912,"_5":31687,"_21707":123657,"_28497":123658,"_3084":54133},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3634":73923,"_31331":73912,"_5":31687,"_21707":123660,"_28497":123661,"_3084":54137},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3634":73924,"_31331":73912,"_5":31687,"_21707":123663,"_28497":123664,"_3084":123665},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3634":73925,"_31331":73912,"_5":31687,"_21707":123667,"_28497":123668,"_3084":123669},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3634":73926,"_31331":73912,"_5":31687,"_21707":123671,"_28497":123672,"_3084":123673},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3634":73927,"_31331":73912,"_5":31687,"_21707":123675,"_28497":123676,"_3084":123677},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3634":73928,"_31331":73912,"_5":31687,"_21707":123679,"_28497":123680,"_3084":54157},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3634":73929,"_31331":73912,"_5":31687,"_21707":123682,"_28497":123683,"_3084":123684},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3634":73930,"_31331":73912,"_5":31687,"_21707":123686,"_28497":123687,"_3084":123688},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3634":73931,"_31331":73912,"_5":31687,"_21707":123690,"_28497":123691,"_3084":123692},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3634":73932,"_31331":73912,"_21707":123694,"_5":14945,"_28497":73912,"_3084":123695},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3634":73933,"_31331":73912,"_21707":123697,"_5":14945,"_28497":123627,"_3084":123698},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3634":73934,"_31331":73912,"_21707":123700,"_5":14945,"_28497":123627,"_3084":123701},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3634":73935,"_31331":73912,"_21707":123703,"_5":14945,"_28497":123634,"_3084":123704},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3634":73936,"_31331":73912,"_21707":123706,"_5":14945,"_28497":123638,"_3084":123707},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3634":73937,"_31331":73912,"_21707":123709,"_5":14945,"_28497":123642,"_3084":123710},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3634":73938,"_31331":73912,"_21707":123712,"_5":14945,"_28497":123646,"_3084":123713},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3634":73939,"_31331":73912,"_21707":123715,"_5":14945,"_28497":123650,"_3084":123716},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3634":73940,"_31331":73912,"_21707":123718,"_5":14945,"_28497":123658,"_3084":123719},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3634":73941,"_31331":73912,"_21707":123721,"_5":14945,"_28497":123658,"_3084":123722},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3634":73942,"_31331":73912,"_21707":123724,"_5":14945,"_28497":123661,"_3084":123725},[],"Campo de `settings.enrollment_settings`",{"_3634":73943,"_31331":73912,"_21707":123727,"_5":14945,"_28497":123661,"_3084":123728},[],"Decisión",{"_3634":73944,"_31331":73912,"_21707":123730,"_5":14945,"_28497":123661,"_3084":54208},[],{"_3634":73945,"_31331":73912,"_21707":123732,"_5":14945,"_28497":123661,"_3084":123733},[],"`EST_RFC7030` para estas operaciones.",{"_3634":73946,"_31331":73912,"_21707":123735,"_5":14945,"_28497":123661,"_3084":54214},[],{"_3634":73947,"_31331":73912,"_21707":123737,"_5":14945,"_28497":123661,"_3084":123738},[],"ID de la CA que firmará.",{"_3634":73948,"_31331":73912,"_21707":123740,"_5":14945,"_28497":123661,"_3084":54220},[],{"_3634":73949,"_31331":73912,"_21707":123742,"_5":14945,"_28497":123661,"_3084":123743},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3634":73950,"_31331":73912,"_21707":123745,"_5":14945,"_28497":123661,"_3084":54226},[],{"_3634":73951,"_31331":73912,"_21707":123747,"_5":14945,"_28497":123661,"_3084":123748},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3634":73952,"_31331":73912,"_21707":123750,"_5":14945,"_28497":123661,"_3084":54232},[],{"_3634":73953,"_31331":73912,"_21707":123752,"_5":14945,"_28497":123661,"_3084":123753},[],"Uno de los cuatro modos de autenticación.",{"_3634":73954,"_31331":73912,"_21707":123755,"_5":14945,"_28497":123661,"_3084":123756},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3634":73955,"_31331":73912,"_21707":123758,"_5":14945,"_28497":123664,"_3084":123759},[],"Los bloques son independientes:",{"_3634":73956,"_31331":73912,"_21707":123761,"_5":14945,"_28497":123664,"_3084":123762},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3634":73957,"_31331":73912,"_21707":123764,"_5":14945,"_28497":123664,"_3084":123765},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3634":73958,"_31331":73912,"_21707":123767,"_5":14945,"_28497":123664,"_3084":54250},[],{"_3634":73959,"_31331":73912,"_21707":123769,"_5":14945,"_28497":123664,"_3084":123770},[],"Control aplicado en la operación configurada",{"_3634":73960,"_31331":73912,"_21707":123772,"_5":14945,"_28497":123664,"_3084":54256},[],{"_3634":73961,"_31331":73912,"_21707":123774,"_5":14945,"_28497":123664,"_3084":123775},[],"Validación del certificado presentado.",{"_3634":73962,"_31331":73912,"_21707":123777,"_5":14945,"_28497":123664,"_3084":54262},[],{"_3634":73963,"_31331":73912,"_21707":123779,"_5":14945,"_28497":123664,"_3084":123780},[],"Autorización del webhook configurado.",{"_3634":73964,"_31331":73912,"_21707":123782,"_5":14945,"_28497":123664,"_3084":54268},[],{"_3634":73965,"_31331":73912,"_21707":123784,"_5":14945,"_28497":123664,"_3084":123785},[],"Validación del certificado y, después, aprobación del webhook.",{"_3634":73966,"_31331":73912,"_21707":123787,"_5":14945,"_28497":123664,"_3084":54274},[],{"_3634":73967,"_31331":73912,"_21707":123789,"_5":14945,"_28497":123664,"_3084":123790},[],"Sin autenticación del solicitante por el DMS.",{"_3634":73968,"_31331":73912,"_21707":123792,"_5":14945,"_28497":123664,"_3084":123793},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3634":73969,"_31331":73912,"_21707":123795,"_5":14945,"_28497":123664,"_3084":123796},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3634":73970,"_31331":73912,"_21707":123798,"_5":14945,"_28497":123664,"_3084":123799},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3634":73971,"_31331":73912,"_21707":123801,"_5":14945,"_28497":123664,"_3084":123802},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3634":73972,"_31331":73912,"_21707":123804,"_5":14945,"_28497":123664,"_3084":123805},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3634":73973,"_31331":73912,"_21707":123807,"_5":14945,"_28497":123668,"_3084":123808},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3634":73974,"_31331":73912,"_21707":123810,"_5":14945,"_28497":123668,"_3084":123811},[],"Campo de `external_webhook_settings`",{"_3634":73975,"_31331":73912,"_21707":123813,"_5":14945,"_28497":123668,"_3084":123728},[],{"_3634":73976,"_31331":73912,"_21707":123815,"_5":14945,"_28497":123668,"_3084":54303},[],{"_3634":73977,"_31331":73912,"_21707":123817,"_5":14945,"_28497":123668,"_3084":123818},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3634":73978,"_31331":73912,"_21707":123820,"_5":14945,"_28497":123668,"_3084":54309},[],{"_3634":73979,"_31331":73912,"_21707":123822,"_5":14945,"_28497":123668,"_3084":123823},[],"`POST` o `PUT`; `POST` por defecto.",{"_3634":73980,"_31331":73912,"_21707":123825,"_5":14945,"_28497":123668,"_3084":54315},[],{"_3634":73981,"_31331":73912,"_21707":123827,"_5":14945,"_28497":123668,"_3084":123828},[],"Etiqueta usada en los logs del servicio.",{"_3634":73982,"_31331":73912,"_21707":123830,"_5":14945,"_28497":123668,"_3084":54321},[],{"_3634":73983,"_31331":73912,"_21707":123832,"_5":14945,"_28497":123668,"_3084":123833},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3634":73984,"_31331":73912,"_21707":123835,"_5":14945,"_28497":123668,"_3084":54327},[],{"_3634":73985,"_31331":73912,"_21707":123837,"_5":14945,"_28497":123668,"_3084":123838},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3634":73986,"_31331":73912,"_21707":123840,"_5":14945,"_28497":123668,"_3084":54333},[],{"_3634":73987,"_31331":73912,"_21707":123842,"_5":14945,"_28497":123668,"_3084":123843},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3634":73988,"_31331":73912,"_21707":123845,"_5":14945,"_28497":123668,"_3084":54339},[],{"_3634":73989,"_31331":73912,"_21707":123847,"_5":14945,"_28497":123668,"_3084":123848},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3634":73990,"_31331":73912,"_21707":123850,"_5":14945,"_28497":123668,"_3084":54345},[],{"_3634":73991,"_31331":73912,"_21707":123852,"_5":14945,"_28497":123668,"_3084":123853},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3634":73992,"_31331":73912,"_21707":123855,"_5":14945,"_28497":123668,"_3084":54351},[],{"_3634":73993,"_31331":73912,"_21707":123857,"_5":14945,"_28497":123668,"_3084":123858},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3634":73994,"_31331":73912,"_21707":123860,"_5":14945,"_28497":123668,"_3084":54357},[],{"_3634":73995,"_31331":73912,"_21707":123862,"_5":14945,"_28497":123668,"_3084":123863},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3634":73996,"_31331":73912,"_21707":123865,"_5":14945,"_28497":123668,"_3084":123866},[],"Reglas de esa configuración:",{"_3634":73997,"_31331":73912,"_21707":123868,"_5":14945,"_28497":123668,"_3084":123869},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3634":73998,"_31331":73912,"_21707":123871,"_5":14945,"_28497":123668,"_3084":123872},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3634":73999,"_31331":73912,"_21707":123874,"_5":14945,"_28497":123668,"_3084":123875},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3634":74000,"_31331":73912,"_21707":123877,"_5":14945,"_28497":123668,"_3084":123878},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3634":74001,"_31331":73912,"_21707":123880,"_5":14945,"_28497":123668,"_3084":123881},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3634":74002,"_31331":73912,"_21707":123883,"_5":14945,"_28497":123668,"_3084":123884},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3634":74003,"_31331":73912,"_21707":123886,"_5":14945,"_28497":123668,"_3084":123887},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3634":74004,"_31331":73912,"_21707":123889,"_5":14945,"_28497":123668,"_3084":123890},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3634":74005,"_31331":73912,"_21707":123892,"_5":14945,"_28497":123668,"_3084":123893},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3634":74006,"_31331":73912,"_21707":123895,"_5":14945,"_28497":123672,"_3084":123896},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3634":74007,"_31331":73912,"_21707":123898,"_5":14945,"_28497":123676,"_3084":123899},[],"Campo de `settings.reenrollment_settings`",{"_3634":74008,"_31331":73912,"_21707":123901,"_5":14945,"_28497":123676,"_3084":123902},[],"Función",{"_3634":74009,"_31331":73912,"_21707":123904,"_5":14945,"_28497":123676,"_3084":54401},[],{"_3634":74010,"_31331":73912,"_21707":123906,"_5":14945,"_28497":123676,"_3084":123907},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3634":74011,"_31331":73912,"_21707":123909,"_5":14945,"_28497":123676,"_3084":54407},[],{"_3634":74012,"_31331":73912,"_21707":123911,"_5":14945,"_28497":123676,"_3084":123912},[],"Umbral operativo preventivo de monitorización.",{"_3634":74013,"_31331":73912,"_21707":123914,"_5":14945,"_28497":123676,"_3084":54413},[],{"_3634":74014,"_31331":73912,"_21707":123916,"_5":14945,"_28497":123676,"_3084":123917},[],"Umbral operativo crítico de monitorización.",{"_3634":74015,"_31331":73912,"_21707":123919,"_5":14945,"_28497":123676,"_3084":54419},[],{"_3634":74016,"_31331":73912,"_21707":123921,"_5":14945,"_28497":123676,"_3084":123922},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3634":74017,"_31331":73912,"_21707":123924,"_5":14945,"_28497":123676,"_3084":54425},[],{"_3634":74018,"_31331":73912,"_21707":123926,"_5":14945,"_28497":123676,"_3084":123927},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3634":74019,"_31331":73912,"_21707":123929,"_5":14945,"_28497":123676,"_3084":54431},[],{"_3634":74020,"_31331":73912,"_21707":123931,"_5":14945,"_28497":123676,"_3084":123932},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3634":74021,"_31331":73912,"_21707":123934,"_5":14945,"_28497":123676,"_3084":123935},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3634":74022,"_31331":73912,"_21707":123937,"_5":14945,"_28497":123680,"_3084":123938},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3634":74023,"_31331":73912,"_21707":123940,"_5":14945,"_28497":123683,"_3084":121114},[],{"_3634":74024,"_31331":73912,"_21707":123942,"_5":14945,"_28497":123683,"_3084":123943},[],"Qué publica",{"_3634":74025,"_31331":73912,"_21707":123945,"_5":14945,"_28497":123683,"_3084":54448},[],{"_3634":74026,"_31331":73912,"_21707":123947,"_5":14945,"_28497":123683,"_3084":123948},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3634":74027,"_31331":73912,"_21707":123950,"_5":14945,"_28497":123683,"_3084":54454},[],{"_3634":74028,"_31331":73912,"_21707":123952,"_5":14945,"_28497":123683,"_3084":123953},[],"Certificado de la CA emisora seleccionada.",{"_3634":74029,"_31331":73912,"_21707":123955,"_5":14945,"_28497":123683,"_3084":54460},[],{"_3634":74030,"_31331":73912,"_21707":123957,"_5":14945,"_28497":123683,"_3084":123958},[],"Certificados de las CAs elegidas explícitamente.",{"_3634":74031,"_31331":73912,"_21707":123960,"_5":14945,"_28497":123683,"_3084":123961},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3634":74032,"_31331":73912,"_21707":123963,"_5":14945,"_28497":123687,"_3084":123964},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3634":74033,"_31331":73912,"_21707":123966,"_5":14945,"_28497":123687,"_3084":123967},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3634":74034,"_31331":73912,"_21707":123969,"_5":14945,"_28497":123687,"_3084":123970},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3634":74035,"_31331":73912,"_21707":123972,"_5":14945,"_28497":123691,"_3084":123973},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3634":74036,"_31331":74036,"_5":15305,"_3084":123975,"_31690":123976,"_21707":123977,"_28497":74036},"Integra el cliente EST",[51145,122216,53829,123361,123539],[],{"_3634":74037,"_31331":74036,"_21707":123979,"_5":14945,"_28497":74036,"_3084":123980},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3634":74038,"_31331":74036,"_5":31687,"_21707":123982,"_28497":123983,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3634":74039,"_31331":74036,"_5":31687,"_21707":123985,"_28497":123986,"_3084":123987},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3634":74040,"_31331":74036,"_5":31687,"_21707":123989,"_28497":123990,"_3084":123991},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3634":74041,"_31331":74036,"_5":31687,"_21707":123993,"_28497":123994,"_3084":123995},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3634":74042,"_31331":74036,"_5":31687,"_21707":123997,"_28497":123998,"_3084":123999},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3634":74043,"_31331":74036,"_5":31687,"_21707":124001,"_28497":124002,"_3084":124003},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3634":74044,"_31331":74036,"_21707":124005,"_5":14945,"_28497":74036,"_3084":124006},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3634":74045,"_31331":74036,"_21707":124008,"_5":14945,"_28497":123983,"_3084":124009},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3634":74046,"_31331":74036,"_21707":124011,"_5":14945,"_28497":123983,"_3084":124012},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3634":74047,"_31331":74036,"_21707":124014,"_5":14945,"_28497":123983,"_3084":124015},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3634":74048,"_31331":74036,"_21707":124017,"_5":14945,"_28497":123986,"_3084":124018},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3634":74049,"_31331":74036,"_21707":124020,"_5":14945,"_28497":123986,"_3084":124021},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3634":74050,"_31331":74036,"_21707":124023,"_5":14945,"_28497":123990,"_3084":124024},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3634":74051,"_31331":74036,"_21707":124026,"_5":14945,"_28497":123990,"_3084":124027},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3634":74052,"_31331":74036,"_21707":124029,"_5":14945,"_28497":123994,"_3084":124030},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3634":74053,"_31331":74036,"_21707":124032,"_5":14945,"_28497":123994,"_3084":124033},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3634":74054,"_31331":74036,"_21707":124035,"_5":14945,"_28497":123998,"_3084":124036},[],"Para el caso de una raíz que emite directamente:",{"_3634":74055,"_31331":74036,"_21707":124038,"_5":14945,"_28497":123998,"_3084":124039},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3634":74056,"_31331":74036,"_21707":124041,"_5":14945,"_28497":123998,"_3084":124042},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3634":74057,"_31331":74036,"_21707":124044,"_5":14945,"_28497":124002,"_3084":124045},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3634":74058,"_31331":74058,"_5":15305,"_3084":124047,"_31690":124048,"_21707":124049,"_28497":74058},"Referencia EST",[51145,122216,53829,123361,123539],[],{"_3634":74059,"_31331":74058,"_21707":124051,"_5":14945,"_28497":74058,"_3084":124052},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3634":74060,"_31331":74058,"_5":31687,"_21707":124054,"_28497":124055,"_3084":124056},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3634":74061,"_31331":74058,"_5":31687,"_21707":124058,"_28497":124059,"_3084":23510},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3634":74062,"_31331":74058,"_5":31687,"_21707":124061,"_28497":124062,"_3084":27024},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3634":74063,"_31331":74058,"_5":31687,"_21707":124064,"_28497":124065,"_3084":27031},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3634":74064,"_31331":74058,"_5":31687,"_21707":124067,"_28497":124068,"_3084":26288},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3634":74065,"_31331":74058,"_5":31687,"_21707":124070,"_28497":124071,"_3084":124072},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3634":74066,"_31331":74058,"_5":31687,"_21707":124074,"_28497":124075,"_3084":124076},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3634":74067,"_31331":74058,"_5":31687,"_21707":124078,"_28497":124079,"_3084":124080},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3634":74068,"_31331":74058,"_21707":124082,"_5":14945,"_28497":74058,"_3084":124083},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3634":74069,"_31331":74058,"_21707":124085,"_5":14945,"_28497":124055,"_3084":124086},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3634":74070,"_31331":74058,"_21707":124088,"_5":14945,"_28497":124055,"_3084":121976},[],{"_3634":74071,"_31331":74058,"_21707":124090,"_5":14945,"_28497":124055,"_3084":124091},[],"Método",{"_3634":74072,"_31331":74058,"_21707":124093,"_5":14945,"_28497":124055,"_3084":124094},[],"Autenticación y condición",{"_3634":74073,"_31331":74058,"_21707":124096,"_5":14945,"_28497":124055,"_3084":54603},[],{"_3634":74074,"_31331":74058,"_21707":124098,"_5":14945,"_28497":124055,"_3084":54606},[],{"_3634":74075,"_31331":74058,"_21707":124100,"_5":14945,"_28497":124055,"_3084":124101},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3634":74076,"_31331":74058,"_21707":124103,"_5":14945,"_28497":124055,"_3084":54612},[],{"_3634":74077,"_31331":74058,"_21707":124105,"_5":14945,"_28497":124055,"_3084":54615},[],{"_3634":74078,"_31331":74058,"_21707":124107,"_5":14945,"_28497":124055,"_3084":124108},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3634":74079,"_31331":74058,"_21707":124110,"_5":14945,"_28497":124055,"_3084":54621},[],{"_3634":74080,"_31331":74058,"_21707":124112,"_5":14945,"_28497":124055,"_3084":54615},[],{"_3634":74081,"_31331":74058,"_21707":124114,"_5":14945,"_28497":124055,"_3084":124115},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3634":74082,"_31331":74058,"_21707":124117,"_5":14945,"_28497":124055,"_3084":54629},[],{"_3634":74083,"_31331":74058,"_21707":124119,"_5":14945,"_28497":124055,"_3084":54615},[],{"_3634":74084,"_31331":74058,"_21707":124121,"_5":14945,"_28497":124055,"_3084":124122},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3634":74085,"_31331":74058,"_21707":124124,"_5":14945,"_28497":124055,"_3084":124125},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3634":74086,"_31331":74058,"_21707":124127,"_5":14945,"_28497":124059,"_3084":124128},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3634":74087,"_31331":74058,"_21707":124130,"_5":14945,"_28497":124059,"_3084":124131},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3634":74088,"_31331":74058,"_21707":124133,"_5":14945,"_28497":124062,"_3084":124134},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3634":74089,"_31331":74058,"_21707":124136,"_5":14945,"_28497":124062,"_3084":124137},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3634":74090,"_31331":74058,"_21707":124139,"_5":14945,"_28497":124065,"_3084":124140},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3634":74091,"_31331":74058,"_21707":124142,"_5":14945,"_28497":124065,"_3084":124143},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3634":74092,"_31331":74058,"_21707":124145,"_5":14945,"_28497":124068,"_3084":124146},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3634":74093,"_31331":74058,"_21707":124148,"_5":14945,"_28497":124068,"_3084":124149},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3634":74094,"_31331":74058,"_21707":124151,"_5":14945,"_28497":124071,"_3084":124152},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3634":74095,"_31331":74058,"_21707":124154,"_5":14945,"_28497":124071,"_3084":124155},[],"Parte",{"_3634":74096,"_31331":74058,"_21707":124157,"_5":14945,"_28497":124071,"_3084":124158},[],"Contenido tras decodificar su Base64",{"_3634":74097,"_31331":74058,"_21707":124160,"_5":14945,"_28497":124071,"_3084":54673},[],{"_3634":74098,"_31331":74058,"_21707":124162,"_5":14945,"_28497":124071,"_3084":124163},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3634":74099,"_31331":74058,"_21707":124165,"_5":14945,"_28497":124071,"_3084":54679},[],{"_3634":74100,"_31331":74058,"_21707":124167,"_5":14945,"_28497":124071,"_3084":124168},[],"PKCS#7 DER con el certificado emitido.",{"_3634":74101,"_31331":74058,"_21707":124170,"_5":14945,"_28497":124071,"_3084":124171},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3634":74102,"_31331":74058,"_21707":124173,"_5":14945,"_28497":124075,"_3084":124174},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3634":74103,"_31331":74058,"_21707":124176,"_5":14945,"_28497":124075,"_3084":124177},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3634":74104,"_31331":74058,"_21707":124179,"_5":14945,"_28497":124075,"_3084":124180},[],"Convierte y comprueba el resultado:",{"_3634":74105,"_31331":74058,"_21707":124182,"_5":14945,"_28497":124075,"_3084":124183},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3634":74106,"_31331":74058,"_21707":124185,"_5":14945,"_28497":124079,"_3084":124186},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3634":74107,"_31331":74058,"_21707":124188,"_5":14945,"_28497":124079,"_3084":124189},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3634":74108,"_31331":74108,"_5":15305,"_3084":123539,"_31690":124191,"_21707":124192,"_28497":74108},[51145,122216,53829,123361,123539],[],{"_3634":74109,"_31331":74108,"_21707":124194,"_5":14945,"_28497":74108,"_3084":124195},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3634":74110,"_31331":74108,"_5":31687,"_21707":124197,"_28497":124198,"_3084":124199},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3634":74111,"_31331":74108,"_5":31687,"_21707":124201,"_28497":124202,"_3084":124203},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3634":74112,"_31331":74108,"_5":31687,"_21707":124205,"_28497":124206,"_3084":124207},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3634":74113,"_31331":74108,"_21707":124209,"_5":14945,"_28497":74108,"_3084":124210},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3634":74114,"_31331":74108,"_21707":124212,"_5":14945,"_28497":124198,"_3084":124213},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3634":74115,"_31331":74108,"_21707":124215,"_5":14945,"_28497":124198,"_3084":124216},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3634":74116,"_31331":74108,"_21707":124218,"_5":14945,"_28497":124198,"_3084":124219},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3634":74117,"_31331":74108,"_21707":124221,"_5":14945,"_28497":124198,"_3084":124222},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3634":74118,"_31331":74108,"_21707":124224,"_5":14945,"_28497":124198,"_3084":124225},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3634":74119,"_31331":74108,"_21707":124227,"_5":14945,"_28497":124198,"_3084":124228},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3634":74120,"_31331":74108,"_21707":124230,"_5":14945,"_28497":124202,"_3084":124231},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3634":74121,"_31331":74108,"_21707":124233,"_5":14945,"_28497":124202,"_3084":124234},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":74122,"_31331":74108,"_21707":124236,"_5":14945,"_28497":124202,"_3084":124237},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3634":74123,"_31331":74108,"_21707":124239,"_5":14945,"_28497":124202,"_3084":124240},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3634":74124,"_31331":74108,"_21707":124242,"_5":14945,"_28497":124206,"_3084":124243},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":74125,"_31331":74108,"_21707":124245,"_5":14945,"_28497":124206,"_3084":124246},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":74126,"_31331":74108,"_21707":124248,"_5":14945,"_28497":124206,"_3084":124249},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3634":74127,"_31331":74108,"_21707":124251,"_5":14945,"_28497":124206,"_3084":124252},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3634":74128,"_31331":74108,"_21707":124254,"_5":14945,"_28497":124206,"_3084":124255},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3634":74129,"_31331":74129,"_5":15305,"_3084":124257,"_31690":124258,"_21707":124259,"_28497":74129},"Estrategias de aprovisionamiento",[51145,122216,53829,123361,123539],[],{"_3634":74130,"_31331":74129,"_21707":124261,"_5":14945,"_28497":74129,"_3084":124262},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3634":74131,"_31331":74129,"_5":31687,"_21707":124264,"_28497":124265,"_3084":124266},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3634":74132,"_31331":74129,"_5":31687,"_21707":124268,"_28497":124269,"_3084":124270},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3634":74133,"_31331":74129,"_5":31687,"_21707":124272,"_28497":124273,"_3084":124274},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3634":74134,"_31331":74129,"_5":31687,"_21707":124276,"_28497":124277,"_3084":124278},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3634":74135,"_31331":74129,"_5":31687,"_21707":124280,"_28497":124281,"_3084":124282},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3634":74136,"_31331":74129,"_21707":124284,"_5":14945,"_28497":74129,"_3084":124285},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3634":74137,"_31331":74129,"_21707":124287,"_5":14945,"_28497":124265,"_3084":124288},[],"Recorrido",{"_3634":74138,"_31331":74129,"_21707":124290,"_5":14945,"_28497":124265,"_3084":124291},[],"Cuándo existe el dispositivo",{"_3634":74139,"_31331":74129,"_21707":124293,"_5":14945,"_28497":124265,"_3084":124294},[],"Qué compruebas",{"_3634":74140,"_31331":74129,"_21707":124296,"_5":14945,"_28497":124265,"_3084":124297},[],"Asignación manual",{"_3634":74141,"_31331":74129,"_21707":124299,"_5":14945,"_28497":124265,"_3084":124300},[],"El operador lo crea antes de asociar un certificado.",{"_3634":74142,"_31331":74129,"_21707":124302,"_5":14945,"_28497":124265,"_3084":124303},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3634":74143,"_31331":74129,"_21707":124305,"_5":14945,"_28497":124265,"_3084":124306},[],"EST con `JITP`",{"_3634":74144,"_31331":74129,"_21707":124308,"_5":14945,"_28497":124265,"_3084":124309},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3634":74145,"_31331":74129,"_21707":124311,"_5":14945,"_28497":124265,"_3084":124312},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3634":74146,"_31331":74129,"_21707":124314,"_5":14945,"_28497":124265,"_3084":124315},[],"EST con `PRE_REGISTRATION`",{"_3634":74147,"_31331":74129,"_21707":124317,"_5":14945,"_28497":124265,"_3084":124318},[],"Debe existir antes de `/simpleenroll`.",{"_3634":74148,"_31331":74129,"_21707":124320,"_5":14945,"_28497":124265,"_3084":124321},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3634":74149,"_31331":74129,"_21707":124323,"_5":14945,"_28497":124265,"_3084":124324},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3634":74150,"_31331":74129,"_21707":124326,"_5":14945,"_28497":124265,"_3084":124327},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3634":74151,"_31331":74129,"_21707":124329,"_5":14945,"_28497":124269,"_3084":124330},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3634":74152,"_31331":74129,"_21707":124332,"_5":14945,"_28497":124269,"_3084":124333},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3634":74153,"_31331":74129,"_21707":124335,"_5":14945,"_28497":124269,"_3084":124336},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3634":74154,"_31331":74129,"_21707":124338,"_5":14945,"_28497":124273,"_3084":124339},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3634":74155,"_31331":74129,"_21707":124341,"_5":14945,"_28497":124273,"_3084":124342},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3634":74156,"_31331":74129,"_21707":124344,"_5":14945,"_28497":124273,"_3084":124345},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3634":74157,"_31331":74129,"_21707":124347,"_5":14945,"_28497":124273,"_3084":124348},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3634":74158,"_31331":74129,"_21707":124350,"_5":14945,"_28497":124273,"_3084":124351},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3634":74159,"_31331":74129,"_21707":124353,"_5":14945,"_28497":124273,"_3084":124354},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3634":74160,"_31331":74129,"_21707":124356,"_5":14945,"_28497":124277,"_3084":121114},[],{"_3634":74161,"_31331":74129,"_21707":124358,"_5":14945,"_28497":124277,"_3084":124359},[],"Material que atraviesa EST",{"_3634":74162,"_31331":74129,"_21707":124361,"_5":14945,"_28497":124277,"_3084":124362},[],"Clave generada por el dispositivo",{"_3634":74163,"_31331":74129,"_21707":124364,"_5":14945,"_28497":124277,"_3084":124365},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3634":74164,"_31331":74129,"_21707":124367,"_5":14945,"_28497":124277,"_3084":124368},[],"Clave ya disponible en el dispositivo",{"_3634":74165,"_31331":74129,"_21707":124370,"_5":14945,"_28497":124277,"_3084":124371},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3634":74166,"_31331":74129,"_21707":124373,"_5":14945,"_28497":124277,"_3084":54157},[],{"_3634":74167,"_31331":74129,"_21707":124375,"_5":14945,"_28497":124277,"_3084":124376},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3634":74168,"_31331":74129,"_21707":124378,"_5":14945,"_28497":124277,"_3084":124379},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3634":74169,"_31331":74129,"_21707":124381,"_5":14945,"_28497":124281,"_3084":124382},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3634":74170,"_31331":74170,"_5":15305,"_3084":124384,"_31690":124385,"_21707":124386,"_28497":74170},"Renovación y recuperación",[51145,122216,53829,123361,123539],[],{"_3634":74171,"_31331":74170,"_21707":124388,"_5":14945,"_28497":74170,"_3084":124389},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3634":74172,"_31331":74170,"_5":31687,"_21707":124391,"_28497":124392,"_3084":124393},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3634":74173,"_31331":74170,"_5":31687,"_21707":124395,"_28497":124396,"_3084":124397},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3634":74174,"_31331":74170,"_5":31687,"_21707":124399,"_28497":124400,"_3084":124401},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3634":74175,"_31331":74170,"_5":31687,"_21707":124403,"_28497":124404,"_3084":124405},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3634":74176,"_31331":74170,"_5":31687,"_21707":124407,"_28497":124408,"_3084":124409},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3634":74177,"_31331":74170,"_21707":124411,"_5":14945,"_28497":74170,"_3084":124412},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3634":74178,"_31331":74170,"_21707":124414,"_5":14945,"_28497":124392,"_3084":124415},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3634":74179,"_31331":74170,"_21707":124417,"_5":14945,"_28497":124392,"_3084":124418},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3634":74180,"_31331":74170,"_21707":124420,"_5":14945,"_28497":124392,"_3084":124421},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3634":74181,"_31331":74170,"_21707":124423,"_5":14945,"_28497":124392,"_3084":124424},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3634":74182,"_31331":74170,"_21707":124426,"_5":14945,"_28497":124396,"_3084":124427},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3634":74183,"_31331":74170,"_21707":124429,"_5":14945,"_28497":124396,"_3084":124430},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3634":74184,"_31331":74170,"_21707":124432,"_5":14945,"_28497":124400,"_3084":124433},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3634":74185,"_31331":74170,"_21707":124435,"_5":14945,"_28497":124400,"_3084":124436},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3634":74186,"_31331":74170,"_21707":124438,"_5":14945,"_28497":124400,"_3084":124439},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3634":74187,"_31331":74170,"_21707":124441,"_5":14945,"_28497":124404,"_3084":124442},[],"Situación",{"_3634":74188,"_31331":74170,"_21707":124444,"_5":14945,"_28497":124404,"_3084":124445},[],"Procedimiento",{"_3634":74189,"_31331":74170,"_21707":124447,"_5":14945,"_28497":124404,"_3084":124448},[],"Certificado vigente, fuera de ventana",{"_3634":74190,"_31331":74170,"_21707":124450,"_5":14945,"_28497":124404,"_3084":124451},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3634":74191,"_31331":74170,"_21707":124453,"_5":14945,"_28497":124404,"_3084":124454},[],"Certificado vencido, clave disponible",{"_3634":74192,"_31331":74170,"_21707":124456,"_5":14945,"_28497":124404,"_3084":124457},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3634":74193,"_31331":74170,"_21707":124459,"_5":14945,"_28497":124404,"_3084":124460},[],"Renovación por webhook o `NO_AUTH`",{"_3634":74194,"_31331":74170,"_21707":124462,"_5":14945,"_28497":124404,"_3084":124463},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3634":74195,"_31331":74170,"_21707":124465,"_5":14945,"_28497":124404,"_3084":124466},[],"Clave perdida o inaccesible",{"_3634":74196,"_31331":74170,"_21707":124468,"_5":14945,"_28497":124404,"_3084":124469},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3634":74197,"_31331":74170,"_21707":124471,"_5":14945,"_28497":124404,"_3084":124472},[],"Identidad actual revocada",{"_3634":74198,"_31331":74170,"_21707":124474,"_5":14945,"_28497":124404,"_3084":124475},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3634":74199,"_31331":74170,"_21707":124477,"_5":14945,"_28497":124404,"_3084":124478},[],"Dispositivo sin identidad",{"_3634":74200,"_31331":74170,"_21707":124480,"_5":14945,"_28497":124404,"_3084":124481},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3634":74201,"_31331":74170,"_21707":124483,"_5":14945,"_28497":124404,"_3084":124484},[],"Dispositivo retirado",{"_3634":74202,"_31331":74170,"_21707":124486,"_5":14945,"_28497":124404,"_3084":124487},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3634":74203,"_31331":74170,"_21707":124489,"_5":14945,"_28497":124404,"_3084":124490},[],"Timeout, HTTP 500 o fallo de instalación",{"_3634":74204,"_31331":74170,"_21707":124492,"_5":14945,"_28497":124404,"_3084":124493},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3634":74205,"_31331":74170,"_21707":124495,"_5":14945,"_28497":124408,"_3084":124496},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3634":74206,"_31331":74170,"_21707":124498,"_5":14945,"_28497":124408,"_3084":124499},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3634":74207,"_31331":74207,"_5":15305,"_3084":124501,"_31690":124502,"_21707":124503,"_28497":74207},"Diagnóstico de enrolamiento",[51145,122216,53829,123361,123539],[],{"_3634":74208,"_31331":74207,"_21707":124505,"_5":14945,"_28497":74207,"_3084":124506},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3634":74209,"_31331":74207,"_5":31687,"_21707":124508,"_28497":124509,"_3084":124510},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3634":74210,"_31331":74207,"_5":31687,"_21707":124512,"_28497":124513,"_3084":124514},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3634":74211,"_31331":74207,"_5":31687,"_21707":124516,"_28497":124517,"_3084":124080},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3634":74212,"_31331":74207,"_5":31687,"_21707":124519,"_28497":124520,"_3084":124521},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3634":74213,"_31331":74207,"_21707":124523,"_5":14945,"_28497":74207,"_3084":124524},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3634":74214,"_31331":74207,"_21707":124526,"_5":14945,"_28497":124513,"_3084":124527},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3634":74215,"_31331":74207,"_21707":124529,"_5":14945,"_28497":124513,"_3084":124530},[],"Síntoma o mensaje",{"_3634":74216,"_31331":74207,"_21707":124532,"_5":14945,"_28497":124513,"_3084":124533},[],"Qué revisar",{"_3634":74217,"_31331":74207,"_21707":124535,"_5":14945,"_28497":124513,"_3084":124536},[],"curl rechaza TLS, nombre o emisor",{"_3634":74218,"_31331":74207,"_21707":124538,"_5":14945,"_28497":124513,"_3084":124539},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3634":74219,"_31331":74207,"_21707":124541,"_5":14945,"_28497":124513,"_3084":124542},[],"404 o APS ausente",{"_3634":74220,"_31331":74207,"_21707":124544,"_5":14945,"_28497":124513,"_3084":124545},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3634":74221,"_31331":74207,"_21707":124547,"_5":14945,"_28497":124513,"_3084":124548},[],"400, error de CSR o formato",{"_3634":74222,"_31331":74207,"_21707":124550,"_5":14945,"_28497":124513,"_3084":124551},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3634":74223,"_31331":74207,"_21707":124553,"_5":14945,"_28497":124513,"_3084":124554},[],"Credencial ausente o certificado no válido",{"_3634":74224,"_31331":74207,"_21707":124556,"_5":14945,"_28497":124513,"_3084":124557},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3634":74225,"_31331":74207,"_21707":124559,"_5":14945,"_28497":124513,"_3084":124560},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3634":74226,"_31331":74207,"_21707":124562,"_5":14945,"_28497":124513,"_3084":124563},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3634":74227,"_31331":74207,"_21707":124565,"_5":14945,"_28497":124513,"_3084":124566},[],"Webhook deniega, expira o responde sin autorización",{"_3634":74228,"_31331":74207,"_21707":124568,"_5":14945,"_28497":124513,"_3084":124569},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3634":74229,"_31331":74207,"_21707":124571,"_5":14945,"_28497":124513,"_3084":55085},[],{"_3634":74230,"_31331":74207,"_21707":124573,"_5":14945,"_28497":124513,"_3084":124574},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3634":74231,"_31331":74207,"_21707":124576,"_5":14945,"_28497":124513,"_3084":55091},[],{"_3634":74232,"_31331":74207,"_21707":124578,"_5":14945,"_28497":124513,"_3084":124579},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3634":74233,"_31331":74207,"_21707":124581,"_5":14945,"_28497":124513,"_3084":55097},[],{"_3634":74234,"_31331":74207,"_21707":124583,"_5":14945,"_28497":124513,"_3084":124584},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3634":74235,"_31331":74207,"_21707":124586,"_5":14945,"_28497":124513,"_3084":55103},[],{"_3634":74236,"_31331":74207,"_21707":124588,"_5":14945,"_28497":124513,"_3084":124589},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3634":74237,"_31331":74207,"_21707":124591,"_5":14945,"_28497":124513,"_3084":55109},[],{"_3634":74238,"_31331":74207,"_21707":124593,"_5":14945,"_28497":124513,"_3084":124594},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3634":74239,"_31331":74207,"_21707":124596,"_5":14945,"_28497":124513,"_3084":124597},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3634":74240,"_31331":74207,"_21707":124599,"_5":14945,"_28497":124513,"_3084":124600},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3634":74241,"_31331":74207,"_21707":124602,"_5":14945,"_28497":124513,"_3084":124603},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3634":74242,"_31331":74207,"_21707":124605,"_5":14945,"_28497":124513,"_3084":124606},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3634":74243,"_31331":74207,"_21707":124608,"_5":14945,"_28497":124513,"_3084":55127},[],{"_3634":74244,"_31331":74207,"_21707":124610,"_5":14945,"_28497":124513,"_3084":124611},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3634":74245,"_31331":74207,"_21707":124613,"_5":14945,"_28497":124513,"_3084":55133},[],{"_3634":74246,"_31331":74207,"_21707":124615,"_5":14945,"_28497":124513,"_3084":124616},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3634":74247,"_31331":74207,"_21707":124618,"_5":14945,"_28497":124513,"_3084":124619},[],"DMS propietario distinto",{"_3634":74248,"_31331":74207,"_21707":124621,"_5":14945,"_28497":124513,"_3084":124622},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3634":74249,"_31331":74207,"_21707":124624,"_5":14945,"_28497":124513,"_3084":55145},[],{"_3634":74250,"_31331":74207,"_21707":124626,"_5":14945,"_28497":124513,"_3084":124627},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3634":74251,"_31331":74207,"_21707":124629,"_5":14945,"_28497":124513,"_3084":55151},[],{"_3634":74252,"_31331":74207,"_21707":124631,"_5":14945,"_28497":124513,"_3084":124632},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3634":74253,"_31331":74207,"_21707":124634,"_5":14945,"_28497":124513,"_3084":124635},[],"Certificado actual revocado",{"_3634":74254,"_31331":74207,"_21707":124637,"_5":14945,"_28497":124513,"_3084":124638},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3634":74255,"_31331":74207,"_21707":124640,"_5":14945,"_28497":124513,"_3084":124641},[],"Error de CA, perfil o firma",{"_3634":74256,"_31331":74207,"_21707":124643,"_5":14945,"_28497":124513,"_3084":124644},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3634":74257,"_31331":74207,"_21707":124646,"_5":14945,"_28497":124513,"_3084":124647},[],"HTTP 200 sin conexión del dispositivo",{"_3634":74258,"_31331":74207,"_21707":124649,"_5":14945,"_28497":124513,"_3084":124650},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3634":74259,"_31331":74207,"_21707":124652,"_5":14945,"_28497":124513,"_3084":124653},[],"Timeout o error después de emitir",{"_3634":74260,"_31331":74207,"_21707":124655,"_5":14945,"_28497":124513,"_3084":124656},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3634":74261,"_31331":74207,"_21707":124658,"_5":14945,"_28497":124517,"_3084":124659},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3634":74262,"_31331":74207,"_21707":124661,"_5":14945,"_28497":124517,"_3084":124662},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3634":74263,"_31331":74207,"_21707":124664,"_5":14945,"_28497":124520,"_3084":124665},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3634":74264,"_31331":74207,"_21707":124667,"_5":14945,"_28497":124520,"_3084":124668},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3634":74265,"_31331":74207,"_21707":124670,"_5":14945,"_28497":124520,"_3084":124671},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3634":74266,"_31331":74207,"_21707":124673,"_5":14945,"_28497":124520,"_3084":124674},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3634":74267,"_31331":74207,"_21707":124676,"_5":14945,"_28497":124520,"_3084":124677},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3634":74268,"_31331":74207,"_21707":124679,"_5":14945,"_28497":124520,"_3084":124680},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3634":74269,"_31331":74207,"_21707":124682,"_5":14945,"_28497":124520,"_3084":124683},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3634":74270,"_31331":74270,"_5":15305,"_3084":124685,"_31690":124686,"_21707":124687,"_28497":74270},"Distribución y actualización de confianza",[51145,122216,53829,123361,123539],[],{"_3634":74271,"_31331":74270,"_21707":124689,"_5":14945,"_28497":74270,"_3084":124690},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3634":74272,"_31331":74270,"_5":31687,"_21707":124692,"_28497":124693,"_3084":124694},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3634":74273,"_31331":74270,"_5":31687,"_21707":124696,"_28497":124697,"_3084":124698},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3634":74274,"_31331":74270,"_5":31687,"_21707":124700,"_28497":124701,"_3084":124702},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3634":74275,"_31331":74270,"_5":31687,"_21707":124704,"_28497":124705,"_3084":124706},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3634":74276,"_31331":74270,"_5":31687,"_21707":124708,"_28497":124709,"_3084":124710},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3634":74277,"_31331":74270,"_21707":124712,"_5":14945,"_28497":74270,"_3084":124713},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3634":74278,"_31331":74270,"_21707":124715,"_5":14945,"_28497":124693,"_3084":124716},[],"Relación",{"_3634":74279,"_31331":74270,"_21707":124718,"_5":14945,"_28497":124693,"_3084":124719},[],"Material que prepara el responsable",{"_3634":74280,"_31331":74270,"_21707":124721,"_5":14945,"_28497":124693,"_3084":124722},[],"Dispositivo → servidor EST",{"_3634":74281,"_31331":74270,"_21707":124724,"_5":14945,"_28497":124693,"_3084":124725},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3634":74282,"_31331":74270,"_21707":124727,"_5":14945,"_28497":124693,"_3084":124728},[],"DMS → solicitante",{"_3634":74283,"_31331":74270,"_21707":124730,"_5":14945,"_28497":124693,"_3084":124731},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3634":74284,"_31331":74270,"_21707":124733,"_5":14945,"_28497":124693,"_3084":124734},[],"Consumidor → dispositivo",{"_3634":74285,"_31331":74270,"_21707":124736,"_5":14945,"_28497":124693,"_3084":124737},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3634":74286,"_31331":74270,"_21707":124739,"_5":14945,"_28497":124693,"_3084":124740},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3634":74287,"_31331":74270,"_21707":124742,"_5":14945,"_28497":124697,"_3084":124743},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3634":74288,"_31331":74270,"_21707":124745,"_5":14945,"_28497":124697,"_3084":124746},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3634":74289,"_31331":74270,"_21707":124748,"_5":14945,"_28497":124701,"_3084":124749},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3634":74290,"_31331":74270,"_21707":124751,"_5":14945,"_28497":124701,"_3084":124752},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3634":74291,"_31331":74270,"_21707":124754,"_5":14945,"_28497":124701,"_3084":124755},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3634":74292,"_31331":74270,"_21707":124757,"_5":14945,"_28497":124701,"_3084":124758},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3634":74293,"_31331":74270,"_21707":124760,"_5":14945,"_28497":124701,"_3084":124761},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3634":74294,"_31331":74270,"_21707":124763,"_5":14945,"_28497":124701,"_3084":124764},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3634":74295,"_31331":74270,"_21707":124766,"_5":14945,"_28497":124705,"_3084":124767},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3634":74296,"_31331":74270,"_21707":124769,"_5":14945,"_28497":124705,"_3084":124770},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3634":74297,"_31331":74270,"_21707":124772,"_5":14945,"_28497":124705,"_3084":124773},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3634":74298,"_31331":74270,"_21707":124775,"_5":14945,"_28497":124709,"_3084":124776},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3634":74299,"_31331":74299,"_5":15305,"_3084":55300,"_31690":124778,"_21707":124780,"_28497":74299},[51145,122216,53829,123361,124779],"Integraciones",[],{"_3634":74300,"_31331":74299,"_21707":124782,"_5":14945,"_28497":74299,"_3084":124783},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3634":74301,"_31331":74299,"_5":31687,"_21707":124785,"_28497":124786,"_3084":124787},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3634":74302,"_31331":74299,"_5":31687,"_21707":124789,"_28497":124790,"_3084":124791},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3634":74303,"_31331":74299,"_5":31687,"_21707":124793,"_28497":124794,"_3084":124795},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3634":74304,"_31331":74299,"_5":31687,"_21707":124797,"_28497":124798,"_3084":124799},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3634":74305,"_31331":74299,"_5":31687,"_21707":124801,"_28497":124802,"_3084":124803},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3634":74306,"_31331":74299,"_5":31687,"_21707":124805,"_28497":124806,"_3084":124807},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3634":74307,"_31331":74299,"_5":31687,"_21707":124809,"_28497":124810,"_3084":124811},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3634":74308,"_31331":74299,"_5":31687,"_21707":124813,"_28497":124814,"_3084":124815},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3634":74309,"_31331":74299,"_5":31687,"_21707":124817,"_28497":124818,"_3084":55342},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3634":74310,"_31331":74299,"_5":31687,"_21707":124820,"_28497":124821,"_3084":55346},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3634":74311,"_31331":74299,"_5":31687,"_21707":124823,"_28497":124824,"_3084":124825},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3634":74312,"_31331":74299,"_5":31687,"_21707":124827,"_28497":124828,"_3084":124829},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3634":74313,"_31331":74299,"_5":31687,"_21707":124831,"_28497":124832,"_3084":124833},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3634":74314,"_31331":74299,"_5":31687,"_21707":124835,"_28497":124836,"_3084":124837},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3634":74315,"_31331":74299,"_5":31687,"_21707":124839,"_28497":124840,"_3084":124841},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3634":74316,"_31331":74299,"_5":31687,"_21707":124843,"_28497":124844,"_3084":124845},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3634":74317,"_31331":74299,"_5":31687,"_21707":124847,"_28497":124848,"_3084":124849},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3634":74318,"_31331":74299,"_5":31687,"_21707":124851,"_28497":124852,"_3084":124853},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3634":74319,"_31331":74299,"_5":31687,"_21707":124855,"_28497":124856,"_3084":124857},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3634":74320,"_31331":74299,"_5":31687,"_21707":124859,"_28497":124860,"_3084":124861},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3634":74321,"_31331":74299,"_5":31687,"_21707":124863,"_28497":124864,"_3084":124865},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3634":74322,"_31331":74299,"_5":31687,"_21707":124867,"_28497":124868,"_3084":124869},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3634":74323,"_31331":74299,"_5":31687,"_21707":124871,"_28497":124872,"_3084":124873},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3634":74324,"_31331":74299,"_5":31687,"_21707":124875,"_28497":124876,"_3084":124877},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3634":74325,"_31331":74299,"_5":31687,"_21707":124879,"_28497":124880,"_3084":124881},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3634":74326,"_31331":74299,"_21707":124883,"_5":14945,"_28497":74299,"_3084":124884},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3634":74327,"_31331":74299,"_21707":124886,"_5":14945,"_28497":74299,"_3084":124887},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3634":74328,"_31331":74299,"_21707":124889,"_5":14945,"_28497":74299,"_3084":124890},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3634":74329,"_31331":74299,"_21707":124892,"_5":14945,"_28497":124786,"_3084":124893},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3634":74330,"_31331":74299,"_21707":124895,"_5":14945,"_28497":124786,"_3084":124896},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3634":74331,"_31331":74299,"_21707":124898,"_5":14945,"_28497":124786,"_3084":124899},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3634":74332,"_31331":74299,"_21707":124901,"_5":14945,"_28497":124786,"_3084":124902},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3634":74333,"_31331":74299,"_21707":124904,"_5":14945,"_28497":124790,"_3084":124905},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3634":74334,"_31331":74299,"_21707":124907,"_5":14945,"_28497":124794,"_3084":124908},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3634":74335,"_31331":74299,"_21707":124910,"_5":14945,"_28497":124794,"_3084":124911},[],"Acción IAM",{"_3634":74336,"_31331":74299,"_21707":124913,"_5":14945,"_28497":124794,"_3084":121120},[],{"_3634":74337,"_31331":74299,"_21707":124915,"_5":14945,"_28497":124794,"_3084":55441},[],{"_3634":74338,"_31331":74299,"_21707":124917,"_5":14945,"_28497":124794,"_3084":124918},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3634":74339,"_31331":74299,"_21707":124920,"_5":14945,"_28497":124794,"_3084":55447},[],{"_3634":74340,"_31331":74299,"_21707":124922,"_5":14945,"_28497":124794,"_3084":124923},[],"Registrar la CA en AWS IoT",{"_3634":74341,"_31331":74299,"_21707":124925,"_5":14945,"_28497":124794,"_3084":55453},[],{"_3634":74342,"_31331":74299,"_21707":124927,"_5":14945,"_28497":124794,"_3084":124928},[],"Consultar el estado del registro de la CA",{"_3634":74343,"_31331":74299,"_21707":124930,"_5":14945,"_28497":124794,"_3084":55459},[],{"_3634":74344,"_31331":74299,"_21707":124932,"_5":14945,"_28497":124794,"_3084":124933},[],"Crear o actualizar Things en IoT Core",{"_3634":74345,"_31331":74299,"_21707":124935,"_5":14945,"_28497":124794,"_3084":55465},[],{"_3634":74346,"_31331":74299,"_21707":124937,"_5":14945,"_28497":124794,"_3084":124938},[],"Aprovisionar Things mediante plantilla",{"_3634":74347,"_31331":74299,"_21707":124940,"_5":14945,"_28497":124794,"_3084":55471},[],{"_3634":74348,"_31331":74299,"_21707":124942,"_5":14945,"_28497":124794,"_3084":124943},[],"Registrar certificados de dispositivo",{"_3634":74349,"_31331":74299,"_21707":124945,"_5":14945,"_28497":124794,"_3084":55477},[],{"_3634":74350,"_31331":74299,"_21707":124947,"_5":14945,"_28497":124794,"_3084":124948},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3634":74351,"_31331":74299,"_21707":124950,"_5":14945,"_28497":124794,"_3084":55483},[],{"_3634":74352,"_31331":74299,"_21707":124952,"_5":14945,"_28497":124794,"_3084":124953},[],"Crear y adjuntar políticas IoT",{"_3634":74353,"_31331":74299,"_21707":124955,"_5":14945,"_28497":124794,"_3084":55489},[],{"_3634":74354,"_31331":74299,"_21707":124957,"_5":14945,"_28497":124794,"_3084":124958},[],"Gestionar grupos de Things",{"_3634":74355,"_31331":74299,"_21707":124960,"_5":14945,"_28497":124794,"_3084":55495},[],{"_3634":74356,"_31331":74299,"_21707":124962,"_5":14945,"_28497":124794,"_3084":124963},[],"Crear plantillas JITP",{"_3634":74357,"_31331":74299,"_21707":124965,"_5":14945,"_28497":124794,"_3084":55501},[],{"_3634":74358,"_31331":74299,"_21707":124967,"_5":14945,"_28497":124794,"_3084":124968},[],"Leer y escribir el Device Shadow",{"_3634":74359,"_31331":74299,"_21707":124970,"_5":14945,"_28497":124794,"_3084":124971},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3634":74360,"_31331":74299,"_21707":124973,"_5":14945,"_28497":124798,"_3084":124974},[],"Parámetro",{"_3634":74361,"_31331":74299,"_21707":124976,"_5":14945,"_28497":124798,"_3084":124977},[],"Tipo",{"_3634":74362,"_31331":74299,"_21707":124979,"_5":14945,"_28497":124798,"_3084":124980},[],"Requerido",{"_3634":74363,"_31331":74299,"_21707":124982,"_5":14945,"_28497":124798,"_3084":124983},[],"Descripción",{"_3634":74364,"_31331":74299,"_21707":124985,"_5":14945,"_28497":124798,"_3084":55522},[],{"_3634":74365,"_31331":74299,"_21707":124987,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74366,"_31331":74299,"_21707":124989,"_5":14945,"_28497":124798,"_3084":124990},[],"Sí",{"_3634":74367,"_31331":74299,"_21707":124992,"_5":14945,"_28497":124798,"_3084":124993},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3634":74368,"_31331":74299,"_21707":124995,"_5":14945,"_28497":124798,"_3084":55533},[],{"_3634":74369,"_31331":74299,"_21707":124997,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74370,"_31331":74299,"_21707":124999,"_5":14945,"_28497":124798,"_3084":124990},[],{"_3634":74371,"_31331":74299,"_21707":125001,"_5":14945,"_28497":124798,"_3084":125002},[],"Región AWS donde opera el conector.",{"_3634":74372,"_31331":74299,"_21707":125004,"_5":14945,"_28497":124798,"_3084":55543},[],{"_3634":74373,"_31331":74299,"_21707":125006,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74374,"_31331":74299,"_21707":125008,"_5":14945,"_28497":124798,"_3084":124990},[],{"_3634":74375,"_31331":74299,"_21707":125010,"_5":14945,"_28497":124798,"_3084":125011},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3634":74376,"_31331":74299,"_21707":125013,"_5":14945,"_28497":124798,"_3084":55553},[],{"_3634":74377,"_31331":74299,"_21707":125015,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74378,"_31331":74299,"_21707":125017,"_5":14945,"_28497":124798,"_3084":125018},[],"Solo con `auth_method=static`",{"_3634":74379,"_31331":74299,"_21707":125020,"_5":14945,"_28497":124798,"_3084":125021},[],"Clave de acceso AWS.",{"_3634":74380,"_31331":74299,"_21707":125023,"_5":14945,"_28497":124798,"_3084":55564},[],{"_3634":74381,"_31331":74299,"_21707":125025,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74382,"_31331":74299,"_21707":125027,"_5":14945,"_28497":124798,"_3084":125018},[],{"_3634":74383,"_31331":74299,"_21707":125029,"_5":14945,"_28497":124798,"_3084":125030},[],"Clave secreta AWS.",{"_3634":74384,"_31331":74299,"_21707":125032,"_5":14945,"_28497":124798,"_3084":55574},[],{"_3634":74385,"_31331":74299,"_21707":125034,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74386,"_31331":74299,"_21707":125036,"_5":14945,"_28497":124798,"_3084":55579},[],{"_3634":74387,"_31331":74299,"_21707":125038,"_5":14945,"_28497":124798,"_3084":125039},[],"Token de sesión (con `auth_method=static`).",{"_3634":74388,"_31331":74299,"_21707":125041,"_5":14945,"_28497":124798,"_3084":55585},[],{"_3634":74389,"_31331":74299,"_21707":125043,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74390,"_31331":74299,"_21707":125045,"_5":14945,"_28497":124798,"_3084":125046},[],"Solo con `auth_method=role`",{"_3634":74391,"_31331":74299,"_21707":125048,"_5":14945,"_28497":124798,"_3084":125049},[],"ARN del rol a asumir.",{"_3634":74392,"_31331":74299,"_21707":125051,"_5":14945,"_28497":124798,"_3084":55596},[],{"_3634":74393,"_31331":74299,"_21707":125053,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74394,"_31331":74299,"_21707":125055,"_5":14945,"_28497":124798,"_3084":55579},[],{"_3634":74395,"_31331":74299,"_21707":125057,"_5":14945,"_28497":124798,"_3084":125058},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3634":74396,"_31331":74299,"_21707":125060,"_5":14945,"_28497":124798,"_3084":55606},[],{"_3634":74397,"_31331":74299,"_21707":125062,"_5":14945,"_28497":124798,"_3084":93236},[],{"_3634":74398,"_31331":74299,"_21707":125064,"_5":14945,"_28497":124798,"_3084":124990},[],{"_3634":74399,"_31331":74299,"_21707":125066,"_5":14945,"_28497":124798,"_3084":125067},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3634":74400,"_31331":74299,"_21707":125069,"_5":14945,"_28497":124798,"_3084":55616},[],{"_3634":74401,"_31331":74299,"_21707":125071,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74402,"_31331":74299,"_21707":125073,"_5":14945,"_28497":124798,"_3084":124990},[],{"_3634":74403,"_31331":74299,"_21707":125075,"_5":14945,"_28497":124798,"_3084":125076},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3634":74404,"_31331":74299,"_21707":125078,"_5":14945,"_28497":124798,"_3084":55626},[],{"_3634":74405,"_31331":74299,"_21707":125080,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74406,"_31331":74299,"_21707":125082,"_5":14945,"_28497":124798,"_3084":124990},[],{"_3634":74407,"_31331":74299,"_21707":125084,"_5":14945,"_28497":124798,"_3084":125085},[],"URL HTTP del Device Manager de Lamassu.",{"_3634":74408,"_31331":74299,"_21707":125087,"_5":14945,"_28497":124798,"_3084":55636},[],{"_3634":74409,"_31331":74299,"_21707":125089,"_5":14945,"_28497":124798,"_3084":25888},[],{"_3634":74410,"_31331":74299,"_21707":125091,"_5":14945,"_28497":124798,"_3084":124990},[],{"_3634":74411,"_31331":74299,"_21707":125093,"_5":14945,"_28497":124798,"_3084":125094},[],"URL HTTP del servicio de CA de Lamassu.",{"_3634":74412,"_31331":74299,"_21707":125096,"_5":14945,"_28497":124802,"_3084":125097},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3634":74413,"_31331":74299,"_21707":125099,"_5":14945,"_28497":124802,"_3084":125100},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3634":74414,"_31331":74299,"_21707":125102,"_5":14945,"_28497":124802,"_3084":125103},[],"Tipo de CloudEvent",{"_3634":74415,"_31331":74299,"_21707":125105,"_5":14945,"_28497":124802,"_3084":125106},[],"Recurso en Lamassu",{"_3634":74416,"_31331":74299,"_21707":125108,"_5":14945,"_28497":124802,"_3084":125109},[],"Recurso AWS",{"_3634":74417,"_31331":74299,"_21707":125111,"_5":14945,"_28497":124802,"_3084":125112},[],"Acciones IAM",{"_3634":74418,"_31331":74299,"_21707":125114,"_5":14945,"_28497":124802,"_3084":125115},[],"Llamadas AWS y efecto",{"_3634":74419,"_31331":74299,"_21707":125117,"_5":14945,"_28497":124802,"_3084":125118},[],"Dónde en esta página",{"_3634":74420,"_31331":74299,"_21707":125120,"_5":14945,"_28497":124802,"_3084":55670},[],{"_3634":74421,"_31331":74299,"_21707":125122,"_5":14945,"_28497":124802,"_3084":55673},[],{"_3634":74422,"_31331":74299,"_21707":125124,"_5":14945,"_28497":124802,"_3084":55676},[],{"_3634":74423,"_31331":74299,"_21707":125126,"_5":14945,"_28497":124802,"_3084":55679},[],{"_3634":74424,"_31331":74299,"_21707":125128,"_5":14945,"_28497":124802,"_3084":125129},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3634":74425,"_31331":74299,"_21707":125131,"_5":14945,"_28497":124802,"_3084":124815},[],{"_3634":74426,"_31331":74299,"_21707":125133,"_5":14945,"_28497":124802,"_3084":55687},[],{"_3634":74427,"_31331":74299,"_21707":125135,"_5":14945,"_28497":124802,"_3084":55690},[],{"_3634":74428,"_31331":74299,"_21707":125137,"_5":14945,"_28497":124802,"_3084":55693},[],{"_3634":74429,"_31331":74299,"_21707":125139,"_5":14945,"_28497":124802,"_3084":55696},[],{"_3634":74430,"_31331":74299,"_21707":125141,"_5":14945,"_28497":124802,"_3084":125142},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3634":74431,"_31331":74299,"_21707":125144,"_5":14945,"_28497":124802,"_3084":124841},[],{"_3634":74432,"_31331":74299,"_21707":125146,"_5":14945,"_28497":124802,"_3084":55704},[],{"_3634":74433,"_31331":74299,"_21707":125148,"_5":14945,"_28497":124802,"_3084":125149},[],"Dispositivo",{"_3634":74434,"_31331":74299,"_21707":125151,"_5":14945,"_28497":124802,"_3084":55710},[],{"_3634":74435,"_31331":74299,"_21707":125153,"_5":14945,"_28497":124802,"_3084":55713},[],{"_3634":74436,"_31331":74299,"_21707":125155,"_5":14945,"_28497":124802,"_3084":125156},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3634":74437,"_31331":74299,"_21707":125158,"_5":14945,"_28497":124802,"_3084":124849},[],{"_3634":74438,"_31331":74299,"_21707":125160,"_5":14945,"_28497":124802,"_3084":55721},[],{"_3634":74439,"_31331":74299,"_21707":125162,"_5":14945,"_28497":124802,"_3084":125163},[],"Certificado",{"_3634":74440,"_31331":74299,"_21707":125165,"_5":14945,"_28497":124802,"_3084":55727},[],{"_3634":74441,"_31331":74299,"_21707":125167,"_5":14945,"_28497":124802,"_3084":125168},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3634":74442,"_31331":74299,"_21707":125170,"_5":14945,"_28497":124802,"_3084":125171},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3634":74443,"_31331":74299,"_21707":125173,"_5":14945,"_28497":124802,"_3084":124861},[],{"_3634":74444,"_31331":74299,"_21707":125175,"_5":14945,"_28497":124802,"_3084":55738},[],{"_3634":74445,"_31331":74299,"_21707":125177,"_5":14945,"_28497":124802,"_3084":125178},[],"Certificado / Dispositivo",{"_3634":74446,"_31331":74299,"_21707":125180,"_5":14945,"_28497":124802,"_3084":55744},[],{"_3634":74447,"_31331":74299,"_21707":125182,"_5":14945,"_28497":124802,"_3084":51541},[],{"_3634":74448,"_31331":74299,"_21707":125184,"_5":14945,"_28497":124802,"_3084":125185},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3634":74449,"_31331":74299,"_21707":125187,"_5":14945,"_28497":124802,"_3084":124869},[],{"_3634":74450,"_31331":74299,"_21707":125189,"_5":14945,"_28497":124806,"_3084":125190},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3634":74451,"_31331":74299,"_21707":125192,"_5":14945,"_28497":124810,"_3084":125193},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3634":74452,"_31331":74299,"_21707":125195,"_5":14945,"_28497":124810,"_3084":125196},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3634":74453,"_31331":74299,"_21707":125198,"_5":14945,"_28497":124814,"_3084":125199},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3634":74454,"_31331":74299,"_21707":125201,"_5":14945,"_28497":124814,"_3084":125202},[],"Transición",{"_3634":74455,"_31331":74299,"_21707":125204,"_5":14945,"_28497":124814,"_3084":125205},[],"Llamadas AWS",{"_3634":74456,"_31331":74299,"_21707":125207,"_5":14945,"_28497":124814,"_3084":125208},[],"`NoRegistrada` → `Solicitada`",{"_3634":74457,"_31331":74299,"_21707":125210,"_5":14945,"_28497":124814,"_3084":125211},[],"ninguna (solo escritura de metadatos)",{"_3634":74458,"_31331":74299,"_21707":125213,"_5":14945,"_28497":124814,"_3084":125214},[],"`Solicitada` → `Registrando`",{"_3634":74459,"_31331":74299,"_21707":125216,"_5":14945,"_28497":124814,"_3084":125217},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3634":74460,"_31331":74299,"_21707":125219,"_5":14945,"_28497":124814,"_3084":125220},[],"`Registrando` → `Completada`",{"_3634":74461,"_31331":74299,"_21707":125222,"_5":14945,"_28497":124814,"_3084":125223},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3634":74462,"_31331":74299,"_21707":125225,"_5":14945,"_28497":124814,"_3084":125226},[],"`Registrando` → `Fallida`",{"_3634":74463,"_31331":74299,"_21707":125228,"_5":14945,"_28497":124814,"_3084":125229},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3634":74464,"_31331":74299,"_21707":125231,"_5":14945,"_28497":124814,"_3084":125232},[],"`Fallida` / `Completada` → `Solicitada`",{"_3634":74465,"_31331":74299,"_21707":125234,"_5":14945,"_28497":124814,"_3084":125235},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3634":74466,"_31331":74299,"_21707":125237,"_5":14945,"_28497":124818,"_3084":125238},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3634":74467,"_31331":74299,"_21707":125240,"_5":14945,"_28497":124818,"_3084":125241},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3634":74468,"_31331":74299,"_21707":125243,"_5":14945,"_28497":124818,"_3084":125244},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3634":74469,"_31331":74299,"_21707":125246,"_5":14945,"_28497":124818,"_3084":125247},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3634":74470,"_31331":74299,"_21707":125249,"_5":14945,"_28497":124818,"_3084":125250},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3634":74471,"_31331":74299,"_21707":125252,"_5":14945,"_28497":124818,"_3084":125253},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3634":74472,"_31331":74299,"_21707":125255,"_5":14945,"_28497":124821,"_3084":125256},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3634":74473,"_31331":74299,"_21707":125258,"_5":14945,"_28497":124824,"_3084":125259},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3634":74474,"_31331":74299,"_21707":125261,"_5":14945,"_28497":124824,"_3084":125262},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3634":74475,"_31331":74299,"_21707":125264,"_5":14945,"_28497":124828,"_3084":125265},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3634":74476,"_31331":74299,"_21707":125267,"_5":14945,"_28497":124832,"_3084":125268},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3634":74477,"_31331":74299,"_21707":125270,"_5":14945,"_28497":124832,"_3084":125271},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3634":74478,"_31331":74299,"_21707":125273,"_5":14945,"_28497":124832,"_3084":125274},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3634":74479,"_31331":74299,"_21707":125276,"_5":14945,"_28497":124832,"_3084":125277},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3634":74480,"_31331":74299,"_21707":125279,"_5":14945,"_28497":124832,"_3084":125280},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3634":74481,"_31331":74299,"_21707":125282,"_5":14945,"_28497":124832,"_3084":125283},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3634":74482,"_31331":74299,"_21707":125285,"_5":14945,"_28497":124836,"_3084":125286},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3634":74483,"_31331":74299,"_21707":125288,"_5":14945,"_28497":124836,"_3084":125289},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3634":74484,"_31331":74299,"_21707":125291,"_5":14945,"_28497":124836,"_3084":125292},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3634":74485,"_31331":74299,"_21707":125294,"_5":14945,"_28497":124836,"_3084":125295},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3634":74486,"_31331":74299,"_21707":125297,"_5":14945,"_28497":124836,"_3084":125298},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3634":74487,"_31331":74299,"_21707":125300,"_5":14945,"_28497":124840,"_3084":125301},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3634":74488,"_31331":74299,"_21707":125303,"_5":14945,"_28497":124840,"_3084":125202},[],{"_3634":74489,"_31331":74299,"_21707":125305,"_5":14945,"_28497":124840,"_3084":125205},[],{"_3634":74490,"_31331":74299,"_21707":125307,"_5":14945,"_28497":124840,"_3084":125308},[],"`SinConfigurar` → `None` / `Auto`",{"_3634":74491,"_31331":74299,"_21707":125310,"_5":14945,"_28497":124840,"_3084":125311},[],"ninguna (solo configuración)",{"_3634":74492,"_31331":74299,"_21707":125313,"_5":14945,"_28497":124840,"_3084":55881},[],{"_3634":74493,"_31331":74299,"_21707":125315,"_5":14945,"_28497":124840,"_3084":125311},[],{"_3634":74494,"_31331":74299,"_21707":125317,"_5":14945,"_28497":124840,"_3084":125318},[],"Cualquiera → `Jitp`",{"_3634":74495,"_31331":74299,"_21707":125320,"_5":14945,"_28497":124840,"_3084":125321},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3634":74496,"_31331":74299,"_21707":125323,"_5":14945,"_28497":124840,"_3084":55892},[],{"_3634":74497,"_31331":74299,"_21707":125325,"_5":14945,"_28497":124840,"_3084":125326},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3634":74498,"_31331":74299,"_21707":125328,"_5":14945,"_28497":124844,"_3084":125329},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3634":74499,"_31331":74299,"_21707":125331,"_5":14945,"_28497":124844,"_3084":125332},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3634":74500,"_31331":74299,"_21707":125334,"_5":14945,"_28497":124844,"_3084":125335},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3634":74501,"_31331":74299,"_21707":125337,"_5":14945,"_28497":124848,"_3084":125338},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3634":74502,"_31331":74299,"_21707":125340,"_5":14945,"_28497":124848,"_3084":125202},[],{"_3634":74503,"_31331":74299,"_21707":125342,"_5":14945,"_28497":124848,"_3084":125205},[],{"_3634":74504,"_31331":74299,"_21707":125344,"_5":14945,"_28497":124848,"_3084":125345},[],"`Ausente` → `Aprovisionado`",{"_3634":74505,"_31331":74299,"_21707":125347,"_5":14945,"_28497":124848,"_3084":125348},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3634":74506,"_31331":74299,"_21707":125350,"_5":14945,"_28497":124848,"_3084":125351},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3634":74507,"_31331":74299,"_21707":125353,"_5":14945,"_28497":124848,"_3084":125354},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3634":74508,"_31331":74299,"_21707":125356,"_5":14945,"_28497":124848,"_3084":125357},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3634":74509,"_31331":74299,"_21707":125359,"_5":14945,"_28497":124852,"_3084":125360},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3634":74510,"_31331":74299,"_21707":125362,"_5":14945,"_28497":124852,"_3084":125363},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3634":74511,"_31331":74299,"_21707":125365,"_5":14945,"_28497":124852,"_3084":125366},[],"Para que el flujo JITP funcione correctamente:",{"_3634":74512,"_31331":74299,"_21707":125368,"_5":14945,"_28497":124852,"_3084":125369},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3634":74513,"_31331":74299,"_21707":125371,"_5":14945,"_28497":124852,"_3084":125372},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3634":74514,"_31331":74299,"_21707":125374,"_5":14945,"_28497":124852,"_3084":125375},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3634":74515,"_31331":74299,"_21707":125377,"_5":14945,"_28497":124852,"_3084":125378},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3634":74516,"_31331":74299,"_21707":125380,"_5":14945,"_28497":124856,"_3084":125381},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3634":74517,"_31331":74299,"_21707":125383,"_5":14945,"_28497":124856,"_3084":125384},[],"Estado en Lamassu",{"_3634":74518,"_31331":74299,"_21707":125386,"_5":14945,"_28497":124856,"_3084":125387},[],"Razón de revocación",{"_3634":74519,"_31331":74299,"_21707":125389,"_5":14945,"_28497":124856,"_3084":125390},[],"Estado en AWS IoT Core",{"_3634":74520,"_31331":74299,"_21707":125392,"_5":14945,"_28497":124856,"_3084":55962},[],{"_3634":74521,"_31331":74299,"_21707":125394,"_5":14945,"_28497":124856,"_3084":125395},[],"Ninguna",{"_3634":74522,"_31331":74299,"_21707":125397,"_5":14945,"_28497":124856,"_3084":55968},[],{"_3634":74523,"_31331":74299,"_21707":125399,"_5":14945,"_28497":124856,"_3084":55971},[],{"_3634":74524,"_31331":74299,"_21707":125401,"_5":14945,"_28497":124856,"_3084":55974},[],{"_3634":74525,"_31331":74299,"_21707":125403,"_5":14945,"_28497":124856,"_3084":55977},[],{"_3634":74526,"_31331":74299,"_21707":125405,"_5":14945,"_28497":124856,"_3084":55971},[],{"_3634":74527,"_31331":74299,"_21707":125407,"_5":14945,"_28497":124856,"_3084":125408},[],"Cualquier otra razón",{"_3634":74528,"_31331":74299,"_21707":125410,"_5":14945,"_28497":124856,"_3084":55985},[],{"_3634":74529,"_31331":74299,"_21707":125412,"_5":14945,"_28497":124856,"_3084":125413},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3634":74530,"_31331":74299,"_21707":125415,"_5":14945,"_28497":124860,"_3084":125416},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3634":74531,"_31331":74299,"_21707":125418,"_5":14945,"_28497":124860,"_3084":125202},[],{"_3634":74532,"_31331":74299,"_21707":125420,"_5":14945,"_28497":124860,"_3084":125205},[],{"_3634":74533,"_31331":74299,"_21707":125422,"_5":14945,"_28497":124860,"_3084":125423},[],"`NoSincronizado` → `Active`",{"_3634":74534,"_31331":74299,"_21707":125425,"_5":14945,"_28497":124860,"_3084":55477},[],{"_3634":74535,"_31331":74299,"_21707":125427,"_5":14945,"_28497":124860,"_3084":56003},[],{"_3634":74536,"_31331":74299,"_21707":125429,"_5":14945,"_28497":124860,"_3084":125430},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3634":74537,"_31331":74299,"_21707":125432,"_5":14945,"_28497":124860,"_3084":56009},[],{"_3634":74538,"_31331":74299,"_21707":125434,"_5":14945,"_28497":124860,"_3084":125430},[],{"_3634":74539,"_31331":74299,"_21707":125436,"_5":14945,"_28497":124860,"_3084":56014},[],{"_3634":74540,"_31331":74299,"_21707":125438,"_5":14945,"_28497":124860,"_3084":55477},[],{"_3634":74541,"_31331":74299,"_21707":125440,"_5":14945,"_28497":124860,"_3084":56019},[],{"_3634":74542,"_31331":74299,"_21707":125442,"_5":14945,"_28497":124860,"_3084":125443},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3634":74543,"_31331":74299,"_21707":125445,"_5":14945,"_28497":124864,"_3084":125446},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3634":74544,"_31331":74299,"_21707":125448,"_5":14945,"_28497":124864,"_3084":125449},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3634":74545,"_31331":74299,"_21707":125451,"_5":14945,"_28497":124864,"_3084":125452},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3634":74546,"_31331":74299,"_21707":125454,"_5":14945,"_28497":124868,"_3084":125455},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3634":74547,"_31331":74299,"_21707":125457,"_5":14945,"_28497":124868,"_3084":125458},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3634":74548,"_31331":74299,"_21707":125460,"_5":14945,"_28497":124872,"_3084":125461},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3634":74549,"_31331":74299,"_21707":125463,"_5":14945,"_28497":124872,"_3084":125464},[],"Existen dos tipos de acciones:",{"_3634":74550,"_31331":74299,"_21707":125466,"_5":14945,"_28497":124872,"_3084":125467},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3634":74551,"_31331":74299,"_21707":125469,"_5":14945,"_28497":124872,"_3084":125470},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3634":74552,"_31331":74299,"_21707":125472,"_5":14945,"_28497":124872,"_3084":125473},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3634":74553,"_31331":74299,"_21707":125475,"_5":14945,"_28497":124876,"_3084":125476},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3634":74554,"_31331":74299,"_21707":125478,"_5":14945,"_28497":124876,"_3084":125479},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3634":74555,"_31331":74299,"_21707":125481,"_5":14945,"_28497":124876,"_3084":125482},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3634":74556,"_31331":74299,"_21707":125484,"_5":14945,"_28497":124880,"_3084":125485},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3634":74557,"_31331":74299,"_21707":125487,"_5":14945,"_28497":124880,"_3084":125488},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3634":74558,"_31331":74299,"_21707":125490,"_5":14945,"_28497":124880,"_3084":125491},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3634":74559,"_31331":74299,"_21707":125493,"_5":14945,"_28497":124880,"_3084":125494},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3634":74560,"_31331":74299,"_21707":125496,"_5":14945,"_28497":124880,"_3084":125497},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3634":74561,"_31331":74299,"_21707":125499,"_5":14945,"_28497":124880,"_3084":125500},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3634":74562,"_31331":74299,"_21707":125502,"_5":14945,"_28497":124880,"_3084":125503},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3634":74563,"_31331":74299,"_21707":125505,"_5":14945,"_28497":124880,"_3084":125506},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3634":74564,"_31331":74299,"_21707":125508,"_5":14945,"_28497":124880,"_3084":125509},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3634":74565,"_31331":74299,"_21707":125511,"_5":14945,"_28497":124880,"_3084":125512},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3634":74566,"_31331":74299,"_21707":125514,"_5":14945,"_28497":124880,"_3084":125515},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3634":74567,"_31331":74299,"_21707":125517,"_5":14945,"_28497":124880,"_3084":125518},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3634":74568,"_31331":74299,"_21707":125520,"_5":14945,"_28497":124880,"_3084":125521},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3634":74569,"_31331":74299,"_21707":125523,"_5":14945,"_28497":124880,"_3084":125524},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3634":74570,"_31331":74299,"_21707":125526,"_5":14945,"_28497":124880,"_3084":125527},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3634":74571,"_31331":74299,"_21707":125529,"_5":14945,"_28497":124880,"_3084":125530},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3634":74572,"_31331":74299,"_21707":125532,"_5":14945,"_28497":124880,"_3084":125533},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3634":74573,"_31331":74299,"_21707":125535,"_5":14945,"_28497":124880,"_3084":125536},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3634":74574,"_31331":74299,"_21707":125538,"_5":14945,"_28497":124880,"_3084":125539},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3634":74575,"_31331":74299,"_21707":125541,"_5":14945,"_28497":124880,"_3084":125542},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3634":74576,"_31331":74299,"_21707":125544,"_5":14945,"_28497":124880,"_3084":125545},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3634":74577,"_31331":74299,"_21707":125547,"_5":14945,"_28497":124880,"_3084":125548},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":74578,"_31331":74299,"_21707":125550,"_5":14945,"_28497":124880,"_3084":125551},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3634":74579,"_31331":74299,"_21707":125553,"_5":14945,"_28497":124880,"_3084":125554},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3634":74580,"_31331":74580,"_5":15305,"_3084":53829,"_31690":125556,"_21707":125557,"_28497":74580},[51145,122216,53829],[],{"_3634":74581,"_31331":74580,"_21707":125559,"_5":14945,"_28497":74580,"_3084":125560},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3634":74582,"_31331":74580,"_5":31687,"_21707":125562,"_28497":125563,"_3084":125564},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3634":74583,"_31331":74580,"_5":31687,"_21707":125566,"_28497":125567,"_3084":123361},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3634":74584,"_31331":74580,"_5":31687,"_21707":125569,"_28497":125570,"_3084":123539},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3634":74585,"_31331":74580,"_5":31687,"_21707":125572,"_28497":125573,"_3084":124779},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#integraciones",{"_3634":74586,"_31331":74580,"_5":31687,"_21707":125575,"_28497":125576,"_3084":125577},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3634":74587,"_31331":74580,"_21707":125579,"_5":14945,"_28497":74580,"_3084":125580},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3634":74588,"_31331":74580,"_21707":125582,"_5":14945,"_28497":125563,"_3084":125583},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3634":74589,"_31331":74580,"_21707":125585,"_5":14945,"_28497":125563,"_3084":125586},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3634":74590,"_31331":74580,"_21707":125588,"_5":14945,"_28497":125567,"_3084":125589},[],"Recurso",{"_3634":74591,"_31331":74580,"_21707":125591,"_5":14945,"_28497":125567,"_3084":125592},[],"Qué representa",{"_3634":74592,"_31331":74580,"_21707":125594,"_5":14945,"_28497":125567,"_3084":125595},[],"**Dispositivo**",{"_3634":74593,"_31331":74580,"_21707":125597,"_5":14945,"_28497":125567,"_3084":125598},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3634":74594,"_31331":74580,"_21707":125600,"_5":14945,"_28497":125567,"_3084":125601},[],"**Identidad**",{"_3634":74595,"_31331":74580,"_21707":125603,"_5":14945,"_28497":125567,"_3084":125604},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3634":74596,"_31331":74580,"_21707":125606,"_5":14945,"_28497":125567,"_3084":56186},[],{"_3634":74597,"_31331":74580,"_21707":125608,"_5":14945,"_28497":125567,"_3084":125609},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3634":74598,"_31331":74580,"_21707":125611,"_5":14945,"_28497":125567,"_3084":125612},[],"**Flota**",{"_3634":74599,"_31331":74580,"_21707":125614,"_5":14945,"_28497":125567,"_3084":125615},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3634":74600,"_31331":74580,"_21707":125617,"_5":14945,"_28497":125567,"_3084":125618},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3634":74601,"_31331":74580,"_21707":125620,"_5":14945,"_28497":125567,"_3084":125621},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3634":74602,"_31331":74580,"_21707":125623,"_5":14945,"_28497":125570,"_3084":125624},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3634":74603,"_31331":74580,"_21707":125626,"_5":14945,"_28497":125570,"_3084":125627},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3634":74604,"_31331":74580,"_21707":125629,"_5":14945,"_28497":125570,"_3084":125630},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3634":74605,"_31331":74580,"_21707":125632,"_5":14945,"_28497":125570,"_3084":125633},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3634":74606,"_31331":74580,"_21707":125635,"_5":14945,"_28497":125570,"_3084":125636},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3634":74607,"_31331":74580,"_21707":125638,"_5":14945,"_28497":125570,"_3084":125639},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3634":74608,"_31331":74580,"_21707":125641,"_5":14945,"_28497":125570,"_3084":125642},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":74609,"_31331":74580,"_21707":125644,"_5":14945,"_28497":125570,"_3084":125645},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":74610,"_31331":74580,"_21707":125647,"_5":14945,"_28497":125573,"_3084":125648},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3634":74611,"_31331":74580,"_21707":125650,"_5":14945,"_28497":125573,"_3084":125651},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3634":74612,"_31331":74580,"_21707":125653,"_5":14945,"_28497":125576,"_3084":125654},[],"Participante",{"_3634":74613,"_31331":74580,"_21707":125656,"_5":14945,"_28497":125576,"_3084":125657},[],"Responsabilidad",{"_3634":74614,"_31331":74580,"_21707":125659,"_5":14945,"_28497":125576,"_3084":125660},[],"Administrador PKI",{"_3634":74615,"_31331":74580,"_21707":125662,"_5":14945,"_28497":125576,"_3084":125663},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3634":74616,"_31331":74580,"_21707":125665,"_5":14945,"_28497":125576,"_3084":125666},[],"Administrador del aprovisionamiento",{"_3634":74617,"_31331":74580,"_21707":125668,"_5":14945,"_28497":125576,"_3084":125669},[],"DMS, admisión, autenticación por operación e inventario.",{"_3634":74618,"_31331":74580,"_21707":125671,"_5":14945,"_28497":125576,"_3084":125672},[],"Integrador del dispositivo",{"_3634":74619,"_31331":74580,"_21707":125674,"_5":14945,"_28497":125576,"_3084":125675},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3634":74620,"_31331":74580,"_21707":125677,"_5":14945,"_28497":125576,"_3084":125678},[],"Integrador del consumidor",{"_3634":74621,"_31331":74580,"_21707":125680,"_5":14945,"_28497":125576,"_3084":125681},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3634":74622,"_31331":74580,"_21707":125683,"_5":14945,"_28497":125576,"_3084":125684},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3634":74623,"_31331":74623,"_5":15305,"_3084":125686,"_31690":125687,"_21707":125689,"_28497":74623},"Enrola y conecta tu primer dispositivo",[51145,122216,53829,125688],"Primeros pasos",[],{"_3634":74624,"_31331":74623,"_21707":125691,"_5":14945,"_28497":74623,"_3084":125692},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3634":74625,"_31331":74623,"_5":31687,"_21707":125694,"_28497":125695,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3634":74626,"_31331":74623,"_5":31687,"_21707":125697,"_28497":125698,"_3084":125699},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3634":74627,"_31331":74623,"_5":31687,"_21707":125701,"_28497":125702,"_3084":125703},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3634":74628,"_31331":74623,"_5":31687,"_21707":125705,"_28497":125706,"_3084":125707},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3634":74629,"_31331":74623,"_5":31687,"_21707":125709,"_28497":125710,"_3084":125711},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3634":74630,"_31331":74623,"_5":31687,"_21707":125713,"_28497":125714,"_3084":125715},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3634":74631,"_31331":74623,"_5":31687,"_21707":125717,"_28497":125718,"_3084":125719},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3634":74632,"_31331":74623,"_5":31687,"_21707":125721,"_28497":125722,"_3084":125723},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3634":74633,"_31331":74623,"_21707":125725,"_5":14945,"_28497":74623,"_3084":125726},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3634":74634,"_31331":74623,"_21707":125728,"_5":14945,"_28497":125695,"_3084":125729},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3634":74635,"_31331":74623,"_21707":125731,"_5":14945,"_28497":125695,"_3084":125732},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3634":74636,"_31331":74623,"_21707":125734,"_5":14945,"_28497":125695,"_3084":125735},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3634":74637,"_31331":74623,"_21707":125737,"_5":14945,"_28497":125695,"_3084":125738},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3634":74638,"_31331":74623,"_21707":125740,"_5":14945,"_28497":125695,"_3084":125741},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3634":74639,"_31331":74623,"_21707":125743,"_5":14945,"_28497":125698,"_3084":125744},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3634":74640,"_31331":74623,"_21707":125746,"_5":14945,"_28497":125698,"_3084":125747},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3634":74641,"_31331":74623,"_21707":125749,"_5":14945,"_28497":125702,"_3084":125750},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3634":74642,"_31331":74623,"_21707":125752,"_5":14945,"_28497":125702,"_3084":125753},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3634":74643,"_31331":74623,"_21707":125755,"_5":14945,"_28497":125702,"_3084":125756},[],"Ajuste",{"_3634":74644,"_31331":74623,"_21707":125758,"_5":14945,"_28497":125702,"_3084":125759},[],"Valor de evaluación",{"_3634":74645,"_31331":74623,"_21707":125761,"_5":14945,"_28497":125702,"_3084":56342},[],{"_3634":74646,"_31331":74623,"_21707":125763,"_5":14945,"_28497":125702,"_3084":125764},[],"Raíz emisora de `device-root.pem`.",{"_3634":74647,"_31331":74623,"_21707":125766,"_5":14945,"_28497":125702,"_3084":123673},[],{"_3634":74648,"_31331":74623,"_21707":125768,"_5":14945,"_28497":125702,"_3084":125769},[],"Perfil final de 1 hora que acabas de preparar.",{"_3634":74649,"_31331":74623,"_21707":125771,"_5":14945,"_28497":125702,"_3084":56353},[],{"_3634":74650,"_31331":74623,"_21707":125773,"_5":14945,"_28497":125702,"_3084":56356},[],{"_3634":74651,"_31331":74623,"_21707":125775,"_5":14945,"_28497":125702,"_3084":56359},[],{"_3634":74652,"_31331":74623,"_21707":125777,"_5":14945,"_28497":125702,"_3084":125778},[],"Habilitado.",{"_3634":74653,"_31331":74623,"_21707":125780,"_5":14945,"_28497":125702,"_3084":56365},[],{"_3634":74654,"_31331":74623,"_21707":125782,"_5":14945,"_28497":125702,"_3084":125783},[],"Deshabilitado; el ID debe ser nuevo.",{"_3634":74655,"_31331":74623,"_21707":125785,"_5":14945,"_28497":125702,"_3084":125786},[],"Autenticación inicial",{"_3634":74656,"_31331":74623,"_21707":125788,"_5":14945,"_28497":125702,"_3084":125789},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3634":74657,"_31331":74623,"_21707":125791,"_5":14945,"_28497":125702,"_3084":125792},[],"Autenticación de renovación",{"_3634":74658,"_31331":74623,"_21707":125794,"_5":14945,"_28497":125702,"_3084":125795},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3634":74659,"_31331":74623,"_21707":125797,"_5":14945,"_28497":125702,"_3084":56383},[],{"_3634":74660,"_31331":74623,"_21707":125799,"_5":14945,"_28497":125702,"_3084":125800},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3634":74661,"_31331":74623,"_21707":125802,"_5":14945,"_28497":125702,"_3084":56389},[],{"_3634":74662,"_31331":74623,"_21707":125804,"_5":14945,"_28497":125702,"_3084":125805},[],"1 hora.",{"_3634":74663,"_31331":74623,"_21707":125807,"_5":14945,"_28497":125702,"_3084":56395},[],{"_3634":74664,"_31331":74623,"_21707":125809,"_5":14945,"_28497":125702,"_3084":125810},[],"30 minutos / 10 minutos.",{"_3634":74665,"_31331":74623,"_21707":125812,"_5":14945,"_28497":125702,"_3084":56401},[],{"_3634":74666,"_31331":74623,"_21707":125814,"_5":14945,"_28497":125702,"_3084":125815},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3634":74667,"_31331":74623,"_21707":125817,"_5":14945,"_28497":125702,"_3084":54157},[],{"_3634":74668,"_31331":74623,"_21707":125819,"_5":14945,"_28497":125702,"_3084":125820},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3634":74669,"_31331":74623,"_21707":125822,"_5":14945,"_28497":125702,"_3084":56412},[],{"_3634":74670,"_31331":74623,"_21707":125824,"_5":14945,"_28497":125702,"_3084":125825},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3634":74671,"_31331":74623,"_21707":125827,"_5":14945,"_28497":125702,"_3084":125828},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3634":74672,"_31331":74623,"_21707":125830,"_5":14945,"_28497":125706,"_3084":125831},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3634":74673,"_31331":74623,"_21707":125833,"_5":14945,"_28497":125706,"_3084":125834},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3634":74674,"_31331":74623,"_21707":125836,"_5":14945,"_28497":125710,"_3084":125837},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3634":74675,"_31331":74623,"_21707":125839,"_5":14945,"_28497":125710,"_3084":125840},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3634":74676,"_31331":74623,"_21707":125842,"_5":14945,"_28497":125710,"_3084":125843},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3634":74677,"_31331":74623,"_21707":125845,"_5":14945,"_28497":125714,"_3084":125846},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3634":74678,"_31331":74623,"_21707":125848,"_5":14945,"_28497":125714,"_3084":125849},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3634":74679,"_31331":74623,"_21707":125851,"_5":14945,"_28497":125718,"_3084":125852},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3634":74680,"_31331":74623,"_21707":125854,"_5":14945,"_28497":125718,"_3084":125855},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3634":74681,"_31331":74623,"_21707":125857,"_5":14945,"_28497":125718,"_3084":125858},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3634":74682,"_31331":74623,"_21707":125860,"_5":14945,"_28497":125718,"_3084":125861},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3634":74683,"_31331":74623,"_21707":125863,"_5":14945,"_28497":125718,"_3084":125864},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3634":74684,"_31331":74623,"_21707":125866,"_5":14945,"_28497":125722,"_3084":125867},[],"Comprobación",{"_3634":74685,"_31331":74623,"_21707":125869,"_5":14945,"_28497":125722,"_3084":125870},[],"Resultado esperado",{"_3634":74686,"_31331":74623,"_21707":125872,"_5":14945,"_28497":125722,"_3084":125873},[],"Registro",{"_3634":74687,"_31331":74623,"_21707":125875,"_5":14945,"_28497":125722,"_3084":125876},[],"ID creado automáticamente y DMS correcto.",{"_3634":74688,"_31331":74623,"_21707":125878,"_5":14945,"_28497":125722,"_3084":125163},[],{"_3634":74689,"_31331":74623,"_21707":125880,"_5":14945,"_28497":125722,"_3084":125881},[],"CN, perfil, serie y clave verificados.",{"_3634":74690,"_31331":74623,"_21707":125883,"_5":14945,"_28497":125722,"_3084":125884},[],"Inventario",{"_3634":74691,"_31331":74623,"_21707":125886,"_5":14945,"_28497":125722,"_3084":125887},[],"Serie recibida visible como identidad actual y en el historial.",{"_3634":74692,"_31331":74623,"_21707":125889,"_5":14945,"_28497":125722,"_3084":125890},[],"Consumidor",{"_3634":74693,"_31331":74623,"_21707":125892,"_5":14945,"_28497":125722,"_3084":125893},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3634":74694,"_31331":74623,"_21707":125895,"_5":14945,"_28497":125722,"_3084":125896},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3634":74695,"_31331":74623,"_21707":125898,"_5":14945,"_28497":125722,"_3084":125899},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3634":74696,"_31331":74696,"_5":15305,"_3084":123378,"_31690":125901,"_21707":125902,"_28497":74696},[51145,122216,53829,125688],[],{"_3634":74697,"_31331":74696,"_21707":125904,"_5":14945,"_28497":74696,"_3084":125905},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3634":74698,"_31331":74696,"_5":31687,"_21707":125907,"_28497":125908,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3634":74699,"_31331":74696,"_5":31687,"_21707":125910,"_28497":125911,"_3084":125912},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3634":74700,"_31331":74696,"_5":31687,"_21707":125914,"_28497":125915,"_3084":125916},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3634":74701,"_31331":74696,"_5":31687,"_21707":125918,"_28497":125919,"_3084":125920},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3634":74702,"_31331":74696,"_5":31687,"_21707":125922,"_28497":125923,"_3084":125924},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3634":74703,"_31331":74696,"_5":31687,"_21707":125926,"_28497":125927,"_3084":125928},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3634":74704,"_31331":74696,"_5":31687,"_21707":125930,"_28497":125931,"_3084":125870},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3634":74705,"_31331":74696,"_5":31687,"_21707":125933,"_28497":125934,"_3084":125935},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3634":74706,"_31331":74696,"_5":31687,"_21707":125937,"_28497":125938,"_3084":125939},[],"/docs/pr-preview/pr-81/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3634":74707,"_31331":74696,"_21707":125941,"_5":14945,"_28497":74696,"_3084":125942},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3634":74708,"_31331":74696,"_21707":125944,"_5":14945,"_28497":74696,"_3084":125945},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3634":74709,"_31331":74696,"_21707":125947,"_5":14945,"_28497":125908,"_3084":125948},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3634":74710,"_31331":74696,"_21707":125950,"_5":14945,"_28497":125908,"_3084":125951},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3634":74711,"_31331":74696,"_21707":125953,"_5":14945,"_28497":125908,"_3084":125954},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3634":74712,"_31331":74696,"_21707":125956,"_5":14945,"_28497":125908,"_3084":125957},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3634":74713,"_31331":74696,"_21707":125959,"_5":14945,"_28497":125911,"_3084":125960},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3634":74714,"_31331":74696,"_21707":125962,"_5":14945,"_28497":125911,"_3084":125963},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3634":74715,"_31331":74696,"_21707":125965,"_5":14945,"_28497":125911,"_3084":125966},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3634":74716,"_31331":74696,"_21707":125968,"_5":14945,"_28497":125911,"_3084":125969},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3634":74717,"_31331":74696,"_21707":125971,"_5":14945,"_28497":125911,"_3084":125972},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3634":74718,"_31331":74696,"_21707":125974,"_5":14945,"_28497":125911,"_3084":125975},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3634":74719,"_31331":74696,"_21707":125977,"_5":14945,"_28497":125911,"_3084":125978},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3634":74720,"_31331":74696,"_21707":125980,"_5":14945,"_28497":125911,"_3084":125981},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3634":74721,"_31331":74696,"_21707":125983,"_5":14945,"_28497":125915,"_3084":125984},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3634":74722,"_31331":74696,"_21707":125986,"_5":14945,"_28497":125915,"_3084":56577},[],{"_3634":74723,"_31331":74696,"_21707":125988,"_5":14945,"_28497":125915,"_3084":125989},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3634":74724,"_31331":74696,"_21707":125991,"_5":14945,"_28497":125915,"_3084":125992},[],"**Icon** y **Tags**: clasificación opcional.",{"_3634":74725,"_31331":74696,"_21707":125994,"_5":14945,"_28497":125915,"_3084":125995},[],"Confirma el registro.",{"_3634":74726,"_31331":74696,"_21707":125997,"_5":14945,"_28497":125919,"_3084":125998},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3634":74727,"_31331":74696,"_21707":126000,"_5":14945,"_28497":125919,"_3084":126001},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3634":74728,"_31331":74696,"_21707":126003,"_5":14945,"_28497":125923,"_3084":126004},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3634":74729,"_31331":74696,"_21707":126006,"_5":14945,"_28497":125923,"_3084":126007},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3634":74730,"_31331":74696,"_21707":126009,"_5":14945,"_28497":125927,"_3084":126010},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3634":74731,"_31331":74696,"_21707":126012,"_5":14945,"_28497":125927,"_3084":126013},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3634":74732,"_31331":74696,"_21707":126015,"_5":14945,"_28497":125931,"_3084":125867},[],{"_3634":74733,"_31331":74696,"_21707":126017,"_5":14945,"_28497":125931,"_3084":126018},[],"Resultado",{"_3634":74734,"_31331":74696,"_21707":126020,"_5":14945,"_28497":125931,"_3084":125149},[],{"_3634":74735,"_31331":74696,"_21707":126022,"_5":14945,"_28497":125931,"_3084":126023},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3634":74736,"_31331":74696,"_21707":126025,"_5":14945,"_28497":125931,"_3084":126026},[],"Identidad actual",{"_3634":74737,"_31331":74696,"_21707":126028,"_5":14945,"_28497":125931,"_3084":126029},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3634":74738,"_31331":74696,"_21707":126031,"_5":14945,"_28497":125931,"_3084":126032},[],"Historial",{"_3634":74739,"_31331":74696,"_21707":126034,"_5":14945,"_28497":125931,"_3084":126035},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3634":74740,"_31331":74696,"_21707":126037,"_5":14945,"_28497":125931,"_3084":126038},[],"Clave y certificado",{"_3634":74741,"_31331":74696,"_21707":126040,"_5":14945,"_28497":125931,"_3084":126041},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3634":74742,"_31331":74696,"_21707":126043,"_5":14945,"_28497":125934,"_3084":126044},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3634":74743,"_31331":74696,"_21707":126046,"_5":14945,"_28497":125934,"_3084":126047},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3634":74744,"_31331":74696,"_21707":126049,"_5":14945,"_28497":125934,"_3084":126050},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3634":74745,"_31331":74696,"_21707":126052,"_5":14945,"_28497":125934,"_3084":126053},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3634":74746,"_31331":74696,"_21707":126055,"_5":14945,"_28497":125938,"_3084":126056},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3634":74747,"_31331":74696,"_21707":126058,"_5":14945,"_28497":125938,"_3084":126059},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3634":74748,"_31331":74696,"_21707":126061,"_5":14945,"_28497":125938,"_3084":126062},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3634":74749,"_31331":74749,"_5":15305,"_3084":126064,"_31690":126065,"_21707":126066,"_28497":74749},"Plataforma Lamassu IoT",[51145,122216],[],{"_3634":74750,"_31331":74749,"_21707":126068,"_5":14945,"_28497":74749,"_3084":126069},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3634":74751,"_31331":74749,"_5":31687,"_21707":126071,"_28497":126072,"_3084":125564},[],"/docs/pr-preview/pr-81/es/platform/overview#empieza-aquí",{"_3634":74752,"_31331":74749,"_5":31687,"_21707":126074,"_28497":126075,"_3084":126076},[],"/docs/pr-preview/pr-81/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3634":74753,"_31331":74749,"_5":31687,"_21707":126078,"_28497":126079,"_3084":126080},[],"/docs/pr-preview/pr-81/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3634":74754,"_31331":74749,"_5":31687,"_21707":126082,"_28497":126083,"_3084":126084},[],"/docs/pr-preview/pr-81/es/platform/overview#capacidades-principales","Capacidades principales",{"_3634":74755,"_31331":74749,"_5":31687,"_21707":126086,"_28497":126087,"_3084":126088},[],"/docs/pr-preview/pr-81/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3634":74756,"_31331":74749,"_5":31687,"_21707":126090,"_28497":126091,"_3084":126092},[],"/docs/pr-preview/pr-81/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3634":74757,"_31331":74749,"_5":31687,"_21707":126094,"_28497":126095,"_3084":126096},[],"/docs/pr-preview/pr-81/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3634":74758,"_31331":74749,"_5":31687,"_21707":126098,"_28497":126099,"_3084":126100},[],"/docs/pr-preview/pr-81/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3634":74759,"_31331":74749,"_5":31687,"_21707":126102,"_28497":126103,"_3084":126104},[],"/docs/pr-preview/pr-81/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3634":74760,"_31331":74749,"_5":31687,"_21707":126106,"_28497":126107,"_3084":126108},[],"/docs/pr-preview/pr-81/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3634":74761,"_31331":74749,"_5":31687,"_21707":126110,"_28497":126111,"_3084":126112},[],"/docs/pr-preview/pr-81/es/platform/overview#referencia-operativa","Referencia operativa",{"_3634":74762,"_31331":74749,"_21707":126114,"_5":14945,"_28497":74749,"_3084":126115},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3634":74763,"_31331":74749,"_21707":126117,"_5":14945,"_28497":126072,"_3084":126118},[],"Elige el resultado que necesitas obtener:",{"_3634":74764,"_31331":74749,"_21707":126120,"_5":14945,"_28497":126072,"_3084":126121},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":74765,"_31331":74749,"_21707":126123,"_5":14945,"_28497":126072,"_3084":126124},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":74766,"_31331":74749,"_21707":126126,"_5":14945,"_28497":126072,"_3084":126127},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3634":74767,"_31331":74749,"_21707":126129,"_5":14945,"_28497":126075,"_3084":126130},[],"Bloque",{"_3634":74768,"_31331":74749,"_21707":126132,"_5":14945,"_28497":126075,"_3084":126133},[],"Qué gestionas",{"_3634":74769,"_31331":74749,"_21707":126135,"_5":14945,"_28497":126075,"_3084":126136},[],"Punto de entrada",{"_3634":74770,"_31331":74749,"_21707":126138,"_5":14945,"_28497":126075,"_3084":56730},[],{"_3634":74771,"_31331":74749,"_21707":126140,"_5":14945,"_28497":126075,"_3084":126141},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3634":74772,"_31331":74749,"_21707":126143,"_5":14945,"_28497":126075,"_3084":126144},[],"Visión general de PKI",{"_3634":74773,"_31331":74749,"_21707":126146,"_5":14945,"_28497":126075,"_3084":56739},[],{"_3634":74774,"_31331":74749,"_21707":126148,"_5":14945,"_28497":126075,"_3084":126149},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3634":74775,"_31331":74749,"_21707":126151,"_5":14945,"_28497":126075,"_3084":126152},[],"Visión general de IoT Fleets",{"_3634":74776,"_31331":74749,"_21707":126154,"_5":14945,"_28497":126075,"_3084":126155},[],"**Administración**",{"_3634":74777,"_31331":74749,"_21707":126157,"_5":14945,"_28497":126075,"_3084":126158},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3634":74778,"_31331":74749,"_21707":126160,"_5":14945,"_28497":126075,"_3084":122218},[],{"_3634":74779,"_31331":74749,"_21707":126162,"_5":14945,"_28497":126075,"_3084":126163},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3634":74780,"_31331":74749,"_21707":126165,"_5":14945,"_28497":126079,"_3084":126166},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3634":74781,"_31331":74749,"_21707":126168,"_5":14945,"_28497":126079,"_3084":126169},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3634":74782,"_31331":74749,"_21707":126171,"_5":14945,"_28497":126079,"_3084":126172},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3634":74783,"_31331":74749,"_21707":126174,"_5":14945,"_28497":126079,"_3084":126175},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3634":74784,"_31331":74749,"_21707":126177,"_5":14945,"_28497":126079,"_3084":126178},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3634":74785,"_31331":74749,"_21707":126180,"_5":14945,"_28497":126079,"_3084":126181},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3634":74786,"_31331":74749,"_21707":126183,"_5":14945,"_28497":126087,"_3084":126184},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3634":74787,"_31331":74749,"_21707":126186,"_5":14945,"_28497":126091,"_3084":126187},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3634":74788,"_31331":74749,"_21707":126189,"_5":14945,"_28497":126095,"_3084":126190},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3634":74789,"_31331":74749,"_21707":126192,"_5":14945,"_28497":126099,"_3084":126193},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3634":74790,"_31331":74749,"_21707":126195,"_5":14945,"_28497":126103,"_3084":126196},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3634":74791,"_31331":74749,"_21707":126198,"_5":14945,"_28497":126107,"_3084":126199},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3634":74792,"_31331":74749,"_21707":126201,"_5":14945,"_28497":126111,"_3084":125657},[],{"_3634":74793,"_31331":74749,"_21707":126203,"_5":14945,"_28497":126111,"_3084":126204},[],"Qué prepara o comprueba",{"_3634":74794,"_31331":74749,"_21707":126206,"_5":14945,"_28497":126111,"_3084":125660},[],{"_3634":74795,"_31331":74749,"_21707":126208,"_5":14945,"_28497":126111,"_3084":126209},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3634":74796,"_31331":74749,"_21707":126211,"_5":14945,"_28497":126111,"_3084":126212},[],"Administrador de la flota",{"_3634":74797,"_31331":74749,"_21707":126214,"_5":14945,"_28497":126111,"_3084":126215},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3634":74798,"_31331":74749,"_21707":126217,"_5":14945,"_28497":126111,"_3084":125672},[],{"_3634":74799,"_31331":74749,"_21707":126219,"_5":14945,"_28497":126111,"_3084":126220},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3634":74800,"_31331":74749,"_21707":126222,"_5":14945,"_28497":126111,"_3084":125678},[],{"_3634":74801,"_31331":74749,"_21707":126224,"_5":14945,"_28497":126111,"_3084":126225},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3634":74802,"_31331":74749,"_21707":126227,"_5":14945,"_28497":126111,"_3084":126228},[],"Operador de infraestructura",{"_3634":74803,"_31331":74749,"_21707":126230,"_5":14945,"_28497":126111,"_3084":126231},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3634":74804,"_31331":74749,"_21707":126233,"_5":14945,"_28497":126111,"_3084":126234},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3634":74805,"_31331":74805,"_5":15305,"_3084":126236,"_31690":126237,"_21707":126239,"_28497":74805},"Jerarquía y rotación de CAs",[51145,122216,56831,126238],"Claves, autoridades y certificados",[],{"_3634":74806,"_31331":74805,"_21707":126241,"_5":14945,"_28497":74805,"_3084":126242},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3634":74807,"_31331":74805,"_5":31687,"_21707":126244,"_28497":126245,"_3084":126246},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3634":74808,"_31331":74805,"_5":31687,"_21707":126248,"_28497":126249,"_3084":126250},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3634":74809,"_31331":74805,"_5":31687,"_21707":126252,"_28497":126253,"_3084":126254},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3634":74810,"_31331":74805,"_5":31687,"_21707":126256,"_28497":126257,"_3084":126258},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3634":74811,"_31331":74805,"_5":31687,"_21707":126260,"_28497":126261,"_3084":126262},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3634":74812,"_31331":74805,"_5":31687,"_21707":126264,"_28497":126265,"_3084":126266},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3634":74813,"_31331":74805,"_5":31687,"_21707":126268,"_28497":126269,"_3084":126270},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3634":74814,"_31331":74805,"_5":31687,"_21707":126272,"_28497":126273,"_3084":126274},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3634":74815,"_31331":74805,"_5":31687,"_21707":126276,"_28497":126277,"_3084":126278},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3634":74816,"_31331":74805,"_5":31687,"_21707":126280,"_28497":126281,"_3084":126282},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3634":74817,"_31331":74805,"_5":31687,"_21707":126284,"_28497":126285,"_3084":126286},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3634":74818,"_31331":74805,"_5":31687,"_21707":126288,"_28497":126289,"_3084":126290},[],"/docs/pr-preview/pr-81/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3634":74819,"_31331":74805,"_21707":126292,"_5":14945,"_28497":74805,"_3084":126293},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3634":74820,"_31331":74805,"_21707":126295,"_5":14945,"_28497":74805,"_3084":126296},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3634":74821,"_31331":74805,"_21707":126298,"_5":14945,"_28497":126245,"_3084":126299},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3634":74822,"_31331":74805,"_21707":126301,"_5":14945,"_28497":126245,"_3084":126302},[],"entorno, como producción y preproducción;",{"_3634":74823,"_31331":74805,"_21707":126304,"_5":14945,"_28497":126245,"_3084":126305},[],"propietario o equipo operador;",{"_3634":74824,"_31331":74805,"_21707":126307,"_5":14945,"_28497":126245,"_3084":126308},[],"familia de dispositivos o proceso de fabricación;",{"_3634":74825,"_31331":74805,"_21707":126310,"_5":14945,"_28497":126245,"_3084":126311},[],"región o requisito regulatorio;",{"_3634":74826,"_31331":74805,"_21707":126313,"_5":14945,"_28497":126245,"_3084":126314},[],"motor criptográfico o política de clave;",{"_3634":74827,"_31331":74805,"_21707":126316,"_5":14945,"_28497":126245,"_3084":126317},[],"ventana de mantenimiento y ritmo de renovación.",{"_3634":74828,"_31331":74805,"_21707":126319,"_5":14945,"_28497":126245,"_3084":126320},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3634":74829,"_31331":74805,"_21707":126322,"_5":14945,"_28497":126245,"_3084":126323},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3634":74830,"_31331":74805,"_21707":126325,"_5":14945,"_28497":126249,"_3084":126326},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3634":74831,"_31331":74805,"_21707":126328,"_5":14945,"_28497":126249,"_3084":126329},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3634":74832,"_31331":74805,"_21707":126331,"_5":14945,"_28497":126249,"_3084":126332},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3634":74833,"_31331":74805,"_21707":126334,"_5":14945,"_28497":126249,"_3084":126335},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3634":74834,"_31331":74805,"_21707":126337,"_5":14945,"_28497":126253,"_3084":126338},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3634":74835,"_31331":74805,"_21707":126340,"_5":14945,"_28497":126253,"_3084":126341},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3634":74836,"_31331":74805,"_21707":126343,"_5":14945,"_28497":126253,"_3084":126344},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3634":74837,"_31331":74805,"_21707":126346,"_5":14945,"_28497":126253,"_3084":126347},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3634":74838,"_31331":74805,"_21707":126349,"_5":14945,"_28497":126261,"_3084":126350},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3634":74839,"_31331":74805,"_21707":126352,"_5":14945,"_28497":126265,"_3084":126353},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3634":74840,"_31331":74805,"_21707":126355,"_5":14945,"_28497":126269,"_3084":126356},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3634":74841,"_31331":74805,"_21707":126358,"_5":14945,"_28497":126273,"_3084":126359},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3634":74842,"_31331":74805,"_21707":126361,"_5":14945,"_28497":126277,"_3084":126362},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3634":74843,"_31331":74805,"_21707":126364,"_5":14945,"_28497":126281,"_3084":126365},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3634":74844,"_31331":74805,"_21707":126367,"_5":14945,"_28497":126285,"_3084":126368},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3634":74845,"_31331":74805,"_21707":126370,"_5":14945,"_28497":126285,"_3084":126371},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3634":74846,"_31331":74805,"_21707":126373,"_5":14945,"_28497":126285,"_3084":126374},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3634":74847,"_31331":74805,"_21707":126376,"_5":14945,"_28497":126285,"_3084":126377},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3634":74848,"_31331":74805,"_21707":126379,"_5":14945,"_28497":126289,"_3084":126380},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3634":74849,"_31331":74805,"_21707":126382,"_5":14945,"_28497":126289,"_3084":126383},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3634":74850,"_31331":74805,"_21707":126385,"_5":14945,"_28497":126289,"_3084":126386},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3634":74851,"_31331":74805,"_21707":126388,"_5":14945,"_28497":126289,"_3084":126389},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3634":74852,"_31331":74805,"_21707":126391,"_5":14945,"_28497":126289,"_3084":126392},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3634":74853,"_31331":74805,"_21707":126394,"_5":14945,"_28497":126289,"_3084":126395},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3634":74854,"_31331":74805,"_21707":126397,"_5":14945,"_28497":126289,"_3084":126398},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3634":74855,"_31331":74855,"_5":15305,"_3084":126400,"_31690":126401,"_21707":126402,"_28497":74855},"Autoridades de certificación",[51145,122216,56831,126238],[],{"_3634":74856,"_31331":74855,"_21707":126404,"_5":14945,"_28497":74855,"_3084":126405},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3634":74857,"_31331":74855,"_5":31687,"_21707":126407,"_28497":126408,"_3084":126409},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3634":74858,"_31331":74855,"_5":31687,"_21707":126411,"_28497":126412,"_3084":126413},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3634":74859,"_31331":74855,"_5":31687,"_21707":126415,"_28497":126416,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3634":74860,"_31331":74855,"_5":31687,"_21707":126418,"_28497":126419,"_3084":126420},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3634":74861,"_31331":74855,"_5":31687,"_21707":126422,"_28497":126423,"_3084":126424},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3634":74862,"_31331":74855,"_5":31687,"_21707":126426,"_28497":126427,"_3084":126428},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3634":74863,"_31331":74855,"_5":31687,"_21707":126430,"_28497":126431,"_3084":126432},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3634":74864,"_31331":74855,"_5":31687,"_21707":126434,"_28497":126435,"_3084":126436},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3634":74865,"_31331":74855,"_5":31687,"_21707":126438,"_28497":126439,"_3084":126440},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3634":74866,"_31331":74855,"_5":31687,"_21707":126442,"_28497":126443,"_3084":126444},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3634":74867,"_31331":74855,"_5":31687,"_21707":126446,"_28497":126447,"_3084":126448},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3634":74868,"_31331":74855,"_5":31687,"_21707":126450,"_28497":126451,"_3084":126452},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3634":74869,"_31331":74855,"_5":31687,"_21707":126454,"_28497":126455,"_3084":126456},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3634":74870,"_31331":74855,"_5":31687,"_21707":126458,"_28497":126459,"_3084":126460},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3634":74871,"_31331":74855,"_5":31687,"_21707":126462,"_28497":126463,"_3084":126464},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3634":74872,"_31331":74855,"_5":31687,"_21707":126466,"_28497":126467,"_3084":126468},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3634":74873,"_31331":74855,"_5":31687,"_21707":126470,"_28497":126471,"_3084":126472},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3634":74874,"_31331":74855,"_5":31687,"_21707":126474,"_28497":126475,"_3084":126476},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3634":74875,"_31331":74855,"_5":31687,"_21707":126478,"_28497":126479,"_3084":126480},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3634":74876,"_31331":74855,"_5":31687,"_21707":126482,"_28497":126483,"_3084":126484},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3634":74877,"_31331":74855,"_5":31687,"_21707":126486,"_28497":126487,"_3084":126488},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3634":74878,"_31331":74855,"_5":31687,"_21707":126490,"_28497":126491,"_3084":126492},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3634":74879,"_31331":74855,"_5":31687,"_21707":126494,"_28497":126495,"_3084":126496},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3634":74880,"_31331":74855,"_5":31687,"_21707":126498,"_28497":126499,"_3084":126500},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3634":74881,"_31331":74855,"_21707":126502,"_5":14945,"_28497":74855,"_3084":126503},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3634":74882,"_31331":74855,"_21707":126505,"_5":14945,"_28497":74855,"_3084":126506},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3634":74883,"_31331":74855,"_21707":126508,"_5":14945,"_28497":74855,"_3084":126509},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3634":74884,"_31331":74855,"_21707":126511,"_5":14945,"_28497":126408,"_3084":126512},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3634":74885,"_31331":74855,"_21707":126514,"_5":14945,"_28497":126408,"_3084":126515},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3634":74886,"_31331":74855,"_21707":126517,"_5":14945,"_28497":126408,"_3084":126518},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3634":74887,"_31331":74855,"_21707":126520,"_5":14945,"_28497":126408,"_3084":126521},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3634":74888,"_31331":74855,"_21707":126523,"_5":14945,"_28497":126408,"_3084":126524},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3634":74889,"_31331":74855,"_21707":126526,"_5":14945,"_28497":126416,"_3084":126527},[],"Decide si la CA será raíz o intermedia.",{"_3634":74890,"_31331":74855,"_21707":126529,"_5":14945,"_28497":126416,"_3084":126530},[],"Elige el motor que custodiará la clave.",{"_3634":74891,"_31331":74855,"_21707":126532,"_5":14945,"_28497":126416,"_3084":126533},[],"Define una validez superior a la de los certificados que emitirá.",{"_3634":74892,"_31331":74855,"_21707":126535,"_5":14945,"_28497":126416,"_3084":126536},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3634":74893,"_31331":74855,"_21707":126538,"_5":14945,"_28497":126419,"_3084":126539},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3634":74894,"_31331":74855,"_21707":126541,"_5":14945,"_28497":126423,"_3084":126542},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3634":74895,"_31331":74855,"_21707":126544,"_5":14945,"_28497":126423,"_3084":126545},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3634":74896,"_31331":74855,"_21707":126547,"_5":14945,"_28497":126427,"_3084":126548},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3634":74897,"_31331":74855,"_21707":126550,"_5":14945,"_28497":126431,"_3084":126551},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3634":74898,"_31331":74855,"_21707":126553,"_5":14945,"_28497":126431,"_3084":126554},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3634":74899,"_31331":74855,"_21707":126556,"_5":14945,"_28497":126431,"_3084":126557},[],"`ST`: estado o provincia.",{"_3634":74900,"_31331":74855,"_21707":126559,"_5":14945,"_28497":126431,"_3084":126560},[],"`L`: localidad.",{"_3634":74901,"_31331":74855,"_21707":126562,"_5":14945,"_28497":126431,"_3084":126563},[],"`O`: organización.",{"_3634":74902,"_31331":74855,"_21707":126565,"_5":14945,"_28497":126431,"_3084":126566},[],"`OU`: unidad organizativa.",{"_3634":74903,"_31331":74855,"_21707":126568,"_5":14945,"_28497":126431,"_3084":126569},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3634":74904,"_31331":74855,"_21707":126571,"_5":14945,"_28497":126435,"_3084":126572},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3634":74905,"_31331":74855,"_21707":126574,"_5":14945,"_28497":126435,"_3084":126575},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3634":74906,"_31331":74855,"_21707":126577,"_5":14945,"_28497":126439,"_3084":126578},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3634":74907,"_31331":74855,"_21707":126580,"_5":14945,"_28497":126439,"_3084":126581},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3634":74908,"_31331":74855,"_21707":126583,"_5":14945,"_28497":126443,"_3084":126584},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3634":74909,"_31331":74855,"_21707":126586,"_5":14945,"_28497":126443,"_3084":126587},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3634":74910,"_31331":74855,"_21707":126589,"_5":14945,"_28497":126447,"_3084":126590},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3634":74911,"_31331":74855,"_21707":126592,"_5":14945,"_28497":126447,"_3084":126593},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3634":74912,"_31331":74855,"_21707":126595,"_5":14945,"_28497":126447,"_3084":126596},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3634":74913,"_31331":74855,"_21707":126598,"_5":14945,"_28497":126447,"_3084":126599},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3634":74914,"_31331":74855,"_21707":126601,"_5":14945,"_28497":126451,"_3084":126602},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3634":74915,"_31331":74855,"_21707":126604,"_5":14945,"_28497":126455,"_3084":126605},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3634":74916,"_31331":74855,"_21707":126607,"_5":14945,"_28497":126455,"_3084":126608},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3634":74917,"_31331":74855,"_21707":126610,"_5":14945,"_28497":126459,"_3084":126611},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3634":74918,"_31331":74855,"_21707":126613,"_5":14945,"_28497":126463,"_3084":126614},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3634":74919,"_31331":74855,"_21707":126616,"_5":14945,"_28497":126463,"_3084":126617},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3634":74920,"_31331":74855,"_21707":126619,"_5":14945,"_28497":126463,"_3084":126620},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3634":74921,"_31331":74855,"_21707":126622,"_5":14945,"_28497":126467,"_3084":126623},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3634":74922,"_31331":74855,"_21707":126625,"_5":14945,"_28497":126467,"_3084":126626},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3634":74923,"_31331":74855,"_21707":126628,"_5":14945,"_28497":126467,"_3084":126629},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3634":74924,"_31331":74855,"_21707":126631,"_5":14945,"_28497":126467,"_3084":126632},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3634":74925,"_31331":74855,"_21707":126634,"_5":14945,"_28497":126471,"_3084":126635},[],"Abre una CA desde el inventario para consultar:",{"_3634":74926,"_31331":74855,"_21707":126637,"_5":14945,"_28497":126471,"_3084":126638},[],"Estado y periodo de validez.",{"_3634":74927,"_31331":74855,"_21707":126640,"_5":14945,"_28497":126471,"_3084":126641},[],"Certificado y cadena en formato PEM.",{"_3634":74928,"_31331":74855,"_21707":126643,"_5":14945,"_28497":126471,"_3084":126644},[],"Número de certificados activos, expirados y revocados.",{"_3634":74929,"_31331":74855,"_21707":126646,"_5":14945,"_28497":126471,"_3084":126647},[],"Certificados emitidos en **Issued Certificates**.",{"_3634":74930,"_31331":74855,"_21707":126649,"_5":14945,"_28497":126471,"_3084":126650},[],"CRL vinculada a la autoridad.",{"_3634":74931,"_31331":74855,"_21707":126652,"_5":14945,"_28497":126471,"_3084":126653},[],"Metadatos y motor criptográfico asociado.",{"_3634":74932,"_31331":74855,"_21707":126655,"_5":14945,"_28497":126471,"_3084":126656},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3634":74933,"_31331":74855,"_21707":126658,"_5":14945,"_28497":126475,"_3084":126659},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3634":74934,"_31331":74855,"_21707":126661,"_5":14945,"_28497":126475,"_3084":126662},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3634":74935,"_31331":74855,"_21707":126664,"_5":14945,"_28497":126475,"_3084":126665},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3634":74936,"_31331":74855,"_21707":126667,"_5":14945,"_28497":126475,"_3084":126668},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3634":74937,"_31331":74855,"_21707":126670,"_5":14945,"_28497":126475,"_3084":126671},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3634":74938,"_31331":74855,"_21707":126673,"_5":14945,"_28497":126475,"_3084":126674},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3634":74939,"_31331":74855,"_21707":126676,"_5":14945,"_28497":126479,"_3084":126677},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3634":74940,"_31331":74855,"_21707":126679,"_5":14945,"_28497":126483,"_3084":126680},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3634":74941,"_31331":74855,"_21707":126682,"_5":14945,"_28497":126487,"_3084":126683},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3634":74942,"_31331":74855,"_21707":126685,"_5":14945,"_28497":126491,"_3084":126686},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3634":74943,"_31331":74855,"_21707":126688,"_5":14945,"_28497":126495,"_3084":126689},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3634":74944,"_31331":74855,"_21707":126691,"_5":14945,"_28497":126499,"_3084":126692},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3634":74945,"_31331":74855,"_21707":126694,"_5":14945,"_28497":126499,"_3084":126695},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3634":74946,"_31331":74855,"_21707":126697,"_5":14945,"_28497":126499,"_3084":126698},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3634":74947,"_31331":74855,"_21707":126700,"_5":14945,"_28497":126499,"_3084":126701},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3634":74948,"_31331":74855,"_21707":126703,"_5":14945,"_28497":126499,"_3084":126704},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3634":74949,"_31331":74949,"_5":15305,"_3084":126706,"_31690":126707,"_21707":126708,"_28497":74949},"Perfiles de certificado",[51145,122216,56831,126238],[],{"_3634":74950,"_31331":74949,"_21707":126710,"_5":14945,"_28497":74949,"_3084":126711},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3634":74951,"_31331":74949,"_5":31687,"_21707":126713,"_28497":126714,"_3084":126715},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3634":74952,"_31331":74949,"_5":31687,"_21707":126717,"_28497":126718,"_3084":126719},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#validez","Validez",{"_3634":74953,"_31331":74949,"_5":31687,"_21707":126721,"_28497":126722,"_3084":126723},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3634":74954,"_31331":74949,"_5":31687,"_21707":126725,"_28497":126726,"_3084":126727},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3634":74955,"_31331":74949,"_5":31687,"_21707":126729,"_28497":126730,"_3084":126731},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3634":74956,"_31331":74949,"_5":31687,"_21707":126733,"_28497":126734,"_3084":126735},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3634":74957,"_31331":74949,"_5":31687,"_21707":126737,"_28497":126738,"_3084":126739},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3634":74958,"_31331":74949,"_5":31687,"_21707":126741,"_28497":126742,"_3084":126743},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3634":74959,"_31331":74949,"_5":31687,"_21707":126745,"_28497":126746,"_3084":126747},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3634":74960,"_31331":74949,"_5":31687,"_21707":126749,"_28497":126750,"_3084":126751},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3634":74961,"_31331":74949,"_5":31687,"_21707":126753,"_28497":126754,"_3084":126755},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3634":74962,"_31331":74949,"_5":31687,"_21707":126757,"_28497":126758,"_3084":126759},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3634":74963,"_31331":74949,"_5":31687,"_21707":126761,"_28497":126762,"_3084":126763},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3634":74964,"_31331":74949,"_5":31687,"_21707":126765,"_28497":126766,"_3084":126767},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3634":74965,"_31331":74949,"_5":31687,"_21707":126769,"_28497":126770,"_3084":126771},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3634":74966,"_31331":74949,"_5":31687,"_21707":126773,"_28497":126774,"_3084":126775},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3634":74967,"_31331":74949,"_21707":126777,"_5":14945,"_28497":74949,"_3084":126778},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3634":74968,"_31331":74949,"_21707":126780,"_5":14945,"_28497":74949,"_3084":126781},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3634":74969,"_31331":74949,"_21707":126783,"_5":14945,"_28497":126718,"_3084":126784},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3634":74970,"_31331":74949,"_21707":126786,"_5":14945,"_28497":126718,"_3084":126787},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3634":74971,"_31331":74949,"_21707":126789,"_5":14945,"_28497":126722,"_3084":126790},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3634":74972,"_31331":74949,"_21707":126792,"_5":14945,"_28497":126726,"_3084":126793},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3634":74973,"_31331":74949,"_21707":126795,"_5":14945,"_28497":126726,"_3084":126796},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3634":74974,"_31331":74949,"_21707":126798,"_5":14945,"_28497":126726,"_3084":126799},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3634":74975,"_31331":74949,"_21707":126801,"_5":14945,"_28497":126730,"_3084":126802},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3634":74976,"_31331":74949,"_21707":126804,"_5":14945,"_28497":126734,"_3084":126805},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3634":74977,"_31331":74949,"_21707":126807,"_5":14945,"_28497":126734,"_3084":126808},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3634":74978,"_31331":74949,"_21707":126810,"_5":14945,"_28497":126738,"_3084":126811},[],"La aplicación criptográfica puede:",{"_3634":74979,"_31331":74949,"_21707":126813,"_5":14945,"_28497":126738,"_3084":126814},[],"permitir o bloquear claves RSA;",{"_3634":74980,"_31331":74949,"_21707":126816,"_5":14945,"_28497":126738,"_3084":126817},[],"limitar los tamaños RSA admitidos;",{"_3634":74981,"_31331":74949,"_21707":126819,"_5":14945,"_28497":126738,"_3084":126820},[],"permitir o bloquear claves ECDSA;",{"_3634":74982,"_31331":74949,"_21707":126822,"_5":14945,"_28497":126738,"_3084":126823},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3634":74983,"_31331":74949,"_21707":126825,"_5":14945,"_28497":126738,"_3084":126826},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3634":74984,"_31331":74949,"_21707":126828,"_5":14945,"_28497":126742,"_3084":126829},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3634":74985,"_31331":74949,"_21707":126831,"_5":14945,"_28497":126742,"_3084":121976},[],{"_3634":74986,"_31331":74949,"_21707":126833,"_5":14945,"_28497":126742,"_3084":126834},[],"Primera opción",{"_3634":74987,"_31331":74949,"_21707":126836,"_5":14945,"_28497":126742,"_3084":126837},[],"Segunda opción",{"_3634":74988,"_31331":74949,"_21707":126839,"_5":14945,"_28497":126742,"_3084":126840},[],"Si no hay ninguna",{"_3634":74989,"_31331":74949,"_21707":126842,"_5":14945,"_28497":126742,"_3084":126843},[],"Firma directa con una CA",{"_3634":74990,"_31331":74949,"_21707":126845,"_5":14945,"_28497":126742,"_3084":126846},[],"`issuance_profile` incluido en la solicitud",{"_3634":74991,"_31331":74949,"_21707":126848,"_5":14945,"_28497":126742,"_3084":126849},[],"`issuance_profile_id` de la solicitud",{"_3634":74992,"_31331":74949,"_21707":126851,"_5":14945,"_28497":126742,"_3084":126852},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3634":74993,"_31331":74949,"_21707":126854,"_5":14945,"_28497":126742,"_3084":126855},[],"Emisión mediante DMS",{"_3634":74994,"_31331":74949,"_21707":126857,"_5":14945,"_28497":126742,"_3084":57452},[],{"_3634":74995,"_31331":74949,"_21707":126859,"_5":14945,"_28497":126742,"_3084":126860},[],"`settings.issuance_profile` incluido en el DMS",{"_3634":74996,"_31331":74949,"_21707":126862,"_5":14945,"_28497":126742,"_3084":126863},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3634":74997,"_31331":74949,"_21707":126865,"_5":14945,"_28497":126742,"_3084":126866},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3634":74998,"_31331":74949,"_21707":126868,"_5":14945,"_28497":126742,"_3084":126869},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3634":74999,"_31331":74949,"_21707":126871,"_5":14945,"_28497":126750,"_3084":126872},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3634":75000,"_31331":74949,"_21707":126874,"_5":14945,"_28497":126754,"_3084":126875},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3634":75001,"_31331":74949,"_21707":126877,"_5":14945,"_28497":126758,"_3084":126878},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3634":75002,"_31331":74949,"_21707":126880,"_5":14945,"_28497":126762,"_3084":126881},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3634":75003,"_31331":74949,"_21707":126883,"_5":14945,"_28497":126766,"_3084":126884},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3634":75004,"_31331":74949,"_21707":126886,"_5":14945,"_28497":126766,"_3084":126887},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3634":75005,"_31331":74949,"_21707":126889,"_5":14945,"_28497":126770,"_3084":126890},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3634":75006,"_31331":74949,"_21707":126892,"_5":14945,"_28497":126770,"_3084":126893},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3634":75007,"_31331":74949,"_21707":126895,"_5":14945,"_28497":126770,"_3084":126896},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3634":75008,"_31331":74949,"_21707":126898,"_5":14945,"_28497":126770,"_3084":126899},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3634":75009,"_31331":74949,"_21707":126901,"_5":14945,"_28497":126774,"_3084":126902},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3634":75010,"_31331":74949,"_21707":126904,"_5":14945,"_28497":126774,"_3084":126905},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3634":75011,"_31331":75011,"_5":15305,"_3084":126907,"_31690":126908,"_21707":126910,"_28497":75011},"Validación de certificados",[51145,122216,56831,126909],"Validación",[],{"_3634":75012,"_31331":75011,"_21707":126912,"_5":14945,"_28497":75011,"_3084":126913},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3634":75013,"_31331":75011,"_5":31687,"_21707":126915,"_28497":126916,"_3084":126917},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3634":75014,"_31331":75011,"_5":31687,"_21707":126919,"_28497":126920,"_3084":126921},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3634":75015,"_31331":75011,"_5":31687,"_21707":126923,"_28497":126924,"_3084":126925},[],"/docs/pr-preview/pr-81/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3634":75016,"_31331":75011,"_21707":126927,"_5":14945,"_28497":75011,"_3084":126928},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3634":75017,"_31331":75011,"_21707":126930,"_5":14945,"_28497":126916,"_3084":126931},[],"Verifica estos criterios juntos:",{"_3634":75018,"_31331":75011,"_21707":126933,"_5":14945,"_28497":126916,"_3084":125867},[],{"_3634":75019,"_31331":75011,"_21707":126935,"_5":14945,"_28497":126916,"_3084":126936},[],"Resultado necesario",{"_3634":75020,"_31331":75011,"_21707":126938,"_5":14945,"_28497":126916,"_3084":126939},[],"Cadena y firma",{"_3634":75021,"_31331":75011,"_21707":126941,"_5":14945,"_28497":126916,"_3084":126942},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3634":75022,"_31331":75011,"_21707":126944,"_5":14945,"_28497":126916,"_3084":126945},[],"Fechas",{"_3634":75023,"_31331":75011,"_21707":126947,"_5":14945,"_28497":126916,"_3084":126948},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3634":75024,"_31331":75011,"_21707":126950,"_5":14945,"_28497":126916,"_3084":121886},[],{"_3634":75025,"_31331":75011,"_21707":126952,"_5":14945,"_28497":126916,"_3084":126953},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3634":75026,"_31331":75011,"_21707":126955,"_5":14945,"_28497":126916,"_3084":126956},[],"Uso",{"_3634":75027,"_31331":75011,"_21707":126958,"_5":14945,"_28497":126916,"_3084":126959},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3634":75028,"_31331":75011,"_21707":126961,"_5":14945,"_28497":126916,"_3084":126962},[],"Revocación",{"_3634":75029,"_31331":75011,"_21707":126964,"_5":14945,"_28497":126916,"_3084":126965},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3634":75030,"_31331":75011,"_21707":126967,"_5":14945,"_28497":126916,"_3084":126968},[],"Autorización",{"_3634":75031,"_31331":75011,"_21707":126970,"_5":14945,"_28497":126916,"_3084":126971},[],"La aplicación permite la acción a esa identidad.",{"_3634":75032,"_31331":75011,"_21707":126973,"_5":14945,"_28497":126916,"_3084":126974},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3634":75033,"_31331":75011,"_21707":126976,"_5":14945,"_28497":126920,"_3084":126977},[],"Mecanismo",{"_3634":75034,"_31331":75011,"_21707":126979,"_5":14945,"_28497":126920,"_3084":126980},[],"Cuándo utilizarlo",{"_3634":75035,"_31331":75011,"_21707":126982,"_5":14945,"_28497":126920,"_3084":126983},[],"Qué debes mantener",{"_3634":75036,"_31331":75011,"_21707":126985,"_5":14945,"_28497":126920,"_3084":57580},[],{"_3634":75037,"_31331":75011,"_21707":126987,"_5":14945,"_28497":126920,"_3084":126988},[],"Consulta del estado de un certificado concreto.",{"_3634":75038,"_31331":75011,"_21707":126990,"_5":14945,"_28497":126920,"_3084":126991},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3634":75039,"_31331":75011,"_21707":126993,"_5":14945,"_28497":126920,"_3084":57589},[],{"_3634":75040,"_31331":75011,"_21707":126995,"_5":14945,"_28497":126920,"_3084":126996},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3634":75041,"_31331":75011,"_21707":126998,"_5":14945,"_28497":126920,"_3084":126999},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3634":75042,"_31331":75011,"_21707":127001,"_5":14945,"_28497":126920,"_3084":127002},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3634":75043,"_31331":75011,"_21707":127004,"_5":14945,"_28497":126920,"_3084":127005},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3634":75044,"_31331":75011,"_21707":127007,"_5":14945,"_28497":126924,"_3084":127008},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3634":75045,"_31331":75011,"_21707":127010,"_5":14945,"_28497":126924,"_3084":127011},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3634":75046,"_31331":75011,"_21707":127013,"_5":14945,"_28497":126924,"_3084":127014},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3634":75047,"_31331":75011,"_21707":127016,"_5":14945,"_28497":126924,"_3084":127017},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3634":75048,"_31331":75011,"_21707":127019,"_5":14945,"_28497":126924,"_3084":127020},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3634":75049,"_31331":75011,"_21707":127022,"_5":14945,"_28497":126924,"_3084":127023},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3634":75050,"_31331":75011,"_21707":127025,"_5":14945,"_28497":126924,"_3084":127026},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3634":75051,"_31331":75011,"_21707":127028,"_5":14945,"_28497":126924,"_3084":127029},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":75052,"_31331":75011,"_21707":127031,"_5":14945,"_28497":126924,"_3084":127032},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3634":75053,"_31331":75053,"_5":15305,"_3084":127034,"_31690":127035,"_21707":127036,"_28497":75053},"Certificados",[51145,122216,56831,126238],[],{"_3634":75054,"_31331":75053,"_21707":127038,"_5":14945,"_28497":75053,"_3084":127039},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3634":75055,"_31331":75053,"_5":31687,"_21707":127041,"_28497":127042,"_3084":127043},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3634":75056,"_31331":75053,"_5":31687,"_21707":127045,"_28497":127046,"_3084":127047},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3634":75057,"_31331":75053,"_5":31687,"_21707":127049,"_28497":127050,"_3084":127051},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3634":75058,"_31331":75053,"_5":31687,"_21707":127053,"_28497":127054,"_3084":127055},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3634":75059,"_31331":75053,"_5":31687,"_21707":127057,"_28497":127058,"_3084":127059},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3634":75060,"_31331":75053,"_5":31687,"_21707":127061,"_28497":127062,"_3084":127063},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3634":75061,"_31331":75053,"_5":31687,"_21707":127065,"_28497":127066,"_3084":127067},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3634":75062,"_31331":75053,"_5":31687,"_21707":127069,"_28497":127070,"_3084":127071},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3634":75063,"_31331":75053,"_5":31687,"_21707":127073,"_28497":127074,"_3084":127075},[],"/docs/pr-preview/pr-81/es/platform/pki/certificates#continúa","Continúa",{"_3634":75064,"_31331":75053,"_21707":127077,"_5":14945,"_28497":75053,"_3084":127078},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3634":75065,"_31331":75053,"_21707":127080,"_5":14945,"_28497":127042,"_3084":127081},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3634":75066,"_31331":75053,"_21707":127083,"_5":14945,"_28497":127042,"_3084":127084},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3634":75067,"_31331":75053,"_21707":127086,"_5":14945,"_28497":127042,"_3084":127087},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3634":75068,"_31331":75053,"_21707":127089,"_5":14945,"_28497":127042,"_3084":127090},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3634":75069,"_31331":75053,"_21707":127092,"_5":14945,"_28497":127042,"_3084":127093},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3634":75070,"_31331":75053,"_21707":127095,"_5":14945,"_28497":127042,"_3084":127096},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3634":75071,"_31331":75053,"_21707":127098,"_5":14945,"_28497":127042,"_3084":127099},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3634":75072,"_31331":75053,"_21707":127101,"_5":14945,"_28497":127046,"_3084":127102},[],"Descarga el PEM e inspecciónalo:",{"_3634":75073,"_31331":75053,"_21707":127104,"_5":14945,"_28497":127046,"_3084":127105},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3634":75074,"_31331":75053,"_21707":127107,"_5":14945,"_28497":127050,"_3084":127108},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3634":75075,"_31331":75053,"_21707":127110,"_5":14945,"_28497":127050,"_3084":127111},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3634":75076,"_31331":75053,"_21707":127113,"_5":14945,"_28497":127050,"_3084":127114},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3634":75077,"_31331":75053,"_21707":127116,"_5":14945,"_28497":127050,"_3084":127117},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3634":75078,"_31331":75053,"_21707":127119,"_5":14945,"_28497":127050,"_3084":127120},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3634":75079,"_31331":75053,"_21707":127122,"_5":14945,"_28497":127050,"_3084":127123},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3634":75080,"_31331":75053,"_21707":127125,"_5":14945,"_28497":127050,"_3084":127126},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3634":75081,"_31331":75053,"_21707":127128,"_5":14945,"_28497":127054,"_3084":127129},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3634":75082,"_31331":75053,"_21707":127131,"_5":14945,"_28497":127058,"_3084":127132},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3634":75083,"_31331":75053,"_21707":127134,"_5":14945,"_28497":127062,"_3084":127135},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3634":75084,"_31331":75053,"_21707":127137,"_5":14945,"_28497":127066,"_3084":127138},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3634":75085,"_31331":75053,"_21707":127140,"_5":14945,"_28497":127066,"_3084":127141},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3634":75086,"_31331":75053,"_21707":127143,"_5":14945,"_28497":127066,"_3084":127144},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3634":75087,"_31331":75053,"_21707":127146,"_5":14945,"_28497":127070,"_3084":127147},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3634":75088,"_31331":75053,"_21707":127149,"_5":14945,"_28497":127070,"_3084":127150},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3634":75089,"_31331":75053,"_21707":127152,"_5":14945,"_28497":127070,"_3084":127153},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3634":75090,"_31331":75053,"_21707":127155,"_5":14945,"_28497":127074,"_3084":127156},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":75091,"_31331":75053,"_21707":127158,"_5":14945,"_28497":127074,"_3084":127159},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3634":75092,"_31331":75092,"_5":15305,"_3084":127161,"_31690":127162,"_21707":127164,"_28497":75092},"Ciclo de vida de un certificado",[51145,122216,56831,127163],"Conceptos",[],{"_3634":75093,"_31331":75092,"_21707":127166,"_5":14945,"_28497":75092,"_3084":127167},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3634":75094,"_31331":75092,"_5":31687,"_21707":127169,"_28497":127170,"_3084":127171},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3634":75095,"_31331":75092,"_5":31687,"_21707":127173,"_28497":127174,"_3084":127175},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3634":75096,"_31331":75092,"_5":31687,"_21707":127177,"_28497":127178,"_3084":127179},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3634":75097,"_31331":75092,"_5":31687,"_21707":127181,"_28497":127182,"_3084":127183},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3634":75098,"_31331":75092,"_5":31687,"_21707":127185,"_28497":127186,"_3084":127187},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3634":75099,"_31331":75092,"_5":31687,"_21707":127189,"_28497":127190,"_3084":127191},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3634":75100,"_31331":75092,"_5":31687,"_21707":127193,"_28497":127194,"_3084":124861},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3634":75101,"_31331":75092,"_5":31687,"_21707":127196,"_28497":127197,"_3084":127198},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3634":75102,"_31331":75092,"_5":31687,"_21707":127200,"_28497":127201,"_3084":127202},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3634":75103,"_31331":75092,"_5":31687,"_21707":127204,"_28497":127205,"_3084":127206},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3634":75104,"_31331":75092,"_21707":127208,"_5":14945,"_28497":75092,"_3084":127209},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3634":75105,"_31331":75092,"_21707":127211,"_5":14945,"_28497":127174,"_3084":127212},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3634":75106,"_31331":75092,"_21707":127214,"_5":14945,"_28497":127178,"_3084":127215},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3634":75107,"_31331":75092,"_21707":127217,"_5":14945,"_28497":127182,"_3084":127218},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3634":75108,"_31331":75092,"_21707":127220,"_5":14945,"_28497":127186,"_3084":127221},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3634":75109,"_31331":75092,"_21707":127223,"_5":14945,"_28497":127190,"_3084":127224},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3634":75110,"_31331":75092,"_21707":127226,"_5":14945,"_28497":127194,"_3084":127227},[],"Lamassu persiste cuatro estados X.509:",{"_3634":75111,"_31331":75092,"_21707":127229,"_5":14945,"_28497":127194,"_3084":127230},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3634":75112,"_31331":75092,"_21707":127232,"_5":14945,"_28497":127194,"_3084":127233},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3634":75113,"_31331":75092,"_21707":127235,"_5":14945,"_28497":127194,"_3084":127236},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3634":75114,"_31331":75092,"_21707":127238,"_5":14945,"_28497":127194,"_3084":127239},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3634":75115,"_31331":75092,"_21707":127241,"_5":14945,"_28497":127194,"_3084":127242},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3634":75116,"_31331":75092,"_21707":127244,"_5":14945,"_28497":127197,"_3084":127245},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3634":75117,"_31331":75092,"_21707":127247,"_5":14945,"_28497":127197,"_3084":127248},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3634":75118,"_31331":75092,"_21707":127250,"_5":14945,"_28497":127197,"_3084":127251},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3634":75119,"_31331":75092,"_21707":127253,"_5":14945,"_28497":127201,"_3084":127254},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3634":75120,"_31331":75092,"_21707":127256,"_5":14945,"_28497":127201,"_3084":127257},[],"Antes de confirmar:",{"_3634":75121,"_31331":75092,"_21707":127259,"_5":14945,"_28497":127201,"_3084":127260},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3634":75122,"_31331":75092,"_21707":127262,"_5":14945,"_28497":127201,"_3084":127263},[],"Distribuye la nueva cadena de confianza.",{"_3634":75123,"_31331":75092,"_21707":127265,"_5":14945,"_28497":127201,"_3084":127266},[],"Reemite las identidades necesarias.",{"_3634":75124,"_31331":75092,"_21707":127268,"_5":14945,"_28497":127201,"_3084":127269},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3634":75125,"_31331":75092,"_21707":127271,"_5":14945,"_28497":127201,"_3084":127272},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3634":75126,"_31331":75092,"_21707":127274,"_5":14945,"_28497":127201,"_3084":127275},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3634":75127,"_31331":75092,"_21707":127277,"_5":14945,"_28497":127205,"_3084":127278},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3634":75128,"_31331":75092,"_21707":127280,"_5":14945,"_28497":127205,"_3084":127281},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3634":75129,"_31331":75092,"_21707":127283,"_5":14945,"_28497":127205,"_3084":127284},[],"Cambios de estado y razones de revocación.",{"_3634":75130,"_31331":75092,"_21707":127286,"_5":14945,"_28497":127205,"_3084":127287},[],"Publicación y vigencia de OCSP y CRLs.",{"_3634":75131,"_31331":75092,"_21707":127289,"_5":14945,"_28497":127205,"_3084":127290},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3634":75132,"_31331":75092,"_21707":127292,"_5":14945,"_28497":127205,"_3084":127293},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3634":75133,"_31331":75133,"_5":15305,"_3084":127295,"_31690":127296,"_21707":127297,"_28497":75133},"Modelo de confianza",[51145,122216,56831,127163],[],{"_3634":75134,"_31331":75133,"_21707":127299,"_5":14945,"_28497":75133,"_3084":127300},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3634":75135,"_31331":75133,"_5":31687,"_21707":127302,"_28497":127303,"_3084":127304},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3634":75136,"_31331":75133,"_5":31687,"_21707":127306,"_28497":127307,"_3084":127308},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3634":75137,"_31331":75133,"_5":31687,"_21707":127310,"_28497":127311,"_3084":127312},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3634":75138,"_31331":75133,"_5":31687,"_21707":127314,"_28497":127315,"_3084":127316},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3634":75139,"_31331":75133,"_5":31687,"_21707":127318,"_28497":127319,"_3084":127320},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3634":75140,"_31331":75133,"_5":31687,"_21707":127322,"_28497":127323,"_3084":127324},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3634":75141,"_31331":75133,"_5":31687,"_21707":127326,"_28497":127327,"_3084":127328},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3634":75142,"_31331":75133,"_5":31687,"_21707":127330,"_28497":127331,"_3084":127332},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3634":75143,"_31331":75133,"_5":31687,"_21707":127334,"_28497":127335,"_3084":127336},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3634":75144,"_31331":75133,"_5":31687,"_21707":127338,"_28497":127339,"_3084":127340},[],"/docs/pr-preview/pr-81/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3634":75145,"_31331":75133,"_21707":127342,"_5":14945,"_28497":75133,"_3084":127343},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3634":75146,"_31331":75133,"_21707":127345,"_5":14945,"_28497":127307,"_3084":127346},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3634":75147,"_31331":75133,"_21707":127348,"_5":14945,"_28497":127311,"_3084":127349},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3634":75148,"_31331":75133,"_21707":127351,"_5":14945,"_28497":127315,"_3084":127352},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3634":75149,"_31331":75133,"_21707":127354,"_5":14945,"_28497":127319,"_3084":127355},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3634":75150,"_31331":75133,"_21707":127357,"_5":14945,"_28497":127323,"_3084":127358},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3634":75151,"_31331":75133,"_21707":127360,"_5":14945,"_28497":127323,"_3084":127361},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3634":75152,"_31331":75133,"_21707":127363,"_5":14945,"_28497":127323,"_3084":127364},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3634":75153,"_31331":75133,"_21707":127366,"_5":14945,"_28497":127323,"_3084":127367},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3634":75154,"_31331":75133,"_21707":127369,"_5":14945,"_28497":127323,"_3084":127370},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3634":75155,"_31331":75133,"_21707":127372,"_5":14945,"_28497":127323,"_3084":127373},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3634":75156,"_31331":75133,"_21707":127375,"_5":14945,"_28497":127327,"_3084":127376},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3634":75157,"_31331":75133,"_21707":127378,"_5":14945,"_28497":127327,"_3084":127379},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3634":75158,"_31331":75133,"_21707":127381,"_5":14945,"_28497":127327,"_3084":127382},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3634":75159,"_31331":75133,"_21707":127384,"_5":14945,"_28497":127327,"_3084":127385},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3634":75160,"_31331":75133,"_21707":127387,"_5":14945,"_28497":127327,"_3084":127388},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3634":75161,"_31331":75133,"_21707":127390,"_5":14945,"_28497":127331,"_3084":127391},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3634":75162,"_31331":75133,"_21707":127393,"_5":14945,"_28497":127331,"_3084":127394},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3634":75163,"_31331":75133,"_21707":127396,"_5":14945,"_28497":127331,"_3084":127397},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3634":75164,"_31331":75133,"_21707":127399,"_5":14945,"_28497":127331,"_3084":127400},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3634":75165,"_31331":75133,"_21707":127402,"_5":14945,"_28497":127331,"_3084":127403},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3634":75166,"_31331":75133,"_21707":127405,"_5":14945,"_28497":127331,"_3084":127406},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3634":75167,"_31331":75133,"_21707":127408,"_5":14945,"_28497":127331,"_3084":127409},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3634":75168,"_31331":75133,"_21707":127411,"_5":14945,"_28497":127335,"_3084":127412},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3634":75169,"_31331":75133,"_21707":127414,"_5":14945,"_28497":127339,"_3084":127415},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3634":75170,"_31331":75133,"_21707":127417,"_5":14945,"_28497":127339,"_3084":127418},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3634":75171,"_31331":75133,"_21707":127420,"_5":14945,"_28497":127339,"_3084":127421},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3634":75172,"_31331":75133,"_21707":127423,"_5":14945,"_28497":127339,"_3084":127424},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3634":75173,"_31331":75133,"_21707":127426,"_5":14945,"_28497":127339,"_3084":127427},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3634":75174,"_31331":75133,"_21707":127429,"_5":14945,"_28497":127339,"_3084":127430},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3634":75175,"_31331":75133,"_21707":127432,"_5":14945,"_28497":127339,"_3084":127433},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3634":75176,"_31331":75176,"_5":15305,"_3084":127435,"_31690":127436,"_21707":127437,"_28497":75176},"Listas de revocación (CRL)",[51145,122216,56831,126909],[],{"_3634":75177,"_31331":75176,"_21707":127439,"_5":14945,"_28497":75176,"_3084":127440},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3634":75178,"_31331":75176,"_5":31687,"_21707":127442,"_28497":127443,"_3084":127444},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3634":75179,"_31331":75176,"_5":31687,"_21707":127446,"_28497":127447,"_3084":127448},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3634":75180,"_31331":75176,"_5":31687,"_21707":127450,"_28497":127451,"_3084":127452},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3634":75181,"_31331":75176,"_5":31687,"_21707":127454,"_28497":127455,"_3084":127456},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3634":75182,"_31331":75176,"_5":31687,"_21707":127458,"_28497":127459,"_3084":127460},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3634":75183,"_31331":75176,"_5":31687,"_21707":127462,"_28497":127463,"_3084":127464},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3634":75184,"_31331":75176,"_5":31687,"_21707":127466,"_28497":127467,"_3084":127468},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3634":75185,"_31331":75176,"_5":31687,"_21707":127470,"_28497":127471,"_3084":127472},[],"/docs/pr-preview/pr-81/es/platform/pki/crl#referencias","Referencias",{"_3634":75186,"_31331":75176,"_21707":127474,"_5":14945,"_28497":75176,"_3084":127475},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3634":75187,"_31331":75176,"_21707":127477,"_5":14945,"_28497":127443,"_3084":127478},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3634":75188,"_31331":75176,"_21707":127480,"_5":14945,"_28497":127443,"_3084":127481},[],"Campo",{"_3634":75189,"_31331":75176,"_21707":127483,"_5":14945,"_28497":127443,"_3084":123902},[],{"_3634":75190,"_31331":75176,"_21707":127485,"_5":14945,"_28497":127443,"_3084":52777},[],{"_3634":75191,"_31331":75176,"_21707":127487,"_5":14945,"_28497":127443,"_3084":127488},[],"ID de la CA a la que pertenecen los ajustes.",{"_3634":75192,"_31331":75176,"_21707":127490,"_5":14945,"_28497":127443,"_3084":58088},[],{"_3634":75193,"_31331":75176,"_21707":127492,"_5":14945,"_28497":127443,"_3084":127493},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3634":75194,"_31331":75176,"_21707":127495,"_5":14945,"_28497":127443,"_3084":58094},[],{"_3634":75195,"_31331":75176,"_21707":127497,"_5":14945,"_28497":127443,"_3084":127498},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3634":75196,"_31331":75176,"_21707":127500,"_5":14945,"_28497":127443,"_3084":58100},[],{"_3634":75197,"_31331":75176,"_21707":127502,"_5":14945,"_28497":127443,"_3084":127503},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3634":75198,"_31331":75176,"_21707":127505,"_5":14945,"_28497":127443,"_3084":127506},[],"Campo de `crl_options`",{"_3634":75199,"_31331":75176,"_21707":127508,"_5":14945,"_28497":127443,"_3084":123902},[],{"_3634":75200,"_31331":75176,"_21707":127510,"_5":14945,"_28497":127443,"_3084":127511},[],"Valor inicial",{"_3634":75201,"_31331":75176,"_21707":127513,"_5":14945,"_28497":127443,"_3084":58114},[],{"_3634":75202,"_31331":75176,"_21707":127515,"_5":14945,"_28497":127443,"_3084":127516},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3634":75203,"_31331":75176,"_21707":127518,"_5":14945,"_28497":127443,"_3084":127519},[],"7 días.",{"_3634":75204,"_31331":75176,"_21707":127521,"_5":14945,"_28497":127443,"_3084":58123},[],{"_3634":75205,"_31331":75176,"_21707":127523,"_5":14945,"_28497":127443,"_3084":127524},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3634":75206,"_31331":75176,"_21707":127526,"_5":14945,"_28497":127443,"_3084":127527},[],"6 días y 23 horas.",{"_3634":75207,"_31331":75176,"_21707":127529,"_5":14945,"_28497":127443,"_3084":58132},[],{"_3634":75208,"_31331":75176,"_21707":127531,"_5":14945,"_28497":127443,"_3084":127532},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3634":75209,"_31331":75176,"_21707":127534,"_5":14945,"_28497":127443,"_3084":58138},[],{"_3634":75210,"_31331":75176,"_21707":127536,"_5":14945,"_28497":127443,"_3084":58141},[],{"_3634":75211,"_31331":75176,"_21707":127538,"_5":14945,"_28497":127443,"_3084":127539},[],"Número de serie del certificado existente que firma la CRL.",{"_3634":75212,"_31331":75176,"_21707":127541,"_5":14945,"_28497":127443,"_3084":127542},[],"Número de serie del certificado actual de la CA.",{"_3634":75213,"_31331":75176,"_21707":127544,"_5":14945,"_28497":127443,"_3084":127545},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3634":75214,"_31331":75176,"_21707":127547,"_5":14945,"_28497":127443,"_3084":127548},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3634":75215,"_31331":75176,"_21707":127550,"_5":14945,"_28497":127443,"_3084":127551},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3634":75216,"_31331":75176,"_21707":127553,"_5":14945,"_28497":127443,"_3084":127554},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3634":75217,"_31331":75176,"_21707":127556,"_5":14945,"_28497":127443,"_3084":127557},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3634":75218,"_31331":75176,"_21707":127559,"_5":14945,"_28497":127443,"_3084":127560},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3634":75219,"_31331":75176,"_21707":127562,"_5":14945,"_28497":127443,"_3084":127563},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3634":75220,"_31331":75176,"_21707":127565,"_5":14945,"_28497":127443,"_3084":127566},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3634":75221,"_31331":75176,"_21707":127568,"_5":14945,"_28497":127443,"_3084":127569},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3634":75222,"_31331":75176,"_21707":127571,"_5":14945,"_28497":127443,"_3084":127572},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3634":75223,"_31331":75176,"_21707":127574,"_5":14945,"_28497":127443,"_3084":127575},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3634":75224,"_31331":75176,"_21707":127577,"_5":14945,"_28497":127447,"_3084":127578},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3634":75225,"_31331":75176,"_21707":127580,"_5":14945,"_28497":127447,"_3084":127581},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3634":75226,"_31331":75176,"_21707":127583,"_5":14945,"_28497":127447,"_3084":127584},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3634":75227,"_31331":75176,"_21707":127586,"_5":14945,"_28497":127447,"_3084":127587},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3634":75228,"_31331":75176,"_21707":127589,"_5":14945,"_28497":127451,"_3084":127590},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3634":75229,"_31331":75176,"_21707":127592,"_5":14945,"_28497":127451,"_3084":127593},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3634":75230,"_31331":75176,"_21707":127595,"_5":14945,"_28497":127451,"_3084":127596},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3634":75231,"_31331":75176,"_21707":127598,"_5":14945,"_28497":127451,"_3084":127599},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3634":75232,"_31331":75176,"_21707":127601,"_5":14945,"_28497":127451,"_3084":127602},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3634":75233,"_31331":75176,"_21707":127604,"_5":14945,"_28497":127451,"_3084":127605},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3634":75234,"_31331":75176,"_21707":127607,"_5":14945,"_28497":127451,"_3084":127608},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3634":75235,"_31331":75176,"_21707":127610,"_5":14945,"_28497":127451,"_3084":127611},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3634":75236,"_31331":75176,"_21707":127613,"_5":14945,"_28497":127451,"_3084":127614},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3634":75237,"_31331":75176,"_21707":127616,"_5":14945,"_28497":127455,"_3084":127617},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3634":75238,"_31331":75176,"_21707":127619,"_5":14945,"_28497":127455,"_3084":127620},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3634":75239,"_31331":75176,"_21707":127622,"_5":14945,"_28497":127459,"_3084":127623},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3634":75240,"_31331":75176,"_21707":127625,"_5":14945,"_28497":127459,"_3084":127626},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3634":75241,"_31331":75176,"_21707":127628,"_5":14945,"_28497":127459,"_3084":127629},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3634":75242,"_31331":75176,"_21707":127631,"_5":14945,"_28497":127459,"_3084":127632},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3634":75243,"_31331":75176,"_21707":127634,"_5":14945,"_28497":127459,"_3084":127635},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3634":75244,"_31331":75176,"_21707":127637,"_5":14945,"_28497":127463,"_3084":127638},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3634":75245,"_31331":75176,"_21707":127640,"_5":14945,"_28497":127463,"_3084":124091},[],{"_3634":75246,"_31331":75176,"_21707":127642,"_5":14945,"_28497":127463,"_3084":127643},[],"Path relativo",{"_3634":75247,"_31331":75176,"_21707":127645,"_5":14945,"_28497":127463,"_3084":121976},[],{"_3634":75248,"_31331":75176,"_21707":127647,"_5":14945,"_28497":127463,"_3084":58253},[],{"_3634":75249,"_31331":75176,"_21707":127649,"_5":14945,"_28497":127463,"_3084":58256},[],{"_3634":75250,"_31331":75176,"_21707":127651,"_5":14945,"_28497":127463,"_3084":127652},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3634":75251,"_31331":75176,"_21707":127654,"_5":14945,"_28497":127463,"_3084":58253},[],{"_3634":75252,"_31331":75176,"_21707":127656,"_5":14945,"_28497":127463,"_3084":58264},[],{"_3634":75253,"_31331":75176,"_21707":127658,"_5":14945,"_28497":127463,"_3084":127659},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3634":75254,"_31331":75176,"_21707":127661,"_5":14945,"_28497":127463,"_3084":58270},[],{"_3634":75255,"_31331":75176,"_21707":127663,"_5":14945,"_28497":127463,"_3084":58264},[],{"_3634":75256,"_31331":75176,"_21707":127665,"_5":14945,"_28497":127463,"_3084":127666},[],"Sustituir la configuración de CRL de una CA.",{"_3634":75257,"_31331":75176,"_21707":127668,"_5":14945,"_28497":127463,"_3084":58278},[],{"_3634":75258,"_31331":75176,"_21707":127670,"_5":14945,"_28497":127463,"_3084":58264},[],{"_3634":75259,"_31331":75176,"_21707":127672,"_5":14945,"_28497":127463,"_3084":127673},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3634":75260,"_31331":75176,"_21707":127675,"_5":14945,"_28497":127463,"_3084":127676},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3634":75261,"_31331":75176,"_21707":127678,"_5":14945,"_28497":127463,"_3084":127679},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3634":75262,"_31331":75176,"_21707":127681,"_5":14945,"_28497":127463,"_3084":127682},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3634":75263,"_31331":75176,"_21707":127684,"_5":14945,"_28497":127467,"_3084":127685},[],"Síntoma",{"_3634":75264,"_31331":75176,"_21707":127687,"_5":14945,"_28497":127467,"_3084":127688},[],"Causa",{"_3634":75265,"_31331":75176,"_21707":127690,"_5":14945,"_28497":127467,"_3084":127691},[],"Acción",{"_3634":75266,"_31331":75176,"_21707":127693,"_5":14945,"_28497":127467,"_3084":127694},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3634":75267,"_31331":75176,"_21707":127696,"_5":14945,"_28497":127467,"_3084":127697},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3634":75268,"_31331":75176,"_21707":127699,"_5":14945,"_28497":127467,"_3084":127700},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3634":75269,"_31331":75176,"_21707":127702,"_5":14945,"_28497":127467,"_3084":127703},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3634":75270,"_31331":75176,"_21707":127705,"_5":14945,"_28497":127467,"_3084":127706},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3634":75271,"_31331":75176,"_21707":127708,"_5":14945,"_28497":127467,"_3084":127709},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3634":75272,"_31331":75176,"_21707":127711,"_5":14945,"_28497":127467,"_3084":127712},[],"`PUT` devuelve 400.",{"_3634":75273,"_31331":75176,"_21707":127714,"_5":14945,"_28497":127467,"_3084":127715},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3634":75274,"_31331":75176,"_21707":127717,"_5":14945,"_28497":127467,"_3084":127718},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3634":75275,"_31331":75176,"_21707":127720,"_5":14945,"_28497":127467,"_3084":127721},[],"`PUT` devuelve 404.",{"_3634":75276,"_31331":75176,"_21707":127723,"_5":14945,"_28497":127467,"_3084":127724},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3634":75277,"_31331":75176,"_21707":127726,"_5":14945,"_28497":127467,"_3084":127727},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3634":75278,"_31331":75176,"_21707":127729,"_5":14945,"_28497":127467,"_3084":127730},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3634":75279,"_31331":75176,"_21707":127732,"_5":14945,"_28497":127467,"_3084":127733},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3634":75280,"_31331":75176,"_21707":127735,"_5":14945,"_28497":127467,"_3084":127736},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3634":75281,"_31331":75176,"_21707":127738,"_5":14945,"_28497":127467,"_3084":127739},[],"La CRL no cambia tras revocar un certificado.",{"_3634":75282,"_31331":75176,"_21707":127741,"_5":14945,"_28497":127467,"_3084":127742},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3634":75283,"_31331":75176,"_21707":127744,"_5":14945,"_28497":127467,"_3084":127745},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3634":75284,"_31331":75176,"_21707":127747,"_5":14945,"_28497":127467,"_3084":127748},[],"Un verificador rechaza la CRL por el emisor.",{"_3634":75285,"_31331":75176,"_21707":127750,"_5":14945,"_28497":127467,"_3084":127751},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3634":75286,"_31331":75176,"_21707":127753,"_5":14945,"_28497":127467,"_3084":127754},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3634":75287,"_31331":75176,"_21707":127756,"_5":14945,"_28497":127471,"_3084":127757},[],"RFC 5280: perfil X.509 y CRL.",{"_3634":75288,"_31331":75176,"_21707":127759,"_5":14945,"_28497":127471,"_3084":58370},[],{"_3634":75289,"_31331":75176,"_21707":127761,"_5":14945,"_28497":127471,"_3084":58373},[],{"_3634":75290,"_31331":75176,"_21707":127763,"_5":14945,"_28497":127471,"_3084":127764},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":75291,"_31331":75176,"_21707":127766,"_5":14945,"_28497":127471,"_3084":127767},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3634":75292,"_31331":75292,"_5":15305,"_3084":127769,"_31690":127770,"_21707":127771,"_28497":75292},"Claves y motores criptográficos",[51145,122216,56831,126238],[],{"_3634":75293,"_31331":75292,"_21707":127773,"_5":14945,"_28497":75292,"_3084":127774},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3634":75294,"_31331":75292,"_5":31687,"_21707":127776,"_28497":127777,"_3084":127778},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3634":75295,"_31331":75292,"_5":31687,"_21707":127780,"_28497":127781,"_3084":127782},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3634":75296,"_31331":75292,"_5":31687,"_21707":127784,"_28497":127785,"_3084":58398},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#file-system",{"_3634":75297,"_31331":75292,"_5":31687,"_21707":127787,"_28497":127788,"_3084":58402},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#hashicorp-vault",{"_3634":75298,"_31331":75292,"_5":31687,"_21707":127790,"_28497":127791,"_3084":58406},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#aws-secrets-manager",{"_3634":75299,"_31331":75292,"_5":31687,"_21707":127793,"_28497":127794,"_3084":58410},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#aws-kms",{"_3634":75300,"_31331":75292,"_5":31687,"_21707":127796,"_28497":127797,"_3084":58414},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#pkcs11",{"_3634":75301,"_31331":75292,"_5":31687,"_21707":127799,"_28497":127800,"_3084":58418},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#azure-key-vault",{"_3634":75302,"_31331":75292,"_5":31687,"_21707":127802,"_28497":127803,"_3084":127804},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3634":75303,"_31331":75292,"_5":31687,"_21707":127806,"_28497":127807,"_3084":127808},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3634":75304,"_31331":75292,"_5":31687,"_21707":127810,"_28497":127811,"_3084":127812},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3634":75305,"_31331":75292,"_5":31687,"_21707":127814,"_28497":127815,"_3084":127816},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3634":75306,"_31331":75292,"_5":31687,"_21707":127818,"_28497":127819,"_3084":127820},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3634":75307,"_31331":75292,"_5":31687,"_21707":127822,"_28497":127823,"_3084":127824},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3634":75308,"_31331":75292,"_5":31687,"_21707":127826,"_28497":127827,"_3084":127828},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3634":75309,"_31331":75292,"_5":31687,"_21707":127830,"_28497":127831,"_3084":58450},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#sign",{"_3634":75310,"_31331":75292,"_5":31687,"_21707":127833,"_28497":127834,"_3084":58454},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#verify",{"_3634":75311,"_31331":75292,"_5":31687,"_21707":127836,"_28497":127837,"_3084":127838},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3634":75312,"_31331":75292,"_5":31687,"_21707":127840,"_28497":127841,"_3084":127842},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3634":75313,"_31331":75292,"_5":31687,"_21707":127844,"_28497":127845,"_3084":127846},[],"/docs/pr-preview/pr-81/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3634":75314,"_31331":75292,"_21707":127848,"_5":14945,"_28497":75292,"_3084":127849},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3634":75315,"_31331":75292,"_21707":127851,"_5":14945,"_28497":75292,"_3084":127852},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3634":75316,"_31331":75292,"_21707":127854,"_5":14945,"_28497":127777,"_3084":127855},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3634":75317,"_31331":75292,"_21707":127857,"_5":14945,"_28497":127777,"_3084":127858},[],"En la práctica, permite:",{"_3634":75318,"_31331":75292,"_21707":127860,"_5":14945,"_28497":127777,"_3084":127861},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3634":75319,"_31331":75292,"_21707":127863,"_5":14945,"_28497":127777,"_3084":127864},[],"Importar claves creadas externamente.",{"_3634":75320,"_31331":75292,"_21707":127866,"_5":14945,"_28497":127777,"_3084":127867},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3634":75321,"_31331":75292,"_21707":127869,"_5":14945,"_28497":127777,"_3084":127870},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3634":75322,"_31331":75292,"_21707":127872,"_5":14945,"_28497":127781,"_3084":127873},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3634":75323,"_31331":75292,"_21707":127875,"_5":14945,"_28497":127781,"_3084":127876},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3634":75324,"_31331":75292,"_21707":127878,"_5":14945,"_28497":127781,"_3084":127879},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3634":75325,"_31331":75292,"_21707":127881,"_5":14945,"_28497":127785,"_3084":127882},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3634":75326,"_31331":75292,"_21707":127884,"_5":14945,"_28497":127788,"_3084":127885},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3634":75327,"_31331":75292,"_21707":127887,"_5":14945,"_28497":127788,"_3084":127888},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3634":75328,"_31331":75292,"_21707":127890,"_5":14945,"_28497":127791,"_3084":127891},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3634":75329,"_31331":75292,"_21707":127893,"_5":14945,"_28497":127794,"_3084":127894},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3634":75330,"_31331":75292,"_21707":127896,"_5":14945,"_28497":127797,"_3084":127897},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3634":75331,"_31331":75292,"_21707":127899,"_5":14945,"_28497":127800,"_3084":127900},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3634":75332,"_31331":75292,"_21707":127902,"_5":14945,"_28497":127800,"_3084":127903},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3634":75333,"_31331":75292,"_21707":127905,"_5":14945,"_28497":127800,"_3084":127906},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3634":75334,"_31331":75292,"_21707":127908,"_5":14945,"_28497":127800,"_3084":127909},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3634":75335,"_31331":75292,"_21707":127911,"_5":14945,"_28497":127803,"_3084":127912},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3634":75336,"_31331":75292,"_21707":127914,"_5":14945,"_28497":127803,"_3084":127915},[],"La tabla incluye los siguientes campos:",{"_3634":75337,"_31331":75292,"_21707":127917,"_5":14945,"_28497":127803,"_3084":127918},[],"**Name**: nombre descriptivo de la clave.",{"_3634":75338,"_31331":75292,"_21707":127920,"_5":14945,"_28497":127803,"_3084":127921},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3634":75339,"_31331":75292,"_21707":127923,"_5":14945,"_28497":127803,"_3084":127924},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3634":75340,"_31331":75292,"_21707":127926,"_5":14945,"_28497":127803,"_3084":127927},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3634":75341,"_31331":75292,"_21707":127929,"_5":14945,"_28497":127803,"_3084":127930},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3634":75342,"_31331":75292,"_21707":127932,"_5":14945,"_28497":127803,"_3084":127933},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3634":75343,"_31331":75292,"_21707":127935,"_5":14945,"_28497":127803,"_3084":127936},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3634":75344,"_31331":75292,"_21707":127938,"_5":14945,"_28497":127803,"_3084":127939},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3634":75345,"_31331":75292,"_21707":127941,"_5":14945,"_28497":127803,"_3084":127942},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3634":75346,"_31331":75292,"_21707":127944,"_5":14945,"_28497":127803,"_3084":127945},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3634":75347,"_31331":75292,"_21707":127947,"_5":14945,"_28497":127803,"_3084":127948},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3634":75348,"_31331":75292,"_21707":127950,"_5":14945,"_28497":127803,"_3084":127951},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3634":75349,"_31331":75292,"_21707":127953,"_5":14945,"_28497":127803,"_3084":127954},[],"**Delete Key** para eliminar la clave del sistema.",{"_3634":75350,"_31331":75292,"_21707":127956,"_5":14945,"_28497":127807,"_3084":127957},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3634":75351,"_31331":75292,"_21707":127959,"_5":14945,"_28497":127811,"_3084":127960},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3634":75352,"_31331":75292,"_21707":127962,"_5":14945,"_28497":127811,"_3084":127963},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3634":75353,"_31331":75292,"_21707":127965,"_5":14945,"_28497":127811,"_3084":127966},[],"**Key Name**: nombre único y descriptivo.",{"_3634":75354,"_31331":75292,"_21707":127968,"_5":14945,"_28497":127811,"_3084":127969},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3634":75355,"_31331":75292,"_21707":127971,"_5":14945,"_28497":127811,"_3084":127972},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3634":75356,"_31331":75292,"_21707":127974,"_5":14945,"_28497":127811,"_3084":127975},[],"**Tags**: metadatos para clasificar la clave.",{"_3634":75357,"_31331":75292,"_21707":127977,"_5":14945,"_28497":127811,"_3084":127978},[],"**Metadata**: información adicional para usos avanzados.",{"_3634":75358,"_31331":75292,"_21707":127980,"_5":14945,"_28497":127815,"_3084":127981},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3634":75359,"_31331":75292,"_21707":127983,"_5":14945,"_28497":127815,"_3084":127984},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3634":75360,"_31331":75292,"_21707":127986,"_5":14945,"_28497":127815,"_3084":127987},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3634":75361,"_31331":75292,"_21707":127989,"_5":14945,"_28497":127815,"_3084":127990},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3634":75362,"_31331":75292,"_21707":127992,"_5":14945,"_28497":127815,"_3084":127993},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3634":75363,"_31331":75292,"_21707":127995,"_5":14945,"_28497":127815,"_3084":127996},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3634":75364,"_31331":75292,"_21707":127998,"_5":14945,"_28497":127815,"_3084":127999},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3634":75365,"_31331":75292,"_21707":128001,"_5":14945,"_28497":127815,"_3084":128002},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3634":75366,"_31331":75292,"_21707":128004,"_5":14945,"_28497":127815,"_3084":128005},[],"**Metadata**: información adicional opcional.",{"_3634":75367,"_31331":75292,"_21707":128007,"_5":14945,"_28497":127815,"_3084":128008},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3634":75368,"_31331":75292,"_21707":128010,"_5":14945,"_28497":127815,"_3084":128011},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3634":75369,"_31331":75292,"_21707":128013,"_5":14945,"_28497":127819,"_3084":128014},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3634":75370,"_31331":75292,"_21707":128016,"_5":14945,"_28497":127823,"_3084":128017},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3634":75371,"_31331":75292,"_21707":128019,"_5":14945,"_28497":127823,"_3084":128020},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3634":75372,"_31331":75292,"_21707":128022,"_5":14945,"_28497":127823,"_3084":128023},[],"**Key Name**: nombre descriptivo.",{"_3634":75373,"_31331":75292,"_21707":128025,"_5":14945,"_28497":127823,"_3084":128026},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3634":75374,"_31331":75292,"_21707":128028,"_5":14945,"_28497":127823,"_3084":128029},[],"**Tags**: etiquetas asociadas.",{"_3634":75375,"_31331":75292,"_21707":128031,"_5":14945,"_28497":127823,"_3084":128032},[],"**Aliases**: nombres alternativos.",{"_3634":75376,"_31331":75292,"_21707":128034,"_5":14945,"_28497":127823,"_3084":128035},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3634":75377,"_31331":75292,"_21707":128037,"_5":14945,"_28497":127823,"_3084":128038},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3634":75378,"_31331":75292,"_21707":128040,"_5":14945,"_28497":127823,"_3084":128041},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3634":75379,"_31331":75292,"_21707":128043,"_5":14945,"_28497":127823,"_3084":128044},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3634":75380,"_31331":75292,"_21707":128046,"_5":14945,"_28497":127827,"_3084":128047},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3634":75381,"_31331":75292,"_21707":128049,"_5":14945,"_28497":127827,"_3084":128050},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3634":75382,"_31331":75292,"_21707":128052,"_5":14945,"_28497":127827,"_3084":128053},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3634":75383,"_31331":75292,"_21707":128055,"_5":14945,"_28497":127831,"_3084":128056},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3634":75384,"_31331":75292,"_21707":128058,"_5":14945,"_28497":127831,"_3084":128059},[],"Campos principales:",{"_3634":75385,"_31331":75292,"_21707":128061,"_5":14945,"_28497":127831,"_3084":128062},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3634":75386,"_31331":75292,"_21707":128064,"_5":14945,"_28497":127831,"_3084":128065},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3634":75387,"_31331":75292,"_21707":128067,"_5":14945,"_28497":127831,"_3084":128068},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3634":75388,"_31331":75292,"_21707":128070,"_5":14945,"_28497":127831,"_3084":128071},[],"**Message**: contenido que se va a firmar.",{"_3634":75389,"_31331":75292,"_21707":128073,"_5":14945,"_28497":127831,"_3084":128074},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3634":75390,"_31331":75292,"_21707":128076,"_5":14945,"_28497":127834,"_3084":128077},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3634":75391,"_31331":75292,"_21707":128079,"_5":14945,"_28497":127834,"_3084":128059},[],{"_3634":75392,"_31331":75292,"_21707":128081,"_5":14945,"_28497":127834,"_3084":128082},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3634":75393,"_31331":75292,"_21707":128084,"_5":14945,"_28497":127834,"_3084":128085},[],"**Message Type**: `Raw` o `Digest`.",{"_3634":75394,"_31331":75292,"_21707":128087,"_5":14945,"_28497":127834,"_3084":128088},[],"**Payload Encoding**: codificación del mensaje.",{"_3634":75395,"_31331":75292,"_21707":128090,"_5":14945,"_28497":127834,"_3084":128091},[],"**Message**: mensaje original o hash.",{"_3634":75396,"_31331":75292,"_21707":128093,"_5":14945,"_28497":127834,"_3084":128094},[],"**Signature**: firma que se desea comprobar.",{"_3634":75397,"_31331":75292,"_21707":128096,"_5":14945,"_28497":127834,"_3084":128097},[],"**Result**: indicador del resultado de la validación.",{"_3634":75398,"_31331":75292,"_21707":128099,"_5":14945,"_28497":127837,"_3084":128100},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3634":75399,"_31331":75292,"_21707":128102,"_5":14945,"_28497":127837,"_3084":128103},[],"Este flujo es útil para:",{"_3634":75400,"_31331":75292,"_21707":128105,"_5":14945,"_28497":127837,"_3084":128106},[],"Solicitar certificados a una CA externa.",{"_3634":75401,"_31331":75292,"_21707":128108,"_5":14945,"_28497":127837,"_3084":128109},[],"Renovar una identidad manteniendo la misma clave.",{"_3634":75402,"_31331":75292,"_21707":128111,"_5":14945,"_28497":127837,"_3084":128112},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3634":75403,"_31331":75292,"_21707":128114,"_5":14945,"_28497":127837,"_3084":128115},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3634":75404,"_31331":75292,"_21707":128117,"_5":14945,"_28497":127837,"_3084":128118},[],"**Organization (O)**: organización o empresa.",{"_3634":75405,"_31331":75292,"_21707":128120,"_5":14945,"_28497":127837,"_3084":128121},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3634":75406,"_31331":75292,"_21707":128123,"_5":14945,"_28497":127837,"_3084":128124},[],"**Country (C)**: código de país de dos letras.",{"_3634":75407,"_31331":75292,"_21707":128126,"_5":14945,"_28497":127837,"_3084":128127},[],"**State / Province (ST)**: estado o provincia.",{"_3634":75408,"_31331":75292,"_21707":128129,"_5":14945,"_28497":127837,"_3084":128130},[],"**Locality (L)**: ciudad o localidad.",{"_3634":75409,"_31331":75292,"_21707":128132,"_5":14945,"_28497":127837,"_3084":128133},[],"**Email Address**: correo de contacto.",{"_3634":75410,"_31331":75292,"_21707":128135,"_5":14945,"_28497":127837,"_3084":128136},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3634":75411,"_31331":75292,"_21707":128138,"_5":14945,"_28497":127837,"_3084":128139},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3634":75412,"_31331":75292,"_21707":128141,"_5":14945,"_28497":127841,"_3084":128142},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3634":75413,"_31331":75292,"_21707":128144,"_5":14945,"_28497":127841,"_3084":128145},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3634":75414,"_31331":75292,"_21707":128147,"_5":14945,"_28497":127845,"_3084":128148},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3634":75415,"_31331":75292,"_21707":128150,"_5":14945,"_28497":127845,"_3084":128151},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3634":75416,"_31331":75416,"_5":15305,"_3084":128153,"_31690":128154,"_21707":128155,"_28497":75416},"Validación online con OCSP",[51145,122216,56831,126909],[],{"_3634":75417,"_31331":75416,"_21707":128157,"_5":14945,"_28497":75416,"_3084":128158},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3634":75418,"_31331":75416,"_5":31687,"_21707":128160,"_28497":128161,"_3084":128162},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3634":75419,"_31331":75416,"_5":31687,"_21707":128164,"_28497":128165,"_3084":128166},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3634":75420,"_31331":75416,"_5":31687,"_21707":128168,"_28497":128169,"_3084":128170},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3634":75421,"_31331":75416,"_5":31687,"_21707":128172,"_28497":128173,"_3084":128174},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3634":75422,"_31331":75416,"_5":31687,"_21707":128176,"_28497":128177,"_3084":128178},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3634":75423,"_31331":75416,"_5":31687,"_21707":128180,"_28497":128181,"_3084":127472},[],"/docs/pr-preview/pr-81/es/platform/pki/ocsp#referencias",{"_3634":75424,"_31331":75416,"_21707":128183,"_5":14945,"_28497":75416,"_3084":128184},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3634":75425,"_31331":75416,"_21707":128186,"_5":14945,"_28497":128161,"_3084":128187},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3634":75426,"_31331":75416,"_21707":128189,"_5":14945,"_28497":128161,"_3084":128190},[],"Estado del registro",{"_3634":75427,"_31331":75416,"_21707":128192,"_5":14945,"_28497":128161,"_3084":128193},[],"Respuesta firmada",{"_3634":75428,"_31331":75416,"_21707":128195,"_5":14945,"_28497":128161,"_3084":55968},[],{"_3634":75429,"_31331":75416,"_21707":128197,"_5":14945,"_28497":128161,"_3084":58818},[],{"_3634":75430,"_31331":75416,"_21707":128199,"_5":14945,"_28497":128161,"_3084":55985},[],{"_3634":75431,"_31331":75416,"_21707":128201,"_5":14945,"_28497":128161,"_3084":128202},[],"`Revoked`, con razón y fecha de revocación.",{"_3634":75432,"_31331":75416,"_21707":128204,"_5":14945,"_28497":128161,"_3084":128205},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3634":75433,"_31331":75416,"_21707":128207,"_5":14945,"_28497":128161,"_3084":128208},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3634":75434,"_31331":75416,"_21707":128210,"_5":14945,"_28497":128161,"_3084":128211},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3634":75435,"_31331":75416,"_21707":128213,"_5":14945,"_28497":128161,"_3084":128214},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3634":75436,"_31331":75416,"_21707":128216,"_5":14945,"_28497":128161,"_3084":128217},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3634":75437,"_31331":75416,"_21707":128219,"_5":14945,"_28497":128165,"_3084":128220},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3634":75438,"_31331":75416,"_21707":128222,"_5":14945,"_28497":128165,"_3084":128223},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3634":75439,"_31331":75416,"_21707":128225,"_5":14945,"_28497":128169,"_3084":128226},[],"El servicio acepta:",{"_3634":75440,"_31331":75416,"_21707":128228,"_5":14945,"_28497":128169,"_3084":124091},[],{"_3634":75441,"_31331":75416,"_21707":128230,"_5":14945,"_28497":128169,"_3084":128231},[],"Ruta del servicio VA",{"_3634":75442,"_31331":75416,"_21707":128233,"_5":14945,"_28497":128169,"_3084":128234},[],"Formato",{"_3634":75443,"_31331":75416,"_21707":128236,"_5":14945,"_28497":128169,"_3084":58858},[],{"_3634":75444,"_31331":75416,"_21707":128238,"_5":14945,"_28497":128169,"_3084":58861},[],{"_3634":75445,"_31331":75416,"_21707":128240,"_5":14945,"_28497":128169,"_3084":128241},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3634":75446,"_31331":75416,"_21707":128243,"_5":14945,"_28497":128169,"_3084":58253},[],{"_3634":75447,"_31331":75416,"_21707":128245,"_5":14945,"_28497":128169,"_3084":58869},[],{"_3634":75448,"_31331":75416,"_21707":128247,"_5":14945,"_28497":128169,"_3084":128248},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3634":75449,"_31331":75416,"_21707":128250,"_5":14945,"_28497":128169,"_3084":128251},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3634":75450,"_31331":75416,"_21707":128253,"_5":14945,"_28497":128173,"_3084":128254},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3634":75451,"_31331":75416,"_21707":128256,"_5":14945,"_28497":128173,"_3084":128257},[],"Genera la solicitud:",{"_3634":75452,"_31331":75416,"_21707":128259,"_5":14945,"_28497":128173,"_3084":128260},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3634":75453,"_31331":75416,"_21707":128262,"_5":14945,"_28497":128173,"_3084":128263},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3634":75454,"_31331":75416,"_21707":128265,"_5":14945,"_28497":128173,"_3084":128266},[],"Verifica el DER recibido:",{"_3634":75455,"_31331":75416,"_21707":128268,"_5":14945,"_28497":128173,"_3084":128269},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3634":75456,"_31331":75416,"_21707":128271,"_5":14945,"_28497":128177,"_3084":128272},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3634":75457,"_31331":75416,"_21707":128274,"_5":14945,"_28497":128177,"_3084":128275},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3634":75458,"_31331":75416,"_21707":128277,"_5":14945,"_28497":128181,"_3084":58902},[],{"_3634":75459,"_31331":75416,"_21707":128279,"_5":14945,"_28497":128181,"_3084":58905},[],{"_3634":75460,"_31331":75416,"_21707":128281,"_5":14945,"_28497":128181,"_3084":128282},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3634":75461,"_31331":75416,"_21707":128284,"_5":14945,"_28497":128181,"_3084":127767},[],{"_3634":75462,"_31331":75462,"_5":15305,"_3084":56831,"_31690":128286,"_21707":128287,"_28497":75462},[51145,122216,56831],[],{"_3634":75463,"_31331":75462,"_21707":128289,"_5":14945,"_28497":75462,"_3084":128290},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3634":75464,"_31331":75462,"_5":31687,"_21707":128292,"_28497":128293,"_3084":125564},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#empieza-aquí",{"_3634":75465,"_31331":75462,"_5":31687,"_21707":128295,"_28497":128296,"_3084":128297},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3634":75466,"_31331":75462,"_5":31687,"_21707":128299,"_28497":128300,"_3084":126084},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#capacidades-principales",{"_3634":75467,"_31331":75462,"_5":31687,"_21707":128302,"_28497":128303,"_3084":126088},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3634":75468,"_31331":75462,"_5":31687,"_21707":128305,"_28497":128306,"_3084":126092},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3634":75469,"_31331":75462,"_5":31687,"_21707":128308,"_28497":128309,"_3084":126096},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#emite-y-controla-certificados",{"_3634":75470,"_31331":75462,"_5":31687,"_21707":128311,"_28497":128312,"_3084":126104},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#publica-el-estado-de-validación",{"_3634":75471,"_31331":75462,"_5":31687,"_21707":128314,"_28497":128315,"_3084":128316},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3634":75472,"_31331":75462,"_5":31687,"_21707":128318,"_28497":128319,"_3084":127075},[],"/docs/pr-preview/pr-81/es/platform/pki/overview#continúa",{"_3634":75473,"_31331":75462,"_21707":128321,"_5":14945,"_28497":75462,"_3084":128322},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3634":75474,"_31331":75462,"_21707":128324,"_5":14945,"_28497":128293,"_3084":128325},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3634":75475,"_31331":75462,"_21707":128327,"_5":14945,"_28497":128293,"_3084":128328},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3634":75476,"_31331":75462,"_21707":128330,"_5":14945,"_28497":128296,"_3084":128331},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3634":75477,"_31331":75462,"_21707":128333,"_5":14945,"_28497":128296,"_3084":128334},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3634":75478,"_31331":75462,"_21707":128336,"_5":14945,"_28497":128296,"_3084":128337},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3634":75479,"_31331":75462,"_21707":128339,"_5":14945,"_28497":128296,"_3084":128340},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3634":75480,"_31331":75462,"_21707":128342,"_5":14945,"_28497":128296,"_3084":128343},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3634":75481,"_31331":75462,"_21707":128345,"_5":14945,"_28497":128303,"_3084":128346},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3634":75482,"_31331":75462,"_21707":128348,"_5":14945,"_28497":128306,"_3084":128349},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3634":75483,"_31331":75462,"_21707":128351,"_5":14945,"_28497":128309,"_3084":128352},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3634":75484,"_31331":75462,"_21707":128354,"_5":14945,"_28497":128312,"_3084":128355},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3634":75485,"_31331":75462,"_21707":128357,"_5":14945,"_28497":128315,"_3084":128358},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3634":75486,"_31331":75462,"_21707":128360,"_5":14945,"_28497":128315,"_3084":128361},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3634":75487,"_31331":75462,"_21707":128363,"_5":14945,"_28497":128315,"_3084":128364},[],"su clave pública corresponda a la clave privada del cliente;",{"_3634":75488,"_31331":75462,"_21707":128366,"_5":14945,"_28497":128315,"_3084":128367},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3634":75489,"_31331":75462,"_21707":128369,"_5":14945,"_28497":128315,"_3084":128370},[],"sus fechas y usos permitan la operación;",{"_3634":75490,"_31331":75462,"_21707":128372,"_5":14945,"_28497":128315,"_3084":128373},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3634":75491,"_31331":75462,"_21707":128375,"_5":14945,"_28497":128315,"_3084":128376},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3634":75492,"_31331":75462,"_21707":128378,"_5":14945,"_28497":128319,"_3084":128379},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":75493,"_31331":75462,"_21707":128381,"_5":14945,"_28497":128319,"_3084":128382},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3634":75494,"_31331":75462,"_21707":128384,"_5":14945,"_28497":128319,"_3084":128385},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3634":75495,"_31331":75495,"_5":15305,"_3084":128387,"_31690":128388,"_21707":128389,"_28497":75495},"Crea tu primera CA",[51145,122216,56831,125688],[],{"_3634":75496,"_31331":75495,"_21707":128391,"_5":14945,"_28497":75495,"_3084":128392},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3634":75497,"_31331":75495,"_5":31687,"_21707":128394,"_28497":128395,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3634":75498,"_31331":75495,"_5":31687,"_21707":128397,"_28497":128398,"_3084":128399},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3634":75499,"_31331":75495,"_5":31687,"_21707":128401,"_28497":128402,"_3084":128403},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3634":75500,"_31331":75495,"_5":31687,"_21707":128405,"_28497":128406,"_3084":128407},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3634":75501,"_31331":75495,"_5":31687,"_21707":128409,"_28497":128410,"_3084":128411},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3634":75502,"_31331":75495,"_5":31687,"_21707":128413,"_28497":128414,"_3084":128415},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3634":75503,"_31331":75495,"_5":31687,"_21707":128417,"_28497":128418,"_3084":128419},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3634":75504,"_31331":75495,"_5":31687,"_21707":128421,"_28497":128422,"_3084":125935},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3634":75505,"_31331":75495,"_5":31687,"_21707":128424,"_28497":128425,"_3084":120774},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3634":75506,"_31331":75495,"_21707":128427,"_5":14945,"_28497":75495,"_3084":128428},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3634":75507,"_31331":75495,"_21707":128430,"_5":14945,"_28497":128395,"_3084":128431},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3634":75508,"_31331":75495,"_21707":128433,"_5":14945,"_28497":128395,"_3084":128434},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3634":75509,"_31331":75495,"_21707":128436,"_5":14945,"_28497":128395,"_3084":128437},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3634":75510,"_31331":75495,"_21707":128439,"_5":14945,"_28497":128395,"_3084":128440},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3634":75511,"_31331":75495,"_21707":128442,"_5":14945,"_28497":128398,"_3084":128443},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3634":75512,"_31331":75495,"_21707":128445,"_5":14945,"_28497":128398,"_3084":128446},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3634":75513,"_31331":75495,"_21707":128448,"_5":14945,"_28497":128402,"_3084":128449},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3634":75514,"_31331":75495,"_21707":128451,"_5":14945,"_28497":128402,"_3084":128452},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3634":75515,"_31331":75495,"_21707":128454,"_5":14945,"_28497":128406,"_3084":128455},[],"Selecciona **Root CA** y completa:",{"_3634":75516,"_31331":75495,"_21707":128457,"_5":14945,"_28497":128406,"_3084":59084},[],{"_3634":75517,"_31331":75495,"_21707":128459,"_5":14945,"_28497":128406,"_3084":128460},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3634":75518,"_31331":75495,"_21707":128462,"_5":14945,"_28497":128406,"_3084":128463},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3634":75519,"_31331":75495,"_21707":128465,"_5":14945,"_28497":128406,"_3084":128466},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3634":75520,"_31331":75495,"_21707":128468,"_5":14945,"_28497":128406,"_3084":128469},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3634":75521,"_31331":75495,"_21707":128471,"_5":14945,"_28497":128410,"_3084":128472},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3634":75522,"_31331":75495,"_21707":128474,"_5":14945,"_28497":128414,"_3084":128475},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3634":75523,"_31331":75495,"_21707":128477,"_5":14945,"_28497":128414,"_3084":128478},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3634":75524,"_31331":75495,"_21707":128480,"_5":14945,"_28497":128418,"_3084":128481},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3634":75525,"_31331":75495,"_21707":128483,"_5":14945,"_28497":128418,"_3084":128484},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3634":75526,"_31331":75495,"_21707":128486,"_5":14945,"_28497":128418,"_3084":128487},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3634":75527,"_31331":75495,"_21707":128489,"_5":14945,"_28497":128422,"_3084":128490},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3634":75528,"_31331":75495,"_21707":128492,"_5":14945,"_28497":128422,"_3084":128493},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3634":75529,"_31331":75495,"_21707":128495,"_5":14945,"_28497":128422,"_3084":128496},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3634":75530,"_31331":75495,"_21707":128498,"_5":14945,"_28497":128422,"_3084":128499},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3634":75531,"_31331":75495,"_21707":128501,"_5":14945,"_28497":128425,"_3084":128502},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3634":75532,"_31331":75532,"_5":15305,"_3084":128504,"_31690":128505,"_21707":128506,"_28497":75532},"Emite y verifica un certificado",[51145,122216,56831,125688],[],{"_3634":75533,"_31331":75532,"_21707":128508,"_5":14945,"_28497":75532,"_3084":128509},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3634":75534,"_31331":75532,"_5":31687,"_21707":128511,"_28497":128512,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3634":75535,"_31331":75532,"_5":31687,"_21707":128514,"_28497":128515,"_3084":128516},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3634":75536,"_31331":75532,"_5":31687,"_21707":128518,"_28497":128519,"_3084":128520},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3634":75537,"_31331":75532,"_5":31687,"_21707":128522,"_28497":128523,"_3084":128524},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3634":75538,"_31331":75532,"_5":31687,"_21707":128526,"_28497":128527,"_3084":128528},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3634":75539,"_31331":75532,"_5":31687,"_21707":128530,"_28497":128531,"_3084":128532},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3634":75540,"_31331":75532,"_5":31687,"_21707":128534,"_28497":128535,"_3084":128536},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3634":75541,"_31331":75532,"_5":31687,"_21707":128538,"_28497":128539,"_3084":128540},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3634":75542,"_31331":75532,"_5":31687,"_21707":128542,"_28497":128543,"_3084":128544},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3634":75543,"_31331":75532,"_5":31687,"_21707":128546,"_28497":128547,"_3084":128548},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3634":75544,"_31331":75532,"_5":31687,"_21707":128550,"_28497":128551,"_3084":125935},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3634":75545,"_31331":75532,"_5":31687,"_21707":128553,"_28497":128554,"_3084":120774},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3634":75546,"_31331":75532,"_21707":128556,"_5":14945,"_28497":75532,"_3084":128557},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3634":75547,"_31331":75532,"_21707":128559,"_5":14945,"_28497":128512,"_3084":128560},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3634":75548,"_31331":75532,"_21707":128562,"_5":14945,"_28497":128512,"_3084":128563},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3634":75549,"_31331":75532,"_21707":128565,"_5":14945,"_28497":128512,"_3084":128566},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3634":75550,"_31331":75532,"_21707":128568,"_5":14945,"_28497":128512,"_3084":128569},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3634":75551,"_31331":75532,"_21707":128571,"_5":14945,"_28497":128512,"_3084":128572},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3634":75552,"_31331":75532,"_21707":128574,"_5":14945,"_28497":128515,"_3084":128575},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3634":75553,"_31331":75532,"_21707":128577,"_5":14945,"_28497":128519,"_3084":128578},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3634":75554,"_31331":75532,"_21707":128580,"_5":14945,"_28497":128519,"_3084":128581},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3634":75555,"_31331":75532,"_21707":128583,"_5":14945,"_28497":128523,"_3084":128584},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3634":75556,"_31331":75532,"_21707":128586,"_5":14945,"_28497":128523,"_3084":128587},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3634":75557,"_31331":75532,"_21707":128589,"_5":14945,"_28497":128527,"_3084":128590},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3634":75558,"_31331":75532,"_21707":128592,"_5":14945,"_28497":128527,"_3084":128593},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3634":75559,"_31331":75532,"_21707":128595,"_5":14945,"_28497":128531,"_3084":128596},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3634":75560,"_31331":75532,"_21707":128598,"_5":14945,"_28497":128535,"_3084":128599},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3634":75561,"_31331":75532,"_21707":128601,"_5":14945,"_28497":128539,"_3084":128602},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3634":75562,"_31331":75532,"_21707":128604,"_5":14945,"_28497":128543,"_3084":128605},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3634":75563,"_31331":75532,"_21707":128607,"_5":14945,"_28497":128543,"_3084":128608},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3634":75564,"_31331":75532,"_21707":128610,"_5":14945,"_28497":128543,"_3084":128611},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3634":75565,"_31331":75532,"_21707":128613,"_5":14945,"_28497":128547,"_3084":128614},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3634":75566,"_31331":75532,"_21707":128616,"_5":14945,"_28497":128547,"_3084":128617},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3634":75567,"_31331":75532,"_21707":128619,"_5":14945,"_28497":128547,"_3084":128620},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3634":75568,"_31331":75532,"_21707":128622,"_5":14945,"_28497":128551,"_3084":126018},[],{"_3634":75569,"_31331":75532,"_21707":128624,"_5":14945,"_28497":128551,"_3084":124533},[],{"_3634":75570,"_31331":75532,"_21707":128626,"_5":14945,"_28497":128551,"_3084":128627},[],"La CA rechaza la emisión",{"_3634":75571,"_31331":75532,"_21707":128629,"_5":14945,"_28497":128551,"_3084":128630},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3634":75572,"_31331":75532,"_21707":128632,"_5":14945,"_28497":128551,"_3084":128633},[],"Sujeto o usos diferentes",{"_3634":75573,"_31331":75532,"_21707":128635,"_5":14945,"_28497":128551,"_3084":128636},[],"Perfil aplicado y valores solicitados.",{"_3634":75574,"_31331":75532,"_21707":128638,"_5":14945,"_28497":128551,"_3084":128639},[],"No se encuentra el emisor",{"_3634":75575,"_31331":75532,"_21707":128641,"_5":14945,"_28497":128551,"_3084":128642},[],"CA descargada y cadena intermedia necesaria.",{"_3634":75576,"_31331":75532,"_21707":128644,"_5":14945,"_28497":128551,"_3084":128645},[],"Falla la vigencia",{"_3634":75577,"_31331":75532,"_21707":128647,"_5":14945,"_28497":128551,"_3084":128648},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3634":75578,"_31331":75532,"_21707":128650,"_5":14945,"_28497":128551,"_3084":128651},[],"Los resúmenes de clave difieren",{"_3634":75579,"_31331":75532,"_21707":128653,"_5":14945,"_28497":128551,"_3084":128654},[],"Archivos de certificado y clave de la misma emisión.",{"_3634":75580,"_31331":75532,"_21707":128656,"_5":14945,"_28497":128551,"_3084":128657},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3634":75581,"_31331":75532,"_21707":128659,"_5":14945,"_28497":128554,"_3084":128660},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3634":75582,"_31331":75532,"_21707":128662,"_5":14945,"_28497":128554,"_3084":128663},[],"Gestionar certificados para inspección, estado y revocación.",{"_3634":75583,"_31331":75532,"_21707":128665,"_5":14945,"_28497":128554,"_3084":128666},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3634":75584,"_31331":75532,"_21707":128668,"_5":14945,"_28497":128554,"_3084":128669},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3634":75585,"_31331":75532,"_21707":128671,"_5":14945,"_28497":128554,"_3084":128672},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3634":75586,"_31331":75586,"_5":15305,"_3084":128674,"_31690":128675,"_21707":128676,"_28497":75586},"Primeros pasos de PKI",[51145,122216,56831,125688],[],{"_3634":75587,"_31331":75586,"_21707":128678,"_5":14945,"_28497":75586,"_3084":128679},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3634":75588,"_31331":75586,"_5":31687,"_21707":128681,"_28497":128682,"_3084":120750},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3634":75589,"_31331":75586,"_5":31687,"_21707":128684,"_28497":128685,"_3084":128686},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3634":75590,"_31331":75586,"_5":31687,"_21707":128688,"_28497":128689,"_3084":125870},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3634":75591,"_31331":75586,"_5":31687,"_21707":128691,"_28497":128692,"_3084":128693},[],"/docs/pr-preview/pr-81/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3634":75592,"_31331":75586,"_21707":128695,"_5":14945,"_28497":75586,"_3084":128696},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3634":75593,"_31331":75586,"_21707":128698,"_5":14945,"_28497":128682,"_3084":128699},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3634":75594,"_31331":75586,"_21707":128701,"_5":14945,"_28497":128682,"_3084":128702},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3634":75595,"_31331":75586,"_21707":128704,"_5":14945,"_28497":128682,"_3084":128705},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3634":75596,"_31331":75586,"_21707":128707,"_5":14945,"_28497":128682,"_3084":128708},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3634":75597,"_31331":75586,"_21707":128710,"_5":14945,"_28497":128682,"_3084":128711},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3634":75598,"_31331":75586,"_21707":128713,"_5":14945,"_28497":128685,"_3084":128714},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3634":75599,"_31331":75586,"_21707":128716,"_5":14945,"_28497":128685,"_3084":128717},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3634":75600,"_31331":75586,"_21707":128719,"_5":14945,"_28497":128685,"_3084":128720},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3634":75601,"_31331":75586,"_21707":128722,"_5":14945,"_28497":128685,"_3084":128723},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3634":75602,"_31331":75586,"_21707":128725,"_5":14945,"_28497":128689,"_3084":128726},[],"Archivo o recurso",{"_3634":75603,"_31331":75586,"_21707":128728,"_5":14945,"_28497":128689,"_3084":125867},[],{"_3634":75604,"_31331":75586,"_21707":128730,"_5":14945,"_28497":128689,"_3084":128731},[],"CA raíz activa y `ca.pem`",{"_3634":75605,"_31331":75586,"_21707":128733,"_5":14945,"_28497":128689,"_3084":128734},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3634":75606,"_31331":75586,"_21707":128736,"_5":14945,"_28497":128689,"_3084":128737},[],"Certificado final y `device.crt`",{"_3634":75607,"_31331":75586,"_21707":128739,"_5":14945,"_28497":128689,"_3084":128740},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3634":75608,"_31331":75586,"_21707":128742,"_5":14945,"_28497":128689,"_3084":128743},[],"Clave privada `device.key`",{"_3634":75609,"_31331":75586,"_21707":128745,"_5":14945,"_28497":128689,"_3084":128746},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3634":75610,"_31331":75586,"_21707":128748,"_5":14945,"_28497":128689,"_3084":128749},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3634":75611,"_31331":75586,"_21707":128751,"_5":14945,"_28497":128692,"_3084":128752},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3634":75612,"_31331":75586,"_21707":128754,"_5":14945,"_28497":128692,"_3084":128755},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3634":75613,"_31331":75586,"_21707":128757,"_5":14945,"_28497":128692,"_3084":128758},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3634":75614,"_31331":75614,"_5":15305,"_3084":128760,"_31690":128761,"_21707":128763,"_28497":75614},"Resolución de problemas PKI",[51145,122216,56831,128762],"Resolución de problemas",[],{"_3634":75615,"_31331":75614,"_21707":128765,"_5":14945,"_28497":75614,"_3084":128766},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3634":75616,"_31331":75614,"_5":31687,"_21707":128768,"_28497":128769,"_3084":128770},[],"/docs/pr-preview/pr-81/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3634":75617,"_31331":75614,"_5":31687,"_21707":128772,"_28497":128773,"_3084":128774},[],"/docs/pr-preview/pr-81/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3634":75618,"_31331":75614,"_5":31687,"_21707":128776,"_28497":128777,"_3084":128778},[],"/docs/pr-preview/pr-81/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3634":75619,"_31331":75614,"_21707":128780,"_5":14945,"_28497":75614,"_3084":128781},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3634":75620,"_31331":75614,"_21707":128783,"_5":14945,"_28497":75614,"_3084":128784},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3634":75621,"_31331":75614,"_21707":128786,"_5":14945,"_28497":128769,"_3084":125867},[],{"_3634":75622,"_31331":75614,"_21707":128788,"_5":14945,"_28497":128769,"_3084":124533},[],{"_3634":75623,"_31331":75614,"_21707":128790,"_5":14945,"_28497":128769,"_3084":120774},[],{"_3634":75624,"_31331":75614,"_21707":128792,"_5":14945,"_28497":128769,"_3084":55673},[],{"_3634":75625,"_31331":75614,"_21707":128794,"_5":14945,"_28497":128769,"_3084":128795},[],"Existe, está activa y sus fechas son utilizables.",{"_3634":75626,"_31331":75614,"_21707":128797,"_5":14945,"_28497":128769,"_3084":128798},[],"Autoridades.",{"_3634":75627,"_31331":75614,"_21707":128800,"_5":14945,"_28497":128769,"_3084":128801},[],"Clave",{"_3634":75628,"_31331":75614,"_21707":128803,"_5":14945,"_28497":128769,"_3084":128804},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3634":75629,"_31331":75614,"_21707":128806,"_5":14945,"_28497":128769,"_3084":128807},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3634":75630,"_31331":75614,"_21707":128809,"_5":14945,"_28497":128769,"_3084":59438},[],{"_3634":75631,"_31331":75614,"_21707":128811,"_5":14945,"_28497":128769,"_3084":128812},[],"PEM correcto y firma verificable.",{"_3634":75632,"_31331":75614,"_21707":128814,"_5":14945,"_28497":128769,"_3084":59444},[],{"_3634":75633,"_31331":75614,"_21707":128816,"_5":14945,"_28497":128769,"_3084":128817},[],"Perfil",{"_3634":75634,"_31331":75614,"_21707":128819,"_5":14945,"_28497":128769,"_3084":128820},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3634":75635,"_31331":75614,"_21707":128822,"_5":14945,"_28497":128769,"_3084":128823},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3634":75636,"_31331":75614,"_21707":128825,"_5":14945,"_28497":128769,"_3084":126018},[],{"_3634":75637,"_31331":75614,"_21707":128827,"_5":14945,"_28497":128769,"_3084":128828},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3634":75638,"_31331":75614,"_21707":128830,"_5":14945,"_28497":128769,"_3084":128831},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3634":75639,"_31331":75614,"_21707":128833,"_5":14945,"_28497":128769,"_3084":128834},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3634":75640,"_31331":75614,"_21707":128836,"_5":14945,"_28497":128769,"_3084":128837},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3634":75641,"_31331":75614,"_21707":128839,"_5":14945,"_28497":128769,"_3084":128840},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3634":75642,"_31331":75614,"_21707":128842,"_5":14945,"_28497":128773,"_3084":128843},[],"Revisa cada frontera por separado:",{"_3634":75643,"_31331":75614,"_21707":128845,"_5":14945,"_28497":128773,"_3084":128846},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3634":75644,"_31331":75614,"_21707":128848,"_5":14945,"_28497":128773,"_3084":128849},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3634":75645,"_31331":75614,"_21707":128851,"_5":14945,"_28497":128773,"_3084":128852},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3634":75646,"_31331":75614,"_21707":128854,"_5":14945,"_28497":128773,"_3084":128855},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3634":75647,"_31331":75614,"_21707":128857,"_5":14945,"_28497":128773,"_3084":128858},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3634":75648,"_31331":75614,"_21707":128860,"_5":14945,"_28497":128773,"_3084":128861},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3634":75649,"_31331":75614,"_21707":128863,"_5":14945,"_28497":128777,"_3084":128864},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3634":75650,"_31331":75614,"_21707":128866,"_5":14945,"_28497":128777,"_3084":128867},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3634":75651,"_31331":75651,"_5":15305,"_3084":128869,"_31690":128870,"_21707":128871,"_28497":75651},"Seguridad",[51145],[],{"_3634":75652,"_31331":75651,"_21707":128873,"_5":14945,"_28497":75651,"_3084":128874},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3634":75653,"_31331":75651,"_5":31687,"_21707":128876,"_28497":128877,"_3084":128878},[],"/docs/pr-preview/pr-81/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3634":75654,"_31331":75651,"_5":31687,"_21707":128880,"_28497":128881,"_3084":128882},[],"/docs/pr-preview/pr-81/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3634":75655,"_31331":75651,"_5":31687,"_21707":128884,"_28497":128885,"_3084":128886},[],"/docs/pr-preview/pr-81/es/security#versiones-soportadas","Versiones soportadas",{"_3634":75656,"_31331":75651,"_5":31687,"_21707":128888,"_28497":128889,"_3084":128890},[],"/docs/pr-preview/pr-81/es/security#divulgación-responsable","Divulgación responsable",{"_3634":75657,"_31331":75651,"_21707":128892,"_5":14945,"_28497":75651,"_3084":128893},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3634":75658,"_31331":75651,"_21707":128895,"_5":14945,"_28497":128877,"_3084":128896},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3634":75659,"_31331":75651,"_21707":128898,"_5":14945,"_28497":128877,"_3084":128899},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3634":75660,"_31331":75651,"_21707":128901,"_5":14945,"_28497":128877,"_3084":15584},[],{"_3634":75661,"_31331":75651,"_21707":128903,"_5":14945,"_28497":128877,"_3084":15513},[],{"_3634":75662,"_31331":75651,"_21707":128905,"_5":14945,"_28497":128877,"_3084":15571},[],{"_3634":75663,"_31331":75651,"_21707":128907,"_5":14945,"_28497":128877,"_3084":128908},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3634":75664,"_31331":75651,"_21707":128910,"_5":14945,"_28497":128877,"_3084":128911},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3634":75665,"_31331":75651,"_21707":128913,"_5":14945,"_28497":128881,"_3084":128914},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3634":75666,"_31331":75651,"_21707":128916,"_5":14945,"_28497":128881,"_3084":128917},[],"No incluyas en el reporte:",{"_3634":75667,"_31331":75651,"_21707":128919,"_5":14945,"_28497":128881,"_3084":128920},[],"Credenciales, tokens o claves privadas",{"_3634":75668,"_31331":75651,"_21707":128922,"_5":14945,"_28497":128881,"_3084":128923},[],"Datos de clientes o información identificable de clientes",{"_3634":75669,"_31331":75651,"_21707":128925,"_5":14945,"_28497":128881,"_3084":128926},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3634":75670,"_31331":75651,"_21707":128928,"_5":14945,"_28497":128885,"_3084":128929},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3634":75671,"_31331":75651,"_21707":128931,"_5":14945,"_28497":128885,"_3084":128932},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3634":75672,"_31331":75651,"_21707":128934,"_5":14945,"_28497":128889,"_3084":128935},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3634":75673,"_31331":75651,"_21707":128937,"_5":14945,"_28497":128889,"_3084":128938},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3634":75674,"_31331":75651,"_21707":128940,"_5":14945,"_28497":128889,"_3084":128941},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3634":75675,"_31331":75651,"_21707":128943,"_5":14945,"_28497":128889,"_3084":128944},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3634":75676,"_31331":75651,"_21707":128946,"_5":14945,"_28497":128889,"_3084":128947},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3634":75677,"_31331":75677,"_5":15305,"_3084":128949,"_31690":128950,"_21707":128952,"_28497":75677},"3.8.0 a 4.0.0",[51145,128951],"Actualizaciones",[],{"_3634":75678,"_31331":75677,"_21707":128954,"_5":14945,"_28497":75677,"_3084":128955},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3634":75679,"_31331":75677,"_5":31687,"_21707":128957,"_28497":128958,"_3084":128959},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3634":75680,"_31331":75677,"_5":31687,"_21707":128961,"_28497":128962,"_3084":128963},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3634":75681,"_31331":75677,"_5":31687,"_21707":128965,"_28497":128966,"_3084":128967},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3634":75682,"_31331":75677,"_5":31687,"_21707":128969,"_28497":128970,"_3084":128971},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3634":75683,"_31331":75677,"_5":31687,"_21707":128973,"_28497":128974,"_3084":128975},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3634":75684,"_31331":75677,"_5":31687,"_21707":128977,"_28497":128978,"_3084":128979},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3634":75685,"_31331":75677,"_5":31687,"_21707":128981,"_28497":128982,"_3084":59613},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3634":75686,"_31331":75677,"_5":31687,"_21707":128984,"_28497":128985,"_3084":128986},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3634":75687,"_31331":75677,"_5":31687,"_21707":128988,"_28497":128989,"_3084":128990},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3634":75688,"_31331":75677,"_5":31687,"_21707":128992,"_28497":128993,"_3084":128994},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3634":75689,"_31331":75677,"_5":31687,"_21707":128996,"_28497":128997,"_3084":121345},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3634":75690,"_31331":75677,"_5":31687,"_21707":128999,"_28497":129000,"_3084":129001},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3634":75691,"_31331":75677,"_5":31687,"_21707":129003,"_28497":129004,"_3084":129005},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3634":75692,"_31331":75677,"_5":31687,"_21707":129007,"_28497":129008,"_3084":129009},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3634":75693,"_31331":75677,"_5":31687,"_21707":129011,"_28497":129012,"_3084":129013},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3634":75694,"_31331":75677,"_5":31687,"_21707":129015,"_28497":129016,"_3084":129017},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3634":75695,"_31331":75677,"_5":31687,"_21707":129019,"_28497":129020,"_3084":129021},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3634":75696,"_31331":75677,"_5":31687,"_21707":129023,"_28497":129024,"_3084":129025},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3634":75697,"_31331":75677,"_5":31687,"_21707":129027,"_28497":129028,"_3084":129029},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3634":75698,"_31331":75677,"_5":31687,"_21707":129031,"_28497":129032,"_3084":129033},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3634":75699,"_31331":75677,"_5":31687,"_21707":129035,"_28497":129036,"_3084":129037},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3634":75700,"_31331":75677,"_5":31687,"_21707":129039,"_28497":129040,"_3084":129041},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3634":75701,"_31331":75677,"_5":31687,"_21707":129043,"_28497":129044,"_3084":129045},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3634":75702,"_31331":75677,"_5":31687,"_21707":129047,"_28497":129048,"_3084":129049},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3634":75703,"_31331":75677,"_5":31687,"_21707":129051,"_28497":129052,"_3084":129053},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3634":75704,"_31331":75677,"_5":31687,"_21707":129055,"_28497":129056,"_3084":129057},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3634":75705,"_31331":75677,"_5":31687,"_21707":129059,"_28497":129060,"_3084":129061},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3634":75706,"_31331":75677,"_5":31687,"_21707":129063,"_28497":129064,"_3084":129065},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3634":75707,"_31331":75677,"_5":31687,"_21707":129067,"_28497":129068,"_3084":129069},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3634":75708,"_31331":75677,"_5":31687,"_21707":129071,"_28497":129072,"_3084":129073},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3634":75709,"_31331":75677,"_5":31687,"_21707":129075,"_28497":129076,"_3084":129077},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3634":75710,"_31331":75677,"_5":31687,"_21707":129079,"_28497":129080,"_3084":129081},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3634":75711,"_31331":75677,"_5":31687,"_21707":129083,"_28497":129084,"_3084":129085},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3634":75712,"_31331":75677,"_5":31687,"_21707":129087,"_28497":129088,"_3084":129089},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3634":75713,"_31331":75677,"_5":31687,"_21707":129091,"_28497":129092,"_3084":129093},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3634":75714,"_31331":75677,"_5":31687,"_21707":129095,"_28497":129096,"_3084":129097},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3634":75715,"_31331":75677,"_5":31687,"_21707":129099,"_28497":129100,"_3084":129101},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3634":75716,"_31331":75677,"_5":31687,"_21707":129103,"_28497":129104,"_3084":129105},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3634":75717,"_31331":75677,"_5":31687,"_21707":129107,"_28497":129108,"_3084":129109},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3634":75718,"_31331":75677,"_5":31687,"_21707":129111,"_28497":129112,"_3084":129113},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3634":75719,"_31331":75677,"_5":31687,"_21707":129115,"_28497":129116,"_3084":129117},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3634":75720,"_31331":75677,"_5":31687,"_21707":129119,"_28497":129120,"_3084":129121},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3634":75721,"_31331":75677,"_5":31687,"_21707":129123,"_28497":129124,"_3084":129125},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3634":75722,"_31331":75677,"_5":31687,"_21707":129127,"_28497":129128,"_3084":129129},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3634":75723,"_31331":75677,"_5":31687,"_21707":129131,"_28497":129132,"_3084":124881},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3634":75724,"_31331":75677,"_5":31687,"_21707":129134,"_28497":129135,"_3084":129136},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3634":75725,"_31331":75677,"_5":31687,"_21707":129138,"_28497":129139,"_3084":129140},[],"/docs/pr-preview/pr-81/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3634":75726,"_31331":75677,"_21707":129142,"_5":14945,"_28497":75677,"_3084":129143},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3634":75727,"_31331":75677,"_21707":129145,"_5":14945,"_28497":75677,"_3084":129146},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3634":75728,"_31331":75677,"_21707":129148,"_5":14945,"_28497":75677,"_3084":129149},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3634":75729,"_31331":75677,"_21707":129151,"_5":14945,"_28497":75677,"_3084":129152},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3634":75730,"_31331":75677,"_21707":129154,"_5":14945,"_28497":75677,"_3084":129155},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3634":75731,"_31331":75677,"_21707":129157,"_5":14945,"_28497":75677,"_3084":129158},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3634":75732,"_31331":75677,"_21707":129160,"_5":14945,"_28497":75677,"_3084":129161},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3634":75733,"_31331":75677,"_21707":129163,"_5":14945,"_28497":128962,"_3084":129164},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3634":75734,"_31331":75677,"_21707":129166,"_5":14945,"_28497":128962,"_3084":129167},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3634":75735,"_31331":75677,"_21707":129169,"_5":14945,"_28497":128966,"_3084":129170},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3634":75736,"_31331":75677,"_21707":129172,"_5":14945,"_28497":128966,"_3084":129173},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3634":75737,"_31331":75677,"_21707":129175,"_5":14945,"_28497":128970,"_3084":129176},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP, que en AMQP el broker elimina automáticamente cuando la instancia se detiene (véase Eventos de dispositivo).",{"_3634":75738,"_31331":75677,"_21707":129178,"_5":14945,"_28497":128974,"_3084":129179},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3634":75739,"_31331":75677,"_21707":129181,"_5":14945,"_28497":128974,"_3084":129182},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3634":75740,"_31331":75677,"_21707":129184,"_5":14945,"_28497":128974,"_3084":129185},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3634":75741,"_31331":75677,"_21707":129187,"_5":14945,"_28497":128974,"_3084":129188},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3634":75742,"_31331":75677,"_21707":129190,"_5":14945,"_28497":128974,"_3084":129191},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3634":75743,"_31331":75677,"_21707":129193,"_5":14945,"_28497":128978,"_3084":129194},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3634":75744,"_31331":75677,"_21707":129196,"_5":14945,"_28497":128978,"_3084":129197},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3634":75745,"_31331":75677,"_21707":129199,"_5":14945,"_28497":128978,"_3084":129200},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3634":75746,"_31331":75677,"_21707":129202,"_5":14945,"_28497":128978,"_3084":129203},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3634":75747,"_31331":75677,"_21707":129205,"_5":14945,"_28497":128978,"_3084":129206},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3634":75748,"_31331":75677,"_21707":129208,"_5":14945,"_28497":128978,"_3084":129209},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3634":75749,"_31331":75677,"_21707":129211,"_5":14945,"_28497":128982,"_3084":129212},[],"Cambio",{"_3634":75750,"_31331":75677,"_21707":129214,"_5":14945,"_28497":128982,"_3084":129215},[],"A quién afecta",{"_3634":75751,"_31331":75677,"_21707":129217,"_5":14945,"_28497":128982,"_3084":129218},[],"Gravedad",{"_3634":75752,"_31331":75677,"_21707":129220,"_5":14945,"_28497":128982,"_3084":127691},[],{"_3634":75753,"_31331":75677,"_21707":129222,"_5":14945,"_28497":128982,"_3084":128990},[],{"_3634":75754,"_31331":75677,"_21707":129224,"_5":14945,"_28497":128982,"_3084":129225},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3634":75755,"_31331":75677,"_21707":129227,"_5":14945,"_28497":128982,"_3084":129228},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3634":75756,"_31331":75677,"_21707":129230,"_5":14945,"_28497":128982,"_3084":129231},[],"Copiar los datos a los volúmenes nuevos",{"_3634":75757,"_31331":75677,"_21707":129233,"_5":14945,"_28497":128982,"_3084":128994},[],{"_3634":75758,"_31331":75677,"_21707":129235,"_5":14945,"_28497":128982,"_3084":129236},[],"Todas las releases de Helm",{"_3634":75759,"_31331":75677,"_21707":129238,"_5":14945,"_28497":128982,"_3084":129239},[],"Alta: `helm upgrade` falla",{"_3634":75760,"_31331":75677,"_21707":129241,"_5":14945,"_28497":128982,"_3084":129242},[],"Eliminar o renombrar las claves heredadas",{"_3634":75761,"_31331":75677,"_21707":129244,"_5":14945,"_28497":128982,"_3084":121345},[],{"_3634":75762,"_31331":75677,"_21707":129246,"_5":14945,"_28497":128982,"_3084":129236},[],{"_3634":75763,"_31331":75677,"_21707":129248,"_5":14945,"_28497":128982,"_3084":129249},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3634":75764,"_31331":75677,"_21707":129251,"_5":14945,"_28497":128982,"_3084":129252},[],"Crear primero los Secrets; consulta el paso 2",{"_3634":75765,"_31331":75677,"_21707":129254,"_5":14945,"_28497":128982,"_3084":129001},[],{"_3634":75766,"_31331":75677,"_21707":129256,"_5":14945,"_28497":128982,"_3084":129257},[],"Todos los despliegues",{"_3634":75767,"_31331":75677,"_21707":129259,"_5":14945,"_28497":128982,"_3084":129260},[],"Alta: sin principal de bootstrap no hay administrador",{"_3634":75768,"_31331":75677,"_21707":129262,"_5":14945,"_28497":128982,"_3084":129263},[],"Configurar `services.authz`",{"_3634":75769,"_31331":75677,"_21707":129265,"_5":14945,"_28497":128982,"_3084":129005},[],{"_3634":75770,"_31331":75677,"_21707":129267,"_5":14945,"_28497":128982,"_3084":129236},[],{"_3634":75771,"_31331":75677,"_21707":129269,"_5":14945,"_28497":128982,"_3084":129270},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3634":75772,"_31331":75677,"_21707":129272,"_5":14945,"_28497":128982,"_3084":129273},[],"Mover JWKS y roles a `services.authz`",{"_3634":75773,"_31331":75677,"_21707":129275,"_5":14945,"_28497":128982,"_3084":129025},[],{"_3634":75774,"_31331":75677,"_21707":129277,"_5":14945,"_28497":128982,"_3084":129278},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3634":75775,"_31331":75677,"_21707":129280,"_5":14945,"_28497":128982,"_3084":129281},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3634":75776,"_31331":75677,"_21707":129283,"_5":14945,"_28497":128982,"_3084":129284},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3634":75777,"_31331":75677,"_21707":129286,"_5":14945,"_28497":128982,"_3084":129029},[],{"_3634":75778,"_31331":75677,"_21707":129288,"_5":14945,"_28497":128982,"_3084":129289},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3634":75779,"_31331":75677,"_21707":129291,"_5":14945,"_28497":128982,"_3084":129292},[],"Alta: el backend ya no arranca con ellos",{"_3634":75780,"_31331":75677,"_21707":129294,"_5":14945,"_28497":128982,"_3084":129295},[],"Pasar a PostgreSQL antes de actualizar",{"_3634":75781,"_31331":75677,"_21707":129297,"_5":14945,"_28497":128982,"_3084":129077},[],{"_3634":75782,"_31331":75677,"_21707":129299,"_5":14945,"_28497":128982,"_3084":129300},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3634":75783,"_31331":75677,"_21707":129302,"_5":14945,"_28497":128982,"_3084":129303},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3634":75784,"_31331":75677,"_21707":129305,"_5":14945,"_28497":128982,"_3084":129306},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3634":75785,"_31331":75677,"_21707":129308,"_5":14945,"_28497":128982,"_3084":129309},[],"Webhooks con referencias a archivos",{"_3634":75786,"_31331":75677,"_21707":129311,"_5":14945,"_28497":128982,"_3084":129312},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3634":75787,"_31331":75677,"_21707":129314,"_5":14945,"_28497":128982,"_3084":129315},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3634":75788,"_31331":75677,"_21707":129317,"_5":14945,"_28497":128982,"_3084":129318},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3634":75789,"_31331":75677,"_21707":129320,"_5":14945,"_28497":128982,"_3084":129009},[],{"_3634":75790,"_31331":75677,"_21707":129322,"_5":14945,"_28497":128982,"_3084":129323},[],"Releases con identidades por servicio o material de claves montado",{"_3634":75791,"_31331":75677,"_21707":129325,"_5":14945,"_28497":128982,"_3084":129326},[],"Media: los servicios no pueden leer sus archivos",{"_3634":75792,"_31331":75677,"_21707":129328,"_5":14945,"_28497":128982,"_3084":129329},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3634":75793,"_31331":75677,"_21707":129331,"_5":14945,"_28497":128982,"_3084":129013},[],{"_3634":75794,"_31331":75677,"_21707":129333,"_5":14945,"_28497":128982,"_3084":129334},[],"Releases que definen `amqp.tls`",{"_3634":75795,"_31331":75677,"_21707":129336,"_5":14945,"_28497":128982,"_3084":129337},[],"Media: los clientes se conectan al puerto equivocado",{"_3634":75796,"_31331":75677,"_21707":129339,"_5":14945,"_28497":128982,"_3084":129340},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3634":75797,"_31331":75677,"_21707":129342,"_5":14945,"_28497":128982,"_3084":129033},[],{"_3634":75798,"_31331":75677,"_21707":129344,"_5":14945,"_28497":128982,"_3084":129345},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3634":75799,"_31331":75677,"_21707":129347,"_5":14945,"_28497":128982,"_3084":129348},[],"Media: las claves de CA quedan sin gestionar",{"_3634":75800,"_31331":75677,"_21707":129350,"_5":14945,"_28497":128982,"_3084":129351},[],"Ejecutar la migración de CA a KMS",{"_3634":75801,"_31331":75677,"_21707":129353,"_5":14945,"_28497":128982,"_3084":129354},[],"Verificación del certificado del receptor",{"_3634":75802,"_31331":75677,"_21707":129356,"_5":14945,"_28497":128982,"_3084":129357},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3634":75803,"_31331":75677,"_21707":129359,"_5":14945,"_28497":128982,"_3084":129360},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3634":75804,"_31331":75677,"_21707":129362,"_5":14945,"_28497":128982,"_3084":129363},[],"Poner `insecure_skip_verify` a `false`",{"_3634":75805,"_31331":75677,"_21707":129365,"_5":14945,"_28497":128982,"_3084":129049},[],{"_3634":75806,"_31331":75677,"_21707":129367,"_5":14945,"_28497":128982,"_3084":129368},[],"Scripts y consolas que editan DMS por API",{"_3634":75807,"_31331":75677,"_21707":129370,"_5":14945,"_28497":128982,"_3084":129371},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3634":75808,"_31331":75677,"_21707":129373,"_5":14945,"_28497":128982,"_3084":129374},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3634":75809,"_31331":75677,"_21707":129376,"_5":14945,"_28497":128982,"_3084":129053},[],{"_3634":75810,"_31331":75677,"_21707":129378,"_5":14945,"_28497":128982,"_3084":129379},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3634":75811,"_31331":75677,"_21707":129381,"_5":14945,"_28497":128982,"_3084":129382},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3634":75812,"_31331":75677,"_21707":129384,"_5":14945,"_28497":128982,"_3084":129385},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3634":75813,"_31331":75677,"_21707":129387,"_5":14945,"_28497":128982,"_3084":129073},[],{"_3634":75814,"_31331":75677,"_21707":129389,"_5":14945,"_28497":128982,"_3084":129390},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3634":75815,"_31331":75677,"_21707":129392,"_5":14945,"_28497":128982,"_3084":129393},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3634":75816,"_31331":75677,"_21707":129395,"_5":14945,"_28497":128982,"_3084":129396},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3634":75817,"_31331":75677,"_21707":129398,"_5":14945,"_28497":128982,"_3084":129081},[],{"_3634":75818,"_31331":75677,"_21707":129400,"_5":14945,"_28497":128982,"_3084":129401},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3634":75819,"_31331":75677,"_21707":129403,"_5":14945,"_28497":128982,"_3084":129404},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3634":75820,"_31331":75677,"_21707":129406,"_5":14945,"_28497":128982,"_3084":129407},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3634":75821,"_31331":75677,"_21707":129409,"_5":14945,"_28497":128982,"_3084":129085},[],{"_3634":75822,"_31331":75677,"_21707":129411,"_5":14945,"_28497":128982,"_3084":129412},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3634":75823,"_31331":75677,"_21707":129414,"_5":14945,"_28497":128982,"_3084":129415},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3634":75824,"_31331":75677,"_21707":129417,"_5":14945,"_28497":128982,"_3084":129418},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3634":75825,"_31331":75677,"_21707":129420,"_5":14945,"_28497":128982,"_3084":129069},[],{"_3634":75826,"_31331":75677,"_21707":129422,"_5":14945,"_28497":128982,"_3084":129423},[],"Consumidores que leen el campo `events` del dispositivo",{"_3634":75827,"_31331":75677,"_21707":129425,"_5":14945,"_28497":128982,"_3084":129426},[],"Media: el campo desaparece",{"_3634":75828,"_31331":75677,"_21707":129428,"_5":14945,"_28497":128982,"_3084":129429},[],"Usar los nuevos endpoints de eventos",{"_3634":75829,"_31331":75677,"_21707":129431,"_5":14945,"_28497":128982,"_3084":129097},[],{"_3634":75830,"_31331":75677,"_21707":129433,"_5":14945,"_28497":128982,"_3084":129434},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3634":75831,"_31331":75677,"_21707":129436,"_5":14945,"_28497":128982,"_3084":129437},[],"Media: la migración de la VA aborta",{"_3634":75832,"_31331":75677,"_21707":129439,"_5":14945,"_28497":128982,"_3084":129440},[],"Corregir los roles afectados antes de actualizar",{"_3634":75833,"_31331":75677,"_21707":129442,"_5":14945,"_28497":128982,"_3084":129017},[],{"_3634":75834,"_31331":75677,"_21707":129444,"_5":14945,"_28497":128982,"_3084":129445},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3634":75835,"_31331":75677,"_21707":129447,"_5":14945,"_28497":128982,"_3084":129448},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3634":75836,"_31331":75677,"_21707":129450,"_5":14945,"_28497":128982,"_3084":129451},[],"Actualizar el archivo de values",{"_3634":75837,"_31331":75677,"_21707":129453,"_5":14945,"_28497":128982,"_3084":129061},[],{"_3634":75838,"_31331":75677,"_21707":129455,"_5":14945,"_28497":128982,"_3084":129456},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3634":75839,"_31331":75677,"_21707":129458,"_5":14945,"_28497":128982,"_3084":129459},[],"Baja: prevalece el ID de la URL",{"_3634":75840,"_31331":75677,"_21707":129461,"_5":14945,"_28497":128982,"_3084":129462},[],"Enviar el ID en la URL",{"_3634":75841,"_31331":75677,"_21707":129464,"_5":14945,"_28497":128982,"_3084":129089},[],{"_3634":75842,"_31331":75677,"_21707":129466,"_5":14945,"_28497":128982,"_3084":129467},[],"Clientes que envían un `id` al crear o importar CAs",{"_3634":75843,"_31331":75677,"_21707":129469,"_5":14945,"_28497":128982,"_3084":129470},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3634":75844,"_31331":75677,"_21707":129472,"_5":14945,"_28497":128982,"_3084":129473},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3634":75845,"_31331":75677,"_21707":129475,"_5":14945,"_28497":128982,"_3084":129093},[],{"_3634":75846,"_31331":75677,"_21707":129477,"_5":14945,"_28497":128982,"_3084":129478},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3634":75847,"_31331":75677,"_21707":129480,"_5":14945,"_28497":128982,"_3084":129481},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3634":75848,"_31331":75677,"_21707":129483,"_5":14945,"_28497":128982,"_3084":129484},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3634":75849,"_31331":75677,"_21707":129486,"_5":14945,"_28497":128982,"_3084":129065},[],{"_3634":75850,"_31331":75677,"_21707":129488,"_5":14945,"_28497":128982,"_3084":129489},[],"Consumidores que comparan el `type` del certificado",{"_3634":75851,"_31331":75677,"_21707":129491,"_5":14945,"_28497":128982,"_3084":129492},[],"Baja: dos valores cambian de nombre",{"_3634":75852,"_31331":75677,"_21707":129494,"_5":14945,"_28497":128982,"_3084":129495},[],"Adaptar los consumidores",{"_3634":75853,"_31331":75677,"_21707":129497,"_5":14945,"_28497":128982,"_3084":129057},[],{"_3634":75854,"_31331":75677,"_21707":129499,"_5":14945,"_28497":128982,"_3084":129500},[],"Cualquier DMS",{"_3634":75855,"_31331":75677,"_21707":129502,"_5":14945,"_28497":128982,"_3084":129503},[],"Baja: solo informativo",{"_3634":75856,"_31331":75677,"_21707":129505,"_5":14945,"_28497":128982,"_3084":129506},[],"Revisar ambos bloques antes de editar",{"_3634":75857,"_31331":75677,"_21707":129508,"_5":14945,"_28497":128989,"_3084":129509},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3634":75858,"_31331":75677,"_21707":129511,"_5":14945,"_28497":128989,"_3084":129512},[],"El paso 4 de la guía de migración copia los datos.",{"_3634":75859,"_31331":75677,"_21707":129514,"_5":14945,"_28497":128993,"_3084":129515},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3634":75860,"_31331":75677,"_21707":129517,"_5":14945,"_28497":128997,"_3084":129518},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3634":75861,"_31331":75677,"_21707":129520,"_5":14945,"_28497":128997,"_3084":129521},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3634":75862,"_31331":75677,"_21707":129523,"_5":14945,"_28497":129000,"_3084":129524},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3634":75863,"_31331":75677,"_21707":129526,"_5":14945,"_28497":129004,"_3084":129527},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3634":75864,"_31331":75677,"_21707":129529,"_5":14945,"_28497":129008,"_3084":129530},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3634":75865,"_31331":75677,"_21707":129532,"_5":14945,"_28497":129008,"_3084":129533},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3634":75866,"_31331":75677,"_21707":129535,"_5":14945,"_28497":129008,"_3084":129536},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3634":75867,"_31331":75677,"_21707":129538,"_5":14945,"_28497":129012,"_3084":129539},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3634":75868,"_31331":75677,"_21707":129541,"_5":14945,"_28497":129016,"_3084":129542},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3634":75869,"_31331":75677,"_21707":129544,"_5":14945,"_28497":129016,"_3084":129545},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3634":75870,"_31331":75677,"_21707":129547,"_5":14945,"_28497":129016,"_3084":129548},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3634":75871,"_31331":75677,"_21707":129550,"_5":14945,"_28497":129016,"_3084":129551},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3634":75872,"_31331":75677,"_21707":129553,"_5":14945,"_28497":129016,"_3084":129554},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3634":75873,"_31331":75677,"_21707":129556,"_5":14945,"_28497":129016,"_3084":129557},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3634":75874,"_31331":75677,"_21707":129559,"_5":14945,"_28497":129024,"_3084":129560},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3634":75875,"_31331":75677,"_21707":129562,"_5":14945,"_28497":129024,"_3084":129563},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3634":75876,"_31331":75677,"_21707":129565,"_5":14945,"_28497":129024,"_3084":129566},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3634":75877,"_31331":75677,"_21707":129568,"_5":14945,"_28497":129024,"_3084":129569},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3634":75878,"_31331":75677,"_21707":129571,"_5":14945,"_28497":129024,"_3084":129572},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3634":75879,"_31331":75677,"_21707":129574,"_5":14945,"_28497":129028,"_3084":129575},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3634":75880,"_31331":75677,"_21707":129577,"_5":14945,"_28497":129032,"_3084":129578},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3634":75881,"_31331":75677,"_21707":129580,"_5":14945,"_28497":129032,"_3084":129581},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3634":75882,"_31331":75677,"_21707":129583,"_5":14945,"_28497":129032,"_3084":129584},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3634":75883,"_31331":75677,"_21707":129586,"_5":14945,"_28497":129032,"_3084":129587},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3634":75884,"_31331":75677,"_21707":129589,"_5":14945,"_28497":129032,"_3084":129590},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3634":75885,"_31331":75677,"_21707":129592,"_5":14945,"_28497":129032,"_3084":129593},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3634":75886,"_31331":75677,"_21707":129595,"_5":14945,"_28497":129032,"_3084":129596},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3634":75887,"_31331":75677,"_21707":129598,"_5":14945,"_28497":129032,"_3084":129599},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3634":75888,"_31331":75677,"_21707":129601,"_5":14945,"_28497":129036,"_3084":129602},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3634":75889,"_31331":75677,"_21707":129604,"_5":14945,"_28497":129044,"_3084":129605},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3634":75890,"_31331":75677,"_21707":129607,"_5":14945,"_28497":129044,"_3084":129608},[],"Campo en 3.8.0",{"_3634":75891,"_31331":75677,"_21707":129610,"_5":14945,"_28497":129044,"_3084":129611},[],"Campo en 4.0.0",{"_3634":75892,"_31331":75677,"_21707":129613,"_5":14945,"_28497":129044,"_3084":60244},[],{"_3634":75893,"_31331":75677,"_21707":129615,"_5":14945,"_28497":129044,"_3084":129616},[],"`insecure_skip_verify` (con el valor negado)",{"_3634":75894,"_31331":75677,"_21707":129618,"_5":14945,"_28497":129044,"_3084":60250},[],{"_3634":75895,"_31331":75677,"_21707":129620,"_5":14945,"_28497":129044,"_3084":60253},[],{"_3634":75896,"_31331":75677,"_21707":129622,"_5":14945,"_28497":129044,"_3084":60256},[],{"_3634":75897,"_31331":75677,"_21707":129624,"_5":14945,"_28497":129044,"_3084":60259},[],{"_3634":75898,"_31331":75677,"_21707":129626,"_5":14945,"_28497":129044,"_3084":60262},[],{"_3634":75899,"_31331":75677,"_21707":129628,"_5":14945,"_28497":129044,"_3084":60265},[],{"_3634":75900,"_31331":75677,"_21707":129630,"_5":14945,"_28497":129044,"_3084":129631},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3634":75901,"_31331":75677,"_21707":129633,"_5":14945,"_28497":129044,"_3084":129634},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3634":75902,"_31331":75677,"_21707":129636,"_5":14945,"_28497":129044,"_3084":129637},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3634":75903,"_31331":75677,"_21707":129639,"_5":14945,"_28497":129048,"_3084":129640},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3634":75904,"_31331":75677,"_21707":129642,"_5":14945,"_28497":129048,"_3084":129643},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3634":75905,"_31331":75677,"_21707":129645,"_5":14945,"_28497":129048,"_3084":129646},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3634":75906,"_31331":75677,"_21707":129648,"_5":14945,"_28497":129052,"_3084":129649},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3634":75907,"_31331":75677,"_21707":129651,"_5":14945,"_28497":129052,"_3084":129652},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3634":75908,"_31331":75677,"_21707":129654,"_5":14945,"_28497":129056,"_3084":129655},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3634":75909,"_31331":75677,"_21707":129657,"_5":14945,"_28497":129060,"_3084":129658},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3634":75910,"_31331":75677,"_21707":129660,"_5":14945,"_28497":129064,"_3084":129661},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3634":75911,"_31331":75677,"_21707":129663,"_5":14945,"_28497":129068,"_3084":129664},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3634":75912,"_31331":75677,"_21707":129666,"_5":14945,"_28497":129068,"_3084":129667},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3634":75913,"_31331":75677,"_21707":129669,"_5":14945,"_28497":129068,"_3084":129670},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3634":75914,"_31331":75677,"_21707":129672,"_5":14945,"_28497":129068,"_3084":129673},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. La entrega es de tipo best effort: los eventos emitidos mientras no hay ningún cliente conectado no se reenvían en la siguiente conexión. El servidor cierra cada stream tras un tiempo de vida máximo, 10 minutos por omisión y configurable con la opción `sse_max_stream_duration` de Device Manager, y el cliente se reconecta para seguir recibiendo eventos. Cuando una instancia alcanza su límite de suscriptores, configurado con la opción `sse_max_subscribers` de Device Manager (1000 por omisión y compartido por todos los streams de la instancia), los nuevos streams reciben una respuesta `503` con una cabecera `Retry-After`. Cada stream vuelve a comprobar el permiso de lectura del dispositivo mientras está activo, y lo cierra cuando el permiso se revoca o no se puede verificar; la reconexión vuelve a pasar por las comprobaciones de autorización habituales.",{"_3634":75915,"_31331":75677,"_21707":129675,"_5":14945,"_28497":129068,"_3084":129676},[],"En AMQP, cada instancia de Device Manager enlaza una cola de suscriptores con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. La cola es duradera y auto-delete, con una expiración de una hora (`x-expires`), de modo que el broker la elimina cuando la instancia se detiene o su conexión muere, y no hace falta ninguna política de limpieza. Solo en proveedores de event bus sin soporte de suscriptores efímeros puede quedar una cola duradera por proceso tras detenerse su instancia; revisa esos proveedores si observas colas residuales.",{"_3634":75916,"_31331":75677,"_21707":129678,"_5":14945,"_28497":129072,"_3084":129679},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3634":75917,"_31331":75677,"_21707":129681,"_5":14945,"_28497":129076,"_3084":129682},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3634":75918,"_31331":75677,"_21707":129684,"_5":14945,"_28497":129076,"_3084":129685},[],"Ruta",{"_3634":75919,"_31331":75677,"_21707":129687,"_5":14945,"_28497":129076,"_3084":121976},[],{"_3634":75920,"_31331":75677,"_21707":129689,"_5":14945,"_28497":129076,"_3084":60327},[],{"_3634":75921,"_31331":75677,"_21707":129691,"_5":14945,"_28497":129076,"_3084":129692},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3634":75922,"_31331":75677,"_21707":129694,"_5":14945,"_28497":129076,"_3084":60333},[],{"_3634":75923,"_31331":75677,"_21707":129696,"_5":14945,"_28497":129076,"_3084":129697},[],"Lee los ajustes de una CA.",{"_3634":75924,"_31331":75677,"_21707":129699,"_5":14945,"_28497":129076,"_3084":60339},[],{"_3634":75925,"_31331":75677,"_21707":129701,"_5":14945,"_28497":129076,"_3084":129702},[],"Sustituye los `crl_options`.",{"_3634":75926,"_31331":75677,"_21707":129704,"_5":14945,"_28497":129076,"_3084":60345},[],{"_3634":75927,"_31331":75677,"_21707":129706,"_5":14945,"_28497":129076,"_3084":129707},[],"Elimina los ajustes archivados de una CA.",{"_3634":75928,"_31331":75677,"_21707":129709,"_5":14945,"_28497":129076,"_3084":129710},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3634":75929,"_31331":75677,"_21707":129712,"_5":14945,"_28497":129076,"_3084":129713},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3634":75930,"_31331":75677,"_21707":129715,"_5":14945,"_28497":129076,"_3084":129716},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3634":75931,"_31331":75677,"_21707":129718,"_5":14945,"_28497":129076,"_3084":129719},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3634":75932,"_31331":75677,"_21707":129721,"_5":14945,"_28497":129076,"_3084":129722},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3634":75933,"_31331":75677,"_21707":129724,"_5":14945,"_28497":129076,"_3084":129725},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3634":75934,"_31331":75677,"_21707":129727,"_5":14945,"_28497":129076,"_3084":129728},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3634":75935,"_31331":75677,"_21707":129730,"_5":14945,"_28497":129076,"_3084":129731},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3634":75936,"_31331":75677,"_21707":129733,"_5":14945,"_28497":129076,"_3084":129734},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3634":75937,"_31331":75677,"_21707":129736,"_5":14945,"_28497":129076,"_3084":129737},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3634":75938,"_31331":75677,"_21707":129739,"_5":14945,"_28497":129076,"_3084":129740},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3634":75939,"_31331":75677,"_21707":129742,"_5":14945,"_28497":129080,"_3084":129743},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3634":75940,"_31331":75677,"_21707":129745,"_5":14945,"_28497":129084,"_3084":129746},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3634":75941,"_31331":75677,"_21707":129748,"_5":14945,"_28497":129088,"_3084":129749},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3634":75942,"_31331":75677,"_21707":129751,"_5":14945,"_28497":129092,"_3084":129752},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3634":75943,"_31331":75677,"_21707":129754,"_5":14945,"_28497":129092,"_3084":129755},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3634":75944,"_31331":75677,"_21707":129757,"_5":14945,"_28497":129096,"_3084":129758},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3634":75945,"_31331":75677,"_21707":129760,"_5":14945,"_28497":129100,"_3084":129761},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3634":75946,"_31331":75677,"_21707":129763,"_5":14945,"_28497":129104,"_3084":129764},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3634":75947,"_31331":75677,"_21707":129766,"_5":14945,"_28497":129104,"_3084":129767},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3634":75948,"_31331":75677,"_21707":129769,"_5":14945,"_28497":129104,"_3084":129770},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3634":75949,"_31331":75677,"_21707":129772,"_5":14945,"_28497":129104,"_3084":129773},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3634":75950,"_31331":75677,"_21707":129775,"_5":14945,"_28497":129104,"_3084":129776},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3634":75951,"_31331":75677,"_21707":129778,"_5":14945,"_28497":129104,"_3084":129779},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3634":75952,"_31331":75677,"_21707":129781,"_5":14945,"_28497":129108,"_3084":129782},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3634":75953,"_31331":75677,"_21707":129784,"_5":14945,"_28497":129108,"_3084":129785},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3634":75954,"_31331":75677,"_21707":129787,"_5":14945,"_28497":129108,"_3084":129788},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3634":75955,"_31331":75677,"_21707":129790,"_5":14945,"_28497":129108,"_3084":129791},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3634":75956,"_31331":75677,"_21707":129793,"_5":14945,"_28497":129108,"_3084":129794},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3634":75957,"_31331":75677,"_21707":129796,"_5":14945,"_28497":129112,"_3084":129797},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3634":75958,"_31331":75677,"_21707":129799,"_5":14945,"_28497":129112,"_3084":129800},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3634":75959,"_31331":75677,"_21707":129802,"_5":14945,"_28497":129112,"_3084":129803},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3634":75960,"_31331":75677,"_21707":129805,"_5":14945,"_28497":129112,"_3084":60447},[],{"_3634":75961,"_31331":75677,"_21707":129807,"_5":14945,"_28497":129112,"_3084":129808},[],"Claves de datos obligatorias",{"_3634":75962,"_31331":75677,"_21707":129810,"_5":14945,"_28497":129112,"_3084":129811},[],"Cuándo",{"_3634":75963,"_31331":75677,"_21707":129813,"_5":14945,"_28497":129112,"_3084":129814},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3634":75964,"_31331":75677,"_21707":129816,"_5":14945,"_28497":129112,"_3084":60459},[],{"_3634":75965,"_31331":75677,"_21707":129818,"_5":14945,"_28497":129112,"_3084":129819},[],"Siempre",{"_3634":75966,"_31331":75677,"_21707":129821,"_5":14945,"_28497":129112,"_3084":129822},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3634":75967,"_31331":75677,"_21707":129824,"_5":14945,"_28497":129112,"_3084":60459},[],{"_3634":75968,"_31331":75677,"_21707":129826,"_5":14945,"_28497":129112,"_3084":129819},[],{"_3634":75969,"_31331":75677,"_21707":129828,"_5":14945,"_28497":129112,"_3084":60472},[],{"_3634":75970,"_31331":75677,"_21707":129830,"_5":14945,"_28497":129112,"_3084":60459},[],{"_3634":75971,"_31331":75677,"_21707":129832,"_5":14945,"_28497":129112,"_3084":129833},[],"Solo cuando hay autenticación SMTP",{"_3634":75972,"_31331":75677,"_21707":129835,"_5":14945,"_28497":129112,"_3084":129836},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3634":75973,"_31331":75677,"_21707":129838,"_5":14945,"_28497":129112,"_3084":129839},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3634":75974,"_31331":75677,"_21707":129841,"_5":14945,"_28497":129112,"_3084":129842},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3634":75975,"_31331":75677,"_21707":129844,"_5":14945,"_28497":129112,"_3084":129845},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3634":75976,"_31331":75677,"_21707":129847,"_5":14945,"_28497":129112,"_3084":129848},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3634":75977,"_31331":75677,"_21707":129850,"_5":14945,"_28497":129112,"_3084":129851},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3634":75978,"_31331":75677,"_21707":129853,"_5":14945,"_28497":129112,"_3084":129854},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3634":75979,"_31331":75677,"_21707":129856,"_5":14945,"_28497":129112,"_3084":129857},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3634":75980,"_31331":75677,"_21707":129859,"_5":14945,"_28497":129112,"_3084":129860},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3634":75981,"_31331":75677,"_21707":129862,"_5":14945,"_28497":129112,"_3084":129863},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3634":75982,"_31331":75677,"_21707":129865,"_5":14945,"_28497":129112,"_3084":129866},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3634":75983,"_31331":75677,"_21707":129868,"_5":14945,"_28497":129112,"_3084":129869},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3634":75984,"_31331":75677,"_21707":129871,"_5":14945,"_28497":129112,"_3084":129872},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3634":75985,"_31331":75677,"_21707":129874,"_5":14945,"_28497":129112,"_3084":129875},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3634":75986,"_31331":75677,"_21707":129877,"_5":14945,"_28497":129112,"_3084":129878},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3634":75987,"_31331":75677,"_21707":129880,"_5":14945,"_28497":129116,"_3084":129881},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3634":75988,"_31331":75677,"_21707":129883,"_5":14945,"_28497":129116,"_3084":129884},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3634":75989,"_31331":75677,"_21707":129886,"_5":14945,"_28497":129120,"_3084":129887},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3634":75990,"_31331":75677,"_21707":129889,"_5":14945,"_28497":129120,"_3084":129890},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3634":75991,"_31331":75677,"_21707":129892,"_5":14945,"_28497":129120,"_3084":129893},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3634":75992,"_31331":75677,"_21707":129895,"_5":14945,"_28497":129120,"_3084":129896},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3634":75993,"_31331":75677,"_21707":129898,"_5":14945,"_28497":129120,"_3084":129899},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3634":75994,"_31331":75677,"_21707":129901,"_5":14945,"_28497":129120,"_3084":129902},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3634":75995,"_31331":75677,"_21707":129904,"_5":14945,"_28497":129120,"_3084":129905},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3634":75996,"_31331":75677,"_21707":129907,"_5":14945,"_28497":129120,"_3084":129908},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3634":75997,"_31331":75677,"_21707":129910,"_5":14945,"_28497":129120,"_3084":129911},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3634":75998,"_31331":75677,"_21707":129913,"_5":14945,"_28497":129120,"_3084":129914},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3634":75999,"_31331":75677,"_21707":129916,"_5":14945,"_28497":129120,"_3084":129917},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3634":76000,"_31331":75677,"_21707":129919,"_5":14945,"_28497":129124,"_3084":129920},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3634":76001,"_31331":75677,"_21707":129922,"_5":14945,"_28497":129124,"_3084":129923},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3634":76002,"_31331":75677,"_21707":129925,"_5":14945,"_28497":129128,"_3084":129926},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3634":76003,"_31331":75677,"_21707":129928,"_5":14945,"_28497":129128,"_3084":129929},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3634":76004,"_31331":75677,"_21707":129931,"_5":14945,"_28497":129128,"_3084":129932},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3634":76005,"_31331":75677,"_21707":129934,"_5":14945,"_28497":129128,"_3084":129935},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3634":76006,"_31331":75677,"_21707":129937,"_5":14945,"_28497":129128,"_3084":129938},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3634":76007,"_31331":75677,"_21707":129940,"_5":14945,"_28497":129128,"_3084":129941},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3634":76008,"_31331":75677,"_21707":129943,"_5":14945,"_28497":129128,"_3084":129944},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3634":76009,"_31331":75677,"_21707":129946,"_5":14945,"_28497":129128,"_3084":129947},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3634":76010,"_31331":75677,"_21707":129949,"_5":14945,"_28497":129132,"_3084":129950},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3634":76011,"_31331":75677,"_21707":129952,"_5":14945,"_28497":129132,"_3084":129953},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3634":76012,"_31331":75677,"_21707":129955,"_5":14945,"_28497":129132,"_3084":129956},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3634":76013,"_31331":75677,"_21707":129958,"_5":14945,"_28497":129132,"_3084":129959},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3634":76014,"_31331":75677,"_21707":129961,"_5":14945,"_28497":129132,"_3084":129962},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3634":76015,"_31331":75677,"_21707":129964,"_5":14945,"_28497":129132,"_3084":129965},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3634":76016,"_31331":75677,"_21707":129967,"_5":14945,"_28497":129132,"_3084":129968},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3634":76017,"_31331":75677,"_21707":129970,"_5":14945,"_28497":129132,"_3084":129971},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3634":76018,"_31331":75677,"_21707":129973,"_5":14945,"_28497":129132,"_3084":129974},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3634":76019,"_31331":75677,"_21707":129976,"_5":14945,"_28497":129132,"_3084":129977},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3634":76020,"_31331":75677,"_21707":129979,"_5":14945,"_28497":129132,"_3084":129980},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3634":76021,"_31331":75677,"_21707":129982,"_5":14945,"_28497":129135,"_3084":129983},[],"Tras la actualización, comprueba en este orden:",{"_3634":76022,"_31331":75677,"_21707":129985,"_5":14945,"_28497":129135,"_3084":129986},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3634":76023,"_31331":75677,"_21707":129988,"_5":14945,"_28497":129135,"_3084":129989},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3634":76024,"_31331":75677,"_21707":129991,"_5":14945,"_28497":129135,"_3084":129992},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3634":76025,"_31331":75677,"_21707":129994,"_5":14945,"_28497":129135,"_3084":129995},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3634":76026,"_31331":75677,"_21707":129997,"_5":14945,"_28497":129135,"_3084":129998},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3634":76027,"_31331":75677,"_21707":130000,"_5":14945,"_28497":129135,"_3084":130001},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3634":76028,"_31331":75677,"_21707":130003,"_5":14945,"_28497":129135,"_3084":130004},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3634":76029,"_31331":75677,"_21707":130006,"_5":14945,"_28497":129135,"_3084":130007},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3634":76030,"_31331":75677,"_21707":130009,"_5":14945,"_28497":129135,"_3084":130010},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada. En AMQP las colas de suscriptores de SSE son auto-delete y desaparecen cuando su instancia se detiene; en proveedores de event bus sin soporte de suscriptores efímeros, comprueba que no se acumulen colas de SSE por proceso.",{"_3634":76031,"_31331":75677,"_21707":130012,"_5":14945,"_28497":129135,"_3084":130013},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3634":76032,"_31331":75677,"_21707":130015,"_5":14945,"_28497":129135,"_3084":130016},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3634":76033,"_31331":75677,"_21707":130018,"_5":14945,"_28497":129135,"_3084":130019},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3634":76034,"_31331":75677,"_21707":130021,"_5":14945,"_28497":129135,"_3084":130022},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3634":76035,"_31331":75677,"_21707":130024,"_5":14945,"_28497":129135,"_3084":130025},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3634":76036,"_31331":75677,"_21707":130027,"_5":14945,"_28497":129135,"_3084":130028},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3634":76037,"_31331":75677,"_21707":130030,"_5":14945,"_28497":129139,"_3084":130031},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3634":76038,"_31331":75677,"_21707":130033,"_5":14945,"_28497":129139,"_3084":130034},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3634":76039,"_31331":75677,"_21707":130036,"_5":14945,"_28497":129139,"_3084":130037},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":76040,"_31331":75677,"_21707":130039,"_5":14945,"_28497":129139,"_3084":130040},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3634":76041,"_31331":75677,"_21707":130042,"_5":14945,"_28497":129139,"_3084":130043},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60690":130045,"_60692":130046,"_60694":130047,"_60696":130048,"_18814":3119,"_72971":3119},"spanish",[3084,31331,5,28497],{"_3084":25888,"_31331":25888,"_5":25888,"_28497":25888},{"_3084":130049,"_31331":133116,"_5":136183,"_28497":139250},{"_4838":130050,"_60700":130051,"_5":25888},{"_15026":12834,"_15405":13129,"_15424":3928,"_30326":4185,"_15411":4224,"_20619":6217,"_15047":3586,"_15054":6633,"_30263":12808,"_30676":15462,"_30708":7822,"_30302":4581,"_35747":5189,"_30405":19765,"_30752":10252,"_35754":5594,"_35757":3556,"_35760":14994,"_35763":3378,"_31154":26069,"_35768":7685,"_35770":10860,"_31189":19217,"_15420":5110,"_35774":7838,"_35777":4800,"_35779":7824,