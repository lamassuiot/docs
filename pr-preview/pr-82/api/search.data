:129745,"_41672":129748,"_41674":129751,"_41676":129754,"_41678":129757,"_41680":129760,"_41682":129763,"_41684":129766,"_41686":129769,"_41688":129772,"_41690":129775,"_41692":129778,"_41695":129781,"_41697":129784,"_41699":129787,"_41701":129790,"_41703":129793,"_41705":129796,"_41707":129799,"_41709":129802,"_41711":129805,"_41713":129808,"_41715":129811,"_41717":129814,"_41719":129817,"_41721":129820,"_41723":129823,"_41725":129826,"_41727":129829,"_41729":129832,"_41731":129835,"_41733":129838,"_41735":129841,"_41737":129844,"_41739":129847,"_41741":129850,"_41743":129853,"_41745":129856,"_41747":129859,"_41749":129862,"_41751":129865,"_41753":129868,"_41755":129871,"_41757":129874,"_41760":129877,"_41762":129880,"_41764":129883},{"_3632":72862,"_31224":72862,"_5":15251,"_3083":120584,"_31583":120585,"_21643":120588,"_28416":72862},"Despliega desde AWS Marketplace",[51036,120586,120587],"Despliegue","Otros modelos",[],{"_3632":72863,"_31224":72862,"_21643":120590,"_5":14891,"_28416":72862,"_3083":120591},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3632":72864,"_31224":72862,"_5":31580,"_21643":120593,"_28416":120594,"_3083":120595},[],"/docs/pr-preview/pr-82/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3632":72865,"_31224":72862,"_5":31580,"_21643":120597,"_28416":120598,"_3083":120599},[],"/docs/pr-preview/pr-82/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3632":72866,"_31224":72862,"_5":31580,"_21643":120601,"_28416":120602,"_3083":120603},[],"/docs/pr-preview/pr-82/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3632":72867,"_31224":72862,"_5":31580,"_21643":120605,"_28416":120606,"_3083":120607},[],"/docs/pr-preview/pr-82/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3632":72868,"_31224":72862,"_5":31580,"_21643":120609,"_28416":120610,"_3083":120611},[],"/docs/pr-preview/pr-82/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3632":72869,"_31224":72862,"_5":31580,"_21643":120613,"_28416":120614,"_3083":120615},[],"/docs/pr-preview/pr-82/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3632":72870,"_31224":72862,"_5":31580,"_21643":120617,"_28416":120618,"_3083":120619},[],"/docs/pr-preview/pr-82/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3632":72871,"_31224":72862,"_21643":120621,"_5":14891,"_28416":72862,"_3083":120622},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3632":72872,"_31224":72862,"_21643":120624,"_5":14891,"_28416":120594,"_3083":120625},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3632":72873,"_31224":72862,"_21643":120627,"_5":14891,"_28416":120594,"_3083":120628},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3632":72874,"_31224":72862,"_21643":120630,"_5":14891,"_28416":120594,"_3083":120631},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3632":72875,"_31224":72862,"_21643":120633,"_5":14891,"_28416":120598,"_3083":120634},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3632":72876,"_31224":72862,"_21643":120636,"_5":14891,"_28416":120598,"_3083":120637},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3632":72877,"_31224":72862,"_21643":120639,"_5":14891,"_28416":120598,"_3083":120640},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3632":72878,"_31224":72862,"_21643":120642,"_5":14891,"_28416":120602,"_3083":120643},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3632":72879,"_31224":72862,"_21643":120645,"_5":14891,"_28416":120606,"_3083":120646},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3632":72880,"_31224":72862,"_21643":120648,"_5":14891,"_28416":120610,"_3083":120649},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3632":72881,"_31224":72862,"_21643":120651,"_5":14891,"_28416":120614,"_3083":120652},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3632":72882,"_31224":72862,"_21643":120654,"_5":14891,"_28416":120618,"_3083":120655},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3632":72883,"_31224":72883,"_5":15251,"_3083":120657,"_31583":120658,"_21643":120659,"_28416":72883},"Despliega Lamassu",[51036,120586],[],{"_3632":72884,"_31224":72883,"_21643":120661,"_5":14891,"_28416":72883,"_3083":120662},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3632":72885,"_31224":72883,"_5":31580,"_21643":120664,"_28416":120665,"_3083":120666},[],"/docs/pr-preview/pr-82/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3632":72886,"_31224":72883,"_5":31580,"_21643":120668,"_28416":120669,"_3083":120670},[],"/docs/pr-preview/pr-82/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3632":72887,"_31224":72883,"_5":31580,"_21643":120672,"_28416":120673,"_3083":120674},[],"/docs/pr-preview/pr-82/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3632":72888,"_31224":72883,"_21643":120676,"_5":14891,"_28416":72883,"_3083":120677},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3632":72889,"_31224":72883,"_21643":120679,"_5":14891,"_28416":120665,"_3083":120680},[],"Modelo",{"_3632":72890,"_31224":72883,"_21643":120682,"_5":14891,"_28416":120665,"_3083":120683},[],"Recomendado para",{"_3632":72891,"_31224":72883,"_21643":120685,"_5":14891,"_28416":120665,"_3083":120686},[],"Quién opera la infraestructura",{"_3632":72892,"_31224":72883,"_21643":120688,"_5":14891,"_28416":120665,"_3083":120689},[],"Punto de partida",{"_3632":72893,"_31224":72883,"_21643":120691,"_5":14891,"_28416":120665,"_3083":51143},[],{"_3632":72894,"_31224":72883,"_21643":120693,"_5":14891,"_28416":120665,"_3083":120694},[],"Producción, entornos regulados y despliegues personalizados",{"_3632":72895,"_31224":72883,"_21643":120696,"_5":14891,"_28416":120665,"_3083":120697},[],"Tu equipo",{"_3632":72896,"_31224":72883,"_21643":120699,"_5":14891,"_28416":120665,"_3083":120700},[],"Helm o Fastlane",{"_3632":72897,"_31224":72883,"_21643":120702,"_5":14891,"_28416":120665,"_3083":51155},[],{"_3632":72898,"_31224":72883,"_21643":120704,"_5":14891,"_28416":120665,"_3083":120705},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3632":72899,"_31224":72883,"_21643":120707,"_5":14891,"_28416":120665,"_3083":120697},[],{"_3632":72900,"_31224":72883,"_21643":120709,"_5":14891,"_28416":120665,"_3083":120710},[],"Imagen preconfigurada en EC2",{"_3632":72901,"_31224":72883,"_21643":120712,"_5":14891,"_28416":120665,"_3083":51166},[],{"_3632":72902,"_31224":72883,"_21643":120714,"_5":14891,"_28416":120665,"_3083":120715},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3632":72903,"_31224":72883,"_21643":120717,"_5":14891,"_28416":120665,"_3083":51172},[],{"_3632":72904,"_31224":72883,"_21643":120719,"_5":14891,"_28416":120665,"_3083":120720},[],"Suscripción gestionada",{"_3632":72905,"_31224":72883,"_21643":120722,"_5":14891,"_28416":120665,"_3083":120723},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3632":72906,"_31224":72883,"_21643":120725,"_5":14891,"_28416":120665,"_3083":120726},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3632":72907,"_31224":72883,"_21643":120728,"_5":14891,"_28416":120665,"_3083":120729},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3632":72908,"_31224":72883,"_21643":120731,"_5":14891,"_28416":120669,"_3083":120732},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3632":72909,"_31224":72883,"_21643":120734,"_5":14891,"_28416":120673,"_3083":120735},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3632":72910,"_31224":72910,"_5":15251,"_3083":120737,"_31583":120738,"_21643":120739,"_28416":72910},"Utiliza Lamassu como SaaS",[51036,120586,120587],[],{"_3632":72911,"_31224":72910,"_21643":120741,"_5":14891,"_28416":72910,"_3083":120742},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3632":72912,"_31224":72910,"_5":31580,"_21643":120744,"_28416":120745,"_3083":120746},[],"/docs/pr-preview/pr-82/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3632":72913,"_31224":72910,"_5":31580,"_21643":120748,"_28416":120749,"_3083":120750},[],"/docs/pr-preview/pr-82/es/deployment/saas#planes","Planes",{"_3632":72914,"_31224":72910,"_5":31580,"_21643":120752,"_28416":120753,"_3083":120754},[],"/docs/pr-preview/pr-82/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3632":72915,"_31224":72910,"_21643":120756,"_5":14891,"_28416":72910,"_3083":120757},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3632":72916,"_31224":72910,"_21643":120759,"_5":14891,"_28416":120745,"_3083":120760},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3632":72917,"_31224":72910,"_21643":120762,"_5":14891,"_28416":120745,"_3083":120763},[],"Copias de seguridad automáticas.",{"_3632":72918,"_31224":72910,"_21643":120765,"_5":14891,"_28416":120745,"_3083":120766},[],"Actualizaciones de versión.",{"_3632":72919,"_31224":72910,"_21643":120768,"_5":14891,"_28416":120745,"_3083":120769},[],"Soporte técnico y SLA según el plan contratado.",{"_3632":72920,"_31224":72910,"_21643":120771,"_5":14891,"_28416":120749,"_3083":51227},[],{"_3632":72921,"_31224":72910,"_21643":120773,"_5":14891,"_28416":120749,"_3083":120774},[],"Dispositivos",{"_3632":72922,"_31224":72910,"_21643":120776,"_5":14891,"_28416":120749,"_3083":120777},[],"Soporte",{"_3632":72923,"_31224":72910,"_21643":120779,"_5":14891,"_28416":120749,"_3083":51236},[],{"_3632":72924,"_31224":72910,"_21643":120781,"_5":14891,"_28416":120749,"_3083":51239},[],{"_3632":72925,"_31224":72910,"_21643":120783,"_5":14891,"_28416":120749,"_3083":120784},[],"Hasta 1.000",{"_3632":72926,"_31224":72910,"_21643":120786,"_5":14891,"_28416":120749,"_3083":51245},[],{"_3632":72927,"_31224":72910,"_21643":120788,"_5":14891,"_28416":120749,"_3083":120789},[],"99,5 %",{"_3632":72928,"_31224":72910,"_21643":120791,"_5":14891,"_28416":120749,"_3083":51251},[],{"_3632":72929,"_31224":72910,"_21643":120793,"_5":14891,"_28416":120749,"_3083":120794},[],"Hasta 10.000",{"_3632":72930,"_31224":72910,"_21643":120796,"_5":14891,"_28416":120749,"_3083":120797},[],"Email y chat",{"_3632":72931,"_31224":72910,"_21643":120799,"_5":14891,"_28416":120749,"_3083":120800},[],"99,9 %",{"_3632":72932,"_31224":72910,"_21643":120802,"_5":14891,"_28416":120749,"_3083":51263},[],{"_3632":72933,"_31224":72910,"_21643":120804,"_5":14891,"_28416":120749,"_3083":120805},[],"Ilimitados",{"_3632":72934,"_31224":72910,"_21643":120807,"_5":14891,"_28416":120749,"_3083":120808},[],"Dedicado",{"_3632":72935,"_31224":72910,"_21643":120810,"_5":14891,"_28416":120749,"_3083":120811},[],"99,99 %",{"_3632":72936,"_31224":72910,"_21643":120813,"_5":14891,"_28416":120753,"_3083":120814},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3632":72937,"_31224":72910,"_21643":120816,"_5":14891,"_28416":120753,"_3083":120817},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3632":72938,"_31224":72938,"_5":15251,"_3083":51280,"_31583":120819,"_21643":120821,"_28416":72938},[51036,120586,120820],"Kubernetes autogestionado",[],{"_3632":72939,"_31224":72938,"_21643":120823,"_5":14891,"_28416":72938,"_3083":120824},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3632":72940,"_31224":72938,"_5":31580,"_21643":120826,"_28416":120827,"_3083":120828},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3632":72941,"_31224":72938,"_5":31580,"_21643":120830,"_28416":120831,"_3083":120832},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3632":72942,"_31224":72938,"_5":31580,"_21643":120834,"_28416":120835,"_3083":120836},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3632":72943,"_31224":72938,"_5":31580,"_21643":120838,"_28416":120839,"_3083":120840},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3632":72944,"_31224":72938,"_5":31580,"_21643":120842,"_28416":120843,"_3083":120844},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3632":72945,"_31224":72938,"_5":31580,"_21643":120846,"_28416":120847,"_3083":120848},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3632":72946,"_31224":72938,"_5":31580,"_21643":120850,"_28416":120851,"_3083":120852},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3632":72947,"_31224":72938,"_5":31580,"_21643":120854,"_28416":120855,"_3083":120856},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3632":72948,"_31224":72938,"_5":31580,"_21643":120858,"_28416":120859,"_3083":120860},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3632":72949,"_31224":72938,"_5":31580,"_21643":120862,"_28416":120863,"_3083":120864},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3632":72950,"_31224":72938,"_5":31580,"_21643":120866,"_28416":120867,"_3083":120868},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3632":72951,"_31224":72938,"_21643":120870,"_5":14891,"_28416":120827,"_3083":120871},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3632":72952,"_31224":72938,"_21643":120873,"_5":14891,"_28416":120827,"_3083":120874},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3632":72953,"_31224":72938,"_21643":120876,"_5":14891,"_28416":120831,"_3083":120877},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3632":72954,"_31224":72938,"_21643":120879,"_5":14891,"_28416":120831,"_3083":120880},[],"Fastlane instala o configura",{"_3632":72955,"_31224":72938,"_21643":120882,"_5":14891,"_28416":120831,"_3083":120883},[],"Tú sigues proporcionando",{"_3632":72956,"_31224":72938,"_21643":120885,"_5":14891,"_28416":120831,"_3083":120886},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3632":72957,"_31224":72938,"_21643":120888,"_5":14891,"_28416":120831,"_3083":120889},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3632":72958,"_31224":72938,"_21643":120891,"_5":14891,"_28416":120831,"_3083":120892},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3632":72959,"_31224":72938,"_21643":120894,"_5":14891,"_28416":120831,"_3083":120895},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3632":72960,"_31224":72938,"_21643":120897,"_5":14891,"_28416":120831,"_3083":120898},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3632":72961,"_31224":72938,"_21643":120900,"_5":14891,"_28416":120831,"_3083":120901},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3632":72962,"_31224":72938,"_21643":120903,"_5":14891,"_28416":120831,"_3083":120904},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3632":72963,"_31224":72938,"_21643":120906,"_5":14891,"_28416":120831,"_3083":120907},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3632":72964,"_31224":72938,"_21643":120909,"_5":14891,"_28416":120831,"_3083":120910},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3632":72965,"_31224":72938,"_21643":120912,"_5":14891,"_28416":120835,"_3083":120913},[],"Necesitas:",{"_3632":72966,"_31224":72938,"_21643":120915,"_5":14891,"_28416":120835,"_3083":120916},[],"un clúster Kubernetes existente",{"_3632":72967,"_31224":72938,"_21643":120918,"_5":14891,"_28416":120835,"_3083":120919},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3632":72968,"_31224":72938,"_21643":120921,"_5":14891,"_28416":120835,"_3083":51382},[],{"_3632":72969,"_31224":72938,"_21643":120923,"_5":14891,"_28416":120835,"_3083":24456},[],{"_3632":72970,"_31224":72938,"_21643":120925,"_5":14891,"_28416":120835,"_3083":120926},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3632":72971,"_31224":72938,"_21643":120928,"_5":14891,"_28416":120835,"_3083":120929},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3632":72972,"_31224":72938,"_21643":120931,"_5":14891,"_28416":120835,"_3083":120932},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3632":72973,"_31224":72938,"_21643":120934,"_5":14891,"_28416":120835,"_3083":120935},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3632":72974,"_31224":72938,"_21643":120937,"_5":14891,"_28416":120835,"_3083":120938},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3632":72975,"_31224":72938,"_21643":120940,"_5":14891,"_28416":120839,"_3083":120941},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3632":72976,"_31224":72938,"_21643":120943,"_5":14891,"_28416":120839,"_3083":120944},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3632":72977,"_31224":72938,"_21643":120946,"_5":14891,"_28416":120843,"_3083":120947},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3632":72978,"_31224":72938,"_21643":120949,"_5":14891,"_28416":120843,"_3083":120950},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3632":72979,"_31224":72938,"_21643":120952,"_5":14891,"_28416":120843,"_3083":120953},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3632":72980,"_31224":72938,"_21643":120955,"_5":14891,"_28416":120843,"_3083":120956},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3632":72981,"_31224":72938,"_21643":120958,"_5":14891,"_28416":120847,"_3083":120959},[],"Opción",{"_3632":72982,"_31224":72938,"_21643":120961,"_5":14891,"_28416":120847,"_3083":120962},[],"Valor predeterminado",{"_3632":72983,"_31224":72938,"_21643":120964,"_5":14891,"_28416":120847,"_3083":120965},[],"Propósito",{"_3632":72984,"_31224":72938,"_21643":120967,"_5":14891,"_28416":120847,"_3083":51429},[],{"_3632":72985,"_31224":72938,"_21643":120969,"_5":14891,"_28416":120847,"_3083":51432},[],{"_3632":72986,"_31224":72938,"_21643":120971,"_5":14891,"_28416":120847,"_3083":120972},[],"Muestra la ayuda",{"_3632":72987,"_31224":72938,"_21643":120974,"_5":14891,"_28416":120847,"_3083":51438},[],{"_3632":72988,"_31224":72938,"_21643":120976,"_5":14891,"_28416":120847,"_3083":120977},[],"contexto actual",{"_3632":72989,"_31224":72938,"_21643":120979,"_5":14891,"_28416":120847,"_3083":120980},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3632":72990,"_31224":72938,"_21643":120982,"_5":14891,"_28416":120847,"_3083":51447},[],{"_3632":72991,"_31224":72938,"_21643":120984,"_5":14891,"_28416":120847,"_3083":6802},[],{"_3632":72992,"_31224":72938,"_21643":120986,"_5":14891,"_28416":120847,"_3083":120987},[],"Omite prompts y genera credenciales para las dependencias",{"_3632":72993,"_31224":72938,"_21643":120989,"_5":14891,"_28416":120847,"_3083":51455},[],{"_3632":72994,"_31224":72938,"_21643":120991,"_5":14891,"_28416":120847,"_3083":51458},[],{"_3632":72995,"_31224":72938,"_21643":120993,"_5":14891,"_28416":120847,"_3083":120994},[],"Namespace de la instalación",{"_3632":72996,"_31224":72938,"_21643":120996,"_5":14891,"_28416":120847,"_3083":51464},[],{"_3632":72997,"_31224":72938,"_21643":120998,"_5":14891,"_28416":120847,"_3083":51467},[],{"_3632":72998,"_31224":72938,"_21643":121000,"_5":14891,"_28416":120847,"_3083":121001},[],"Dominio usado por la UI, OIDC y el certificado",{"_3632":72999,"_31224":72938,"_21643":121003,"_5":14891,"_28416":120847,"_3083":51473},[],{"_3632":73000,"_31224":72938,"_21643":121005,"_5":14891,"_28416":120847,"_3083":15603},[],{"_3632":73001,"_31224":72938,"_21643":121007,"_5":14891,"_28416":120847,"_3083":121008},[],"Versión del chart de Lamassu",{"_3632":73002,"_31224":72938,"_21643":121010,"_5":14891,"_28416":120847,"_3083":51481},[],{"_3632":73003,"_31224":72938,"_21643":121012,"_5":14891,"_28416":120847,"_3083":51484},[],{"_3632":73004,"_31224":72938,"_21643":121014,"_5":14891,"_28416":120847,"_3083":121015},[],"Puerto del listener HTTPS",{"_3632":73005,"_31224":72938,"_21643":121017,"_5":14891,"_28416":120847,"_3083":51490},[],{"_3632":73006,"_31224":72938,"_21643":121019,"_5":14891,"_28416":120847,"_3083":51493},[],{"_3632":73007,"_31224":72938,"_21643":121021,"_5":14891,"_28416":120847,"_3083":121022},[],"Puerto del listener HTTP",{"_3632":73008,"_31224":72938,"_21643":121024,"_5":14891,"_28416":120847,"_3083":51499},[],{"_3632":73009,"_31224":72938,"_21643":121026,"_5":14891,"_28416":120847,"_3083":51432},[],{"_3632":73010,"_31224":72938,"_21643":121028,"_5":14891,"_28416":120847,"_3083":121029},[],"Certificado PEM para TLS downstream",{"_3632":73011,"_31224":72938,"_21643":121031,"_5":14891,"_28416":120847,"_3083":51507},[],{"_3632":73012,"_31224":72938,"_21643":121033,"_5":14891,"_28416":120847,"_3083":51432},[],{"_3632":73013,"_31224":72938,"_21643":121035,"_5":14891,"_28416":120847,"_3083":121036},[],"Clave privada PEM para TLS downstream",{"_3632":73014,"_31224":72938,"_21643":121038,"_5":14891,"_28416":120847,"_3083":51515},[],{"_3632":73015,"_31224":72938,"_21643":121040,"_5":14891,"_28416":120847,"_3083":121041},[],"chart del repositorio",{"_3632":73016,"_31224":72938,"_21643":121043,"_5":14891,"_28416":120847,"_3083":121044},[],"Usa un chart local de Lamassu sin empaquetar",{"_3632":73017,"_31224":72938,"_21643":121046,"_5":14891,"_28416":120847,"_3083":51524},[],{"_3632":73018,"_31224":72938,"_21643":121048,"_5":14891,"_28416":120847,"_3083":121049},[],"detección automática",{"_3632":73019,"_31224":72938,"_21643":121051,"_5":14891,"_28416":120847,"_3083":121052},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3632":73020,"_31224":72938,"_21643":121054,"_5":14891,"_28416":120847,"_3083":51532},[],{"_3632":73021,"_31224":72938,"_21643":121056,"_5":14891,"_28416":120847,"_3083":6802},[],{"_3632":73022,"_31224":72938,"_21643":121058,"_5":14891,"_28416":120847,"_3083":121059},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3632":73023,"_31224":72938,"_21643":121061,"_5":14891,"_28416":120847,"_3083":51540},[],{"_3632":73024,"_31224":72938,"_21643":121063,"_5":14891,"_28416":120847,"_3083":6802},[],{"_3632":73025,"_31224":72938,"_21643":121065,"_5":14891,"_28416":120847,"_3083":121066},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3632":73026,"_31224":72938,"_21643":121068,"_5":14891,"_28416":120847,"_3083":51548},[],{"_3632":73027,"_31224":72938,"_21643":121070,"_5":14891,"_28416":120847,"_3083":6802},[],{"_3632":73028,"_31224":72938,"_21643":121072,"_5":14891,"_28416":120847,"_3083":121073},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3632":73029,"_31224":72938,"_21643":121075,"_5":14891,"_28416":120847,"_3083":51556},[],{"_3632":73030,"_31224":72938,"_21643":121077,"_5":14891,"_28416":120847,"_3083":6802},[],{"_3632":73031,"_31224":72938,"_21643":121079,"_5":14891,"_28416":120847,"_3083":121080},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3632":73032,"_31224":72938,"_21643":121082,"_5":14891,"_28416":120847,"_3083":51564},[],{"_3632":73033,"_31224":72938,"_21643":121084,"_5":14891,"_28416":120847,"_3083":51567},[],{"_3632":73034,"_31224":72938,"_21643":121086,"_5":14891,"_28416":120847,"_3083":121087},[],"Usa otro chart local de SoftHSM",{"_3632":73035,"_31224":72938,"_21643":121089,"_5":14891,"_28416":120847,"_3083":121090},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3632":73036,"_31224":72938,"_21643":121092,"_5":14891,"_28416":120851,"_3083":121093},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3632":73037,"_31224":72938,"_21643":121095,"_5":14891,"_28416":120851,"_3083":121096},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3632":73038,"_31224":72938,"_21643":121098,"_5":14891,"_28416":120851,"_3083":121099},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3632":73039,"_31224":72938,"_21643":121101,"_5":14891,"_28416":120851,"_3083":121102},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3632":73040,"_31224":72938,"_21643":121104,"_5":14891,"_28416":120851,"_3083":121105},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3632":73041,"_31224":72938,"_21643":121107,"_5":14891,"_28416":120851,"_3083":121108},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3632":73042,"_31224":72938,"_21643":121110,"_5":14891,"_28416":120855,"_3083":51594},[],{"_3632":73043,"_31224":72938,"_21643":121112,"_5":14891,"_28416":120855,"_3083":121113},[],"valida las herramientas locales y el clúster seleccionado",{"_3632":73044,"_31224":72938,"_21643":121115,"_5":14891,"_28416":120855,"_3083":121116},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3632":73045,"_31224":72938,"_21643":121118,"_5":14891,"_28416":120855,"_3083":121119},[],"crea el namespace",{"_3632":73046,"_31224":72938,"_21643":121121,"_5":14891,"_28416":120855,"_3083":121122},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3632":73047,"_31224":72938,"_21643":121124,"_5":14891,"_28416":120855,"_3083":121125},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3632":73048,"_31224":72938,"_21643":121127,"_5":14891,"_28416":120855,"_3083":121128},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3632":73049,"_31224":72938,"_21643":121130,"_5":14891,"_28416":120855,"_3083":121131},[],"instala RabbitMQ",{"_3632":73050,"_31224":72938,"_21643":121133,"_5":14891,"_28416":120855,"_3083":121134},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3632":73051,"_31224":72938,"_21643":121136,"_5":14891,"_28416":120855,"_3083":121137},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3632":73052,"_31224":72938,"_21643":121139,"_5":14891,"_28416":120855,"_3083":121140},[],"carga datos de ejemplo opcionalmente",{"_3632":73053,"_31224":72938,"_21643":121142,"_5":14891,"_28416":120855,"_3083":121143},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3632":73054,"_31224":72938,"_21643":121145,"_5":14891,"_28416":120859,"_3083":121146},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3632":73055,"_31224":72938,"_21643":121148,"_5":14891,"_28416":120859,"_3083":121149},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3632":73056,"_31224":72938,"_21643":121151,"_5":14891,"_28416":120863,"_3083":121152},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3632":73057,"_31224":72938,"_21643":121154,"_5":14891,"_28416":120863,"_3083":121155},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3632":73058,"_31224":72938,"_21643":121157,"_5":14891,"_28416":120863,"_3083":121158},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3632":73059,"_31224":72938,"_21643":121160,"_5":14891,"_28416":120863,"_3083":121161},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3632":73060,"_31224":72938,"_21643":121163,"_5":14891,"_28416":120867,"_3083":121164},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3632":73061,"_31224":73061,"_5":15251,"_3083":121166,"_31583":121167,"_21643":121168,"_28416":73061},"Instala con Helm",[51036,120586,120820],[],{"_3632":73062,"_31224":73061,"_21643":121170,"_5":14891,"_28416":73061,"_3083":121171},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3632":73063,"_31224":73061,"_5":31580,"_21643":121173,"_28416":121174,"_3083":121175},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3632":73064,"_31224":73061,"_5":31580,"_21643":121177,"_28416":121178,"_3083":120836},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3632":73065,"_31224":73061,"_5":31580,"_21643":121180,"_28416":121181,"_3083":121182},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3632":73066,"_31224":73061,"_5":31580,"_21643":121184,"_28416":121185,"_3083":121186},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3632":73067,"_31224":73061,"_5":31580,"_21643":121188,"_28416":121189,"_3083":121190},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3632":73068,"_31224":73061,"_5":31580,"_21643":121192,"_28416":121193,"_3083":121194},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3632":73069,"_31224":73061,"_5":31580,"_21643":121196,"_28416":121197,"_3083":121198},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3632":73070,"_31224":73061,"_5":31580,"_21643":121200,"_28416":121201,"_3083":121202},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3632":73071,"_31224":73061,"_5":31580,"_21643":121204,"_28416":121205,"_3083":121206},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3632":73072,"_31224":73061,"_5":31580,"_21643":121208,"_28416":121209,"_3083":121210},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3632":73073,"_31224":73061,"_5":31580,"_21643":121212,"_28416":121213,"_3083":121214},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3632":73074,"_31224":73061,"_5":31580,"_21643":121216,"_28416":121217,"_3083":121218},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3632":73075,"_31224":73061,"_21643":121220,"_5":14891,"_28416":121174,"_3083":121221},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3632":73076,"_31224":73061,"_21643":121223,"_5":14891,"_28416":121178,"_3083":121224},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3632":73077,"_31224":73061,"_21643":121226,"_5":14891,"_28416":121178,"_3083":121227},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3632":73078,"_31224":73061,"_21643":121229,"_5":14891,"_28416":121178,"_3083":121230},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3632":73079,"_31224":73061,"_21643":121232,"_5":14891,"_28416":121178,"_3083":121233},[],"un broker RabbitMQ accesible y sus credenciales",{"_3632":73080,"_31224":73061,"_21643":121235,"_5":14891,"_28416":121178,"_3083":121236},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3632":73081,"_31224":73061,"_21643":121238,"_5":14891,"_28416":121178,"_3083":121239},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3632":73082,"_31224":73061,"_21643":121241,"_5":14891,"_28416":121178,"_3083":121242},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3632":73083,"_31224":73061,"_21643":121244,"_5":14891,"_28416":121178,"_3083":121245},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3632":73084,"_31224":73061,"_21643":121247,"_5":14891,"_28416":121178,"_3083":121248},[],"una StorageClass y un diseño de tráfico externo",{"_3632":73085,"_31224":73061,"_21643":121250,"_5":14891,"_28416":121178,"_3083":121251},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3632":73086,"_31224":73061,"_21643":121253,"_5":14891,"_28416":121178,"_3083":121254},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3632":73087,"_31224":73061,"_21643":121256,"_5":14891,"_28416":121178,"_3083":121257},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3632":73088,"_31224":73061,"_21643":121259,"_5":14891,"_28416":121181,"_3083":121260},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3632":73089,"_31224":73061,"_21643":121262,"_5":14891,"_28416":121181,"_3083":121263},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3632":73090,"_31224":73061,"_21643":121265,"_5":14891,"_28416":121181,"_3083":121266},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3632":73091,"_31224":73061,"_21643":121268,"_5":14891,"_28416":121185,"_3083":121269},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3632":73092,"_31224":73061,"_21643":121271,"_5":14891,"_28416":121185,"_3083":121272},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3632":73093,"_31224":73061,"_21643":121274,"_5":14891,"_28416":121185,"_3083":121275},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3632":73094,"_31224":73061,"_21643":121277,"_5":14891,"_28416":121185,"_3083":121278},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3632":73095,"_31224":73061,"_21643":121280,"_5":14891,"_28416":121189,"_3083":121281},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3632":73096,"_31224":73061,"_21643":121283,"_5":14891,"_28416":121189,"_3083":121284},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3632":73097,"_31224":73061,"_21643":121286,"_5":14891,"_28416":121189,"_3083":121287},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3632":73098,"_31224":73061,"_21643":121289,"_5":14891,"_28416":121189,"_3083":121290},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3632":73099,"_31224":73061,"_21643":121292,"_5":14891,"_28416":121189,"_3083":121293},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3632":73100,"_31224":73061,"_21643":121295,"_5":14891,"_28416":121189,"_3083":121296},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3632":73101,"_31224":73061,"_21643":121298,"_5":14891,"_28416":121189,"_3083":121299},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3632":73102,"_31224":73061,"_21643":121301,"_5":14891,"_28416":121189,"_3083":121302},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3632":73103,"_31224":73061,"_21643":121304,"_5":14891,"_28416":121193,"_3083":121305},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3632":73104,"_31224":73061,"_21643":121307,"_5":14891,"_28416":121197,"_3083":121308},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3632":73105,"_31224":73061,"_21643":121310,"_5":14891,"_28416":121197,"_3083":121311},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3632":73106,"_31224":73061,"_21643":121313,"_5":14891,"_28416":121197,"_3083":121314},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3632":73107,"_31224":73061,"_21643":121316,"_5":14891,"_28416":121197,"_3083":121317},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3632":73108,"_31224":73061,"_21643":121319,"_5":14891,"_28416":121197,"_3083":121320},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3632":73109,"_31224":73061,"_21643":121322,"_5":14891,"_28416":121197,"_3083":121323},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3632":73110,"_31224":73061,"_21643":121325,"_5":14891,"_28416":121197,"_3083":121326},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3632":73111,"_31224":73061,"_21643":121328,"_5":14891,"_28416":121201,"_3083":121329},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3632":73112,"_31224":73061,"_21643":121331,"_5":14891,"_28416":121201,"_3083":121332},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3632":73113,"_31224":73061,"_21643":121334,"_5":14891,"_28416":121201,"_3083":121335},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3632":73114,"_31224":73061,"_21643":121337,"_5":14891,"_28416":121201,"_3083":121338},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3632":73115,"_31224":73061,"_21643":121340,"_5":14891,"_28416":121205,"_3083":121341},[],"Para instalar un checkout local:",{"_3632":73116,"_31224":73061,"_21643":121343,"_5":14891,"_28416":121209,"_3083":121344},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3632":73117,"_31224":73061,"_21643":121346,"_5":14891,"_28416":121209,"_3083":121347},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3632":73118,"_31224":73061,"_21643":121349,"_5":14891,"_28416":121213,"_3083":121350},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3632":73119,"_31224":73061,"_21643":121352,"_5":14891,"_28416":121213,"_3083":121353},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3632":73120,"_31224":73061,"_21643":121355,"_5":14891,"_28416":121213,"_3083":121356},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3632":73121,"_31224":73061,"_21643":121358,"_5":14891,"_28416":121213,"_3083":121359},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3632":73122,"_31224":73061,"_21643":121361,"_5":14891,"_28416":121213,"_3083":121362},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3632":73123,"_31224":73061,"_21643":121364,"_5":14891,"_28416":121217,"_3083":121365},[],"Antes de pasar a producción, revisa:",{"_3632":73124,"_31224":73061,"_21643":121367,"_5":14891,"_28416":121217,"_3083":121368},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3632":73125,"_31224":73061,"_21643":121370,"_5":14891,"_28416":121217,"_3083":121371},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3632":73126,"_31224":73061,"_21643":121373,"_5":14891,"_28416":121217,"_3083":121374},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3632":73127,"_31224":73061,"_21643":121376,"_5":14891,"_28416":121217,"_3083":121377},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3632":73128,"_31224":73061,"_21643":121379,"_5":14891,"_28416":121217,"_3083":121380},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3632":73129,"_31224":73061,"_21643":121382,"_5":14891,"_28416":121217,"_3083":121383},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3632":73130,"_31224":73061,"_21643":121385,"_5":14891,"_28416":121217,"_3083":121386},[],"SMTP, observabilidad y entrega de alertas",{"_3632":73131,"_31224":73061,"_21643":121388,"_5":14891,"_28416":121217,"_3083":121389},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3632":73132,"_31224":73061,"_21643":121391,"_5":14891,"_28416":121217,"_3083":121392},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3632":73133,"_31224":73133,"_5":15251,"_3083":121394,"_31583":121395,"_21643":121396,"_28416":73133},"Expón el Gateway",[51036,120586,120820],[],{"_3632":73134,"_31224":73133,"_21643":121398,"_5":14891,"_28416":73133,"_3083":121399},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3632":73135,"_31224":73133,"_5":31580,"_21643":121401,"_28416":121402,"_3083":121403},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3632":73136,"_31224":73133,"_5":31580,"_21643":121405,"_28416":121406,"_3083":121407},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3632":73137,"_31224":73133,"_5":31580,"_21643":121409,"_28416":121410,"_3083":121411},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3632":73138,"_31224":73133,"_5":31580,"_21643":121413,"_28416":121414,"_3083":51899},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#k3s",{"_3632":73139,"_31224":73133,"_5":31580,"_21643":121416,"_28416":121417,"_3083":121418},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3632":73140,"_31224":73133,"_5":31580,"_21643":121420,"_28416":121421,"_3083":121422},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3632":73141,"_31224":73133,"_5":31580,"_21643":121424,"_28416":121425,"_3083":121426},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3632":73142,"_31224":73133,"_5":31580,"_21643":121428,"_28416":121429,"_3083":121430},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3632":73143,"_31224":73133,"_5":31580,"_21643":121432,"_28416":121433,"_3083":121434},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3632":73144,"_31224":73133,"_5":31580,"_21643":121436,"_28416":121437,"_3083":121438},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3632":73145,"_31224":73133,"_5":31580,"_21643":121440,"_28416":121441,"_3083":121442},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3632":73146,"_31224":73133,"_21643":121444,"_5":14891,"_28416":121402,"_3083":121445},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3632":73147,"_31224":73133,"_21643":121447,"_5":14891,"_28416":121402,"_3083":121448},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3632":73148,"_31224":73133,"_21643":121450,"_5":14891,"_28416":121406,"_3083":121451},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3632":73149,"_31224":73133,"_21643":121453,"_5":14891,"_28416":121406,"_3083":121454},[],"Defínelo únicamente cuando:",{"_3632":73150,"_31224":73133,"_21643":121456,"_5":14891,"_28416":121406,"_3083":121457},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3632":73151,"_31224":73133,"_21643":121459,"_5":14891,"_28416":121406,"_3083":121460},[],"esa dirección está asignada a este Gateway",{"_3632":73152,"_31224":73133,"_21643":121462,"_5":14891,"_28416":121406,"_3083":121463},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3632":73153,"_31224":73133,"_21643":121465,"_5":14891,"_28416":121406,"_3083":121466},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3632":73154,"_31224":73133,"_21643":121468,"_5":14891,"_28416":121406,"_3083":121469},[],"No confundas estos valores:",{"_3632":73155,"_31224":73133,"_21643":121471,"_5":14891,"_28416":121406,"_3083":121472},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3632":73156,"_31224":73133,"_21643":121474,"_5":14891,"_28416":121406,"_3083":121475},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3632":73157,"_31224":73133,"_21643":121477,"_5":14891,"_28416":121406,"_3083":121478},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3632":73158,"_31224":73133,"_21643":121480,"_5":14891,"_28416":121410,"_3083":121481},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3632":73159,"_31224":73133,"_21643":121483,"_5":14891,"_28416":121410,"_3083":121484},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3632":73160,"_31224":73133,"_21643":121486,"_5":14891,"_28416":121414,"_3083":121487},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3632":73161,"_31224":73133,"_21643":121489,"_5":14891,"_28416":121414,"_3083":121490},[],"Para el diseño recomendado:",{"_3632":73162,"_31224":73133,"_21643":121492,"_5":14891,"_28416":121414,"_3083":121493},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3632":73163,"_31224":73133,"_21643":121495,"_5":14891,"_28416":121414,"_3083":121496},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3632":73164,"_31224":73133,"_21643":121498,"_5":14891,"_28416":121414,"_3083":121499},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3632":73165,"_31224":73133,"_21643":121501,"_5":14891,"_28416":121414,"_3083":121502},[],"Apunta DNS a la dirección accesible de la VM.",{"_3632":73166,"_31224":73133,"_21643":121504,"_5":14891,"_28416":121414,"_3083":121505},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3632":73167,"_31224":73133,"_21643":121507,"_5":14891,"_28416":121417,"_3083":121508},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3632":73168,"_31224":73133,"_21643":121510,"_5":14891,"_28416":121421,"_3083":121511},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3632":73169,"_31224":73133,"_21643":121513,"_5":14891,"_28416":121421,"_3083":121514},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3632":73170,"_31224":73133,"_21643":121516,"_5":14891,"_28416":121425,"_3083":121517},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3632":73171,"_31224":73133,"_21643":121519,"_5":14891,"_28416":121425,"_3083":121520},[],"Requisito",{"_3632":73172,"_31224":73133,"_21643":121522,"_5":14891,"_28416":121425,"_3083":121523},[],"Diseño recomendado",{"_3632":73173,"_31224":73133,"_21643":121525,"_5":14891,"_28416":121425,"_3083":121526},[],"Consecuencia",{"_3632":73174,"_31224":73133,"_21643":121528,"_5":14891,"_28416":121425,"_3083":121529},[],"Varias URL o servicios de Lamassu",{"_3632":73175,"_31224":73133,"_21643":121531,"_5":14891,"_28416":121425,"_3083":121532},[],"Un Gateway con varias rutas",{"_3632":73176,"_31224":73133,"_21643":121534,"_5":14891,"_28416":121425,"_3083":121535},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3632":73177,"_31224":73133,"_21643":121537,"_5":14891,"_28416":121425,"_3083":121538},[],"Gateways independientes e IP externas distintas",{"_3632":73178,"_31224":73133,"_21643":121540,"_5":14891,"_28416":121425,"_3083":121541},[],"Una VIP por Gateway",{"_3632":73179,"_31224":73133,"_21643":121543,"_5":14891,"_28416":121425,"_3083":121544},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3632":73180,"_31224":73133,"_21643":121546,"_5":14891,"_28416":121425,"_3083":121547},[],"Gateways independientes, un nodo y una IP",{"_3632":73181,"_31224":73133,"_21643":121549,"_5":14891,"_28416":121425,"_3083":121550},[],"Puertos externos diferentes",{"_3632":73182,"_31224":73133,"_21643":121552,"_5":14891,"_28416":121425,"_3083":121553},[],"Los clientes deben indicar puertos no estándar",{"_3632":73183,"_31224":73133,"_21643":121555,"_5":14891,"_28416":121425,"_3083":121556},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3632":73184,"_31224":73133,"_21643":121558,"_5":14891,"_28416":121425,"_3083":121559},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3632":73185,"_31224":73133,"_21643":121561,"_5":14891,"_28416":121425,"_3083":121562},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3632":73186,"_31224":73133,"_21643":121564,"_5":14891,"_28416":121425,"_3083":121565},[],"Recursos Gateway separados pero proxy compartido",{"_3632":73187,"_31224":73133,"_21643":121567,"_5":14891,"_28416":121425,"_3083":121568},[],"Modo merged Gateway de Envoy",{"_3632":73188,"_31224":73133,"_21643":121570,"_5":14891,"_28416":121425,"_3083":121571},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3632":73189,"_31224":73133,"_21643":121573,"_5":14891,"_28416":121425,"_3083":121574},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3632":73190,"_31224":73133,"_21643":121576,"_5":14891,"_28416":121425,"_3083":121577},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3632":73191,"_31224":73133,"_21643":121579,"_5":14891,"_28416":121425,"_3083":121580},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3632":73192,"_31224":73133,"_21643":121582,"_5":14891,"_28416":121425,"_3083":121583},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3632":73193,"_31224":73133,"_21643":121585,"_5":14891,"_28416":121429,"_3083":121586},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3632":73194,"_31224":73133,"_21643":121588,"_5":14891,"_28416":121433,"_3083":121589},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3632":73195,"_31224":73133,"_21643":121591,"_5":14891,"_28416":121433,"_3083":121592},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3632":73196,"_31224":73133,"_21643":121594,"_5":14891,"_28416":121433,"_3083":121595},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3632":73197,"_31224":73133,"_21643":121597,"_5":14891,"_28416":121433,"_3083":121598},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3632":73198,"_31224":73133,"_21643":121600,"_5":14891,"_28416":121433,"_3083":121601},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3632":73199,"_31224":73133,"_21643":121603,"_5":14891,"_28416":121437,"_3083":121604},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3632":73200,"_31224":73133,"_21643":121606,"_5":14891,"_28416":121437,"_3083":121607},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3632":73201,"_31224":73133,"_21643":121609,"_5":14891,"_28416":121441,"_3083":121610},[],"Comprueba, en orden:",{"_3632":73202,"_31224":73133,"_21643":121612,"_5":14891,"_28416":121441,"_3083":121613},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3632":73203,"_31224":73133,"_21643":121615,"_5":14891,"_28416":121441,"_3083":121616},[],"Su estado contiene la dirección esperada.",{"_3632":73204,"_31224":73133,"_21643":121618,"_5":14891,"_28416":121441,"_3083":121619},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3632":73205,"_31224":73133,"_21643":121621,"_5":14891,"_28416":121441,"_3083":121622},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3632":73206,"_31224":73133,"_21643":121624,"_5":14891,"_28416":121441,"_3083":121625},[],"DNS resuelve al endpoint accesible externamente.",{"_3632":73207,"_31224":73133,"_21643":121627,"_5":14891,"_28416":121441,"_3083":121628},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3632":73208,"_31224":73133,"_21643":121630,"_5":14891,"_28416":121441,"_3083":121631},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3632":73209,"_31224":73209,"_5":15251,"_3083":51143,"_31583":121633,"_21643":121634,"_28416":73209},[51036,120586,120820],[],{"_3632":73210,"_31224":73209,"_21643":121636,"_5":14891,"_28416":73209,"_3083":121637},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3632":73211,"_31224":73209,"_5":31580,"_21643":121639,"_28416":121640,"_3083":121641},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3632":73212,"_31224":73209,"_5":31580,"_21643":121643,"_28416":121644,"_3083":121645},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3632":73213,"_31224":73209,"_5":31580,"_21643":121647,"_28416":121648,"_3083":121649},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3632":73214,"_31224":73209,"_5":31580,"_21643":121651,"_28416":121652,"_3083":121653},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3632":73215,"_31224":73209,"_5":31580,"_21643":121655,"_28416":121656,"_3083":121657},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3632":73216,"_31224":73209,"_5":31580,"_21643":121659,"_28416":121660,"_3083":121661},[],"/docs/pr-preview/pr-82/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3632":73217,"_31224":73209,"_21643":121663,"_5":14891,"_28416":121640,"_3083":121664},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3632":73218,"_31224":73209,"_21643":121666,"_5":14891,"_28416":121644,"_3083":121667},[],"Flujo",{"_3632":73219,"_31224":73209,"_21643":121669,"_5":14891,"_28416":121644,"_3083":121670},[],"Úsalo para",{"_3632":73220,"_31224":73209,"_21643":121672,"_5":14891,"_28416":121644,"_3083":121673},[],"Qué instala",{"_3632":73221,"_31224":73209,"_21643":121675,"_5":14891,"_28416":121644,"_3083":52161},[],{"_3632":73222,"_31224":73209,"_21643":121677,"_5":14891,"_28416":121644,"_3083":121678},[],"Producción y entornos controlados",{"_3632":73223,"_31224":73209,"_21643":121680,"_5":14891,"_28416":121644,"_3083":121681},[],"Servicios de Lamassu y recursos de Gateway API",{"_3632":73224,"_31224":73209,"_21643":121683,"_5":14891,"_28416":121644,"_3083":51280},[],{"_3632":73225,"_31224":73209,"_21643":121685,"_5":14891,"_28416":121644,"_3083":121686},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3632":73226,"_31224":73209,"_21643":121688,"_5":14891,"_28416":121644,"_3083":121689},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3632":73227,"_31224":73209,"_21643":121691,"_5":14891,"_28416":121648,"_3083":121692},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3632":73228,"_31224":73209,"_21643":121694,"_5":14891,"_28416":121648,"_3083":121695},[],"Área",{"_3632":73229,"_31224":73209,"_21643":121697,"_5":14891,"_28416":121648,"_3083":121698},[],"El chart de Lamassu proporciona",{"_3632":73230,"_31224":73209,"_21643":121700,"_5":14891,"_28416":121648,"_3083":121701},[],"Tú proporcionas",{"_3632":73231,"_31224":73209,"_21643":121703,"_5":14891,"_28416":121648,"_3083":121704},[],"Aplicaciones Lamassu",{"_3632":73232,"_31224":73209,"_21643":121706,"_5":14891,"_28416":121648,"_3083":121707},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3632":73233,"_31224":73209,"_21643":121709,"_5":14891,"_28416":121648,"_3083":121710},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3632":73234,"_31224":73209,"_21643":121712,"_5":14891,"_28416":121648,"_3083":121713},[],"Datos PostgreSQL",{"_3632":73235,"_31224":73209,"_21643":121715,"_5":14891,"_28416":121648,"_3083":121716},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3632":73236,"_31224":73209,"_21643":121718,"_5":14891,"_28416":121648,"_3083":121719},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3632":73237,"_31224":73209,"_21643":121721,"_5":14891,"_28416":121648,"_3083":121722},[],"Mensajería",{"_3632":73238,"_31224":73209,"_21643":121724,"_5":14891,"_28416":121648,"_3083":121725},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3632":73239,"_31224":73209,"_21643":121727,"_5":14891,"_28416":121648,"_3083":121728},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3632":73240,"_31224":73209,"_21643":121730,"_5":14891,"_28416":121648,"_3083":121731},[],"Identidad",{"_3632":73241,"_31224":73209,"_21643":121733,"_5":14891,"_28416":121648,"_3083":121734},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3632":73242,"_31224":73209,"_21643":121736,"_5":14891,"_28416":121648,"_3083":121737},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3632":73243,"_31224":73209,"_21643":121739,"_5":14891,"_28416":121648,"_3083":121740},[],"Enrutamiento externo",{"_3632":73244,"_31224":73209,"_21643":121742,"_5":14891,"_28416":121648,"_3083":121743},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3632":73245,"_31224":73209,"_21643":121745,"_5":14891,"_28416":121648,"_3083":121746},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3632":73246,"_31224":73209,"_21643":121748,"_5":14891,"_28416":121648,"_3083":52235},[],{"_3632":73247,"_31224":73209,"_21643":121750,"_5":14891,"_28416":121648,"_3083":121751},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3632":73248,"_31224":73209,"_21643":121753,"_5":14891,"_28416":121648,"_3083":121754},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3632":73249,"_31224":73209,"_21643":121756,"_5":14891,"_28416":121648,"_3083":121757},[],"Datos persistentes de la aplicación",{"_3632":73250,"_31224":73209,"_21643":121759,"_5":14891,"_28416":121648,"_3083":121760},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3632":73251,"_31224":73209,"_21643":121762,"_5":14891,"_28416":121648,"_3083":121763},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3632":73252,"_31224":73209,"_21643":121765,"_5":14891,"_28416":121648,"_3083":121766},[],"Integraciones opcionales",{"_3632":73253,"_31224":73209,"_21643":121768,"_5":14891,"_28416":121648,"_3083":121769},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3632":73254,"_31224":73209,"_21643":121771,"_5":14891,"_28416":121648,"_3083":121772},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3632":73255,"_31224":73209,"_21643":121774,"_5":14891,"_28416":121648,"_3083":121775},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3632":73256,"_31224":73209,"_21643":121777,"_5":14891,"_28416":121648,"_3083":121778},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3632":73257,"_31224":73209,"_21643":121780,"_5":14891,"_28416":121652,"_3083":121781},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3632":73258,"_31224":73209,"_21643":121783,"_5":14891,"_28416":121652,"_3083":121784},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3632":73259,"_31224":73209,"_21643":121786,"_5":14891,"_28416":121656,"_3083":121787},[],"Kubernetes 1.24 o posterior",{"_3632":73260,"_31224":73209,"_21643":121789,"_5":14891,"_28416":121656,"_3083":121790},[],"Helm 3.2 o posterior",{"_3632":73261,"_31224":73209,"_21643":121792,"_5":14891,"_28416":121656,"_3083":121793},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3632":73262,"_31224":73209,"_21643":121795,"_5":14891,"_28416":121656,"_3083":121796},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3632":73263,"_31224":73209,"_21643":121798,"_5":14891,"_28416":121656,"_3083":121799},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3632":73264,"_31224":73209,"_21643":121801,"_5":14891,"_28416":121656,"_3083":121802},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3632":73265,"_31224":73209,"_21643":121804,"_5":14891,"_28416":121656,"_3083":121805},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3632":73266,"_31224":73209,"_21643":121807,"_5":14891,"_28416":121660,"_3083":121808},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":73267,"_31224":73209,"_21643":121810,"_5":14891,"_28416":121660,"_3083":121811},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3632":73268,"_31224":73209,"_21643":121813,"_5":14891,"_28416":121660,"_3083":121814},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3632":73269,"_31224":73209,"_21643":121816,"_5":14891,"_28416":121660,"_3083":121817},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3632":73270,"_31224":73270,"_5":15251,"_3083":121819,"_31583":121820,"_21643":121822,"_28416":73270},"Resolución de problemas de despliegue",[51036,120586,121821],"Operación",[],{"_3632":73271,"_31224":73270,"_21643":121824,"_5":14891,"_28416":73270,"_3083":121825},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3632":73272,"_31224":73270,"_5":31580,"_21643":121827,"_28416":121828,"_3083":121829},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3632":73273,"_31224":73270,"_5":31580,"_21643":121831,"_28416":121832,"_3083":121833},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3632":73274,"_31224":73270,"_5":31580,"_21643":121835,"_28416":121836,"_3083":121837},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3632":73275,"_31224":73270,"_5":31580,"_21643":121839,"_28416":121840,"_3083":121841},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3632":73276,"_31224":73270,"_5":31580,"_21643":121843,"_28416":121844,"_3083":121845},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3632":73277,"_31224":73270,"_5":31580,"_21643":121847,"_28416":121848,"_3083":121849},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3632":73278,"_31224":73270,"_5":31580,"_21643":121851,"_28416":121852,"_3083":121853},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3632":73279,"_31224":73270,"_5":31580,"_21643":121855,"_28416":121856,"_3083":121857},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3632":73280,"_31224":73270,"_5":31580,"_21643":121859,"_28416":121860,"_3083":121861},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3632":73281,"_31224":73270,"_5":31580,"_21643":121863,"_28416":121864,"_3083":121865},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3632":73282,"_31224":73270,"_5":31580,"_21643":121867,"_28416":121868,"_3083":121869},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3632":73283,"_31224":73270,"_5":31580,"_21643":121871,"_28416":121872,"_3083":121873},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3632":73284,"_31224":73270,"_5":31580,"_21643":121875,"_28416":121876,"_3083":121877},[],"/docs/pr-preview/pr-82/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3632":73285,"_31224":73270,"_21643":121879,"_5":14891,"_28416":73270,"_3083":121880},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3632":73286,"_31224":73270,"_21643":121882,"_5":14891,"_28416":121832,"_3083":121883},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3632":73287,"_31224":73270,"_21643":121885,"_5":14891,"_28416":121836,"_3083":121886},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3632":73288,"_31224":73270,"_21643":121888,"_5":14891,"_28416":121840,"_3083":121889},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3632":73289,"_31224":73270,"_21643":121891,"_5":14891,"_28416":121844,"_3083":121892},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3632":73290,"_31224":73270,"_21643":121894,"_5":14891,"_28416":121848,"_3083":121895},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3632":73291,"_31224":73270,"_21643":121897,"_5":14891,"_28416":121852,"_3083":121898},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3632":73292,"_31224":73270,"_21643":121900,"_5":14891,"_28416":121852,"_3083":121901},[],"Ejecuta también la prueba de conectividad del chart:",{"_3632":73293,"_31224":73270,"_21643":121903,"_5":14891,"_28416":121852,"_3083":121904},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3632":73294,"_31224":73270,"_21643":121906,"_5":14891,"_28416":121852,"_3083":121907},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3632":73295,"_31224":73270,"_21643":121909,"_5":14891,"_28416":121856,"_3083":121910},[],"Si recibes un 401:",{"_3632":73296,"_31224":73270,"_21643":121912,"_5":14891,"_28416":121856,"_3083":121913},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3632":73297,"_31224":73270,"_21643":121915,"_5":14891,"_28416":121856,"_3083":121916},[],"verifica emisor, audiencia y expiración del token;",{"_3632":73298,"_31224":73270,"_21643":121918,"_5":14891,"_28416":121856,"_3083":121919},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3632":73299,"_31224":73270,"_21643":121921,"_5":14891,"_28416":121856,"_3083":121922},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3632":73300,"_31224":73270,"_21643":121924,"_5":14891,"_28416":121856,"_3083":121925},[],"Si el login termina pero las APIs devuelven 403:",{"_3632":73301,"_31224":73270,"_21643":121927,"_5":14891,"_28416":121856,"_3083":121928},[],"inspecciona los claims reales del token;",{"_3632":73302,"_31224":73270,"_21643":121930,"_5":14891,"_28416":121856,"_3083":121931},[],"confirma que coinciden con un principal activo;",{"_3632":73303,"_31224":73270,"_21643":121933,"_5":14891,"_28416":121856,"_3083":121934},[],"revisa las políticas concedidas al principal;",{"_3632":73304,"_31224":73270,"_21643":121936,"_5":14891,"_28416":121856,"_3083":121937},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3632":73305,"_31224":73270,"_21643":121939,"_5":14891,"_28416":121856,"_3083":121940},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3632":73306,"_31224":73270,"_21643":121942,"_5":14891,"_28416":121860,"_3083":121943},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3632":73307,"_31224":73270,"_21643":121945,"_5":14891,"_28416":121860,"_3083":121946},[],"Localiza el pod y Service de authz.",{"_3632":73308,"_31224":73270,"_21643":121948,"_5":14891,"_28416":121860,"_3083":121949},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3632":73309,"_31224":73270,"_21643":121951,"_5":14891,"_28416":121860,"_3083":121952},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3632":73310,"_31224":73270,"_21643":121954,"_5":14891,"_28416":121860,"_3083":121955},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3632":73311,"_31224":73270,"_21643":121957,"_5":14891,"_28416":121860,"_3083":121958},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3632":73312,"_31224":73270,"_21643":121960,"_5":14891,"_28416":121864,"_3083":121961},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3632":73313,"_31224":73270,"_21643":121963,"_5":14891,"_28416":121868,"_3083":121964},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3632":73314,"_31224":73270,"_21643":121966,"_5":14891,"_28416":121868,"_3083":121967},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3632":73315,"_31224":73270,"_21643":121969,"_5":14891,"_28416":121868,"_3083":121970},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3632":73316,"_31224":73270,"_21643":121972,"_5":14891,"_28416":121868,"_3083":121973},[],"volumen persistente sin enlazar;",{"_3632":73317,"_31224":73270,"_21643":121975,"_5":14891,"_28416":121868,"_3083":121976},[],"imagen inaccesible o política de pull incorrecta;",{"_3632":73318,"_31224":73270,"_21643":121978,"_5":14891,"_28416":121868,"_3083":121979},[],"configuración inválida del motor criptográfico;",{"_3632":73319,"_31224":73270,"_21643":121981,"_5":14891,"_28416":121868,"_3083":121982},[],"límites de CPU o memoria demasiado bajos;",{"_3632":73320,"_31224":73270,"_21643":121984,"_5":14891,"_28416":121868,"_3083":121985},[],"migración previa incompleta.",{"_3632":73321,"_31224":73270,"_21643":121987,"_5":14891,"_28416":121868,"_3083":121988},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3632":73322,"_31224":73270,"_21643":121990,"_5":14891,"_28416":121868,"_3083":121991},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3632":73323,"_31224":73270,"_21643":121993,"_5":14891,"_28416":121868,"_3083":121994},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3632":73324,"_31224":73270,"_21643":121996,"_5":14891,"_28416":121872,"_3083":121997},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3632":73325,"_31224":73270,"_21643":121999,"_5":14891,"_28416":121872,"_3083":122000},[],"verifica que esté habilitado en el servicio emisor;",{"_3632":73326,"_31224":73270,"_21643":122002,"_5":14891,"_28416":121872,"_3083":122003},[],"comprueba conectividad y credenciales AMQP;",{"_3632":73327,"_31224":73270,"_21643":122005,"_5":14891,"_28416":121872,"_3083":122006},[],"revisa exchange, routing key, colas y consumidores;",{"_3632":73328,"_31224":73270,"_21643":122008,"_5":14891,"_28416":121872,"_3083":122009},[],"inspecciona dead-letter queues;",{"_3632":73329,"_31224":73270,"_21643":122011,"_5":14891,"_28416":121872,"_3083":122012},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3632":73330,"_31224":73270,"_21643":122014,"_5":14891,"_28416":121872,"_3083":122015},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3632":73331,"_31224":73270,"_21643":122017,"_5":14891,"_28416":121872,"_3083":122018},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3632":73332,"_31224":73270,"_21643":122020,"_5":14891,"_28416":121872,"_3083":122021},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3632":73333,"_31224":73270,"_21643":122023,"_5":14891,"_28416":121872,"_3083":122024},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3632":73334,"_31224":73270,"_21643":122026,"_5":14891,"_28416":121872,"_3083":122027},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3632":73335,"_31224":73270,"_21643":122029,"_5":14891,"_28416":121872,"_3083":122030},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3632":73336,"_31224":73270,"_21643":122032,"_5":14891,"_28416":121872,"_3083":122033},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3632":73337,"_31224":73270,"_21643":122035,"_5":14891,"_28416":121876,"_3083":122036},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3632":73338,"_31224":73270,"_21643":122038,"_5":14891,"_28416":121876,"_3083":122039},[],"Antes de cerrar una incidencia, guarda:",{"_3632":73339,"_31224":73270,"_21643":122041,"_5":14891,"_28416":121876,"_3083":122042},[],"causa confirmada;",{"_3632":73340,"_31224":73270,"_21643":122044,"_5":14891,"_28416":121876,"_3083":122045},[],"alcance temporal y recursos afectados;",{"_3632":73341,"_31224":73270,"_21643":122047,"_5":14891,"_28416":121876,"_3083":122048},[],"comandos o consultas utilizados;",{"_3632":73342,"_31224":73270,"_21643":122050,"_5":14891,"_28416":121876,"_3083":122051},[],"cambio aplicado y forma de revertirlo;",{"_3632":73343,"_31224":73270,"_21643":122053,"_5":14891,"_28416":121876,"_3083":122054},[],"validación desde un consumidor;",{"_3632":73344,"_31224":73270,"_21643":122056,"_5":14891,"_28416":121876,"_3083":122057},[],"acción preventiva y propietario.",{"_3632":73345,"_31224":73345,"_5":15251,"_3083":122059,"_31583":122060,"_21643":122064,"_28416":73345},"Modelo de datos",[51036,122061,122062,122063],"Plataforma","Administración","Control de acceso",[],{"_3632":73346,"_31224":73345,"_21643":122066,"_5":14891,"_28416":73345,"_3083":122067},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3632":73347,"_31224":73345,"_5":31580,"_21643":122069,"_28416":122070,"_3083":122071},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3632":73348,"_31224":73345,"_5":31580,"_21643":122073,"_28416":122074,"_3083":122075},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3632":73349,"_31224":73345,"_21643":122077,"_5":14891,"_28416":73345,"_3083":122078},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3632":73350,"_31224":73345,"_21643":122080,"_5":14891,"_28416":122070,"_3083":122081},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3632":73351,"_31224":73345,"_21643":122083,"_5":14891,"_28416":122070,"_3083":122084},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3632":73352,"_31224":73345,"_21643":122086,"_5":14891,"_28416":122070,"_3083":122087},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3632":73353,"_31224":73345,"_21643":122089,"_5":14891,"_28416":122074,"_3083":122090},[],"Entidad (`schema_name.entity_type`)",{"_3632":73354,"_31224":73345,"_21643":122092,"_5":14891,"_28416":122074,"_3083":122093},[],"Tabla (`table_name`)",{"_3632":73355,"_31224":73345,"_21643":122095,"_5":14891,"_28416":122074,"_3083":122096},[],"Clave (`primary_key`)",{"_3632":73356,"_31224":73345,"_21643":122098,"_5":14891,"_28416":122074,"_3083":52586},[],{"_3632":73357,"_31224":73345,"_21643":122100,"_5":14891,"_28416":122074,"_3083":52589},[],{"_3632":73358,"_31224":73345,"_21643":122102,"_5":14891,"_28416":122074,"_3083":52592},[],{"_3632":73359,"_31224":73345,"_21643":122104,"_5":14891,"_28416":122074,"_3083":52595},[],{"_3632":73360,"_31224":73345,"_21643":122106,"_5":14891,"_28416":122074,"_3083":52598},[],{"_3632":73361,"_31224":73345,"_21643":122108,"_5":14891,"_28416":122074,"_3083":52601},[],{"_3632":73362,"_31224":73345,"_21643":122110,"_5":14891,"_28416":122074,"_3083":52604},[],{"_3632":73363,"_31224":73345,"_21643":122112,"_5":14891,"_28416":122074,"_3083":52607},[],{"_3632":73364,"_31224":73345,"_21643":122114,"_5":14891,"_28416":122074,"_3083":52601},[],{"_3632":73365,"_31224":73345,"_21643":122116,"_5":14891,"_28416":122074,"_3083":52612},[],{"_3632":73366,"_31224":73345,"_21643":122118,"_5":14891,"_28416":122074,"_3083":52615},[],{"_3632":73367,"_31224":73345,"_21643":122120,"_5":14891,"_28416":122074,"_3083":52618},[],{"_3632":73368,"_31224":73345,"_21643":122122,"_5":14891,"_28416":122074,"_3083":52621},[],{"_3632":73369,"_31224":73345,"_21643":122124,"_5":14891,"_28416":122074,"_3083":52624},[],{"_3632":73370,"_31224":73345,"_21643":122126,"_5":14891,"_28416":122074,"_3083":52601},[],{"_3632":73371,"_31224":73345,"_21643":122128,"_5":14891,"_28416":122074,"_3083":52629},[],{"_3632":73372,"_31224":73345,"_21643":122130,"_5":14891,"_28416":122074,"_3083":52632},[],{"_3632":73373,"_31224":73345,"_21643":122132,"_5":14891,"_28416":122074,"_3083":52601},[],{"_3632":73374,"_31224":73345,"_21643":122134,"_5":14891,"_28416":122074,"_3083":52637},[],{"_3632":73375,"_31224":73345,"_21643":122136,"_5":14891,"_28416":122074,"_3083":52640},[],{"_3632":73376,"_31224":73345,"_21643":122138,"_5":14891,"_28416":122074,"_3083":52601},[],{"_3632":73377,"_31224":73345,"_21643":122140,"_5":14891,"_28416":122074,"_3083":52645},[],{"_3632":73378,"_31224":73345,"_21643":122142,"_5":14891,"_28416":122074,"_3083":52648},[],{"_3632":73379,"_31224":73345,"_21643":122144,"_5":14891,"_28416":122074,"_3083":52601},[],{"_3632":73380,"_31224":73345,"_21643":122146,"_5":14891,"_28416":122074,"_3083":52653},[],{"_3632":73381,"_31224":73345,"_21643":122148,"_5":14891,"_28416":122074,"_3083":52656},[],{"_3632":73382,"_31224":73345,"_21643":122150,"_5":14891,"_28416":122074,"_3083":52659},[],{"_3632":73383,"_31224":73345,"_21643":122152,"_5":14891,"_28416":122074,"_3083":52662},[],{"_3632":73384,"_31224":73345,"_21643":122154,"_5":14891,"_28416":122074,"_3083":52665},[],{"_3632":73385,"_31224":73345,"_21643":122156,"_5":14891,"_28416":122074,"_3083":52668},[],{"_3632":73386,"_31224":73345,"_21643":122158,"_5":14891,"_28416":122074,"_3083":122159},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3632":73387,"_31224":73345,"_21643":122161,"_5":14891,"_28416":122074,"_3083":122162},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3632":73388,"_31224":73345,"_21643":122164,"_5":14891,"_28416":122074,"_3083":122165},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3632":73389,"_31224":73389,"_5":15251,"_3083":122167,"_31583":122168,"_21643":122169,"_28416":73389},"Visión general del control de acceso",[51036,122061,122062,122063],[],{"_3632":73390,"_31224":73389,"_21643":122171,"_5":14891,"_28416":73389,"_3083":122172},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3632":73391,"_31224":73389,"_5":31580,"_21643":122174,"_28416":122175,"_3083":122176},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3632":73392,"_31224":73389,"_5":31580,"_21643":122178,"_28416":122179,"_3083":122180},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3632":73393,"_31224":73389,"_5":31580,"_21643":122182,"_28416":122183,"_3083":122184},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3632":73394,"_31224":73389,"_5":31580,"_21643":122186,"_28416":122187,"_3083":122188},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3632":73395,"_31224":73389,"_5":31580,"_21643":122190,"_28416":122191,"_3083":122192},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3632":73396,"_31224":73389,"_5":31580,"_21643":122194,"_28416":122195,"_3083":122196},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3632":73397,"_31224":73389,"_5":31580,"_21643":122198,"_28416":122199,"_3083":122200},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3632":73398,"_31224":73389,"_5":31580,"_21643":122202,"_28416":122203,"_3083":122204},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3632":73399,"_31224":73389,"_5":31580,"_21643":122206,"_28416":122207,"_3083":122208},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3632":73400,"_31224":73389,"_5":31580,"_21643":122210,"_28416":122211,"_3083":122212},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3632":73401,"_31224":73389,"_5":31580,"_21643":122214,"_28416":122215,"_3083":122216},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3632":73402,"_31224":73389,"_5":31580,"_21643":122218,"_28416":122219,"_3083":122220},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3632":73403,"_31224":73389,"_5":31580,"_21643":122222,"_28416":122223,"_3083":122224},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3632":73404,"_31224":73389,"_5":31580,"_21643":122226,"_28416":122227,"_3083":122228},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3632":73405,"_31224":73389,"_5":31580,"_21643":122230,"_28416":122231,"_3083":122232},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3632":73406,"_31224":73389,"_5":31580,"_21643":122234,"_28416":122235,"_3083":121202},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3632":73407,"_31224":73389,"_5":31580,"_21643":122237,"_28416":122238,"_3083":122239},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3632":73408,"_31224":73389,"_5":31580,"_21643":122241,"_28416":122242,"_3083":122243},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3632":73409,"_31224":73389,"_5":31580,"_21643":122245,"_28416":122246,"_3083":122247},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3632":73410,"_31224":73389,"_5":31580,"_21643":122249,"_28416":122250,"_3083":122251},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3632":73411,"_31224":73389,"_5":31580,"_21643":122253,"_28416":122254,"_3083":122255},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3632":73412,"_31224":73389,"_5":31580,"_21643":122257,"_28416":122258,"_3083":122259},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3632":73413,"_31224":73389,"_5":31580,"_21643":122261,"_28416":122262,"_3083":122263},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3632":73414,"_31224":73389,"_5":31580,"_21643":122265,"_28416":122266,"_3083":122267},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3632":73415,"_31224":73389,"_5":31580,"_21643":122269,"_28416":122270,"_3083":122271},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3632":73416,"_31224":73389,"_5":31580,"_21643":122273,"_28416":122274,"_3083":122275},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3632":73417,"_31224":73389,"_5":31580,"_21643":122277,"_28416":122278,"_3083":122279},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3632":73418,"_31224":73389,"_5":31580,"_21643":122281,"_28416":122282,"_3083":122283},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3632":73419,"_31224":73389,"_5":31580,"_21643":122285,"_28416":122286,"_3083":122287},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3632":73420,"_31224":73389,"_5":31580,"_21643":122289,"_28416":122290,"_3083":122291},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3632":73421,"_31224":73389,"_5":31580,"_21643":122293,"_28416":122294,"_3083":122295},[],"/docs/pr-preview/pr-82/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3632":73422,"_31224":73389,"_21643":122297,"_5":14891,"_28416":73389,"_3083":122298},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3632":73423,"_31224":73389,"_21643":122300,"_5":14891,"_28416":73389,"_3083":122301},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3632":73424,"_31224":73389,"_21643":122303,"_5":14891,"_28416":73389,"_3083":122304},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3632":73425,"_31224":73389,"_21643":122306,"_5":14891,"_28416":122175,"_3083":122307},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3632":73426,"_31224":73389,"_21643":122309,"_5":14891,"_28416":122175,"_3083":122310},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3632":73427,"_31224":73389,"_21643":122312,"_5":14891,"_28416":122175,"_3083":122313},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3632":73428,"_31224":73389,"_21643":122315,"_5":14891,"_28416":122175,"_3083":122316},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3632":73429,"_31224":73389,"_21643":122318,"_5":14891,"_28416":122175,"_3083":122319},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3632":73430,"_31224":73389,"_21643":122321,"_5":14891,"_28416":122175,"_3083":122322},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3632":73431,"_31224":73389,"_21643":122324,"_5":14891,"_28416":122179,"_3083":122325},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3632":73432,"_31224":73389,"_21643":122327,"_5":14891,"_28416":122179,"_3083":122328},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3632":73433,"_31224":73389,"_21643":122330,"_5":14891,"_28416":122183,"_3083":122331},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3632":73434,"_31224":73389,"_21643":122333,"_5":14891,"_28416":122183,"_3083":122334},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3632":73435,"_31224":73389,"_21643":122336,"_5":14891,"_28416":122183,"_3083":122337},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3632":73436,"_31224":73389,"_21643":122339,"_5":14891,"_28416":122183,"_3083":122340},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3632":73437,"_31224":73389,"_21643":122342,"_5":14891,"_28416":122183,"_3083":122343},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3632":73438,"_31224":73389,"_21643":122345,"_5":14891,"_28416":122183,"_3083":122346},[],"Carga por separado las políticas concedidas a cada principal.",{"_3632":73439,"_31224":73389,"_21643":122348,"_5":14891,"_28416":122183,"_3083":122349},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3632":73440,"_31224":73389,"_21643":122351,"_5":14891,"_28416":122183,"_3083":122352},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3632":73441,"_31224":73389,"_21643":122354,"_5":14891,"_28416":122183,"_3083":122355},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3632":73442,"_31224":73389,"_21643":122357,"_5":14891,"_28416":122183,"_3083":122358},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3632":73443,"_31224":73389,"_21643":122360,"_5":14891,"_28416":122183,"_3083":122361},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3632":73444,"_31224":73389,"_21643":122363,"_5":14891,"_28416":122183,"_3083":122364},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3632":73445,"_31224":73389,"_21643":122366,"_5":14891,"_28416":122187,"_3083":122367},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3632":73446,"_31224":73389,"_21643":122369,"_5":14891,"_28416":122187,"_3083":122370},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3632":73447,"_31224":73389,"_21643":122372,"_5":14891,"_28416":122187,"_3083":122373},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3632":73448,"_31224":73389,"_21643":122375,"_5":14891,"_28416":122187,"_3083":122376},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3632":73449,"_31224":73389,"_21643":122378,"_5":14891,"_28416":122187,"_3083":122379},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3632":73450,"_31224":73389,"_21643":122381,"_5":14891,"_28416":122187,"_3083":122382},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3632":73451,"_31224":73389,"_21643":122384,"_5":14891,"_28416":122187,"_3083":122385},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3632":73452,"_31224":73389,"_21643":122387,"_5":14891,"_28416":122187,"_3083":122388},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3632":73453,"_31224":73389,"_21643":122390,"_5":14891,"_28416":122187,"_3083":122391},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3632":73454,"_31224":73389,"_21643":122393,"_5":14891,"_28416":122187,"_3083":122394},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3632":73455,"_31224":73389,"_21643":122396,"_5":14891,"_28416":122191,"_3083":122397},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3632":73456,"_31224":73389,"_21643":122399,"_5":14891,"_28416":122191,"_3083":122400},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3632":73457,"_31224":73389,"_21643":122402,"_5":14891,"_28416":122191,"_3083":122403},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3632":73458,"_31224":73389,"_21643":122405,"_5":14891,"_28416":122191,"_3083":122406},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3632":73459,"_31224":73389,"_21643":122408,"_5":14891,"_28416":122191,"_3083":122409},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3632":73460,"_31224":73389,"_21643":122411,"_5":14891,"_28416":122191,"_3083":122412},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3632":73461,"_31224":73389,"_21643":122414,"_5":14891,"_28416":122191,"_3083":122415},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3632":73462,"_31224":73389,"_21643":122417,"_5":14891,"_28416":122191,"_3083":122418},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3632":73463,"_31224":73389,"_21643":122420,"_5":14891,"_28416":122191,"_3083":122421},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3632":73464,"_31224":73389,"_21643":122423,"_5":14891,"_28416":122191,"_3083":122424},[],"Las acciones se dividen en dos grupos:",{"_3632":73465,"_31224":73389,"_21643":122426,"_5":14891,"_28416":122191,"_3083":122427},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3632":73466,"_31224":73389,"_21643":122429,"_5":14891,"_28416":122191,"_3083":122430},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3632":73467,"_31224":73389,"_21643":122432,"_5":14891,"_28416":122191,"_3083":122433},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3632":73468,"_31224":73389,"_21643":122435,"_5":14891,"_28416":122195,"_3083":122436},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3632":73469,"_31224":73389,"_21643":122438,"_5":14891,"_28416":122195,"_3083":122439},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3632":73470,"_31224":73389,"_21643":122441,"_5":14891,"_28416":122195,"_3083":122442},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3632":73471,"_31224":73389,"_21643":122444,"_5":14891,"_28416":122199,"_3083":122445},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3632":73472,"_31224":73389,"_21643":122447,"_5":14891,"_28416":122199,"_3083":122448},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3632":73473,"_31224":73389,"_21643":122450,"_5":14891,"_28416":122199,"_3083":122451},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3632":73474,"_31224":73389,"_21643":122453,"_5":14891,"_28416":122199,"_3083":122454},[],"Los operadores implementados son:",{"_3632":73475,"_31224":73389,"_21643":122456,"_5":14891,"_28416":122199,"_3083":122457},[],"`equals`, para igualdad exacta;",{"_3632":73476,"_31224":73389,"_21643":122459,"_5":14891,"_28416":122199,"_3083":122460},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3632":73477,"_31224":73389,"_21643":122462,"_5":14891,"_28416":122199,"_3083":122463},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3632":73478,"_31224":73389,"_21643":122465,"_5":14891,"_28416":122199,"_3083":122466},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3632":73479,"_31224":73389,"_21643":122468,"_5":14891,"_28416":122203,"_3083":122469},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3632":73480,"_31224":73389,"_21643":122471,"_5":14891,"_28416":122203,"_3083":122472},[],"Los modos disponibles son:",{"_3632":73481,"_31224":73389,"_21643":122474,"_5":14891,"_28416":122203,"_3083":122475},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3632":73482,"_31224":73389,"_21643":122477,"_5":14891,"_28416":122203,"_3083":122478},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3632":73483,"_31224":73389,"_21643":122480,"_5":14891,"_28416":122203,"_3083":122481},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3632":73484,"_31224":73389,"_21643":122483,"_5":14891,"_28416":122203,"_3083":122484},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3632":73485,"_31224":73389,"_21643":122486,"_5":14891,"_28416":122203,"_3083":122487},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3632":73486,"_31224":73389,"_21643":122489,"_5":14891,"_28416":122203,"_3083":122490},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3632":73487,"_31224":73389,"_21643":122492,"_5":14891,"_28416":122207,"_3083":122493},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3632":73488,"_31224":73389,"_21643":122495,"_5":14891,"_28416":122207,"_3083":122496},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3632":73489,"_31224":73389,"_21643":122498,"_5":14891,"_28416":122207,"_3083":122499},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3632":73490,"_31224":73389,"_21643":122501,"_5":14891,"_28416":122207,"_3083":122502},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3632":73491,"_31224":73389,"_21643":122504,"_5":14891,"_28416":122215,"_3083":122505},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3632":73492,"_31224":73389,"_21643":122507,"_5":14891,"_28416":122215,"_3083":122508},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3632":73493,"_31224":73389,"_21643":122510,"_5":14891,"_28416":122219,"_3083":122511},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3632":73494,"_31224":73389,"_21643":122513,"_5":14891,"_28416":122219,"_3083":122514},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3632":73495,"_31224":73389,"_21643":122516,"_5":14891,"_28416":122219,"_3083":122517},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3632":73496,"_31224":73389,"_21643":122519,"_5":14891,"_28416":122219,"_3083":122520},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3632":73497,"_31224":73389,"_21643":122522,"_5":14891,"_28416":122219,"_3083":122523},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3632":73498,"_31224":73389,"_21643":122525,"_5":14891,"_28416":122223,"_3083":122526},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3632":73499,"_31224":73389,"_21643":122528,"_5":14891,"_28416":122223,"_3083":122529},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3632":73500,"_31224":73389,"_21643":122531,"_5":14891,"_28416":122223,"_3083":122532},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3632":73501,"_31224":73389,"_21643":122534,"_5":14891,"_28416":122227,"_3083":122535},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3632":73502,"_31224":73389,"_21643":122537,"_5":14891,"_28416":122227,"_3083":122538},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3632":73503,"_31224":73389,"_21643":122540,"_5":14891,"_28416":122227,"_3083":122541},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3632":73504,"_31224":73389,"_21643":122543,"_5":14891,"_28416":122227,"_3083":122544},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3632":73505,"_31224":73389,"_21643":122546,"_5":14891,"_28416":122227,"_3083":122547},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3632":73506,"_31224":73389,"_21643":122549,"_5":14891,"_28416":122227,"_3083":122550},[],"Ten en cuenta que:",{"_3632":73507,"_31224":73389,"_21643":122552,"_5":14891,"_28416":122227,"_3083":122553},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3632":73508,"_31224":73389,"_21643":122555,"_5":14891,"_28416":122227,"_3083":122556},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3632":73509,"_31224":73389,"_21643":122558,"_5":14891,"_28416":122227,"_3083":122559},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3632":73510,"_31224":73389,"_21643":122561,"_5":14891,"_28416":122231,"_3083":122562},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3632":73511,"_31224":73389,"_21643":122564,"_5":14891,"_28416":122231,"_3083":122565},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3632":73512,"_31224":73389,"_21643":122567,"_5":14891,"_28416":122231,"_3083":122568},[],"acceso completo y de solo lectura a KMS;",{"_3632":73513,"_31224":73389,"_21643":122570,"_5":14891,"_28416":122231,"_3083":122571},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3632":73514,"_31224":73389,"_21643":122573,"_5":14891,"_28416":122231,"_3083":122574},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3632":73515,"_31224":73389,"_21643":122576,"_5":14891,"_28416":122231,"_3083":122577},[],"acceso a la interfaz;",{"_3632":73516,"_31224":73389,"_21643":122579,"_5":14891,"_28416":122231,"_3083":122580},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3632":73517,"_31224":73389,"_21643":122582,"_5":14891,"_28416":122231,"_3083":122583},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3632":73518,"_31224":73389,"_21643":122585,"_5":14891,"_28416":122231,"_3083":122586},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3632":73519,"_31224":73389,"_21643":122588,"_5":14891,"_28416":122231,"_3083":122589},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3632":73520,"_31224":73389,"_21643":122591,"_5":14891,"_28416":122231,"_3083":122592},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3632":73521,"_31224":73389,"_21643":122594,"_5":14891,"_28416":122235,"_3083":122595},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3632":73522,"_31224":73389,"_21643":122597,"_5":14891,"_28416":122235,"_3083":122598},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3632":73523,"_31224":73389,"_21643":122600,"_5":14891,"_28416":122235,"_3083":122601},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3632":73524,"_31224":73389,"_21643":122603,"_5":14891,"_28416":122238,"_3083":122604},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3632":73525,"_31224":73389,"_21643":122606,"_5":14891,"_28416":122242,"_3083":122607},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3632":73526,"_31224":73389,"_21643":122609,"_5":14891,"_28416":122242,"_3083":122610},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3632":73527,"_31224":73389,"_21643":122612,"_5":14891,"_28416":122246,"_3083":122613},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3632":73528,"_31224":73389,"_21643":122615,"_5":14891,"_28416":122250,"_3083":122616},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3632":73529,"_31224":73389,"_21643":122618,"_5":14891,"_28416":122254,"_3083":122619},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3632":73530,"_31224":73389,"_21643":122621,"_5":14891,"_28416":122258,"_3083":122622},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3632":73531,"_31224":73389,"_21643":122624,"_5":14891,"_28416":122258,"_3083":122625},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3632":73532,"_31224":73389,"_21643":122627,"_5":14891,"_28416":122262,"_3083":122628},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3632":73533,"_31224":73389,"_21643":122630,"_5":14891,"_28416":122262,"_3083":122631},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3632":73534,"_31224":73389,"_21643":122633,"_5":14891,"_28416":122262,"_3083":122634},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3632":73535,"_31224":73389,"_21643":122636,"_5":14891,"_28416":122262,"_3083":122637},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3632":73536,"_31224":73389,"_21643":122639,"_5":14891,"_28416":122262,"_3083":122640},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3632":73537,"_31224":73389,"_21643":122642,"_5":14891,"_28416":122262,"_3083":122643},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3632":73538,"_31224":73389,"_21643":122645,"_5":14891,"_28416":122262,"_3083":122646},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3632":73539,"_31224":73389,"_21643":122648,"_5":14891,"_28416":122262,"_3083":122649},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3632":73540,"_31224":73389,"_21643":122651,"_5":14891,"_28416":122266,"_3083":122652},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3632":73541,"_31224":73389,"_21643":122654,"_5":14891,"_28416":122266,"_3083":122655},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3632":73542,"_31224":73389,"_21643":122657,"_5":14891,"_28416":122266,"_3083":122658},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3632":73543,"_31224":73389,"_21643":122660,"_5":14891,"_28416":122270,"_3083":122661},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3632":73544,"_31224":73389,"_21643":122663,"_5":14891,"_28416":122270,"_3083":122664},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3632":73545,"_31224":73389,"_21643":122666,"_5":14891,"_28416":122270,"_3083":122667},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3632":73546,"_31224":73389,"_21643":122669,"_5":14891,"_28416":122270,"_3083":122670},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3632":73547,"_31224":73389,"_21643":122672,"_5":14891,"_28416":122270,"_3083":122673},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3632":73548,"_31224":73389,"_21643":122675,"_5":14891,"_28416":122270,"_3083":122676},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3632":73549,"_31224":73389,"_21643":122678,"_5":14891,"_28416":122270,"_3083":122679},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3632":73550,"_31224":73389,"_21643":122681,"_5":14891,"_28416":122270,"_3083":122682},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3632":73551,"_31224":73389,"_21643":122684,"_5":14891,"_28416":122278,"_3083":122685},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3632":73552,"_31224":73389,"_21643":122687,"_5":14891,"_28416":122282,"_3083":122688},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3632":73553,"_31224":73389,"_21643":122690,"_5":14891,"_28416":122282,"_3083":122691},[],"que exista un principal activo del tipo correcto;",{"_3632":73554,"_31224":73389,"_21643":122693,"_5":14891,"_28416":122282,"_3083":122694},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3632":73555,"_31224":73389,"_21643":122696,"_5":14891,"_28416":122282,"_3083":122697},[],"que todas las condiciones del principal se cumplan;",{"_3632":73556,"_31224":73389,"_21643":122699,"_5":14891,"_28416":122282,"_3083":122700},[],"que el principal tenga concedida la política esperada;",{"_3632":73557,"_31224":73389,"_21643":122702,"_5":14891,"_28416":122282,"_3083":122703},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3632":73558,"_31224":73389,"_21643":122705,"_5":14891,"_28416":122282,"_3083":122706},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3632":73559,"_31224":73389,"_21643":122708,"_5":14891,"_28416":122282,"_3083":122709},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3632":73560,"_31224":73389,"_21643":122711,"_5":14891,"_28416":122282,"_3083":122712},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3632":73561,"_31224":73389,"_21643":122714,"_5":14891,"_28416":122286,"_3083":122715},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3632":73562,"_31224":73389,"_21643":122717,"_5":14891,"_28416":122290,"_3083":122718},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3632":73563,"_31224":73389,"_21643":122720,"_5":14891,"_28416":122294,"_3083":122721},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3632":73564,"_31224":73389,"_21643":122723,"_5":14891,"_28416":122294,"_3083":122724},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3632":73565,"_31224":73565,"_5":15251,"_3083":122726,"_31583":122727,"_21643":122728,"_28416":73565},"Alertas y suscripciones",[51036,122061,122062],[],{"_3632":73566,"_31224":73565,"_21643":122730,"_5":14891,"_28416":73565,"_3083":122731},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3632":73567,"_31224":73565,"_5":31580,"_21643":122733,"_28416":122734,"_3083":122735},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3632":73568,"_31224":73565,"_5":31580,"_21643":122737,"_28416":122738,"_3083":122739},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3632":73569,"_31224":73565,"_5":31580,"_21643":122741,"_28416":122742,"_3083":122743},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3632":73570,"_31224":73565,"_5":31580,"_21643":122745,"_28416":122746,"_3083":122747},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3632":73571,"_31224":73565,"_5":31580,"_21643":122749,"_28416":122750,"_3083":122751},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3632":73572,"_31224":73565,"_5":31580,"_21643":122753,"_28416":122754,"_3083":122755},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3632":73573,"_31224":73565,"_5":31580,"_21643":122757,"_28416":122758,"_3083":122759},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3632":73574,"_31224":73565,"_5":31580,"_21643":122761,"_28416":122762,"_3083":122763},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3632":73575,"_31224":73565,"_5":31580,"_21643":122765,"_28416":122766,"_3083":122767},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3632":73576,"_31224":73565,"_5":31580,"_21643":122769,"_28416":122770,"_3083":122771},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3632":73577,"_31224":73565,"_5":31580,"_21643":122773,"_28416":122774,"_3083":122775},[],"/docs/pr-preview/pr-82/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3632":73578,"_31224":73565,"_21643":122777,"_5":14891,"_28416":73565,"_3083":122778},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3632":73579,"_31224":73565,"_21643":122780,"_5":14891,"_28416":122734,"_3083":122781},[],"Un servicio publica un evento de dominio.",{"_3632":73580,"_31224":73565,"_21643":122783,"_5":14891,"_28416":122734,"_3083":122784},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3632":73581,"_31224":73565,"_21643":122786,"_5":14891,"_28416":122734,"_3083":122787},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3632":73582,"_31224":73565,"_21643":122789,"_5":14891,"_28416":122734,"_3083":122790},[],"Lamassu entrega el evento al canal configurado.",{"_3632":73583,"_31224":73565,"_21643":122792,"_5":14891,"_28416":122734,"_3083":122793},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3632":73584,"_31224":73565,"_21643":122795,"_5":14891,"_28416":122738,"_3083":122796},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3632":73585,"_31224":73565,"_21643":122798,"_5":14891,"_28416":122738,"_3083":122799},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3632":73586,"_31224":73565,"_21643":122801,"_5":14891,"_28416":122738,"_3083":122802},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3632":73587,"_31224":73565,"_21643":122804,"_5":14891,"_28416":122738,"_3083":122805},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3632":73588,"_31224":73565,"_21643":122807,"_5":14891,"_28416":122738,"_3083":122808},[],"`apikey_options` necesita `header` y `key`.",{"_3632":73589,"_31224":73565,"_21643":122810,"_5":14891,"_28416":122738,"_3083":122811},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3632":73590,"_31224":73565,"_21643":122813,"_5":14891,"_28416":122738,"_3083":122814},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3632":73591,"_31224":73565,"_21643":122816,"_5":14891,"_28416":122738,"_3083":122817},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3632":73592,"_31224":73565,"_21643":122819,"_5":14891,"_28416":122746,"_3083":122820},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3632":73593,"_31224":73565,"_21643":122822,"_5":14891,"_28416":122750,"_3083":122823},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3632":73594,"_31224":73565,"_21643":122825,"_5":14891,"_28416":122754,"_3083":122826},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3632":73595,"_31224":73565,"_21643":122828,"_5":14891,"_28416":122754,"_3083":122829},[],"**None** notifica todas las instancias del evento.",{"_3632":73596,"_31224":73565,"_21643":122831,"_5":14891,"_28416":122754,"_3083":122832},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3632":73597,"_31224":73565,"_21643":122834,"_5":14891,"_28416":122754,"_3083":122835},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3632":73598,"_31224":73565,"_21643":122837,"_5":14891,"_28416":122754,"_3083":122838},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3632":73599,"_31224":73565,"_21643":122840,"_5":14891,"_28416":122754,"_3083":122841},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3632":73600,"_31224":73565,"_21643":122843,"_5":14891,"_28416":122754,"_3083":122844},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3632":73601,"_31224":73565,"_21643":122846,"_5":14891,"_28416":122758,"_3083":122847},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3632":73602,"_31224":73565,"_21643":122849,"_5":14891,"_28416":122762,"_3083":122850},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3632":73603,"_31224":73565,"_21643":122852,"_5":14891,"_28416":122762,"_3083":122853},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3632":73604,"_31224":73565,"_21643":122855,"_5":14891,"_28416":122762,"_3083":122856},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3632":73605,"_31224":73565,"_21643":122858,"_5":14891,"_28416":122762,"_3083":122859},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3632":73606,"_31224":73565,"_21643":122861,"_5":14891,"_28416":122762,"_3083":122862},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3632":73607,"_31224":73565,"_21643":122864,"_5":14891,"_28416":122762,"_3083":122865},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3632":73608,"_31224":73565,"_21643":122867,"_5":14891,"_28416":122762,"_3083":122868},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3632":73609,"_31224":73565,"_21643":122870,"_5":14891,"_28416":122762,"_3083":122871},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3632":73610,"_31224":73565,"_21643":122873,"_5":14891,"_28416":122766,"_3083":122874},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3632":73611,"_31224":73565,"_21643":122876,"_5":14891,"_28416":122766,"_3083":122877},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3632":73612,"_31224":73565,"_21643":122879,"_5":14891,"_28416":122766,"_3083":122880},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3632":73613,"_31224":73565,"_21643":122882,"_5":14891,"_28416":122766,"_3083":122883},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3632":73614,"_31224":73565,"_21643":122885,"_5":14891,"_28416":122766,"_3083":122886},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3632":73615,"_31224":73565,"_21643":122888,"_5":14891,"_28416":122766,"_3083":122889},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3632":73616,"_31224":73565,"_21643":122891,"_5":14891,"_28416":122766,"_3083":122892},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3632":73617,"_31224":73565,"_21643":122894,"_5":14891,"_28416":122766,"_3083":122895},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3632":73618,"_31224":73565,"_21643":122897,"_5":14891,"_28416":122770,"_3083":122898},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3632":73619,"_31224":73565,"_21643":122900,"_5":14891,"_28416":122770,"_3083":122901},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3632":73620,"_31224":73565,"_21643":122903,"_5":14891,"_28416":122774,"_3083":122904},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3632":73621,"_31224":73565,"_21643":122906,"_5":14891,"_28416":122774,"_3083":122907},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3632":73622,"_31224":73565,"_21643":122909,"_5":14891,"_28416":122774,"_3083":122910},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3632":73623,"_31224":73565,"_21643":122912,"_5":14891,"_28416":122774,"_3083":122913},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3632":73624,"_31224":73565,"_21643":122915,"_5":14891,"_28416":122774,"_3083":122916},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3632":73625,"_31224":73565,"_21643":122918,"_5":14891,"_28416":122774,"_3083":122919},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3632":73626,"_31224":73565,"_21643":122921,"_5":14891,"_28416":122774,"_3083":122922},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3632":73627,"_31224":73565,"_21643":122924,"_5":14891,"_28416":122774,"_3083":122925},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3632":73628,"_31224":73565,"_21643":122927,"_5":14891,"_28416":122774,"_3083":122928},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3632":73629,"_31224":73565,"_21643":122930,"_5":14891,"_28416":122774,"_3083":122931},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3632":73630,"_31224":73630,"_5":15251,"_3083":122933,"_31583":122934,"_21643":122935,"_28416":73630},"Registros de auditoría",[51036,122061,122062],[],{"_3632":73631,"_31224":73630,"_21643":122937,"_5":14891,"_28416":73630,"_3083":122938},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3632":73632,"_31224":73630,"_5":31580,"_21643":122940,"_28416":122941,"_3083":122942},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3632":73633,"_31224":73630,"_5":31580,"_21643":122944,"_28416":122945,"_3083":122946},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3632":73634,"_31224":73630,"_5":31580,"_21643":122948,"_28416":122949,"_3083":122950},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3632":73635,"_31224":73630,"_5":31580,"_21643":122952,"_28416":122953,"_3083":122954},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3632":73636,"_31224":73630,"_5":31580,"_21643":122956,"_28416":122957,"_3083":122958},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3632":73637,"_31224":73630,"_5":31580,"_21643":122960,"_28416":122961,"_3083":122962},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3632":73638,"_31224":73630,"_5":31580,"_21643":122964,"_28416":122965,"_3083":122966},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3632":73639,"_31224":73630,"_5":31580,"_21643":122968,"_28416":122969,"_3083":122970},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3632":73640,"_31224":73630,"_5":31580,"_21643":122972,"_28416":122973,"_3083":122974},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3632":73641,"_31224":73630,"_5":31580,"_21643":122976,"_28416":122977,"_3083":122978},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3632":73642,"_31224":73630,"_5":31580,"_21643":122980,"_28416":122981,"_3083":122982},[],"/docs/pr-preview/pr-82/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3632":73643,"_31224":73630,"_21643":122984,"_5":14891,"_28416":73630,"_3083":122985},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3632":73644,"_31224":73630,"_21643":122987,"_5":14891,"_28416":122941,"_3083":122988},[],"El cuerpo de auditoría incluye:",{"_3632":73645,"_31224":73630,"_21643":122990,"_5":14891,"_28416":122941,"_3083":122991},[],"input: datos recibidos por la operación;",{"_3632":73646,"_31224":73630,"_21643":122993,"_5":14891,"_28416":122941,"_3083":122994},[],"has\\_error: indica si el servicio devolvió un error;",{"_3632":73647,"_31224":73630,"_21643":122996,"_5":14891,"_28416":122941,"_3083":122997},[],"output: resultado producido o mensaje de error;",{"_3632":73648,"_31224":73630,"_21643":122999,"_5":14891,"_28416":122941,"_3083":123000},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3632":73649,"_31224":73630,"_21643":123002,"_5":14891,"_28416":122941,"_3083":123003},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3632":73650,"_31224":73630,"_21643":123005,"_5":14891,"_28416":122941,"_3083":123006},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3632":73651,"_31224":73630,"_21643":123008,"_5":14891,"_28416":122945,"_3083":123009},[],"El backend aplica auditoría a mutaciones de:",{"_3632":73652,"_31224":73630,"_21643":123011,"_5":14891,"_28416":122945,"_3083":123012},[],"autoridades, certificados y perfiles de emisión;",{"_3632":73653,"_31224":73630,"_21643":123014,"_5":14891,"_28416":122945,"_3083":123015},[],"claves y motores KMS;",{"_3632":73654,"_31224":73630,"_21643":123017,"_5":14891,"_28416":122945,"_3083":123018},[],"dispositivos e identidades;",{"_3632":73655,"_31224":73630,"_21643":123020,"_5":14891,"_28416":122945,"_3083":123021},[],"DMS y operaciones de enrolamiento;",{"_3632":73656,"_31224":73630,"_21643":123023,"_5":14891,"_28416":122945,"_3083":123024},[],"funciones de validación y CRL;",{"_3632":73657,"_31224":73630,"_21643":123026,"_5":14891,"_28416":122945,"_3083":123027},[],"principales, políticas y concesiones de autorización.",{"_3632":73658,"_31224":73630,"_21643":123029,"_5":14891,"_28416":122945,"_3083":123030},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3632":73659,"_31224":73630,"_21643":123032,"_5":14891,"_28416":122949,"_3083":123033},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3632":73660,"_31224":73630,"_21643":123035,"_5":14891,"_28416":122949,"_3083":123036},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3632":73661,"_31224":73630,"_21643":123038,"_5":14891,"_28416":122949,"_3083":123039},[],"Diseña el consumidor para:",{"_3632":73662,"_31224":73630,"_21643":123041,"_5":14891,"_28416":122949,"_3083":123042},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3632":73663,"_31224":73630,"_21643":123044,"_5":14891,"_28416":122949,"_3083":123045},[],"conservar el CloudEvent completo sin modificar;",{"_3632":73664,"_31224":73630,"_21643":123047,"_5":14891,"_28416":122949,"_3083":123048},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3632":73665,"_31224":73630,"_21643":123050,"_5":14891,"_28416":122949,"_3083":123051},[],"cifrar en tránsito y en reposo;",{"_3632":73666,"_31224":73630,"_21643":123053,"_5":14891,"_28416":122949,"_3083":123054},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3632":73667,"_31224":73630,"_21643":123056,"_5":14891,"_28416":122949,"_3083":123057},[],"aplicar una política explícita de retención y legal hold;",{"_3632":73668,"_31224":73630,"_21643":123059,"_5":14891,"_28416":122949,"_3083":123060},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3632":73669,"_31224":73630,"_21643":123062,"_5":14891,"_28416":122953,"_3083":123063},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3632":73670,"_31224":73630,"_21643":123065,"_5":14891,"_28416":122953,"_3083":123066},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3632":73671,"_31224":73630,"_21643":123068,"_5":14891,"_28416":122961,"_3083":123069},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3632":73672,"_31224":73630,"_21643":123071,"_5":14891,"_28416":122965,"_3083":123072},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3632":73673,"_31224":73630,"_21643":123074,"_5":14891,"_28416":122969,"_3083":123075},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3632":73674,"_31224":73630,"_21643":123077,"_5":14891,"_28416":122973,"_3083":123078},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3632":73675,"_31224":73630,"_21643":123080,"_5":14891,"_28416":122977,"_3083":123081},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3632":73676,"_31224":73630,"_21643":123083,"_5":14891,"_28416":122981,"_3083":123084},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3632":73677,"_31224":73630,"_21643":123086,"_5":14891,"_28416":122981,"_3083":123087},[],"aparece un evento de auditoría correcto;",{"_3632":73678,"_31224":73630,"_21643":123089,"_5":14891,"_28416":122981,"_3083":123090},[],"el principal coincide con la identidad utilizada;",{"_3632":73679,"_31224":73630,"_21643":123092,"_5":14891,"_28416":122981,"_3083":123093},[],"el consumidor lo persiste una sola vez;",{"_3632":73680,"_31224":73630,"_21643":123095,"_5":14891,"_28416":122981,"_3083":123096},[],"puede recuperarse por recurso, actor y periodo;",{"_3632":73681,"_31224":73630,"_21643":123098,"_5":14891,"_28416":122981,"_3083":123099},[],"una interrupción del consumidor produce una alerta.",{"_3632":73682,"_31224":73630,"_21643":123101,"_5":14891,"_28416":122981,"_3083":123102},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3632":73683,"_31224":73683,"_5":15251,"_3083":123104,"_31583":123105,"_21643":123106,"_28416":73683},"Arquitectura de la plataforma",[51036,122061],[],{"_3632":73684,"_31224":73683,"_21643":123108,"_5":14891,"_28416":73683,"_3083":123109},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3632":73685,"_31224":73683,"_5":31580,"_21643":123111,"_28416":123112,"_3083":123113},[],"/docs/pr-preview/pr-82/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3632":73686,"_31224":73683,"_5":31580,"_21643":123115,"_28416":123116,"_3083":123117},[],"/docs/pr-preview/pr-82/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3632":73687,"_31224":73683,"_5":31580,"_21643":123119,"_28416":123120,"_3083":123121},[],"/docs/pr-preview/pr-82/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3632":73688,"_31224":73683,"_5":31580,"_21643":123123,"_28416":123124,"_3083":123125},[],"/docs/pr-preview/pr-82/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3632":73689,"_31224":73683,"_5":31580,"_21643":123127,"_28416":123128,"_3083":123129},[],"/docs/pr-preview/pr-82/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3632":73690,"_31224":73683,"_21643":123131,"_5":14891,"_28416":73683,"_3083":123132},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3632":73691,"_31224":73683,"_21643":123134,"_5":14891,"_28416":73683,"_3083":123135},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3632":73692,"_31224":73683,"_21643":123137,"_5":14891,"_28416":123112,"_3083":123138},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3632":73693,"_31224":73683,"_21643":123140,"_5":14891,"_28416":123116,"_3083":123141},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3632":73694,"_31224":73683,"_21643":123143,"_5":14891,"_28416":123120,"_3083":123144},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3632":73695,"_31224":73683,"_21643":123146,"_5":14891,"_28416":123124,"_3083":123147},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3632":73696,"_31224":73683,"_21643":123149,"_5":14891,"_28416":123128,"_3083":123150},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3632":73697,"_31224":73697,"_5":15251,"_3083":123152,"_31583":123153,"_21643":123154,"_28416":73697},"Cómo funciona Lamassu",[51036,122061],[],{"_3632":73698,"_31224":73697,"_21643":123156,"_5":14891,"_28416":73697,"_3083":123157},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3632":73699,"_31224":73697,"_5":31580,"_21643":123159,"_28416":123160,"_3083":123161},[],"/docs/pr-preview/pr-82/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3632":73700,"_31224":73697,"_5":31580,"_21643":123163,"_28416":123164,"_3083":123165},[],"/docs/pr-preview/pr-82/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3632":73701,"_31224":73697,"_21643":123167,"_5":14891,"_28416":73697,"_3083":123168},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3632":73702,"_31224":73697,"_21643":123170,"_5":14891,"_28416":123160,"_3083":123171},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3632":73703,"_31224":73697,"_21643":123173,"_5":14891,"_28416":123160,"_3083":123174},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3632":73704,"_31224":73697,"_21643":123176,"_5":14891,"_28416":123160,"_3083":123177},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3632":73705,"_31224":73697,"_21643":123179,"_5":14891,"_28416":123160,"_3083":123180},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3632":73706,"_31224":73697,"_21643":123182,"_5":14891,"_28416":123160,"_3083":123183},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3632":73707,"_31224":73697,"_21643":123185,"_5":14891,"_28416":123164,"_3083":123186},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3632":73708,"_31224":73697,"_21643":123188,"_5":14891,"_28416":123164,"_3083":123189},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3632":73709,"_31224":73697,"_21643":123191,"_5":14891,"_28416":123164,"_3083":123192},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3632":73710,"_31224":73697,"_21643":123194,"_5":14891,"_28416":123164,"_3083":123195},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3632":73711,"_31224":73697,"_21643":123197,"_5":14891,"_28416":123164,"_3083":123198},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3632":73712,"_31224":73697,"_21643":123200,"_5":14891,"_28416":123164,"_3083":123201},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3632":73713,"_31224":73697,"_21643":123203,"_5":14891,"_28416":123164,"_3083":123204},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3632":73714,"_31224":73714,"_5":15251,"_3083":123206,"_31583":123207,"_21643":123208,"_28416":73714},"Dispositivos e identidades",[51036,122061,53720,123206],[],{"_3632":73715,"_31224":73714,"_21643":123210,"_5":14891,"_28416":73714,"_3083":123211},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3632":73716,"_31224":73714,"_5":31580,"_21643":123213,"_28416":123214,"_3083":123215},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3632":73717,"_31224":73714,"_5":31580,"_21643":123217,"_28416":123218,"_3083":123219},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3632":73718,"_31224":73714,"_5":31580,"_21643":123221,"_28416":123222,"_3083":123223},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3632":73719,"_31224":73714,"_5":31580,"_21643":123225,"_28416":123226,"_3083":123227},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3632":73720,"_31224":73714,"_5":31580,"_21643":123229,"_28416":123230,"_3083":123231},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3632":73721,"_31224":73714,"_5":31580,"_21643":123233,"_28416":123234,"_3083":123235},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3632":73722,"_31224":73714,"_5":31580,"_21643":123237,"_28416":123238,"_3083":123239},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3632":73723,"_31224":73714,"_5":31580,"_21643":123241,"_28416":123242,"_3083":123243},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3632":73724,"_31224":73714,"_5":31580,"_21643":123245,"_28416":123246,"_3083":123247},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3632":73725,"_31224":73714,"_5":31580,"_21643":123249,"_28416":123250,"_3083":123251},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3632":73726,"_31224":73714,"_5":31580,"_21643":123253,"_28416":123254,"_3083":123255},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3632":73727,"_31224":73714,"_21643":123257,"_5":14891,"_28416":73714,"_3083":123258},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3632":73728,"_31224":73714,"_21643":123260,"_5":14891,"_28416":73714,"_3083":123261},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3632":73729,"_31224":73714,"_21643":123263,"_5":14891,"_28416":123214,"_3083":123264},[],"Vista operativa",{"_3632":73730,"_31224":73714,"_21643":123266,"_5":14891,"_28416":123214,"_3083":123267},[],"Interpretación",{"_3632":73731,"_31224":73714,"_21643":123269,"_5":14891,"_28416":123214,"_3083":53783},[],{"_3632":73732,"_31224":73714,"_21643":123271,"_5":14891,"_28416":123214,"_3083":123272},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3632":73733,"_31224":73714,"_21643":123274,"_5":14891,"_28416":123214,"_3083":53789},[],{"_3632":73734,"_31224":73714,"_21643":123276,"_5":14891,"_28416":123214,"_3083":123277},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3632":73735,"_31224":73714,"_21643":123279,"_5":14891,"_28416":123214,"_3083":53795},[],{"_3632":73736,"_31224":73714,"_21643":123281,"_5":14891,"_28416":123214,"_3083":123282},[],"La identidad está en la ventana operativa de renovación.",{"_3632":73737,"_31224":73714,"_21643":123284,"_5":14891,"_28416":123214,"_3083":53801},[],{"_3632":73738,"_31224":73714,"_21643":123286,"_5":14891,"_28416":123214,"_3083":123287},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3632":73739,"_31224":73714,"_21643":123289,"_5":14891,"_28416":123214,"_3083":53807},[],{"_3632":73740,"_31224":73714,"_21643":123291,"_5":14891,"_28416":123214,"_3083":123292},[],"La identidad ha vencido.",{"_3632":73741,"_31224":73714,"_21643":123294,"_5":14891,"_28416":123214,"_3083":53813},[],{"_3632":73742,"_31224":73714,"_21643":123296,"_5":14891,"_28416":123214,"_3083":123297},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3632":73743,"_31224":73714,"_21643":123299,"_5":14891,"_28416":123214,"_3083":53819},[],{"_3632":73744,"_31224":73714,"_21643":123301,"_5":14891,"_28416":123214,"_3083":123302},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3632":73745,"_31224":73714,"_21643":123304,"_5":14891,"_28416":123214,"_3083":123305},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3632":73746,"_31224":73714,"_21643":123307,"_5":14891,"_28416":123218,"_3083":123308},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3632":73747,"_31224":73714,"_21643":123310,"_5":14891,"_28416":123218,"_3083":123311},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3632":73748,"_31224":73714,"_21643":123313,"_5":14891,"_28416":123218,"_3083":123314},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. En el modo **Live**, sigue automáticamente los eventos nuevos y los cambios del dispositivo (como el estado o el propietario) sin recargar la página, y muestra un indicador **Connected** o **Disconnected**. Tras una interrupción se reconecta y recupera sin huecos ni duplicados, de modo que **Live** muestra el mismo contenido que una recarga de la página. Cuando las actualizaciones en vivo no pueden usarse — falta de permisos, dispositivo no encontrado o actualizaciones en vivo no habilitadas en el servidor —, la línea de tiempo muestra `Live updates unavailable: ...` con el motivo, y la navegación por el historial (**Load more**) sigue funcionando. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3632":73749,"_31224":73714,"_21643":123316,"_5":14891,"_28416":123218,"_3083":123317},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3632":73750,"_31224":73714,"_21643":123319,"_5":14891,"_28416":123222,"_3083":123320},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3632":73751,"_31224":73714,"_21643":123322,"_5":14891,"_28416":123226,"_3083":123323},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3632":73752,"_31224":73714,"_21643":123325,"_5":14891,"_28416":123230,"_3083":123326},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3632":73753,"_31224":73714,"_21643":123328,"_5":14891,"_28416":123234,"_3083":123329},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3632":73754,"_31224":73714,"_21643":123331,"_5":14891,"_28416":123238,"_3083":123332},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3632":73755,"_31224":73714,"_21643":123334,"_5":14891,"_28416":123238,"_3083":123335},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3632":73756,"_31224":73714,"_21643":123337,"_5":14891,"_28416":123242,"_3083":123338},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3632":73757,"_31224":73714,"_21643":123340,"_5":14891,"_28416":123242,"_3083":123341},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3632":73758,"_31224":73714,"_21643":123343,"_5":14891,"_28416":123242,"_3083":123344},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3632":73759,"_31224":73714,"_21643":123346,"_5":14891,"_28416":123242,"_3083":123347},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3632":73760,"_31224":73714,"_21643":123349,"_5":14891,"_28416":123242,"_3083":123350},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3632":73761,"_31224":73714,"_21643":123352,"_5":14891,"_28416":123242,"_3083":123353},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3632":73762,"_31224":73714,"_21643":123355,"_5":14891,"_28416":123246,"_3083":123356},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3632":73763,"_31224":73714,"_21643":123358,"_5":14891,"_28416":123246,"_3083":123359},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3632":73764,"_31224":73714,"_21643":123361,"_5":14891,"_28416":123246,"_3083":123362},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3632":73765,"_31224":73714,"_21643":123364,"_5":14891,"_28416":123250,"_3083":123365},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3632":73766,"_31224":73714,"_21643":123367,"_5":14891,"_28416":123250,"_3083":123368},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3632":73767,"_31224":73714,"_21643":123370,"_5":14891,"_28416":123250,"_3083":123371},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3632":73768,"_31224":73714,"_21643":123373,"_5":14891,"_28416":123250,"_3083":123374},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3632":73769,"_31224":73714,"_21643":123376,"_5":14891,"_28416":123254,"_3083":123377},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":73770,"_31224":73714,"_21643":123379,"_5":14891,"_28416":123254,"_3083":123380},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":73771,"_31224":73771,"_5":15251,"_3083":123382,"_31583":123383,"_21643":123385,"_28416":73771},"Identidad inicial y autenticación",[51036,122061,53720,123206,123384],"Enrolamiento con PKI",[],{"_3632":73772,"_31224":73771,"_21643":123387,"_5":14891,"_28416":73771,"_3083":123388},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3632":73773,"_31224":73771,"_5":31580,"_21643":123390,"_28416":123391,"_3083":123392},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3632":73774,"_31224":73771,"_5":31580,"_21643":123394,"_28416":123395,"_3083":123396},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3632":73775,"_31224":73771,"_5":31580,"_21643":123398,"_28416":123399,"_3083":123400},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3632":73776,"_31224":73771,"_5":31580,"_21643":123402,"_28416":123403,"_3083":123404},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3632":73777,"_31224":73771,"_5":31580,"_21643":123406,"_28416":123407,"_3083":123408},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3632":73778,"_31224":73771,"_21643":123410,"_5":14891,"_28416":73771,"_3083":123411},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3632":73779,"_31224":73771,"_21643":123413,"_5":14891,"_28416":123391,"_3083":123414},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3632":73780,"_31224":73771,"_21643":123416,"_5":14891,"_28416":123391,"_3083":123417},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3632":73781,"_31224":73771,"_21643":123419,"_5":14891,"_28416":123395,"_3083":123420},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3632":73782,"_31224":73771,"_21643":123422,"_5":14891,"_28416":123395,"_3083":123423},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3632":73783,"_31224":73771,"_21643":123425,"_5":14891,"_28416":123395,"_3083":123426},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3632":73784,"_31224":73771,"_21643":123428,"_5":14891,"_28416":123399,"_3083":123429},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3632":73785,"_31224":73771,"_21643":123431,"_5":14891,"_28416":123399,"_3083":123432},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3632":73786,"_31224":73771,"_21643":123434,"_5":14891,"_28416":123403,"_3083":123435},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3632":73787,"_31224":73771,"_21643":123437,"_5":14891,"_28416":123403,"_3083":123438},[],"Ejemplo de cuerpo:",{"_3632":73788,"_31224":73771,"_21643":123440,"_5":14891,"_28416":123403,"_3083":123441},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3632":73789,"_31224":73771,"_21643":123443,"_5":14891,"_28416":123403,"_3083":123444},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3632":73790,"_31224":73771,"_21643":123446,"_5":14891,"_28416":123403,"_3083":123447},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3632":73791,"_31224":73771,"_21643":123449,"_5":14891,"_28416":123403,"_3083":123450},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3632":73792,"_31224":73771,"_21643":123452,"_5":14891,"_28416":123407,"_3083":123453},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3632":73793,"_31224":73771,"_21643":123455,"_5":14891,"_28416":123407,"_3083":123456},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3632":73794,"_31224":73771,"_21643":123458,"_5":14891,"_28416":123407,"_3083":123459},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3632":73795,"_31224":73771,"_21643":123461,"_5":14891,"_28416":123407,"_3083":123462},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3632":73796,"_31224":73796,"_5":15251,"_3083":123464,"_31583":123465,"_21643":123466,"_28416":73796},"Configura y opera el DMS",[51036,122061,53720,123206,123384],[],{"_3632":73797,"_31224":73796,"_21643":123468,"_5":14891,"_28416":73796,"_3083":123469},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3632":73798,"_31224":73796,"_5":31580,"_21643":123471,"_28416":123472,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3632":73799,"_31224":73796,"_5":31580,"_21643":123474,"_28416":123475,"_3083":123476},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3632":73800,"_31224":73796,"_5":31580,"_21643":123478,"_28416":123479,"_3083":123480},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3632":73801,"_31224":73796,"_5":31580,"_21643":123482,"_28416":123483,"_3083":123484},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3632":73802,"_31224":73796,"_5":31580,"_21643":123486,"_28416":123487,"_3083":123488},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3632":73803,"_31224":73796,"_5":31580,"_21643":123490,"_28416":123491,"_3083":123492},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3632":73804,"_31224":73796,"_5":31580,"_21643":123494,"_28416":123495,"_3083":123496},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3632":73805,"_31224":73796,"_5":31580,"_21643":123498,"_28416":123499,"_3083":123500},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3632":73806,"_31224":73796,"_5":31580,"_21643":123502,"_28416":123503,"_3083":54024},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3632":73807,"_31224":73796,"_5":31580,"_21643":123505,"_28416":123506,"_3083":54028},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3632":73808,"_31224":73796,"_5":31580,"_21643":123508,"_28416":123509,"_3083":123510},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3632":73809,"_31224":73796,"_5":31580,"_21643":123512,"_28416":123513,"_3083":123514},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3632":73810,"_31224":73796,"_5":31580,"_21643":123516,"_28416":123517,"_3083":123518},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3632":73811,"_31224":73796,"_5":31580,"_21643":123520,"_28416":123521,"_3083":123522},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3632":73812,"_31224":73796,"_5":31580,"_21643":123524,"_28416":123525,"_3083":54048},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3632":73813,"_31224":73796,"_5":31580,"_21643":123527,"_28416":123528,"_3083":123529},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3632":73814,"_31224":73796,"_5":31580,"_21643":123531,"_28416":123532,"_3083":123533},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3632":73815,"_31224":73796,"_5":31580,"_21643":123535,"_28416":123536,"_3083":123537},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3632":73816,"_31224":73796,"_21643":123539,"_5":14891,"_28416":73796,"_3083":123540},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3632":73817,"_31224":73796,"_21643":123542,"_5":14891,"_28416":123472,"_3083":123543},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3632":73818,"_31224":73796,"_21643":123545,"_5":14891,"_28416":123472,"_3083":123546},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3632":73819,"_31224":73796,"_21643":123548,"_5":14891,"_28416":123479,"_3083":123549},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3632":73820,"_31224":73796,"_21643":123551,"_5":14891,"_28416":123483,"_3083":123552},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3632":73821,"_31224":73796,"_21643":123554,"_5":14891,"_28416":123487,"_3083":123555},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3632":73822,"_31224":73796,"_21643":123557,"_5":14891,"_28416":123491,"_3083":123558},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3632":73823,"_31224":73796,"_21643":123560,"_5":14891,"_28416":123495,"_3083":123561},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3632":73824,"_31224":73796,"_21643":123563,"_5":14891,"_28416":123503,"_3083":123564},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3632":73825,"_31224":73796,"_21643":123566,"_5":14891,"_28416":123503,"_3083":123567},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3632":73826,"_31224":73796,"_21643":123569,"_5":14891,"_28416":123506,"_3083":123570},[],"Campo de `settings.enrollment_settings`",{"_3632":73827,"_31224":73796,"_21643":123572,"_5":14891,"_28416":123506,"_3083":123573},[],"Decisión",{"_3632":73828,"_31224":73796,"_21643":123575,"_5":14891,"_28416":123506,"_3083":54099},[],{"_3632":73829,"_31224":73796,"_21643":123577,"_5":14891,"_28416":123506,"_3083":123578},[],"`EST_RFC7030` para estas operaciones.",{"_3632":73830,"_31224":73796,"_21643":123580,"_5":14891,"_28416":123506,"_3083":54105},[],{"_3632":73831,"_31224":73796,"_21643":123582,"_5":14891,"_28416":123506,"_3083":123583},[],"ID de la CA que firmará.",{"_3632":73832,"_31224":73796,"_21643":123585,"_5":14891,"_28416":123506,"_3083":54111},[],{"_3632":73833,"_31224":73796,"_21643":123587,"_5":14891,"_28416":123506,"_3083":123588},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3632":73834,"_31224":73796,"_21643":123590,"_5":14891,"_28416":123506,"_3083":54117},[],{"_3632":73835,"_31224":73796,"_21643":123592,"_5":14891,"_28416":123506,"_3083":123593},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3632":73836,"_31224":73796,"_21643":123595,"_5":14891,"_28416":123506,"_3083":54123},[],{"_3632":73837,"_31224":73796,"_21643":123597,"_5":14891,"_28416":123506,"_3083":123598},[],"Uno de los cuatro modos de autenticación.",{"_3632":73838,"_31224":73796,"_21643":123600,"_5":14891,"_28416":123506,"_3083":123601},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3632":73839,"_31224":73796,"_21643":123603,"_5":14891,"_28416":123509,"_3083":123604},[],"Los bloques son independientes:",{"_3632":73840,"_31224":73796,"_21643":123606,"_5":14891,"_28416":123509,"_3083":123607},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3632":73841,"_31224":73796,"_21643":123609,"_5":14891,"_28416":123509,"_3083":123610},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3632":73842,"_31224":73796,"_21643":123612,"_5":14891,"_28416":123509,"_3083":54141},[],{"_3632":73843,"_31224":73796,"_21643":123614,"_5":14891,"_28416":123509,"_3083":123615},[],"Control aplicado en la operación configurada",{"_3632":73844,"_31224":73796,"_21643":123617,"_5":14891,"_28416":123509,"_3083":54147},[],{"_3632":73845,"_31224":73796,"_21643":123619,"_5":14891,"_28416":123509,"_3083":123620},[],"Validación del certificado presentado.",{"_3632":73846,"_31224":73796,"_21643":123622,"_5":14891,"_28416":123509,"_3083":54153},[],{"_3632":73847,"_31224":73796,"_21643":123624,"_5":14891,"_28416":123509,"_3083":123625},[],"Autorización del webhook configurado.",{"_3632":73848,"_31224":73796,"_21643":123627,"_5":14891,"_28416":123509,"_3083":54159},[],{"_3632":73849,"_31224":73796,"_21643":123629,"_5":14891,"_28416":123509,"_3083":123630},[],"Validación del certificado y, después, aprobación del webhook.",{"_3632":73850,"_31224":73796,"_21643":123632,"_5":14891,"_28416":123509,"_3083":54165},[],{"_3632":73851,"_31224":73796,"_21643":123634,"_5":14891,"_28416":123509,"_3083":123635},[],"Sin autenticación del solicitante por el DMS.",{"_3632":73852,"_31224":73796,"_21643":123637,"_5":14891,"_28416":123509,"_3083":123638},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3632":73853,"_31224":73796,"_21643":123640,"_5":14891,"_28416":123509,"_3083":123641},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3632":73854,"_31224":73796,"_21643":123643,"_5":14891,"_28416":123509,"_3083":123644},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3632":73855,"_31224":73796,"_21643":123646,"_5":14891,"_28416":123509,"_3083":123647},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3632":73856,"_31224":73796,"_21643":123649,"_5":14891,"_28416":123509,"_3083":123650},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3632":73857,"_31224":73796,"_21643":123652,"_5":14891,"_28416":123513,"_3083":123653},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3632":73858,"_31224":73796,"_21643":123655,"_5":14891,"_28416":123513,"_3083":123656},[],"Campo de `external_webhook_settings`",{"_3632":73859,"_31224":73796,"_21643":123658,"_5":14891,"_28416":123513,"_3083":123573},[],{"_3632":73860,"_31224":73796,"_21643":123660,"_5":14891,"_28416":123513,"_3083":54194},[],{"_3632":73861,"_31224":73796,"_21643":123662,"_5":14891,"_28416":123513,"_3083":123663},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3632":73862,"_31224":73796,"_21643":123665,"_5":14891,"_28416":123513,"_3083":54200},[],{"_3632":73863,"_31224":73796,"_21643":123667,"_5":14891,"_28416":123513,"_3083":123668},[],"`POST` o `PUT`; `POST` por defecto.",{"_3632":73864,"_31224":73796,"_21643":123670,"_5":14891,"_28416":123513,"_3083":54206},[],{"_3632":73865,"_31224":73796,"_21643":123672,"_5":14891,"_28416":123513,"_3083":123673},[],"Etiqueta usada en los logs del servicio.",{"_3632":73866,"_31224":73796,"_21643":123675,"_5":14891,"_28416":123513,"_3083":54212},[],{"_3632":73867,"_31224":73796,"_21643":123677,"_5":14891,"_28416":123513,"_3083":123678},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3632":73868,"_31224":73796,"_21643":123680,"_5":14891,"_28416":123513,"_3083":54218},[],{"_3632":73869,"_31224":73796,"_21643":123682,"_5":14891,"_28416":123513,"_3083":123683},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3632":73870,"_31224":73796,"_21643":123685,"_5":14891,"_28416":123513,"_3083":54224},[],{"_3632":73871,"_31224":73796,"_21643":123687,"_5":14891,"_28416":123513,"_3083":123688},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3632":73872,"_31224":73796,"_21643":123690,"_5":14891,"_28416":123513,"_3083":54230},[],{"_3632":73873,"_31224":73796,"_21643":123692,"_5":14891,"_28416":123513,"_3083":123693},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3632":73874,"_31224":73796,"_21643":123695,"_5":14891,"_28416":123513,"_3083":54236},[],{"_3632":73875,"_31224":73796,"_21643":123697,"_5":14891,"_28416":123513,"_3083":123698},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3632":73876,"_31224":73796,"_21643":123700,"_5":14891,"_28416":123513,"_3083":54242},[],{"_3632":73877,"_31224":73796,"_21643":123702,"_5":14891,"_28416":123513,"_3083":123703},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3632":73878,"_31224":73796,"_21643":123705,"_5":14891,"_28416":123513,"_3083":54248},[],{"_3632":73879,"_31224":73796,"_21643":123707,"_5":14891,"_28416":123513,"_3083":123708},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3632":73880,"_31224":73796,"_21643":123710,"_5":14891,"_28416":123513,"_3083":123711},[],"Reglas de esa configuración:",{"_3632":73881,"_31224":73796,"_21643":123713,"_5":14891,"_28416":123513,"_3083":123714},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3632":73882,"_31224":73796,"_21643":123716,"_5":14891,"_28416":123513,"_3083":123717},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3632":73883,"_31224":73796,"_21643":123719,"_5":14891,"_28416":123513,"_3083":123720},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3632":73884,"_31224":73796,"_21643":123722,"_5":14891,"_28416":123513,"_3083":123723},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3632":73885,"_31224":73796,"_21643":123725,"_5":14891,"_28416":123513,"_3083":123726},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3632":73886,"_31224":73796,"_21643":123728,"_5":14891,"_28416":123513,"_3083":123729},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3632":73887,"_31224":73796,"_21643":123731,"_5":14891,"_28416":123513,"_3083":123732},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3632":73888,"_31224":73796,"_21643":123734,"_5":14891,"_28416":123513,"_3083":123735},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3632":73889,"_31224":73796,"_21643":123737,"_5":14891,"_28416":123513,"_3083":123738},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3632":73890,"_31224":73796,"_21643":123740,"_5":14891,"_28416":123517,"_3083":123741},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3632":73891,"_31224":73796,"_21643":123743,"_5":14891,"_28416":123521,"_3083":123744},[],"Campo de `settings.reenrollment_settings`",{"_3632":73892,"_31224":73796,"_21643":123746,"_5":14891,"_28416":123521,"_3083":123747},[],"Función",{"_3632":73893,"_31224":73796,"_21643":123749,"_5":14891,"_28416":123521,"_3083":54292},[],{"_3632":73894,"_31224":73796,"_21643":123751,"_5":14891,"_28416":123521,"_3083":123752},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3632":73895,"_31224":73796,"_21643":123754,"_5":14891,"_28416":123521,"_3083":54298},[],{"_3632":73896,"_31224":73796,"_21643":123756,"_5":14891,"_28416":123521,"_3083":123757},[],"Umbral operativo preventivo de monitorización.",{"_3632":73897,"_31224":73796,"_21643":123759,"_5":14891,"_28416":123521,"_3083":54304},[],{"_3632":73898,"_31224":73796,"_21643":123761,"_5":14891,"_28416":123521,"_3083":123762},[],"Umbral operativo crítico de monitorización.",{"_3632":73899,"_31224":73796,"_21643":123764,"_5":14891,"_28416":123521,"_3083":54310},[],{"_3632":73900,"_31224":73796,"_21643":123766,"_5":14891,"_28416":123521,"_3083":123767},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3632":73901,"_31224":73796,"_21643":123769,"_5":14891,"_28416":123521,"_3083":54316},[],{"_3632":73902,"_31224":73796,"_21643":123771,"_5":14891,"_28416":123521,"_3083":123772},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3632":73903,"_31224":73796,"_21643":123774,"_5":14891,"_28416":123521,"_3083":54322},[],{"_3632":73904,"_31224":73796,"_21643":123776,"_5":14891,"_28416":123521,"_3083":123777},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3632":73905,"_31224":73796,"_21643":123779,"_5":14891,"_28416":123521,"_3083":123780},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3632":73906,"_31224":73796,"_21643":123782,"_5":14891,"_28416":123525,"_3083":123783},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3632":73907,"_31224":73796,"_21643":123785,"_5":14891,"_28416":123528,"_3083":120959},[],{"_3632":73908,"_31224":73796,"_21643":123787,"_5":14891,"_28416":123528,"_3083":123788},[],"Qué publica",{"_3632":73909,"_31224":73796,"_21643":123790,"_5":14891,"_28416":123528,"_3083":54339},[],{"_3632":73910,"_31224":73796,"_21643":123792,"_5":14891,"_28416":123528,"_3083":123793},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3632":73911,"_31224":73796,"_21643":123795,"_5":14891,"_28416":123528,"_3083":54345},[],{"_3632":73912,"_31224":73796,"_21643":123797,"_5":14891,"_28416":123528,"_3083":123798},[],"Certificado de la CA emisora seleccionada.",{"_3632":73913,"_31224":73796,"_21643":123800,"_5":14891,"_28416":123528,"_3083":54351},[],{"_3632":73914,"_31224":73796,"_21643":123802,"_5":14891,"_28416":123528,"_3083":123803},[],"Certificados de las CAs elegidas explícitamente.",{"_3632":73915,"_31224":73796,"_21643":123805,"_5":14891,"_28416":123528,"_3083":123806},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3632":73916,"_31224":73796,"_21643":123808,"_5":14891,"_28416":123532,"_3083":123809},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3632":73917,"_31224":73796,"_21643":123811,"_5":14891,"_28416":123532,"_3083":123812},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3632":73918,"_31224":73796,"_21643":123814,"_5":14891,"_28416":123532,"_3083":123815},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3632":73919,"_31224":73796,"_21643":123817,"_5":14891,"_28416":123536,"_3083":123818},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3632":73920,"_31224":73920,"_5":15251,"_3083":123820,"_31583":123821,"_21643":123822,"_28416":73920},"Integra el cliente EST",[51036,122061,53720,123206,123384],[],{"_3632":73921,"_31224":73920,"_21643":123824,"_5":14891,"_28416":73920,"_3083":123825},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3632":73922,"_31224":73920,"_5":31580,"_21643":123827,"_28416":123828,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3632":73923,"_31224":73920,"_5":31580,"_21643":123830,"_28416":123831,"_3083":123832},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3632":73924,"_31224":73920,"_5":31580,"_21643":123834,"_28416":123835,"_3083":123836},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3632":73925,"_31224":73920,"_5":31580,"_21643":123838,"_28416":123839,"_3083":123840},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3632":73926,"_31224":73920,"_5":31580,"_21643":123842,"_28416":123843,"_3083":123844},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3632":73927,"_31224":73920,"_5":31580,"_21643":123846,"_28416":123847,"_3083":123848},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3632":73928,"_31224":73920,"_21643":123850,"_5":14891,"_28416":73920,"_3083":123851},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3632":73929,"_31224":73920,"_21643":123853,"_5":14891,"_28416":123828,"_3083":123854},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3632":73930,"_31224":73920,"_21643":123856,"_5":14891,"_28416":123828,"_3083":123857},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3632":73931,"_31224":73920,"_21643":123859,"_5":14891,"_28416":123828,"_3083":123860},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3632":73932,"_31224":73920,"_21643":123862,"_5":14891,"_28416":123831,"_3083":123863},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3632":73933,"_31224":73920,"_21643":123865,"_5":14891,"_28416":123831,"_3083":123866},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3632":73934,"_31224":73920,"_21643":123868,"_5":14891,"_28416":123835,"_3083":123869},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3632":73935,"_31224":73920,"_21643":123871,"_5":14891,"_28416":123835,"_3083":123872},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3632":73936,"_31224":73920,"_21643":123874,"_5":14891,"_28416":123839,"_3083":123875},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3632":73937,"_31224":73920,"_21643":123877,"_5":14891,"_28416":123839,"_3083":123878},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3632":73938,"_31224":73920,"_21643":123880,"_5":14891,"_28416":123843,"_3083":123881},[],"Para el caso de una raíz que emite directamente:",{"_3632":73939,"_31224":73920,"_21643":123883,"_5":14891,"_28416":123843,"_3083":123884},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3632":73940,"_31224":73920,"_21643":123886,"_5":14891,"_28416":123843,"_3083":123887},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3632":73941,"_31224":73920,"_21643":123889,"_5":14891,"_28416":123847,"_3083":123890},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3632":73942,"_31224":73942,"_5":15251,"_3083":123892,"_31583":123893,"_21643":123894,"_28416":73942},"Referencia EST",[51036,122061,53720,123206,123384],[],{"_3632":73943,"_31224":73942,"_21643":123896,"_5":14891,"_28416":73942,"_3083":123897},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3632":73944,"_31224":73942,"_5":31580,"_21643":123899,"_28416":123900,"_3083":123901},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3632":73945,"_31224":73942,"_5":31580,"_21643":123903,"_28416":123904,"_3083":23446},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3632":73946,"_31224":73942,"_5":31580,"_21643":123906,"_28416":123907,"_3083":26961},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3632":73947,"_31224":73942,"_5":31580,"_21643":123909,"_28416":123910,"_3083":26968},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3632":73948,"_31224":73942,"_5":31580,"_21643":123912,"_28416":123913,"_3083":26230},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3632":73949,"_31224":73942,"_5":31580,"_21643":123915,"_28416":123916,"_3083":123917},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3632":73950,"_31224":73942,"_5":31580,"_21643":123919,"_28416":123920,"_3083":123921},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3632":73951,"_31224":73942,"_5":31580,"_21643":123923,"_28416":123924,"_3083":123925},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3632":73952,"_31224":73942,"_21643":123927,"_5":14891,"_28416":73942,"_3083":123928},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3632":73953,"_31224":73942,"_21643":123930,"_5":14891,"_28416":123900,"_3083":123931},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3632":73954,"_31224":73942,"_21643":123933,"_5":14891,"_28416":123900,"_3083":121821},[],{"_3632":73955,"_31224":73942,"_21643":123935,"_5":14891,"_28416":123900,"_3083":123936},[],"Método",{"_3632":73956,"_31224":73942,"_21643":123938,"_5":14891,"_28416":123900,"_3083":123939},[],"Autenticación y condición",{"_3632":73957,"_31224":73942,"_21643":123941,"_5":14891,"_28416":123900,"_3083":54494},[],{"_3632":73958,"_31224":73942,"_21643":123943,"_5":14891,"_28416":123900,"_3083":54497},[],{"_3632":73959,"_31224":73942,"_21643":123945,"_5":14891,"_28416":123900,"_3083":123946},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3632":73960,"_31224":73942,"_21643":123948,"_5":14891,"_28416":123900,"_3083":54503},[],{"_3632":73961,"_31224":73942,"_21643":123950,"_5":14891,"_28416":123900,"_3083":54506},[],{"_3632":73962,"_31224":73942,"_21643":123952,"_5":14891,"_28416":123900,"_3083":123953},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3632":73963,"_31224":73942,"_21643":123955,"_5":14891,"_28416":123900,"_3083":54512},[],{"_3632":73964,"_31224":73942,"_21643":123957,"_5":14891,"_28416":123900,"_3083":54506},[],{"_3632":73965,"_31224":73942,"_21643":123959,"_5":14891,"_28416":123900,"_3083":123960},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3632":73966,"_31224":73942,"_21643":123962,"_5":14891,"_28416":123900,"_3083":54520},[],{"_3632":73967,"_31224":73942,"_21643":123964,"_5":14891,"_28416":123900,"_3083":54506},[],{"_3632":73968,"_31224":73942,"_21643":123966,"_5":14891,"_28416":123900,"_3083":123967},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3632":73969,"_31224":73942,"_21643":123969,"_5":14891,"_28416":123900,"_3083":123970},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3632":73970,"_31224":73942,"_21643":123972,"_5":14891,"_28416":123904,"_3083":123973},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3632":73971,"_31224":73942,"_21643":123975,"_5":14891,"_28416":123904,"_3083":123976},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3632":73972,"_31224":73942,"_21643":123978,"_5":14891,"_28416":123907,"_3083":123979},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3632":73973,"_31224":73942,"_21643":123981,"_5":14891,"_28416":123907,"_3083":123982},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3632":73974,"_31224":73942,"_21643":123984,"_5":14891,"_28416":123910,"_3083":123985},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3632":73975,"_31224":73942,"_21643":123987,"_5":14891,"_28416":123910,"_3083":123988},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3632":73976,"_31224":73942,"_21643":123990,"_5":14891,"_28416":123913,"_3083":123991},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3632":73977,"_31224":73942,"_21643":123993,"_5":14891,"_28416":123913,"_3083":123994},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3632":73978,"_31224":73942,"_21643":123996,"_5":14891,"_28416":123916,"_3083":123997},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3632":73979,"_31224":73942,"_21643":123999,"_5":14891,"_28416":123916,"_3083":124000},[],"Parte",{"_3632":73980,"_31224":73942,"_21643":124002,"_5":14891,"_28416":123916,"_3083":124003},[],"Contenido tras decodificar su Base64",{"_3632":73981,"_31224":73942,"_21643":124005,"_5":14891,"_28416":123916,"_3083":54564},[],{"_3632":73982,"_31224":73942,"_21643":124007,"_5":14891,"_28416":123916,"_3083":124008},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3632":73983,"_31224":73942,"_21643":124010,"_5":14891,"_28416":123916,"_3083":54570},[],{"_3632":73984,"_31224":73942,"_21643":124012,"_5":14891,"_28416":123916,"_3083":124013},[],"PKCS#7 DER con el certificado emitido.",{"_3632":73985,"_31224":73942,"_21643":124015,"_5":14891,"_28416":123916,"_3083":124016},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3632":73986,"_31224":73942,"_21643":124018,"_5":14891,"_28416":123920,"_3083":124019},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3632":73987,"_31224":73942,"_21643":124021,"_5":14891,"_28416":123920,"_3083":124022},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3632":73988,"_31224":73942,"_21643":124024,"_5":14891,"_28416":123920,"_3083":124025},[],"Convierte y comprueba el resultado:",{"_3632":73989,"_31224":73942,"_21643":124027,"_5":14891,"_28416":123920,"_3083":124028},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3632":73990,"_31224":73942,"_21643":124030,"_5":14891,"_28416":123924,"_3083":124031},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3632":73991,"_31224":73942,"_21643":124033,"_5":14891,"_28416":123924,"_3083":124034},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3632":73992,"_31224":73992,"_5":15251,"_3083":123384,"_31583":124036,"_21643":124037,"_28416":73992},[51036,122061,53720,123206,123384],[],{"_3632":73993,"_31224":73992,"_21643":124039,"_5":14891,"_28416":73992,"_3083":124040},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3632":73994,"_31224":73992,"_5":31580,"_21643":124042,"_28416":124043,"_3083":124044},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3632":73995,"_31224":73992,"_5":31580,"_21643":124046,"_28416":124047,"_3083":124048},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3632":73996,"_31224":73992,"_5":31580,"_21643":124050,"_28416":124051,"_3083":124052},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3632":73997,"_31224":73992,"_21643":124054,"_5":14891,"_28416":73992,"_3083":124055},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3632":73998,"_31224":73992,"_21643":124057,"_5":14891,"_28416":124043,"_3083":124058},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3632":73999,"_31224":73992,"_21643":124060,"_5":14891,"_28416":124043,"_3083":124061},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3632":74000,"_31224":73992,"_21643":124063,"_5":14891,"_28416":124043,"_3083":124064},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3632":74001,"_31224":73992,"_21643":124066,"_5":14891,"_28416":124043,"_3083":124067},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3632":74002,"_31224":73992,"_21643":124069,"_5":14891,"_28416":124043,"_3083":124070},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3632":74003,"_31224":73992,"_21643":124072,"_5":14891,"_28416":124043,"_3083":124073},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3632":74004,"_31224":73992,"_21643":124075,"_5":14891,"_28416":124047,"_3083":124076},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3632":74005,"_31224":73992,"_21643":124078,"_5":14891,"_28416":124047,"_3083":124079},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":74006,"_31224":73992,"_21643":124081,"_5":14891,"_28416":124047,"_3083":124082},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3632":74007,"_31224":73992,"_21643":124084,"_5":14891,"_28416":124047,"_3083":124085},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3632":74008,"_31224":73992,"_21643":124087,"_5":14891,"_28416":124051,"_3083":124088},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":74009,"_31224":73992,"_21643":124090,"_5":14891,"_28416":124051,"_3083":124091},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":74010,"_31224":73992,"_21643":124093,"_5":14891,"_28416":124051,"_3083":124094},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3632":74011,"_31224":73992,"_21643":124096,"_5":14891,"_28416":124051,"_3083":124097},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3632":74012,"_31224":73992,"_21643":124099,"_5":14891,"_28416":124051,"_3083":124100},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3632":74013,"_31224":74013,"_5":15251,"_3083":124102,"_31583":124103,"_21643":124104,"_28416":74013},"Estrategias de aprovisionamiento",[51036,122061,53720,123206,123384],[],{"_3632":74014,"_31224":74013,"_21643":124106,"_5":14891,"_28416":74013,"_3083":124107},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3632":74015,"_31224":74013,"_5":31580,"_21643":124109,"_28416":124110,"_3083":124111},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3632":74016,"_31224":74013,"_5":31580,"_21643":124113,"_28416":124114,"_3083":124115},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3632":74017,"_31224":74013,"_5":31580,"_21643":124117,"_28416":124118,"_3083":124119},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3632":74018,"_31224":74013,"_5":31580,"_21643":124121,"_28416":124122,"_3083":124123},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3632":74019,"_31224":74013,"_5":31580,"_21643":124125,"_28416":124126,"_3083":124127},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3632":74020,"_31224":74013,"_21643":124129,"_5":14891,"_28416":74013,"_3083":124130},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3632":74021,"_31224":74013,"_21643":124132,"_5":14891,"_28416":124110,"_3083":124133},[],"Recorrido",{"_3632":74022,"_31224":74013,"_21643":124135,"_5":14891,"_28416":124110,"_3083":124136},[],"Cuándo existe el dispositivo",{"_3632":74023,"_31224":74013,"_21643":124138,"_5":14891,"_28416":124110,"_3083":124139},[],"Qué compruebas",{"_3632":74024,"_31224":74013,"_21643":124141,"_5":14891,"_28416":124110,"_3083":124142},[],"Asignación manual",{"_3632":74025,"_31224":74013,"_21643":124144,"_5":14891,"_28416":124110,"_3083":124145},[],"El operador lo crea antes de asociar un certificado.",{"_3632":74026,"_31224":74013,"_21643":124147,"_5":14891,"_28416":124110,"_3083":124148},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3632":74027,"_31224":74013,"_21643":124150,"_5":14891,"_28416":124110,"_3083":124151},[],"EST con `JITP`",{"_3632":74028,"_31224":74013,"_21643":124153,"_5":14891,"_28416":124110,"_3083":124154},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3632":74029,"_31224":74013,"_21643":124156,"_5":14891,"_28416":124110,"_3083":124157},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3632":74030,"_31224":74013,"_21643":124159,"_5":14891,"_28416":124110,"_3083":124160},[],"EST con `PRE_REGISTRATION`",{"_3632":74031,"_31224":74013,"_21643":124162,"_5":14891,"_28416":124110,"_3083":124163},[],"Debe existir antes de `/simpleenroll`.",{"_3632":74032,"_31224":74013,"_21643":124165,"_5":14891,"_28416":124110,"_3083":124166},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3632":74033,"_31224":74013,"_21643":124168,"_5":14891,"_28416":124110,"_3083":124169},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3632":74034,"_31224":74013,"_21643":124171,"_5":14891,"_28416":124110,"_3083":124172},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3632":74035,"_31224":74013,"_21643":124174,"_5":14891,"_28416":124114,"_3083":124175},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3632":74036,"_31224":74013,"_21643":124177,"_5":14891,"_28416":124114,"_3083":124178},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3632":74037,"_31224":74013,"_21643":124180,"_5":14891,"_28416":124114,"_3083":124181},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3632":74038,"_31224":74013,"_21643":124183,"_5":14891,"_28416":124118,"_3083":124184},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3632":74039,"_31224":74013,"_21643":124186,"_5":14891,"_28416":124118,"_3083":124187},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3632":74040,"_31224":74013,"_21643":124189,"_5":14891,"_28416":124118,"_3083":124190},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3632":74041,"_31224":74013,"_21643":124192,"_5":14891,"_28416":124118,"_3083":124193},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3632":74042,"_31224":74013,"_21643":124195,"_5":14891,"_28416":124118,"_3083":124196},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3632":74043,"_31224":74013,"_21643":124198,"_5":14891,"_28416":124118,"_3083":124199},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3632":74044,"_31224":74013,"_21643":124201,"_5":14891,"_28416":124122,"_3083":120959},[],{"_3632":74045,"_31224":74013,"_21643":124203,"_5":14891,"_28416":124122,"_3083":124204},[],"Material que atraviesa EST",{"_3632":74046,"_31224":74013,"_21643":124206,"_5":14891,"_28416":124122,"_3083":124207},[],"Clave generada por el dispositivo",{"_3632":74047,"_31224":74013,"_21643":124209,"_5":14891,"_28416":124122,"_3083":124210},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3632":74048,"_31224":74013,"_21643":124212,"_5":14891,"_28416":124122,"_3083":124213},[],"Clave ya disponible en el dispositivo",{"_3632":74049,"_31224":74013,"_21643":124215,"_5":14891,"_28416":124122,"_3083":124216},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3632":74050,"_31224":74013,"_21643":124218,"_5":14891,"_28416":124122,"_3083":54048},[],{"_3632":74051,"_31224":74013,"_21643":124220,"_5":14891,"_28416":124122,"_3083":124221},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3632":74052,"_31224":74013,"_21643":124223,"_5":14891,"_28416":124122,"_3083":124224},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3632":74053,"_31224":74013,"_21643":124226,"_5":14891,"_28416":124126,"_3083":124227},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3632":74054,"_31224":74054,"_5":15251,"_3083":124229,"_31583":124230,"_21643":124231,"_28416":74054},"Renovación y recuperación",[51036,122061,53720,123206,123384],[],{"_3632":74055,"_31224":74054,"_21643":124233,"_5":14891,"_28416":74054,"_3083":124234},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3632":74056,"_31224":74054,"_5":31580,"_21643":124236,"_28416":124237,"_3083":124238},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3632":74057,"_31224":74054,"_5":31580,"_21643":124240,"_28416":124241,"_3083":124242},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3632":74058,"_31224":74054,"_5":31580,"_21643":124244,"_28416":124245,"_3083":124246},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3632":74059,"_31224":74054,"_5":31580,"_21643":124248,"_28416":124249,"_3083":124250},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3632":74060,"_31224":74054,"_5":31580,"_21643":124252,"_28416":124253,"_3083":124254},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3632":74061,"_31224":74054,"_21643":124256,"_5":14891,"_28416":74054,"_3083":124257},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3632":74062,"_31224":74054,"_21643":124259,"_5":14891,"_28416":124237,"_3083":124260},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3632":74063,"_31224":74054,"_21643":124262,"_5":14891,"_28416":124237,"_3083":124263},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3632":74064,"_31224":74054,"_21643":124265,"_5":14891,"_28416":124237,"_3083":124266},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3632":74065,"_31224":74054,"_21643":124268,"_5":14891,"_28416":124237,"_3083":124269},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3632":74066,"_31224":74054,"_21643":124271,"_5":14891,"_28416":124241,"_3083":124272},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3632":74067,"_31224":74054,"_21643":124274,"_5":14891,"_28416":124241,"_3083":124275},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3632":74068,"_31224":74054,"_21643":124277,"_5":14891,"_28416":124245,"_3083":124278},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3632":74069,"_31224":74054,"_21643":124280,"_5":14891,"_28416":124245,"_3083":124281},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3632":74070,"_31224":74054,"_21643":124283,"_5":14891,"_28416":124245,"_3083":124284},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3632":74071,"_31224":74054,"_21643":124286,"_5":14891,"_28416":124249,"_3083":124287},[],"Situación",{"_3632":74072,"_31224":74054,"_21643":124289,"_5":14891,"_28416":124249,"_3083":124290},[],"Procedimiento",{"_3632":74073,"_31224":74054,"_21643":124292,"_5":14891,"_28416":124249,"_3083":124293},[],"Certificado vigente, fuera de ventana",{"_3632":74074,"_31224":74054,"_21643":124295,"_5":14891,"_28416":124249,"_3083":124296},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3632":74075,"_31224":74054,"_21643":124298,"_5":14891,"_28416":124249,"_3083":124299},[],"Certificado vencido, clave disponible",{"_3632":74076,"_31224":74054,"_21643":124301,"_5":14891,"_28416":124249,"_3083":124302},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3632":74077,"_31224":74054,"_21643":124304,"_5":14891,"_28416":124249,"_3083":124305},[],"Renovación por webhook o `NO_AUTH`",{"_3632":74078,"_31224":74054,"_21643":124307,"_5":14891,"_28416":124249,"_3083":124308},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3632":74079,"_31224":74054,"_21643":124310,"_5":14891,"_28416":124249,"_3083":124311},[],"Clave perdida o inaccesible",{"_3632":74080,"_31224":74054,"_21643":124313,"_5":14891,"_28416":124249,"_3083":124314},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3632":74081,"_31224":74054,"_21643":124316,"_5":14891,"_28416":124249,"_3083":124317},[],"Identidad actual revocada",{"_3632":74082,"_31224":74054,"_21643":124319,"_5":14891,"_28416":124249,"_3083":124320},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3632":74083,"_31224":74054,"_21643":124322,"_5":14891,"_28416":124249,"_3083":124323},[],"Dispositivo sin identidad",{"_3632":74084,"_31224":74054,"_21643":124325,"_5":14891,"_28416":124249,"_3083":124326},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3632":74085,"_31224":74054,"_21643":124328,"_5":14891,"_28416":124249,"_3083":124329},[],"Dispositivo retirado",{"_3632":74086,"_31224":74054,"_21643":124331,"_5":14891,"_28416":124249,"_3083":124332},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3632":74087,"_31224":74054,"_21643":124334,"_5":14891,"_28416":124249,"_3083":124335},[],"Timeout, HTTP 500 o fallo de instalación",{"_3632":74088,"_31224":74054,"_21643":124337,"_5":14891,"_28416":124249,"_3083":124338},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3632":74089,"_31224":74054,"_21643":124340,"_5":14891,"_28416":124253,"_3083":124341},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3632":74090,"_31224":74054,"_21643":124343,"_5":14891,"_28416":124253,"_3083":124344},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3632":74091,"_31224":74091,"_5":15251,"_3083":124346,"_31583":124347,"_21643":124348,"_28416":74091},"Diagnóstico de enrolamiento",[51036,122061,53720,123206,123384],[],{"_3632":74092,"_31224":74091,"_21643":124350,"_5":14891,"_28416":74091,"_3083":124351},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3632":74093,"_31224":74091,"_5":31580,"_21643":124353,"_28416":124354,"_3083":124355},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3632":74094,"_31224":74091,"_5":31580,"_21643":124357,"_28416":124358,"_3083":124359},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3632":74095,"_31224":74091,"_5":31580,"_21643":124361,"_28416":124362,"_3083":123925},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3632":74096,"_31224":74091,"_5":31580,"_21643":124364,"_28416":124365,"_3083":124366},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3632":74097,"_31224":74091,"_21643":124368,"_5":14891,"_28416":74091,"_3083":124369},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3632":74098,"_31224":74091,"_21643":124371,"_5":14891,"_28416":124358,"_3083":124372},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3632":74099,"_31224":74091,"_21643":124374,"_5":14891,"_28416":124358,"_3083":124375},[],"Síntoma o mensaje",{"_3632":74100,"_31224":74091,"_21643":124377,"_5":14891,"_28416":124358,"_3083":124378},[],"Qué revisar",{"_3632":74101,"_31224":74091,"_21643":124380,"_5":14891,"_28416":124358,"_3083":124381},[],"curl rechaza TLS, nombre o emisor",{"_3632":74102,"_31224":74091,"_21643":124383,"_5":14891,"_28416":124358,"_3083":124384},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3632":74103,"_31224":74091,"_21643":124386,"_5":14891,"_28416":124358,"_3083":124387},[],"404 o APS ausente",{"_3632":74104,"_31224":74091,"_21643":124389,"_5":14891,"_28416":124358,"_3083":124390},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3632":74105,"_31224":74091,"_21643":124392,"_5":14891,"_28416":124358,"_3083":124393},[],"400, error de CSR o formato",{"_3632":74106,"_31224":74091,"_21643":124395,"_5":14891,"_28416":124358,"_3083":124396},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3632":74107,"_31224":74091,"_21643":124398,"_5":14891,"_28416":124358,"_3083":124399},[],"Credencial ausente o certificado no válido",{"_3632":74108,"_31224":74091,"_21643":124401,"_5":14891,"_28416":124358,"_3083":124402},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3632":74109,"_31224":74091,"_21643":124404,"_5":14891,"_28416":124358,"_3083":124405},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3632":74110,"_31224":74091,"_21643":124407,"_5":14891,"_28416":124358,"_3083":124408},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3632":74111,"_31224":74091,"_21643":124410,"_5":14891,"_28416":124358,"_3083":124411},[],"Webhook deniega, expira o responde sin autorización",{"_3632":74112,"_31224":74091,"_21643":124413,"_5":14891,"_28416":124358,"_3083":124414},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3632":74113,"_31224":74091,"_21643":124416,"_5":14891,"_28416":124358,"_3083":54976},[],{"_3632":74114,"_31224":74091,"_21643":124418,"_5":14891,"_28416":124358,"_3083":124419},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3632":74115,"_31224":74091,"_21643":124421,"_5":14891,"_28416":124358,"_3083":54982},[],{"_3632":74116,"_31224":74091,"_21643":124423,"_5":14891,"_28416":124358,"_3083":124424},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3632":74117,"_31224":74091,"_21643":124426,"_5":14891,"_28416":124358,"_3083":54988},[],{"_3632":74118,"_31224":74091,"_21643":124428,"_5":14891,"_28416":124358,"_3083":124429},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3632":74119,"_31224":74091,"_21643":124431,"_5":14891,"_28416":124358,"_3083":54994},[],{"_3632":74120,"_31224":74091,"_21643":124433,"_5":14891,"_28416":124358,"_3083":124434},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3632":74121,"_31224":74091,"_21643":124436,"_5":14891,"_28416":124358,"_3083":55000},[],{"_3632":74122,"_31224":74091,"_21643":124438,"_5":14891,"_28416":124358,"_3083":124439},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3632":74123,"_31224":74091,"_21643":124441,"_5":14891,"_28416":124358,"_3083":124442},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3632":74124,"_31224":74091,"_21643":124444,"_5":14891,"_28416":124358,"_3083":124445},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3632":74125,"_31224":74091,"_21643":124447,"_5":14891,"_28416":124358,"_3083":124448},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3632":74126,"_31224":74091,"_21643":124450,"_5":14891,"_28416":124358,"_3083":124451},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3632":74127,"_31224":74091,"_21643":124453,"_5":14891,"_28416":124358,"_3083":55018},[],{"_3632":74128,"_31224":74091,"_21643":124455,"_5":14891,"_28416":124358,"_3083":124456},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3632":74129,"_31224":74091,"_21643":124458,"_5":14891,"_28416":124358,"_3083":55024},[],{"_3632":74130,"_31224":74091,"_21643":124460,"_5":14891,"_28416":124358,"_3083":124461},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3632":74131,"_31224":74091,"_21643":124463,"_5":14891,"_28416":124358,"_3083":124464},[],"DMS propietario distinto",{"_3632":74132,"_31224":74091,"_21643":124466,"_5":14891,"_28416":124358,"_3083":124467},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3632":74133,"_31224":74091,"_21643":124469,"_5":14891,"_28416":124358,"_3083":55036},[],{"_3632":74134,"_31224":74091,"_21643":124471,"_5":14891,"_28416":124358,"_3083":124472},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3632":74135,"_31224":74091,"_21643":124474,"_5":14891,"_28416":124358,"_3083":55042},[],{"_3632":74136,"_31224":74091,"_21643":124476,"_5":14891,"_28416":124358,"_3083":124477},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3632":74137,"_31224":74091,"_21643":124479,"_5":14891,"_28416":124358,"_3083":124480},[],"Certificado actual revocado",{"_3632":74138,"_31224":74091,"_21643":124482,"_5":14891,"_28416":124358,"_3083":124483},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3632":74139,"_31224":74091,"_21643":124485,"_5":14891,"_28416":124358,"_3083":124486},[],"Error de CA, perfil o firma",{"_3632":74140,"_31224":74091,"_21643":124488,"_5":14891,"_28416":124358,"_3083":124489},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3632":74141,"_31224":74091,"_21643":124491,"_5":14891,"_28416":124358,"_3083":124492},[],"HTTP 200 sin conexión del dispositivo",{"_3632":74142,"_31224":74091,"_21643":124494,"_5":14891,"_28416":124358,"_3083":124495},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3632":74143,"_31224":74091,"_21643":124497,"_5":14891,"_28416":124358,"_3083":124498},[],"Timeout o error después de emitir",{"_3632":74144,"_31224":74091,"_21643":124500,"_5":14891,"_28416":124358,"_3083":124501},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3632":74145,"_31224":74091,"_21643":124503,"_5":14891,"_28416":124362,"_3083":124504},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3632":74146,"_31224":74091,"_21643":124506,"_5":14891,"_28416":124362,"_3083":124507},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3632":74147,"_31224":74091,"_21643":124509,"_5":14891,"_28416":124365,"_3083":124510},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3632":74148,"_31224":74091,"_21643":124512,"_5":14891,"_28416":124365,"_3083":124513},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3632":74149,"_31224":74091,"_21643":124515,"_5":14891,"_28416":124365,"_3083":124516},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3632":74150,"_31224":74091,"_21643":124518,"_5":14891,"_28416":124365,"_3083":124519},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3632":74151,"_31224":74091,"_21643":124521,"_5":14891,"_28416":124365,"_3083":124522},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3632":74152,"_31224":74091,"_21643":124524,"_5":14891,"_28416":124365,"_3083":124525},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3632":74153,"_31224":74091,"_21643":124527,"_5":14891,"_28416":124365,"_3083":124528},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3632":74154,"_31224":74154,"_5":15251,"_3083":124530,"_31583":124531,"_21643":124532,"_28416":74154},"Distribución y actualización de confianza",[51036,122061,53720,123206,123384],[],{"_3632":74155,"_31224":74154,"_21643":124534,"_5":14891,"_28416":74154,"_3083":124535},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3632":74156,"_31224":74154,"_5":31580,"_21643":124537,"_28416":124538,"_3083":124539},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3632":74157,"_31224":74154,"_5":31580,"_21643":124541,"_28416":124542,"_3083":124543},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3632":74158,"_31224":74154,"_5":31580,"_21643":124545,"_28416":124546,"_3083":124547},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3632":74159,"_31224":74154,"_5":31580,"_21643":124549,"_28416":124550,"_3083":124551},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3632":74160,"_31224":74154,"_5":31580,"_21643":124553,"_28416":124554,"_3083":124555},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3632":74161,"_31224":74154,"_21643":124557,"_5":14891,"_28416":74154,"_3083":124558},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3632":74162,"_31224":74154,"_21643":124560,"_5":14891,"_28416":124538,"_3083":124561},[],"Relación",{"_3632":74163,"_31224":74154,"_21643":124563,"_5":14891,"_28416":124538,"_3083":124564},[],"Material que prepara el responsable",{"_3632":74164,"_31224":74154,"_21643":124566,"_5":14891,"_28416":124538,"_3083":124567},[],"Dispositivo → servidor EST",{"_3632":74165,"_31224":74154,"_21643":124569,"_5":14891,"_28416":124538,"_3083":124570},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3632":74166,"_31224":74154,"_21643":124572,"_5":14891,"_28416":124538,"_3083":124573},[],"DMS → solicitante",{"_3632":74167,"_31224":74154,"_21643":124575,"_5":14891,"_28416":124538,"_3083":124576},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3632":74168,"_31224":74154,"_21643":124578,"_5":14891,"_28416":124538,"_3083":124579},[],"Consumidor → dispositivo",{"_3632":74169,"_31224":74154,"_21643":124581,"_5":14891,"_28416":124538,"_3083":124582},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3632":74170,"_31224":74154,"_21643":124584,"_5":14891,"_28416":124538,"_3083":124585},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3632":74171,"_31224":74154,"_21643":124587,"_5":14891,"_28416":124542,"_3083":124588},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3632":74172,"_31224":74154,"_21643":124590,"_5":14891,"_28416":124542,"_3083":124591},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3632":74173,"_31224":74154,"_21643":124593,"_5":14891,"_28416":124546,"_3083":124594},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3632":74174,"_31224":74154,"_21643":124596,"_5":14891,"_28416":124546,"_3083":124597},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3632":74175,"_31224":74154,"_21643":124599,"_5":14891,"_28416":124546,"_3083":124600},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3632":74176,"_31224":74154,"_21643":124602,"_5":14891,"_28416":124546,"_3083":124603},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3632":74177,"_31224":74154,"_21643":124605,"_5":14891,"_28416":124546,"_3083":124606},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3632":74178,"_31224":74154,"_21643":124608,"_5":14891,"_28416":124546,"_3083":124609},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3632":74179,"_31224":74154,"_21643":124611,"_5":14891,"_28416":124550,"_3083":124612},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3632":74180,"_31224":74154,"_21643":124614,"_5":14891,"_28416":124550,"_3083":124615},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3632":74181,"_31224":74154,"_21643":124617,"_5":14891,"_28416":124550,"_3083":124618},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3632":74182,"_31224":74154,"_21643":124620,"_5":14891,"_28416":124554,"_3083":124621},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3632":74183,"_31224":74183,"_5":15251,"_3083":55191,"_31583":124623,"_21643":124625,"_28416":74183},[51036,122061,53720,123206,124624],"Integraciones",[],{"_3632":74184,"_31224":74183,"_21643":124627,"_5":14891,"_28416":74183,"_3083":124628},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3632":74185,"_31224":74183,"_5":31580,"_21643":124630,"_28416":124631,"_3083":124632},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3632":74186,"_31224":74183,"_5":31580,"_21643":124634,"_28416":124635,"_3083":124636},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3632":74187,"_31224":74183,"_5":31580,"_21643":124638,"_28416":124639,"_3083":124640},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3632":74188,"_31224":74183,"_5":31580,"_21643":124642,"_28416":124643,"_3083":124644},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3632":74189,"_31224":74183,"_5":31580,"_21643":124646,"_28416":124647,"_3083":124648},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3632":74190,"_31224":74183,"_5":31580,"_21643":124650,"_28416":124651,"_3083":124652},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3632":74191,"_31224":74183,"_5":31580,"_21643":124654,"_28416":124655,"_3083":124656},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3632":74192,"_31224":74183,"_5":31580,"_21643":124658,"_28416":124659,"_3083":124660},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3632":74193,"_31224":74183,"_5":31580,"_21643":124662,"_28416":124663,"_3083":55233},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3632":74194,"_31224":74183,"_5":31580,"_21643":124665,"_28416":124666,"_3083":55237},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3632":74195,"_31224":74183,"_5":31580,"_21643":124668,"_28416":124669,"_3083":124670},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3632":74196,"_31224":74183,"_5":31580,"_21643":124672,"_28416":124673,"_3083":124674},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3632":74197,"_31224":74183,"_5":31580,"_21643":124676,"_28416":124677,"_3083":124678},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3632":74198,"_31224":74183,"_5":31580,"_21643":124680,"_28416":124681,"_3083":124682},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3632":74199,"_31224":74183,"_5":31580,"_21643":124684,"_28416":124685,"_3083":124686},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3632":74200,"_31224":74183,"_5":31580,"_21643":124688,"_28416":124689,"_3083":124690},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3632":74201,"_31224":74183,"_5":31580,"_21643":124692,"_28416":124693,"_3083":124694},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3632":74202,"_31224":74183,"_5":31580,"_21643":124696,"_28416":124697,"_3083":124698},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3632":74203,"_31224":74183,"_5":31580,"_21643":124700,"_28416":124701,"_3083":124702},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3632":74204,"_31224":74183,"_5":31580,"_21643":124704,"_28416":124705,"_3083":124706},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3632":74205,"_31224":74183,"_5":31580,"_21643":124708,"_28416":124709,"_3083":124710},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3632":74206,"_31224":74183,"_5":31580,"_21643":124712,"_28416":124713,"_3083":124714},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3632":74207,"_31224":74183,"_5":31580,"_21643":124716,"_28416":124717,"_3083":124718},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3632":74208,"_31224":74183,"_5":31580,"_21643":124720,"_28416":124721,"_3083":124722},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3632":74209,"_31224":74183,"_5":31580,"_21643":124724,"_28416":124725,"_3083":124726},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3632":74210,"_31224":74183,"_21643":124728,"_5":14891,"_28416":74183,"_3083":124729},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3632":74211,"_31224":74183,"_21643":124731,"_5":14891,"_28416":74183,"_3083":124732},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3632":74212,"_31224":74183,"_21643":124734,"_5":14891,"_28416":74183,"_3083":124735},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3632":74213,"_31224":74183,"_21643":124737,"_5":14891,"_28416":124631,"_3083":124738},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3632":74214,"_31224":74183,"_21643":124740,"_5":14891,"_28416":124631,"_3083":124741},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3632":74215,"_31224":74183,"_21643":124743,"_5":14891,"_28416":124631,"_3083":124744},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3632":74216,"_31224":74183,"_21643":124746,"_5":14891,"_28416":124631,"_3083":124747},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3632":74217,"_31224":74183,"_21643":124749,"_5":14891,"_28416":124635,"_3083":124750},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3632":74218,"_31224":74183,"_21643":124752,"_5":14891,"_28416":124639,"_3083":124753},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3632":74219,"_31224":74183,"_21643":124755,"_5":14891,"_28416":124639,"_3083":124756},[],"Acción IAM",{"_3632":74220,"_31224":74183,"_21643":124758,"_5":14891,"_28416":124639,"_3083":120965},[],{"_3632":74221,"_31224":74183,"_21643":124760,"_5":14891,"_28416":124639,"_3083":55332},[],{"_3632":74222,"_31224":74183,"_21643":124762,"_5":14891,"_28416":124639,"_3083":124763},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3632":74223,"_31224":74183,"_21643":124765,"_5":14891,"_28416":124639,"_3083":55338},[],{"_3632":74224,"_31224":74183,"_21643":124767,"_5":14891,"_28416":124639,"_3083":124768},[],"Registrar la CA en AWS IoT",{"_3632":74225,"_31224":74183,"_21643":124770,"_5":14891,"_28416":124639,"_3083":55344},[],{"_3632":74226,"_31224":74183,"_21643":124772,"_5":14891,"_28416":124639,"_3083":124773},[],"Consultar el estado del registro de la CA",{"_3632":74227,"_31224":74183,"_21643":124775,"_5":14891,"_28416":124639,"_3083":55350},[],{"_3632":74228,"_31224":74183,"_21643":124777,"_5":14891,"_28416":124639,"_3083":124778},[],"Crear o actualizar Things en IoT Core",{"_3632":74229,"_31224":74183,"_21643":124780,"_5":14891,"_28416":124639,"_3083":55356},[],{"_3632":74230,"_31224":74183,"_21643":124782,"_5":14891,"_28416":124639,"_3083":124783},[],"Aprovisionar Things mediante plantilla",{"_3632":74231,"_31224":74183,"_21643":124785,"_5":14891,"_28416":124639,"_3083":55362},[],{"_3632":74232,"_31224":74183,"_21643":124787,"_5":14891,"_28416":124639,"_3083":124788},[],"Registrar certificados de dispositivo",{"_3632":74233,"_31224":74183,"_21643":124790,"_5":14891,"_28416":124639,"_3083":55368},[],{"_3632":74234,"_31224":74183,"_21643":124792,"_5":14891,"_28416":124639,"_3083":124793},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3632":74235,"_31224":74183,"_21643":124795,"_5":14891,"_28416":124639,"_3083":55374},[],{"_3632":74236,"_31224":74183,"_21643":124797,"_5":14891,"_28416":124639,"_3083":124798},[],"Crear y adjuntar políticas IoT",{"_3632":74237,"_31224":74183,"_21643":124800,"_5":14891,"_28416":124639,"_3083":55380},[],{"_3632":74238,"_31224":74183,"_21643":124802,"_5":14891,"_28416":124639,"_3083":124803},[],"Gestionar grupos de Things",{"_3632":74239,"_31224":74183,"_21643":124805,"_5":14891,"_28416":124639,"_3083":55386},[],{"_3632":74240,"_31224":74183,"_21643":124807,"_5":14891,"_28416":124639,"_3083":124808},[],"Crear plantillas JITP",{"_3632":74241,"_31224":74183,"_21643":124810,"_5":14891,"_28416":124639,"_3083":55392},[],{"_3632":74242,"_31224":74183,"_21643":124812,"_5":14891,"_28416":124639,"_3083":124813},[],"Leer y escribir el Device Shadow",{"_3632":74243,"_31224":74183,"_21643":124815,"_5":14891,"_28416":124639,"_3083":124816},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3632":74244,"_31224":74183,"_21643":124818,"_5":14891,"_28416":124643,"_3083":124819},[],"Parámetro",{"_3632":74245,"_31224":74183,"_21643":124821,"_5":14891,"_28416":124643,"_3083":124822},[],"Tipo",{"_3632":74246,"_31224":74183,"_21643":124824,"_5":14891,"_28416":124643,"_3083":124825},[],"Requerido",{"_3632":74247,"_31224":74183,"_21643":124827,"_5":14891,"_28416":124643,"_3083":124828},[],"Descripción",{"_3632":74248,"_31224":74183,"_21643":124830,"_5":14891,"_28416":124643,"_3083":55413},[],{"_3632":74249,"_31224":74183,"_21643":124832,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74250,"_31224":74183,"_21643":124834,"_5":14891,"_28416":124643,"_3083":124835},[],"Sí",{"_3632":74251,"_31224":74183,"_21643":124837,"_5":14891,"_28416":124643,"_3083":124838},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3632":74252,"_31224":74183,"_21643":124840,"_5":14891,"_28416":124643,"_3083":55424},[],{"_3632":74253,"_31224":74183,"_21643":124842,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74254,"_31224":74183,"_21643":124844,"_5":14891,"_28416":124643,"_3083":124835},[],{"_3632":74255,"_31224":74183,"_21643":124846,"_5":14891,"_28416":124643,"_3083":124847},[],"Región AWS donde opera el conector.",{"_3632":74256,"_31224":74183,"_21643":124849,"_5":14891,"_28416":124643,"_3083":55434},[],{"_3632":74257,"_31224":74183,"_21643":124851,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74258,"_31224":74183,"_21643":124853,"_5":14891,"_28416":124643,"_3083":124835},[],{"_3632":74259,"_31224":74183,"_21643":124855,"_5":14891,"_28416":124643,"_3083":124856},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3632":74260,"_31224":74183,"_21643":124858,"_5":14891,"_28416":124643,"_3083":55444},[],{"_3632":74261,"_31224":74183,"_21643":124860,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74262,"_31224":74183,"_21643":124862,"_5":14891,"_28416":124643,"_3083":124863},[],"Solo con `auth_method=static`",{"_3632":74263,"_31224":74183,"_21643":124865,"_5":14891,"_28416":124643,"_3083":124866},[],"Clave de acceso AWS.",{"_3632":74264,"_31224":74183,"_21643":124868,"_5":14891,"_28416":124643,"_3083":55455},[],{"_3632":74265,"_31224":74183,"_21643":124870,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74266,"_31224":74183,"_21643":124872,"_5":14891,"_28416":124643,"_3083":124863},[],{"_3632":74267,"_31224":74183,"_21643":124874,"_5":14891,"_28416":124643,"_3083":124875},[],"Clave secreta AWS.",{"_3632":74268,"_31224":74183,"_21643":124877,"_5":14891,"_28416":124643,"_3083":55465},[],{"_3632":74269,"_31224":74183,"_21643":124879,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74270,"_31224":74183,"_21643":124881,"_5":14891,"_28416":124643,"_3083":55470},[],{"_3632":74271,"_31224":74183,"_21643":124883,"_5":14891,"_28416":124643,"_3083":124884},[],"Token de sesión (con `auth_method=static`).",{"_3632":74272,"_31224":74183,"_21643":124886,"_5":14891,"_28416":124643,"_3083":55476},[],{"_3632":74273,"_31224":74183,"_21643":124888,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74274,"_31224":74183,"_21643":124890,"_5":14891,"_28416":124643,"_3083":124891},[],"Solo con `auth_method=role`",{"_3632":74275,"_31224":74183,"_21643":124893,"_5":14891,"_28416":124643,"_3083":124894},[],"ARN del rol a asumir.",{"_3632":74276,"_31224":74183,"_21643":124896,"_5":14891,"_28416":124643,"_3083":55487},[],{"_3632":74277,"_31224":74183,"_21643":124898,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74278,"_31224":74183,"_21643":124900,"_5":14891,"_28416":124643,"_3083":55470},[],{"_3632":74279,"_31224":74183,"_21643":124902,"_5":14891,"_28416":124643,"_3083":124903},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3632":74280,"_31224":74183,"_21643":124905,"_5":14891,"_28416":124643,"_3083":55497},[],{"_3632":74281,"_31224":74183,"_21643":124907,"_5":14891,"_28416":124643,"_3083":93097},[],{"_3632":74282,"_31224":74183,"_21643":124909,"_5":14891,"_28416":124643,"_3083":124835},[],{"_3632":74283,"_31224":74183,"_21643":124911,"_5":14891,"_28416":124643,"_3083":124912},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3632":74284,"_31224":74183,"_21643":124914,"_5":14891,"_28416":124643,"_3083":55507},[],{"_3632":74285,"_31224":74183,"_21643":124916,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74286,"_31224":74183,"_21643":124918,"_5":14891,"_28416":124643,"_3083":124835},[],{"_3632":74287,"_31224":74183,"_21643":124920,"_5":14891,"_28416":124643,"_3083":124921},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3632":74288,"_31224":74183,"_21643":124923,"_5":14891,"_28416":124643,"_3083":55517},[],{"_3632":74289,"_31224":74183,"_21643":124925,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74290,"_31224":74183,"_21643":124927,"_5":14891,"_28416":124643,"_3083":124835},[],{"_3632":74291,"_31224":74183,"_21643":124929,"_5":14891,"_28416":124643,"_3083":124930},[],"URL HTTP del Device Manager de Lamassu.",{"_3632":74292,"_31224":74183,"_21643":124932,"_5":14891,"_28416":124643,"_3083":55527},[],{"_3632":74293,"_31224":74183,"_21643":124934,"_5":14891,"_28416":124643,"_3083":25830},[],{"_3632":74294,"_31224":74183,"_21643":124936,"_5":14891,"_28416":124643,"_3083":124835},[],{"_3632":74295,"_31224":74183,"_21643":124938,"_5":14891,"_28416":124643,"_3083":124939},[],"URL HTTP del servicio de CA de Lamassu.",{"_3632":74296,"_31224":74183,"_21643":124941,"_5":14891,"_28416":124647,"_3083":124942},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3632":74297,"_31224":74183,"_21643":124944,"_5":14891,"_28416":124647,"_3083":124945},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3632":74298,"_31224":74183,"_21643":124947,"_5":14891,"_28416":124647,"_3083":124948},[],"Tipo de CloudEvent",{"_3632":74299,"_31224":74183,"_21643":124950,"_5":14891,"_28416":124647,"_3083":124951},[],"Recurso en Lamassu",{"_3632":74300,"_31224":74183,"_21643":124953,"_5":14891,"_28416":124647,"_3083":124954},[],"Recurso AWS",{"_3632":74301,"_31224":74183,"_21643":124956,"_5":14891,"_28416":124647,"_3083":124957},[],"Acciones IAM",{"_3632":74302,"_31224":74183,"_21643":124959,"_5":14891,"_28416":124647,"_3083":124960},[],"Llamadas AWS y efecto",{"_3632":74303,"_31224":74183,"_21643":124962,"_5":14891,"_28416":124647,"_3083":124963},[],"Dónde en esta página",{"_3632":74304,"_31224":74183,"_21643":124965,"_5":14891,"_28416":124647,"_3083":55561},[],{"_3632":74305,"_31224":74183,"_21643":124967,"_5":14891,"_28416":124647,"_3083":55564},[],{"_3632":74306,"_31224":74183,"_21643":124969,"_5":14891,"_28416":124647,"_3083":55567},[],{"_3632":74307,"_31224":74183,"_21643":124971,"_5":14891,"_28416":124647,"_3083":55570},[],{"_3632":74308,"_31224":74183,"_21643":124973,"_5":14891,"_28416":124647,"_3083":124974},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3632":74309,"_31224":74183,"_21643":124976,"_5":14891,"_28416":124647,"_3083":124660},[],{"_3632":74310,"_31224":74183,"_21643":124978,"_5":14891,"_28416":124647,"_3083":55578},[],{"_3632":74311,"_31224":74183,"_21643":124980,"_5":14891,"_28416":124647,"_3083":55581},[],{"_3632":74312,"_31224":74183,"_21643":124982,"_5":14891,"_28416":124647,"_3083":55584},[],{"_3632":74313,"_31224":74183,"_21643":124984,"_5":14891,"_28416":124647,"_3083":55587},[],{"_3632":74314,"_31224":74183,"_21643":124986,"_5":14891,"_28416":124647,"_3083":124987},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3632":74315,"_31224":74183,"_21643":124989,"_5":14891,"_28416":124647,"_3083":124686},[],{"_3632":74316,"_31224":74183,"_21643":124991,"_5":14891,"_28416":124647,"_3083":55595},[],{"_3632":74317,"_31224":74183,"_21643":124993,"_5":14891,"_28416":124647,"_3083":124994},[],"Dispositivo",{"_3632":74318,"_31224":74183,"_21643":124996,"_5":14891,"_28416":124647,"_3083":55601},[],{"_3632":74319,"_31224":74183,"_21643":124998,"_5":14891,"_28416":124647,"_3083":55604},[],{"_3632":74320,"_31224":74183,"_21643":125000,"_5":14891,"_28416":124647,"_3083":125001},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3632":74321,"_31224":74183,"_21643":125003,"_5":14891,"_28416":124647,"_3083":124694},[],{"_3632":74322,"_31224":74183,"_21643":125005,"_5":14891,"_28416":124647,"_3083":55612},[],{"_3632":74323,"_31224":74183,"_21643":125007,"_5":14891,"_28416":124647,"_3083":125008},[],"Certificado",{"_3632":74324,"_31224":74183,"_21643":125010,"_5":14891,"_28416":124647,"_3083":55618},[],{"_3632":74325,"_31224":74183,"_21643":125012,"_5":14891,"_28416":124647,"_3083":125013},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3632":74326,"_31224":74183,"_21643":125015,"_5":14891,"_28416":124647,"_3083":125016},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3632":74327,"_31224":74183,"_21643":125018,"_5":14891,"_28416":124647,"_3083":124706},[],{"_3632":74328,"_31224":74183,"_21643":125020,"_5":14891,"_28416":124647,"_3083":55629},[],{"_3632":74329,"_31224":74183,"_21643":125022,"_5":14891,"_28416":124647,"_3083":125023},[],"Certificado / Dispositivo",{"_3632":74330,"_31224":74183,"_21643":125025,"_5":14891,"_28416":124647,"_3083":55635},[],{"_3632":74331,"_31224":74183,"_21643":125027,"_5":14891,"_28416":124647,"_3083":51432},[],{"_3632":74332,"_31224":74183,"_21643":125029,"_5":14891,"_28416":124647,"_3083":125030},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3632":74333,"_31224":74183,"_21643":125032,"_5":14891,"_28416":124647,"_3083":124714},[],{"_3632":74334,"_31224":74183,"_21643":125034,"_5":14891,"_28416":124651,"_3083":125035},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3632":74335,"_31224":74183,"_21643":125037,"_5":14891,"_28416":124655,"_3083":125038},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3632":74336,"_31224":74183,"_21643":125040,"_5":14891,"_28416":124655,"_3083":125041},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3632":74337,"_31224":74183,"_21643":125043,"_5":14891,"_28416":124659,"_3083":125044},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3632":74338,"_31224":74183,"_21643":125046,"_5":14891,"_28416":124659,"_3083":125047},[],"Transición",{"_3632":74339,"_31224":74183,"_21643":125049,"_5":14891,"_28416":124659,"_3083":125050},[],"Llamadas AWS",{"_3632":74340,"_31224":74183,"_21643":125052,"_5":14891,"_28416":124659,"_3083":125053},[],"`NoRegistrada` → `Solicitada`",{"_3632":74341,"_31224":74183,"_21643":125055,"_5":14891,"_28416":124659,"_3083":125056},[],"ninguna (solo escritura de metadatos)",{"_3632":74342,"_31224":74183,"_21643":125058,"_5":14891,"_28416":124659,"_3083":125059},[],"`Solicitada` → `Registrando`",{"_3632":74343,"_31224":74183,"_21643":125061,"_5":14891,"_28416":124659,"_3083":125062},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3632":74344,"_31224":74183,"_21643":125064,"_5":14891,"_28416":124659,"_3083":125065},[],"`Registrando` → `Completada`",{"_3632":74345,"_31224":74183,"_21643":125067,"_5":14891,"_28416":124659,"_3083":125068},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3632":74346,"_31224":74183,"_21643":125070,"_5":14891,"_28416":124659,"_3083":125071},[],"`Registrando` → `Fallida`",{"_3632":74347,"_31224":74183,"_21643":125073,"_5":14891,"_28416":124659,"_3083":125074},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3632":74348,"_31224":74183,"_21643":125076,"_5":14891,"_28416":124659,"_3083":125077},[],"`Fallida` / `Completada` → `Solicitada`",{"_3632":74349,"_31224":74183,"_21643":125079,"_5":14891,"_28416":124659,"_3083":125080},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3632":74350,"_31224":74183,"_21643":125082,"_5":14891,"_28416":124663,"_3083":125083},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3632":74351,"_31224":74183,"_21643":125085,"_5":14891,"_28416":124663,"_3083":125086},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3632":74352,"_31224":74183,"_21643":125088,"_5":14891,"_28416":124663,"_3083":125089},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3632":74353,"_31224":74183,"_21643":125091,"_5":14891,"_28416":124663,"_3083":125092},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3632":74354,"_31224":74183,"_21643":125094,"_5":14891,"_28416":124663,"_3083":125095},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3632":74355,"_31224":74183,"_21643":125097,"_5":14891,"_28416":124663,"_3083":125098},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3632":74356,"_31224":74183,"_21643":125100,"_5":14891,"_28416":124666,"_3083":125101},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3632":74357,"_31224":74183,"_21643":125103,"_5":14891,"_28416":124669,"_3083":125104},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3632":74358,"_31224":74183,"_21643":125106,"_5":14891,"_28416":124669,"_3083":125107},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3632":74359,"_31224":74183,"_21643":125109,"_5":14891,"_28416":124673,"_3083":125110},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3632":74360,"_31224":74183,"_21643":125112,"_5":14891,"_28416":124677,"_3083":125113},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3632":74361,"_31224":74183,"_21643":125115,"_5":14891,"_28416":124677,"_3083":125116},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3632":74362,"_31224":74183,"_21643":125118,"_5":14891,"_28416":124677,"_3083":125119},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3632":74363,"_31224":74183,"_21643":125121,"_5":14891,"_28416":124677,"_3083":125122},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3632":74364,"_31224":74183,"_21643":125124,"_5":14891,"_28416":124677,"_3083":125125},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3632":74365,"_31224":74183,"_21643":125127,"_5":14891,"_28416":124677,"_3083":125128},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3632":74366,"_31224":74183,"_21643":125130,"_5":14891,"_28416":124681,"_3083":125131},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3632":74367,"_31224":74183,"_21643":125133,"_5":14891,"_28416":124681,"_3083":125134},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3632":74368,"_31224":74183,"_21643":125136,"_5":14891,"_28416":124681,"_3083":125137},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3632":74369,"_31224":74183,"_21643":125139,"_5":14891,"_28416":124681,"_3083":125140},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3632":74370,"_31224":74183,"_21643":125142,"_5":14891,"_28416":124681,"_3083":125143},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3632":74371,"_31224":74183,"_21643":125145,"_5":14891,"_28416":124685,"_3083":125146},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3632":74372,"_31224":74183,"_21643":125148,"_5":14891,"_28416":124685,"_3083":125047},[],{"_3632":74373,"_31224":74183,"_21643":125150,"_5":14891,"_28416":124685,"_3083":125050},[],{"_3632":74374,"_31224":74183,"_21643":125152,"_5":14891,"_28416":124685,"_3083":125153},[],"`SinConfigurar` → `None` / `Auto`",{"_3632":74375,"_31224":74183,"_21643":125155,"_5":14891,"_28416":124685,"_3083":125156},[],"ninguna (solo configuración)",{"_3632":74376,"_31224":74183,"_21643":125158,"_5":14891,"_28416":124685,"_3083":55772},[],{"_3632":74377,"_31224":74183,"_21643":125160,"_5":14891,"_28416":124685,"_3083":125156},[],{"_3632":74378,"_31224":74183,"_21643":125162,"_5":14891,"_28416":124685,"_3083":125163},[],"Cualquiera → `Jitp`",{"_3632":74379,"_31224":74183,"_21643":125165,"_5":14891,"_28416":124685,"_3083":125166},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3632":74380,"_31224":74183,"_21643":125168,"_5":14891,"_28416":124685,"_3083":55783},[],{"_3632":74381,"_31224":74183,"_21643":125170,"_5":14891,"_28416":124685,"_3083":125171},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3632":74382,"_31224":74183,"_21643":125173,"_5":14891,"_28416":124689,"_3083":125174},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3632":74383,"_31224":74183,"_21643":125176,"_5":14891,"_28416":124689,"_3083":125177},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3632":74384,"_31224":74183,"_21643":125179,"_5":14891,"_28416":124689,"_3083":125180},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3632":74385,"_31224":74183,"_21643":125182,"_5":14891,"_28416":124693,"_3083":125183},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3632":74386,"_31224":74183,"_21643":125185,"_5":14891,"_28416":124693,"_3083":125047},[],{"_3632":74387,"_31224":74183,"_21643":125187,"_5":14891,"_28416":124693,"_3083":125050},[],{"_3632":74388,"_31224":74183,"_21643":125189,"_5":14891,"_28416":124693,"_3083":125190},[],"`Ausente` → `Aprovisionado`",{"_3632":74389,"_31224":74183,"_21643":125192,"_5":14891,"_28416":124693,"_3083":125193},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3632":74390,"_31224":74183,"_21643":125195,"_5":14891,"_28416":124693,"_3083":125196},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3632":74391,"_31224":74183,"_21643":125198,"_5":14891,"_28416":124693,"_3083":125199},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3632":74392,"_31224":74183,"_21643":125201,"_5":14891,"_28416":124693,"_3083":125202},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3632":74393,"_31224":74183,"_21643":125204,"_5":14891,"_28416":124697,"_3083":125205},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3632":74394,"_31224":74183,"_21643":125207,"_5":14891,"_28416":124697,"_3083":125208},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3632":74395,"_31224":74183,"_21643":125210,"_5":14891,"_28416":124697,"_3083":125211},[],"Para que el flujo JITP funcione correctamente:",{"_3632":74396,"_31224":74183,"_21643":125213,"_5":14891,"_28416":124697,"_3083":125214},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3632":74397,"_31224":74183,"_21643":125216,"_5":14891,"_28416":124697,"_3083":125217},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3632":74398,"_31224":74183,"_21643":125219,"_5":14891,"_28416":124697,"_3083":125220},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3632":74399,"_31224":74183,"_21643":125222,"_5":14891,"_28416":124697,"_3083":125223},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3632":74400,"_31224":74183,"_21643":125225,"_5":14891,"_28416":124701,"_3083":125226},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3632":74401,"_31224":74183,"_21643":125228,"_5":14891,"_28416":124701,"_3083":125229},[],"Estado en Lamassu",{"_3632":74402,"_31224":74183,"_21643":125231,"_5":14891,"_28416":124701,"_3083":125232},[],"Razón de revocación",{"_3632":74403,"_31224":74183,"_21643":125234,"_5":14891,"_28416":124701,"_3083":125235},[],"Estado en AWS IoT Core",{"_3632":74404,"_31224":74183,"_21643":125237,"_5":14891,"_28416":124701,"_3083":55853},[],{"_3632":74405,"_31224":74183,"_21643":125239,"_5":14891,"_28416":124701,"_3083":125240},[],"Ninguna",{"_3632":74406,"_31224":74183,"_21643":125242,"_5":14891,"_28416":124701,"_3083":55859},[],{"_3632":74407,"_31224":74183,"_21643":125244,"_5":14891,"_28416":124701,"_3083":55862},[],{"_3632":74408,"_31224":74183,"_21643":125246,"_5":14891,"_28416":124701,"_3083":55865},[],{"_3632":74409,"_31224":74183,"_21643":125248,"_5":14891,"_28416":124701,"_3083":55868},[],{"_3632":74410,"_31224":74183,"_21643":125250,"_5":14891,"_28416":124701,"_3083":55862},[],{"_3632":74411,"_31224":74183,"_21643":125252,"_5":14891,"_28416":124701,"_3083":125253},[],"Cualquier otra razón",{"_3632":74412,"_31224":74183,"_21643":125255,"_5":14891,"_28416":124701,"_3083":55876},[],{"_3632":74413,"_31224":74183,"_21643":125257,"_5":14891,"_28416":124701,"_3083":125258},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3632":74414,"_31224":74183,"_21643":125260,"_5":14891,"_28416":124705,"_3083":125261},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3632":74415,"_31224":74183,"_21643":125263,"_5":14891,"_28416":124705,"_3083":125047},[],{"_3632":74416,"_31224":74183,"_21643":125265,"_5":14891,"_28416":124705,"_3083":125050},[],{"_3632":74417,"_31224":74183,"_21643":125267,"_5":14891,"_28416":124705,"_3083":125268},[],"`NoSincronizado` → `Active`",{"_3632":74418,"_31224":74183,"_21643":125270,"_5":14891,"_28416":124705,"_3083":55368},[],{"_3632":74419,"_31224":74183,"_21643":125272,"_5":14891,"_28416":124705,"_3083":55894},[],{"_3632":74420,"_31224":74183,"_21643":125274,"_5":14891,"_28416":124705,"_3083":125275},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3632":74421,"_31224":74183,"_21643":125277,"_5":14891,"_28416":124705,"_3083":55900},[],{"_3632":74422,"_31224":74183,"_21643":125279,"_5":14891,"_28416":124705,"_3083":125275},[],{"_3632":74423,"_31224":74183,"_21643":125281,"_5":14891,"_28416":124705,"_3083":55905},[],{"_3632":74424,"_31224":74183,"_21643":125283,"_5":14891,"_28416":124705,"_3083":55368},[],{"_3632":74425,"_31224":74183,"_21643":125285,"_5":14891,"_28416":124705,"_3083":55910},[],{"_3632":74426,"_31224":74183,"_21643":125287,"_5":14891,"_28416":124705,"_3083":125288},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3632":74427,"_31224":74183,"_21643":125290,"_5":14891,"_28416":124709,"_3083":125291},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3632":74428,"_31224":74183,"_21643":125293,"_5":14891,"_28416":124709,"_3083":125294},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3632":74429,"_31224":74183,"_21643":125296,"_5":14891,"_28416":124709,"_3083":125297},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3632":74430,"_31224":74183,"_21643":125299,"_5":14891,"_28416":124713,"_3083":125300},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3632":74431,"_31224":74183,"_21643":125302,"_5":14891,"_28416":124713,"_3083":125303},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3632":74432,"_31224":74183,"_21643":125305,"_5":14891,"_28416":124717,"_3083":125306},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3632":74433,"_31224":74183,"_21643":125308,"_5":14891,"_28416":124717,"_3083":125309},[],"Existen dos tipos de acciones:",{"_3632":74434,"_31224":74183,"_21643":125311,"_5":14891,"_28416":124717,"_3083":125312},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3632":74435,"_31224":74183,"_21643":125314,"_5":14891,"_28416":124717,"_3083":125315},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3632":74436,"_31224":74183,"_21643":125317,"_5":14891,"_28416":124717,"_3083":125318},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3632":74437,"_31224":74183,"_21643":125320,"_5":14891,"_28416":124721,"_3083":125321},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3632":74438,"_31224":74183,"_21643":125323,"_5":14891,"_28416":124721,"_3083":125324},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3632":74439,"_31224":74183,"_21643":125326,"_5":14891,"_28416":124721,"_3083":125327},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3632":74440,"_31224":74183,"_21643":125329,"_5":14891,"_28416":124725,"_3083":125330},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3632":74441,"_31224":74183,"_21643":125332,"_5":14891,"_28416":124725,"_3083":125333},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3632":74442,"_31224":74183,"_21643":125335,"_5":14891,"_28416":124725,"_3083":125336},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3632":74443,"_31224":74183,"_21643":125338,"_5":14891,"_28416":124725,"_3083":125339},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3632":74444,"_31224":74183,"_21643":125341,"_5":14891,"_28416":124725,"_3083":125342},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3632":74445,"_31224":74183,"_21643":125344,"_5":14891,"_28416":124725,"_3083":125345},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3632":74446,"_31224":74183,"_21643":125347,"_5":14891,"_28416":124725,"_3083":125348},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3632":74447,"_31224":74183,"_21643":125350,"_5":14891,"_28416":124725,"_3083":125351},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3632":74448,"_31224":74183,"_21643":125353,"_5":14891,"_28416":124725,"_3083":125354},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3632":74449,"_31224":74183,"_21643":125356,"_5":14891,"_28416":124725,"_3083":125357},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3632":74450,"_31224":74183,"_21643":125359,"_5":14891,"_28416":124725,"_3083":125360},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3632":74451,"_31224":74183,"_21643":125362,"_5":14891,"_28416":124725,"_3083":125363},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3632":74452,"_31224":74183,"_21643":125365,"_5":14891,"_28416":124725,"_3083":125366},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3632":74453,"_31224":74183,"_21643":125368,"_5":14891,"_28416":124725,"_3083":125369},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3632":74454,"_31224":74183,"_21643":125371,"_5":14891,"_28416":124725,"_3083":125372},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3632":74455,"_31224":74183,"_21643":125374,"_5":14891,"_28416":124725,"_3083":125375},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3632":74456,"_31224":74183,"_21643":125377,"_5":14891,"_28416":124725,"_3083":125378},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3632":74457,"_31224":74183,"_21643":125380,"_5":14891,"_28416":124725,"_3083":125381},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3632":74458,"_31224":74183,"_21643":125383,"_5":14891,"_28416":124725,"_3083":125384},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3632":74459,"_31224":74183,"_21643":125386,"_5":14891,"_28416":124725,"_3083":125387},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3632":74460,"_31224":74183,"_21643":125389,"_5":14891,"_28416":124725,"_3083":125390},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3632":74461,"_31224":74183,"_21643":125392,"_5":14891,"_28416":124725,"_3083":125393},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":74462,"_31224":74183,"_21643":125395,"_5":14891,"_28416":124725,"_3083":125396},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3632":74463,"_31224":74183,"_21643":125398,"_5":14891,"_28416":124725,"_3083":125399},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3632":74464,"_31224":74464,"_5":15251,"_3083":53720,"_31583":125401,"_21643":125402,"_28416":74464},[51036,122061,53720],[],{"_3632":74465,"_31224":74464,"_21643":125404,"_5":14891,"_28416":74464,"_3083":125405},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3632":74466,"_31224":74464,"_5":31580,"_21643":125407,"_28416":125408,"_3083":125409},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3632":74467,"_31224":74464,"_5":31580,"_21643":125411,"_28416":125412,"_3083":123206},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3632":74468,"_31224":74464,"_5":31580,"_21643":125414,"_28416":125415,"_3083":123384},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3632":74469,"_31224":74464,"_5":31580,"_21643":125417,"_28416":125418,"_3083":124624},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/overview#integraciones",{"_3632":74470,"_31224":74464,"_5":31580,"_21643":125420,"_28416":125421,"_3083":125422},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3632":74471,"_31224":74464,"_21643":125424,"_5":14891,"_28416":74464,"_3083":125425},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3632":74472,"_31224":74464,"_21643":125427,"_5":14891,"_28416":125408,"_3083":125428},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3632":74473,"_31224":74464,"_21643":125430,"_5":14891,"_28416":125408,"_3083":125431},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3632":74474,"_31224":74464,"_21643":125433,"_5":14891,"_28416":125412,"_3083":125434},[],"Recurso",{"_3632":74475,"_31224":74464,"_21643":125436,"_5":14891,"_28416":125412,"_3083":125437},[],"Qué representa",{"_3632":74476,"_31224":74464,"_21643":125439,"_5":14891,"_28416":125412,"_3083":125440},[],"**Dispositivo**",{"_3632":74477,"_31224":74464,"_21643":125442,"_5":14891,"_28416":125412,"_3083":125443},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3632":74478,"_31224":74464,"_21643":125445,"_5":14891,"_28416":125412,"_3083":125446},[],"**Identidad**",{"_3632":74479,"_31224":74464,"_21643":125448,"_5":14891,"_28416":125412,"_3083":125449},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3632":74480,"_31224":74464,"_21643":125451,"_5":14891,"_28416":125412,"_3083":56077},[],{"_3632":74481,"_31224":74464,"_21643":125453,"_5":14891,"_28416":125412,"_3083":125454},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3632":74482,"_31224":74464,"_21643":125456,"_5":14891,"_28416":125412,"_3083":125457},[],"**Flota**",{"_3632":74483,"_31224":74464,"_21643":125459,"_5":14891,"_28416":125412,"_3083":125460},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3632":74484,"_31224":74464,"_21643":125462,"_5":14891,"_28416":125412,"_3083":125463},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3632":74485,"_31224":74464,"_21643":125465,"_5":14891,"_28416":125412,"_3083":125466},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3632":74486,"_31224":74464,"_21643":125468,"_5":14891,"_28416":125415,"_3083":125469},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3632":74487,"_31224":74464,"_21643":125471,"_5":14891,"_28416":125415,"_3083":125472},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3632":74488,"_31224":74464,"_21643":125474,"_5":14891,"_28416":125415,"_3083":125475},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3632":74489,"_31224":74464,"_21643":125477,"_5":14891,"_28416":125415,"_3083":125478},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3632":74490,"_31224":74464,"_21643":125480,"_5":14891,"_28416":125415,"_3083":125481},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3632":74491,"_31224":74464,"_21643":125483,"_5":14891,"_28416":125415,"_3083":125484},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3632":74492,"_31224":74464,"_21643":125486,"_5":14891,"_28416":125415,"_3083":125487},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":74493,"_31224":74464,"_21643":125489,"_5":14891,"_28416":125415,"_3083":125490},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":74494,"_31224":74464,"_21643":125492,"_5":14891,"_28416":125418,"_3083":125493},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3632":74495,"_31224":74464,"_21643":125495,"_5":14891,"_28416":125418,"_3083":125496},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3632":74496,"_31224":74464,"_21643":125498,"_5":14891,"_28416":125421,"_3083":125499},[],"Participante",{"_3632":74497,"_31224":74464,"_21643":125501,"_5":14891,"_28416":125421,"_3083":125502},[],"Responsabilidad",{"_3632":74498,"_31224":74464,"_21643":125504,"_5":14891,"_28416":125421,"_3083":125505},[],"Administrador PKI",{"_3632":74499,"_31224":74464,"_21643":125507,"_5":14891,"_28416":125421,"_3083":125508},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3632":74500,"_31224":74464,"_21643":125510,"_5":14891,"_28416":125421,"_3083":125511},[],"Administrador del aprovisionamiento",{"_3632":74501,"_31224":74464,"_21643":125513,"_5":14891,"_28416":125421,"_3083":125514},[],"DMS, admisión, autenticación por operación e inventario.",{"_3632":74502,"_31224":74464,"_21643":125516,"_5":14891,"_28416":125421,"_3083":125517},[],"Integrador del dispositivo",{"_3632":74503,"_31224":74464,"_21643":125519,"_5":14891,"_28416":125421,"_3083":125520},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3632":74504,"_31224":74464,"_21643":125522,"_5":14891,"_28416":125421,"_3083":125523},[],"Integrador del consumidor",{"_3632":74505,"_31224":74464,"_21643":125525,"_5":14891,"_28416":125421,"_3083":125526},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3632":74506,"_31224":74464,"_21643":125528,"_5":14891,"_28416":125421,"_3083":125529},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3632":74507,"_31224":74507,"_5":15251,"_3083":125531,"_31583":125532,"_21643":125534,"_28416":74507},"Enrola y conecta tu primer dispositivo",[51036,122061,53720,125533],"Primeros pasos",[],{"_3632":74508,"_31224":74507,"_21643":125536,"_5":14891,"_28416":74507,"_3083":125537},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3632":74509,"_31224":74507,"_5":31580,"_21643":125539,"_28416":125540,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3632":74510,"_31224":74507,"_5":31580,"_21643":125542,"_28416":125543,"_3083":125544},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3632":74511,"_31224":74507,"_5":31580,"_21643":125546,"_28416":125547,"_3083":125548},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3632":74512,"_31224":74507,"_5":31580,"_21643":125550,"_28416":125551,"_3083":125552},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3632":74513,"_31224":74507,"_5":31580,"_21643":125554,"_28416":125555,"_3083":125556},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3632":74514,"_31224":74507,"_5":31580,"_21643":125558,"_28416":125559,"_3083":125560},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3632":74515,"_31224":74507,"_5":31580,"_21643":125562,"_28416":125563,"_3083":125564},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3632":74516,"_31224":74507,"_5":31580,"_21643":125566,"_28416":125567,"_3083":125568},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3632":74517,"_31224":74507,"_21643":125570,"_5":14891,"_28416":74507,"_3083":125571},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3632":74518,"_31224":74507,"_21643":125573,"_5":14891,"_28416":125540,"_3083":125574},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3632":74519,"_31224":74507,"_21643":125576,"_5":14891,"_28416":125540,"_3083":125577},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3632":74520,"_31224":74507,"_21643":125579,"_5":14891,"_28416":125540,"_3083":125580},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3632":74521,"_31224":74507,"_21643":125582,"_5":14891,"_28416":125540,"_3083":125583},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3632":74522,"_31224":74507,"_21643":125585,"_5":14891,"_28416":125540,"_3083":125586},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3632":74523,"_31224":74507,"_21643":125588,"_5":14891,"_28416":125543,"_3083":125589},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3632":74524,"_31224":74507,"_21643":125591,"_5":14891,"_28416":125543,"_3083":125592},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3632":74525,"_31224":74507,"_21643":125594,"_5":14891,"_28416":125547,"_3083":125595},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3632":74526,"_31224":74507,"_21643":125597,"_5":14891,"_28416":125547,"_3083":125598},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3632":74527,"_31224":74507,"_21643":125600,"_5":14891,"_28416":125547,"_3083":125601},[],"Ajuste",{"_3632":74528,"_31224":74507,"_21643":125603,"_5":14891,"_28416":125547,"_3083":125604},[],"Valor de evaluación",{"_3632":74529,"_31224":74507,"_21643":125606,"_5":14891,"_28416":125547,"_3083":56233},[],{"_3632":74530,"_31224":74507,"_21643":125608,"_5":14891,"_28416":125547,"_3083":125609},[],"Raíz emisora de `device-root.pem`.",{"_3632":74531,"_31224":74507,"_21643":125611,"_5":14891,"_28416":125547,"_3083":123518},[],{"_3632":74532,"_31224":74507,"_21643":125613,"_5":14891,"_28416":125547,"_3083":125614},[],"Perfil final de 1 hora que acabas de preparar.",{"_3632":74533,"_31224":74507,"_21643":125616,"_5":14891,"_28416":125547,"_3083":56244},[],{"_3632":74534,"_31224":74507,"_21643":125618,"_5":14891,"_28416":125547,"_3083":56247},[],{"_3632":74535,"_31224":74507,"_21643":125620,"_5":14891,"_28416":125547,"_3083":56250},[],{"_3632":74536,"_31224":74507,"_21643":125622,"_5":14891,"_28416":125547,"_3083":125623},[],"Habilitado.",{"_3632":74537,"_31224":74507,"_21643":125625,"_5":14891,"_28416":125547,"_3083":56256},[],{"_3632":74538,"_31224":74507,"_21643":125627,"_5":14891,"_28416":125547,"_3083":125628},[],"Deshabilitado; el ID debe ser nuevo.",{"_3632":74539,"_31224":74507,"_21643":125630,"_5":14891,"_28416":125547,"_3083":125631},[],"Autenticación inicial",{"_3632":74540,"_31224":74507,"_21643":125633,"_5":14891,"_28416":125547,"_3083":125634},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3632":74541,"_31224":74507,"_21643":125636,"_5":14891,"_28416":125547,"_3083":125637},[],"Autenticación de renovación",{"_3632":74542,"_31224":74507,"_21643":125639,"_5":14891,"_28416":125547,"_3083":125640},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3632":74543,"_31224":74507,"_21643":125642,"_5":14891,"_28416":125547,"_3083":56274},[],{"_3632":74544,"_31224":74507,"_21643":125644,"_5":14891,"_28416":125547,"_3083":125645},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3632":74545,"_31224":74507,"_21643":125647,"_5":14891,"_28416":125547,"_3083":56280},[],{"_3632":74546,"_31224":74507,"_21643":125649,"_5":14891,"_28416":125547,"_3083":125650},[],"1 hora.",{"_3632":74547,"_31224":74507,"_21643":125652,"_5":14891,"_28416":125547,"_3083":56286},[],{"_3632":74548,"_31224":74507,"_21643":125654,"_5":14891,"_28416":125547,"_3083":125655},[],"30 minutos / 10 minutos.",{"_3632":74549,"_31224":74507,"_21643":125657,"_5":14891,"_28416":125547,"_3083":56292},[],{"_3632":74550,"_31224":74507,"_21643":125659,"_5":14891,"_28416":125547,"_3083":125660},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3632":74551,"_31224":74507,"_21643":125662,"_5":14891,"_28416":125547,"_3083":54048},[],{"_3632":74552,"_31224":74507,"_21643":125664,"_5":14891,"_28416":125547,"_3083":125665},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3632":74553,"_31224":74507,"_21643":125667,"_5":14891,"_28416":125547,"_3083":56303},[],{"_3632":74554,"_31224":74507,"_21643":125669,"_5":14891,"_28416":125547,"_3083":125670},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3632":74555,"_31224":74507,"_21643":125672,"_5":14891,"_28416":125547,"_3083":125673},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3632":74556,"_31224":74507,"_21643":125675,"_5":14891,"_28416":125551,"_3083":125676},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3632":74557,"_31224":74507,"_21643":125678,"_5":14891,"_28416":125551,"_3083":125679},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3632":74558,"_31224":74507,"_21643":125681,"_5":14891,"_28416":125555,"_3083":125682},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3632":74559,"_31224":74507,"_21643":125684,"_5":14891,"_28416":125555,"_3083":125685},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3632":74560,"_31224":74507,"_21643":125687,"_5":14891,"_28416":125555,"_3083":125688},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3632":74561,"_31224":74507,"_21643":125690,"_5":14891,"_28416":125559,"_3083":125691},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3632":74562,"_31224":74507,"_21643":125693,"_5":14891,"_28416":125559,"_3083":125694},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3632":74563,"_31224":74507,"_21643":125696,"_5":14891,"_28416":125563,"_3083":125697},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3632":74564,"_31224":74507,"_21643":125699,"_5":14891,"_28416":125563,"_3083":125700},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3632":74565,"_31224":74507,"_21643":125702,"_5":14891,"_28416":125563,"_3083":125703},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3632":74566,"_31224":74507,"_21643":125705,"_5":14891,"_28416":125563,"_3083":125706},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3632":74567,"_31224":74507,"_21643":125708,"_5":14891,"_28416":125563,"_3083":125709},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3632":74568,"_31224":74507,"_21643":125711,"_5":14891,"_28416":125567,"_3083":125712},[],"Comprobación",{"_3632":74569,"_31224":74507,"_21643":125714,"_5":14891,"_28416":125567,"_3083":125715},[],"Resultado esperado",{"_3632":74570,"_31224":74507,"_21643":125717,"_5":14891,"_28416":125567,"_3083":125718},[],"Registro",{"_3632":74571,"_31224":74507,"_21643":125720,"_5":14891,"_28416":125567,"_3083":125721},[],"ID creado automáticamente y DMS correcto.",{"_3632":74572,"_31224":74507,"_21643":125723,"_5":14891,"_28416":125567,"_3083":125008},[],{"_3632":74573,"_31224":74507,"_21643":125725,"_5":14891,"_28416":125567,"_3083":125726},[],"CN, perfil, serie y clave verificados.",{"_3632":74574,"_31224":74507,"_21643":125728,"_5":14891,"_28416":125567,"_3083":125729},[],"Inventario",{"_3632":74575,"_31224":74507,"_21643":125731,"_5":14891,"_28416":125567,"_3083":125732},[],"Serie recibida visible como identidad actual y en el historial.",{"_3632":74576,"_31224":74507,"_21643":125734,"_5":14891,"_28416":125567,"_3083":125735},[],"Consumidor",{"_3632":74577,"_31224":74507,"_21643":125737,"_5":14891,"_28416":125567,"_3083":125738},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3632":74578,"_31224":74507,"_21643":125740,"_5":14891,"_28416":125567,"_3083":125741},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3632":74579,"_31224":74507,"_21643":125743,"_5":14891,"_28416":125567,"_3083":125744},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3632":74580,"_31224":74580,"_5":15251,"_3083":123223,"_31583":125746,"_21643":125747,"_28416":74580},[51036,122061,53720,125533],[],{"_3632":74581,"_31224":74580,"_21643":125749,"_5":14891,"_28416":74580,"_3083":125750},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3632":74582,"_31224":74580,"_5":31580,"_21643":125752,"_28416":125753,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3632":74583,"_31224":74580,"_5":31580,"_21643":125755,"_28416":125756,"_3083":125757},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3632":74584,"_31224":74580,"_5":31580,"_21643":125759,"_28416":125760,"_3083":125761},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3632":74585,"_31224":74580,"_5":31580,"_21643":125763,"_28416":125764,"_3083":125765},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3632":74586,"_31224":74580,"_5":31580,"_21643":125767,"_28416":125768,"_3083":125769},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3632":74587,"_31224":74580,"_5":31580,"_21643":125771,"_28416":125772,"_3083":125773},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3632":74588,"_31224":74580,"_5":31580,"_21643":125775,"_28416":125776,"_3083":125715},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3632":74589,"_31224":74580,"_5":31580,"_21643":125778,"_28416":125779,"_3083":125780},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3632":74590,"_31224":74580,"_5":31580,"_21643":125782,"_28416":125783,"_3083":125784},[],"/docs/pr-preview/pr-82/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3632":74591,"_31224":74580,"_21643":125786,"_5":14891,"_28416":74580,"_3083":125787},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3632":74592,"_31224":74580,"_21643":125789,"_5":14891,"_28416":74580,"_3083":125790},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3632":74593,"_31224":74580,"_21643":125792,"_5":14891,"_28416":125753,"_3083":125793},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3632":74594,"_31224":74580,"_21643":125795,"_5":14891,"_28416":125753,"_3083":125796},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3632":74595,"_31224":74580,"_21643":125798,"_5":14891,"_28416":125753,"_3083":125799},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3632":74596,"_31224":74580,"_21643":125801,"_5":14891,"_28416":125753,"_3083":125802},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3632":74597,"_31224":74580,"_21643":125804,"_5":14891,"_28416":125756,"_3083":125805},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3632":74598,"_31224":74580,"_21643":125807,"_5":14891,"_28416":125756,"_3083":125808},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3632":74599,"_31224":74580,"_21643":125810,"_5":14891,"_28416":125756,"_3083":125811},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3632":74600,"_31224":74580,"_21643":125813,"_5":14891,"_28416":125756,"_3083":125814},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3632":74601,"_31224":74580,"_21643":125816,"_5":14891,"_28416":125756,"_3083":125817},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3632":74602,"_31224":74580,"_21643":125819,"_5":14891,"_28416":125756,"_3083":125820},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3632":74603,"_31224":74580,"_21643":125822,"_5":14891,"_28416":125756,"_3083":125823},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3632":74604,"_31224":74580,"_21643":125825,"_5":14891,"_28416":125756,"_3083":125826},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3632":74605,"_31224":74580,"_21643":125828,"_5":14891,"_28416":125760,"_3083":125829},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3632":74606,"_31224":74580,"_21643":125831,"_5":14891,"_28416":125760,"_3083":56468},[],{"_3632":74607,"_31224":74580,"_21643":125833,"_5":14891,"_28416":125760,"_3083":125834},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3632":74608,"_31224":74580,"_21643":125836,"_5":14891,"_28416":125760,"_3083":125837},[],"**Icon** y **Tags**: clasificación opcional.",{"_3632":74609,"_31224":74580,"_21643":125839,"_5":14891,"_28416":125760,"_3083":125840},[],"Confirma el registro.",{"_3632":74610,"_31224":74580,"_21643":125842,"_5":14891,"_28416":125764,"_3083":125843},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3632":74611,"_31224":74580,"_21643":125845,"_5":14891,"_28416":125764,"_3083":125846},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3632":74612,"_31224":74580,"_21643":125848,"_5":14891,"_28416":125768,"_3083":125849},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3632":74613,"_31224":74580,"_21643":125851,"_5":14891,"_28416":125768,"_3083":125852},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3632":74614,"_31224":74580,"_21643":125854,"_5":14891,"_28416":125772,"_3083":125855},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3632":74615,"_31224":74580,"_21643":125857,"_5":14891,"_28416":125772,"_3083":125858},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3632":74616,"_31224":74580,"_21643":125860,"_5":14891,"_28416":125776,"_3083":125712},[],{"_3632":74617,"_31224":74580,"_21643":125862,"_5":14891,"_28416":125776,"_3083":125863},[],"Resultado",{"_3632":74618,"_31224":74580,"_21643":125865,"_5":14891,"_28416":125776,"_3083":124994},[],{"_3632":74619,"_31224":74580,"_21643":125867,"_5":14891,"_28416":125776,"_3083":125868},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3632":74620,"_31224":74580,"_21643":125870,"_5":14891,"_28416":125776,"_3083":125871},[],"Identidad actual",{"_3632":74621,"_31224":74580,"_21643":125873,"_5":14891,"_28416":125776,"_3083":125874},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3632":74622,"_31224":74580,"_21643":125876,"_5":14891,"_28416":125776,"_3083":125877},[],"Historial",{"_3632":74623,"_31224":74580,"_21643":125879,"_5":14891,"_28416":125776,"_3083":125880},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3632":74624,"_31224":74580,"_21643":125882,"_5":14891,"_28416":125776,"_3083":125883},[],"Clave y certificado",{"_3632":74625,"_31224":74580,"_21643":125885,"_5":14891,"_28416":125776,"_3083":125886},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3632":74626,"_31224":74580,"_21643":125888,"_5":14891,"_28416":125779,"_3083":125889},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3632":74627,"_31224":74580,"_21643":125891,"_5":14891,"_28416":125779,"_3083":125892},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3632":74628,"_31224":74580,"_21643":125894,"_5":14891,"_28416":125779,"_3083":125895},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3632":74629,"_31224":74580,"_21643":125897,"_5":14891,"_28416":125779,"_3083":125898},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3632":74630,"_31224":74580,"_21643":125900,"_5":14891,"_28416":125783,"_3083":125901},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3632":74631,"_31224":74580,"_21643":125903,"_5":14891,"_28416":125783,"_3083":125904},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3632":74632,"_31224":74580,"_21643":125906,"_5":14891,"_28416":125783,"_3083":125907},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3632":74633,"_31224":74633,"_5":15251,"_3083":125909,"_31583":125910,"_21643":125911,"_28416":74633},"Plataforma Lamassu IoT",[51036,122061],[],{"_3632":74634,"_31224":74633,"_21643":125913,"_5":14891,"_28416":74633,"_3083":125914},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3632":74635,"_31224":74633,"_5":31580,"_21643":125916,"_28416":125917,"_3083":125409},[],"/docs/pr-preview/pr-82/es/platform/overview#empieza-aquí",{"_3632":74636,"_31224":74633,"_5":31580,"_21643":125919,"_28416":125920,"_3083":125921},[],"/docs/pr-preview/pr-82/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3632":74637,"_31224":74633,"_5":31580,"_21643":125923,"_28416":125924,"_3083":125925},[],"/docs/pr-preview/pr-82/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3632":74638,"_31224":74633,"_5":31580,"_21643":125927,"_28416":125928,"_3083":125929},[],"/docs/pr-preview/pr-82/es/platform/overview#capacidades-principales","Capacidades principales",{"_3632":74639,"_31224":74633,"_5":31580,"_21643":125931,"_28416":125932,"_3083":125933},[],"/docs/pr-preview/pr-82/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3632":74640,"_31224":74633,"_5":31580,"_21643":125935,"_28416":125936,"_3083":125937},[],"/docs/pr-preview/pr-82/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3632":74641,"_31224":74633,"_5":31580,"_21643":125939,"_28416":125940,"_3083":125941},[],"/docs/pr-preview/pr-82/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3632":74642,"_31224":74633,"_5":31580,"_21643":125943,"_28416":125944,"_3083":125945},[],"/docs/pr-preview/pr-82/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3632":74643,"_31224":74633,"_5":31580,"_21643":125947,"_28416":125948,"_3083":125949},[],"/docs/pr-preview/pr-82/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3632":74644,"_31224":74633,"_5":31580,"_21643":125951,"_28416":125952,"_3083":125953},[],"/docs/pr-preview/pr-82/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3632":74645,"_31224":74633,"_5":31580,"_21643":125955,"_28416":125956,"_3083":125957},[],"/docs/pr-preview/pr-82/es/platform/overview#referencia-operativa","Referencia operativa",{"_3632":74646,"_31224":74633,"_21643":125959,"_5":14891,"_28416":74633,"_3083":125960},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3632":74647,"_31224":74633,"_21643":125962,"_5":14891,"_28416":125917,"_3083":125963},[],"Elige el resultado que necesitas obtener:",{"_3632":74648,"_31224":74633,"_21643":125965,"_5":14891,"_28416":125917,"_3083":125966},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":74649,"_31224":74633,"_21643":125968,"_5":14891,"_28416":125917,"_3083":125969},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":74650,"_31224":74633,"_21643":125971,"_5":14891,"_28416":125917,"_3083":125972},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3632":74651,"_31224":74633,"_21643":125974,"_5":14891,"_28416":125920,"_3083":125975},[],"Bloque",{"_3632":74652,"_31224":74633,"_21643":125977,"_5":14891,"_28416":125920,"_3083":125978},[],"Qué gestionas",{"_3632":74653,"_31224":74633,"_21643":125980,"_5":14891,"_28416":125920,"_3083":125981},[],"Punto de entrada",{"_3632":74654,"_31224":74633,"_21643":125983,"_5":14891,"_28416":125920,"_3083":56621},[],{"_3632":74655,"_31224":74633,"_21643":125985,"_5":14891,"_28416":125920,"_3083":125986},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3632":74656,"_31224":74633,"_21643":125988,"_5":14891,"_28416":125920,"_3083":125989},[],"Visión general de PKI",{"_3632":74657,"_31224":74633,"_21643":125991,"_5":14891,"_28416":125920,"_3083":56630},[],{"_3632":74658,"_31224":74633,"_21643":125993,"_5":14891,"_28416":125920,"_3083":125994},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3632":74659,"_31224":74633,"_21643":125996,"_5":14891,"_28416":125920,"_3083":125997},[],"Visión general de IoT Fleets",{"_3632":74660,"_31224":74633,"_21643":125999,"_5":14891,"_28416":125920,"_3083":126000},[],"**Administración**",{"_3632":74661,"_31224":74633,"_21643":126002,"_5":14891,"_28416":125920,"_3083":126003},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3632":74662,"_31224":74633,"_21643":126005,"_5":14891,"_28416":125920,"_3083":122063},[],{"_3632":74663,"_31224":74633,"_21643":126007,"_5":14891,"_28416":125920,"_3083":126008},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3632":74664,"_31224":74633,"_21643":126010,"_5":14891,"_28416":125924,"_3083":126011},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3632":74665,"_31224":74633,"_21643":126013,"_5":14891,"_28416":125924,"_3083":126014},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3632":74666,"_31224":74633,"_21643":126016,"_5":14891,"_28416":125924,"_3083":126017},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3632":74667,"_31224":74633,"_21643":126019,"_5":14891,"_28416":125924,"_3083":126020},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3632":74668,"_31224":74633,"_21643":126022,"_5":14891,"_28416":125924,"_3083":126023},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3632":74669,"_31224":74633,"_21643":126025,"_5":14891,"_28416":125924,"_3083":126026},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3632":74670,"_31224":74633,"_21643":126028,"_5":14891,"_28416":125932,"_3083":126029},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3632":74671,"_31224":74633,"_21643":126031,"_5":14891,"_28416":125936,"_3083":126032},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3632":74672,"_31224":74633,"_21643":126034,"_5":14891,"_28416":125940,"_3083":126035},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3632":74673,"_31224":74633,"_21643":126037,"_5":14891,"_28416":125944,"_3083":126038},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3632":74674,"_31224":74633,"_21643":126040,"_5":14891,"_28416":125948,"_3083":126041},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3632":74675,"_31224":74633,"_21643":126043,"_5":14891,"_28416":125952,"_3083":126044},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3632":74676,"_31224":74633,"_21643":126046,"_5":14891,"_28416":125956,"_3083":125502},[],{"_3632":74677,"_31224":74633,"_21643":126048,"_5":14891,"_28416":125956,"_3083":126049},[],"Qué prepara o comprueba",{"_3632":74678,"_31224":74633,"_21643":126051,"_5":14891,"_28416":125956,"_3083":125505},[],{"_3632":74679,"_31224":74633,"_21643":126053,"_5":14891,"_28416":125956,"_3083":126054},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3632":74680,"_31224":74633,"_21643":126056,"_5":14891,"_28416":125956,"_3083":126057},[],"Administrador de la flota",{"_3632":74681,"_31224":74633,"_21643":126059,"_5":14891,"_28416":125956,"_3083":126060},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3632":74682,"_31224":74633,"_21643":126062,"_5":14891,"_28416":125956,"_3083":125517},[],{"_3632":74683,"_31224":74633,"_21643":126064,"_5":14891,"_28416":125956,"_3083":126065},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3632":74684,"_31224":74633,"_21643":126067,"_5":14891,"_28416":125956,"_3083":125523},[],{"_3632":74685,"_31224":74633,"_21643":126069,"_5":14891,"_28416":125956,"_3083":126070},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3632":74686,"_31224":74633,"_21643":126072,"_5":14891,"_28416":125956,"_3083":126073},[],"Operador de infraestructura",{"_3632":74687,"_31224":74633,"_21643":126075,"_5":14891,"_28416":125956,"_3083":126076},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3632":74688,"_31224":74633,"_21643":126078,"_5":14891,"_28416":125956,"_3083":126079},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3632":74689,"_31224":74689,"_5":15251,"_3083":126081,"_31583":126082,"_21643":126084,"_28416":74689},"Jerarquía y rotación de CAs",[51036,122061,56722,126083],"Claves, autoridades y certificados",[],{"_3632":74690,"_31224":74689,"_21643":126086,"_5":14891,"_28416":74689,"_3083":126087},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3632":74691,"_31224":74689,"_5":31580,"_21643":126089,"_28416":126090,"_3083":126091},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3632":74692,"_31224":74689,"_5":31580,"_21643":126093,"_28416":126094,"_3083":126095},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3632":74693,"_31224":74689,"_5":31580,"_21643":126097,"_28416":126098,"_3083":126099},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3632":74694,"_31224":74689,"_5":31580,"_21643":126101,"_28416":126102,"_3083":126103},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3632":74695,"_31224":74689,"_5":31580,"_21643":126105,"_28416":126106,"_3083":126107},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3632":74696,"_31224":74689,"_5":31580,"_21643":126109,"_28416":126110,"_3083":126111},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3632":74697,"_31224":74689,"_5":31580,"_21643":126113,"_28416":126114,"_3083":126115},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3632":74698,"_31224":74689,"_5":31580,"_21643":126117,"_28416":126118,"_3083":126119},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3632":74699,"_31224":74689,"_5":31580,"_21643":126121,"_28416":126122,"_3083":126123},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3632":74700,"_31224":74689,"_5":31580,"_21643":126125,"_28416":126126,"_3083":126127},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3632":74701,"_31224":74689,"_5":31580,"_21643":126129,"_28416":126130,"_3083":126131},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3632":74702,"_31224":74689,"_5":31580,"_21643":126133,"_28416":126134,"_3083":126135},[],"/docs/pr-preview/pr-82/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3632":74703,"_31224":74689,"_21643":126137,"_5":14891,"_28416":74689,"_3083":126138},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3632":74704,"_31224":74689,"_21643":126140,"_5":14891,"_28416":74689,"_3083":126141},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3632":74705,"_31224":74689,"_21643":126143,"_5":14891,"_28416":126090,"_3083":126144},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3632":74706,"_31224":74689,"_21643":126146,"_5":14891,"_28416":126090,"_3083":126147},[],"entorno, como producción y preproducción;",{"_3632":74707,"_31224":74689,"_21643":126149,"_5":14891,"_28416":126090,"_3083":126150},[],"propietario o equipo operador;",{"_3632":74708,"_31224":74689,"_21643":126152,"_5":14891,"_28416":126090,"_3083":126153},[],"familia de dispositivos o proceso de fabricación;",{"_3632":74709,"_31224":74689,"_21643":126155,"_5":14891,"_28416":126090,"_3083":126156},[],"región o requisito regulatorio;",{"_3632":74710,"_31224":74689,"_21643":126158,"_5":14891,"_28416":126090,"_3083":126159},[],"motor criptográfico o política de clave;",{"_3632":74711,"_31224":74689,"_21643":126161,"_5":14891,"_28416":126090,"_3083":126162},[],"ventana de mantenimiento y ritmo de renovación.",{"_3632":74712,"_31224":74689,"_21643":126164,"_5":14891,"_28416":126090,"_3083":126165},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3632":74713,"_31224":74689,"_21643":126167,"_5":14891,"_28416":126090,"_3083":126168},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3632":74714,"_31224":74689,"_21643":126170,"_5":14891,"_28416":126094,"_3083":126171},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3632":74715,"_31224":74689,"_21643":126173,"_5":14891,"_28416":126094,"_3083":126174},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3632":74716,"_31224":74689,"_21643":126176,"_5":14891,"_28416":126094,"_3083":126177},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3632":74717,"_31224":74689,"_21643":126179,"_5":14891,"_28416":126094,"_3083":126180},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3632":74718,"_31224":74689,"_21643":126182,"_5":14891,"_28416":126098,"_3083":126183},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3632":74719,"_31224":74689,"_21643":126185,"_5":14891,"_28416":126098,"_3083":126186},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3632":74720,"_31224":74689,"_21643":126188,"_5":14891,"_28416":126098,"_3083":126189},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3632":74721,"_31224":74689,"_21643":126191,"_5":14891,"_28416":126098,"_3083":126192},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3632":74722,"_31224":74689,"_21643":126194,"_5":14891,"_28416":126106,"_3083":126195},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3632":74723,"_31224":74689,"_21643":126197,"_5":14891,"_28416":126110,"_3083":126198},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3632":74724,"_31224":74689,"_21643":126200,"_5":14891,"_28416":126114,"_3083":126201},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3632":74725,"_31224":74689,"_21643":126203,"_5":14891,"_28416":126118,"_3083":126204},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3632":74726,"_31224":74689,"_21643":126206,"_5":14891,"_28416":126122,"_3083":126207},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3632":74727,"_31224":74689,"_21643":126209,"_5":14891,"_28416":126126,"_3083":126210},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3632":74728,"_31224":74689,"_21643":126212,"_5":14891,"_28416":126130,"_3083":126213},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3632":74729,"_31224":74689,"_21643":126215,"_5":14891,"_28416":126130,"_3083":126216},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3632":74730,"_31224":74689,"_21643":126218,"_5":14891,"_28416":126130,"_3083":126219},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3632":74731,"_31224":74689,"_21643":126221,"_5":14891,"_28416":126130,"_3083":126222},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3632":74732,"_31224":74689,"_21643":126224,"_5":14891,"_28416":126134,"_3083":126225},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3632":74733,"_31224":74689,"_21643":126227,"_5":14891,"_28416":126134,"_3083":126228},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3632":74734,"_31224":74689,"_21643":126230,"_5":14891,"_28416":126134,"_3083":126231},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3632":74735,"_31224":74689,"_21643":126233,"_5":14891,"_28416":126134,"_3083":126234},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3632":74736,"_31224":74689,"_21643":126236,"_5":14891,"_28416":126134,"_3083":126237},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3632":74737,"_31224":74689,"_21643":126239,"_5":14891,"_28416":126134,"_3083":126240},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3632":74738,"_31224":74689,"_21643":126242,"_5":14891,"_28416":126134,"_3083":126243},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3632":74739,"_31224":74739,"_5":15251,"_3083":126245,"_31583":126246,"_21643":126247,"_28416":74739},"Autoridades de certificación",[51036,122061,56722,126083],[],{"_3632":74740,"_31224":74739,"_21643":126249,"_5":14891,"_28416":74739,"_3083":126250},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3632":74741,"_31224":74739,"_5":31580,"_21643":126252,"_28416":126253,"_3083":126254},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3632":74742,"_31224":74739,"_5":31580,"_21643":126256,"_28416":126257,"_3083":126258},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3632":74743,"_31224":74739,"_5":31580,"_21643":126260,"_28416":126261,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3632":74744,"_31224":74739,"_5":31580,"_21643":126263,"_28416":126264,"_3083":126265},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3632":74745,"_31224":74739,"_5":31580,"_21643":126267,"_28416":126268,"_3083":126269},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3632":74746,"_31224":74739,"_5":31580,"_21643":126271,"_28416":126272,"_3083":126273},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3632":74747,"_31224":74739,"_5":31580,"_21643":126275,"_28416":126276,"_3083":126277},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3632":74748,"_31224":74739,"_5":31580,"_21643":126279,"_28416":126280,"_3083":126281},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3632":74749,"_31224":74739,"_5":31580,"_21643":126283,"_28416":126284,"_3083":126285},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3632":74750,"_31224":74739,"_5":31580,"_21643":126287,"_28416":126288,"_3083":126289},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3632":74751,"_31224":74739,"_5":31580,"_21643":126291,"_28416":126292,"_3083":126293},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3632":74752,"_31224":74739,"_5":31580,"_21643":126295,"_28416":126296,"_3083":126297},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3632":74753,"_31224":74739,"_5":31580,"_21643":126299,"_28416":126300,"_3083":126301},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3632":74754,"_31224":74739,"_5":31580,"_21643":126303,"_28416":126304,"_3083":126305},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3632":74755,"_31224":74739,"_5":31580,"_21643":126307,"_28416":126308,"_3083":126309},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3632":74756,"_31224":74739,"_5":31580,"_21643":126311,"_28416":126312,"_3083":126313},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3632":74757,"_31224":74739,"_5":31580,"_21643":126315,"_28416":126316,"_3083":126317},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3632":74758,"_31224":74739,"_5":31580,"_21643":126319,"_28416":126320,"_3083":126321},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3632":74759,"_31224":74739,"_5":31580,"_21643":126323,"_28416":126324,"_3083":126325},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3632":74760,"_31224":74739,"_5":31580,"_21643":126327,"_28416":126328,"_3083":126329},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3632":74761,"_31224":74739,"_5":31580,"_21643":126331,"_28416":126332,"_3083":126333},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3632":74762,"_31224":74739,"_5":31580,"_21643":126335,"_28416":126336,"_3083":126337},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3632":74763,"_31224":74739,"_5":31580,"_21643":126339,"_28416":126340,"_3083":126341},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3632":74764,"_31224":74739,"_5":31580,"_21643":126343,"_28416":126344,"_3083":126345},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3632":74765,"_31224":74739,"_21643":126347,"_5":14891,"_28416":74739,"_3083":126348},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3632":74766,"_31224":74739,"_21643":126350,"_5":14891,"_28416":74739,"_3083":126351},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3632":74767,"_31224":74739,"_21643":126353,"_5":14891,"_28416":74739,"_3083":126354},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3632":74768,"_31224":74739,"_21643":126356,"_5":14891,"_28416":126253,"_3083":126357},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3632":74769,"_31224":74739,"_21643":126359,"_5":14891,"_28416":126253,"_3083":126360},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3632":74770,"_31224":74739,"_21643":126362,"_5":14891,"_28416":126253,"_3083":126363},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3632":74771,"_31224":74739,"_21643":126365,"_5":14891,"_28416":126253,"_3083":126366},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3632":74772,"_31224":74739,"_21643":126368,"_5":14891,"_28416":126253,"_3083":126369},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3632":74773,"_31224":74739,"_21643":126371,"_5":14891,"_28416":126261,"_3083":126372},[],"Decide si la CA será raíz o intermedia.",{"_3632":74774,"_31224":74739,"_21643":126374,"_5":14891,"_28416":126261,"_3083":126375},[],"Elige el motor que custodiará la clave.",{"_3632":74775,"_31224":74739,"_21643":126377,"_5":14891,"_28416":126261,"_3083":126378},[],"Define una validez superior a la de los certificados que emitirá.",{"_3632":74776,"_31224":74739,"_21643":126380,"_5":14891,"_28416":126261,"_3083":126381},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3632":74777,"_31224":74739,"_21643":126383,"_5":14891,"_28416":126264,"_3083":126384},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3632":74778,"_31224":74739,"_21643":126386,"_5":14891,"_28416":126268,"_3083":126387},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3632":74779,"_31224":74739,"_21643":126389,"_5":14891,"_28416":126268,"_3083":126390},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3632":74780,"_31224":74739,"_21643":126392,"_5":14891,"_28416":126272,"_3083":126393},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3632":74781,"_31224":74739,"_21643":126395,"_5":14891,"_28416":126276,"_3083":126396},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3632":74782,"_31224":74739,"_21643":126398,"_5":14891,"_28416":126276,"_3083":126399},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3632":74783,"_31224":74739,"_21643":126401,"_5":14891,"_28416":126276,"_3083":126402},[],"`ST`: estado o provincia.",{"_3632":74784,"_31224":74739,"_21643":126404,"_5":14891,"_28416":126276,"_3083":126405},[],"`L`: localidad.",{"_3632":74785,"_31224":74739,"_21643":126407,"_5":14891,"_28416":126276,"_3083":126408},[],"`O`: organización.",{"_3632":74786,"_31224":74739,"_21643":126410,"_5":14891,"_28416":126276,"_3083":126411},[],"`OU`: unidad organizativa.",{"_3632":74787,"_31224":74739,"_21643":126413,"_5":14891,"_28416":126276,"_3083":126414},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3632":74788,"_31224":74739,"_21643":126416,"_5":14891,"_28416":126280,"_3083":126417},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3632":74789,"_31224":74739,"_21643":126419,"_5":14891,"_28416":126280,"_3083":126420},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3632":74790,"_31224":74739,"_21643":126422,"_5":14891,"_28416":126284,"_3083":126423},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3632":74791,"_31224":74739,"_21643":126425,"_5":14891,"_28416":126284,"_3083":126426},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3632":74792,"_31224":74739,"_21643":126428,"_5":14891,"_28416":126288,"_3083":126429},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3632":74793,"_31224":74739,"_21643":126431,"_5":14891,"_28416":126288,"_3083":126432},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3632":74794,"_31224":74739,"_21643":126434,"_5":14891,"_28416":126292,"_3083":126435},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3632":74795,"_31224":74739,"_21643":126437,"_5":14891,"_28416":126292,"_3083":126438},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3632":74796,"_31224":74739,"_21643":126440,"_5":14891,"_28416":126292,"_3083":126441},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3632":74797,"_31224":74739,"_21643":126443,"_5":14891,"_28416":126292,"_3083":126444},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3632":74798,"_31224":74739,"_21643":126446,"_5":14891,"_28416":126296,"_3083":126447},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3632":74799,"_31224":74739,"_21643":126449,"_5":14891,"_28416":126300,"_3083":126450},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3632":74800,"_31224":74739,"_21643":126452,"_5":14891,"_28416":126300,"_3083":126453},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3632":74801,"_31224":74739,"_21643":126455,"_5":14891,"_28416":126304,"_3083":126456},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3632":74802,"_31224":74739,"_21643":126458,"_5":14891,"_28416":126308,"_3083":126459},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3632":74803,"_31224":74739,"_21643":126461,"_5":14891,"_28416":126308,"_3083":126462},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3632":74804,"_31224":74739,"_21643":126464,"_5":14891,"_28416":126308,"_3083":126465},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3632":74805,"_31224":74739,"_21643":126467,"_5":14891,"_28416":126312,"_3083":126468},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3632":74806,"_31224":74739,"_21643":126470,"_5":14891,"_28416":126312,"_3083":126471},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3632":74807,"_31224":74739,"_21643":126473,"_5":14891,"_28416":126312,"_3083":126474},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3632":74808,"_31224":74739,"_21643":126476,"_5":14891,"_28416":126312,"_3083":126477},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3632":74809,"_31224":74739,"_21643":126479,"_5":14891,"_28416":126316,"_3083":126480},[],"Abre una CA desde el inventario para consultar:",{"_3632":74810,"_31224":74739,"_21643":126482,"_5":14891,"_28416":126316,"_3083":126483},[],"Estado y periodo de validez.",{"_3632":74811,"_31224":74739,"_21643":126485,"_5":14891,"_28416":126316,"_3083":126486},[],"Certificado y cadena en formato PEM.",{"_3632":74812,"_31224":74739,"_21643":126488,"_5":14891,"_28416":126316,"_3083":126489},[],"Número de certificados activos, expirados y revocados.",{"_3632":74813,"_31224":74739,"_21643":126491,"_5":14891,"_28416":126316,"_3083":126492},[],"Certificados emitidos en **Issued Certificates**.",{"_3632":74814,"_31224":74739,"_21643":126494,"_5":14891,"_28416":126316,"_3083":126495},[],"CRL vinculada a la autoridad.",{"_3632":74815,"_31224":74739,"_21643":126497,"_5":14891,"_28416":126316,"_3083":126498},[],"Metadatos y motor criptográfico asociado.",{"_3632":74816,"_31224":74739,"_21643":126500,"_5":14891,"_28416":126316,"_3083":126501},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3632":74817,"_31224":74739,"_21643":126503,"_5":14891,"_28416":126320,"_3083":126504},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3632":74818,"_31224":74739,"_21643":126506,"_5":14891,"_28416":126320,"_3083":126507},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3632":74819,"_31224":74739,"_21643":126509,"_5":14891,"_28416":126320,"_3083":126510},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3632":74820,"_31224":74739,"_21643":126512,"_5":14891,"_28416":126320,"_3083":126513},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3632":74821,"_31224":74739,"_21643":126515,"_5":14891,"_28416":126320,"_3083":126516},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3632":74822,"_31224":74739,"_21643":126518,"_5":14891,"_28416":126320,"_3083":126519},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3632":74823,"_31224":74739,"_21643":126521,"_5":14891,"_28416":126324,"_3083":126522},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3632":74824,"_31224":74739,"_21643":126524,"_5":14891,"_28416":126328,"_3083":126525},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3632":74825,"_31224":74739,"_21643":126527,"_5":14891,"_28416":126332,"_3083":126528},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3632":74826,"_31224":74739,"_21643":126530,"_5":14891,"_28416":126336,"_3083":126531},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3632":74827,"_31224":74739,"_21643":126533,"_5":14891,"_28416":126340,"_3083":126534},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3632":74828,"_31224":74739,"_21643":126536,"_5":14891,"_28416":126344,"_3083":126537},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3632":74829,"_31224":74739,"_21643":126539,"_5":14891,"_28416":126344,"_3083":126540},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3632":74830,"_31224":74739,"_21643":126542,"_5":14891,"_28416":126344,"_3083":126543},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3632":74831,"_31224":74739,"_21643":126545,"_5":14891,"_28416":126344,"_3083":126546},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3632":74832,"_31224":74739,"_21643":126548,"_5":14891,"_28416":126344,"_3083":126549},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3632":74833,"_31224":74833,"_5":15251,"_3083":126551,"_31583":126552,"_21643":126553,"_28416":74833},"Perfiles de certificado",[51036,122061,56722,126083],[],{"_3632":74834,"_31224":74833,"_21643":126555,"_5":14891,"_28416":74833,"_3083":126556},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3632":74835,"_31224":74833,"_5":31580,"_21643":126558,"_28416":126559,"_3083":126560},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3632":74836,"_31224":74833,"_5":31580,"_21643":126562,"_28416":126563,"_3083":126564},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#validez","Validez",{"_3632":74837,"_31224":74833,"_5":31580,"_21643":126566,"_28416":126567,"_3083":126568},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3632":74838,"_31224":74833,"_5":31580,"_21643":126570,"_28416":126571,"_3083":126572},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3632":74839,"_31224":74833,"_5":31580,"_21643":126574,"_28416":126575,"_3083":126576},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3632":74840,"_31224":74833,"_5":31580,"_21643":126578,"_28416":126579,"_3083":126580},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3632":74841,"_31224":74833,"_5":31580,"_21643":126582,"_28416":126583,"_3083":126584},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3632":74842,"_31224":74833,"_5":31580,"_21643":126586,"_28416":126587,"_3083":126588},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3632":74843,"_31224":74833,"_5":31580,"_21643":126590,"_28416":126591,"_3083":126592},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3632":74844,"_31224":74833,"_5":31580,"_21643":126594,"_28416":126595,"_3083":126596},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3632":74845,"_31224":74833,"_5":31580,"_21643":126598,"_28416":126599,"_3083":126600},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3632":74846,"_31224":74833,"_5":31580,"_21643":126602,"_28416":126603,"_3083":126604},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3632":74847,"_31224":74833,"_5":31580,"_21643":126606,"_28416":126607,"_3083":126608},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3632":74848,"_31224":74833,"_5":31580,"_21643":126610,"_28416":126611,"_3083":126612},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3632":74849,"_31224":74833,"_5":31580,"_21643":126614,"_28416":126615,"_3083":126616},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3632":74850,"_31224":74833,"_5":31580,"_21643":126618,"_28416":126619,"_3083":126620},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3632":74851,"_31224":74833,"_21643":126622,"_5":14891,"_28416":74833,"_3083":126623},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3632":74852,"_31224":74833,"_21643":126625,"_5":14891,"_28416":74833,"_3083":126626},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3632":74853,"_31224":74833,"_21643":126628,"_5":14891,"_28416":126563,"_3083":126629},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3632":74854,"_31224":74833,"_21643":126631,"_5":14891,"_28416":126563,"_3083":126632},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3632":74855,"_31224":74833,"_21643":126634,"_5":14891,"_28416":126567,"_3083":126635},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3632":74856,"_31224":74833,"_21643":126637,"_5":14891,"_28416":126571,"_3083":126638},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3632":74857,"_31224":74833,"_21643":126640,"_5":14891,"_28416":126571,"_3083":126641},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3632":74858,"_31224":74833,"_21643":126643,"_5":14891,"_28416":126571,"_3083":126644},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3632":74859,"_31224":74833,"_21643":126646,"_5":14891,"_28416":126575,"_3083":126647},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3632":74860,"_31224":74833,"_21643":126649,"_5":14891,"_28416":126579,"_3083":126650},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3632":74861,"_31224":74833,"_21643":126652,"_5":14891,"_28416":126579,"_3083":126653},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3632":74862,"_31224":74833,"_21643":126655,"_5":14891,"_28416":126583,"_3083":126656},[],"La aplicación criptográfica puede:",{"_3632":74863,"_31224":74833,"_21643":126658,"_5":14891,"_28416":126583,"_3083":126659},[],"permitir o bloquear claves RSA;",{"_3632":74864,"_31224":74833,"_21643":126661,"_5":14891,"_28416":126583,"_3083":126662},[],"limitar los tamaños RSA admitidos;",{"_3632":74865,"_31224":74833,"_21643":126664,"_5":14891,"_28416":126583,"_3083":126665},[],"permitir o bloquear claves ECDSA;",{"_3632":74866,"_31224":74833,"_21643":126667,"_5":14891,"_28416":126583,"_3083":126668},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3632":74867,"_31224":74833,"_21643":126670,"_5":14891,"_28416":126583,"_3083":126671},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3632":74868,"_31224":74833,"_21643":126673,"_5":14891,"_28416":126587,"_3083":126674},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3632":74869,"_31224":74833,"_21643":126676,"_5":14891,"_28416":126587,"_3083":121821},[],{"_3632":74870,"_31224":74833,"_21643":126678,"_5":14891,"_28416":126587,"_3083":126679},[],"Primera opción",{"_3632":74871,"_31224":74833,"_21643":126681,"_5":14891,"_28416":126587,"_3083":126682},[],"Segunda opción",{"_3632":74872,"_31224":74833,"_21643":126684,"_5":14891,"_28416":126587,"_3083":126685},[],"Si no hay ninguna",{"_3632":74873,"_31224":74833,"_21643":126687,"_5":14891,"_28416":126587,"_3083":126688},[],"Firma directa con una CA",{"_3632":74874,"_31224":74833,"_21643":126690,"_5":14891,"_28416":126587,"_3083":126691},[],"`issuance_profile` incluido en la solicitud",{"_3632":74875,"_31224":74833,"_21643":126693,"_5":14891,"_28416":126587,"_3083":126694},[],"`issuance_profile_id` de la solicitud",{"_3632":74876,"_31224":74833,"_21643":126696,"_5":14891,"_28416":126587,"_3083":126697},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3632":74877,"_31224":74833,"_21643":126699,"_5":14891,"_28416":126587,"_3083":126700},[],"Emisión mediante DMS",{"_3632":74878,"_31224":74833,"_21643":126702,"_5":14891,"_28416":126587,"_3083":57343},[],{"_3632":74879,"_31224":74833,"_21643":126704,"_5":14891,"_28416":126587,"_3083":126705},[],"`settings.issuance_profile` incluido en el DMS",{"_3632":74880,"_31224":74833,"_21643":126707,"_5":14891,"_28416":126587,"_3083":126708},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3632":74881,"_31224":74833,"_21643":126710,"_5":14891,"_28416":126587,"_3083":126711},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3632":74882,"_31224":74833,"_21643":126713,"_5":14891,"_28416":126587,"_3083":126714},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3632":74883,"_31224":74833,"_21643":126716,"_5":14891,"_28416":126595,"_3083":126717},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3632":74884,"_31224":74833,"_21643":126719,"_5":14891,"_28416":126599,"_3083":126720},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3632":74885,"_31224":74833,"_21643":126722,"_5":14891,"_28416":126603,"_3083":126723},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3632":74886,"_31224":74833,"_21643":126725,"_5":14891,"_28416":126607,"_3083":126726},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3632":74887,"_31224":74833,"_21643":126728,"_5":14891,"_28416":126611,"_3083":126729},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3632":74888,"_31224":74833,"_21643":126731,"_5":14891,"_28416":126611,"_3083":126732},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3632":74889,"_31224":74833,"_21643":126734,"_5":14891,"_28416":126615,"_3083":126735},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3632":74890,"_31224":74833,"_21643":126737,"_5":14891,"_28416":126615,"_3083":126738},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3632":74891,"_31224":74833,"_21643":126740,"_5":14891,"_28416":126615,"_3083":126741},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3632":74892,"_31224":74833,"_21643":126743,"_5":14891,"_28416":126615,"_3083":126744},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3632":74893,"_31224":74833,"_21643":126746,"_5":14891,"_28416":126619,"_3083":126747},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3632":74894,"_31224":74833,"_21643":126749,"_5":14891,"_28416":126619,"_3083":126750},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3632":74895,"_31224":74895,"_5":15251,"_3083":126752,"_31583":126753,"_21643":126755,"_28416":74895},"Validación de certificados",[51036,122061,56722,126754],"Validación",[],{"_3632":74896,"_31224":74895,"_21643":126757,"_5":14891,"_28416":74895,"_3083":126758},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3632":74897,"_31224":74895,"_5":31580,"_21643":126760,"_28416":126761,"_3083":126762},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3632":74898,"_31224":74895,"_5":31580,"_21643":126764,"_28416":126765,"_3083":126766},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3632":74899,"_31224":74895,"_5":31580,"_21643":126768,"_28416":126769,"_3083":126770},[],"/docs/pr-preview/pr-82/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3632":74900,"_31224":74895,"_21643":126772,"_5":14891,"_28416":74895,"_3083":126773},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3632":74901,"_31224":74895,"_21643":126775,"_5":14891,"_28416":126761,"_3083":126776},[],"Verifica estos criterios juntos:",{"_3632":74902,"_31224":74895,"_21643":126778,"_5":14891,"_28416":126761,"_3083":125712},[],{"_3632":74903,"_31224":74895,"_21643":126780,"_5":14891,"_28416":126761,"_3083":126781},[],"Resultado necesario",{"_3632":74904,"_31224":74895,"_21643":126783,"_5":14891,"_28416":126761,"_3083":126784},[],"Cadena y firma",{"_3632":74905,"_31224":74895,"_21643":126786,"_5":14891,"_28416":126761,"_3083":126787},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3632":74906,"_31224":74895,"_21643":126789,"_5":14891,"_28416":126761,"_3083":126790},[],"Fechas",{"_3632":74907,"_31224":74895,"_21643":126792,"_5":14891,"_28416":126761,"_3083":126793},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3632":74908,"_31224":74895,"_21643":126795,"_5":14891,"_28416":126761,"_3083":121731},[],{"_3632":74909,"_31224":74895,"_21643":126797,"_5":14891,"_28416":126761,"_3083":126798},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3632":74910,"_31224":74895,"_21643":126800,"_5":14891,"_28416":126761,"_3083":126801},[],"Uso",{"_3632":74911,"_31224":74895,"_21643":126803,"_5":14891,"_28416":126761,"_3083":126804},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3632":74912,"_31224":74895,"_21643":126806,"_5":14891,"_28416":126761,"_3083":126807},[],"Revocación",{"_3632":74913,"_31224":74895,"_21643":126809,"_5":14891,"_28416":126761,"_3083":126810},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3632":74914,"_31224":74895,"_21643":126812,"_5":14891,"_28416":126761,"_3083":126813},[],"Autorización",{"_3632":74915,"_31224":74895,"_21643":126815,"_5":14891,"_28416":126761,"_3083":126816},[],"La aplicación permite la acción a esa identidad.",{"_3632":74916,"_31224":74895,"_21643":126818,"_5":14891,"_28416":126761,"_3083":126819},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3632":74917,"_31224":74895,"_21643":126821,"_5":14891,"_28416":126765,"_3083":126822},[],"Mecanismo",{"_3632":74918,"_31224":74895,"_21643":126824,"_5":14891,"_28416":126765,"_3083":126825},[],"Cuándo utilizarlo",{"_3632":74919,"_31224":74895,"_21643":126827,"_5":14891,"_28416":126765,"_3083":126828},[],"Qué debes mantener",{"_3632":74920,"_31224":74895,"_21643":126830,"_5":14891,"_28416":126765,"_3083":57471},[],{"_3632":74921,"_31224":74895,"_21643":126832,"_5":14891,"_28416":126765,"_3083":126833},[],"Consulta del estado de un certificado concreto.",{"_3632":74922,"_31224":74895,"_21643":126835,"_5":14891,"_28416":126765,"_3083":126836},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3632":74923,"_31224":74895,"_21643":126838,"_5":14891,"_28416":126765,"_3083":57480},[],{"_3632":74924,"_31224":74895,"_21643":126840,"_5":14891,"_28416":126765,"_3083":126841},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3632":74925,"_31224":74895,"_21643":126843,"_5":14891,"_28416":126765,"_3083":126844},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3632":74926,"_31224":74895,"_21643":126846,"_5":14891,"_28416":126765,"_3083":126847},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3632":74927,"_31224":74895,"_21643":126849,"_5":14891,"_28416":126765,"_3083":126850},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3632":74928,"_31224":74895,"_21643":126852,"_5":14891,"_28416":126769,"_3083":126853},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3632":74929,"_31224":74895,"_21643":126855,"_5":14891,"_28416":126769,"_3083":126856},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3632":74930,"_31224":74895,"_21643":126858,"_5":14891,"_28416":126769,"_3083":126859},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3632":74931,"_31224":74895,"_21643":126861,"_5":14891,"_28416":126769,"_3083":126862},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3632":74932,"_31224":74895,"_21643":126864,"_5":14891,"_28416":126769,"_3083":126865},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3632":74933,"_31224":74895,"_21643":126867,"_5":14891,"_28416":126769,"_3083":126868},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3632":74934,"_31224":74895,"_21643":126870,"_5":14891,"_28416":126769,"_3083":126871},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3632":74935,"_31224":74895,"_21643":126873,"_5":14891,"_28416":126769,"_3083":126874},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":74936,"_31224":74895,"_21643":126876,"_5":14891,"_28416":126769,"_3083":126877},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3632":74937,"_31224":74937,"_5":15251,"_3083":126879,"_31583":126880,"_21643":126881,"_28416":74937},"Certificados",[51036,122061,56722,126083],[],{"_3632":74938,"_31224":74937,"_21643":126883,"_5":14891,"_28416":74937,"_3083":126884},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3632":74939,"_31224":74937,"_5":31580,"_21643":126886,"_28416":126887,"_3083":126888},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3632":74940,"_31224":74937,"_5":31580,"_21643":126890,"_28416":126891,"_3083":126892},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3632":74941,"_31224":74937,"_5":31580,"_21643":126894,"_28416":126895,"_3083":126896},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3632":74942,"_31224":74937,"_5":31580,"_21643":126898,"_28416":126899,"_3083":126900},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3632":74943,"_31224":74937,"_5":31580,"_21643":126902,"_28416":126903,"_3083":126904},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3632":74944,"_31224":74937,"_5":31580,"_21643":126906,"_28416":126907,"_3083":126908},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3632":74945,"_31224":74937,"_5":31580,"_21643":126910,"_28416":126911,"_3083":126912},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3632":74946,"_31224":74937,"_5":31580,"_21643":126914,"_28416":126915,"_3083":126916},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3632":74947,"_31224":74937,"_5":31580,"_21643":126918,"_28416":126919,"_3083":126920},[],"/docs/pr-preview/pr-82/es/platform/pki/certificates#continúa","Continúa",{"_3632":74948,"_31224":74937,"_21643":126922,"_5":14891,"_28416":74937,"_3083":126923},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3632":74949,"_31224":74937,"_21643":126925,"_5":14891,"_28416":126887,"_3083":126926},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3632":74950,"_31224":74937,"_21643":126928,"_5":14891,"_28416":126887,"_3083":126929},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3632":74951,"_31224":74937,"_21643":126931,"_5":14891,"_28416":126887,"_3083":126932},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3632":74952,"_31224":74937,"_21643":126934,"_5":14891,"_28416":126887,"_3083":126935},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3632":74953,"_31224":74937,"_21643":126937,"_5":14891,"_28416":126887,"_3083":126938},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3632":74954,"_31224":74937,"_21643":126940,"_5":14891,"_28416":126887,"_3083":126941},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3632":74955,"_31224":74937,"_21643":126943,"_5":14891,"_28416":126887,"_3083":126944},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3632":74956,"_31224":74937,"_21643":126946,"_5":14891,"_28416":126891,"_3083":126947},[],"Descarga el PEM e inspecciónalo:",{"_3632":74957,"_31224":74937,"_21643":126949,"_5":14891,"_28416":126891,"_3083":126950},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3632":74958,"_31224":74937,"_21643":126952,"_5":14891,"_28416":126895,"_3083":126953},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3632":74959,"_31224":74937,"_21643":126955,"_5":14891,"_28416":126895,"_3083":126956},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3632":74960,"_31224":74937,"_21643":126958,"_5":14891,"_28416":126895,"_3083":126959},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3632":74961,"_31224":74937,"_21643":126961,"_5":14891,"_28416":126895,"_3083":126962},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3632":74962,"_31224":74937,"_21643":126964,"_5":14891,"_28416":126895,"_3083":126965},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3632":74963,"_31224":74937,"_21643":126967,"_5":14891,"_28416":126895,"_3083":126968},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3632":74964,"_31224":74937,"_21643":126970,"_5":14891,"_28416":126895,"_3083":126971},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3632":74965,"_31224":74937,"_21643":126973,"_5":14891,"_28416":126899,"_3083":126974},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3632":74966,"_31224":74937,"_21643":126976,"_5":14891,"_28416":126903,"_3083":126977},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3632":74967,"_31224":74937,"_21643":126979,"_5":14891,"_28416":126907,"_3083":126980},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3632":74968,"_31224":74937,"_21643":126982,"_5":14891,"_28416":126911,"_3083":126983},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3632":74969,"_31224":74937,"_21643":126985,"_5":14891,"_28416":126911,"_3083":126986},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3632":74970,"_31224":74937,"_21643":126988,"_5":14891,"_28416":126911,"_3083":126989},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3632":74971,"_31224":74937,"_21643":126991,"_5":14891,"_28416":126915,"_3083":126992},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3632":74972,"_31224":74937,"_21643":126994,"_5":14891,"_28416":126915,"_3083":126995},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3632":74973,"_31224":74937,"_21643":126997,"_5":14891,"_28416":126915,"_3083":126998},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3632":74974,"_31224":74937,"_21643":127000,"_5":14891,"_28416":126919,"_3083":127001},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":74975,"_31224":74937,"_21643":127003,"_5":14891,"_28416":126919,"_3083":127004},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3632":74976,"_31224":74976,"_5":15251,"_3083":127006,"_31583":127007,"_21643":127009,"_28416":74976},"Ciclo de vida de un certificado",[51036,122061,56722,127008],"Conceptos",[],{"_3632":74977,"_31224":74976,"_21643":127011,"_5":14891,"_28416":74976,"_3083":127012},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3632":74978,"_31224":74976,"_5":31580,"_21643":127014,"_28416":127015,"_3083":127016},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3632":74979,"_31224":74976,"_5":31580,"_21643":127018,"_28416":127019,"_3083":127020},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3632":74980,"_31224":74976,"_5":31580,"_21643":127022,"_28416":127023,"_3083":127024},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3632":74981,"_31224":74976,"_5":31580,"_21643":127026,"_28416":127027,"_3083":127028},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3632":74982,"_31224":74976,"_5":31580,"_21643":127030,"_28416":127031,"_3083":127032},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3632":74983,"_31224":74976,"_5":31580,"_21643":127034,"_28416":127035,"_3083":127036},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3632":74984,"_31224":74976,"_5":31580,"_21643":127038,"_28416":127039,"_3083":124706},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3632":74985,"_31224":74976,"_5":31580,"_21643":127041,"_28416":127042,"_3083":127043},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3632":74986,"_31224":74976,"_5":31580,"_21643":127045,"_28416":127046,"_3083":127047},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3632":74987,"_31224":74976,"_5":31580,"_21643":127049,"_28416":127050,"_3083":127051},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3632":74988,"_31224":74976,"_21643":127053,"_5":14891,"_28416":74976,"_3083":127054},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3632":74989,"_31224":74976,"_21643":127056,"_5":14891,"_28416":127019,"_3083":127057},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3632":74990,"_31224":74976,"_21643":127059,"_5":14891,"_28416":127023,"_3083":127060},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3632":74991,"_31224":74976,"_21643":127062,"_5":14891,"_28416":127027,"_3083":127063},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3632":74992,"_31224":74976,"_21643":127065,"_5":14891,"_28416":127031,"_3083":127066},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3632":74993,"_31224":74976,"_21643":127068,"_5":14891,"_28416":127035,"_3083":127069},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3632":74994,"_31224":74976,"_21643":127071,"_5":14891,"_28416":127039,"_3083":127072},[],"Lamassu persiste cuatro estados X.509:",{"_3632":74995,"_31224":74976,"_21643":127074,"_5":14891,"_28416":127039,"_3083":127075},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3632":74996,"_31224":74976,"_21643":127077,"_5":14891,"_28416":127039,"_3083":127078},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3632":74997,"_31224":74976,"_21643":127080,"_5":14891,"_28416":127039,"_3083":127081},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3632":74998,"_31224":74976,"_21643":127083,"_5":14891,"_28416":127039,"_3083":127084},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3632":74999,"_31224":74976,"_21643":127086,"_5":14891,"_28416":127039,"_3083":127087},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3632":75000,"_31224":74976,"_21643":127089,"_5":14891,"_28416":127042,"_3083":127090},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3632":75001,"_31224":74976,"_21643":127092,"_5":14891,"_28416":127042,"_3083":127093},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3632":75002,"_31224":74976,"_21643":127095,"_5":14891,"_28416":127042,"_3083":127096},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3632":75003,"_31224":74976,"_21643":127098,"_5":14891,"_28416":127046,"_3083":127099},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3632":75004,"_31224":74976,"_21643":127101,"_5":14891,"_28416":127046,"_3083":127102},[],"Antes de confirmar:",{"_3632":75005,"_31224":74976,"_21643":127104,"_5":14891,"_28416":127046,"_3083":127105},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3632":75006,"_31224":74976,"_21643":127107,"_5":14891,"_28416":127046,"_3083":127108},[],"Distribuye la nueva cadena de confianza.",{"_3632":75007,"_31224":74976,"_21643":127110,"_5":14891,"_28416":127046,"_3083":127111},[],"Reemite las identidades necesarias.",{"_3632":75008,"_31224":74976,"_21643":127113,"_5":14891,"_28416":127046,"_3083":127114},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3632":75009,"_31224":74976,"_21643":127116,"_5":14891,"_28416":127046,"_3083":127117},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3632":75010,"_31224":74976,"_21643":127119,"_5":14891,"_28416":127046,"_3083":127120},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3632":75011,"_31224":74976,"_21643":127122,"_5":14891,"_28416":127050,"_3083":127123},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3632":75012,"_31224":74976,"_21643":127125,"_5":14891,"_28416":127050,"_3083":127126},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3632":75013,"_31224":74976,"_21643":127128,"_5":14891,"_28416":127050,"_3083":127129},[],"Cambios de estado y razones de revocación.",{"_3632":75014,"_31224":74976,"_21643":127131,"_5":14891,"_28416":127050,"_3083":127132},[],"Publicación y vigencia de OCSP y CRLs.",{"_3632":75015,"_31224":74976,"_21643":127134,"_5":14891,"_28416":127050,"_3083":127135},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3632":75016,"_31224":74976,"_21643":127137,"_5":14891,"_28416":127050,"_3083":127138},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3632":75017,"_31224":75017,"_5":15251,"_3083":127140,"_31583":127141,"_21643":127142,"_28416":75017},"Modelo de confianza",[51036,122061,56722,127008],[],{"_3632":75018,"_31224":75017,"_21643":127144,"_5":14891,"_28416":75017,"_3083":127145},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3632":75019,"_31224":75017,"_5":31580,"_21643":127147,"_28416":127148,"_3083":127149},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3632":75020,"_31224":75017,"_5":31580,"_21643":127151,"_28416":127152,"_3083":127153},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3632":75021,"_31224":75017,"_5":31580,"_21643":127155,"_28416":127156,"_3083":127157},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3632":75022,"_31224":75017,"_5":31580,"_21643":127159,"_28416":127160,"_3083":127161},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3632":75023,"_31224":75017,"_5":31580,"_21643":127163,"_28416":127164,"_3083":127165},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3632":75024,"_31224":75017,"_5":31580,"_21643":127167,"_28416":127168,"_3083":127169},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3632":75025,"_31224":75017,"_5":31580,"_21643":127171,"_28416":127172,"_3083":127173},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3632":75026,"_31224":75017,"_5":31580,"_21643":127175,"_28416":127176,"_3083":127177},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3632":75027,"_31224":75017,"_5":31580,"_21643":127179,"_28416":127180,"_3083":127181},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3632":75028,"_31224":75017,"_5":31580,"_21643":127183,"_28416":127184,"_3083":127185},[],"/docs/pr-preview/pr-82/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3632":75029,"_31224":75017,"_21643":127187,"_5":14891,"_28416":75017,"_3083":127188},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3632":75030,"_31224":75017,"_21643":127190,"_5":14891,"_28416":127152,"_3083":127191},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3632":75031,"_31224":75017,"_21643":127193,"_5":14891,"_28416":127156,"_3083":127194},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3632":75032,"_31224":75017,"_21643":127196,"_5":14891,"_28416":127160,"_3083":127197},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3632":75033,"_31224":75017,"_21643":127199,"_5":14891,"_28416":127164,"_3083":127200},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3632":75034,"_31224":75017,"_21643":127202,"_5":14891,"_28416":127168,"_3083":127203},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3632":75035,"_31224":75017,"_21643":127205,"_5":14891,"_28416":127168,"_3083":127206},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3632":75036,"_31224":75017,"_21643":127208,"_5":14891,"_28416":127168,"_3083":127209},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3632":75037,"_31224":75017,"_21643":127211,"_5":14891,"_28416":127168,"_3083":127212},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3632":75038,"_31224":75017,"_21643":127214,"_5":14891,"_28416":127168,"_3083":127215},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3632":75039,"_31224":75017,"_21643":127217,"_5":14891,"_28416":127168,"_3083":127218},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3632":75040,"_31224":75017,"_21643":127220,"_5":14891,"_28416":127172,"_3083":127221},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3632":75041,"_31224":75017,"_21643":127223,"_5":14891,"_28416":127172,"_3083":127224},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3632":75042,"_31224":75017,"_21643":127226,"_5":14891,"_28416":127172,"_3083":127227},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3632":75043,"_31224":75017,"_21643":127229,"_5":14891,"_28416":127172,"_3083":127230},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3632":75044,"_31224":75017,"_21643":127232,"_5":14891,"_28416":127172,"_3083":127233},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3632":75045,"_31224":75017,"_21643":127235,"_5":14891,"_28416":127176,"_3083":127236},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3632":75046,"_31224":75017,"_21643":127238,"_5":14891,"_28416":127176,"_3083":127239},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3632":75047,"_31224":75017,"_21643":127241,"_5":14891,"_28416":127176,"_3083":127242},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3632":75048,"_31224":75017,"_21643":127244,"_5":14891,"_28416":127176,"_3083":127245},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3632":75049,"_31224":75017,"_21643":127247,"_5":14891,"_28416":127176,"_3083":127248},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3632":75050,"_31224":75017,"_21643":127250,"_5":14891,"_28416":127176,"_3083":127251},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3632":75051,"_31224":75017,"_21643":127253,"_5":14891,"_28416":127176,"_3083":127254},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3632":75052,"_31224":75017,"_21643":127256,"_5":14891,"_28416":127180,"_3083":127257},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3632":75053,"_31224":75017,"_21643":127259,"_5":14891,"_28416":127184,"_3083":127260},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3632":75054,"_31224":75017,"_21643":127262,"_5":14891,"_28416":127184,"_3083":127263},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3632":75055,"_31224":75017,"_21643":127265,"_5":14891,"_28416":127184,"_3083":127266},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3632":75056,"_31224":75017,"_21643":127268,"_5":14891,"_28416":127184,"_3083":127269},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3632":75057,"_31224":75017,"_21643":127271,"_5":14891,"_28416":127184,"_3083":127272},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3632":75058,"_31224":75017,"_21643":127274,"_5":14891,"_28416":127184,"_3083":127275},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3632":75059,"_31224":75017,"_21643":127277,"_5":14891,"_28416":127184,"_3083":127278},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3632":75060,"_31224":75060,"_5":15251,"_3083":127280,"_31583":127281,"_21643":127282,"_28416":75060},"Listas de revocación (CRL)",[51036,122061,56722,126754],[],{"_3632":75061,"_31224":75060,"_21643":127284,"_5":14891,"_28416":75060,"_3083":127285},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3632":75062,"_31224":75060,"_5":31580,"_21643":127287,"_28416":127288,"_3083":127289},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3632":75063,"_31224":75060,"_5":31580,"_21643":127291,"_28416":127292,"_3083":127293},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3632":75064,"_31224":75060,"_5":31580,"_21643":127295,"_28416":127296,"_3083":127297},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3632":75065,"_31224":75060,"_5":31580,"_21643":127299,"_28416":127300,"_3083":127301},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3632":75066,"_31224":75060,"_5":31580,"_21643":127303,"_28416":127304,"_3083":127305},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3632":75067,"_31224":75060,"_5":31580,"_21643":127307,"_28416":127308,"_3083":127309},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3632":75068,"_31224":75060,"_5":31580,"_21643":127311,"_28416":127312,"_3083":127313},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3632":75069,"_31224":75060,"_5":31580,"_21643":127315,"_28416":127316,"_3083":127317},[],"/docs/pr-preview/pr-82/es/platform/pki/crl#referencias","Referencias",{"_3632":75070,"_31224":75060,"_21643":127319,"_5":14891,"_28416":75060,"_3083":127320},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3632":75071,"_31224":75060,"_21643":127322,"_5":14891,"_28416":127288,"_3083":127323},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3632":75072,"_31224":75060,"_21643":127325,"_5":14891,"_28416":127288,"_3083":127326},[],"Campo",{"_3632":75073,"_31224":75060,"_21643":127328,"_5":14891,"_28416":127288,"_3083":123747},[],{"_3632":75074,"_31224":75060,"_21643":127330,"_5":14891,"_28416":127288,"_3083":52668},[],{"_3632":75075,"_31224":75060,"_21643":127332,"_5":14891,"_28416":127288,"_3083":127333},[],"ID de la CA a la que pertenecen los ajustes.",{"_3632":75076,"_31224":75060,"_21643":127335,"_5":14891,"_28416":127288,"_3083":57979},[],{"_3632":75077,"_31224":75060,"_21643":127337,"_5":14891,"_28416":127288,"_3083":127338},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3632":75078,"_31224":75060,"_21643":127340,"_5":14891,"_28416":127288,"_3083":57985},[],{"_3632":75079,"_31224":75060,"_21643":127342,"_5":14891,"_28416":127288,"_3083":127343},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3632":75080,"_31224":75060,"_21643":127345,"_5":14891,"_28416":127288,"_3083":57991},[],{"_3632":75081,"_31224":75060,"_21643":127347,"_5":14891,"_28416":127288,"_3083":127348},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3632":75082,"_31224":75060,"_21643":127350,"_5":14891,"_28416":127288,"_3083":127351},[],"Campo de `crl_options`",{"_3632":75083,"_31224":75060,"_21643":127353,"_5":14891,"_28416":127288,"_3083":123747},[],{"_3632":75084,"_31224":75060,"_21643":127355,"_5":14891,"_28416":127288,"_3083":127356},[],"Valor inicial",{"_3632":75085,"_31224":75060,"_21643":127358,"_5":14891,"_28416":127288,"_3083":58005},[],{"_3632":75086,"_31224":75060,"_21643":127360,"_5":14891,"_28416":127288,"_3083":127361},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3632":75087,"_31224":75060,"_21643":127363,"_5":14891,"_28416":127288,"_3083":127364},[],"7 días.",{"_3632":75088,"_31224":75060,"_21643":127366,"_5":14891,"_28416":127288,"_3083":58014},[],{"_3632":75089,"_31224":75060,"_21643":127368,"_5":14891,"_28416":127288,"_3083":127369},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3632":75090,"_31224":75060,"_21643":127371,"_5":14891,"_28416":127288,"_3083":127372},[],"6 días y 23 horas.",{"_3632":75091,"_31224":75060,"_21643":127374,"_5":14891,"_28416":127288,"_3083":58023},[],{"_3632":75092,"_31224":75060,"_21643":127376,"_5":14891,"_28416":127288,"_3083":127377},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3632":75093,"_31224":75060,"_21643":127379,"_5":14891,"_28416":127288,"_3083":58029},[],{"_3632":75094,"_31224":75060,"_21643":127381,"_5":14891,"_28416":127288,"_3083":58032},[],{"_3632":75095,"_31224":75060,"_21643":127383,"_5":14891,"_28416":127288,"_3083":127384},[],"Número de serie del certificado existente que firma la CRL.",{"_3632":75096,"_31224":75060,"_21643":127386,"_5":14891,"_28416":127288,"_3083":127387},[],"Número de serie del certificado actual de la CA.",{"_3632":75097,"_31224":75060,"_21643":127389,"_5":14891,"_28416":127288,"_3083":127390},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3632":75098,"_31224":75060,"_21643":127392,"_5":14891,"_28416":127288,"_3083":127393},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3632":75099,"_31224":75060,"_21643":127395,"_5":14891,"_28416":127288,"_3083":127396},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3632":75100,"_31224":75060,"_21643":127398,"_5":14891,"_28416":127288,"_3083":127399},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3632":75101,"_31224":75060,"_21643":127401,"_5":14891,"_28416":127288,"_3083":127402},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3632":75102,"_31224":75060,"_21643":127404,"_5":14891,"_28416":127288,"_3083":127405},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3632":75103,"_31224":75060,"_21643":127407,"_5":14891,"_28416":127288,"_3083":127408},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3632":75104,"_31224":75060,"_21643":127410,"_5":14891,"_28416":127288,"_3083":127411},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3632":75105,"_31224":75060,"_21643":127413,"_5":14891,"_28416":127288,"_3083":127414},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3632":75106,"_31224":75060,"_21643":127416,"_5":14891,"_28416":127288,"_3083":127417},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3632":75107,"_31224":75060,"_21643":127419,"_5":14891,"_28416":127288,"_3083":127420},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3632":75108,"_31224":75060,"_21643":127422,"_5":14891,"_28416":127292,"_3083":127423},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3632":75109,"_31224":75060,"_21643":127425,"_5":14891,"_28416":127292,"_3083":127426},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3632":75110,"_31224":75060,"_21643":127428,"_5":14891,"_28416":127292,"_3083":127429},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3632":75111,"_31224":75060,"_21643":127431,"_5":14891,"_28416":127292,"_3083":127432},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3632":75112,"_31224":75060,"_21643":127434,"_5":14891,"_28416":127296,"_3083":127435},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3632":75113,"_31224":75060,"_21643":127437,"_5":14891,"_28416":127296,"_3083":127438},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3632":75114,"_31224":75060,"_21643":127440,"_5":14891,"_28416":127296,"_3083":127441},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3632":75115,"_31224":75060,"_21643":127443,"_5":14891,"_28416":127296,"_3083":127444},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3632":75116,"_31224":75060,"_21643":127446,"_5":14891,"_28416":127296,"_3083":127447},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3632":75117,"_31224":75060,"_21643":127449,"_5":14891,"_28416":127296,"_3083":127450},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3632":75118,"_31224":75060,"_21643":127452,"_5":14891,"_28416":127296,"_3083":127453},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3632":75119,"_31224":75060,"_21643":127455,"_5":14891,"_28416":127296,"_3083":127456},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3632":75120,"_31224":75060,"_21643":127458,"_5":14891,"_28416":127296,"_3083":127459},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3632":75121,"_31224":75060,"_21643":127461,"_5":14891,"_28416":127300,"_3083":127462},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3632":75122,"_31224":75060,"_21643":127464,"_5":14891,"_28416":127300,"_3083":127465},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3632":75123,"_31224":75060,"_21643":127467,"_5":14891,"_28416":127304,"_3083":127468},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3632":75124,"_31224":75060,"_21643":127470,"_5":14891,"_28416":127304,"_3083":127471},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3632":75125,"_31224":75060,"_21643":127473,"_5":14891,"_28416":127304,"_3083":127474},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3632":75126,"_31224":75060,"_21643":127476,"_5":14891,"_28416":127304,"_3083":127477},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3632":75127,"_31224":75060,"_21643":127479,"_5":14891,"_28416":127304,"_3083":127480},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3632":75128,"_31224":75060,"_21643":127482,"_5":14891,"_28416":127308,"_3083":127483},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3632":75129,"_31224":75060,"_21643":127485,"_5":14891,"_28416":127308,"_3083":123936},[],{"_3632":75130,"_31224":75060,"_21643":127487,"_5":14891,"_28416":127308,"_3083":127488},[],"Path relativo",{"_3632":75131,"_31224":75060,"_21643":127490,"_5":14891,"_28416":127308,"_3083":121821},[],{"_3632":75132,"_31224":75060,"_21643":127492,"_5":14891,"_28416":127308,"_3083":58144},[],{"_3632":75133,"_31224":75060,"_21643":127494,"_5":14891,"_28416":127308,"_3083":58147},[],{"_3632":75134,"_31224":75060,"_21643":127496,"_5":14891,"_28416":127308,"_3083":127497},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3632":75135,"_31224":75060,"_21643":127499,"_5":14891,"_28416":127308,"_3083":58144},[],{"_3632":75136,"_31224":75060,"_21643":127501,"_5":14891,"_28416":127308,"_3083":58155},[],{"_3632":75137,"_31224":75060,"_21643":127503,"_5":14891,"_28416":127308,"_3083":127504},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3632":75138,"_31224":75060,"_21643":127506,"_5":14891,"_28416":127308,"_3083":58161},[],{"_3632":75139,"_31224":75060,"_21643":127508,"_5":14891,"_28416":127308,"_3083":58155},[],{"_3632":75140,"_31224":75060,"_21643":127510,"_5":14891,"_28416":127308,"_3083":127511},[],"Sustituir la configuración de CRL de una CA.",{"_3632":75141,"_31224":75060,"_21643":127513,"_5":14891,"_28416":127308,"_3083":58169},[],{"_3632":75142,"_31224":75060,"_21643":127515,"_5":14891,"_28416":127308,"_3083":58155},[],{"_3632":75143,"_31224":75060,"_21643":127517,"_5":14891,"_28416":127308,"_3083":127518},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3632":75144,"_31224":75060,"_21643":127520,"_5":14891,"_28416":127308,"_3083":127521},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3632":75145,"_31224":75060,"_21643":127523,"_5":14891,"_28416":127308,"_3083":127524},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3632":75146,"_31224":75060,"_21643":127526,"_5":14891,"_28416":127308,"_3083":127527},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3632":75147,"_31224":75060,"_21643":127529,"_5":14891,"_28416":127312,"_3083":127530},[],"Síntoma",{"_3632":75148,"_31224":75060,"_21643":127532,"_5":14891,"_28416":127312,"_3083":127533},[],"Causa",{"_3632":75149,"_31224":75060,"_21643":127535,"_5":14891,"_28416":127312,"_3083":127536},[],"Acción",{"_3632":75150,"_31224":75060,"_21643":127538,"_5":14891,"_28416":127312,"_3083":127539},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3632":75151,"_31224":75060,"_21643":127541,"_5":14891,"_28416":127312,"_3083":127542},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3632":75152,"_31224":75060,"_21643":127544,"_5":14891,"_28416":127312,"_3083":127545},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3632":75153,"_31224":75060,"_21643":127547,"_5":14891,"_28416":127312,"_3083":127548},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3632":75154,"_31224":75060,"_21643":127550,"_5":14891,"_28416":127312,"_3083":127551},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3632":75155,"_31224":75060,"_21643":127553,"_5":14891,"_28416":127312,"_3083":127554},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3632":75156,"_31224":75060,"_21643":127556,"_5":14891,"_28416":127312,"_3083":127557},[],"`PUT` devuelve 400.",{"_3632":75157,"_31224":75060,"_21643":127559,"_5":14891,"_28416":127312,"_3083":127560},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3632":75158,"_31224":75060,"_21643":127562,"_5":14891,"_28416":127312,"_3083":127563},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3632":75159,"_31224":75060,"_21643":127565,"_5":14891,"_28416":127312,"_3083":127566},[],"`PUT` devuelve 404.",{"_3632":75160,"_31224":75060,"_21643":127568,"_5":14891,"_28416":127312,"_3083":127569},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3632":75161,"_31224":75060,"_21643":127571,"_5":14891,"_28416":127312,"_3083":127572},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3632":75162,"_31224":75060,"_21643":127574,"_5":14891,"_28416":127312,"_3083":127575},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3632":75163,"_31224":75060,"_21643":127577,"_5":14891,"_28416":127312,"_3083":127578},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3632":75164,"_31224":75060,"_21643":127580,"_5":14891,"_28416":127312,"_3083":127581},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3632":75165,"_31224":75060,"_21643":127583,"_5":14891,"_28416":127312,"_3083":127584},[],"La CRL no cambia tras revocar un certificado.",{"_3632":75166,"_31224":75060,"_21643":127586,"_5":14891,"_28416":127312,"_3083":127587},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3632":75167,"_31224":75060,"_21643":127589,"_5":14891,"_28416":127312,"_3083":127590},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3632":75168,"_31224":75060,"_21643":127592,"_5":14891,"_28416":127312,"_3083":127593},[],"Un verificador rechaza la CRL por el emisor.",{"_3632":75169,"_31224":75060,"_21643":127595,"_5":14891,"_28416":127312,"_3083":127596},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3632":75170,"_31224":75060,"_21643":127598,"_5":14891,"_28416":127312,"_3083":127599},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3632":75171,"_31224":75060,"_21643":127601,"_5":14891,"_28416":127316,"_3083":127602},[],"RFC 5280: perfil X.509 y CRL.",{"_3632":75172,"_31224":75060,"_21643":127604,"_5":14891,"_28416":127316,"_3083":58261},[],{"_3632":75173,"_31224":75060,"_21643":127606,"_5":14891,"_28416":127316,"_3083":58264},[],{"_3632":75174,"_31224":75060,"_21643":127608,"_5":14891,"_28416":127316,"_3083":127609},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":75175,"_31224":75060,"_21643":127611,"_5":14891,"_28416":127316,"_3083":127612},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3632":75176,"_31224":75176,"_5":15251,"_3083":127614,"_31583":127615,"_21643":127616,"_28416":75176},"Claves y motores criptográficos",[51036,122061,56722,126083],[],{"_3632":75177,"_31224":75176,"_21643":127618,"_5":14891,"_28416":75176,"_3083":127619},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3632":75178,"_31224":75176,"_5":31580,"_21643":127621,"_28416":127622,"_3083":127623},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3632":75179,"_31224":75176,"_5":31580,"_21643":127625,"_28416":127626,"_3083":127627},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3632":75180,"_31224":75176,"_5":31580,"_21643":127629,"_28416":127630,"_3083":58289},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#file-system",{"_3632":75181,"_31224":75176,"_5":31580,"_21643":127632,"_28416":127633,"_3083":58293},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#hashicorp-vault",{"_3632":75182,"_31224":75176,"_5":31580,"_21643":127635,"_28416":127636,"_3083":58297},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#aws-secrets-manager",{"_3632":75183,"_31224":75176,"_5":31580,"_21643":127638,"_28416":127639,"_3083":58301},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#aws-kms",{"_3632":75184,"_31224":75176,"_5":31580,"_21643":127641,"_28416":127642,"_3083":58305},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#pkcs11",{"_3632":75185,"_31224":75176,"_5":31580,"_21643":127644,"_28416":127645,"_3083":58309},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#azure-key-vault",{"_3632":75186,"_31224":75176,"_5":31580,"_21643":127647,"_28416":127648,"_3083":127649},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3632":75187,"_31224":75176,"_5":31580,"_21643":127651,"_28416":127652,"_3083":127653},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3632":75188,"_31224":75176,"_5":31580,"_21643":127655,"_28416":127656,"_3083":127657},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3632":75189,"_31224":75176,"_5":31580,"_21643":127659,"_28416":127660,"_3083":127661},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3632":75190,"_31224":75176,"_5":31580,"_21643":127663,"_28416":127664,"_3083":127665},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3632":75191,"_31224":75176,"_5":31580,"_21643":127667,"_28416":127668,"_3083":127669},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3632":75192,"_31224":75176,"_5":31580,"_21643":127671,"_28416":127672,"_3083":127673},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3632":75193,"_31224":75176,"_5":31580,"_21643":127675,"_28416":127676,"_3083":58341},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#sign",{"_3632":75194,"_31224":75176,"_5":31580,"_21643":127678,"_28416":127679,"_3083":58345},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#verify",{"_3632":75195,"_31224":75176,"_5":31580,"_21643":127681,"_28416":127682,"_3083":127683},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3632":75196,"_31224":75176,"_5":31580,"_21643":127685,"_28416":127686,"_3083":127687},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3632":75197,"_31224":75176,"_5":31580,"_21643":127689,"_28416":127690,"_3083":127691},[],"/docs/pr-preview/pr-82/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3632":75198,"_31224":75176,"_21643":127693,"_5":14891,"_28416":75176,"_3083":127694},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3632":75199,"_31224":75176,"_21643":127696,"_5":14891,"_28416":75176,"_3083":127697},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3632":75200,"_31224":75176,"_21643":127699,"_5":14891,"_28416":127622,"_3083":127700},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3632":75201,"_31224":75176,"_21643":127702,"_5":14891,"_28416":127622,"_3083":127703},[],"En la práctica, permite:",{"_3632":75202,"_31224":75176,"_21643":127705,"_5":14891,"_28416":127622,"_3083":127706},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3632":75203,"_31224":75176,"_21643":127708,"_5":14891,"_28416":127622,"_3083":127709},[],"Importar claves creadas externamente.",{"_3632":75204,"_31224":75176,"_21643":127711,"_5":14891,"_28416":127622,"_3083":127712},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3632":75205,"_31224":75176,"_21643":127714,"_5":14891,"_28416":127622,"_3083":127715},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3632":75206,"_31224":75176,"_21643":127717,"_5":14891,"_28416":127626,"_3083":127718},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3632":75207,"_31224":75176,"_21643":127720,"_5":14891,"_28416":127626,"_3083":127721},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3632":75208,"_31224":75176,"_21643":127723,"_5":14891,"_28416":127626,"_3083":127724},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3632":75209,"_31224":75176,"_21643":127726,"_5":14891,"_28416":127630,"_3083":127727},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3632":75210,"_31224":75176,"_21643":127729,"_5":14891,"_28416":127633,"_3083":127730},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3632":75211,"_31224":75176,"_21643":127732,"_5":14891,"_28416":127633,"_3083":127733},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3632":75212,"_31224":75176,"_21643":127735,"_5":14891,"_28416":127636,"_3083":127736},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3632":75213,"_31224":75176,"_21643":127738,"_5":14891,"_28416":127639,"_3083":127739},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3632":75214,"_31224":75176,"_21643":127741,"_5":14891,"_28416":127642,"_3083":127742},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3632":75215,"_31224":75176,"_21643":127744,"_5":14891,"_28416":127645,"_3083":127745},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3632":75216,"_31224":75176,"_21643":127747,"_5":14891,"_28416":127645,"_3083":127748},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3632":75217,"_31224":75176,"_21643":127750,"_5":14891,"_28416":127645,"_3083":127751},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3632":75218,"_31224":75176,"_21643":127753,"_5":14891,"_28416":127645,"_3083":127754},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3632":75219,"_31224":75176,"_21643":127756,"_5":14891,"_28416":127648,"_3083":127757},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3632":75220,"_31224":75176,"_21643":127759,"_5":14891,"_28416":127648,"_3083":127760},[],"La tabla incluye los siguientes campos:",{"_3632":75221,"_31224":75176,"_21643":127762,"_5":14891,"_28416":127648,"_3083":127763},[],"**Name**: nombre descriptivo de la clave.",{"_3632":75222,"_31224":75176,"_21643":127765,"_5":14891,"_28416":127648,"_3083":127766},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3632":75223,"_31224":75176,"_21643":127768,"_5":14891,"_28416":127648,"_3083":127769},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3632":75224,"_31224":75176,"_21643":127771,"_5":14891,"_28416":127648,"_3083":127772},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3632":75225,"_31224":75176,"_21643":127774,"_5":14891,"_28416":127648,"_3083":127775},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3632":75226,"_31224":75176,"_21643":127777,"_5":14891,"_28416":127648,"_3083":127778},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3632":75227,"_31224":75176,"_21643":127780,"_5":14891,"_28416":127648,"_3083":127781},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3632":75228,"_31224":75176,"_21643":127783,"_5":14891,"_28416":127648,"_3083":127784},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3632":75229,"_31224":75176,"_21643":127786,"_5":14891,"_28416":127648,"_3083":127787},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3632":75230,"_31224":75176,"_21643":127789,"_5":14891,"_28416":127648,"_3083":127790},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3632":75231,"_31224":75176,"_21643":127792,"_5":14891,"_28416":127648,"_3083":127793},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3632":75232,"_31224":75176,"_21643":127795,"_5":14891,"_28416":127648,"_3083":127796},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3632":75233,"_31224":75176,"_21643":127798,"_5":14891,"_28416":127648,"_3083":127799},[],"**Delete Key** para eliminar la clave del sistema.",{"_3632":75234,"_31224":75176,"_21643":127801,"_5":14891,"_28416":127652,"_3083":127802},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3632":75235,"_31224":75176,"_21643":127804,"_5":14891,"_28416":127656,"_3083":127805},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3632":75236,"_31224":75176,"_21643":127807,"_5":14891,"_28416":127656,"_3083":127808},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3632":75237,"_31224":75176,"_21643":127810,"_5":14891,"_28416":127656,"_3083":127811},[],"**Key Name**: nombre único y descriptivo.",{"_3632":75238,"_31224":75176,"_21643":127813,"_5":14891,"_28416":127656,"_3083":127814},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3632":75239,"_31224":75176,"_21643":127816,"_5":14891,"_28416":127656,"_3083":127817},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3632":75240,"_31224":75176,"_21643":127819,"_5":14891,"_28416":127656,"_3083":127820},[],"**Tags**: metadatos para clasificar la clave.",{"_3632":75241,"_31224":75176,"_21643":127822,"_5":14891,"_28416":127656,"_3083":127823},[],"**Metadata**: información adicional para usos avanzados.",{"_3632":75242,"_31224":75176,"_21643":127825,"_5":14891,"_28416":127660,"_3083":127826},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3632":75243,"_31224":75176,"_21643":127828,"_5":14891,"_28416":127660,"_3083":127829},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3632":75244,"_31224":75176,"_21643":127831,"_5":14891,"_28416":127660,"_3083":127832},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3632":75245,"_31224":75176,"_21643":127834,"_5":14891,"_28416":127660,"_3083":127835},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3632":75246,"_31224":75176,"_21643":127837,"_5":14891,"_28416":127660,"_3083":127838},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3632":75247,"_31224":75176,"_21643":127840,"_5":14891,"_28416":127660,"_3083":127841},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3632":75248,"_31224":75176,"_21643":127843,"_5":14891,"_28416":127660,"_3083":127844},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3632":75249,"_31224":75176,"_21643":127846,"_5":14891,"_28416":127660,"_3083":127847},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3632":75250,"_31224":75176,"_21643":127849,"_5":14891,"_28416":127660,"_3083":127850},[],"**Metadata**: información adicional opcional.",{"_3632":75251,"_31224":75176,"_21643":127852,"_5":14891,"_28416":127660,"_3083":127853},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3632":75252,"_31224":75176,"_21643":127855,"_5":14891,"_28416":127660,"_3083":127856},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3632":75253,"_31224":75176,"_21643":127858,"_5":14891,"_28416":127664,"_3083":127859},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3632":75254,"_31224":75176,"_21643":127861,"_5":14891,"_28416":127668,"_3083":127862},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3632":75255,"_31224":75176,"_21643":127864,"_5":14891,"_28416":127668,"_3083":127865},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3632":75256,"_31224":75176,"_21643":127867,"_5":14891,"_28416":127668,"_3083":127868},[],"**Key Name**: nombre descriptivo.",{"_3632":75257,"_31224":75176,"_21643":127870,"_5":14891,"_28416":127668,"_3083":127871},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3632":75258,"_31224":75176,"_21643":127873,"_5":14891,"_28416":127668,"_3083":127874},[],"**Tags**: etiquetas asociadas.",{"_3632":75259,"_31224":75176,"_21643":127876,"_5":14891,"_28416":127668,"_3083":127877},[],"**Aliases**: nombres alternativos.",{"_3632":75260,"_31224":75176,"_21643":127879,"_5":14891,"_28416":127668,"_3083":127880},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3632":75261,"_31224":75176,"_21643":127882,"_5":14891,"_28416":127668,"_3083":127883},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3632":75262,"_31224":75176,"_21643":127885,"_5":14891,"_28416":127668,"_3083":127886},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3632":75263,"_31224":75176,"_21643":127888,"_5":14891,"_28416":127668,"_3083":127889},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3632":75264,"_31224":75176,"_21643":127891,"_5":14891,"_28416":127672,"_3083":127892},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3632":75265,"_31224":75176,"_21643":127894,"_5":14891,"_28416":127672,"_3083":127895},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3632":75266,"_31224":75176,"_21643":127897,"_5":14891,"_28416":127672,"_3083":127898},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3632":75267,"_31224":75176,"_21643":127900,"_5":14891,"_28416":127676,"_3083":127901},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3632":75268,"_31224":75176,"_21643":127903,"_5":14891,"_28416":127676,"_3083":127904},[],"Campos principales:",{"_3632":75269,"_31224":75176,"_21643":127906,"_5":14891,"_28416":127676,"_3083":127907},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3632":75270,"_31224":75176,"_21643":127909,"_5":14891,"_28416":127676,"_3083":127910},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3632":75271,"_31224":75176,"_21643":127912,"_5":14891,"_28416":127676,"_3083":127913},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3632":75272,"_31224":75176,"_21643":127915,"_5":14891,"_28416":127676,"_3083":127916},[],"**Message**: contenido que se va a firmar.",{"_3632":75273,"_31224":75176,"_21643":127918,"_5":14891,"_28416":127676,"_3083":127919},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3632":75274,"_31224":75176,"_21643":127921,"_5":14891,"_28416":127679,"_3083":127922},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3632":75275,"_31224":75176,"_21643":127924,"_5":14891,"_28416":127679,"_3083":127904},[],{"_3632":75276,"_31224":75176,"_21643":127926,"_5":14891,"_28416":127679,"_3083":127927},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3632":75277,"_31224":75176,"_21643":127929,"_5":14891,"_28416":127679,"_3083":127930},[],"**Message Type**: `Raw` o `Digest`.",{"_3632":75278,"_31224":75176,"_21643":127932,"_5":14891,"_28416":127679,"_3083":127933},[],"**Payload Encoding**: codificación del mensaje.",{"_3632":75279,"_31224":75176,"_21643":127935,"_5":14891,"_28416":127679,"_3083":127936},[],"**Message**: mensaje original o hash.",{"_3632":75280,"_31224":75176,"_21643":127938,"_5":14891,"_28416":127679,"_3083":127939},[],"**Signature**: firma que se desea comprobar.",{"_3632":75281,"_31224":75176,"_21643":127941,"_5":14891,"_28416":127679,"_3083":127942},[],"**Result**: indicador del resultado de la validación.",{"_3632":75282,"_31224":75176,"_21643":127944,"_5":14891,"_28416":127682,"_3083":127945},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3632":75283,"_31224":75176,"_21643":127947,"_5":14891,"_28416":127682,"_3083":127948},[],"Este flujo es útil para:",{"_3632":75284,"_31224":75176,"_21643":127950,"_5":14891,"_28416":127682,"_3083":127951},[],"Solicitar certificados a una CA externa.",{"_3632":75285,"_31224":75176,"_21643":127953,"_5":14891,"_28416":127682,"_3083":127954},[],"Renovar una identidad manteniendo la misma clave.",{"_3632":75286,"_31224":75176,"_21643":127956,"_5":14891,"_28416":127682,"_3083":127957},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3632":75287,"_31224":75176,"_21643":127959,"_5":14891,"_28416":127682,"_3083":127960},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3632":75288,"_31224":75176,"_21643":127962,"_5":14891,"_28416":127682,"_3083":127963},[],"**Organization (O)**: organización o empresa.",{"_3632":75289,"_31224":75176,"_21643":127965,"_5":14891,"_28416":127682,"_3083":127966},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3632":75290,"_31224":75176,"_21643":127968,"_5":14891,"_28416":127682,"_3083":127969},[],"**Country (C)**: código de país de dos letras.",{"_3632":75291,"_31224":75176,"_21643":127971,"_5":14891,"_28416":127682,"_3083":127972},[],"**State / Province (ST)**: estado o provincia.",{"_3632":75292,"_31224":75176,"_21643":127974,"_5":14891,"_28416":127682,"_3083":127975},[],"**Locality (L)**: ciudad o localidad.",{"_3632":75293,"_31224":75176,"_21643":127977,"_5":14891,"_28416":127682,"_3083":127978},[],"**Email Address**: correo de contacto.",{"_3632":75294,"_31224":75176,"_21643":127980,"_5":14891,"_28416":127682,"_3083":127981},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3632":75295,"_31224":75176,"_21643":127983,"_5":14891,"_28416":127682,"_3083":127984},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3632":75296,"_31224":75176,"_21643":127986,"_5":14891,"_28416":127686,"_3083":127987},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3632":75297,"_31224":75176,"_21643":127989,"_5":14891,"_28416":127686,"_3083":127990},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3632":75298,"_31224":75176,"_21643":127992,"_5":14891,"_28416":127690,"_3083":127993},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3632":75299,"_31224":75176,"_21643":127995,"_5":14891,"_28416":127690,"_3083":127996},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3632":75300,"_31224":75300,"_5":15251,"_3083":127998,"_31583":127999,"_21643":128000,"_28416":75300},"Validación online con OCSP",[51036,122061,56722,126754],[],{"_3632":75301,"_31224":75300,"_21643":128002,"_5":14891,"_28416":75300,"_3083":128003},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3632":75302,"_31224":75300,"_5":31580,"_21643":128005,"_28416":128006,"_3083":128007},[],"/docs/pr-preview/pr-82/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3632":75303,"_31224":75300,"_5":31580,"_21643":128009,"_28416":128010,"_3083":128011},[],"/docs/pr-preview/pr-82/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3632":75304,"_31224":75300,"_5":31580,"_21643":128013,"_28416":128014,"_3083":128015},[],"/docs/pr-preview/pr-82/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3632":75305,"_31224":75300,"_5":31580,"_21643":128017,"_28416":128018,"_3083":128019},[],"/docs/pr-preview/pr-82/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3632":75306,"_31224":75300,"_5":31580,"_21643":128021,"_28416":128022,"_3083":128023},[],"/docs/pr-preview/pr-82/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3632":75307,"_31224":75300,"_5":31580,"_21643":128025,"_28416":128026,"_3083":127317},[],"/docs/pr-preview/pr-82/es/platform/pki/ocsp#referencias",{"_3632":75308,"_31224":75300,"_21643":128028,"_5":14891,"_28416":75300,"_3083":128029},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3632":75309,"_31224":75300,"_21643":128031,"_5":14891,"_28416":128006,"_3083":128032},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3632":75310,"_31224":75300,"_21643":128034,"_5":14891,"_28416":128006,"_3083":128035},[],"Estado del registro",{"_3632":75311,"_31224":75300,"_21643":128037,"_5":14891,"_28416":128006,"_3083":128038},[],"Respuesta firmada",{"_3632":75312,"_31224":75300,"_21643":128040,"_5":14891,"_28416":128006,"_3083":55859},[],{"_3632":75313,"_31224":75300,"_21643":128042,"_5":14891,"_28416":128006,"_3083":58709},[],{"_3632":75314,"_31224":75300,"_21643":128044,"_5":14891,"_28416":128006,"_3083":55876},[],{"_3632":75315,"_31224":75300,"_21643":128046,"_5":14891,"_28416":128006,"_3083":128047},[],"`Revoked`, con razón y fecha de revocación.",{"_3632":75316,"_31224":75300,"_21643":128049,"_5":14891,"_28416":128006,"_3083":128050},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3632":75317,"_31224":75300,"_21643":128052,"_5":14891,"_28416":128006,"_3083":128053},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3632":75318,"_31224":75300,"_21643":128055,"_5":14891,"_28416":128006,"_3083":128056},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3632":75319,"_31224":75300,"_21643":128058,"_5":14891,"_28416":128006,"_3083":128059},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3632":75320,"_31224":75300,"_21643":128061,"_5":14891,"_28416":128006,"_3083":128062},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3632":75321,"_31224":75300,"_21643":128064,"_5":14891,"_28416":128010,"_3083":128065},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3632":75322,"_31224":75300,"_21643":128067,"_5":14891,"_28416":128010,"_3083":128068},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3632":75323,"_31224":75300,"_21643":128070,"_5":14891,"_28416":128014,"_3083":128071},[],"El servicio acepta:",{"_3632":75324,"_31224":75300,"_21643":128073,"_5":14891,"_28416":128014,"_3083":123936},[],{"_3632":75325,"_31224":75300,"_21643":128075,"_5":14891,"_28416":128014,"_3083":128076},[],"Ruta del servicio VA",{"_3632":75326,"_31224":75300,"_21643":128078,"_5":14891,"_28416":128014,"_3083":128079},[],"Formato",{"_3632":75327,"_31224":75300,"_21643":128081,"_5":14891,"_28416":128014,"_3083":58749},[],{"_3632":75328,"_31224":75300,"_21643":128083,"_5":14891,"_28416":128014,"_3083":58752},[],{"_3632":75329,"_31224":75300,"_21643":128085,"_5":14891,"_28416":128014,"_3083":128086},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3632":75330,"_31224":75300,"_21643":128088,"_5":14891,"_28416":128014,"_3083":58144},[],{"_3632":75331,"_31224":75300,"_21643":128090,"_5":14891,"_28416":128014,"_3083":58760},[],{"_3632":75332,"_31224":75300,"_21643":128092,"_5":14891,"_28416":128014,"_3083":128093},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3632":75333,"_31224":75300,"_21643":128095,"_5":14891,"_28416":128014,"_3083":128096},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3632":75334,"_31224":75300,"_21643":128098,"_5":14891,"_28416":128018,"_3083":128099},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3632":75335,"_31224":75300,"_21643":128101,"_5":14891,"_28416":128018,"_3083":128102},[],"Genera la solicitud:",{"_3632":75336,"_31224":75300,"_21643":128104,"_5":14891,"_28416":128018,"_3083":128105},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3632":75337,"_31224":75300,"_21643":128107,"_5":14891,"_28416":128018,"_3083":128108},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3632":75338,"_31224":75300,"_21643":128110,"_5":14891,"_28416":128018,"_3083":128111},[],"Verifica el DER recibido:",{"_3632":75339,"_31224":75300,"_21643":128113,"_5":14891,"_28416":128018,"_3083":128114},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3632":75340,"_31224":75300,"_21643":128116,"_5":14891,"_28416":128022,"_3083":128117},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3632":75341,"_31224":75300,"_21643":128119,"_5":14891,"_28416":128022,"_3083":128120},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3632":75342,"_31224":75300,"_21643":128122,"_5":14891,"_28416":128026,"_3083":58793},[],{"_3632":75343,"_31224":75300,"_21643":128124,"_5":14891,"_28416":128026,"_3083":58796},[],{"_3632":75344,"_31224":75300,"_21643":128126,"_5":14891,"_28416":128026,"_3083":128127},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3632":75345,"_31224":75300,"_21643":128129,"_5":14891,"_28416":128026,"_3083":127612},[],{"_3632":75346,"_31224":75346,"_5":15251,"_3083":56722,"_31583":128131,"_21643":128132,"_28416":75346},[51036,122061,56722],[],{"_3632":75347,"_31224":75346,"_21643":128134,"_5":14891,"_28416":75346,"_3083":128135},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3632":75348,"_31224":75346,"_5":31580,"_21643":128137,"_28416":128138,"_3083":125409},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#empieza-aquí",{"_3632":75349,"_31224":75346,"_5":31580,"_21643":128140,"_28416":128141,"_3083":128142},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3632":75350,"_31224":75346,"_5":31580,"_21643":128144,"_28416":128145,"_3083":125929},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#capacidades-principales",{"_3632":75351,"_31224":75346,"_5":31580,"_21643":128147,"_28416":128148,"_3083":125933},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3632":75352,"_31224":75346,"_5":31580,"_21643":128150,"_28416":128151,"_3083":125937},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3632":75353,"_31224":75346,"_5":31580,"_21643":128153,"_28416":128154,"_3083":125941},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#emite-y-controla-certificados",{"_3632":75354,"_31224":75346,"_5":31580,"_21643":128156,"_28416":128157,"_3083":125949},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#publica-el-estado-de-validación",{"_3632":75355,"_31224":75346,"_5":31580,"_21643":128159,"_28416":128160,"_3083":128161},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3632":75356,"_31224":75346,"_5":31580,"_21643":128163,"_28416":128164,"_3083":126920},[],"/docs/pr-preview/pr-82/es/platform/pki/overview#continúa",{"_3632":75357,"_31224":75346,"_21643":128166,"_5":14891,"_28416":75346,"_3083":128167},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3632":75358,"_31224":75346,"_21643":128169,"_5":14891,"_28416":128138,"_3083":128170},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3632":75359,"_31224":75346,"_21643":128172,"_5":14891,"_28416":128138,"_3083":128173},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3632":75360,"_31224":75346,"_21643":128175,"_5":14891,"_28416":128141,"_3083":128176},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3632":75361,"_31224":75346,"_21643":128178,"_5":14891,"_28416":128141,"_3083":128179},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3632":75362,"_31224":75346,"_21643":128181,"_5":14891,"_28416":128141,"_3083":128182},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3632":75363,"_31224":75346,"_21643":128184,"_5":14891,"_28416":128141,"_3083":128185},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3632":75364,"_31224":75346,"_21643":128187,"_5":14891,"_28416":128141,"_3083":128188},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3632":75365,"_31224":75346,"_21643":128190,"_5":14891,"_28416":128148,"_3083":128191},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3632":75366,"_31224":75346,"_21643":128193,"_5":14891,"_28416":128151,"_3083":128194},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3632":75367,"_31224":75346,"_21643":128196,"_5":14891,"_28416":128154,"_3083":128197},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3632":75368,"_31224":75346,"_21643":128199,"_5":14891,"_28416":128157,"_3083":128200},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3632":75369,"_31224":75346,"_21643":128202,"_5":14891,"_28416":128160,"_3083":128203},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3632":75370,"_31224":75346,"_21643":128205,"_5":14891,"_28416":128160,"_3083":128206},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3632":75371,"_31224":75346,"_21643":128208,"_5":14891,"_28416":128160,"_3083":128209},[],"su clave pública corresponda a la clave privada del cliente;",{"_3632":75372,"_31224":75346,"_21643":128211,"_5":14891,"_28416":128160,"_3083":128212},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3632":75373,"_31224":75346,"_21643":128214,"_5":14891,"_28416":128160,"_3083":128215},[],"sus fechas y usos permitan la operación;",{"_3632":75374,"_31224":75346,"_21643":128217,"_5":14891,"_28416":128160,"_3083":128218},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3632":75375,"_31224":75346,"_21643":128220,"_5":14891,"_28416":128160,"_3083":128221},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3632":75376,"_31224":75346,"_21643":128223,"_5":14891,"_28416":128164,"_3083":128224},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":75377,"_31224":75346,"_21643":128226,"_5":14891,"_28416":128164,"_3083":128227},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3632":75378,"_31224":75346,"_21643":128229,"_5":14891,"_28416":128164,"_3083":128230},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3632":75379,"_31224":75379,"_5":15251,"_3083":128232,"_31583":128233,"_21643":128234,"_28416":75379},"Crea tu primera CA",[51036,122061,56722,125533],[],{"_3632":75380,"_31224":75379,"_21643":128236,"_5":14891,"_28416":75379,"_3083":128237},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3632":75381,"_31224":75379,"_5":31580,"_21643":128239,"_28416":128240,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3632":75382,"_31224":75379,"_5":31580,"_21643":128242,"_28416":128243,"_3083":128244},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3632":75383,"_31224":75379,"_5":31580,"_21643":128246,"_28416":128247,"_3083":128248},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3632":75384,"_31224":75379,"_5":31580,"_21643":128250,"_28416":128251,"_3083":128252},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3632":75385,"_31224":75379,"_5":31580,"_21643":128254,"_28416":128255,"_3083":128256},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3632":75386,"_31224":75379,"_5":31580,"_21643":128258,"_28416":128259,"_3083":128260},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3632":75387,"_31224":75379,"_5":31580,"_21643":128262,"_28416":128263,"_3083":128264},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3632":75388,"_31224":75379,"_5":31580,"_21643":128266,"_28416":128267,"_3083":125780},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3632":75389,"_31224":75379,"_5":31580,"_21643":128269,"_28416":128270,"_3083":120619},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3632":75390,"_31224":75379,"_21643":128272,"_5":14891,"_28416":75379,"_3083":128273},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3632":75391,"_31224":75379,"_21643":128275,"_5":14891,"_28416":128240,"_3083":128276},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3632":75392,"_31224":75379,"_21643":128278,"_5":14891,"_28416":128240,"_3083":128279},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3632":75393,"_31224":75379,"_21643":128281,"_5":14891,"_28416":128240,"_3083":128282},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3632":75394,"_31224":75379,"_21643":128284,"_5":14891,"_28416":128240,"_3083":128285},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3632":75395,"_31224":75379,"_21643":128287,"_5":14891,"_28416":128243,"_3083":128288},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3632":75396,"_31224":75379,"_21643":128290,"_5":14891,"_28416":128243,"_3083":128291},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3632":75397,"_31224":75379,"_21643":128293,"_5":14891,"_28416":128247,"_3083":128294},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3632":75398,"_31224":75379,"_21643":128296,"_5":14891,"_28416":128247,"_3083":128297},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3632":75399,"_31224":75379,"_21643":128299,"_5":14891,"_28416":128251,"_3083":128300},[],"Selecciona **Root CA** y completa:",{"_3632":75400,"_31224":75379,"_21643":128302,"_5":14891,"_28416":128251,"_3083":58975},[],{"_3632":75401,"_31224":75379,"_21643":128304,"_5":14891,"_28416":128251,"_3083":128305},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3632":75402,"_31224":75379,"_21643":128307,"_5":14891,"_28416":128251,"_3083":128308},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3632":75403,"_31224":75379,"_21643":128310,"_5":14891,"_28416":128251,"_3083":128311},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3632":75404,"_31224":75379,"_21643":128313,"_5":14891,"_28416":128251,"_3083":128314},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3632":75405,"_31224":75379,"_21643":128316,"_5":14891,"_28416":128255,"_3083":128317},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3632":75406,"_31224":75379,"_21643":128319,"_5":14891,"_28416":128259,"_3083":128320},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3632":75407,"_31224":75379,"_21643":128322,"_5":14891,"_28416":128259,"_3083":128323},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3632":75408,"_31224":75379,"_21643":128325,"_5":14891,"_28416":128263,"_3083":128326},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3632":75409,"_31224":75379,"_21643":128328,"_5":14891,"_28416":128263,"_3083":128329},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3632":75410,"_31224":75379,"_21643":128331,"_5":14891,"_28416":128263,"_3083":128332},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3632":75411,"_31224":75379,"_21643":128334,"_5":14891,"_28416":128267,"_3083":128335},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3632":75412,"_31224":75379,"_21643":128337,"_5":14891,"_28416":128267,"_3083":128338},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3632":75413,"_31224":75379,"_21643":128340,"_5":14891,"_28416":128267,"_3083":128341},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3632":75414,"_31224":75379,"_21643":128343,"_5":14891,"_28416":128267,"_3083":128344},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3632":75415,"_31224":75379,"_21643":128346,"_5":14891,"_28416":128270,"_3083":128347},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3632":75416,"_31224":75416,"_5":15251,"_3083":128349,"_31583":128350,"_21643":128351,"_28416":75416},"Emite y verifica un certificado",[51036,122061,56722,125533],[],{"_3632":75417,"_31224":75416,"_21643":128353,"_5":14891,"_28416":75416,"_3083":128354},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3632":75418,"_31224":75416,"_5":31580,"_21643":128356,"_28416":128357,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3632":75419,"_31224":75416,"_5":31580,"_21643":128359,"_28416":128360,"_3083":128361},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3632":75420,"_31224":75416,"_5":31580,"_21643":128363,"_28416":128364,"_3083":128365},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3632":75421,"_31224":75416,"_5":31580,"_21643":128367,"_28416":128368,"_3083":128369},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3632":75422,"_31224":75416,"_5":31580,"_21643":128371,"_28416":128372,"_3083":128373},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3632":75423,"_31224":75416,"_5":31580,"_21643":128375,"_28416":128376,"_3083":128377},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3632":75424,"_31224":75416,"_5":31580,"_21643":128379,"_28416":128380,"_3083":128381},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3632":75425,"_31224":75416,"_5":31580,"_21643":128383,"_28416":128384,"_3083":128385},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3632":75426,"_31224":75416,"_5":31580,"_21643":128387,"_28416":128388,"_3083":128389},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3632":75427,"_31224":75416,"_5":31580,"_21643":128391,"_28416":128392,"_3083":128393},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3632":75428,"_31224":75416,"_5":31580,"_21643":128395,"_28416":128396,"_3083":125780},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3632":75429,"_31224":75416,"_5":31580,"_21643":128398,"_28416":128399,"_3083":120619},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3632":75430,"_31224":75416,"_21643":128401,"_5":14891,"_28416":75416,"_3083":128402},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3632":75431,"_31224":75416,"_21643":128404,"_5":14891,"_28416":128357,"_3083":128405},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3632":75432,"_31224":75416,"_21643":128407,"_5":14891,"_28416":128357,"_3083":128408},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3632":75433,"_31224":75416,"_21643":128410,"_5":14891,"_28416":128357,"_3083":128411},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3632":75434,"_31224":75416,"_21643":128413,"_5":14891,"_28416":128357,"_3083":128414},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3632":75435,"_31224":75416,"_21643":128416,"_5":14891,"_28416":128357,"_3083":128417},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3632":75436,"_31224":75416,"_21643":128419,"_5":14891,"_28416":128360,"_3083":128420},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3632":75437,"_31224":75416,"_21643":128422,"_5":14891,"_28416":128364,"_3083":128423},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3632":75438,"_31224":75416,"_21643":128425,"_5":14891,"_28416":128364,"_3083":128426},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3632":75439,"_31224":75416,"_21643":128428,"_5":14891,"_28416":128368,"_3083":128429},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3632":75440,"_31224":75416,"_21643":128431,"_5":14891,"_28416":128368,"_3083":128432},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3632":75441,"_31224":75416,"_21643":128434,"_5":14891,"_28416":128372,"_3083":128435},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3632":75442,"_31224":75416,"_21643":128437,"_5":14891,"_28416":128372,"_3083":128438},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3632":75443,"_31224":75416,"_21643":128440,"_5":14891,"_28416":128376,"_3083":128441},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3632":75444,"_31224":75416,"_21643":128443,"_5":14891,"_28416":128380,"_3083":128444},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3632":75445,"_31224":75416,"_21643":128446,"_5":14891,"_28416":128384,"_3083":128447},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3632":75446,"_31224":75416,"_21643":128449,"_5":14891,"_28416":128388,"_3083":128450},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3632":75447,"_31224":75416,"_21643":128452,"_5":14891,"_28416":128388,"_3083":128453},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3632":75448,"_31224":75416,"_21643":128455,"_5":14891,"_28416":128388,"_3083":128456},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3632":75449,"_31224":75416,"_21643":128458,"_5":14891,"_28416":128392,"_3083":128459},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3632":75450,"_31224":75416,"_21643":128461,"_5":14891,"_28416":128392,"_3083":128462},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3632":75451,"_31224":75416,"_21643":128464,"_5":14891,"_28416":128392,"_3083":128465},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3632":75452,"_31224":75416,"_21643":128467,"_5":14891,"_28416":128396,"_3083":125863},[],{"_3632":75453,"_31224":75416,"_21643":128469,"_5":14891,"_28416":128396,"_3083":124378},[],{"_3632":75454,"_31224":75416,"_21643":128471,"_5":14891,"_28416":128396,"_3083":128472},[],"La CA rechaza la emisión",{"_3632":75455,"_31224":75416,"_21643":128474,"_5":14891,"_28416":128396,"_3083":128475},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3632":75456,"_31224":75416,"_21643":128477,"_5":14891,"_28416":128396,"_3083":128478},[],"Sujeto o usos diferentes",{"_3632":75457,"_31224":75416,"_21643":128480,"_5":14891,"_28416":128396,"_3083":128481},[],"Perfil aplicado y valores solicitados.",{"_3632":75458,"_31224":75416,"_21643":128483,"_5":14891,"_28416":128396,"_3083":128484},[],"No se encuentra el emisor",{"_3632":75459,"_31224":75416,"_21643":128486,"_5":14891,"_28416":128396,"_3083":128487},[],"CA descargada y cadena intermedia necesaria.",{"_3632":75460,"_31224":75416,"_21643":128489,"_5":14891,"_28416":128396,"_3083":128490},[],"Falla la vigencia",{"_3632":75461,"_31224":75416,"_21643":128492,"_5":14891,"_28416":128396,"_3083":128493},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3632":75462,"_31224":75416,"_21643":128495,"_5":14891,"_28416":128396,"_3083":128496},[],"Los resúmenes de clave difieren",{"_3632":75463,"_31224":75416,"_21643":128498,"_5":14891,"_28416":128396,"_3083":128499},[],"Archivos de certificado y clave de la misma emisión.",{"_3632":75464,"_31224":75416,"_21643":128501,"_5":14891,"_28416":128396,"_3083":128502},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3632":75465,"_31224":75416,"_21643":128504,"_5":14891,"_28416":128399,"_3083":128505},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3632":75466,"_31224":75416,"_21643":128507,"_5":14891,"_28416":128399,"_3083":128508},[],"Gestionar certificados para inspección, estado y revocación.",{"_3632":75467,"_31224":75416,"_21643":128510,"_5":14891,"_28416":128399,"_3083":128511},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3632":75468,"_31224":75416,"_21643":128513,"_5":14891,"_28416":128399,"_3083":128514},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3632":75469,"_31224":75416,"_21643":128516,"_5":14891,"_28416":128399,"_3083":128517},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3632":75470,"_31224":75470,"_5":15251,"_3083":128519,"_31583":128520,"_21643":128521,"_28416":75470},"Primeros pasos de PKI",[51036,122061,56722,125533],[],{"_3632":75471,"_31224":75470,"_21643":128523,"_5":14891,"_28416":75470,"_3083":128524},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3632":75472,"_31224":75470,"_5":31580,"_21643":128526,"_28416":128527,"_3083":120595},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3632":75473,"_31224":75470,"_5":31580,"_21643":128529,"_28416":128530,"_3083":128531},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3632":75474,"_31224":75470,"_5":31580,"_21643":128533,"_28416":128534,"_3083":125715},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3632":75475,"_31224":75470,"_5":31580,"_21643":128536,"_28416":128537,"_3083":128538},[],"/docs/pr-preview/pr-82/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3632":75476,"_31224":75470,"_21643":128540,"_5":14891,"_28416":75470,"_3083":128541},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3632":75477,"_31224":75470,"_21643":128543,"_5":14891,"_28416":128527,"_3083":128544},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3632":75478,"_31224":75470,"_21643":128546,"_5":14891,"_28416":128527,"_3083":128547},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3632":75479,"_31224":75470,"_21643":128549,"_5":14891,"_28416":128527,"_3083":128550},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3632":75480,"_31224":75470,"_21643":128552,"_5":14891,"_28416":128527,"_3083":128553},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3632":75481,"_31224":75470,"_21643":128555,"_5":14891,"_28416":128527,"_3083":128556},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3632":75482,"_31224":75470,"_21643":128558,"_5":14891,"_28416":128530,"_3083":128559},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3632":75483,"_31224":75470,"_21643":128561,"_5":14891,"_28416":128530,"_3083":128562},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3632":75484,"_31224":75470,"_21643":128564,"_5":14891,"_28416":128530,"_3083":128565},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3632":75485,"_31224":75470,"_21643":128567,"_5":14891,"_28416":128530,"_3083":128568},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3632":75486,"_31224":75470,"_21643":128570,"_5":14891,"_28416":128534,"_3083":128571},[],"Archivo o recurso",{"_3632":75487,"_31224":75470,"_21643":128573,"_5":14891,"_28416":128534,"_3083":125712},[],{"_3632":75488,"_31224":75470,"_21643":128575,"_5":14891,"_28416":128534,"_3083":128576},[],"CA raíz activa y `ca.pem`",{"_3632":75489,"_31224":75470,"_21643":128578,"_5":14891,"_28416":128534,"_3083":128579},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3632":75490,"_31224":75470,"_21643":128581,"_5":14891,"_28416":128534,"_3083":128582},[],"Certificado final y `device.crt`",{"_3632":75491,"_31224":75470,"_21643":128584,"_5":14891,"_28416":128534,"_3083":128585},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3632":75492,"_31224":75470,"_21643":128587,"_5":14891,"_28416":128534,"_3083":128588},[],"Clave privada `device.key`",{"_3632":75493,"_31224":75470,"_21643":128590,"_5":14891,"_28416":128534,"_3083":128591},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3632":75494,"_31224":75470,"_21643":128593,"_5":14891,"_28416":128534,"_3083":128594},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3632":75495,"_31224":75470,"_21643":128596,"_5":14891,"_28416":128537,"_3083":128597},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3632":75496,"_31224":75470,"_21643":128599,"_5":14891,"_28416":128537,"_3083":128600},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3632":75497,"_31224":75470,"_21643":128602,"_5":14891,"_28416":128537,"_3083":128603},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3632":75498,"_31224":75498,"_5":15251,"_3083":128605,"_31583":128606,"_21643":128608,"_28416":75498},"Resolución de problemas PKI",[51036,122061,56722,128607],"Resolución de problemas",[],{"_3632":75499,"_31224":75498,"_21643":128610,"_5":14891,"_28416":75498,"_3083":128611},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3632":75500,"_31224":75498,"_5":31580,"_21643":128613,"_28416":128614,"_3083":128615},[],"/docs/pr-preview/pr-82/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3632":75501,"_31224":75498,"_5":31580,"_21643":128617,"_28416":128618,"_3083":128619},[],"/docs/pr-preview/pr-82/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3632":75502,"_31224":75498,"_5":31580,"_21643":128621,"_28416":128622,"_3083":128623},[],"/docs/pr-preview/pr-82/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3632":75503,"_31224":75498,"_21643":128625,"_5":14891,"_28416":75498,"_3083":128626},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3632":75504,"_31224":75498,"_21643":128628,"_5":14891,"_28416":75498,"_3083":128629},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3632":75505,"_31224":75498,"_21643":128631,"_5":14891,"_28416":128614,"_3083":125712},[],{"_3632":75506,"_31224":75498,"_21643":128633,"_5":14891,"_28416":128614,"_3083":124378},[],{"_3632":75507,"_31224":75498,"_21643":128635,"_5":14891,"_28416":128614,"_3083":120619},[],{"_3632":75508,"_31224":75498,"_21643":128637,"_5":14891,"_28416":128614,"_3083":55564},[],{"_3632":75509,"_31224":75498,"_21643":128639,"_5":14891,"_28416":128614,"_3083":128640},[],"Existe, está activa y sus fechas son utilizables.",{"_3632":75510,"_31224":75498,"_21643":128642,"_5":14891,"_28416":128614,"_3083":128643},[],"Autoridades.",{"_3632":75511,"_31224":75498,"_21643":128645,"_5":14891,"_28416":128614,"_3083":128646},[],"Clave",{"_3632":75512,"_31224":75498,"_21643":128648,"_5":14891,"_28416":128614,"_3083":128649},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3632":75513,"_31224":75498,"_21643":128651,"_5":14891,"_28416":128614,"_3083":128652},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3632":75514,"_31224":75498,"_21643":128654,"_5":14891,"_28416":128614,"_3083":59329},[],{"_3632":75515,"_31224":75498,"_21643":128656,"_5":14891,"_28416":128614,"_3083":128657},[],"PEM correcto y firma verificable.",{"_3632":75516,"_31224":75498,"_21643":128659,"_5":14891,"_28416":128614,"_3083":59335},[],{"_3632":75517,"_31224":75498,"_21643":128661,"_5":14891,"_28416":128614,"_3083":128662},[],"Perfil",{"_3632":75518,"_31224":75498,"_21643":128664,"_5":14891,"_28416":128614,"_3083":128665},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3632":75519,"_31224":75498,"_21643":128667,"_5":14891,"_28416":128614,"_3083":128668},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3632":75520,"_31224":75498,"_21643":128670,"_5":14891,"_28416":128614,"_3083":125863},[],{"_3632":75521,"_31224":75498,"_21643":128672,"_5":14891,"_28416":128614,"_3083":128673},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3632":75522,"_31224":75498,"_21643":128675,"_5":14891,"_28416":128614,"_3083":128676},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3632":75523,"_31224":75498,"_21643":128678,"_5":14891,"_28416":128614,"_3083":128679},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3632":75524,"_31224":75498,"_21643":128681,"_5":14891,"_28416":128614,"_3083":128682},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3632":75525,"_31224":75498,"_21643":128684,"_5":14891,"_28416":128614,"_3083":128685},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3632":75526,"_31224":75498,"_21643":128687,"_5":14891,"_28416":128618,"_3083":128688},[],"Revisa cada frontera por separado:",{"_3632":75527,"_31224":75498,"_21643":128690,"_5":14891,"_28416":128618,"_3083":128691},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3632":75528,"_31224":75498,"_21643":128693,"_5":14891,"_28416":128618,"_3083":128694},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3632":75529,"_31224":75498,"_21643":128696,"_5":14891,"_28416":128618,"_3083":128697},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3632":75530,"_31224":75498,"_21643":128699,"_5":14891,"_28416":128618,"_3083":128700},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3632":75531,"_31224":75498,"_21643":128702,"_5":14891,"_28416":128618,"_3083":128703},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3632":75532,"_31224":75498,"_21643":128705,"_5":14891,"_28416":128618,"_3083":128706},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3632":75533,"_31224":75498,"_21643":128708,"_5":14891,"_28416":128622,"_3083":128709},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3632":75534,"_31224":75498,"_21643":128711,"_5":14891,"_28416":128622,"_3083":128712},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3632":75535,"_31224":75535,"_5":15251,"_3083":128714,"_31583":128715,"_21643":128716,"_28416":75535},"Seguridad",[51036],[],{"_3632":75536,"_31224":75535,"_21643":128718,"_5":14891,"_28416":75535,"_3083":128719},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3632":75537,"_31224":75535,"_5":31580,"_21643":128721,"_28416":128722,"_3083":128723},[],"/docs/pr-preview/pr-82/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3632":75538,"_31224":75535,"_5":31580,"_21643":128725,"_28416":128726,"_3083":128727},[],"/docs/pr-preview/pr-82/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3632":75539,"_31224":75535,"_5":31580,"_21643":128729,"_28416":128730,"_3083":128731},[],"/docs/pr-preview/pr-82/es/security#versiones-soportadas","Versiones soportadas",{"_3632":75540,"_31224":75535,"_5":31580,"_21643":128733,"_28416":128734,"_3083":128735},[],"/docs/pr-preview/pr-82/es/security#divulgación-responsable","Divulgación responsable",{"_3632":75541,"_31224":75535,"_21643":128737,"_5":14891,"_28416":75535,"_3083":128738},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3632":75542,"_31224":75535,"_21643":128740,"_5":14891,"_28416":128722,"_3083":128741},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3632":75543,"_31224":75535,"_21643":128743,"_5":14891,"_28416":128722,"_3083":128744},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3632":75544,"_31224":75535,"_21643":128746,"_5":14891,"_28416":128722,"_3083":15530},[],{"_3632":75545,"_31224":75535,"_21643":128748,"_5":14891,"_28416":128722,"_3083":15459},[],{"_3632":75546,"_31224":75535,"_21643":128750,"_5":14891,"_28416":128722,"_3083":15517},[],{"_3632":75547,"_31224":75535,"_21643":128752,"_5":14891,"_28416":128722,"_3083":128753},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3632":75548,"_31224":75535,"_21643":128755,"_5":14891,"_28416":128722,"_3083":128756},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3632":75549,"_31224":75535,"_21643":128758,"_5":14891,"_28416":128726,"_3083":128759},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3632":75550,"_31224":75535,"_21643":128761,"_5":14891,"_28416":128726,"_3083":128762},[],"No incluyas en el reporte:",{"_3632":75551,"_31224":75535,"_21643":128764,"_5":14891,"_28416":128726,"_3083":128765},[],"Credenciales, tokens o claves privadas",{"_3632":75552,"_31224":75535,"_21643":128767,"_5":14891,"_28416":128726,"_3083":128768},[],"Datos de clientes o información identificable de clientes",{"_3632":75553,"_31224":75535,"_21643":128770,"_5":14891,"_28416":128726,"_3083":128771},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3632":75554,"_31224":75535,"_21643":128773,"_5":14891,"_28416":128730,"_3083":128774},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3632":75555,"_31224":75535,"_21643":128776,"_5":14891,"_28416":128730,"_3083":128777},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3632":75556,"_31224":75535,"_21643":128779,"_5":14891,"_28416":128734,"_3083":128780},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3632":75557,"_31224":75535,"_21643":128782,"_5":14891,"_28416":128734,"_3083":128783},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3632":75558,"_31224":75535,"_21643":128785,"_5":14891,"_28416":128734,"_3083":128786},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3632":75559,"_31224":75535,"_21643":128788,"_5":14891,"_28416":128734,"_3083":128789},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3632":75560,"_31224":75535,"_21643":128791,"_5":14891,"_28416":128734,"_3083":128792},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3632":75561,"_31224":75561,"_5":15251,"_3083":128794,"_31583":128795,"_21643":128797,"_28416":75561},"3.8.0 a 4.0.0",[51036,128796],"Actualizaciones",[],{"_3632":75562,"_31224":75561,"_21643":128799,"_5":14891,"_28416":75561,"_3083":128800},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3632":75563,"_31224":75561,"_5":31580,"_21643":128802,"_28416":128803,"_3083":128804},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3632":75564,"_31224":75561,"_5":31580,"_21643":128806,"_28416":128807,"_3083":128808},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3632":75565,"_31224":75561,"_5":31580,"_21643":128810,"_28416":128811,"_3083":128812},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3632":75566,"_31224":75561,"_5":31580,"_21643":128814,"_28416":128815,"_3083":128816},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3632":75567,"_31224":75561,"_5":31580,"_21643":128818,"_28416":128819,"_3083":128820},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3632":75568,"_31224":75561,"_5":31580,"_21643":128822,"_28416":128823,"_3083":128824},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3632":75569,"_31224":75561,"_5":31580,"_21643":128826,"_28416":128827,"_3083":59504},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3632":75570,"_31224":75561,"_5":31580,"_21643":128829,"_28416":128830,"_3083":128831},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3632":75571,"_31224":75561,"_5":31580,"_21643":128833,"_28416":128834,"_3083":128835},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3632":75572,"_31224":75561,"_5":31580,"_21643":128837,"_28416":128838,"_3083":128839},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3632":75573,"_31224":75561,"_5":31580,"_21643":128841,"_28416":128842,"_3083":121190},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3632":75574,"_31224":75561,"_5":31580,"_21643":128844,"_28416":128845,"_3083":128846},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3632":75575,"_31224":75561,"_5":31580,"_21643":128848,"_28416":128849,"_3083":128850},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3632":75576,"_31224":75561,"_5":31580,"_21643":128852,"_28416":128853,"_3083":128854},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3632":75577,"_31224":75561,"_5":31580,"_21643":128856,"_28416":128857,"_3083":128858},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3632":75578,"_31224":75561,"_5":31580,"_21643":128860,"_28416":128861,"_3083":128862},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3632":75579,"_31224":75561,"_5":31580,"_21643":128864,"_28416":128865,"_3083":128866},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3632":75580,"_31224":75561,"_5":31580,"_21643":128868,"_28416":128869,"_3083":128870},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3632":75581,"_31224":75561,"_5":31580,"_21643":128872,"_28416":128873,"_3083":128874},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3632":75582,"_31224":75561,"_5":31580,"_21643":128876,"_28416":128877,"_3083":128878},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3632":75583,"_31224":75561,"_5":31580,"_21643":128880,"_28416":128881,"_3083":128882},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3632":75584,"_31224":75561,"_5":31580,"_21643":128884,"_28416":128885,"_3083":128886},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3632":75585,"_31224":75561,"_5":31580,"_21643":128888,"_28416":128889,"_3083":128890},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3632":75586,"_31224":75561,"_5":31580,"_21643":128892,"_28416":128893,"_3083":128894},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3632":75587,"_31224":75561,"_5":31580,"_21643":128896,"_28416":128897,"_3083":128898},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3632":75588,"_31224":75561,"_5":31580,"_21643":128900,"_28416":128901,"_3083":128902},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3632":75589,"_31224":75561,"_5":31580,"_21643":128904,"_28416":128905,"_3083":128906},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3632":75590,"_31224":75561,"_5":31580,"_21643":128908,"_28416":128909,"_3083":128910},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3632":75591,"_31224":75561,"_5":31580,"_21643":128912,"_28416":128913,"_3083":128914},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3632":75592,"_31224":75561,"_5":31580,"_21643":128916,"_28416":128917,"_3083":128918},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3632":75593,"_31224":75561,"_5":31580,"_21643":128920,"_28416":128921,"_3083":128922},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3632":75594,"_31224":75561,"_5":31580,"_21643":128924,"_28416":128925,"_3083":128926},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3632":75595,"_31224":75561,"_5":31580,"_21643":128928,"_28416":128929,"_3083":128930},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3632":75596,"_31224":75561,"_5":31580,"_21643":128932,"_28416":128933,"_3083":128934},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3632":75597,"_31224":75561,"_5":31580,"_21643":128936,"_28416":128937,"_3083":128938},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3632":75598,"_31224":75561,"_5":31580,"_21643":128940,"_28416":128941,"_3083":128942},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3632":75599,"_31224":75561,"_5":31580,"_21643":128944,"_28416":128945,"_3083":128946},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3632":75600,"_31224":75561,"_5":31580,"_21643":128948,"_28416":128949,"_3083":128950},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3632":75601,"_31224":75561,"_5":31580,"_21643":128952,"_28416":128953,"_3083":128954},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3632":75602,"_31224":75561,"_5":31580,"_21643":128956,"_28416":128957,"_3083":128958},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3632":75603,"_31224":75561,"_5":31580,"_21643":128960,"_28416":128961,"_3083":128962},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3632":75604,"_31224":75561,"_5":31580,"_21643":128964,"_28416":128965,"_3083":128966},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3632":75605,"_31224":75561,"_5":31580,"_21643":128968,"_28416":128969,"_3083":128970},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3632":75606,"_31224":75561,"_5":31580,"_21643":128972,"_28416":128973,"_3083":128974},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3632":75607,"_31224":75561,"_5":31580,"_21643":128976,"_28416":128977,"_3083":124726},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3632":75608,"_31224":75561,"_5":31580,"_21643":128979,"_28416":128980,"_3083":128981},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3632":75609,"_31224":75561,"_5":31580,"_21643":128983,"_28416":128984,"_3083":128985},[],"/docs/pr-preview/pr-82/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3632":75610,"_31224":75561,"_21643":128987,"_5":14891,"_28416":75561,"_3083":128988},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3632":75611,"_31224":75561,"_21643":128990,"_5":14891,"_28416":75561,"_3083":128991},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3632":75612,"_31224":75561,"_21643":128993,"_5":14891,"_28416":75561,"_3083":128994},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3632":75613,"_31224":75561,"_21643":128996,"_5":14891,"_28416":75561,"_3083":128997},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3632":75614,"_31224":75561,"_21643":128999,"_5":14891,"_28416":75561,"_3083":129000},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3632":75615,"_31224":75561,"_21643":129002,"_5":14891,"_28416":75561,"_3083":129003},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3632":75616,"_31224":75561,"_21643":129005,"_5":14891,"_28416":75561,"_3083":129006},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3632":75617,"_31224":75561,"_21643":129008,"_5":14891,"_28416":128807,"_3083":129009},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3632":75618,"_31224":75561,"_21643":129011,"_5":14891,"_28416":128807,"_3083":129012},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3632":75619,"_31224":75561,"_21643":129014,"_5":14891,"_28416":128811,"_3083":129015},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3632":75620,"_31224":75561,"_21643":129017,"_5":14891,"_28416":128811,"_3083":129018},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3632":75621,"_31224":75561,"_21643":129020,"_5":14891,"_28416":128815,"_3083":129021},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3632":75622,"_31224":75561,"_21643":129023,"_5":14891,"_28416":128819,"_3083":129024},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3632":75623,"_31224":75561,"_21643":129026,"_5":14891,"_28416":128819,"_3083":129027},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3632":75624,"_31224":75561,"_21643":129029,"_5":14891,"_28416":128819,"_3083":129030},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3632":75625,"_31224":75561,"_21643":129032,"_5":14891,"_28416":128819,"_3083":129033},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3632":75626,"_31224":75561,"_21643":129035,"_5":14891,"_28416":128819,"_3083":129036},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3632":75627,"_31224":75561,"_21643":129038,"_5":14891,"_28416":128823,"_3083":129039},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3632":75628,"_31224":75561,"_21643":129041,"_5":14891,"_28416":128823,"_3083":129042},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3632":75629,"_31224":75561,"_21643":129044,"_5":14891,"_28416":128823,"_3083":129045},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3632":75630,"_31224":75561,"_21643":129047,"_5":14891,"_28416":128823,"_3083":129048},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3632":75631,"_31224":75561,"_21643":129050,"_5":14891,"_28416":128823,"_3083":129051},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3632":75632,"_31224":75561,"_21643":129053,"_5":14891,"_28416":128823,"_3083":129054},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3632":75633,"_31224":75561,"_21643":129056,"_5":14891,"_28416":128827,"_3083":129057},[],"Cambio",{"_3632":75634,"_31224":75561,"_21643":129059,"_5":14891,"_28416":128827,"_3083":129060},[],"A quién afecta",{"_3632":75635,"_31224":75561,"_21643":129062,"_5":14891,"_28416":128827,"_3083":129063},[],"Gravedad",{"_3632":75636,"_31224":75561,"_21643":129065,"_5":14891,"_28416":128827,"_3083":127536},[],{"_3632":75637,"_31224":75561,"_21643":129067,"_5":14891,"_28416":128827,"_3083":128835},[],{"_3632":75638,"_31224":75561,"_21643":129069,"_5":14891,"_28416":128827,"_3083":129070},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3632":75639,"_31224":75561,"_21643":129072,"_5":14891,"_28416":128827,"_3083":129073},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3632":75640,"_31224":75561,"_21643":129075,"_5":14891,"_28416":128827,"_3083":129076},[],"Copiar los datos a los volúmenes nuevos",{"_3632":75641,"_31224":75561,"_21643":129078,"_5":14891,"_28416":128827,"_3083":128839},[],{"_3632":75642,"_31224":75561,"_21643":129080,"_5":14891,"_28416":128827,"_3083":129081},[],"Todas las releases de Helm",{"_3632":75643,"_31224":75561,"_21643":129083,"_5":14891,"_28416":128827,"_3083":129084},[],"Alta: `helm upgrade` falla",{"_3632":75644,"_31224":75561,"_21643":129086,"_5":14891,"_28416":128827,"_3083":129087},[],"Eliminar o renombrar las claves heredadas",{"_3632":75645,"_31224":75561,"_21643":129089,"_5":14891,"_28416":128827,"_3083":121190},[],{"_3632":75646,"_31224":75561,"_21643":129091,"_5":14891,"_28416":128827,"_3083":129081},[],{"_3632":75647,"_31224":75561,"_21643":129093,"_5":14891,"_28416":128827,"_3083":129094},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3632":75648,"_31224":75561,"_21643":129096,"_5":14891,"_28416":128827,"_3083":129097},[],"Crear primero los Secrets; consulta el paso 2",{"_3632":75649,"_31224":75561,"_21643":129099,"_5":14891,"_28416":128827,"_3083":128846},[],{"_3632":75650,"_31224":75561,"_21643":129101,"_5":14891,"_28416":128827,"_3083":129102},[],"Todos los despliegues",{"_3632":75651,"_31224":75561,"_21643":129104,"_5":14891,"_28416":128827,"_3083":129105},[],"Alta: sin principal de bootstrap no hay administrador",{"_3632":75652,"_31224":75561,"_21643":129107,"_5":14891,"_28416":128827,"_3083":129108},[],"Configurar `services.authz`",{"_3632":75653,"_31224":75561,"_21643":129110,"_5":14891,"_28416":128827,"_3083":128850},[],{"_3632":75654,"_31224":75561,"_21643":129112,"_5":14891,"_28416":128827,"_3083":129081},[],{"_3632":75655,"_31224":75561,"_21643":129114,"_5":14891,"_28416":128827,"_3083":129115},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3632":75656,"_31224":75561,"_21643":129117,"_5":14891,"_28416":128827,"_3083":129118},[],"Mover JWKS y roles a `services.authz`",{"_3632":75657,"_31224":75561,"_21643":129120,"_5":14891,"_28416":128827,"_3083":128870},[],{"_3632":75658,"_31224":75561,"_21643":129122,"_5":14891,"_28416":128827,"_3083":129123},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3632":75659,"_31224":75561,"_21643":129125,"_5":14891,"_28416":128827,"_3083":129126},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3632":75660,"_31224":75561,"_21643":129128,"_5":14891,"_28416":128827,"_3083":129129},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3632":75661,"_31224":75561,"_21643":129131,"_5":14891,"_28416":128827,"_3083":128874},[],{"_3632":75662,"_31224":75561,"_21643":129133,"_5":14891,"_28416":128827,"_3083":129134},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3632":75663,"_31224":75561,"_21643":129136,"_5":14891,"_28416":128827,"_3083":129137},[],"Alta: el backend ya no arranca con ellos",{"_3632":75664,"_31224":75561,"_21643":129139,"_5":14891,"_28416":128827,"_3083":129140},[],"Pasar a PostgreSQL antes de actualizar",{"_3632":75665,"_31224":75561,"_21643":129142,"_5":14891,"_28416":128827,"_3083":128922},[],{"_3632":75666,"_31224":75561,"_21643":129144,"_5":14891,"_28416":128827,"_3083":129145},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3632":75667,"_31224":75561,"_21643":129147,"_5":14891,"_28416":128827,"_3083":129148},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3632":75668,"_31224":75561,"_21643":129150,"_5":14891,"_28416":128827,"_3083":129151},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3632":75669,"_31224":75561,"_21643":129153,"_5":14891,"_28416":128827,"_3083":129154},[],"Webhooks con referencias a archivos",{"_3632":75670,"_31224":75561,"_21643":129156,"_5":14891,"_28416":128827,"_3083":129157},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3632":75671,"_31224":75561,"_21643":129159,"_5":14891,"_28416":128827,"_3083":129160},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3632":75672,"_31224":75561,"_21643":129162,"_5":14891,"_28416":128827,"_3083":129163},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3632":75673,"_31224":75561,"_21643":129165,"_5":14891,"_28416":128827,"_3083":128854},[],{"_3632":75674,"_31224":75561,"_21643":129167,"_5":14891,"_28416":128827,"_3083":129168},[],"Releases con identidades por servicio o material de claves montado",{"_3632":75675,"_31224":75561,"_21643":129170,"_5":14891,"_28416":128827,"_3083":129171},[],"Media: los servicios no pueden leer sus archivos",{"_3632":75676,"_31224":75561,"_21643":129173,"_5":14891,"_28416":128827,"_3083":129174},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3632":75677,"_31224":75561,"_21643":129176,"_5":14891,"_28416":128827,"_3083":128858},[],{"_3632":75678,"_31224":75561,"_21643":129178,"_5":14891,"_28416":128827,"_3083":129179},[],"Releases que definen `amqp.tls`",{"_3632":75679,"_31224":75561,"_21643":129181,"_5":14891,"_28416":128827,"_3083":129182},[],"Media: los clientes se conectan al puerto equivocado",{"_3632":75680,"_31224":75561,"_21643":129184,"_5":14891,"_28416":128827,"_3083":129185},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3632":75681,"_31224":75561,"_21643":129187,"_5":14891,"_28416":128827,"_3083":128878},[],{"_3632":75682,"_31224":75561,"_21643":129189,"_5":14891,"_28416":128827,"_3083":129190},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3632":75683,"_31224":75561,"_21643":129192,"_5":14891,"_28416":128827,"_3083":129193},[],"Media: las claves de CA quedan sin gestionar",{"_3632":75684,"_31224":75561,"_21643":129195,"_5":14891,"_28416":128827,"_3083":129196},[],"Ejecutar la migración de CA a KMS",{"_3632":75685,"_31224":75561,"_21643":129198,"_5":14891,"_28416":128827,"_3083":129199},[],"Verificación del certificado del receptor",{"_3632":75686,"_31224":75561,"_21643":129201,"_5":14891,"_28416":128827,"_3083":129202},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3632":75687,"_31224":75561,"_21643":129204,"_5":14891,"_28416":128827,"_3083":129205},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3632":75688,"_31224":75561,"_21643":129207,"_5":14891,"_28416":128827,"_3083":129208},[],"Poner `insecure_skip_verify` a `false`",{"_3632":75689,"_31224":75561,"_21643":129210,"_5":14891,"_28416":128827,"_3083":128894},[],{"_3632":75690,"_31224":75561,"_21643":129212,"_5":14891,"_28416":128827,"_3083":129213},[],"Scripts y consolas que editan DMS por API",{"_3632":75691,"_31224":75561,"_21643":129215,"_5":14891,"_28416":128827,"_3083":129216},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3632":75692,"_31224":75561,"_21643":129218,"_5":14891,"_28416":128827,"_3083":129219},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3632":75693,"_31224":75561,"_21643":129221,"_5":14891,"_28416":128827,"_3083":128898},[],{"_3632":75694,"_31224":75561,"_21643":129223,"_5":14891,"_28416":128827,"_3083":129224},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3632":75695,"_31224":75561,"_21643":129226,"_5":14891,"_28416":128827,"_3083":129227},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3632":75696,"_31224":75561,"_21643":129229,"_5":14891,"_28416":128827,"_3083":129230},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3632":75697,"_31224":75561,"_21643":129232,"_5":14891,"_28416":128827,"_3083":128918},[],{"_3632":75698,"_31224":75561,"_21643":129234,"_5":14891,"_28416":128827,"_3083":129235},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3632":75699,"_31224":75561,"_21643":129237,"_5":14891,"_28416":128827,"_3083":129238},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3632":75700,"_31224":75561,"_21643":129240,"_5":14891,"_28416":128827,"_3083":129241},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3632":75701,"_31224":75561,"_21643":129243,"_5":14891,"_28416":128827,"_3083":128926},[],{"_3632":75702,"_31224":75561,"_21643":129245,"_5":14891,"_28416":128827,"_3083":129246},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3632":75703,"_31224":75561,"_21643":129248,"_5":14891,"_28416":128827,"_3083":129249},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3632":75704,"_31224":75561,"_21643":129251,"_5":14891,"_28416":128827,"_3083":129252},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3632":75705,"_31224":75561,"_21643":129254,"_5":14891,"_28416":128827,"_3083":128930},[],{"_3632":75706,"_31224":75561,"_21643":129256,"_5":14891,"_28416":128827,"_3083":129257},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3632":75707,"_31224":75561,"_21643":129259,"_5":14891,"_28416":128827,"_3083":129260},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3632":75708,"_31224":75561,"_21643":129262,"_5":14891,"_28416":128827,"_3083":129263},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3632":75709,"_31224":75561,"_21643":129265,"_5":14891,"_28416":128827,"_3083":128914},[],{"_3632":75710,"_31224":75561,"_21643":129267,"_5":14891,"_28416":128827,"_3083":129268},[],"Consumidores que leen el campo `events` del dispositivo",{"_3632":75711,"_31224":75561,"_21643":129270,"_5":14891,"_28416":128827,"_3083":129271},[],"Media: el campo desaparece",{"_3632":75712,"_31224":75561,"_21643":129273,"_5":14891,"_28416":128827,"_3083":129274},[],"Usar los nuevos endpoints de eventos",{"_3632":75713,"_31224":75561,"_21643":129276,"_5":14891,"_28416":128827,"_3083":128942},[],{"_3632":75714,"_31224":75561,"_21643":129278,"_5":14891,"_28416":128827,"_3083":129279},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3632":75715,"_31224":75561,"_21643":129281,"_5":14891,"_28416":128827,"_3083":129282},[],"Media: la migración de la VA aborta",{"_3632":75716,"_31224":75561,"_21643":129284,"_5":14891,"_28416":128827,"_3083":129285},[],"Corregir los roles afectados antes de actualizar",{"_3632":75717,"_31224":75561,"_21643":129287,"_5":14891,"_28416":128827,"_3083":128862},[],{"_3632":75718,"_31224":75561,"_21643":129289,"_5":14891,"_28416":128827,"_3083":129290},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3632":75719,"_31224":75561,"_21643":129292,"_5":14891,"_28416":128827,"_3083":129293},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3632":75720,"_31224":75561,"_21643":129295,"_5":14891,"_28416":128827,"_3083":129296},[],"Actualizar el archivo de values",{"_3632":75721,"_31224":75561,"_21643":129298,"_5":14891,"_28416":128827,"_3083":128906},[],{"_3632":75722,"_31224":75561,"_21643":129300,"_5":14891,"_28416":128827,"_3083":129301},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3632":75723,"_31224":75561,"_21643":129303,"_5":14891,"_28416":128827,"_3083":129304},[],"Baja: prevalece el ID de la URL",{"_3632":75724,"_31224":75561,"_21643":129306,"_5":14891,"_28416":128827,"_3083":129307},[],"Enviar el ID en la URL",{"_3632":75725,"_31224":75561,"_21643":129309,"_5":14891,"_28416":128827,"_3083":128934},[],{"_3632":75726,"_31224":75561,"_21643":129311,"_5":14891,"_28416":128827,"_3083":129312},[],"Clientes que envían un `id` al crear o importar CAs",{"_3632":75727,"_31224":75561,"_21643":129314,"_5":14891,"_28416":128827,"_3083":129315},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3632":75728,"_31224":75561,"_21643":129317,"_5":14891,"_28416":128827,"_3083":129318},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3632":75729,"_31224":75561,"_21643":129320,"_5":14891,"_28416":128827,"_3083":128938},[],{"_3632":75730,"_31224":75561,"_21643":129322,"_5":14891,"_28416":128827,"_3083":129323},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3632":75731,"_31224":75561,"_21643":129325,"_5":14891,"_28416":128827,"_3083":129326},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3632":75732,"_31224":75561,"_21643":129328,"_5":14891,"_28416":128827,"_3083":129329},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3632":75733,"_31224":75561,"_21643":129331,"_5":14891,"_28416":128827,"_3083":128910},[],{"_3632":75734,"_31224":75561,"_21643":129333,"_5":14891,"_28416":128827,"_3083":129334},[],"Consumidores que comparan el `type` del certificado",{"_3632":75735,"_31224":75561,"_21643":129336,"_5":14891,"_28416":128827,"_3083":129337},[],"Baja: dos valores cambian de nombre",{"_3632":75736,"_31224":75561,"_21643":129339,"_5":14891,"_28416":128827,"_3083":129340},[],"Adaptar los consumidores",{"_3632":75737,"_31224":75561,"_21643":129342,"_5":14891,"_28416":128827,"_3083":128902},[],{"_3632":75738,"_31224":75561,"_21643":129344,"_5":14891,"_28416":128827,"_3083":129345},[],"Cualquier DMS",{"_3632":75739,"_31224":75561,"_21643":129347,"_5":14891,"_28416":128827,"_3083":129348},[],"Baja: solo informativo",{"_3632":75740,"_31224":75561,"_21643":129350,"_5":14891,"_28416":128827,"_3083":129351},[],"Revisar ambos bloques antes de editar",{"_3632":75741,"_31224":75561,"_21643":129353,"_5":14891,"_28416":128834,"_3083":129354},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3632":75742,"_31224":75561,"_21643":129356,"_5":14891,"_28416":128834,"_3083":129357},[],"El paso 4 de la guía de migración copia los datos.",{"_3632":75743,"_31224":75561,"_21643":129359,"_5":14891,"_28416":128838,"_3083":129360},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3632":75744,"_31224":75561,"_21643":129362,"_5":14891,"_28416":128842,"_3083":129363},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3632":75745,"_31224":75561,"_21643":129365,"_5":14891,"_28416":128842,"_3083":129366},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3632":75746,"_31224":75561,"_21643":129368,"_5":14891,"_28416":128845,"_3083":129369},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3632":75747,"_31224":75561,"_21643":129371,"_5":14891,"_28416":128849,"_3083":129372},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3632":75748,"_31224":75561,"_21643":129374,"_5":14891,"_28416":128853,"_3083":129375},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3632":75749,"_31224":75561,"_21643":129377,"_5":14891,"_28416":128853,"_3083":129378},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3632":75750,"_31224":75561,"_21643":129380,"_5":14891,"_28416":128853,"_3083":129381},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3632":75751,"_31224":75561,"_21643":129383,"_5":14891,"_28416":128857,"_3083":129384},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3632":75752,"_31224":75561,"_21643":129386,"_5":14891,"_28416":128861,"_3083":129387},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3632":75753,"_31224":75561,"_21643":129389,"_5":14891,"_28416":128861,"_3083":129390},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3632":75754,"_31224":75561,"_21643":129392,"_5":14891,"_28416":128861,"_3083":129393},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3632":75755,"_31224":75561,"_21643":129395,"_5":14891,"_28416":128861,"_3083":129396},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3632":75756,"_31224":75561,"_21643":129398,"_5":14891,"_28416":128861,"_3083":129399},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3632":75757,"_31224":75561,"_21643":129401,"_5":14891,"_28416":128861,"_3083":129402},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3632":75758,"_31224":75561,"_21643":129404,"_5":14891,"_28416":128869,"_3083":129405},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3632":75759,"_31224":75561,"_21643":129407,"_5":14891,"_28416":128869,"_3083":129408},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3632":75760,"_31224":75561,"_21643":129410,"_5":14891,"_28416":128869,"_3083":129411},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3632":75761,"_31224":75561,"_21643":129413,"_5":14891,"_28416":128869,"_3083":129414},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3632":75762,"_31224":75561,"_21643":129416,"_5":14891,"_28416":128869,"_3083":129417},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3632":75763,"_31224":75561,"_21643":129419,"_5":14891,"_28416":128873,"_3083":129420},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3632":75764,"_31224":75561,"_21643":129422,"_5":14891,"_28416":128877,"_3083":129423},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3632":75765,"_31224":75561,"_21643":129425,"_5":14891,"_28416":128877,"_3083":129426},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3632":75766,"_31224":75561,"_21643":129428,"_5":14891,"_28416":128877,"_3083":129429},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3632":75767,"_31224":75561,"_21643":129431,"_5":14891,"_28416":128877,"_3083":129432},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3632":75768,"_31224":75561,"_21643":129434,"_5":14891,"_28416":128877,"_3083":129435},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3632":75769,"_31224":75561,"_21643":129437,"_5":14891,"_28416":128877,"_3083":129438},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3632":75770,"_31224":75561,"_21643":129440,"_5":14891,"_28416":128877,"_3083":129441},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3632":75771,"_31224":75561,"_21643":129443,"_5":14891,"_28416":128877,"_3083":129444},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3632":75772,"_31224":75561,"_21643":129446,"_5":14891,"_28416":128881,"_3083":129447},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3632":75773,"_31224":75561,"_21643":129449,"_5":14891,"_28416":128889,"_3083":129450},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3632":75774,"_31224":75561,"_21643":129452,"_5":14891,"_28416":128889,"_3083":129453},[],"Campo en 3.8.0",{"_3632":75775,"_31224":75561,"_21643":129455,"_5":14891,"_28416":128889,"_3083":129456},[],"Campo en 4.0.0",{"_3632":75776,"_31224":75561,"_21643":129458,"_5":14891,"_28416":128889,"_3083":60135},[],{"_3632":75777,"_31224":75561,"_21643":129460,"_5":14891,"_28416":128889,"_3083":129461},[],"`insecure_skip_verify` (con el valor negado)",{"_3632":75778,"_31224":75561,"_21643":129463,"_5":14891,"_28416":128889,"_3083":60141},[],{"_3632":75779,"_31224":75561,"_21643":129465,"_5":14891,"_28416":128889,"_3083":60144},[],{"_3632":75780,"_31224":75561,"_21643":129467,"_5":14891,"_28416":128889,"_3083":60147},[],{"_3632":75781,"_31224":75561,"_21643":129469,"_5":14891,"_28416":128889,"_3083":60150},[],{"_3632":75782,"_31224":75561,"_21643":129471,"_5":14891,"_28416":128889,"_3083":60153},[],{"_3632":75783,"_31224":75561,"_21643":129473,"_5":14891,"_28416":128889,"_3083":60156},[],{"_3632":75784,"_31224":75561,"_21643":129475,"_5":14891,"_28416":128889,"_3083":129476},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3632":75785,"_31224":75561,"_21643":129478,"_5":14891,"_28416":128889,"_3083":129479},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3632":75786,"_31224":75561,"_21643":129481,"_5":14891,"_28416":128889,"_3083":129482},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3632":75787,"_31224":75561,"_21643":129484,"_5":14891,"_28416":128893,"_3083":129485},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3632":75788,"_31224":75561,"_21643":129487,"_5":14891,"_28416":128893,"_3083":129488},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3632":75789,"_31224":75561,"_21643":129490,"_5":14891,"_28416":128893,"_3083":129491},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3632":75790,"_31224":75561,"_21643":129493,"_5":14891,"_28416":128897,"_3083":129494},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3632":75791,"_31224":75561,"_21643":129496,"_5":14891,"_28416":128897,"_3083":129497},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3632":75792,"_31224":75561,"_21643":129499,"_5":14891,"_28416":128901,"_3083":129500},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3632":75793,"_31224":75561,"_21643":129502,"_5":14891,"_28416":128905,"_3083":129503},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3632":75794,"_31224":75561,"_21643":129505,"_5":14891,"_28416":128909,"_3083":129506},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3632":75795,"_31224":75561,"_21643":129508,"_5":14891,"_28416":128913,"_3083":129509},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3632":75796,"_31224":75561,"_21643":129511,"_5":14891,"_28416":128913,"_3083":129512},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3632":75797,"_31224":75561,"_21643":129514,"_5":14891,"_28416":128913,"_3083":129515},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3632":75798,"_31224":75561,"_21643":129517,"_5":14891,"_28416":128913,"_3083":129518},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3632":75799,"_31224":75561,"_21643":129520,"_5":14891,"_28416":128917,"_3083":129521},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3632":75800,"_31224":75561,"_21643":129523,"_5":14891,"_28416":128921,"_3083":129524},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3632":75801,"_31224":75561,"_21643":129526,"_5":14891,"_28416":128921,"_3083":129527},[],"Ruta",{"_3632":75802,"_31224":75561,"_21643":129529,"_5":14891,"_28416":128921,"_3083":121821},[],{"_3632":75803,"_31224":75561,"_21643":129531,"_5":14891,"_28416":128921,"_3083":60215},[],{"_3632":75804,"_31224":75561,"_21643":129533,"_5":14891,"_28416":128921,"_3083":129534},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3632":75805,"_31224":75561,"_21643":129536,"_5":14891,"_28416":128921,"_3083":60221},[],{"_3632":75806,"_31224":75561,"_21643":129538,"_5":14891,"_28416":128921,"_3083":129539},[],"Lee los ajustes de una CA.",{"_3632":75807,"_31224":75561,"_21643":129541,"_5":14891,"_28416":128921,"_3083":60227},[],{"_3632":75808,"_31224":75561,"_21643":129543,"_5":14891,"_28416":128921,"_3083":129544},[],"Sustituye los `crl_options`.",{"_3632":75809,"_31224":75561,"_21643":129546,"_5":14891,"_28416":128921,"_3083":60233},[],{"_3632":75810,"_31224":75561,"_21643":129548,"_5":14891,"_28416":128921,"_3083":129549},[],"Elimina los ajustes archivados de una CA.",{"_3632":75811,"_31224":75561,"_21643":129551,"_5":14891,"_28416":128921,"_3083":129552},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3632":75812,"_31224":75561,"_21643":129554,"_5":14891,"_28416":128921,"_3083":129555},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3632":75813,"_31224":75561,"_21643":129557,"_5":14891,"_28416":128921,"_3083":129558},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3632":75814,"_31224":75561,"_21643":129560,"_5":14891,"_28416":128921,"_3083":129561},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3632":75815,"_31224":75561,"_21643":129563,"_5":14891,"_28416":128921,"_3083":129564},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3632":75816,"_31224":75561,"_21643":129566,"_5":14891,"_28416":128921,"_3083":129567},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3632":75817,"_31224":75561,"_21643":129569,"_5":14891,"_28416":128921,"_3083":129570},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3632":75818,"_31224":75561,"_21643":129572,"_5":14891,"_28416":128921,"_3083":129573},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3632":75819,"_31224":75561,"_21643":129575,"_5":14891,"_28416":128921,"_3083":129576},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3632":75820,"_31224":75561,"_21643":129578,"_5":14891,"_28416":128921,"_3083":129579},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3632":75821,"_31224":75561,"_21643":129581,"_5":14891,"_28416":128921,"_3083":129582},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3632":75822,"_31224":75561,"_21643":129584,"_5":14891,"_28416":128925,"_3083":129585},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3632":75823,"_31224":75561,"_21643":129587,"_5":14891,"_28416":128929,"_3083":129588},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3632":75824,"_31224":75561,"_21643":129590,"_5":14891,"_28416":128933,"_3083":129591},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3632":75825,"_31224":75561,"_21643":129593,"_5":14891,"_28416":128937,"_3083":129594},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3632":75826,"_31224":75561,"_21643":129596,"_5":14891,"_28416":128937,"_3083":129597},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3632":75827,"_31224":75561,"_21643":129599,"_5":14891,"_28416":128941,"_3083":129600},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3632":75828,"_31224":75561,"_21643":129602,"_5":14891,"_28416":128945,"_3083":129603},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3632":75829,"_31224":75561,"_21643":129605,"_5":14891,"_28416":128949,"_3083":129606},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3632":75830,"_31224":75561,"_21643":129608,"_5":14891,"_28416":128949,"_3083":129609},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3632":75831,"_31224":75561,"_21643":129611,"_5":14891,"_28416":128949,"_3083":129612},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3632":75832,"_31224":75561,"_21643":129614,"_5":14891,"_28416":128949,"_3083":129615},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3632":75833,"_31224":75561,"_21643":129617,"_5":14891,"_28416":128949,"_3083":129618},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3632":75834,"_31224":75561,"_21643":129620,"_5":14891,"_28416":128949,"_3083":129621},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3632":75835,"_31224":75561,"_21643":129623,"_5":14891,"_28416":128953,"_3083":129624},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3632":75836,"_31224":75561,"_21643":129626,"_5":14891,"_28416":128953,"_3083":129627},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3632":75837,"_31224":75561,"_21643":129629,"_5":14891,"_28416":128953,"_3083":129630},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3632":75838,"_31224":75561,"_21643":129632,"_5":14891,"_28416":128953,"_3083":129633},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3632":75839,"_31224":75561,"_21643":129635,"_5":14891,"_28416":128953,"_3083":129636},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3632":75840,"_31224":75561,"_21643":129638,"_5":14891,"_28416":128957,"_3083":129639},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3632":75841,"_31224":75561,"_21643":129641,"_5":14891,"_28416":128957,"_3083":129642},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3632":75842,"_31224":75561,"_21643":129644,"_5":14891,"_28416":128957,"_3083":129645},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3632":75843,"_31224":75561,"_21643":129647,"_5":14891,"_28416":128957,"_3083":60335},[],{"_3632":75844,"_31224":75561,"_21643":129649,"_5":14891,"_28416":128957,"_3083":129650},[],"Claves de datos obligatorias",{"_3632":75845,"_31224":75561,"_21643":129652,"_5":14891,"_28416":128957,"_3083":129653},[],"Cuándo",{"_3632":75846,"_31224":75561,"_21643":129655,"_5":14891,"_28416":128957,"_3083":129656},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3632":75847,"_31224":75561,"_21643":129658,"_5":14891,"_28416":128957,"_3083":60347},[],{"_3632":75848,"_31224":75561,"_21643":129660,"_5":14891,"_28416":128957,"_3083":129661},[],"Siempre",{"_3632":75849,"_31224":75561,"_21643":129663,"_5":14891,"_28416":128957,"_3083":129664},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3632":75850,"_31224":75561,"_21643":129666,"_5":14891,"_28416":128957,"_3083":60347},[],{"_3632":75851,"_31224":75561,"_21643":129668,"_5":14891,"_28416":128957,"_3083":129661},[],{"_3632":75852,"_31224":75561,"_21643":129670,"_5":14891,"_28416":128957,"_3083":60360},[],{"_3632":75853,"_31224":75561,"_21643":129672,"_5":14891,"_28416":128957,"_3083":60347},[],{"_3632":75854,"_31224":75561,"_21643":129674,"_5":14891,"_28416":128957,"_3083":129675},[],"Solo cuando hay autenticación SMTP",{"_3632":75855,"_31224":75561,"_21643":129677,"_5":14891,"_28416":128957,"_3083":129678},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3632":75856,"_31224":75561,"_21643":129680,"_5":14891,"_28416":128957,"_3083":129681},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3632":75857,"_31224":75561,"_21643":129683,"_5":14891,"_28416":128957,"_3083":129684},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3632":75858,"_31224":75561,"_21643":129686,"_5":14891,"_28416":128957,"_3083":129687},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3632":75859,"_31224":75561,"_21643":129689,"_5":14891,"_28416":128957,"_3083":129690},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3632":75860,"_31224":75561,"_21643":129692,"_5":14891,"_28416":128957,"_3083":129693},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3632":75861,"_31224":75561,"_21643":129695,"_5":14891,"_28416":128957,"_3083":129696},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3632":75862,"_31224":75561,"_21643":129698,"_5":14891,"_28416":128957,"_3083":129699},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3632":75863,"_31224":75561,"_21643":129701,"_5":14891,"_28416":128957,"_3083":129702},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3632":75864,"_31224":75561,"_21643":129704,"_5":14891,"_28416":128957,"_3083":129705},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3632":75865,"_31224":75561,"_21643":129707,"_5":14891,"_28416":128957,"_3083":129708},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3632":75866,"_31224":75561,"_21643":129710,"_5":14891,"_28416":128957,"_3083":129711},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3632":75867,"_31224":75561,"_21643":129713,"_5":14891,"_28416":128957,"_3083":129714},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3632":75868,"_31224":75561,"_21643":129716,"_5":14891,"_28416":128957,"_3083":129717},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3632":75869,"_31224":75561,"_21643":129719,"_5":14891,"_28416":128957,"_3083":129720},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3632":75870,"_31224":75561,"_21643":129722,"_5":14891,"_28416":128961,"_3083":129723},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3632":75871,"_31224":75561,"_21643":129725,"_5":14891,"_28416":128961,"_3083":129726},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3632":75872,"_31224":75561,"_21643":129728,"_5":14891,"_28416":128965,"_3083":129729},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3632":75873,"_31224":75561,"_21643":129731,"_5":14891,"_28416":128965,"_3083":129732},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3632":75874,"_31224":75561,"_21643":129734,"_5":14891,"_28416":128965,"_3083":129735},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3632":75875,"_31224":75561,"_21643":129737,"_5":14891,"_28416":128965,"_3083":129738},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3632":75876,"_31224":75561,"_21643":129740,"_5":14891,"_28416":128965,"_3083":129741},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3632":75877,"_31224":75561,"_21643":129743,"_5":14891,"_28416":128965,"_3083":129744},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3632":75878,"_31224":75561,"_21643":129746,"_5":14891,"_28416":128965,"_3083":129747},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3632":75879,"_31224":75561,"_21643":129749,"_5":14891,"_28416":128965,"_3083":129750},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3632":75880,"_31224":75561,"_21643":129752,"_5":14891,"_28416":128965,"_3083":129753},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3632":75881,"_31224":75561,"_21643":129755,"_5":14891,"_28416":128965,"_3083":129756},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3632":75882,"_31224":75561,"_21643":129758,"_5":14891,"_28416":128965,"_3083":129759},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3632":75883,"_31224":75561,"_21643":129761,"_5":14891,"_28416":128969,"_3083":129762},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3632":75884,"_31224":75561,"_21643":129764,"_5":14891,"_28416":128969,"_3083":129765},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3632":75885,"_31224":75561,"_21643":129767,"_5":14891,"_28416":128973,"_3083":129768},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3632":75886,"_31224":75561,"_21643":129770,"_5":14891,"_28416":128973,"_3083":129771},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3632":75887,"_31224":75561,"_21643":129773,"_5":14891,"_28416":128973,"_3083":129774},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3632":75888,"_31224":75561,"_21643":129776,"_5":14891,"_28416":128973,"_3083":129777},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3632":75889,"_31224":75561,"_21643":129779,"_5":14891,"_28416":128973,"_3083":129780},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3632":75890,"_31224":75561,"_21643":129782,"_5":14891,"_28416":128973,"_3083":129783},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3632":75891,"_31224":75561,"_21643":129785,"_5":14891,"_28416":128973,"_3083":129786},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3632":75892,"_31224":75561,"_21643":129788,"_5":14891,"_28416":128973,"_3083":129789},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3632":75893,"_31224":75561,"_21643":129791,"_5":14891,"_28416":128977,"_3083":129792},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3632":75894,"_31224":75561,"_21643":129794,"_5":14891,"_28416":128977,"_3083":129795},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3632":75895,"_31224":75561,"_21643":129797,"_5":14891,"_28416":128977,"_3083":129798},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3632":75896,"_31224":75561,"_21643":129800,"_5":14891,"_28416":128977,"_3083":129801},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3632":75897,"_31224":75561,"_21643":129803,"_5":14891,"_28416":128977,"_3083":129804},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3632":75898,"_31224":75561,"_21643":129806,"_5":14891,"_28416":128977,"_3083":129807},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3632":75899,"_31224":75561,"_21643":129809,"_5":14891,"_28416":128977,"_3083":129810},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3632":75900,"_31224":75561,"_21643":129812,"_5":14891,"_28416":128977,"_3083":129813},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3632":75901,"_31224":75561,"_21643":129815,"_5":14891,"_28416":128977,"_3083":129816},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3632":75902,"_31224":75561,"_21643":129818,"_5":14891,"_28416":128977,"_3083":129819},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3632":75903,"_31224":75561,"_21643":129821,"_5":14891,"_28416":128977,"_3083":129822},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3632":75904,"_31224":75561,"_21643":129824,"_5":14891,"_28416":128980,"_3083":129825},[],"Tras la actualización, comprueba en este orden:",{"_3632":75905,"_31224":75561,"_21643":129827,"_5":14891,"_28416":128980,"_3083":129828},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3632":75906,"_31224":75561,"_21643":129830,"_5":14891,"_28416":128980,"_3083":129831},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3632":75907,"_31224":75561,"_21643":129833,"_5":14891,"_28416":128980,"_3083":129834},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3632":75908,"_31224":75561,"_21643":129836,"_5":14891,"_28416":128980,"_3083":129837},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3632":75909,"_31224":75561,"_21643":129839,"_5":14891,"_28416":128980,"_3083":129840},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3632":75910,"_31224":75561,"_21643":129842,"_5":14891,"_28416":128980,"_3083":129843},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3632":75911,"_31224":75561,"_21643":129845,"_5":14891,"_28416":128980,"_3083":129846},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3632":75912,"_31224":75561,"_21643":129848,"_5":14891,"_28416":128980,"_3083":129849},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3632":75913,"_31224":75561,"_21643":129851,"_5":14891,"_28416":128980,"_3083":129852},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3632":75914,"_31224":75561,"_21643":129854,"_5":14891,"_28416":128980,"_3083":129855},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3632":75915,"_31224":75561,"_21643":129857,"_5":14891,"_28416":128980,"_3083":129858},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3632":75916,"_31224":75561,"_21643":129860,"_5":14891,"_28416":128980,"_3083":129861},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3632":75917,"_31224":75561,"_21643":129863,"_5":14891,"_28416":128980,"_3083":129864},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3632":75918,"_31224":75561,"_21643":129866,"_5":14891,"_28416":128980,"_3083":129867},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3632":75919,"_31224":75561,"_21643":129869,"_5":14891,"_28416":128980,"_3083":129870},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3632":75920,"_31224":75561,"_21643":129872,"_5":14891,"_28416":128984,"_3083":129873},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3632":75921,"_31224":75561,"_21643":129875,"_5":14891,"_28416":128984,"_3083":129876},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3632":75922,"_31224":75561,"_21643":129878,"_5":14891,"_28416":128984,"_3083":129879},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":75923,"_31224":75561,"_21643":129881,"_5":14891,"_28416":128984,"_3083":129882},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3632":75924,"_31224":75561,"_21643":129884,"_5":14891,"_28416":128984,"_3083":129885},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60578":129887,"_60580":129888,"_60582":129889,"_60584":129890,"_18771":3118,"_72855":3118},"spanish",[3083,31224,5,28416],{"_3083":25830,"_31224":25830,"_5":25830,"_28416":25830},{"_3083":129891,"_31224":132957,"_5":136023,"_28416":139089},{"_4836":129892,"_60588":129893,"_5":25830},{"_14972":12791,"_15351":13080,"_15370":3926,"_30224":6078,"_15357":4222,"