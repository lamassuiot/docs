0330,"_41601":60333,"_41603":60336,"_41605":60339,"_41607":60342,"_41609":60345,"_41611":60348,"_41613":60351,"_41615":60354,"_41617":60356,"_41619":60358,"_41621":60361,"_41623":60363,"_41625":60366,"_41627":60369,"_41629":60372,"_41631":60375,"_41633":60378,"_41635":60381,"_41637":60384,"_41639":60387,"_41641":60390,"_41643":60393,"_41645":60396,"_41647":60399,"_41649":60402,"_41651":60405,"_41653":60408,"_41655":60411,"_41657":60414,"_41659":60417,"_41661":60420,"_41663":60423,"_41666":60426,"_41668":60429,"_41670":60432,"_41672":60435,"_41674":60438,"_41676":60441,"_41678":60444,"_41680":60447,"_41682":60450,"_41684":60453,"_41686":60456,"_41688":60459,"_41690":60462,"_41692":60465,"_41695":60468,"_41697":60471,"_41699":60474,"_41701":60477,"_41703":60480,"_41705":60483,"_41707":60486,"_41709":60489,"_41711":60492,"_41713":60495,"_41715":60498,"_41717":60501,"_41719":60504,"_41721":60507,"_41723":60510,"_41725":60513,"_41727":60516,"_41729":60519,"_41731":60522,"_41733":60525,"_41735":60528,"_41737":60531,"_41739":60534,"_41741":60537,"_41743":60540,"_41745":60543,"_41747":60546,"_41749":60549,"_41751":60552,"_41753":60555,"_41755":60558,"_41757":60561,"_41760":60564,"_41762":60567,"_41764":60570,"_41766":60573},{"_3632":15,"_31224":15,"_5":15251,"_3083":51034,"_31583":51035,"_21643":51039,"_28416":15},"Deploy from AWS Marketplace",[51036,51037,51038],"Docs","Deployment","Other models",[],{"_3632":16,"_31224":15,"_21643":51041,"_5":14891,"_28416":15,"_3083":51042},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3632":17,"_31224":15,"_5":31580,"_21643":51044,"_28416":51045,"_3083":51046},[],"/docs/pr-preview/pr-82/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3632":18,"_31224":15,"_5":31580,"_21643":51048,"_28416":51049,"_3083":51050},[],"/docs/pr-preview/pr-82/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3632":19,"_31224":15,"_5":31580,"_21643":51052,"_28416":51053,"_3083":51054},[],"/docs/pr-preview/pr-82/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3632":20,"_31224":15,"_5":31580,"_21643":51056,"_28416":51057,"_3083":51058},[],"/docs/pr-preview/pr-82/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3632":21,"_31224":15,"_5":31580,"_21643":51060,"_28416":51061,"_3083":51062},[],"/docs/pr-preview/pr-82/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3632":22,"_31224":15,"_5":31580,"_21643":51064,"_28416":51065,"_3083":51066},[],"/docs/pr-preview/pr-82/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3632":23,"_31224":15,"_5":31580,"_21643":51068,"_28416":51069,"_3083":51070},[],"/docs/pr-preview/pr-82/deployment/aws-marketplace#next-step","Next step",{"_3632":24,"_31224":15,"_21643":51072,"_5":14891,"_28416":15,"_3083":51073},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3632":25,"_31224":15,"_21643":51075,"_5":14891,"_28416":51045,"_3083":51076},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3632":26,"_31224":15,"_21643":51078,"_5":14891,"_28416":51045,"_3083":51079},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3632":27,"_31224":15,"_21643":51081,"_5":14891,"_28416":51045,"_3083":51082},[],"A security group allowing the necessary endpoints.",{"_3632":28,"_31224":15,"_21643":51084,"_5":14891,"_28416":51049,"_3083":51085},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3632":29,"_31224":15,"_21643":51087,"_5":14891,"_28416":51049,"_3083":51088},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3632":30,"_31224":15,"_21643":51090,"_5":14891,"_28416":51049,"_3083":51091},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3632":31,"_31224":15,"_21643":51093,"_5":14891,"_28416":51053,"_3083":51094},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3632":32,"_31224":15,"_21643":51096,"_5":14891,"_28416":51057,"_3083":51097},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3632":33,"_31224":15,"_21643":51099,"_5":14891,"_28416":51061,"_3083":51100},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3632":34,"_31224":15,"_21643":51102,"_5":14891,"_28416":51065,"_3083":51103},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3632":35,"_31224":15,"_21643":51105,"_5":14891,"_28416":51069,"_3083":51106},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3632":36,"_31224":36,"_5":15251,"_3083":51108,"_31583":51109,"_21643":51110,"_28416":36},"Deploy Lamassu",[51036,51037],[],{"_3632":37,"_31224":36,"_21643":51112,"_5":14891,"_28416":36,"_3083":51113},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3632":38,"_31224":36,"_5":31580,"_21643":51115,"_28416":51116,"_3083":51117},[],"/docs/pr-preview/pr-82/deployment/overview#choose-a-model","Choose a model",{"_3632":39,"_31224":36,"_5":31580,"_21643":51119,"_28416":51120,"_3083":51121},[],"/docs/pr-preview/pr-82/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3632":40,"_31224":36,"_5":31580,"_21643":51123,"_28416":51124,"_3083":51125},[],"/docs/pr-preview/pr-82/deployment/overview#after-deployment","After deployment",{"_3632":41,"_31224":36,"_21643":51127,"_5":14891,"_28416":36,"_3083":51128},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3632":42,"_31224":36,"_21643":51130,"_5":14891,"_28416":51116,"_3083":51131},[],"Model",{"_3632":43,"_31224":36,"_21643":51133,"_5":14891,"_28416":51116,"_3083":51134},[],"Recommended for",{"_3632":44,"_31224":36,"_21643":51136,"_5":14891,"_28416":51116,"_3083":51137},[],"Who operates the infrastructure",{"_3632":45,"_31224":36,"_21643":51139,"_5":14891,"_28416":51116,"_3083":51140},[],"Starting point",{"_3632":46,"_31224":36,"_21643":51142,"_5":14891,"_28416":51116,"_3083":51143},[],"Kubernetes self-managed",{"_3632":47,"_31224":36,"_21643":51145,"_5":14891,"_28416":51116,"_3083":51146},[],"Production, regulated environments and custom deployments",{"_3632":48,"_31224":36,"_21643":51148,"_5":14891,"_28416":51116,"_3083":51149},[],"Your team",{"_3632":49,"_31224":36,"_21643":51151,"_5":14891,"_28416":51116,"_3083":51152},[],"Helm or Fastlane",{"_3632":50,"_31224":36,"_21643":51154,"_5":14891,"_28416":51116,"_3083":51155},[],"AWS Marketplace",{"_3632":51,"_31224":36,"_21643":51157,"_5":14891,"_28416":51116,"_3083":51158},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3632":52,"_31224":36,"_21643":51160,"_5":14891,"_28416":51116,"_3083":51149},[],{"_3632":53,"_31224":36,"_21643":51162,"_5":14891,"_28416":51116,"_3083":51163},[],"Preconfigured image on EC2",{"_3632":54,"_31224":36,"_21643":51165,"_5":14891,"_28416":51116,"_3083":51166},[],"SaaS",{"_3632":55,"_31224":36,"_21643":51168,"_5":14891,"_28416":51116,"_3083":51169},[],"Teams that want to use the platform without operating it",{"_3632":56,"_31224":36,"_21643":51171,"_5":14891,"_28416":51116,"_3083":51172},[],"Lamassu",{"_3632":57,"_31224":36,"_21643":51174,"_5":14891,"_28416":51116,"_3083":51175},[],"Managed subscription",{"_3632":58,"_31224":36,"_21643":51177,"_5":14891,"_28416":51116,"_3083":51178},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3632":59,"_31224":36,"_21643":51180,"_5":14891,"_28416":51116,"_3083":51181},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3632":60,"_31224":36,"_21643":51183,"_5":14891,"_28416":51116,"_3083":51184},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3632":61,"_31224":36,"_21643":51186,"_5":14891,"_28416":51120,"_3083":51187},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3632":62,"_31224":36,"_21643":51189,"_5":14891,"_28416":51124,"_3083":51190},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3632":63,"_31224":63,"_5":15251,"_3083":51192,"_31583":51193,"_21643":51194,"_28416":63},"Use Lamassu as SaaS",[51036,51037,51038],[],{"_3632":64,"_31224":63,"_21643":51196,"_5":14891,"_28416":63,"_3083":51197},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3632":65,"_31224":63,"_5":31580,"_21643":51199,"_28416":51200,"_3083":51201},[],"/docs/pr-preview/pr-82/deployment/saas#what-the-service-manages","What the service manages",{"_3632":66,"_31224":63,"_5":31580,"_21643":51203,"_28416":51204,"_3083":51205},[],"/docs/pr-preview/pr-82/deployment/saas#plans","Plans",{"_3632":67,"_31224":63,"_5":31580,"_21643":51207,"_28416":51208,"_3083":51209},[],"/docs/pr-preview/pr-82/deployment/saas#request-access","Request access",{"_3632":68,"_31224":63,"_21643":51211,"_5":14891,"_28416":63,"_3083":51212},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3632":69,"_31224":63,"_21643":51214,"_5":14891,"_28416":51200,"_3083":51215},[],"Platform availability and maintenance.",{"_3632":70,"_31224":63,"_21643":51217,"_5":14891,"_28416":51200,"_3083":51218},[],"Automatic backups.",{"_3632":71,"_31224":63,"_21643":51220,"_5":14891,"_28416":51200,"_3083":51221},[],"Version upgrades.",{"_3632":72,"_31224":63,"_21643":51223,"_5":14891,"_28416":51200,"_3083":51224},[],"Technical support and SLA according to your plan.",{"_3632":73,"_31224":63,"_21643":51226,"_5":14891,"_28416":51204,"_3083":51227},[],"Plan",{"_3632":74,"_31224":63,"_21643":51229,"_5":14891,"_28416":51204,"_3083":51230},[],"Devices",{"_3632":75,"_31224":63,"_21643":51232,"_5":14891,"_28416":51204,"_3083":51233},[],"Support",{"_3632":76,"_31224":63,"_21643":51235,"_5":14891,"_28416":51204,"_3083":51236},[],"SLA",{"_3632":77,"_31224":63,"_21643":51238,"_5":14891,"_28416":51204,"_3083":51239},[],"Starter",{"_3632":78,"_31224":63,"_21643":51241,"_5":14891,"_28416":51204,"_3083":51242},[],"Up to 1,000",{"_3632":79,"_31224":63,"_21643":51244,"_5":14891,"_28416":51204,"_3083":51245},[],"Email",{"_3632":80,"_31224":63,"_21643":51247,"_5":14891,"_28416":51204,"_3083":51248},[],"99.5 %",{"_3632":81,"_31224":63,"_21643":51250,"_5":14891,"_28416":51204,"_3083":51251},[],"Professional",{"_3632":82,"_31224":63,"_21643":51253,"_5":14891,"_28416":51204,"_3083":51254},[],"Up to 10,000",{"_3632":83,"_31224":63,"_21643":51256,"_5":14891,"_28416":51204,"_3083":51257},[],"Email and chat",{"_3632":84,"_31224":63,"_21643":51259,"_5":14891,"_28416":51204,"_3083":51260},[],"99.9 %",{"_3632":85,"_31224":63,"_21643":51262,"_5":14891,"_28416":51204,"_3083":51263},[],"Enterprise",{"_3632":86,"_31224":63,"_21643":51265,"_5":14891,"_28416":51204,"_3083":51266},[],"Unlimited",{"_3632":87,"_31224":63,"_21643":51268,"_5":14891,"_28416":51204,"_3083":51269},[],"Dedicated",{"_3632":88,"_31224":63,"_21643":51271,"_5":14891,"_28416":51204,"_3083":51272},[],"99.99 %",{"_3632":89,"_31224":63,"_21643":51274,"_5":14891,"_28416":51208,"_3083":51275},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3632":90,"_31224":63,"_21643":51277,"_5":14891,"_28416":51208,"_3083":51278},[],"When you receive your instance's credentials, continue with Get started.",{"_3632":91,"_31224":91,"_5":15251,"_3083":51280,"_31583":51281,"_21643":51282,"_28416":91},"Fastlane",[51036,51037,51143],[],{"_3632":92,"_31224":91,"_21643":51284,"_5":14891,"_28416":91,"_3083":51285},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3632":93,"_31224":91,"_5":31580,"_21643":51287,"_28416":51288,"_3083":51289},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3632":94,"_31224":91,"_5":31580,"_21643":51291,"_28416":51292,"_3083":51293},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3632":95,"_31224":91,"_5":31580,"_21643":51295,"_28416":51296,"_3083":51046},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#before-you-begin",{"_3632":96,"_31224":91,"_5":31580,"_21643":51298,"_28416":51299,"_3083":51300},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3632":97,"_31224":91,"_5":31580,"_21643":51302,"_28416":51303,"_3083":51304},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3632":98,"_31224":91,"_5":31580,"_21643":51306,"_28416":51307,"_3083":51308},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3632":99,"_31224":91,"_5":31580,"_21643":51310,"_28416":51311,"_3083":51312},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3632":100,"_31224":91,"_5":31580,"_21643":51314,"_28416":51315,"_3083":51316},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3632":101,"_31224":91,"_5":31580,"_21643":51318,"_28416":51319,"_3083":51320},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3632":102,"_31224":91,"_5":31580,"_21643":51322,"_28416":51323,"_3083":51324},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3632":103,"_31224":91,"_5":31580,"_21643":51326,"_28416":51327,"_3083":51328},[],"/docs/pr-preview/pr-82/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3632":104,"_31224":91,"_21643":51330,"_5":14891,"_28416":51288,"_3083":51331},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3632":105,"_31224":91,"_21643":51333,"_5":14891,"_28416":51288,"_3083":51334},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3632":106,"_31224":91,"_21643":51336,"_5":14891,"_28416":51292,"_3083":51337},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3632":107,"_31224":91,"_21643":51339,"_5":14891,"_28416":51292,"_3083":51340},[],"Fastlane installs or configures",{"_3632":108,"_31224":91,"_21643":51342,"_5":14891,"_28416":51292,"_3083":51343},[],"You still provide",{"_3632":109,"_31224":91,"_21643":51345,"_5":14891,"_28416":51292,"_3083":51346},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3632":110,"_31224":91,"_21643":51348,"_5":14891,"_28416":51292,"_3083":51349},[],"The Kubernetes cluster, nodes and persistent storage",{"_3632":111,"_31224":91,"_21643":51351,"_5":14891,"_28416":51292,"_3083":51352},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3632":112,"_31224":91,"_21643":51354,"_5":14891,"_28416":51292,"_3083":51355},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3632":113,"_31224":91,"_21643":51357,"_5":14891,"_28416":51292,"_3083":51358},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3632":114,"_31224":91,"_21643":51360,"_5":14891,"_28416":51292,"_3083":51361},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3632":115,"_31224":91,"_21643":51363,"_5":14891,"_28416":51292,"_3083":51364},[],"Optional observability and lab HSM components",{"_3632":116,"_31224":91,"_21643":51366,"_5":14891,"_28416":51292,"_3083":51367},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3632":117,"_31224":91,"_21643":51369,"_5":14891,"_28416":51292,"_3083":51370},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3632":118,"_31224":91,"_21643":51372,"_5":14891,"_28416":51296,"_3083":51373},[],"You need:",{"_3632":119,"_31224":91,"_21643":51375,"_5":14891,"_28416":51296,"_3083":51376},[],"an existing Kubernetes cluster",{"_3632":120,"_31224":91,"_21643":51378,"_5":14891,"_28416":51296,"_3083":51379},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3632":121,"_31224":91,"_21643":51381,"_5":14891,"_28416":51296,"_3083":51382},[],"`yq`",{"_3632":122,"_31224":91,"_21643":51384,"_5":14891,"_28416":51296,"_3083":24456},[],{"_3632":123,"_31224":91,"_21643":51386,"_5":14891,"_28416":51296,"_3083":51387},[],"`jq` only when using `--sample-data` or `--development`",{"_3632":124,"_31224":91,"_21643":51389,"_5":14891,"_28416":51296,"_3083":51390},[],"`ssh-keygen` only when using `--with-hsm`",{"_3632":125,"_31224":91,"_21643":51392,"_5":14891,"_28416":51296,"_3083":51393},[],"free external ports 80 and 443 on a single-node K3s host",{"_3632":126,"_31224":91,"_21643":51395,"_5":14891,"_28416":51296,"_3083":51396},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3632":127,"_31224":91,"_21643":51398,"_5":14891,"_28416":51296,"_3083":51399},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3632":128,"_31224":91,"_21643":51401,"_5":14891,"_28416":51299,"_3083":51402},[],"Run the script from a clone of the Helm repository:",{"_3632":129,"_31224":91,"_21643":51404,"_5":14891,"_28416":51299,"_3083":51405},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3632":130,"_31224":91,"_21643":51407,"_5":14891,"_28416":51303,"_3083":51408},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3632":131,"_31224":91,"_21643":51410,"_5":14891,"_28416":51303,"_3083":51411},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3632":132,"_31224":91,"_21643":51413,"_5":14891,"_28416":51303,"_3083":51414},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3632":133,"_31224":91,"_21643":51416,"_5":14891,"_28416":51303,"_3083":51417},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3632":134,"_31224":91,"_21643":51419,"_5":14891,"_28416":51307,"_3083":51420},[],"Option",{"_3632":135,"_31224":91,"_21643":51422,"_5":14891,"_28416":51307,"_3083":51423},[],"Default",{"_3632":136,"_31224":91,"_21643":51425,"_5":14891,"_28416":51307,"_3083":51426},[],"Purpose",{"_3632":137,"_31224":91,"_21643":51428,"_5":14891,"_28416":51307,"_3083":51429},[],"`-h`, `--help`",{"_3632":138,"_31224":91,"_21643":51431,"_5":14891,"_28416":51307,"_3083":51432},[],"—",{"_3632":139,"_31224":91,"_21643":51434,"_5":14891,"_28416":51307,"_3083":51435},[],"Show help",{"_3632":140,"_31224":91,"_21643":51437,"_5":14891,"_28416":51307,"_3083":51438},[],"`-c`, `--context`",{"_3632":141,"_31224":91,"_21643":51440,"_5":14891,"_28416":51307,"_3083":51441},[],"current context",{"_3632":142,"_31224":91,"_21643":51443,"_5":14891,"_28416":51307,"_3083":51444},[],"Select the kubeconfig context for kubectl and Helm",{"_3632":143,"_31224":91,"_21643":51446,"_5":14891,"_28416":51307,"_3083":51447},[],"`-n`, `--non-interactive`",{"_3632":144,"_31224":91,"_21643":51449,"_5":14891,"_28416":51307,"_3083":6802},[],{"_3632":145,"_31224":91,"_21643":51451,"_5":14891,"_28416":51307,"_3083":51452},[],"Skip prompts and generate dependency credentials",{"_3632":146,"_31224":91,"_21643":51454,"_5":14891,"_28416":51307,"_3083":51455},[],"`-ns`, `--namespace`",{"_3632":147,"_31224":91,"_21643":51457,"_5":14891,"_28416":51307,"_3083":51458},[],"`lamassu-dev`",{"_3632":148,"_31224":91,"_21643":51460,"_5":14891,"_28416":51307,"_3083":51461},[],"Namespace for the installation",{"_3632":149,"_31224":91,"_21643":51463,"_5":14891,"_28416":51307,"_3083":51464},[],"`-d`, `--domain`",{"_3632":150,"_31224":91,"_21643":51466,"_5":14891,"_28416":51307,"_3083":51467},[],"`dev.lamassu.io`",{"_3632":151,"_31224":91,"_21643":51469,"_5":14891,"_28416":51307,"_3083":51470},[],"Domain used by the UI, OIDC and certificate",{"_3632":152,"_31224":91,"_21643":51472,"_5":14891,"_28416":51307,"_3083":51473},[],"`-v`, `--version`",{"_3632":153,"_31224":91,"_21643":51475,"_5":14891,"_28416":51307,"_3083":15603},[],{"_3632":154,"_31224":91,"_21643":51477,"_5":14891,"_28416":51307,"_3083":51478},[],"Lamassu chart version",{"_3632":155,"_31224":91,"_21643":51480,"_5":14891,"_28416":51307,"_3083":51481},[],"`--https-port`",{"_3632":156,"_31224":91,"_21643":51483,"_5":14891,"_28416":51307,"_3083":51484},[],"`443`",{"_3632":157,"_31224":91,"_21643":51486,"_5":14891,"_28416":51307,"_3083":51487},[],"Gateway HTTPS listener port",{"_3632":158,"_31224":91,"_21643":51489,"_5":14891,"_28416":51307,"_3083":51490},[],"`--http-port`",{"_3632":159,"_31224":91,"_21643":51492,"_5":14891,"_28416":51307,"_3083":51493},[],"`80`",{"_3632":160,"_31224":91,"_21643":51495,"_5":14891,"_28416":51307,"_3083":51496},[],"Gateway HTTP listener port",{"_3632":161,"_31224":91,"_21643":51498,"_5":14891,"_28416":51307,"_3083":51499},[],"`--tls-crt`",{"_3632":162,"_31224":91,"_21643":51501,"_5":14891,"_28416":51307,"_3083":51432},[],{"_3632":163,"_31224":91,"_21643":51503,"_5":14891,"_28416":51307,"_3083":51504},[],"PEM certificate for downstream TLS",{"_3632":164,"_31224":91,"_21643":51506,"_5":14891,"_28416":51307,"_3083":51507},[],"`--tls-key`",{"_3632":165,"_31224":91,"_21643":51509,"_5":14891,"_28416":51307,"_3083":51432},[],{"_3632":166,"_31224":91,"_21643":51511,"_5":14891,"_28416":51307,"_3083":51512},[],"PEM private key for downstream TLS",{"_3632":167,"_31224":91,"_21643":51514,"_5":14891,"_28416":51307,"_3083":51515},[],"`-l`, `--local-chart-path`",{"_3632":168,"_31224":91,"_21643":51517,"_5":14891,"_28416":51307,"_3083":51518},[],"repository chart",{"_3632":169,"_31224":91,"_21643":51520,"_5":14891,"_28416":51307,"_3083":51521},[],"Use an unpacked local Lamassu chart",{"_3632":170,"_31224":91,"_21643":51523,"_5":14891,"_28416":51307,"_3083":51524},[],"`-ip`, `--gateway-ip`",{"_3632":171,"_31224":91,"_21643":51526,"_5":14891,"_28416":51307,"_3083":9088},[],{"_3632":172,"_31224":91,"_21643":51528,"_5":14891,"_28416":51307,"_3083":51529},[],"Override the address written to `gateway.addresses`",{"_3632":173,"_31224":91,"_21643":51531,"_5":14891,"_28416":51307,"_3083":51532},[],"`--otel`",{"_3632":174,"_31224":91,"_21643":51534,"_5":14891,"_28416":51307,"_3083":6802},[],{"_3632":175,"_31224":91,"_21643":51536,"_5":14891,"_28416":51307,"_3083":51537},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3632":176,"_31224":91,"_21643":51539,"_5":14891,"_28416":51307,"_3083":51540},[],"`--development`",{"_3632":177,"_31224":91,"_21643":51542,"_5":14891,"_28416":51307,"_3083":6802},[],{"_3632":178,"_31224":91,"_21643":51544,"_5":14891,"_28416":51307,"_3083":51545},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3632":179,"_31224":91,"_21643":51547,"_5":14891,"_28416":51307,"_3083":51548},[],"`--sample-data`",{"_3632":180,"_31224":91,"_21643":51550,"_5":14891,"_28416":51307,"_3083":6802},[],{"_3632":181,"_31224":91,"_21643":51552,"_5":14891,"_28416":51307,"_3083":51553},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3632":182,"_31224":91,"_21643":51555,"_5":14891,"_28416":51307,"_3083":51556},[],"`--with-hsm`",{"_3632":183,"_31224":91,"_21643":51558,"_5":14891,"_28416":51307,"_3083":6802},[],{"_3632":184,"_31224":91,"_21643":51560,"_5":14891,"_28416":51307,"_3083":51561},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3632":185,"_31224":91,"_21643":51563,"_5":14891,"_28416":51307,"_3083":51564},[],"`--softhsm-chart-path`",{"_3632":186,"_31224":91,"_21643":51566,"_5":14891,"_28416":51307,"_3083":51567},[],"`./charts/softhsm`",{"_3632":187,"_31224":91,"_21643":51569,"_5":14891,"_28416":51307,"_3083":51570},[],"Use a different local SoftHSM chart",{"_3632":188,"_31224":91,"_21643":51572,"_5":14891,"_28416":51307,"_3083":51573},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3632":189,"_31224":91,"_21643":51575,"_5":14891,"_28416":51311,"_3083":51576},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3632":190,"_31224":91,"_21643":51578,"_5":14891,"_28416":51311,"_3083":51579},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3632":191,"_31224":91,"_21643":51581,"_5":14891,"_28416":51311,"_3083":51582},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3632":192,"_31224":91,"_21643":51584,"_5":14891,"_28416":51311,"_3083":51585},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3632":193,"_31224":91,"_21643":51587,"_5":14891,"_28416":51311,"_3083":51588},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3632":194,"_31224":91,"_21643":51590,"_5":14891,"_28416":51311,"_3083":51591},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3632":195,"_31224":91,"_21643":51593,"_5":14891,"_28416":51315,"_3083":51594},[],"Fastlane:",{"_3632":196,"_31224":91,"_21643":51596,"_5":14891,"_28416":51315,"_3083":51597},[],"validates local tools and the selected cluster",{"_3632":197,"_31224":91,"_21643":51599,"_5":14891,"_28416":51315,"_3083":51600},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3632":198,"_31224":91,"_21643":51602,"_5":14891,"_28416":51315,"_3083":51603},[],"creates the namespace",{"_3632":199,"_31224":91,"_21643":51605,"_5":14891,"_28416":51315,"_3083":51606},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3632":200,"_31224":91,"_21643":51608,"_5":14891,"_28416":51315,"_3083":51609},[],"installs PostgreSQL and creates the required databases",{"_3632":201,"_31224":91,"_21643":51611,"_5":14891,"_28416":51315,"_3083":51612},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3632":202,"_31224":91,"_21643":51614,"_5":14891,"_28416":51315,"_3083":51615},[],"installs RabbitMQ",{"_3632":203,"_31224":91,"_21643":51617,"_5":14891,"_28416":51315,"_3083":51618},[],"optionally installs observability and lab HSM components",{"_3632":204,"_31224":91,"_21643":51620,"_5":14891,"_28416":51315,"_3083":51621},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3632":205,"_31224":91,"_21643":51623,"_5":14891,"_28416":51315,"_3083":51624},[],"optionally loads sample data",{"_3632":206,"_31224":91,"_21643":51626,"_5":14891,"_28416":51315,"_3083":51627},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3632":207,"_31224":91,"_21643":51629,"_5":14891,"_28416":51319,"_3083":51630},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3632":208,"_31224":91,"_21643":51632,"_5":14891,"_28416":51319,"_3083":51633},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3632":209,"_31224":91,"_21643":51635,"_5":14891,"_28416":51323,"_3083":51636},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3632":210,"_31224":91,"_21643":51638,"_5":14891,"_28416":51323,"_3083":51639},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3632":211,"_31224":91,"_21643":51641,"_5":14891,"_28416":51323,"_3083":51642},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3632":212,"_31224":91,"_21643":51644,"_5":14891,"_28416":51323,"_3083":51645},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3632":213,"_31224":91,"_21643":51647,"_5":14891,"_28416":51327,"_3083":51648},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3632":214,"_31224":214,"_5":15251,"_3083":51650,"_31583":51651,"_21643":51652,"_28416":214},"Install with Helm",[51036,51037,51143],[],{"_3632":215,"_31224":214,"_21643":51654,"_5":14891,"_28416":214,"_3083":51655},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3632":216,"_31224":214,"_5":31580,"_21643":51657,"_28416":51658,"_3083":51659},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3632":217,"_31224":214,"_5":31580,"_21643":51661,"_28416":51662,"_3083":51046},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#before-you-begin",{"_3632":218,"_31224":214,"_5":31580,"_21643":51664,"_28416":51665,"_3083":51666},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3632":219,"_31224":214,"_5":31580,"_21643":51668,"_28416":51669,"_3083":51670},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3632":220,"_31224":214,"_5":31580,"_21643":51672,"_28416":51673,"_3083":51674},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3632":221,"_31224":214,"_5":31580,"_21643":51676,"_28416":51677,"_3083":51678},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3632":222,"_31224":214,"_5":31580,"_21643":51680,"_28416":51681,"_3083":51682},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3632":223,"_31224":214,"_5":31580,"_21643":51684,"_28416":51685,"_3083":51686},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3632":224,"_31224":214,"_5":31580,"_21643":51688,"_28416":51689,"_3083":51690},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3632":225,"_31224":214,"_5":31580,"_21643":51692,"_28416":51693,"_3083":51694},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3632":226,"_31224":214,"_5":31580,"_21643":51696,"_28416":51697,"_3083":51698},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3632":227,"_31224":214,"_5":31580,"_21643":51700,"_28416":51701,"_3083":51702},[],"/docs/pr-preview/pr-82/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3632":228,"_31224":214,"_21643":51704,"_5":14891,"_28416":51658,"_3083":51705},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3632":229,"_31224":214,"_21643":51707,"_5":14891,"_28416":51662,"_3083":51708},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3632":230,"_31224":214,"_21643":51710,"_5":14891,"_28416":51662,"_3083":51711},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3632":231,"_31224":214,"_21643":51713,"_5":14891,"_28416":51662,"_3083":51714},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3632":232,"_31224":214,"_21643":51716,"_5":14891,"_28416":51662,"_3083":51717},[],"a reachable RabbitMQ broker and credentials",{"_3632":233,"_31224":214,"_21643":51719,"_5":14891,"_28416":51662,"_3083":51720},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3632":234,"_31224":214,"_21643":51722,"_5":14891,"_28416":51662,"_3083":51723},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3632":235,"_31224":214,"_21643":51725,"_5":14891,"_28416":51662,"_3083":51726},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3632":236,"_31224":214,"_21643":51728,"_5":14891,"_28416":51662,"_3083":51729},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3632":237,"_31224":214,"_21643":51731,"_5":14891,"_28416":51662,"_3083":51732},[],"a StorageClass and an external traffic design",{"_3632":238,"_31224":214,"_21643":51734,"_5":14891,"_28416":51662,"_3083":51735},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3632":239,"_31224":214,"_21643":51737,"_5":14891,"_28416":51662,"_3083":51738},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3632":240,"_31224":214,"_21643":51740,"_5":14891,"_28416":51662,"_3083":51741},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3632":241,"_31224":214,"_21643":51743,"_5":14891,"_28416":51665,"_3083":51744},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3632":242,"_31224":214,"_21643":51746,"_5":14891,"_28416":51665,"_3083":51747},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3632":243,"_31224":214,"_21643":51749,"_5":14891,"_28416":51665,"_3083":51750},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3632":244,"_31224":214,"_21643":51752,"_5":14891,"_28416":51669,"_3083":51753},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3632":245,"_31224":214,"_21643":51755,"_5":14891,"_28416":51669,"_3083":51756},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3632":246,"_31224":214,"_21643":51758,"_5":14891,"_28416":51669,"_3083":51759},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3632":247,"_31224":214,"_21643":51761,"_5":14891,"_28416":51669,"_3083":51762},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3632":248,"_31224":214,"_21643":51764,"_5":14891,"_28416":51673,"_3083":51765},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3632":249,"_31224":214,"_21643":51767,"_5":14891,"_28416":51673,"_3083":51768},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3632":250,"_31224":214,"_21643":51770,"_5":14891,"_28416":51673,"_3083":51771},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3632":251,"_31224":214,"_21643":51773,"_5":14891,"_28416":51673,"_3083":51774},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3632":252,"_31224":214,"_21643":51776,"_5":14891,"_28416":51673,"_3083":51777},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3632":253,"_31224":214,"_21643":51779,"_5":14891,"_28416":51673,"_3083":51780},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3632":254,"_31224":214,"_21643":51782,"_5":14891,"_28416":51673,"_3083":51783},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3632":255,"_31224":214,"_21643":51785,"_5":14891,"_28416":51673,"_3083":51786},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3632":256,"_31224":214,"_21643":51788,"_5":14891,"_28416":51677,"_3083":51789},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3632":257,"_31224":214,"_21643":51791,"_5":14891,"_28416":51681,"_3083":51792},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3632":258,"_31224":214,"_21643":51794,"_5":14891,"_28416":51681,"_3083":51795},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3632":259,"_31224":214,"_21643":51797,"_5":14891,"_28416":51681,"_3083":51798},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3632":260,"_31224":214,"_21643":51800,"_5":14891,"_28416":51681,"_3083":51801},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3632":261,"_31224":214,"_21643":51803,"_5":14891,"_28416":51681,"_3083":51804},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3632":262,"_31224":214,"_21643":51806,"_5":14891,"_28416":51681,"_3083":51807},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3632":263,"_31224":214,"_21643":51809,"_5":14891,"_28416":51681,"_3083":51810},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3632":264,"_31224":214,"_21643":51812,"_5":14891,"_28416":51685,"_3083":51813},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3632":265,"_31224":214,"_21643":51815,"_5":14891,"_28416":51685,"_3083":51816},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3632":266,"_31224":214,"_21643":51818,"_5":14891,"_28416":51685,"_3083":51819},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3632":267,"_31224":214,"_21643":51821,"_5":14891,"_28416":51685,"_3083":51822},[],"See Access control for the principal and policy model.",{"_3632":268,"_31224":214,"_21643":51824,"_5":14891,"_28416":51689,"_3083":51825},[],"To install a local checkout instead:",{"_3632":269,"_31224":214,"_21643":51827,"_5":14891,"_28416":51693,"_3083":51828},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3632":270,"_31224":214,"_21643":51830,"_5":14891,"_28416":51693,"_3083":51831},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3632":271,"_31224":214,"_21643":51833,"_5":14891,"_28416":51697,"_3083":51834},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3632":272,"_31224":214,"_21643":51836,"_5":14891,"_28416":51697,"_3083":51837},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3632":273,"_31224":214,"_21643":51839,"_5":14891,"_28416":51697,"_3083":51840},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3632":274,"_31224":214,"_21643":51842,"_5":14891,"_28416":51697,"_3083":51843},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3632":275,"_31224":214,"_21643":51845,"_5":14891,"_28416":51697,"_3083":51846},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3632":276,"_31224":214,"_21643":51848,"_5":14891,"_28416":51701,"_3083":51849},[],"Before going live, review:",{"_3632":277,"_31224":214,"_21643":51851,"_5":14891,"_28416":51701,"_3083":51852},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3632":278,"_31224":214,"_21643":51854,"_5":14891,"_28416":51701,"_3083":51855},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3632":279,"_31224":214,"_21643":51857,"_5":14891,"_28416":51701,"_3083":51858},[],"shared VA storage before increasing VA replicas",{"_3632":280,"_31224":214,"_21643":51860,"_5":14891,"_28416":51701,"_3083":51861},[],"managed OIDC roles and removal of evaluation credentials",{"_3632":281,"_31224":214,"_21643":51863,"_5":14891,"_28416":51701,"_3083":51864},[],"a trusted TLS issuer or externally managed certificate",{"_3632":282,"_31224":214,"_21643":51866,"_5":14891,"_28416":51701,"_3083":51867},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3632":283,"_31224":214,"_21643":51869,"_5":14891,"_28416":51701,"_3083":51870},[],"SMTP, observability and alert delivery",{"_3632":284,"_31224":214,"_21643":51872,"_5":14891,"_28416":51701,"_3083":51873},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3632":285,"_31224":214,"_21643":51875,"_5":14891,"_28416":51701,"_3083":51876},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3632":286,"_31224":286,"_5":15251,"_3083":51878,"_31583":51879,"_21643":51880,"_28416":286},"Expose the Gateway",[51036,51037,51143],[],{"_3632":287,"_31224":286,"_21643":51882,"_5":14891,"_28416":286,"_3083":51883},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3632":288,"_31224":286,"_5":31580,"_21643":51885,"_28416":51886,"_3083":51887},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3632":289,"_31224":286,"_5":31580,"_21643":51889,"_28416":51890,"_3083":51891},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3632":290,"_31224":286,"_5":31580,"_21643":51893,"_28416":51894,"_3083":51895},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3632":291,"_31224":286,"_5":31580,"_21643":51897,"_28416":51898,"_3083":51899},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#k3s","K3s",{"_3632":292,"_31224":286,"_5":31580,"_21643":51901,"_28416":51902,"_3083":51903},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3632":293,"_31224":286,"_5":31580,"_21643":51905,"_28416":51906,"_3083":51907},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3632":294,"_31224":286,"_5":31580,"_21643":51909,"_28416":51910,"_3083":51911},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3632":295,"_31224":286,"_5":31580,"_21643":51913,"_28416":51914,"_3083":51915},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3632":296,"_31224":286,"_5":31580,"_21643":51917,"_28416":51918,"_3083":51919},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3632":297,"_31224":286,"_5":31580,"_21643":51921,"_28416":51922,"_3083":51923},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3632":298,"_31224":286,"_5":31580,"_21643":51925,"_28416":51926,"_3083":51927},[],"/docs/pr-preview/pr-82/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3632":299,"_31224":286,"_21643":51929,"_5":14891,"_28416":51886,"_3083":51930},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3632":300,"_31224":286,"_21643":51932,"_5":14891,"_28416":51886,"_3083":51933},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3632":301,"_31224":286,"_21643":51935,"_5":14891,"_28416":51890,"_3083":51936},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3632":302,"_31224":286,"_21643":51938,"_5":14891,"_28416":51890,"_3083":51939},[],"Set it only when:",{"_3632":303,"_31224":286,"_21643":51941,"_5":14891,"_28416":51890,"_3083":51942},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3632":304,"_31224":286,"_21643":51944,"_5":14891,"_28416":51890,"_3083":51945},[],"that address is allocated to this Gateway",{"_3632":305,"_31224":286,"_21643":51947,"_5":14891,"_28416":51890,"_3083":51948},[],"the surrounding network already routes traffic for it to the cluster",{"_3632":306,"_31224":286,"_21643":51950,"_5":14891,"_28416":51890,"_3083":51951},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3632":307,"_31224":286,"_21643":51953,"_5":14891,"_28416":51890,"_3083":51954},[],"Keep these two settings separate:",{"_3632":308,"_31224":286,"_21643":51956,"_5":14891,"_28416":51890,"_3083":51957},[],"`gateway.addresses` requests an address for the Gateway.",{"_3632":309,"_31224":286,"_21643":51959,"_5":14891,"_28416":51890,"_3083":51960},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3632":310,"_31224":286,"_21643":51962,"_5":14891,"_28416":51890,"_3083":51963},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3632":311,"_31224":286,"_21643":51965,"_5":14891,"_28416":51894,"_3083":51966},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3632":312,"_31224":286,"_21643":51968,"_5":14891,"_28416":51894,"_3083":51969},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3632":313,"_31224":286,"_21643":51971,"_5":14891,"_28416":51898,"_3083":51972},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3632":314,"_31224":286,"_21643":51974,"_5":14891,"_28416":51898,"_3083":51975},[],"For the recommended design:",{"_3632":315,"_31224":286,"_21643":51977,"_5":14891,"_28416":51898,"_3083":51978},[],"Use only one externally exposed Lamassu Gateway.",{"_3632":316,"_31224":286,"_21643":51980,"_5":14891,"_28416":51898,"_3083":51981},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3632":317,"_31224":286,"_21643":51983,"_5":14891,"_28416":51898,"_3083":51984},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3632":318,"_31224":286,"_21643":51986,"_5":14891,"_28416":51898,"_3083":51987},[],"Point DNS at the VM's reachable address.",{"_3632":319,"_31224":286,"_21643":51989,"_5":14891,"_28416":51898,"_3083":51990},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3632":320,"_31224":286,"_21643":51992,"_5":14891,"_28416":51902,"_3083":51993},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3632":321,"_31224":286,"_21643":51995,"_5":14891,"_28416":51906,"_3083":51996},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3632":322,"_31224":286,"_21643":51998,"_5":14891,"_28416":51906,"_3083":51999},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3632":323,"_31224":286,"_21643":52001,"_5":14891,"_28416":51910,"_3083":52002},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3632":324,"_31224":286,"_21643":52004,"_5":14891,"_28416":51910,"_3083":52005},[],"Requirement",{"_3632":325,"_31224":286,"_21643":52007,"_5":14891,"_28416":51910,"_3083":52008},[],"Recommended design",{"_3632":326,"_31224":286,"_21643":52010,"_5":14891,"_28416":51910,"_3083":52011},[],"Consequence",{"_3632":327,"_31224":286,"_21643":52013,"_5":14891,"_28416":51910,"_3083":52014},[],"Several Lamassu URLs or services",{"_3632":328,"_31224":286,"_21643":52016,"_5":14891,"_28416":51910,"_3083":52017},[],"One Gateway with multiple routes",{"_3632":329,"_31224":286,"_21643":52019,"_5":14891,"_28416":51910,"_3083":52020},[],"One IP and one proxy fleet; this is the chart default",{"_3632":330,"_31224":286,"_21643":52022,"_5":14891,"_28416":51910,"_3083":52023},[],"Independent Gateways and separate external IPs",{"_3632":331,"_31224":286,"_21643":52025,"_5":14891,"_28416":51910,"_3083":52026},[],"One VIP per Gateway",{"_3632":332,"_31224":286,"_21643":52028,"_5":14891,"_28416":51910,"_3083":52029},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3632":333,"_31224":286,"_21643":52031,"_5":14891,"_28416":51910,"_3083":52032},[],"Independent Gateways on one node and one IP",{"_3632":334,"_31224":286,"_21643":52034,"_5":14891,"_28416":51910,"_3083":52035},[],"Use different external ports",{"_3632":335,"_31224":286,"_21643":52037,"_5":14891,"_28416":51910,"_3083":52038},[],"Clients must include non-standard ports",{"_3632":336,"_31224":286,"_21643":52040,"_5":14891,"_28416":51910,"_3083":52041},[],"Separate TLS/mTLS termination behind one IP",{"_3632":337,"_31224":286,"_21643":52043,"_5":14891,"_28416":51910,"_3083":52044},[],"Front-door SNI routing to internal Gateways",{"_3632":338,"_31224":286,"_21643":52046,"_5":14891,"_28416":51910,"_3083":52047},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3632":339,"_31224":286,"_21643":52049,"_5":14891,"_28416":51910,"_3083":52050},[],"Separate Gateway resources but shared proxy infrastructure",{"_3632":340,"_31224":286,"_21643":52052,"_5":14891,"_28416":51910,"_3083":52053},[],"Envoy merged-Gateway mode",{"_3632":341,"_31224":286,"_21643":52055,"_5":14891,"_28416":51910,"_3083":52056},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3632":342,"_31224":286,"_21643":52058,"_5":14891,"_28416":51910,"_3083":52059},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3632":343,"_31224":286,"_21643":52061,"_5":14891,"_28416":51910,"_3083":52062},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3632":344,"_31224":286,"_21643":52064,"_5":14891,"_28416":51910,"_3083":52065},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3632":345,"_31224":286,"_21643":52067,"_5":14891,"_28416":51910,"_3083":52068},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3632":346,"_31224":286,"_21643":52070,"_5":14891,"_28416":51914,"_3083":52071},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3632":347,"_31224":286,"_21643":52073,"_5":14891,"_28416":51918,"_3083":52074},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3632":348,"_31224":286,"_21643":52076,"_5":14891,"_28416":51918,"_3083":52077},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3632":349,"_31224":286,"_21643":52079,"_5":14891,"_28416":51918,"_3083":52080},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3632":350,"_31224":286,"_21643":52082,"_5":14891,"_28416":51918,"_3083":52083},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3632":351,"_31224":286,"_21643":52085,"_5":14891,"_28416":51918,"_3083":52086},[],"If none of those are possible, use different external ports or change the external network design.",{"_3632":352,"_31224":286,"_21643":52088,"_5":14891,"_28416":51922,"_3083":52089},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3632":353,"_31224":286,"_21643":52091,"_5":14891,"_28416":51922,"_3083":52092},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3632":354,"_31224":286,"_21643":52094,"_5":14891,"_28416":51926,"_3083":52095},[],"Check, in order:",{"_3632":355,"_31224":286,"_21643":52097,"_5":14891,"_28416":51926,"_3083":52098},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3632":356,"_31224":286,"_21643":52100,"_5":14891,"_28416":51926,"_3083":52101},[],"Its status contains the expected address.",{"_3632":357,"_31224":286,"_21643":52103,"_5":14891,"_28416":51926,"_3083":52104},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3632":358,"_31224":286,"_21643":52106,"_5":14891,"_28416":51926,"_3083":52107},[],"Port 443 reaches that address from the client network.",{"_3632":359,"_31224":286,"_21643":52109,"_5":14891,"_28416":51926,"_3083":52110},[],"DNS resolves to the externally reachable endpoint.",{"_3632":360,"_31224":286,"_21643":52112,"_5":14891,"_28416":51926,"_3083":52113},[],"The certificate contains the DNS name or IP used by the client.",{"_3632":361,"_31224":286,"_21643":52115,"_5":14891,"_28416":51926,"_3083":52116},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3632":362,"_31224":362,"_5":15251,"_3083":51143,"_31583":52118,"_21643":52119,"_28416":362},[51036,51037,51143],[],{"_3632":363,"_31224":362,"_21643":52121,"_5":14891,"_28416":362,"_3083":52122},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3632":364,"_31224":362,"_5":31580,"_21643":52124,"_28416":52125,"_3083":52126},[],"/docs/pr-preview/pr-82/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3632":365,"_31224":362,"_5":31580,"_21643":52128,"_28416":52129,"_3083":52130},[],"/docs/pr-preview/pr-82/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3632":366,"_31224":362,"_5":31580,"_21643":52132,"_28416":52133,"_3083":52134},[],"/docs/pr-preview/pr-82/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3632":367,"_31224":362,"_5":31580,"_21643":52136,"_28416":52137,"_3083":52138},[],"/docs/pr-preview/pr-82/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3632":368,"_31224":362,"_5":31580,"_21643":52140,"_28416":52141,"_3083":52142},[],"/docs/pr-preview/pr-82/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3632":369,"_31224":362,"_5":31580,"_21643":52144,"_28416":52145,"_3083":52146},[],"/docs/pr-preview/pr-82/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3632":370,"_31224":362,"_21643":52148,"_5":14891,"_28416":52125,"_3083":52149},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3632":371,"_31224":362,"_21643":52151,"_5":14891,"_28416":52129,"_3083":52152},[],"Workflow",{"_3632":372,"_31224":362,"_21643":52154,"_5":14891,"_28416":52129,"_3083":52155},[],"Use it for",{"_3632":373,"_31224":362,"_21643":52157,"_5":14891,"_28416":52129,"_3083":52158},[],"What it installs",{"_3632":374,"_31224":362,"_21643":52160,"_5":14891,"_28416":52129,"_3083":52161},[],"Helm",{"_3632":375,"_31224":362,"_21643":52163,"_5":14891,"_28416":52129,"_3083":52164},[],"Production and controlled environments",{"_3632":376,"_31224":362,"_21643":52166,"_5":14891,"_28416":52129,"_3083":52167},[],"Lamassu services and Gateway API resources",{"_3632":377,"_31224":362,"_21643":52169,"_5":14891,"_28416":52129,"_3083":51280},[],{"_3632":378,"_31224":362,"_21643":52171,"_5":14891,"_28416":52129,"_3083":52172},[],"Evaluation, demos, CI and small lab clusters",{"_3632":379,"_31224":362,"_21643":52174,"_5":14891,"_28416":52129,"_3083":52175},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3632":380,"_31224":362,"_21643":52177,"_5":14891,"_28416":52133,"_3083":52178},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3632":381,"_31224":362,"_21643":52180,"_5":14891,"_28416":52133,"_3083":52181},[],"Area",{"_3632":382,"_31224":362,"_21643":52183,"_5":14891,"_28416":52133,"_3083":52184},[],"The Lamassu chart provides",{"_3632":383,"_31224":362,"_21643":52186,"_5":14891,"_28416":52133,"_3083":52187},[],"You provide",{"_3632":384,"_31224":362,"_21643":52189,"_5":14891,"_28416":52133,"_3083":52190},[],"Lamassu applications",{"_3632":385,"_31224":362,"_21643":52192,"_5":14891,"_28416":52133,"_3083":52193},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3632":386,"_31224":362,"_21643":52195,"_5":14891,"_28416":52133,"_3083":52196},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3632":387,"_31224":362,"_21643":52198,"_5":14891,"_28416":52133,"_3083":52199},[],"PostgreSQL data",{"_3632":388,"_31224":362,"_21643":52201,"_5":14891,"_28416":52133,"_3083":52202},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3632":389,"_31224":362,"_21643":52204,"_5":14891,"_28416":52133,"_3083":52205},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3632":390,"_31224":362,"_21643":52207,"_5":14891,"_28416":52133,"_3083":52208},[],"Messaging",{"_3632":391,"_31224":362,"_21643":52210,"_5":14891,"_28416":52133,"_3083":52211},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3632":392,"_31224":362,"_21643":52213,"_5":14891,"_28416":52133,"_3083":52214},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3632":393,"_31224":362,"_21643":52216,"_5":14891,"_28416":52133,"_3083":52217},[],"Identity",{"_3632":394,"_31224":362,"_21643":52219,"_5":14891,"_28416":52133,"_3083":52220},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3632":395,"_31224":362,"_21643":52222,"_5":14891,"_28416":52133,"_3083":52223},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3632":396,"_31224":362,"_21643":52225,"_5":14891,"_28416":52133,"_3083":52226},[],"External routing",{"_3632":397,"_31224":362,"_21643":52228,"_5":14891,"_28416":52133,"_3083":52229},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3632":398,"_31224":362,"_21643":52231,"_5":14891,"_28416":52133,"_3083":52232},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3632":399,"_31224":362,"_21643":52234,"_5":14891,"_28416":52133,"_3083":52235},[],"TLS",{"_3632":400,"_31224":362,"_21643":52237,"_5":14891,"_28416":52133,"_3083":52238},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3632":401,"_31224":362,"_21643":52240,"_5":14891,"_28416":52133,"_3083":52241},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3632":402,"_31224":362,"_21643":52243,"_5":14891,"_28416":52133,"_3083":52244},[],"Persistent application data",{"_3632":403,"_31224":362,"_21643":52246,"_5":14891,"_28416":52133,"_3083":52247},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3632":404,"_31224":362,"_21643":52249,"_5":14891,"_28416":52133,"_3083":52250},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3632":405,"_31224":362,"_21643":52252,"_5":14891,"_28416":52133,"_3083":52253},[],"Optional integrations",{"_3632":406,"_31224":362,"_21643":52255,"_5":14891,"_28416":52133,"_3083":52256},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3632":407,"_31224":362,"_21643":52258,"_5":14891,"_28416":52133,"_3083":52259},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3632":408,"_31224":362,"_21643":52261,"_5":14891,"_28416":52133,"_3083":52262},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3632":409,"_31224":362,"_21643":52264,"_5":14891,"_28416":52133,"_3083":52265},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3632":410,"_31224":362,"_21643":52267,"_5":14891,"_28416":52137,"_3083":52268},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3632":411,"_31224":362,"_21643":52270,"_5":14891,"_28416":52137,"_3083":52271},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3632":412,"_31224":362,"_21643":52273,"_5":14891,"_28416":52141,"_3083":52274},[],"Kubernetes 1.24 or newer",{"_3632":413,"_31224":362,"_21643":52276,"_5":14891,"_28416":52141,"_3083":52277},[],"Helm 3.2 or newer",{"_3632":414,"_31224":362,"_21643":52279,"_5":14891,"_28416":52141,"_3083":52280},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3632":415,"_31224":362,"_21643":52282,"_5":14891,"_28416":52141,"_3083":52283},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3632":416,"_31224":362,"_21643":52285,"_5":14891,"_28416":52141,"_3083":52286},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3632":417,"_31224":362,"_21643":52288,"_5":14891,"_28416":52141,"_3083":52289},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3632":418,"_31224":362,"_21643":52291,"_5":14891,"_28416":52141,"_3083":52292},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3632":419,"_31224":362,"_21643":52294,"_5":14891,"_28416":52145,"_3083":52295},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":420,"_31224":362,"_21643":52297,"_5":14891,"_28416":52145,"_3083":52298},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3632":421,"_31224":362,"_21643":52300,"_5":14891,"_28416":52145,"_3083":52301},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3632":422,"_31224":362,"_21643":52303,"_5":14891,"_28416":52145,"_3083":52304},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3632":423,"_31224":423,"_5":15251,"_3083":52306,"_31583":52307,"_21643":52309,"_28416":423},"Deployment troubleshooting",[51036,51037,52308],"Operations",[],{"_3632":424,"_31224":423,"_21643":52311,"_5":14891,"_28416":423,"_3083":52312},[],"Diagnose access, service health and infrastructure dependencies.",{"_3632":425,"_31224":423,"_5":31580,"_21643":52314,"_28416":52315,"_3083":52316},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3632":426,"_31224":423,"_5":31580,"_21643":52318,"_28416":52319,"_3083":52320},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3632":427,"_31224":423,"_5":31580,"_21643":52322,"_28416":52323,"_3083":52324},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3632":428,"_31224":423,"_5":31580,"_21643":52326,"_28416":52327,"_3083":52328},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3632":429,"_31224":423,"_5":31580,"_21643":52330,"_28416":52331,"_3083":52332},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3632":430,"_31224":423,"_5":31580,"_21643":52334,"_28416":52335,"_3083":52336},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3632":431,"_31224":423,"_5":31580,"_21643":52338,"_28416":52339,"_3083":52340},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3632":432,"_31224":423,"_5":31580,"_21643":52342,"_28416":52343,"_3083":52344},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3632":433,"_31224":423,"_5":31580,"_21643":52346,"_28416":52347,"_3083":52348},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3632":434,"_31224":423,"_5":31580,"_21643":52350,"_28416":52351,"_3083":52352},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3632":435,"_31224":423,"_5":31580,"_21643":52354,"_28416":52355,"_3083":52356},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3632":436,"_31224":423,"_5":31580,"_21643":52358,"_28416":52359,"_3083":52360},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3632":437,"_31224":423,"_5":31580,"_21643":52362,"_28416":52363,"_3083":52364},[],"/docs/pr-preview/pr-82/deployment/troubleshooting#observability","Observability",{"_3632":438,"_31224":423,"_21643":52366,"_5":14891,"_28416":423,"_3083":52367},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3632":439,"_31224":423,"_21643":52369,"_5":14891,"_28416":52319,"_3083":52370},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3632":440,"_31224":423,"_21643":52372,"_5":14891,"_28416":52323,"_3083":52373},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3632":441,"_31224":423,"_21643":52375,"_5":14891,"_28416":52327,"_3083":52376},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3632":442,"_31224":423,"_21643":52378,"_5":14891,"_28416":52331,"_3083":52379},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3632":443,"_31224":423,"_21643":52381,"_5":14891,"_28416":52335,"_3083":52382},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3632":444,"_31224":423,"_21643":52384,"_5":14891,"_28416":52339,"_3083":52385},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3632":445,"_31224":423,"_21643":52387,"_5":14891,"_28416":52339,"_3083":52388},[],"Also run the chart's connectivity test:",{"_3632":446,"_31224":423,"_21643":52390,"_5":14891,"_28416":52339,"_3083":52391},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3632":447,"_31224":423,"_21643":52393,"_5":14891,"_28416":52339,"_3083":52394},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3632":448,"_31224":423,"_21643":52396,"_5":14891,"_28416":52343,"_3083":52397},[],"If you receive a 401:",{"_3632":449,"_31224":423,"_21643":52399,"_5":14891,"_28416":52343,"_3083":52400},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3632":450,"_31224":423,"_21643":52402,"_5":14891,"_28416":52343,"_3083":52403},[],"verify issuer, audience and expiration of the token;",{"_3632":451,"_31224":423,"_21643":52405,"_5":14891,"_28416":52343,"_3083":52406},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3632":452,"_31224":423,"_21643":52408,"_5":14891,"_28416":52343,"_3083":52409},[],"check that the provider's public and internal routes point to the same realm.",{"_3632":453,"_31224":423,"_21643":52411,"_5":14891,"_28416":52343,"_3083":52412},[],"If login succeeds but the APIs return 403:",{"_3632":454,"_31224":423,"_21643":52414,"_5":14891,"_28416":52343,"_3083":52415},[],"inspect the token's real claims;",{"_3632":455,"_31224":423,"_21643":52417,"_5":14891,"_28416":52343,"_3083":52418},[],"confirm they match an active principal;",{"_3632":456,"_31224":423,"_21643":52420,"_5":14891,"_28416":52343,"_3083":52421},[],"review the policies granted to that principal;",{"_3632":457,"_31224":423,"_21643":52423,"_5":14891,"_28416":52343,"_3083":52424},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3632":458,"_31224":423,"_21643":52426,"_5":14891,"_28416":52343,"_3083":52427},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3632":459,"_31224":423,"_21643":52429,"_5":14891,"_28416":52347,"_3083":52430},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3632":460,"_31224":423,"_21643":52432,"_5":14891,"_28416":52347,"_3083":52433},[],"Locate the authz pod and Service.",{"_3632":461,"_31224":423,"_21643":52435,"_5":14891,"_28416":52347,"_3083":52436},[],"Check /health, logs and its database connection.",{"_3632":462,"_31224":423,"_21643":52438,"_5":14891,"_28416":52347,"_3083":52439},[],"Verify the DNS and port configured in externalAuthorization.",{"_3632":463,"_31224":423,"_21643":52441,"_5":14891,"_28416":52347,"_3083":52442},[],"Check the check route is /v1/ext\\_authz/check.",{"_3632":464,"_31224":423,"_21643":52444,"_5":14891,"_28416":52347,"_3083":52445},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3632":465,"_31224":423,"_21643":52447,"_5":14891,"_28416":52351,"_3083":52448},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3632":466,"_31224":423,"_21643":52450,"_5":14891,"_28416":52355,"_3083":52451},[],"Review kubectl describe pod first. Common causes are:",{"_3632":467,"_31224":423,"_21643":52453,"_5":14891,"_28416":52355,"_3083":52454},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3632":468,"_31224":423,"_21643":52456,"_5":14891,"_28416":52355,"_3083":52457},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3632":469,"_31224":423,"_21643":52459,"_5":14891,"_28416":52355,"_3083":52460},[],"unbound persistent volume;",{"_3632":470,"_31224":423,"_21643":52462,"_5":14891,"_28416":52355,"_3083":52463},[],"inaccessible image or incorrect pull policy;",{"_3632":471,"_31224":423,"_21643":52465,"_5":14891,"_28416":52355,"_3083":52466},[],"invalid cryptographic engine configuration;",{"_3632":472,"_31224":423,"_21643":52468,"_5":14891,"_28416":52355,"_3083":52469},[],"CPU or memory limits set too low;",{"_3632":473,"_31224":423,"_21643":52471,"_5":14891,"_28416":52355,"_3083":52472},[],"an incomplete prior migration.",{"_3632":474,"_31224":423,"_21643":52474,"_5":14891,"_28416":52355,"_3083":52475},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3632":475,"_31224":423,"_21643":52477,"_5":14891,"_28416":52355,"_3083":52478},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3632":476,"_31224":423,"_21643":52480,"_5":14891,"_28416":52355,"_3083":52481},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3632":477,"_31224":423,"_21643":52483,"_5":14891,"_28416":52359,"_3083":52484},[],"Domain and audit events depend on the bus publisher:",{"_3632":478,"_31224":423,"_21643":52486,"_5":14891,"_28416":52359,"_3083":52487},[],"verify it is enabled in the emitting service;",{"_3632":479,"_31224":423,"_21643":52489,"_5":14891,"_28416":52359,"_3083":52490},[],"check AMQP connectivity and credentials;",{"_3632":480,"_31224":423,"_21643":52492,"_5":14891,"_28416":52359,"_3083":52493},[],"review exchange, routing key, queues and consumers;",{"_3632":481,"_31224":423,"_21643":52495,"_5":14891,"_28416":52359,"_3083":52496},[],"inspect dead-letter queues;",{"_3632":482,"_31224":423,"_21643":52498,"_5":14891,"_28416":52359,"_3083":52499},[],"alert on orphan durable queues and backlog growth.",{"_3632":483,"_31224":423,"_21643":52501,"_5":14891,"_28416":52359,"_3083":52502},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3632":484,"_31224":423,"_21643":52504,"_5":14891,"_28416":52359,"_3083":52505},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3632":485,"_31224":423,"_21643":52507,"_5":14891,"_28416":52359,"_3083":52508},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3632":486,"_31224":423,"_21643":52510,"_5":14891,"_28416":52359,"_3083":52511},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3632":487,"_31224":423,"_21643":52513,"_5":14891,"_28416":52359,"_3083":52514},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3632":488,"_31224":423,"_21643":52516,"_5":14891,"_28416":52359,"_3083":52517},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3632":489,"_31224":423,"_21643":52519,"_5":14891,"_28416":52359,"_3083":52520},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3632":490,"_31224":423,"_21643":52522,"_5":14891,"_28416":52363,"_3083":52523},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3632":491,"_31224":423,"_21643":52525,"_5":14891,"_28416":52363,"_3083":52526},[],"Before closing an incident, record:",{"_3632":492,"_31224":423,"_21643":52528,"_5":14891,"_28416":52363,"_3083":52529},[],"the confirmed cause;",{"_3632":493,"_31224":423,"_21643":52531,"_5":14891,"_28416":52363,"_3083":52532},[],"the time scope and affected resources;",{"_3632":494,"_31224":423,"_21643":52534,"_5":14891,"_28416":52363,"_3083":52535},[],"the commands or queries used;",{"_3632":495,"_31224":423,"_21643":52537,"_5":14891,"_28416":52363,"_3083":52538},[],"the applied change and how to revert it;",{"_3632":496,"_31224":423,"_21643":52540,"_5":14891,"_28416":52363,"_3083":52541},[],"validation from a consumer;",{"_3632":497,"_31224":423,"_21643":52543,"_5":14891,"_28416":52363,"_3083":52544},[],"the preventive action and its owner.",{"_3632":498,"_31224":498,"_5":15251,"_3083":52546,"_31583":52547,"_21643":52551,"_28416":498},"Data model",[51036,52548,52549,52550],"Platform","Administration","Access control",[],{"_3632":499,"_31224":498,"_21643":52553,"_5":14891,"_28416":498,"_3083":52554},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3632":500,"_31224":498,"_5":31580,"_21643":52556,"_28416":52557,"_3083":52558},[],"/docs/pr-preview/pr-82/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3632":501,"_31224":498,"_5":31580,"_21643":52560,"_28416":52561,"_3083":52562},[],"/docs/pr-preview/pr-82/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3632":502,"_31224":498,"_21643":52564,"_5":14891,"_28416":498,"_3083":52565},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3632":503,"_31224":498,"_21643":52567,"_5":14891,"_28416":52557,"_3083":52568},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3632":504,"_31224":498,"_21643":52570,"_5":14891,"_28416":52557,"_3083":52571},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3632":505,"_31224":498,"_21643":52573,"_5":14891,"_28416":52557,"_3083":52574},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3632":506,"_31224":498,"_21643":52576,"_5":14891,"_28416":52561,"_3083":52577},[],"Entity (`schema_name.entity_type`)",{"_3632":507,"_31224":498,"_21643":52579,"_5":14891,"_28416":52561,"_3083":52580},[],"Table (`table_name`)",{"_3632":508,"_31224":498,"_21643":52582,"_5":14891,"_28416":52561,"_3083":52583},[],"Key (`primary_key`)",{"_3632":509,"_31224":498,"_21643":52585,"_5":14891,"_28416":52561,"_3083":52586},[],"`alerts.event`",{"_3632":510,"_31224":498,"_21643":52588,"_5":14891,"_28416":52561,"_3083":52589},[],"`events`",{"_3632":511,"_31224":498,"_21643":52591,"_5":14891,"_28416":52561,"_3083":52592},[],"`event_type`",{"_3632":512,"_31224":498,"_21643":52594,"_5":14891,"_28416":52561,"_3083":52595},[],"`alerts.subscription`",{"_3632":513,"_31224":498,"_21643":52597,"_5":14891,"_28416":52561,"_3083":52598},[],"`subscriptions`",{"_3632":514,"_31224":498,"_21643":52600,"_5":14891,"_28416":52561,"_3083":52601},[],"`id`",{"_3632":515,"_31224":498,"_21643":52603,"_5":14891,"_28416":52561,"_3083":52604},[],"`ca.ca_certificate`",{"_3632":516,"_31224":498,"_21643":52606,"_5":14891,"_28416":52561,"_3083":52607},[],"`ca_certificates`",{"_3632":517,"_31224":498,"_21643":52609,"_5":14891,"_28416":52561,"_3083":52601},[],{"_3632":518,"_31224":498,"_21643":52611,"_5":14891,"_28416":52561,"_3083":52612},[],"`ca.certificate`",{"_3632":519,"_31224":498,"_21643":52614,"_5":14891,"_28416":52561,"_3083":52615},[],"`certificates`",{"_3632":520,"_31224":498,"_21643":52617,"_5":14891,"_28416":52561,"_3083":52618},[],"`serial_number`",{"_3632":521,"_31224":498,"_21643":52620,"_5":14891,"_28416":52561,"_3083":52621},[],"`ca.issuance_profile`",{"_3632":522,"_31224":498,"_21643":52623,"_5":14891,"_28416":52561,"_3083":52624},[],"`issuance_profiles`",{"_3632":523,"_31224":498,"_21643":52626,"_5":14891,"_28416":52561,"_3083":52601},[],{"_3632":524,"_31224":498,"_21643":52628,"_5":14891,"_28416":52561,"_3083":52629},[],"`devicemanager.device_group`",{"_3632":525,"_31224":498,"_21643":52631,"_5":14891,"_28416":52561,"_3083":52632},[],"`device_groups`",{"_3632":526,"_31224":498,"_21643":52634,"_5":14891,"_28416":52561,"_3083":52601},[],{"_3632":527,"_31224":498,"_21643":52636,"_5":14891,"_28416":52561,"_3083":52637},[],"`devicemanager.device`",{"_3632":528,"_31224":498,"_21643":52639,"_5":14891,"_28416":52561,"_3083":52640},[],"`devices`",{"_3632":529,"_31224":498,"_21643":52642,"_5":14891,"_28416":52561,"_3083":52601},[],{"_3632":530,"_31224":498,"_21643":52644,"_5":14891,"_28416":52561,"_3083":52645},[],"`dmsmanager.dms`",{"_3632":531,"_31224":498,"_21643":52647,"_5":14891,"_28416":52561,"_3083":52648},[],"`dms`",{"_3632":532,"_31224":498,"_21643":52650,"_5":14891,"_28416":52561,"_3083":52601},[],{"_3632":533,"_31224":498,"_21643":52652,"_5":14891,"_28416":52561,"_3083":52653},[],"`kms.kms_key`",{"_3632":534,"_31224":498,"_21643":52655,"_5":14891,"_28416":52561,"_3083":52656},[],"`kms_keys`",{"_3632":535,"_31224":498,"_21643":52658,"_5":14891,"_28416":52561,"_3083":52659},[],"`key_id`, `engine_id`",{"_3632":536,"_31224":498,"_21643":52661,"_5":14891,"_28416":52561,"_3083":52662},[],"`va.crl_settings`",{"_3632":537,"_31224":498,"_21643":52664,"_5":14891,"_28416":52561,"_3083":52665},[],"`crl_settings`",{"_3632":538,"_31224":498,"_21643":52667,"_5":14891,"_28416":52561,"_3083":52668},[],"`ca_id`",{"_3632":539,"_31224":498,"_21643":52670,"_5":14891,"_28416":52561,"_3083":52671},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3632":540,"_31224":498,"_21643":52673,"_5":14891,"_28416":52561,"_3083":52674},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3632":541,"_31224":498,"_21643":52676,"_5":14891,"_28416":52561,"_3083":52677},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3632":542,"_31224":542,"_5":15251,"_3083":52679,"_31583":52680,"_21643":52681,"_28416":542},"Access control overview",[51036,52548,52549,52550],[],{"_3632":543,"_31224":542,"_21643":52683,"_5":14891,"_28416":542,"_3083":52684},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3632":544,"_31224":542,"_5":31580,"_21643":52686,"_28416":52687,"_3083":52688},[],"/docs/pr-preview/pr-82/platform/administration/access-control#essential-concepts","Essential concepts",{"_3632":545,"_31224":542,"_5":31580,"_21643":52690,"_28416":52691,"_3083":52692},[],"/docs/pr-preview/pr-82/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3632":546,"_31224":542,"_5":31580,"_21643":52694,"_28416":52695,"_3083":52696},[],"/docs/pr-preview/pr-82/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3632":547,"_31224":542,"_5":31580,"_21643":52698,"_28416":52699,"_3083":52700},[],"/docs/pr-preview/pr-82/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3632":548,"_31224":542,"_5":31580,"_21643":52702,"_28416":52703,"_3083":52704},[],"/docs/pr-preview/pr-82/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3632":549,"_31224":542,"_5":31580,"_21643":52706,"_28416":52707,"_3083":52708},[],"/docs/pr-preview/pr-82/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3632":550,"_31224":542,"_5":31580,"_21643":52710,"_28416":52711,"_3083":52712},[],"/docs/pr-preview/pr-82/platform/administration/access-control#oidc-principals","OIDC principals",{"_3632":551,"_31224":542,"_5":31580,"_21643":52714,"_28416":52715,"_3083":52716},[],"/docs/pr-preview/pr-82/platform/administration/access-control#x509-principals","X.509 principals",{"_3632":552,"_31224":542,"_5":31580,"_21643":52718,"_28416":52719,"_3083":52720},[],"/docs/pr-preview/pr-82/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3632":553,"_31224":542,"_5":31580,"_21643":52722,"_28416":52723,"_3083":52724},[],"/docs/pr-preview/pr-82/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3632":554,"_31224":542,"_5":31580,"_21643":52726,"_28416":52727,"_3083":52728},[],"/docs/pr-preview/pr-82/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3632":555,"_31224":542,"_5":31580,"_21643":52730,"_28416":52731,"_3083":52732},[],"/docs/pr-preview/pr-82/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3632":556,"_31224":542,"_5":31580,"_21643":52734,"_28416":52735,"_3083":52736},[],"/docs/pr-preview/pr-82/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3632":557,"_31224":542,"_5":31580,"_21643":52738,"_28416":52739,"_3083":52740},[],"/docs/pr-preview/pr-82/platform/administration/access-control#http-rules","HTTP rules",{"_3632":558,"_31224":542,"_5":31580,"_21643":52742,"_28416":52743,"_3083":52744},[],"/docs/pr-preview/pr-82/platform/administration/access-control#included-policies","Included policies",{"_3632":559,"_31224":542,"_5":31580,"_21643":52746,"_28416":52747,"_3083":51686},[],"/docs/pr-preview/pr-82/platform/administration/access-control#provision-the-first-administrator",{"_3632":560,"_31224":542,"_5":31580,"_21643":52749,"_28416":52750,"_3083":52751},[],"/docs/pr-preview/pr-82/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3632":561,"_31224":542,"_5":31580,"_21643":52753,"_28416":52754,"_3083":52755},[],"/docs/pr-preview/pr-82/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3632":562,"_31224":542,"_5":31580,"_21643":52757,"_28416":52758,"_3083":52759},[],"/docs/pr-preview/pr-82/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3632":563,"_31224":542,"_5":31580,"_21643":52761,"_28416":52762,"_3083":52763},[],"/docs/pr-preview/pr-82/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3632":564,"_31224":542,"_5":31580,"_21643":52765,"_28416":52766,"_3083":52767},[],"/docs/pr-preview/pr-82/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3632":565,"_31224":542,"_5":31580,"_21643":52769,"_28416":52770,"_3083":52771},[],"/docs/pr-preview/pr-82/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3632":566,"_31224":542,"_5":31580,"_21643":52773,"_28416":52774,"_3083":52775},[],"/docs/pr-preview/pr-82/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3632":567,"_31224":542,"_5":31580,"_21643":52777,"_28416":52778,"_3083":52779},[],"/docs/pr-preview/pr-82/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3632":568,"_31224":542,"_5":31580,"_21643":52781,"_28416":52782,"_3083":52783},[],"/docs/pr-preview/pr-82/platform/administration/access-control#operational-checklist","Operational checklist",{"_3632":569,"_31224":542,"_5":31580,"_21643":52785,"_28416":52786,"_3083":52787},[],"/docs/pr-preview/pr-82/platform/administration/access-control#diagnostics","Diagnostics",{"_3632":570,"_31224":542,"_5":31580,"_21643":52789,"_28416":52790,"_3083":52791},[],"/docs/pr-preview/pr-82/platform/administration/access-control#the-response-is-401","The response is 401",{"_3632":571,"_31224":542,"_5":31580,"_21643":52793,"_28416":52794,"_3083":52795},[],"/docs/pr-preview/pr-82/platform/administration/access-control#the-response-is-403","The response is 403",{"_3632":572,"_31224":542,"_5":31580,"_21643":52797,"_28416":52798,"_3083":52799},[],"/docs/pr-preview/pr-82/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3632":573,"_31224":542,"_5":31580,"_21643":52801,"_28416":52802,"_3083":52803},[],"/docs/pr-preview/pr-82/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3632":574,"_31224":542,"_5":31580,"_21643":52805,"_28416":52806,"_3083":52807},[],"/docs/pr-preview/pr-82/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3632":575,"_31224":542,"_21643":52809,"_5":14891,"_28416":542,"_3083":52810},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3632":576,"_31224":542,"_21643":52812,"_5":14891,"_28416":542,"_3083":52813},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3632":577,"_31224":542,"_21643":52815,"_5":14891,"_28416":542,"_3083":52816},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3632":578,"_31224":542,"_21643":52818,"_5":14891,"_28416":52687,"_3083":52819},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3632":579,"_31224":542,"_21643":52821,"_5":14891,"_28416":52687,"_3083":52822},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3632":580,"_31224":542,"_21643":52824,"_5":14891,"_28416":52687,"_3083":52825},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3632":581,"_31224":542,"_21643":52827,"_5":14891,"_28416":52687,"_3083":52828},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3632":582,"_31224":542,"_21643":52830,"_5":14891,"_28416":52687,"_3083":52831},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3632":583,"_31224":542,"_21643":52833,"_5":14891,"_28416":52687,"_3083":52834},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3632":584,"_31224":542,"_21643":52836,"_5":14891,"_28416":52691,"_3083":52837},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3632":585,"_31224":542,"_21643":52839,"_5":14891,"_28416":52691,"_3083":52840},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3632":586,"_31224":542,"_21643":52842,"_5":14891,"_28416":52695,"_3083":52843},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3632":587,"_31224":542,"_21643":52845,"_5":14891,"_28416":52695,"_3083":52846},[],"The decision is made **before forwarding the request to the service**:",{"_3632":588,"_31224":542,"_21643":52848,"_5":14891,"_28416":52695,"_3083":52849},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3632":589,"_31224":542,"_21643":52851,"_5":14891,"_28416":52695,"_3083":52852},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3632":590,"_31224":542,"_21643":52854,"_5":14891,"_28416":52695,"_3083":52855},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3632":591,"_31224":542,"_21643":52857,"_5":14891,"_28416":52695,"_3083":52858},[],"It separately loads the policies granted to each principal.",{"_3632":592,"_31224":542,"_21643":52860,"_5":14891,"_28416":52695,"_3083":52861},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3632":593,"_31224":542,"_21643":52863,"_5":14891,"_28416":52695,"_3083":52864},[],"`authz` looks for an HTTP rule granting that action.",{"_3632":594,"_31224":542,"_21643":52866,"_5":14891,"_28416":52695,"_3083":52867},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3632":595,"_31224":542,"_21643":52869,"_5":14891,"_28416":52695,"_3083":52870},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3632":596,"_31224":542,"_21643":52872,"_5":14891,"_28416":52695,"_3083":52873},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3632":597,"_31224":542,"_21643":52875,"_5":14891,"_28416":52695,"_3083":52876},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3632":598,"_31224":542,"_21643":52878,"_5":14891,"_28416":52699,"_3083":52879},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3632":599,"_31224":542,"_21643":52881,"_5":14891,"_28416":52699,"_3083":52882},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3632":600,"_31224":542,"_21643":52884,"_5":14891,"_28416":52699,"_3083":52885},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3632":601,"_31224":542,"_21643":52887,"_5":14891,"_28416":52699,"_3083":52888},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3632":602,"_31224":542,"_21643":52890,"_5":14891,"_28416":52699,"_3083":52891},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3632":603,"_31224":542,"_21643":52893,"_5":14891,"_28416":52699,"_3083":52894},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3632":604,"_31224":542,"_21643":52896,"_5":14891,"_28416":52699,"_3083":52897},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3632":605,"_31224":542,"_21643":52899,"_5":14891,"_28416":52699,"_3083":52900},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3632":606,"_31224":542,"_21643":52902,"_5":14891,"_28416":52699,"_3083":52903},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3632":607,"_31224":542,"_21643":52905,"_5":14891,"_28416":52699,"_3083":52906},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3632":608,"_31224":542,"_21643":52908,"_5":14891,"_28416":52703,"_3083":52909},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3632":609,"_31224":542,"_21643":52911,"_5":14891,"_28416":52703,"_3083":52912},[],"The decision is made with the domain operation context:",{"_3632":610,"_31224":542,"_21643":52914,"_5":14891,"_28416":52703,"_3083":52915},[],"The middleware extracts the credential and resolves the matching principals.",{"_3632":611,"_31224":542,"_21643":52917,"_5":14891,"_28416":52703,"_3083":52918},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3632":612,"_31224":542,"_21643":52920,"_5":14891,"_28416":52703,"_3083":52921},[],"`authz` gathers the entity rules of the granted policies.",{"_3632":613,"_31224":542,"_21643":52923,"_5":14891,"_28416":52703,"_3083":52924},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3632":614,"_31224":542,"_21643":52926,"_5":14891,"_28416":52703,"_3083":52927},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3632":615,"_31224":542,"_21643":52929,"_5":14891,"_28416":52703,"_3083":52930},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3632":616,"_31224":542,"_21643":52932,"_5":14891,"_28416":52703,"_3083":52933},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3632":617,"_31224":542,"_21643":52935,"_5":14891,"_28416":52703,"_3083":52936},[],"Actions fall into two groups:",{"_3632":618,"_31224":542,"_21643":52938,"_5":14891,"_28416":52703,"_3083":52939},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3632":619,"_31224":542,"_21643":52941,"_5":14891,"_28416":52703,"_3083":52942},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3632":620,"_31224":542,"_21643":52944,"_5":14891,"_28416":52703,"_3083":52945},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3632":621,"_31224":542,"_21643":52947,"_5":14891,"_28416":52707,"_3083":52948},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3632":622,"_31224":542,"_21643":52950,"_5":14891,"_28416":52707,"_3083":52951},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3632":623,"_31224":542,"_21643":52953,"_5":14891,"_28416":52707,"_3083":52954},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3632":624,"_31224":542,"_21643":52956,"_5":14891,"_28416":52711,"_3083":52957},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3632":625,"_31224":542,"_21643":52959,"_5":14891,"_28416":52711,"_3083":52960},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3632":626,"_31224":542,"_21643":52962,"_5":14891,"_28416":52711,"_3083":52963},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3632":627,"_31224":542,"_21643":52965,"_5":14891,"_28416":52711,"_3083":52966},[],"The implemented operators are:",{"_3632":628,"_31224":542,"_21643":52968,"_5":14891,"_28416":52711,"_3083":52969},[],"`equals`, for exact equality;",{"_3632":629,"_31224":542,"_21643":52971,"_5":14891,"_28416":52711,"_3083":52972},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3632":630,"_31224":542,"_21643":52974,"_5":14891,"_28416":52711,"_3083":52975},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3632":631,"_31224":542,"_21643":52977,"_5":14891,"_28416":52711,"_3083":52978},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3632":632,"_31224":542,"_21643":52980,"_5":14891,"_28416":52715,"_3083":52981},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3632":633,"_31224":542,"_21643":52983,"_5":14891,"_28416":52715,"_3083":52984},[],"The available modes are:",{"_3632":634,"_31224":542,"_21643":52986,"_5":14891,"_28416":52715,"_3083":52987},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3632":635,"_31224":542,"_21643":52989,"_5":14891,"_28416":52715,"_3083":52990},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3632":636,"_31224":542,"_21643":52992,"_5":14891,"_28416":52715,"_3083":52993},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3632":637,"_31224":542,"_21643":52995,"_5":14891,"_28416":52715,"_3083":52996},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3632":638,"_31224":542,"_21643":52998,"_5":14891,"_28416":52715,"_3083":52999},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3632":639,"_31224":542,"_21643":53001,"_5":14891,"_28416":52715,"_3083":53002},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3632":640,"_31224":542,"_21643":53004,"_5":14891,"_28416":52719,"_3083":53005},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3632":641,"_31224":542,"_21643":53007,"_5":14891,"_28416":52719,"_3083":53008},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3632":642,"_31224":542,"_21643":53010,"_5":14891,"_28416":52719,"_3083":53011},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3632":643,"_31224":542,"_21643":53013,"_5":14891,"_28416":52719,"_3083":53014},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3632":644,"_31224":542,"_21643":53016,"_5":14891,"_28416":52727,"_3083":53017},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3632":645,"_31224":542,"_21643":53019,"_5":14891,"_28416":52727,"_3083":53020},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3632":646,"_31224":542,"_21643":53022,"_5":14891,"_28416":52731,"_3083":53023},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3632":647,"_31224":542,"_21643":53025,"_5":14891,"_28416":52731,"_3083":53026},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3632":648,"_31224":542,"_21643":53028,"_5":14891,"_28416":52731,"_3083":53029},[],"The data model shows how the resources used in entity rules are connected.",{"_3632":649,"_31224":542,"_21643":53031,"_5":14891,"_28416":52731,"_3083":53032},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3632":650,"_31224":542,"_21643":53034,"_5":14891,"_28416":52731,"_3083":53035},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3632":651,"_31224":542,"_21643":53037,"_5":14891,"_28416":52735,"_3083":53038},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3632":652,"_31224":542,"_21643":53040,"_5":14891,"_28416":52735,"_3083":53041},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3632":653,"_31224":542,"_21643":53043,"_5":14891,"_28416":52735,"_3083":53044},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3632":654,"_31224":542,"_21643":53046,"_5":14891,"_28416":52739,"_3083":53047},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3632":655,"_31224":542,"_21643":53049,"_5":14891,"_28416":52739,"_3083":53050},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3632":656,"_31224":542,"_21643":53052,"_5":14891,"_28416":52739,"_3083":53053},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3632":657,"_31224":542,"_21643":53055,"_5":14891,"_28416":52739,"_3083":53056},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3632":658,"_31224":542,"_21643":53058,"_5":14891,"_28416":52739,"_3083":53059},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3632":659,"_31224":542,"_21643":53061,"_5":14891,"_28416":52739,"_3083":53062},[],"Note that:",{"_3632":660,"_31224":542,"_21643":53064,"_5":14891,"_28416":52739,"_3083":53065},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3632":661,"_31224":542,"_21643":53067,"_5":14891,"_28416":52739,"_3083":53068},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3632":662,"_31224":542,"_21643":53070,"_5":14891,"_28416":52739,"_3083":53071},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3632":663,"_31224":542,"_21643":53073,"_5":14891,"_28416":52743,"_3083":53074},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3632":664,"_31224":542,"_21643":53076,"_5":14891,"_28416":52743,"_3083":53077},[],"full and read-only access to certificates and authorities;",{"_3632":665,"_31224":542,"_21643":53079,"_5":14891,"_28416":52743,"_3083":53080},[],"full and read-only access to the KMS;",{"_3632":666,"_31224":542,"_21643":53082,"_5":14891,"_28416":52743,"_3083":53083},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3632":667,"_31224":542,"_21643":53085,"_5":14891,"_28416":52743,"_3083":53086},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3632":668,"_31224":542,"_21643":53088,"_5":14891,"_28416":52743,"_3083":53089},[],"console access;",{"_3632":669,"_31224":542,"_21643":53091,"_5":14891,"_28416":52743,"_3083":53092},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3632":670,"_31224":542,"_21643":53094,"_5":14891,"_28416":52743,"_3083":53095},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3632":671,"_31224":542,"_21643":53097,"_5":14891,"_28416":52743,"_3083":53098},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3632":672,"_31224":542,"_21643":53100,"_5":14891,"_28416":52743,"_3083":53101},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3632":673,"_31224":542,"_21643":53103,"_5":14891,"_28416":52743,"_3083":53104},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3632":674,"_31224":542,"_21643":53106,"_5":14891,"_28416":52747,"_3083":53107},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3632":675,"_31224":542,"_21643":53109,"_5":14891,"_28416":52747,"_3083":53110},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3632":676,"_31224":542,"_21643":53112,"_5":14891,"_28416":52747,"_3083":53113},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3632":677,"_31224":542,"_21643":53115,"_5":14891,"_28416":52750,"_3083":53116},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3632":678,"_31224":542,"_21643":53118,"_5":14891,"_28416":52754,"_3083":53119},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3632":679,"_31224":542,"_21643":53121,"_5":14891,"_28416":52754,"_3083":53122},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3632":680,"_31224":542,"_21643":53124,"_5":14891,"_28416":52758,"_3083":53125},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3632":681,"_31224":542,"_21643":53127,"_5":14891,"_28416":52762,"_3083":53128},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3632":682,"_31224":542,"_21643":53130,"_5":14891,"_28416":52766,"_3083":53131},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3632":683,"_31224":542,"_21643":53133,"_5":14891,"_28416":52770,"_3083":53134},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3632":684,"_31224":542,"_21643":53136,"_5":14891,"_28416":52770,"_3083":53137},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3632":685,"_31224":542,"_21643":53139,"_5":14891,"_28416":52774,"_3083":53140},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3632":686,"_31224":542,"_21643":53142,"_5":14891,"_28416":52774,"_3083":53143},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3632":687,"_31224":542,"_21643":53145,"_5":14891,"_28416":52774,"_3083":53146},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3632":688,"_31224":542,"_21643":53148,"_5":14891,"_28416":52774,"_3083":53149},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3632":689,"_31224":542,"_21643":53151,"_5":14891,"_28416":52774,"_3083":53152},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3632":690,"_31224":542,"_21643":53154,"_5":14891,"_28416":52774,"_3083":53155},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3632":691,"_31224":542,"_21643":53157,"_5":14891,"_28416":52774,"_3083":53158},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3632":692,"_31224":542,"_21643":53160,"_5":14891,"_28416":52774,"_3083":53161},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3632":693,"_31224":542,"_21643":53163,"_5":14891,"_28416":52778,"_3083":53164},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3632":694,"_31224":542,"_21643":53166,"_5":14891,"_28416":52778,"_3083":53167},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3632":695,"_31224":542,"_21643":53169,"_5":14891,"_28416":52778,"_3083":53170},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3632":696,"_31224":542,"_21643":53172,"_5":14891,"_28416":52782,"_3083":53173},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3632":697,"_31224":542,"_21643":53175,"_5":14891,"_28416":52782,"_3083":53176},[],"Use groups or stable roles for people and independent identities for automations.",{"_3632":698,"_31224":542,"_21643":53178,"_5":14891,"_28416":52782,"_3083":53179},[],"Keep at least two recovery administrators and test their access periodically.",{"_3632":699,"_31224":542,"_21643":53181,"_5":14891,"_28416":52782,"_3083":53182},[],"Review active principals, their matches and their grants after IdP changes.",{"_3632":700,"_31224":542,"_21643":53184,"_5":14891,"_28416":52782,"_3083":53185},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3632":701,"_31224":542,"_21643":53187,"_5":14891,"_28416":52782,"_3083":53188},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3632":702,"_31224":542,"_21643":53190,"_5":14891,"_28416":52782,"_3083":53191},[],"Always test one allowed and one denied operation for each role.",{"_3632":703,"_31224":542,"_21643":53193,"_5":14891,"_28416":52782,"_3083":53194},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3632":704,"_31224":542,"_21643":53196,"_5":14891,"_28416":52790,"_3083":53197},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3632":705,"_31224":542,"_21643":53199,"_5":14891,"_28416":52794,"_3083":53200},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3632":706,"_31224":542,"_21643":53202,"_5":14891,"_28416":52794,"_3083":53203},[],"that an active principal of the correct type exists;",{"_3632":707,"_31224":542,"_21643":53205,"_5":14891,"_28416":52794,"_3083":53206},[],"that the claim paths and values match the real token exactly;",{"_3632":708,"_31224":542,"_21643":53208,"_5":14891,"_28416":52794,"_3083":53209},[],"that all of the principal's conditions hold;",{"_3632":709,"_31224":542,"_21643":53211,"_5":14891,"_28416":52794,"_3083":53212},[],"that the principal has the expected policy granted;",{"_3632":710,"_31224":542,"_21643":53214,"_5":14891,"_28416":52794,"_3083":53215},[],"that the policy includes the action and the requested resource type or route;",{"_3632":711,"_31224":542,"_21643":53217,"_5":14891,"_28416":52794,"_3083":53218},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3632":712,"_31224":542,"_21643":53220,"_5":14891,"_28416":52794,"_3083":53221},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3632":713,"_31224":542,"_21643":53223,"_5":14891,"_28416":52794,"_3083":53224},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3632":714,"_31224":542,"_21643":53226,"_5":14891,"_28416":52798,"_3083":53227},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3632":715,"_31224":542,"_21643":53229,"_5":14891,"_28416":52802,"_3083":53230},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3632":716,"_31224":542,"_21643":53232,"_5":14891,"_28416":52806,"_3083":53233},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3632":717,"_31224":542,"_21643":53235,"_5":14891,"_28416":52806,"_3083":53236},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3632":718,"_31224":718,"_5":15251,"_3083":53238,"_31583":53239,"_21643":53240,"_28416":718},"Alerts and subscriptions",[51036,52548,52549],[],{"_3632":719,"_31224":718,"_21643":53242,"_5":14891,"_28416":718,"_3083":53243},[],"Send PKI events to people and external systems.",{"_3632":720,"_31224":718,"_5":31580,"_21643":53245,"_28416":53246,"_3083":53247},[],"/docs/pr-preview/pr-82/platform/administration/alerts#how-it-works","How it works",{"_3632":721,"_31224":718,"_5":31580,"_21643":53249,"_28416":53250,"_3083":53251},[],"/docs/pr-preview/pr-82/platform/administration/alerts#available-channels","Available channels",{"_3632":722,"_31224":718,"_5":31580,"_21643":53253,"_28416":53254,"_3083":53255},[],"/docs/pr-preview/pr-82/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3632":723,"_31224":718,"_5":31580,"_21643":53257,"_28416":53258,"_3083":53259},[],"/docs/pr-preview/pr-82/platform/administration/alerts#choose-the-event","Choose the event",{"_3632":724,"_31224":718,"_5":31580,"_21643":53261,"_28416":53262,"_3083":53263},[],"/docs/pr-preview/pr-82/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3632":725,"_31224":718,"_5":31580,"_21643":53265,"_28416":53266,"_3083":53267},[],"/docs/pr-preview/pr-82/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3632":726,"_31224":718,"_5":31580,"_21643":53269,"_28416":53270,"_3083":53271},[],"/docs/pr-preview/pr-82/platform/administration/alerts#review-and-activate","Review and activate",{"_3632":727,"_31224":718,"_5":31580,"_21643":53273,"_28416":53274,"_3083":53275},[],"/docs/pr-preview/pr-82/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3632":728,"_31224":718,"_5":31580,"_21643":53277,"_28416":53278,"_3083":53279},[],"/docs/pr-preview/pr-82/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3632":729,"_31224":718,"_5":31580,"_21643":53281,"_28416":53282,"_3083":53283},[],"/docs/pr-preview/pr-82/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3632":730,"_31224":718,"_5":31580,"_21643":53285,"_28416":53286,"_3083":53287},[],"/docs/pr-preview/pr-82/platform/administration/alerts#event-families","Event families",{"_3632":731,"_31224":718,"_21643":53289,"_5":14891,"_28416":718,"_3083":53290},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3632":732,"_31224":718,"_21643":53292,"_5":14891,"_28416":53246,"_3083":53293},[],"A service publishes a domain event.",{"_3632":733,"_31224":718,"_21643":53295,"_5":14891,"_28416":53246,"_3083":53296},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3632":734,"_31224":718,"_21643":53298,"_5":14891,"_28416":53246,"_3083":53299},[],"Each subscription's filter decides whether it should be notified.",{"_3632":735,"_31224":718,"_21643":53301,"_5":14891,"_28416":53246,"_3083":53302},[],"Lamassu delivers the event to the configured channel.",{"_3632":736,"_31224":718,"_21643":53304,"_5":14891,"_28416":53246,"_3083":53305},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3632":737,"_31224":718,"_21643":53307,"_5":14891,"_28416":53250,"_3083":53308},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3632":738,"_31224":718,"_21643":53310,"_5":14891,"_28416":53250,"_3083":53311},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3632":739,"_31224":718,"_21643":53313,"_5":14891,"_28416":53250,"_3083":53314},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3632":740,"_31224":718,"_21643":53316,"_5":14891,"_28416":53250,"_3083":53317},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3632":741,"_31224":718,"_21643":53319,"_5":14891,"_28416":53250,"_3083":53320},[],"`apikey_options` requires `header` and `key`.",{"_3632":742,"_31224":718,"_21643":53322,"_5":14891,"_28416":53250,"_3083":53323},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3632":743,"_31224":718,"_21643":53325,"_5":14891,"_28416":53250,"_3083":53326},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3632":744,"_31224":718,"_21643":53328,"_5":14891,"_28416":53250,"_3083":53329},[],"The alerts API reference documents the full `http_client` schema.",{"_3632":745,"_31224":718,"_21643":53331,"_5":14891,"_28416":53258,"_3083":53332},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3632":746,"_31224":718,"_21643":53334,"_5":14891,"_28416":53262,"_3083":53335},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3632":747,"_31224":718,"_21643":53337,"_5":14891,"_28416":53266,"_3083":53338},[],"Add a filter if you don't want to receive every instance of the event.",{"_3632":748,"_31224":718,"_21643":53340,"_5":14891,"_28416":53266,"_3083":53341},[],"**None** notifies all instances of the event.",{"_3632":749,"_31224":718,"_21643":53343,"_5":14891,"_28416":53266,"_3083":53344},[],"**JSON Path** evaluates one or more specific fields.",{"_3632":750,"_31224":718,"_21643":53346,"_5":14891,"_28416":53266,"_3083":53347},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3632":751,"_31224":718,"_21643":53349,"_5":14891,"_28416":53266,"_3083":53350},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3632":752,"_31224":718,"_21643":53352,"_5":14891,"_28416":53266,"_3083":53353},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3632":753,"_31224":718,"_21643":53355,"_5":14891,"_28416":53266,"_3083":53356},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3632":754,"_31224":718,"_21643":53358,"_5":14891,"_28416":53270,"_3083":53359},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3632":755,"_31224":718,"_21643":53361,"_5":14891,"_28416":53274,"_3083":53362},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3632":756,"_31224":718,"_21643":53364,"_5":14891,"_28416":53274,"_3083":53365},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3632":757,"_31224":718,"_21643":53367,"_5":14891,"_28416":53274,"_3083":53368},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3632":758,"_31224":718,"_21643":53370,"_5":14891,"_28416":53274,"_3083":53371},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3632":759,"_31224":718,"_21643":53373,"_5":14891,"_28416":53274,"_3083":53374},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3632":760,"_31224":718,"_21643":53376,"_5":14891,"_28416":53274,"_3083":53377},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3632":761,"_31224":718,"_21643":53379,"_5":14891,"_28416":53274,"_3083":53380},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3632":762,"_31224":718,"_21643":53382,"_5":14891,"_28416":53274,"_3083":53383},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3632":763,"_31224":718,"_21643":53385,"_5":14891,"_28416":53278,"_3083":53386},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3632":764,"_31224":718,"_21643":53388,"_5":14891,"_28416":53278,"_3083":53389},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3632":765,"_31224":718,"_21643":53391,"_5":14891,"_28416":53278,"_3083":53392},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3632":766,"_31224":718,"_21643":53394,"_5":14891,"_28416":53278,"_3083":53395},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3632":767,"_31224":718,"_21643":53397,"_5":14891,"_28416":53278,"_3083":53398},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3632":768,"_31224":718,"_21643":53400,"_5":14891,"_28416":53278,"_3083":53401},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3632":769,"_31224":718,"_21643":53403,"_5":14891,"_28416":53278,"_3083":53404},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3632":770,"_31224":718,"_21643":53406,"_5":14891,"_28416":53278,"_3083":53407},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3632":771,"_31224":718,"_21643":53409,"_5":14891,"_28416":53282,"_3083":53410},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3632":772,"_31224":718,"_21643":53412,"_5":14891,"_28416":53282,"_3083":53413},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3632":773,"_31224":718,"_21643":53415,"_5":14891,"_28416":53286,"_3083":53416},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3632":774,"_31224":718,"_21643":53418,"_5":14891,"_28416":53286,"_3083":53419},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3632":775,"_31224":718,"_21643":53421,"_5":14891,"_28416":53286,"_3083":53422},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3632":776,"_31224":718,"_21643":53424,"_5":14891,"_28416":53286,"_3083":53425},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3632":777,"_31224":718,"_21643":53427,"_5":14891,"_28416":53286,"_3083":53428},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3632":778,"_31224":718,"_21643":53430,"_5":14891,"_28416":53286,"_3083":53431},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3632":779,"_31224":718,"_21643":53433,"_5":14891,"_28416":53286,"_3083":53434},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3632":780,"_31224":718,"_21643":53436,"_5":14891,"_28416":53286,"_3083":53437},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3632":781,"_31224":718,"_21643":53439,"_5":14891,"_28416":53286,"_3083":53440},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3632":782,"_31224":718,"_21643":53442,"_5":14891,"_28416":53286,"_3083":53443},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3632":783,"_31224":783,"_5":15251,"_3083":53445,"_31583":53446,"_21643":53447,"_28416":783},"Audit logs",[51036,52548,52549],[],{"_3632":784,"_31224":783,"_21643":53449,"_5":14891,"_28416":783,"_3083":53450},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3632":785,"_31224":783,"_5":31580,"_21643":53452,"_28416":53453,"_3083":53454},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3632":786,"_31224":783,"_5":31580,"_21643":53456,"_28416":53457,"_3083":53458},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#coverage","Coverage",{"_3632":787,"_31224":783,"_5":31580,"_21643":53460,"_28416":53461,"_3083":53462},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3632":788,"_31224":783,"_5":31580,"_21643":53464,"_28416":53465,"_3083":53466},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3632":789,"_31224":783,"_5":31580,"_21643":53468,"_28416":53469,"_3083":53470},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3632":790,"_31224":783,"_5":31580,"_21643":53472,"_28416":53473,"_3083":53474},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3632":791,"_31224":783,"_5":31580,"_21643":53476,"_28416":53477,"_3083":53478},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3632":792,"_31224":783,"_5":31580,"_21643":53480,"_28416":53481,"_3083":53482},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3632":793,"_31224":783,"_5":31580,"_21643":53484,"_28416":53485,"_3083":53486},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3632":794,"_31224":783,"_5":31580,"_21643":53488,"_28416":53489,"_3083":53490},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3632":795,"_31224":783,"_5":31580,"_21643":53492,"_28416":53493,"_3083":53494},[],"/docs/pr-preview/pr-82/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3632":796,"_31224":783,"_21643":53496,"_5":14891,"_28416":783,"_3083":53497},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3632":797,"_31224":783,"_21643":53499,"_5":14891,"_28416":53453,"_3083":53500},[],"The audit body includes:",{"_3632":798,"_31224":783,"_21643":53502,"_5":14891,"_28416":53453,"_3083":53503},[],"input: data received by the operation;",{"_3632":799,"_31224":783,"_21643":53505,"_5":14891,"_28416":53453,"_3083":53506},[],"has\\_error: whether the service returned an error;",{"_3632":800,"_31224":783,"_21643":53508,"_5":14891,"_28416":53453,"_3083":53509},[],"output: produced result or error message;",{"_3632":801,"_31224":783,"_21643":53511,"_5":14891,"_28416":53453,"_3083":53512},[],"principals: identifiers of the principals that matched the request.",{"_3632":802,"_31224":783,"_21643":53514,"_5":14891,"_28416":53453,"_3083":53515},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3632":803,"_31224":783,"_21643":53517,"_5":14891,"_28416":53453,"_3083":53518},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3632":804,"_31224":783,"_21643":53520,"_5":14891,"_28416":53457,"_3083":53521},[],"The backend applies auditing to mutations of:",{"_3632":805,"_31224":783,"_21643":53523,"_5":14891,"_28416":53457,"_3083":53524},[],"authorities, certificates and issuance profiles;",{"_3632":806,"_31224":783,"_21643":53526,"_5":14891,"_28416":53457,"_3083":53527},[],"keys and KMS engines;",{"_3632":807,"_31224":783,"_21643":53529,"_5":14891,"_28416":53457,"_3083":53530},[],"devices and identities;",{"_3632":808,"_31224":783,"_21643":53532,"_5":14891,"_28416":53457,"_3083":53533},[],"DMSs and enrollment operations;",{"_3632":809,"_31224":783,"_21643":53535,"_5":14891,"_28416":53457,"_3083":53536},[],"validation functions and CRL;",{"_3632":810,"_31224":783,"_21643":53538,"_5":14891,"_28416":53457,"_3083":53539},[],"principals, policies and authorization grants.",{"_3632":811,"_31224":783,"_21643":53541,"_5":14891,"_28416":53457,"_3083":53542},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3632":812,"_31224":783,"_21643":53544,"_5":14891,"_28416":53461,"_3083":53545},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3632":813,"_31224":783,"_21643":53547,"_5":14891,"_28416":53461,"_3083":53548},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3632":814,"_31224":783,"_21643":53550,"_5":14891,"_28416":53461,"_3083":53551},[],"Design the consumer to:",{"_3632":815,"_31224":783,"_21643":53553,"_5":14891,"_28416":53461,"_3083":53554},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3632":816,"_31224":783,"_21643":53556,"_5":14891,"_28416":53461,"_3083":53557},[],"keep the complete CloudEvent unmodified;",{"_3632":817,"_31224":783,"_21643":53559,"_5":14891,"_28416":53461,"_3083":53560},[],"record the ingestion time and detect duplicates by ID;",{"_3632":818,"_31224":783,"_21643":53562,"_5":14891,"_28416":53461,"_3083":53563},[],"encrypt in transit and at rest;",{"_3632":819,"_31224":783,"_21643":53565,"_5":14891,"_28416":53461,"_3083":53566},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3632":820,"_31224":783,"_21643":53568,"_5":14891,"_28416":53461,"_3083":53569},[],"apply an explicit retention and legal hold policy;",{"_3632":821,"_31224":783,"_21643":53571,"_5":14891,"_28416":53461,"_3083":53572},[],"alert if it stops consuming or the pending queue grows.",{"_3632":822,"_31224":783,"_21643":53574,"_5":14891,"_28416":53465,"_3083":53575},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3632":823,"_31224":783,"_21643":53577,"_5":14891,"_28416":53465,"_3083":53578},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3632":824,"_31224":783,"_21643":53580,"_5":14891,"_28416":53473,"_3083":53581},[],"Start from the reported time and normalize every source to UTC.",{"_3632":825,"_31224":783,"_21643":53583,"_5":14891,"_28416":53477,"_3083":53584},[],"Filter by event type, service source and resource identifier.",{"_3632":826,"_31224":783,"_21643":53586,"_5":14891,"_28416":53481,"_3083":53587},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3632":827,"_31224":783,"_21643":53589,"_5":14891,"_28416":53485,"_3083":53590},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3632":828,"_31224":783,"_21643":53592,"_5":14891,"_28416":53489,"_3083":53593},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3632":829,"_31224":783,"_21643":53595,"_5":14891,"_28416":53493,"_3083":53596},[],"Generate a controlled mutation in a test environment and check that:",{"_3632":830,"_31224":783,"_21643":53598,"_5":14891,"_28416":53493,"_3083":53599},[],"a successful audit event appears;",{"_3632":831,"_31224":783,"_21643":53601,"_5":14891,"_28416":53493,"_3083":53602},[],"the principal matches the identity used;",{"_3632":832,"_31224":783,"_21643":53604,"_5":14891,"_28416":53493,"_3083":53605},[],"the consumer persists it exactly once;",{"_3632":833,"_31224":783,"_21643":53607,"_5":14891,"_28416":53493,"_3083":53608},[],"it can be retrieved by resource, actor and period;",{"_3632":834,"_31224":783,"_21643":53610,"_5":14891,"_28416":53493,"_3083":53611},[],"a consumer outage raises an alert.",{"_3632":835,"_31224":783,"_21643":53613,"_5":14891,"_28416":53493,"_3083":53614},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3632":836,"_31224":836,"_5":15251,"_3083":53616,"_31583":53617,"_21643":53618,"_28416":836},"Platform architecture",[51036,52548],[],{"_3632":837,"_31224":836,"_21643":53620,"_5":14891,"_28416":836,"_3083":53621},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3632":838,"_31224":836,"_5":31580,"_21643":53623,"_28416":53624,"_3083":53625},[],"/docs/pr-preview/pr-82/platform/concepts/architecture#control-plane","Control plane",{"_3632":839,"_31224":836,"_5":31580,"_21643":53627,"_28416":53628,"_3083":53629},[],"/docs/pr-preview/pr-82/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3632":840,"_31224":836,"_5":31580,"_21643":53631,"_28416":53632,"_3083":53633},[],"/docs/pr-preview/pr-82/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3632":841,"_31224":836,"_5":31580,"_21643":53635,"_28416":53636,"_3083":53637},[],"/docs/pr-preview/pr-82/platform/concepts/architecture#status-and-validation","Status and validation",{"_3632":842,"_31224":836,"_5":31580,"_21643":53639,"_28416":53640,"_3083":53641},[],"/docs/pr-preview/pr-82/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3632":843,"_31224":836,"_21643":53643,"_5":14891,"_28416":836,"_3083":53644},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3632":844,"_31224":836,"_21643":53646,"_5":14891,"_28416":836,"_3083":53647},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3632":845,"_31224":836,"_21643":53649,"_5":14891,"_28416":53624,"_3083":53650},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3632":846,"_31224":836,"_21643":53652,"_5":14891,"_28416":53628,"_3083":53653},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3632":847,"_31224":836,"_21643":53655,"_5":14891,"_28416":53632,"_3083":53656},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3632":848,"_31224":836,"_21643":53658,"_5":14891,"_28416":53636,"_3083":53659},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3632":849,"_31224":836,"_21643":53661,"_5":14891,"_28416":53640,"_3083":53662},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3632":850,"_31224":850,"_5":15251,"_3083":53664,"_31583":53665,"_21643":53666,"_28416":850},"How Lamassu works",[51036,52548],[],{"_3632":851,"_31224":850,"_21643":53668,"_5":14891,"_28416":850,"_3083":53669},[],"The mental model of trust, keys, certificates and devices.",{"_3632":852,"_31224":850,"_5":31580,"_21643":53671,"_28416":53672,"_3083":53673},[],"/docs/pr-preview/pr-82/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3632":853,"_31224":850,"_5":31580,"_21643":53675,"_28416":53676,"_3083":53677},[],"/docs/pr-preview/pr-82/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3632":854,"_31224":850,"_21643":53679,"_5":14891,"_28416":850,"_3083":53680},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3632":855,"_31224":850,"_21643":53682,"_5":14891,"_28416":53672,"_3083":53683},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3632":856,"_31224":850,"_21643":53685,"_5":14891,"_28416":53672,"_3083":53686},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3632":857,"_31224":850,"_21643":53688,"_5":14891,"_28416":53672,"_3083":53689},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3632":858,"_31224":850,"_21643":53691,"_5":14891,"_28416":53672,"_3083":53692},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3632":859,"_31224":850,"_21643":53694,"_5":14891,"_28416":53672,"_3083":53695},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3632":860,"_31224":850,"_21643":53697,"_5":14891,"_28416":53676,"_3083":53698},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3632":861,"_31224":850,"_21643":53700,"_5":14891,"_28416":53676,"_3083":53701},[],"A DMS relates that CA to an enrollment policy.",{"_3632":862,"_31224":850,"_21643":53703,"_5":14891,"_28416":53676,"_3083":53704},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3632":863,"_31224":850,"_21643":53706,"_5":14891,"_28416":53676,"_3083":53707},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3632":864,"_31224":850,"_21643":53709,"_5":14891,"_28416":53676,"_3083":53710},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3632":865,"_31224":850,"_21643":53712,"_5":14891,"_28416":53676,"_3083":53713},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3632":866,"_31224":850,"_21643":53715,"_5":14891,"_28416":53676,"_3083":53716},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3632":867,"_31224":867,"_5":15251,"_3083":53718,"_31583":53719,"_21643":53721,"_28416":867},"Devices and identities",[51036,52548,53720,53718],"IoT Fleets",[],{"_3632":868,"_31224":867,"_21643":53723,"_5":14891,"_28416":867,"_3083":53724},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3632":869,"_31224":867,"_5":31580,"_21643":53726,"_28416":53727,"_3083":53728},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#device-states","Device states",{"_3632":870,"_31224":867,"_5":31580,"_21643":53730,"_28416":53731,"_3083":53732},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3632":871,"_31224":867,"_5":31580,"_21643":53734,"_28416":53735,"_3083":53736},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3632":872,"_31224":867,"_5":31580,"_21643":53738,"_28416":53739,"_3083":53740},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3632":873,"_31224":867,"_5":31580,"_21643":53742,"_28416":53743,"_3083":53744},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3632":874,"_31224":867,"_5":31580,"_21643":53746,"_28416":53747,"_3083":53748},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3632":875,"_31224":867,"_5":31580,"_21643":53750,"_28416":53751,"_3083":53752},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3632":876,"_31224":867,"_5":31580,"_21643":53754,"_28416":53755,"_3083":53756},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3632":877,"_31224":867,"_5":31580,"_21643":53758,"_28416":53759,"_3083":53760},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3632":878,"_31224":867,"_5":31580,"_21643":53762,"_28416":53763,"_3083":53764},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3632":879,"_31224":867,"_5":31580,"_21643":53766,"_28416":53767,"_3083":53768},[],"/docs/pr-preview/pr-82/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3632":880,"_31224":867,"_21643":53770,"_5":14891,"_28416":867,"_3083":53771},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3632":881,"_31224":867,"_21643":53773,"_5":14891,"_28416":867,"_3083":53774},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3632":882,"_31224":867,"_21643":53776,"_5":14891,"_28416":53727,"_3083":53777},[],"Operational view",{"_3632":883,"_31224":867,"_21643":53779,"_5":14891,"_28416":53727,"_3083":53780},[],"Meaning",{"_3632":884,"_31224":867,"_21643":53782,"_5":14891,"_28416":53727,"_3083":53783},[],"**No Identity**",{"_3632":885,"_31224":867,"_21643":53785,"_5":14891,"_28416":53727,"_3083":53786},[],"A record exists without an associated identity.",{"_3632":886,"_31224":867,"_21643":53788,"_5":14891,"_28416":53727,"_3083":53789},[],"**Active**",{"_3632":887,"_31224":867,"_21643":53791,"_5":14891,"_28416":53727,"_3083":53792},[],"The slot is active; also check certificate dates, status and usages.",{"_3632":888,"_31224":867,"_21643":53794,"_5":14891,"_28416":53727,"_3083":53795},[],"**Renewal Pending**",{"_3632":889,"_31224":867,"_21643":53797,"_5":14891,"_28416":53727,"_3083":53798},[],"The identity is in the operational renewal window.",{"_3632":890,"_31224":867,"_21643":53800,"_5":14891,"_28416":53727,"_3083":53801},[],"**Expiring Soon**",{"_3632":891,"_31224":867,"_21643":53803,"_5":14891,"_28416":53727,"_3083":53804},[],"Expiration is approaching according to configured thresholds.",{"_3632":892,"_31224":867,"_21643":53806,"_5":14891,"_28416":53727,"_3083":53807},[],"**Expired**",{"_3632":893,"_31224":867,"_21643":53809,"_5":14891,"_28416":53727,"_3083":53810},[],"The identity has expired.",{"_3632":894,"_31224":867,"_21643":53812,"_5":14891,"_28416":53727,"_3083":53813},[],"**Revoked**",{"_3632":895,"_31224":867,"_21643":53815,"_5":14891,"_28416":53727,"_3083":53816},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3632":896,"_31224":867,"_21643":53818,"_5":14891,"_28416":53727,"_3083":53819},[],"**Decommissioned**",{"_3632":897,"_31224":867,"_21643":53821,"_5":14891,"_28416":53727,"_3083":53822},[],"The record is retired and ordinary updates do not restore operation.",{"_3632":898,"_31224":867,"_21643":53824,"_5":14891,"_28416":53727,"_3083":53825},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3632":899,"_31224":867,"_21643":53827,"_5":14891,"_28416":53731,"_3083":53828},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3632":900,"_31224":867,"_21643":53830,"_5":14891,"_28416":53731,"_3083":53831},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3632":901,"_31224":867,"_21643":53833,"_5":14891,"_28416":53731,"_3083":53834},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. In **Live** mode it follows new events and device changes (such as status or owner) automatically without reloading the page, and shows a **Connected** or **Disconnected** indicator. After an interruption it reconnects and recovers without gaps or duplicates, so **Live** shows the same content a page reload would. When live updates cannot be used — no permission, device not found, or live updates not enabled on the server — the timeline shows `Live updates unavailable: ...` with the reason, while history browsing (**Load more**) still works. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3632":902,"_31224":867,"_21643":53836,"_5":14891,"_28416":53731,"_3083":53837},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3632":903,"_31224":867,"_21643":53839,"_5":14891,"_28416":53735,"_3083":53840},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3632":904,"_31224":867,"_21643":53842,"_5":14891,"_28416":53739,"_3083":53843},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3632":905,"_31224":867,"_21643":53845,"_5":14891,"_28416":53743,"_3083":53846},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3632":906,"_31224":867,"_21643":53848,"_5":14891,"_28416":53747,"_3083":53849},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3632":907,"_31224":867,"_21643":53851,"_5":14891,"_28416":53751,"_3083":53852},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3632":908,"_31224":867,"_21643":53854,"_5":14891,"_28416":53751,"_3083":53855},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3632":909,"_31224":867,"_21643":53857,"_5":14891,"_28416":53755,"_3083":53858},[],"From **No Identity**, use **Assign Identity**:",{"_3632":910,"_31224":867,"_21643":53860,"_5":14891,"_28416":53755,"_3083":53861},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3632":911,"_31224":867,"_21643":53863,"_5":14891,"_28416":53755,"_3083":53864},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3632":912,"_31224":867,"_21643":53866,"_5":14891,"_28416":53755,"_3083":53867},[],"Confirm and read the serial, active version and history again.",{"_3632":913,"_31224":867,"_21643":53869,"_5":14891,"_28416":53755,"_3083":53870},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3632":914,"_31224":867,"_21643":53872,"_5":14891,"_28416":53755,"_3083":53873},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3632":915,"_31224":867,"_21643":53875,"_5":14891,"_28416":53759,"_3083":53876},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3632":916,"_31224":867,"_21643":53878,"_5":14891,"_28416":53759,"_3083":53879},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3632":917,"_31224":867,"_21643":53881,"_5":14891,"_28416":53759,"_3083":53882},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3632":918,"_31224":867,"_21643":53884,"_5":14891,"_28416":53763,"_3083":53885},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3632":919,"_31224":867,"_21643":53887,"_5":14891,"_28416":53763,"_3083":53888},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3632":920,"_31224":867,"_21643":53890,"_5":14891,"_28416":53763,"_3083":53891},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3632":921,"_31224":867,"_21643":53893,"_5":14891,"_28416":53763,"_3083":53894},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3632":922,"_31224":867,"_21643":53896,"_5":14891,"_28416":53767,"_3083":53897},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":923,"_31224":867,"_21643":53899,"_5":14891,"_28416":53767,"_3083":53900},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":924,"_31224":924,"_5":15251,"_3083":53902,"_31583":53903,"_21643":53905,"_28416":924},"Bootstrap identity and authentication",[51036,52548,53720,53718,53904],"Enrollment with PKI",[],{"_3632":925,"_31224":924,"_21643":53907,"_5":14891,"_28416":924,"_3083":53908},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3632":926,"_31224":924,"_5":31580,"_21643":53910,"_28416":53911,"_3083":53912},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3632":927,"_31224":924,"_5":31580,"_21643":53914,"_28416":53915,"_3083":53916},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3632":928,"_31224":924,"_5":31580,"_21643":53918,"_28416":53919,"_3083":53920},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3632":929,"_31224":924,"_5":31580,"_21643":53922,"_28416":53923,"_3083":53924},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3632":930,"_31224":924,"_5":31580,"_21643":53926,"_28416":53927,"_3083":53928},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3632":931,"_31224":924,"_21643":53930,"_5":14891,"_28416":924,"_3083":53931},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3632":932,"_31224":924,"_21643":53933,"_5":14891,"_28416":53911,"_3083":53934},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3632":933,"_31224":924,"_21643":53936,"_5":14891,"_28416":53911,"_3083":53937},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3632":934,"_31224":924,"_21643":53939,"_5":14891,"_28416":53915,"_3083":53940},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3632":935,"_31224":924,"_21643":53942,"_5":14891,"_28416":53915,"_3083":53943},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3632":936,"_31224":924,"_21643":53945,"_5":14891,"_28416":53915,"_3083":53946},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3632":937,"_31224":924,"_21643":53948,"_5":14891,"_28416":53919,"_3083":53949},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3632":938,"_31224":924,"_21643":53951,"_5":14891,"_28416":53919,"_3083":53952},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3632":939,"_31224":924,"_21643":53954,"_5":14891,"_28416":53923,"_3083":53955},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3632":940,"_31224":924,"_21643":53957,"_5":14891,"_28416":53923,"_3083":53958},[],"Example body:",{"_3632":941,"_31224":924,"_21643":53960,"_5":14891,"_28416":53923,"_3083":53961},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3632":942,"_31224":924,"_21643":53963,"_5":14891,"_28416":53923,"_3083":53964},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3632":943,"_31224":924,"_21643":53966,"_5":14891,"_28416":53923,"_3083":53967},[],"Continuation requires a successful HTTP response and JSON:",{"_3632":944,"_31224":924,"_21643":53969,"_5":14891,"_28416":53923,"_3083":53970},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3632":945,"_31224":924,"_21643":53972,"_5":14891,"_28416":53927,"_3083":53973},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3632":946,"_31224":924,"_21643":53975,"_5":14891,"_28416":53927,"_3083":53976},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3632":947,"_31224":924,"_21643":53978,"_5":14891,"_28416":53927,"_3083":53979},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3632":948,"_31224":924,"_21643":53981,"_5":14891,"_28416":53927,"_3083":53982},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3632":949,"_31224":949,"_5":15251,"_3083":53984,"_31583":53985,"_21643":53986,"_28416":949},"Configure and operate the DMS",[51036,52548,53720,53718,53904],[],{"_3632":950,"_31224":949,"_21643":53988,"_5":14891,"_28416":949,"_3083":53989},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3632":951,"_31224":949,"_5":31580,"_21643":53991,"_28416":53992,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3632":952,"_31224":949,"_5":31580,"_21643":53994,"_28416":53995,"_3083":53996},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3632":953,"_31224":949,"_5":31580,"_21643":53998,"_28416":53999,"_3083":54000},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3632":954,"_31224":949,"_5":31580,"_21643":54002,"_28416":54003,"_3083":54004},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3632":955,"_31224":949,"_5":31580,"_21643":54006,"_28416":54007,"_3083":54008},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3632":956,"_31224":949,"_5":31580,"_21643":54010,"_28416":54011,"_3083":54012},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3632":957,"_31224":949,"_5":31580,"_21643":54014,"_28416":54015,"_3083":54016},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3632":958,"_31224":949,"_5":31580,"_21643":54018,"_28416":54019,"_3083":54020},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3632":959,"_31224":949,"_5":31580,"_21643":54022,"_28416":54023,"_3083":54024},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3632":960,"_31224":949,"_5":31580,"_21643":54026,"_28416":54027,"_3083":54028},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3632":961,"_31224":949,"_5":31580,"_21643":54030,"_28416":54031,"_3083":54032},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3632":962,"_31224":949,"_5":31580,"_21643":54034,"_28416":54035,"_3083":54036},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3632":963,"_31224":949,"_5":31580,"_21643":54038,"_28416":54039,"_3083":54040},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3632":964,"_31224":949,"_5":31580,"_21643":54042,"_28416":54043,"_3083":54044},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3632":965,"_31224":949,"_5":31580,"_21643":54046,"_28416":54047,"_3083":54048},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3632":966,"_31224":949,"_5":31580,"_21643":54050,"_28416":54051,"_3083":54052},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3632":967,"_31224":949,"_5":31580,"_21643":54054,"_28416":54055,"_3083":54056},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3632":968,"_31224":949,"_5":31580,"_21643":54058,"_28416":54059,"_3083":54060},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3632":969,"_31224":949,"_21643":54062,"_5":14891,"_28416":949,"_3083":54063},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3632":970,"_31224":949,"_21643":54065,"_5":14891,"_28416":53992,"_3083":54066},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3632":971,"_31224":949,"_21643":54068,"_5":14891,"_28416":53992,"_3083":54069},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3632":972,"_31224":949,"_21643":54071,"_5":14891,"_28416":53999,"_3083":54072},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3632":973,"_31224":949,"_21643":54074,"_5":14891,"_28416":54003,"_3083":54075},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3632":974,"_31224":949,"_21643":54077,"_5":14891,"_28416":54007,"_3083":54078},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3632":975,"_31224":949,"_21643":54080,"_5":14891,"_28416":54011,"_3083":54081},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3632":976,"_31224":949,"_21643":54083,"_5":14891,"_28416":54015,"_3083":54084},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3632":977,"_31224":949,"_21643":54086,"_5":14891,"_28416":54023,"_3083":54087},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3632":978,"_31224":949,"_21643":54089,"_5":14891,"_28416":54023,"_3083":54090},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3632":979,"_31224":949,"_21643":54092,"_5":14891,"_28416":54027,"_3083":54093},[],"`settings.enrollment_settings` field",{"_3632":980,"_31224":949,"_21643":54095,"_5":14891,"_28416":54027,"_3083":54096},[],"Decision",{"_3632":981,"_31224":949,"_21643":54098,"_5":14891,"_28416":54027,"_3083":54099},[],"`protocol`",{"_3632":982,"_31224":949,"_21643":54101,"_5":14891,"_28416":54027,"_3083":54102},[],"`EST_RFC7030` for these operations.",{"_3632":983,"_31224":949,"_21643":54104,"_5":14891,"_28416":54027,"_3083":54105},[],"`enrollment_ca`",{"_3632":984,"_31224":949,"_21643":54107,"_5":14891,"_28416":54027,"_3083":54108},[],"ID of the signing CA.",{"_3632":985,"_31224":949,"_21643":54110,"_5":14891,"_28416":54027,"_3083":54111},[],"`verify_csr_signature`",{"_3632":986,"_31224":949,"_21643":54113,"_5":14891,"_28416":54027,"_3083":54114},[],"Keep `true` to verify CSR key possession.",{"_3632":987,"_31224":949,"_21643":54116,"_5":14891,"_28416":54027,"_3083":54117},[],"`enable_replaceable_enrollment`",{"_3632":988,"_31224":949,"_21643":54119,"_5":14891,"_28416":54027,"_3083":54120},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3632":989,"_31224":949,"_21643":54122,"_5":14891,"_28416":54027,"_3083":54123},[],"`est_rfc7030_settings.auth_mode`",{"_3632":990,"_31224":949,"_21643":54125,"_5":14891,"_28416":54027,"_3083":54126},[],"One of the four authentication modes.",{"_3632":991,"_31224":949,"_21643":54128,"_5":14891,"_28416":54027,"_3083":54129},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3632":992,"_31224":949,"_21643":54131,"_5":14891,"_28416":54031,"_3083":54132},[],"The blocks are independent:",{"_3632":993,"_31224":949,"_21643":54134,"_5":14891,"_28416":54031,"_3083":54135},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3632":994,"_31224":949,"_21643":54137,"_5":14891,"_28416":54031,"_3083":54138},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3632":995,"_31224":949,"_21643":54140,"_5":14891,"_28416":54031,"_3083":54141},[],"`auth_mode`",{"_3632":996,"_31224":949,"_21643":54143,"_5":14891,"_28416":54031,"_3083":54144},[],"Control applied in the configured operation",{"_3632":997,"_31224":949,"_21643":54146,"_5":14891,"_28416":54031,"_3083":54147},[],"`CLIENT_CERTIFICATE`",{"_3632":998,"_31224":949,"_21643":54149,"_5":14891,"_28416":54031,"_3083":54150},[],"Presented certificate validation.",{"_3632":999,"_31224":949,"_21643":54152,"_5":14891,"_28416":54031,"_3083":54153},[],"`EXTERNAL_WEBHOOK`",{"_3632":1000,"_31224":949,"_21643":54155,"_5":14891,"_28416":54031,"_3083":54156},[],"Configured webhook authorization.",{"_3632":1001,"_31224":949,"_21643":54158,"_5":14891,"_28416":54031,"_3083":54159},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3632":1002,"_31224":949,"_21643":54161,"_5":14891,"_28416":54031,"_3083":54162},[],"Certificate validation followed by webhook approval.",{"_3632":1003,"_31224":949,"_21643":54164,"_5":14891,"_28416":54031,"_3083":54165},[],"`NO_AUTH`",{"_3632":1004,"_31224":949,"_21643":54167,"_5":14891,"_28416":54031,"_3083":54168},[],"No DMS requester authentication.",{"_3632":1005,"_31224":949,"_21643":54170,"_5":14891,"_28416":54031,"_3083":54171},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3632":1006,"_31224":949,"_21643":54173,"_5":14891,"_28416":54031,"_3083":54174},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3632":1007,"_31224":949,"_21643":54176,"_5":14891,"_28416":54031,"_3083":54177},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3632":1008,"_31224":949,"_21643":54179,"_5":14891,"_28416":54031,"_3083":54180},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3632":1009,"_31224":949,"_21643":54182,"_5":14891,"_28416":54031,"_3083":54183},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3632":1010,"_31224":949,"_21643":54185,"_5":14891,"_28416":54035,"_3083":54186},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3632":1011,"_31224":949,"_21643":54188,"_5":14891,"_28416":54035,"_3083":54189},[],"`external_webhook_settings` field",{"_3632":1012,"_31224":949,"_21643":54191,"_5":14891,"_28416":54035,"_3083":54096},[],{"_3632":1013,"_31224":949,"_21643":54193,"_5":14891,"_28416":54035,"_3083":54194},[],"`url`",{"_3632":1014,"_31224":949,"_21643":54196,"_5":14891,"_28416":54035,"_3083":54197},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3632":1015,"_31224":949,"_21643":54199,"_5":14891,"_28416":54035,"_3083":54200},[],"`method`",{"_3632":1016,"_31224":949,"_21643":54202,"_5":14891,"_28416":54035,"_3083":54203},[],"`POST` or `PUT`; `POST` by default.",{"_3632":1017,"_31224":949,"_21643":54205,"_5":14891,"_28416":54035,"_3083":54206},[],"`name`",{"_3632":1018,"_31224":949,"_21643":54208,"_5":14891,"_28416":54035,"_3083":54209},[],"Label used in service logs.",{"_3632":1019,"_31224":949,"_21643":54211,"_5":14891,"_28416":54035,"_3083":54212},[],"`config.auth_mode`",{"_3632":1020,"_31224":949,"_21643":54214,"_5":14891,"_28416":54035,"_3083":54215},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3632":1021,"_31224":949,"_21643":54217,"_5":14891,"_28416":54035,"_3083":54218},[],"`config.log_level`",{"_3632":1022,"_31224":949,"_21643":54220,"_5":14891,"_28416":54035,"_3083":54221},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3632":1023,"_31224":949,"_21643":54223,"_5":14891,"_28416":54035,"_3083":54224},[],"`config.apikey_options`",{"_3632":1024,"_31224":949,"_21643":54226,"_5":14891,"_28416":54035,"_3083":54227},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3632":1025,"_31224":949,"_21643":54229,"_5":14891,"_28416":54035,"_3083":54230},[],"`config.jwt_options`",{"_3632":1026,"_31224":949,"_21643":54232,"_5":14891,"_28416":54035,"_3083":54233},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3632":1027,"_31224":949,"_21643":54235,"_5":14891,"_28416":54035,"_3083":54236},[],"`config.mtls_options`",{"_3632":1028,"_31224":949,"_21643":54238,"_5":14891,"_28416":54035,"_3083":54239},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3632":1029,"_31224":949,"_21643":54241,"_5":14891,"_28416":54035,"_3083":54242},[],"`config.insecure_skip_verify`",{"_3632":1030,"_31224":949,"_21643":54244,"_5":14891,"_28416":54035,"_3083":54245},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3632":1031,"_31224":949,"_21643":54247,"_5":14891,"_28416":54035,"_3083":54248},[],"`config.call_timeout`",{"_3632":1032,"_31224":949,"_21643":54250,"_5":14891,"_28416":54035,"_3083":54251},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3632":1033,"_31224":949,"_21643":54253,"_5":14891,"_28416":54035,"_3083":54254},[],"Rules for that configuration:",{"_3632":1034,"_31224":949,"_21643":54256,"_5":14891,"_28416":54035,"_3083":54257},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3632":1035,"_31224":949,"_21643":54259,"_5":14891,"_28416":54035,"_3083":54260},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3632":1036,"_31224":949,"_21643":54262,"_5":14891,"_28416":54035,"_3083":54263},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3632":1037,"_31224":949,"_21643":54265,"_5":14891,"_28416":54035,"_3083":54266},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3632":1038,"_31224":949,"_21643":54268,"_5":14891,"_28416":54035,"_3083":54269},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3632":1039,"_31224":949,"_21643":54271,"_5":14891,"_28416":54035,"_3083":54272},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3632":1040,"_31224":949,"_21643":54274,"_5":14891,"_28416":54035,"_3083":54275},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3632":1041,"_31224":949,"_21643":54277,"_5":14891,"_28416":54035,"_3083":54278},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3632":1042,"_31224":949,"_21643":54280,"_5":14891,"_28416":54035,"_3083":54281},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3632":1043,"_31224":949,"_21643":54283,"_5":14891,"_28416":54039,"_3083":54284},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3632":1044,"_31224":949,"_21643":54286,"_5":14891,"_28416":54043,"_3083":54287},[],"`settings.reenrollment_settings` field",{"_3632":1045,"_31224":949,"_21643":54289,"_5":14891,"_28416":54043,"_3083":51426},[],{"_3632":1046,"_31224":949,"_21643":54291,"_5":14891,"_28416":54043,"_3083":54292},[],"`reenrollment_delta`",{"_3632":1047,"_31224":949,"_21643":54294,"_5":14891,"_28416":54043,"_3083":54295},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3632":1048,"_31224":949,"_21643":54297,"_5":14891,"_28416":54043,"_3083":54298},[],"`preventive_delta`",{"_3632":1049,"_31224":949,"_21643":54300,"_5":14891,"_28416":54043,"_3083":54301},[],"Preventive operational monitoring threshold.",{"_3632":1050,"_31224":949,"_21643":54303,"_5":14891,"_28416":54043,"_3083":54304},[],"`critical_delta`",{"_3632":1051,"_31224":949,"_21643":54306,"_5":14891,"_28416":54043,"_3083":54307},[],"Critical operational monitoring threshold.",{"_3632":1052,"_31224":949,"_21643":54309,"_5":14891,"_28416":54043,"_3083":54310},[],"`enable_expired_renewal`",{"_3632":1053,"_31224":949,"_21643":54312,"_5":14891,"_28416":54043,"_3083":54313},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3632":1054,"_31224":949,"_21643":54315,"_5":14891,"_28416":54043,"_3083":54316},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3632":1055,"_31224":949,"_21643":54318,"_5":14891,"_28416":54043,"_3083":54319},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3632":1056,"_31224":949,"_21643":54321,"_5":14891,"_28416":54043,"_3083":54322},[],"`revoke_on_reenrollment`",{"_3632":1057,"_31224":949,"_21643":54324,"_5":14891,"_28416":54043,"_3083":54325},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3632":1058,"_31224":949,"_21643":54327,"_5":14891,"_28416":54043,"_3083":54328},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3632":1059,"_31224":949,"_21643":54330,"_5":14891,"_28416":54047,"_3083":54331},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3632":1060,"_31224":949,"_21643":54333,"_5":14891,"_28416":54051,"_3083":51420},[],{"_3632":1061,"_31224":949,"_21643":54335,"_5":14891,"_28416":54051,"_3083":54336},[],"Published material",{"_3632":1062,"_31224":949,"_21643":54338,"_5":14891,"_28416":54051,"_3083":54339},[],"**Include Lamassu System CA**",{"_3632":1063,"_31224":949,"_21643":54341,"_5":14891,"_28416":54051,"_3083":54342},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3632":1064,"_31224":949,"_21643":54344,"_5":14891,"_28416":54051,"_3083":54345},[],"**Include Enrollment CA**",{"_3632":1065,"_31224":949,"_21643":54347,"_5":14891,"_28416":54051,"_3083":54348},[],"Selected issuing CA certificate.",{"_3632":1066,"_31224":949,"_21643":54350,"_5":14891,"_28416":54051,"_3083":54351},[],"**Managed CAs**",{"_3632":1067,"_31224":949,"_21643":54353,"_5":14891,"_28416":54051,"_3083":54354},[],"Explicitly selected CA certificates.",{"_3632":1068,"_31224":949,"_21643":54356,"_5":14891,"_28416":54051,"_3083":54357},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3632":1069,"_31224":949,"_21643":54359,"_5":14891,"_28416":54055,"_3083":54360},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3632":1070,"_31224":949,"_21643":54362,"_5":14891,"_28416":54055,"_3083":54363},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3632":1071,"_31224":949,"_21643":54365,"_5":14891,"_28416":54055,"_3083":54366},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3632":1072,"_31224":949,"_21643":54368,"_5":14891,"_28416":54059,"_3083":54369},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3632":1073,"_31224":1073,"_5":15251,"_3083":54371,"_31583":54372,"_21643":54373,"_28416":1073},"Integrate the EST client",[51036,52548,53720,53718,53904],[],{"_3632":1074,"_31224":1073,"_21643":54375,"_5":14891,"_28416":1073,"_3083":54376},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3632":1075,"_31224":1073,"_5":31580,"_21643":54378,"_28416":54379,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3632":1076,"_31224":1073,"_5":31580,"_21643":54381,"_28416":54382,"_3083":54383},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3632":1077,"_31224":1073,"_5":31580,"_21643":54385,"_28416":54386,"_3083":54387},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3632":1078,"_31224":1073,"_5":31580,"_21643":54389,"_28416":54390,"_3083":54391},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3632":1079,"_31224":1073,"_5":31580,"_21643":54393,"_28416":54394,"_3083":54395},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3632":1080,"_31224":1073,"_5":31580,"_21643":54397,"_28416":54398,"_3083":54399},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3632":1081,"_31224":1073,"_21643":54401,"_5":14891,"_28416":1073,"_3083":54402},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3632":1082,"_31224":1073,"_21643":54404,"_5":14891,"_28416":54379,"_3083":54405},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3632":1083,"_31224":1073,"_21643":54407,"_5":14891,"_28416":54379,"_3083":54408},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3632":1084,"_31224":1073,"_21643":54410,"_5":14891,"_28416":54379,"_3083":54411},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3632":1085,"_31224":1073,"_21643":54413,"_5":14891,"_28416":54382,"_3083":54414},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3632":1086,"_31224":1073,"_21643":54416,"_5":14891,"_28416":54382,"_3083":54417},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3632":1087,"_31224":1073,"_21643":54419,"_5":14891,"_28416":54386,"_3083":54420},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3632":1088,"_31224":1073,"_21643":54422,"_5":14891,"_28416":54386,"_3083":54423},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3632":1089,"_31224":1073,"_21643":54425,"_5":14891,"_28416":54390,"_3083":54426},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3632":1090,"_31224":1073,"_21643":54428,"_5":14891,"_28416":54390,"_3083":54429},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3632":1091,"_31224":1073,"_21643":54431,"_5":14891,"_28416":54394,"_3083":54432},[],"For a root that issues directly:",{"_3632":1092,"_31224":1073,"_21643":54434,"_5":14891,"_28416":54394,"_3083":54435},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3632":1093,"_31224":1073,"_21643":54437,"_5":14891,"_28416":54394,"_3083":54438},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3632":1094,"_31224":1073,"_21643":54440,"_5":14891,"_28416":54398,"_3083":54441},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3632":1095,"_31224":1095,"_5":15251,"_3083":54443,"_31583":54444,"_21643":54445,"_28416":1095},"EST reference",[51036,52548,53720,53718,53904],[],{"_3632":1096,"_31224":1095,"_21643":54447,"_5":14891,"_28416":1095,"_3083":54448},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3632":1097,"_31224":1095,"_5":31580,"_21643":54450,"_28416":54451,"_3083":54452},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3632":1098,"_31224":1095,"_5":31580,"_21643":54454,"_28416":54455,"_3083":23446},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3632":1099,"_31224":1095,"_5":31580,"_21643":54457,"_28416":54458,"_3083":26961},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3632":1100,"_31224":1095,"_5":31580,"_21643":54460,"_28416":54461,"_3083":26968},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3632":1101,"_31224":1095,"_5":31580,"_21643":54463,"_28416":54464,"_3083":26230},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3632":1102,"_31224":1095,"_5":31580,"_21643":54466,"_28416":54467,"_3083":54468},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3632":1103,"_31224":1095,"_5":31580,"_21643":54470,"_28416":54471,"_3083":54472},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3632":1104,"_31224":1095,"_5":31580,"_21643":54474,"_28416":54475,"_3083":54476},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3632":1105,"_31224":1095,"_21643":54478,"_5":14891,"_28416":1095,"_3083":54479},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3632":1106,"_31224":1095,"_21643":54481,"_5":14891,"_28416":54451,"_3083":54482},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3632":1107,"_31224":1095,"_21643":54484,"_5":14891,"_28416":54451,"_3083":54485},[],"Operation",{"_3632":1108,"_31224":1095,"_21643":54487,"_5":14891,"_28416":54451,"_3083":54488},[],"Method",{"_3632":1109,"_31224":1095,"_21643":54490,"_5":14891,"_28416":54451,"_3083":54491},[],"Authentication and condition",{"_3632":1110,"_31224":1095,"_21643":54493,"_5":14891,"_28416":54451,"_3083":54494},[],"`/cacerts`",{"_3632":1111,"_31224":1095,"_21643":54496,"_5":14891,"_28416":54451,"_3083":54497},[],"GET",{"_3632":1112,"_31224":1095,"_21643":54499,"_5":14891,"_28416":54451,"_3083":54500},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3632":1113,"_31224":1095,"_21643":54502,"_5":14891,"_28416":54451,"_3083":54503},[],"`/simpleenroll`",{"_3632":1114,"_31224":1095,"_21643":54505,"_5":14891,"_28416":54451,"_3083":54506},[],"POST",{"_3632":1115,"_31224":1095,"_21643":54508,"_5":14891,"_28416":54451,"_3083":54509},[],"Initial authentication and DMS registration/replacement policy.",{"_3632":1116,"_31224":1095,"_21643":54511,"_5":14891,"_28416":54451,"_3083":54512},[],"`/simplereenroll`",{"_3632":1117,"_31224":1095,"_21643":54514,"_5":14891,"_28416":54451,"_3083":54506},[],{"_3632":1118,"_31224":1095,"_21643":54516,"_5":14891,"_28416":54451,"_3083":54517},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3632":1119,"_31224":1095,"_21643":54519,"_5":14891,"_28416":54451,"_3083":54520},[],"`/serverkeygen`",{"_3632":1120,"_31224":1095,"_21643":54522,"_5":14891,"_28416":54451,"_3083":54506},[],{"_3632":1121,"_31224":1095,"_21643":54524,"_5":14891,"_28416":54451,"_3083":54525},[],"Initial authentication and admission; server generation enabled.",{"_3632":1122,"_31224":1095,"_21643":54527,"_5":14891,"_28416":54451,"_3083":54528},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3632":1123,"_31224":1095,"_21643":54530,"_5":14891,"_28416":54455,"_3083":54531},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3632":1124,"_31224":1095,"_21643":54533,"_5":14891,"_28416":54455,"_3083":54534},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3632":1125,"_31224":1095,"_21643":54536,"_5":14891,"_28416":54458,"_3083":54537},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3632":1126,"_31224":1095,"_21643":54539,"_5":14891,"_28416":54458,"_3083":54540},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3632":1127,"_31224":1095,"_21643":54542,"_5":14891,"_28416":54461,"_3083":54543},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3632":1128,"_31224":1095,"_21643":54545,"_5":14891,"_28416":54461,"_3083":54546},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3632":1129,"_31224":1095,"_21643":54548,"_5":14891,"_28416":54464,"_3083":54549},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3632":1130,"_31224":1095,"_21643":54551,"_5":14891,"_28416":54464,"_3083":54552},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3632":1131,"_31224":1095,"_21643":54554,"_5":14891,"_28416":54467,"_3083":54555},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3632":1132,"_31224":1095,"_21643":54557,"_5":14891,"_28416":54467,"_3083":54558},[],"Part",{"_3632":1133,"_31224":1095,"_21643":54560,"_5":14891,"_28416":54467,"_3083":54561},[],"Content after decoding its Base64",{"_3632":1134,"_31224":1095,"_21643":54563,"_5":14891,"_28416":54467,"_3083":54564},[],"`application/pkcs8`",{"_3632":1135,"_31224":1095,"_21643":54566,"_5":14891,"_28416":54467,"_3083":54567},[],"Unencrypted DER PKCS#8 private key.",{"_3632":1136,"_31224":1095,"_21643":54569,"_5":14891,"_28416":54467,"_3083":54570},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3632":1137,"_31224":1095,"_21643":54572,"_5":14891,"_28416":54467,"_3083":54573},[],"DER PKCS#7 containing the issued certificate.",{"_3632":1138,"_31224":1095,"_21643":54575,"_5":14891,"_28416":54467,"_3083":54576},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3632":1139,"_31224":1095,"_21643":54578,"_5":14891,"_28416":54471,"_3083":54579},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3632":1140,"_31224":1095,"_21643":54581,"_5":14891,"_28416":54471,"_3083":54582},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3632":1141,"_31224":1095,"_21643":54584,"_5":14891,"_28416":54471,"_3083":54585},[],"Convert and check the result:",{"_3632":1142,"_31224":1095,"_21643":54587,"_5":14891,"_28416":54471,"_3083":54588},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3632":1143,"_31224":1095,"_21643":54590,"_5":14891,"_28416":54475,"_3083":54591},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3632":1144,"_31224":1095,"_21643":54593,"_5":14891,"_28416":54475,"_3083":54594},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3632":1145,"_31224":1145,"_5":15251,"_3083":53904,"_31583":54596,"_21643":54597,"_28416":1145},[51036,52548,53720,53718,53904],[],{"_3632":1146,"_31224":1145,"_21643":54599,"_5":14891,"_28416":1145,"_3083":54600},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3632":1147,"_31224":1145,"_5":31580,"_21643":54602,"_28416":54603,"_3083":54604},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3632":1148,"_31224":1145,"_5":31580,"_21643":54606,"_28416":54607,"_3083":54608},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3632":1149,"_31224":1145,"_5":31580,"_21643":54610,"_28416":54611,"_3083":54612},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3632":1150,"_31224":1145,"_21643":54614,"_5":14891,"_28416":1145,"_3083":54615},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3632":1151,"_31224":1145,"_21643":54617,"_5":14891,"_28416":54603,"_3083":54618},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3632":1152,"_31224":1145,"_21643":54620,"_5":14891,"_28416":54603,"_3083":54621},[],"The integrator installs initial EST server trust and an admission credential.",{"_3632":1153,"_31224":1145,"_21643":54623,"_5":14891,"_28416":54603,"_3083":54624},[],"The client requests an identity for its `Device ID` through EST.",{"_3632":1154,"_31224":1145,"_21643":54626,"_5":14891,"_28416":54603,"_3083":54627},[],"Certificate, device binding and key/certificate installation are checked.",{"_3632":1155,"_31224":1145,"_21643":54629,"_5":14891,"_28416":54603,"_3083":54630},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3632":1156,"_31224":1145,"_21643":54632,"_5":14891,"_28416":54603,"_3083":54633},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3632":1157,"_31224":1145,"_21643":54635,"_5":14891,"_28416":54607,"_3083":54636},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3632":1158,"_31224":1145,"_21643":54638,"_5":14891,"_28416":54607,"_3083":54639},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":1159,"_31224":1145,"_21643":54641,"_5":14891,"_28416":54607,"_3083":54642},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3632":1160,"_31224":1145,"_21643":54644,"_5":14891,"_28416":54607,"_3083":54645},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3632":1161,"_31224":1145,"_21643":54647,"_5":14891,"_28416":54611,"_3083":54648},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":1162,"_31224":1145,"_21643":54650,"_5":14891,"_28416":54611,"_3083":54651},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":1163,"_31224":1145,"_21643":54653,"_5":14891,"_28416":54611,"_3083":54654},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3632":1164,"_31224":1145,"_21643":54656,"_5":14891,"_28416":54611,"_3083":54657},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3632":1165,"_31224":1145,"_21643":54659,"_5":14891,"_28416":54611,"_3083":54660},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3632":1166,"_31224":1166,"_5":15251,"_3083":54662,"_31583":54663,"_21643":54664,"_28416":1166},"Provisioning strategies",[51036,52548,53720,53718,53904],[],{"_3632":1167,"_31224":1166,"_21643":54666,"_5":14891,"_28416":1166,"_3083":54667},[],"Choose device registration, identity authorization and key generation.",{"_3632":1168,"_31224":1166,"_5":31580,"_21643":54669,"_28416":54670,"_3083":54671},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3632":1169,"_31224":1166,"_5":31580,"_21643":54673,"_28416":54674,"_3083":54675},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3632":1170,"_31224":1166,"_5":31580,"_21643":54677,"_28416":54678,"_3083":54679},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3632":1171,"_31224":1166,"_5":31580,"_21643":54681,"_28416":54682,"_3083":54683},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3632":1172,"_31224":1166,"_5":31580,"_21643":54685,"_28416":54686,"_3083":54687},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3632":1173,"_31224":1166,"_21643":54689,"_5":14891,"_28416":1166,"_3083":54690},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3632":1174,"_31224":1166,"_21643":54692,"_5":14891,"_28416":54670,"_3083":54693},[],"Path",{"_3632":1175,"_31224":1166,"_21643":54695,"_5":14891,"_28416":54670,"_3083":54696},[],"When the device exists",{"_3632":1176,"_31224":1166,"_21643":54698,"_5":14891,"_28416":54670,"_3083":54699},[],"What to check",{"_3632":1177,"_31224":1166,"_21643":54701,"_5":14891,"_28416":54670,"_3083":54702},[],"Manual assignment",{"_3632":1178,"_31224":1166,"_21643":54704,"_5":14891,"_28416":54670,"_3083":54705},[],"An operator creates it before associating a certificate.",{"_3632":1179,"_31224":1166,"_21643":54707,"_5":14891,"_28416":54670,"_3083":54708},[],"ID, owning DMS, certificate CN and bound serial.",{"_3632":1180,"_31224":1166,"_21643":54710,"_5":14891,"_28416":54670,"_3083":54711},[],"EST with `JITP`",{"_3632":1181,"_31224":1166,"_21643":54713,"_5":14891,"_28416":54670,"_3083":54714},[],"Created for an unknown CN during `/simpleenroll`.",{"_3632":1182,"_31224":1166,"_21643":54716,"_5":14891,"_28416":54670,"_3083":54717},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3632":1183,"_31224":1166,"_21643":54719,"_5":14891,"_28416":54670,"_3083":54720},[],"EST with `PRE_REGISTRATION`",{"_3632":1184,"_31224":1166,"_21643":54722,"_5":14891,"_28416":54670,"_3083":54723},[],"Must exist before `/simpleenroll`.",{"_3632":1185,"_31224":1166,"_21643":54725,"_5":14891,"_28416":54670,"_3083":54726},[],"Approved record, same DMS and replacement conditions for your version.",{"_3632":1186,"_31224":1166,"_21643":54728,"_5":14891,"_28416":54670,"_3083":54729},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3632":1187,"_31224":1166,"_21643":54731,"_5":14891,"_28416":54670,"_3083":54732},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3632":1188,"_31224":1166,"_21643":54734,"_5":14891,"_28416":54674,"_3083":54735},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3632":1189,"_31224":1166,"_21643":54737,"_5":14891,"_28416":54674,"_3083":54738},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3632":1190,"_31224":1166,"_21643":54740,"_5":14891,"_28416":54674,"_3083":54741},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3632":1191,"_31224":1166,"_21643":54743,"_5":14891,"_28416":54678,"_3083":54744},[],"Decide initial enrollment and re-enrollment separately:",{"_3632":1192,"_31224":1166,"_21643":54746,"_5":14891,"_28416":54678,"_3083":54747},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3632":1193,"_31224":1166,"_21643":54749,"_5":14891,"_28416":54678,"_3083":54750},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3632":1194,"_31224":1166,"_21643":54752,"_5":14891,"_28416":54678,"_3083":54753},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3632":1195,"_31224":1166,"_21643":54755,"_5":14891,"_28416":54678,"_3083":54756},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3632":1196,"_31224":1166,"_21643":54758,"_5":14891,"_28416":54678,"_3083":54759},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3632":1197,"_31224":1166,"_21643":54761,"_5":14891,"_28416":54682,"_3083":51420},[],{"_3632":1198,"_31224":1166,"_21643":54763,"_5":14891,"_28416":54682,"_3083":54764},[],"Material crossing EST",{"_3632":1199,"_31224":1166,"_21643":54766,"_5":14891,"_28416":54682,"_3083":54767},[],"Device-generated key",{"_3632":1200,"_31224":1166,"_21643":54769,"_5":14891,"_28416":54682,"_3083":54770},[],"Public CSR and certificate; the key stays on the client.",{"_3632":1201,"_31224":1166,"_21643":54772,"_5":14891,"_28416":54682,"_3083":54773},[],"Existing device key",{"_3632":1202,"_31224":1166,"_21643":54775,"_5":14891,"_28416":54682,"_3083":54776},[],"CSR signed with that key and a new certificate.",{"_3632":1203,"_31224":1166,"_21643":54778,"_5":14891,"_28416":54682,"_3083":54048},[],{"_3632":1204,"_31224":1166,"_21643":54780,"_5":14891,"_28416":54682,"_3083":54781},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3632":1205,"_31224":1166,"_21643":54783,"_5":14891,"_28416":54682,"_3083":54784},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3632":1206,"_31224":1166,"_21643":54786,"_5":14891,"_28416":54686,"_3083":54787},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3632":1207,"_31224":1207,"_5":15251,"_3083":54789,"_31583":54790,"_21643":54791,"_28416":1207},"Renewal and recovery",[51036,52548,53720,53718,53904],[],{"_3632":1208,"_31224":1207,"_21643":54793,"_5":14891,"_28416":1207,"_3083":54794},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3632":1209,"_31224":1207,"_5":31580,"_21643":54796,"_28416":54797,"_3083":54798},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3632":1210,"_31224":1207,"_5":31580,"_21643":54800,"_28416":54801,"_3083":54802},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3632":1211,"_31224":1207,"_5":31580,"_21643":54804,"_28416":54805,"_3083":54806},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3632":1212,"_31224":1207,"_5":31580,"_21643":54808,"_28416":54809,"_3083":54810},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3632":1213,"_31224":1207,"_5":31580,"_21643":54812,"_28416":54813,"_3083":54814},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3632":1214,"_31224":1207,"_21643":54816,"_5":14891,"_28416":1207,"_3083":54817},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3632":1215,"_31224":1207,"_21643":54819,"_5":14891,"_28416":54797,"_3083":54820},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3632":1216,"_31224":1207,"_21643":54822,"_5":14891,"_28416":54797,"_3083":54823},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3632":1217,"_31224":1207,"_21643":54825,"_5":14891,"_28416":54797,"_3083":54826},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3632":1218,"_31224":1207,"_21643":54828,"_5":14891,"_28416":54797,"_3083":54829},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3632":1219,"_31224":1207,"_21643":54831,"_5":14891,"_28416":54801,"_3083":54832},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3632":1220,"_31224":1207,"_21643":54834,"_5":14891,"_28416":54801,"_3083":54835},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3632":1221,"_31224":1207,"_21643":54837,"_5":14891,"_28416":54805,"_3083":54838},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3632":1222,"_31224":1207,"_21643":54840,"_5":14891,"_28416":54805,"_3083":54841},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3632":1223,"_31224":1207,"_21643":54843,"_5":14891,"_28416":54805,"_3083":54844},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3632":1224,"_31224":1207,"_21643":54846,"_5":14891,"_28416":54809,"_3083":54847},[],"Situation",{"_3632":1225,"_31224":1207,"_21643":54849,"_5":14891,"_28416":54809,"_3083":54850},[],"Procedure",{"_3632":1226,"_31224":1207,"_21643":54852,"_5":14891,"_28416":54809,"_3083":54853},[],"Valid certificate, outside the window",{"_3632":1227,"_31224":1207,"_21643":54855,"_5":14891,"_28416":54809,"_3083":54856},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3632":1228,"_31224":1207,"_21643":54858,"_5":14891,"_28416":54809,"_3083":54859},[],"Expired certificate, key available",{"_3632":1229,"_31224":1207,"_21643":54861,"_5":14891,"_28416":54809,"_3083":54862},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3632":1230,"_31224":1207,"_21643":54864,"_5":14891,"_28416":54809,"_3083":54865},[],"Renewal through webhook or `NO_AUTH`",{"_3632":1231,"_31224":1207,"_21643":54867,"_5":14891,"_28416":54809,"_3083":54868},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3632":1232,"_31224":1207,"_21643":54870,"_5":14891,"_28416":54809,"_3083":54871},[],"Lost or inaccessible key",{"_3632":1233,"_31224":1207,"_21643":54873,"_5":14891,"_28416":54809,"_3083":54874},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3632":1234,"_31224":1207,"_21643":54876,"_5":14891,"_28416":54809,"_3083":54877},[],"Current identity revoked",{"_3632":1235,"_31224":1207,"_21643":54879,"_5":14891,"_28416":54809,"_3083":54880},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3632":1236,"_31224":1207,"_21643":54882,"_5":14891,"_28416":54809,"_3083":54883},[],"Device without an identity",{"_3632":1237,"_31224":1207,"_21643":54885,"_5":14891,"_28416":54809,"_3083":54886},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3632":1238,"_31224":1207,"_21643":54888,"_5":14891,"_28416":54809,"_3083":54889},[],"Retired device",{"_3632":1239,"_31224":1207,"_21643":54891,"_5":14891,"_28416":54809,"_3083":54892},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3632":1240,"_31224":1207,"_21643":54894,"_5":14891,"_28416":54809,"_3083":54895},[],"Timeout, HTTP 500 or installation failure",{"_3632":1241,"_31224":1207,"_21643":54897,"_5":14891,"_28416":54809,"_3083":54898},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3632":1242,"_31224":1207,"_21643":54900,"_5":14891,"_28416":54813,"_3083":54901},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3632":1243,"_31224":1207,"_21643":54903,"_5":14891,"_28416":54813,"_3083":54904},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3632":1244,"_31224":1244,"_5":15251,"_3083":54906,"_31583":54907,"_21643":54908,"_28416":1244},"Enrollment troubleshooting",[51036,52548,53720,53718,53904],[],{"_3632":1245,"_31224":1244,"_21643":54910,"_5":14891,"_28416":1244,"_3083":54911},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3632":1246,"_31224":1244,"_5":31580,"_21643":54913,"_28416":54914,"_3083":54915},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3632":1247,"_31224":1244,"_5":31580,"_21643":54917,"_28416":54918,"_3083":54919},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3632":1248,"_31224":1244,"_5":31580,"_21643":54921,"_28416":54922,"_3083":54476},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3632":1249,"_31224":1244,"_5":31580,"_21643":54924,"_28416":54925,"_3083":54926},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3632":1250,"_31224":1244,"_21643":54928,"_5":14891,"_28416":1244,"_3083":54929},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3632":1251,"_31224":1244,"_21643":54931,"_5":14891,"_28416":54918,"_3083":54932},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3632":1252,"_31224":1244,"_21643":54934,"_5":14891,"_28416":54918,"_3083":54935},[],"Symptom or message",{"_3632":1253,"_31224":1244,"_21643":54937,"_5":14891,"_28416":54918,"_3083":54699},[],{"_3632":1254,"_31224":1244,"_21643":54939,"_5":14891,"_28416":54918,"_3083":54940},[],"curl rejects TLS, name or issuer",{"_3632":1255,"_31224":1244,"_21643":54942,"_5":14891,"_28416":54918,"_3083":54943},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3632":1256,"_31224":1244,"_21643":54945,"_5":14891,"_28416":54918,"_3083":54946},[],"404 or missing APS",{"_3632":1257,"_31224":1244,"_21643":54948,"_5":14891,"_28416":54918,"_3083":54949},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3632":1258,"_31224":1244,"_21643":54951,"_5":14891,"_28416":54918,"_3083":54952},[],"400, CSR or format error",{"_3632":1259,"_31224":1244,"_21643":54954,"_5":14891,"_28416":54918,"_3083":54955},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3632":1260,"_31224":1244,"_21643":54957,"_5":14891,"_28416":54918,"_3083":54958},[],"Missing credential or invalid certificate",{"_3632":1261,"_31224":1244,"_21643":54960,"_5":14891,"_28416":54918,"_3083":54961},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3632":1262,"_31224":1244,"_21643":54963,"_5":14891,"_28416":54918,"_3083":54964},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3632":1263,"_31224":1244,"_21643":54966,"_5":14891,"_28416":54918,"_3083":54967},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3632":1264,"_31224":1244,"_21643":54969,"_5":14891,"_28416":54918,"_3083":54970},[],"Webhook denies, times out or responds without authorization",{"_3632":1265,"_31224":1244,"_21643":54972,"_5":14891,"_28416":54918,"_3083":54973},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3632":1266,"_31224":1244,"_21643":54975,"_5":14891,"_28416":54918,"_3083":54976},[],"`unexpected status code: <n>: redirects are not followed`",{"_3632":1267,"_31224":1244,"_21643":54978,"_5":14891,"_28416":54918,"_3083":54979},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3632":1268,"_31224":1244,"_21643":54981,"_5":14891,"_28416":54918,"_3083":54982},[],"`webhook response exceeds 1048576 bytes`",{"_3632":1269,"_31224":1244,"_21643":54984,"_5":14891,"_28416":54918,"_3083":54985},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3632":1270,"_31224":1244,"_21643":54987,"_5":14891,"_28416":54918,"_3083":54988},[],"`webhook config must not reference files`",{"_3632":1271,"_31224":1244,"_21643":54990,"_5":14891,"_28416":54918,"_3083":54991},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3632":1272,"_31224":1244,"_21643":54993,"_5":14891,"_28416":54918,"_3083":54994},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3632":1273,"_31224":1244,"_21643":54996,"_5":14891,"_28416":54918,"_3083":54997},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3632":1274,"_31224":1244,"_21643":54999,"_5":14891,"_28416":54918,"_3083":55000},[],"`webhook mTLS certificate and key are invalid: …`",{"_3632":1275,"_31224":1244,"_21643":55002,"_5":14891,"_28416":54918,"_3083":55003},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3632":1276,"_31224":1244,"_21643":55005,"_5":14891,"_28416":54918,"_3083":55006},[],"400 `struct validation error` creating or updating a DMS",{"_3632":1277,"_31224":1244,"_21643":55008,"_5":14891,"_28416":54918,"_3083":55009},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3632":1278,"_31224":1244,"_21643":55011,"_5":14891,"_28416":54918,"_3083":55012},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3632":1279,"_31224":1244,"_21643":55014,"_5":14891,"_28416":54918,"_3083":55015},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3632":1280,"_31224":1244,"_21643":55017,"_5":14891,"_28416":54918,"_3083":55018},[],"`device not preregistered`",{"_3632":1281,"_31224":1244,"_21643":55020,"_5":14891,"_28416":54918,"_3083":55021},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3632":1282,"_31224":1244,"_21643":55023,"_5":14891,"_28416":54918,"_3083":55024},[],"`forbiddenNewEnrollment`",{"_3632":1283,"_31224":1244,"_21643":55026,"_5":14891,"_28416":54918,"_3083":55027},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3632":1284,"_31224":1244,"_21643":55029,"_5":14891,"_28416":54918,"_3083":55030},[],"Different owning DMS",{"_3632":1285,"_31224":1244,"_21643":55032,"_5":14891,"_28416":54918,"_3083":55033},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3632":1286,"_31224":1244,"_21643":55035,"_5":14891,"_28416":54918,"_3083":55036},[],"`invalid RawSubject bytes`",{"_3632":1287,"_31224":1244,"_21643":55038,"_5":14891,"_28416":54918,"_3083":55039},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3632":1288,"_31224":1244,"_21643":55041,"_5":14891,"_28416":54918,"_3083":55042},[],"`invalid reenroll window`",{"_3632":1289,"_31224":1244,"_21643":55044,"_5":14891,"_28416":54918,"_3083":55045},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3632":1290,"_31224":1244,"_21643":55047,"_5":14891,"_28416":54918,"_3083":55048},[],"Current certificate revoked",{"_3632":1291,"_31224":1244,"_21643":55050,"_5":14891,"_28416":54918,"_3083":55051},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3632":1292,"_31224":1244,"_21643":55053,"_5":14891,"_28416":54918,"_3083":55054},[],"CA, profile or signing error",{"_3632":1293,"_31224":1244,"_21643":55056,"_5":14891,"_28416":54918,"_3083":55057},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3632":1294,"_31224":1244,"_21643":55059,"_5":14891,"_28416":54918,"_3083":55060},[],"HTTP 200 without a device connection",{"_3632":1295,"_31224":1244,"_21643":55062,"_5":14891,"_28416":54918,"_3083":55063},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3632":1296,"_31224":1244,"_21643":55065,"_5":14891,"_28416":54918,"_3083":55066},[],"Timeout or error after issuance",{"_3632":1297,"_31224":1244,"_21643":55068,"_5":14891,"_28416":54918,"_3083":55069},[],"New certificates, current slot and previous identity's state before retrying.",{"_3632":1298,"_31224":1244,"_21643":55071,"_5":14891,"_28416":54922,"_3083":55072},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3632":1299,"_31224":1244,"_21643":55074,"_5":14891,"_28416":54922,"_3083":55075},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3632":1300,"_31224":1244,"_21643":55077,"_5":14891,"_28416":54925,"_3083":55078},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3632":1301,"_31224":1244,"_21643":55080,"_5":14891,"_28416":54925,"_3083":55081},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3632":1302,"_31224":1244,"_21643":55083,"_5":14891,"_28416":54925,"_3083":55084},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3632":1303,"_31224":1244,"_21643":55086,"_5":14891,"_28416":54925,"_3083":55087},[],"Make one request, save headers/body and query the device and certificates.",{"_3632":1304,"_31224":1244,"_21643":55089,"_5":14891,"_28416":54925,"_3083":55090},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3632":1305,"_31224":1244,"_21643":55092,"_5":14891,"_28416":54925,"_3083":55093},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3632":1306,"_31224":1244,"_21643":55095,"_5":14891,"_28416":54925,"_3083":55096},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3632":1307,"_31224":1307,"_5":15251,"_3083":55098,"_31583":55099,"_21643":55100,"_28416":1307},"Trust distribution and updates",[51036,52548,53720,53718,53904],[],{"_3632":1308,"_31224":1307,"_21643":55102,"_5":14891,"_28416":1307,"_3083":55103},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3632":1309,"_31224":1307,"_5":31580,"_21643":55105,"_28416":55106,"_3083":55107},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3632":1310,"_31224":1307,"_5":31580,"_21643":55109,"_28416":55110,"_3083":55111},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3632":1311,"_31224":1307,"_5":31580,"_21643":55113,"_28416":55114,"_3083":55115},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3632":1312,"_31224":1307,"_5":31580,"_21643":55117,"_28416":55118,"_3083":55119},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3632":1313,"_31224":1307,"_5":31580,"_21643":55121,"_28416":55122,"_3083":55123},[],"/docs/pr-preview/pr-82/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3632":1314,"_31224":1307,"_21643":55125,"_5":14891,"_28416":1307,"_3083":55126},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3632":1315,"_31224":1307,"_21643":55128,"_5":14891,"_28416":55106,"_3083":55129},[],"Relationship",{"_3632":1316,"_31224":1307,"_21643":55131,"_5":14891,"_28416":55106,"_3083":55132},[],"Material prepared by its owner",{"_3632":1317,"_31224":1307,"_21643":55134,"_5":14891,"_28416":55106,"_3083":55135},[],"Device → EST server",{"_3632":1318,"_31224":1307,"_21643":55137,"_5":14891,"_28416":55106,"_3083":55138},[],"Previously verified server root, chain or pin and TLS name.",{"_3632":1319,"_31224":1307,"_21643":55140,"_5":14891,"_28416":55106,"_3083":55141},[],"DMS → requester",{"_3632":1320,"_31224":1307,"_21643":55143,"_5":14891,"_28416":55106,"_3083":55144},[],"CAs and rules authorizing initial or renewal credentials.",{"_3632":1321,"_31224":1307,"_21643":55146,"_5":14891,"_28416":55106,"_3083":55147},[],"Consumer → device",{"_3632":1322,"_31224":1307,"_21643":55149,"_5":14891,"_28416":55106,"_3083":55150},[],"Operational identity roots, intermediates, validation and permissions.",{"_3632":1323,"_31224":1307,"_21643":55152,"_5":14891,"_28416":55106,"_3083":55153},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3632":1324,"_31224":1307,"_21643":55155,"_5":14891,"_28416":55110,"_3083":55156},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3632":1325,"_31224":1307,"_21643":55158,"_5":14891,"_28416":55110,"_3083":55159},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3632":1326,"_31224":1307,"_21643":55161,"_5":14891,"_28416":55114,"_3083":55162},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3632":1327,"_31224":1307,"_21643":55164,"_5":14891,"_28416":55114,"_3083":55165},[],"Select policy-approved roots as anchors.",{"_3632":1328,"_31224":1307,"_21643":55167,"_5":14891,"_28416":55114,"_3083":55168},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3632":1329,"_31224":1307,"_21643":55170,"_5":14891,"_28416":55114,"_3083":55171},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3632":1330,"_31224":1307,"_21643":55173,"_5":14891,"_28416":55114,"_3083":55174},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3632":1331,"_31224":1307,"_21643":55176,"_5":14891,"_28416":55114,"_3083":55177},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3632":1332,"_31224":1307,"_21643":55179,"_5":14891,"_28416":55118,"_3083":55180},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3632":1333,"_31224":1307,"_21643":55182,"_5":14891,"_28416":55118,"_3083":55183},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3632":1334,"_31224":1307,"_21643":55185,"_5":14891,"_28416":55118,"_3083":55186},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3632":1335,"_31224":1307,"_21643":55188,"_5":14891,"_28416":55122,"_3083":55189},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3632":1336,"_31224":1336,"_5":15251,"_3083":55191,"_31583":55192,"_21643":55194,"_28416":1336},"AWS IoT Core",[51036,52548,53720,53718,55193],"Integrations",[],{"_3632":1337,"_31224":1336,"_21643":55196,"_5":14891,"_28416":1336,"_3083":55197},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3632":1338,"_31224":1336,"_5":31580,"_21643":55199,"_28416":55200,"_3083":55201},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3632":1339,"_31224":1336,"_5":31580,"_21643":55203,"_28416":55204,"_3083":55205},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3632":1340,"_31224":1336,"_5":31580,"_21643":55207,"_28416":55208,"_3083":55209},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3632":1341,"_31224":1336,"_5":31580,"_21643":55211,"_28416":55212,"_3083":55213},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3632":1342,"_31224":1336,"_5":31580,"_21643":55215,"_28416":55216,"_3083":55217},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3632":1343,"_31224":1336,"_5":31580,"_21643":55219,"_28416":55220,"_3083":55221},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3632":1344,"_31224":1336,"_5":31580,"_21643":55223,"_28416":55224,"_3083":55225},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3632":1345,"_31224":1336,"_5":31580,"_21643":55227,"_28416":55228,"_3083":55229},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3632":1346,"_31224":1336,"_5":31580,"_21643":55231,"_28416":55232,"_3083":55233},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3632":1347,"_31224":1336,"_5":31580,"_21643":55235,"_28416":55236,"_3083":55237},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3632":1348,"_31224":1336,"_5":31580,"_21643":55239,"_28416":55240,"_3083":55241},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3632":1349,"_31224":1336,"_5":31580,"_21643":55243,"_28416":55244,"_3083":55245},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3632":1350,"_31224":1336,"_5":31580,"_21643":55247,"_28416":55248,"_3083":55249},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3632":1351,"_31224":1336,"_5":31580,"_21643":55251,"_28416":55252,"_3083":55253},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3632":1352,"_31224":1336,"_5":31580,"_21643":55255,"_28416":55256,"_3083":55257},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3632":1353,"_31224":1336,"_5":31580,"_21643":55259,"_28416":55260,"_3083":55261},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3632":1354,"_31224":1336,"_5":31580,"_21643":55263,"_28416":55264,"_3083":55265},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3632":1355,"_31224":1336,"_5":31580,"_21643":55267,"_28416":55268,"_3083":55269},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3632":1356,"_31224":1336,"_5":31580,"_21643":55271,"_28416":55272,"_3083":55273},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3632":1357,"_31224":1336,"_5":31580,"_21643":55275,"_28416":55276,"_3083":55277},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3632":1358,"_31224":1336,"_5":31580,"_21643":55279,"_28416":55280,"_3083":55281},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3632":1359,"_31224":1336,"_5":31580,"_21643":55283,"_28416":55284,"_3083":55285},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3632":1360,"_31224":1336,"_5":31580,"_21643":55287,"_28416":55288,"_3083":55289},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3632":1361,"_31224":1336,"_5":31580,"_21643":55291,"_28416":55292,"_3083":55293},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3632":1362,"_31224":1336,"_5":31580,"_21643":55295,"_28416":55296,"_3083":55297},[],"/docs/pr-preview/pr-82/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3632":1363,"_31224":1336,"_21643":55299,"_5":14891,"_28416":1336,"_3083":55300},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3632":1364,"_31224":1336,"_21643":55302,"_5":14891,"_28416":1336,"_3083":55303},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3632":1365,"_31224":1336,"_21643":55305,"_5":14891,"_28416":1336,"_3083":55306},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3632":1366,"_31224":1336,"_21643":55308,"_5":14891,"_28416":55200,"_3083":55309},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3632":1367,"_31224":1336,"_21643":55311,"_5":14891,"_28416":55200,"_3083":55312},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3632":1368,"_31224":1336,"_21643":55314,"_5":14891,"_28416":55200,"_3083":55315},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3632":1369,"_31224":1336,"_21643":55317,"_5":14891,"_28416":55200,"_3083":55318},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3632":1370,"_31224":1336,"_21643":55320,"_5":14891,"_28416":55204,"_3083":55321},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3632":1371,"_31224":1336,"_21643":55323,"_5":14891,"_28416":55208,"_3083":55324},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3632":1372,"_31224":1336,"_21643":55326,"_5":14891,"_28416":55208,"_3083":55327},[],"IAM action",{"_3632":1373,"_31224":1336,"_21643":55329,"_5":14891,"_28416":55208,"_3083":51426},[],{"_3632":1374,"_31224":1336,"_21643":55331,"_5":14891,"_28416":55208,"_3083":55332},[],"`iot:GetRegistrationCode`",{"_3632":1375,"_31224":1336,"_21643":55334,"_5":14891,"_28416":55208,"_3083":55335},[],"Obtain the verification code for CA registration in the Primary Account",{"_3632":1376,"_31224":1336,"_21643":55337,"_5":14891,"_28416":55208,"_3083":55338},[],"`iot:RegisterCACertificate`",{"_3632":1377,"_31224":1336,"_21643":55340,"_5":14891,"_28416":55208,"_3083":55341},[],"Register the CA in AWS IoT",{"_3632":1378,"_31224":1336,"_21643":55343,"_5":14891,"_28416":55208,"_3083":55344},[],"`iot:DescribeCACertificate`",{"_3632":1379,"_31224":1336,"_21643":55346,"_5":14891,"_28416":55208,"_3083":55347},[],"Check the CA registration status",{"_3632":1380,"_31224":1336,"_21643":55349,"_5":14891,"_28416":55208,"_3083":55350},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3632":1381,"_31224":1336,"_21643":55352,"_5":14891,"_28416":55208,"_3083":55353},[],"Create or update Things in IoT Core",{"_3632":1382,"_31224":1336,"_21643":55355,"_5":14891,"_28416":55208,"_3083":55356},[],"`iot:RegisterThing`",{"_3632":1383,"_31224":1336,"_21643":55358,"_5":14891,"_28416":55208,"_3083":55359},[],"Provision Things through a template",{"_3632":1384,"_31224":1336,"_21643":55361,"_5":14891,"_28416":55208,"_3083":55362},[],"`iot:RegisterCertificate`",{"_3632":1385,"_31224":1336,"_21643":55364,"_5":14891,"_28416":55208,"_3083":55365},[],"Register device certificates",{"_3632":1386,"_31224":1336,"_21643":55367,"_5":14891,"_28416":55208,"_3083":55368},[],"`iot:UpdateCertificate`",{"_3632":1387,"_31224":1336,"_21643":55370,"_5":14891,"_28416":55208,"_3083":55371},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3632":1388,"_31224":1336,"_21643":55373,"_5":14891,"_28416":55208,"_3083":55374},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3632":1389,"_31224":1336,"_21643":55376,"_5":14891,"_28416":55208,"_3083":55377},[],"Create and attach IoT policies",{"_3632":1390,"_31224":1336,"_21643":55379,"_5":14891,"_28416":55208,"_3083":55380},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3632":1391,"_31224":1336,"_21643":55382,"_5":14891,"_28416":55208,"_3083":55383},[],"Manage Thing groups",{"_3632":1392,"_31224":1336,"_21643":55385,"_5":14891,"_28416":55208,"_3083":55386},[],"`iot:CreateProvisioningTemplate`",{"_3632":1393,"_31224":1336,"_21643":55388,"_5":14891,"_28416":55208,"_3083":55389},[],"Create JITP templates",{"_3632":1394,"_31224":1336,"_21643":55391,"_5":14891,"_28416":55208,"_3083":55392},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3632":1395,"_31224":1336,"_21643":55394,"_5":14891,"_28416":55208,"_3083":55395},[],"Read and write the Device Shadow",{"_3632":1396,"_31224":1336,"_21643":55397,"_5":14891,"_28416":55208,"_3083":55398},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3632":1397,"_31224":1336,"_21643":55400,"_5":14891,"_28416":55212,"_3083":55401},[],"Parameter",{"_3632":1398,"_31224":1336,"_21643":55403,"_5":14891,"_28416":55212,"_3083":55404},[],"Type",{"_3632":1399,"_31224":1336,"_21643":55406,"_5":14891,"_28416":55212,"_3083":55407},[],"Required",{"_3632":1400,"_31224":1336,"_21643":55409,"_5":14891,"_28416":55212,"_3083":55410},[],"Description",{"_3632":1401,"_31224":1336,"_21643":55412,"_5":14891,"_28416":55212,"_3083":55413},[],"`connector_id`",{"_3632":1402,"_31224":1336,"_21643":55415,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1403,"_31224":1336,"_21643":55417,"_5":14891,"_28416":55212,"_3083":55418},[],"Yes",{"_3632":1404,"_31224":1336,"_21643":55420,"_5":14891,"_28416":55212,"_3083":55421},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3632":1405,"_31224":1336,"_21643":55423,"_5":14891,"_28416":55212,"_3083":55424},[],"`aws_config.region`",{"_3632":1406,"_31224":1336,"_21643":55426,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1407,"_31224":1336,"_21643":55428,"_5":14891,"_28416":55212,"_3083":55418},[],{"_3632":1408,"_31224":1336,"_21643":55430,"_5":14891,"_28416":55212,"_3083":55431},[],"AWS region where the connector operates.",{"_3632":1409,"_31224":1336,"_21643":55433,"_5":14891,"_28416":55212,"_3083":55434},[],"`aws_config.auth_method`",{"_3632":1410,"_31224":1336,"_21643":55436,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1411,"_31224":1336,"_21643":55438,"_5":14891,"_28416":55212,"_3083":55418},[],{"_3632":1412,"_31224":1336,"_21643":55440,"_5":14891,"_28416":55212,"_3083":55441},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3632":1413,"_31224":1336,"_21643":55443,"_5":14891,"_28416":55212,"_3083":55444},[],"`aws_config.access_key_id`",{"_3632":1414,"_31224":1336,"_21643":55446,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1415,"_31224":1336,"_21643":55448,"_5":14891,"_28416":55212,"_3083":55449},[],"Only with `auth_method=static`",{"_3632":1416,"_31224":1336,"_21643":55451,"_5":14891,"_28416":55212,"_3083":55452},[],"AWS access key.",{"_3632":1417,"_31224":1336,"_21643":55454,"_5":14891,"_28416":55212,"_3083":55455},[],"`aws_config.secret_access_key`",{"_3632":1418,"_31224":1336,"_21643":55457,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1419,"_31224":1336,"_21643":55459,"_5":14891,"_28416":55212,"_3083":55449},[],{"_3632":1420,"_31224":1336,"_21643":55461,"_5":14891,"_28416":55212,"_3083":55462},[],"AWS secret key.",{"_3632":1421,"_31224":1336,"_21643":55464,"_5":14891,"_28416":55212,"_3083":55465},[],"`aws_config.session_token`",{"_3632":1422,"_31224":1336,"_21643":55467,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1423,"_31224":1336,"_21643":55469,"_5":14891,"_28416":55212,"_3083":55470},[],"No",{"_3632":1424,"_31224":1336,"_21643":55472,"_5":14891,"_28416":55212,"_3083":55473},[],"Session token (with `auth_method=static`).",{"_3632":1425,"_31224":1336,"_21643":55475,"_5":14891,"_28416":55212,"_3083":55476},[],"`aws_config.role_arn`",{"_3632":1426,"_31224":1336,"_21643":55478,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1427,"_31224":1336,"_21643":55480,"_5":14891,"_28416":55212,"_3083":55481},[],"Only with `auth_method=role`",{"_3632":1428,"_31224":1336,"_21643":55483,"_5":14891,"_28416":55212,"_3083":55484},[],"ARN of the role to assume.",{"_3632":1429,"_31224":1336,"_21643":55486,"_5":14891,"_28416":55212,"_3083":55487},[],"`aws_config.endpoint_url`",{"_3632":1430,"_31224":1336,"_21643":55489,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1431,"_31224":1336,"_21643":55491,"_5":14891,"_28416":55212,"_3083":55470},[],{"_3632":1432,"_31224":1336,"_21643":55493,"_5":14891,"_28416":55212,"_3083":55494},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3632":1433,"_31224":1336,"_21643":55496,"_5":14891,"_28416":55212,"_3083":55497},[],"`subscriber_event_bus`",{"_3632":1434,"_31224":1336,"_21643":55499,"_5":14891,"_28416":55212,"_3083":18247},[],{"_3632":1435,"_31224":1336,"_21643":55501,"_5":14891,"_28416":55212,"_3083":55418},[],{"_3632":1436,"_31224":1336,"_21643":55503,"_5":14891,"_28416":55212,"_3083":55504},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3632":1437,"_31224":1336,"_21643":55506,"_5":14891,"_28416":55212,"_3083":55507},[],"`dms_manager_client`",{"_3632":1438,"_31224":1336,"_21643":55509,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1439,"_31224":1336,"_21643":55511,"_5":14891,"_28416":55212,"_3083":55418},[],{"_3632":1440,"_31224":1336,"_21643":55513,"_5":14891,"_28416":55212,"_3083":55514},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3632":1441,"_31224":1336,"_21643":55516,"_5":14891,"_28416":55212,"_3083":55517},[],"`device_manager_client`",{"_3632":1442,"_31224":1336,"_21643":55519,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1443,"_31224":1336,"_21643":55521,"_5":14891,"_28416":55212,"_3083":55418},[],{"_3632":1444,"_31224":1336,"_21643":55523,"_5":14891,"_28416":55212,"_3083":55524},[],"HTTP URL of Lamassu's Device Manager.",{"_3632":1445,"_31224":1336,"_21643":55526,"_5":14891,"_28416":55212,"_3083":55527},[],"`ca_client`",{"_3632":1446,"_31224":1336,"_21643":55529,"_5":14891,"_28416":55212,"_3083":25830},[],{"_3632":1447,"_31224":1336,"_21643":55531,"_5":14891,"_28416":55212,"_3083":55418},[],{"_3632":1448,"_31224":1336,"_21643":55533,"_5":14891,"_28416":55212,"_3083":55534},[],"HTTP URL of Lamassu's CA service.",{"_3632":1449,"_31224":1336,"_21643":55536,"_5":14891,"_28416":55216,"_3083":55537},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3632":1450,"_31224":1336,"_21643":55539,"_5":14891,"_28416":55216,"_3083":55540},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3632":1451,"_31224":1336,"_21643":55542,"_5":14891,"_28416":55216,"_3083":55543},[],"CloudEvent type",{"_3632":1452,"_31224":1336,"_21643":55545,"_5":14891,"_28416":55216,"_3083":55546},[],"Lamassu resource",{"_3632":1453,"_31224":1336,"_21643":55548,"_5":14891,"_28416":55216,"_3083":55549},[],"AWS Resource",{"_3632":1454,"_31224":1336,"_21643":55551,"_5":14891,"_28416":55216,"_3083":55552},[],"IAM actions",{"_3632":1455,"_31224":1336,"_21643":55554,"_5":14891,"_28416":55216,"_3083":55555},[],"AWS calls and effect",{"_3632":1456,"_31224":1336,"_21643":55557,"_5":14891,"_28416":55216,"_3083":55558},[],"Where in this page",{"_3632":1457,"_31224":1336,"_21643":55560,"_5":14891,"_28416":55216,"_3083":55561},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3632":1458,"_31224":1336,"_21643":55563,"_5":14891,"_28416":55216,"_3083":55564},[],"CA",{"_3632":1459,"_31224":1336,"_21643":55566,"_5":14891,"_28416":55216,"_3083":55567},[],"`IoTCore/CACertificate`",{"_3632":1460,"_31224":1336,"_21643":55569,"_5":14891,"_28416":55216,"_3083":55570},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3632":1461,"_31224":1336,"_21643":55572,"_5":14891,"_28416":55216,"_3083":55573},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3632":1462,"_31224":1336,"_21643":55575,"_5":14891,"_28416":55216,"_3083":55229},[],{"_3632":1463,"_31224":1336,"_21643":55577,"_5":14891,"_28416":55216,"_3083":55578},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3632":1464,"_31224":1336,"_21643":55580,"_5":14891,"_28416":55216,"_3083":55581},[],"DMS",{"_3632":1465,"_31224":1336,"_21643":55583,"_5":14891,"_28416":55216,"_3083":55584},[],"`IoTCore/ProvisioningTemplate`",{"_3632":1466,"_31224":1336,"_21643":55586,"_5":14891,"_28416":55216,"_3083":55587},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3632":1467,"_31224":1336,"_21643":55589,"_5":14891,"_28416":55216,"_3083":55590},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3632":1468,"_31224":1336,"_21643":55592,"_5":14891,"_28416":55216,"_3083":55257},[],{"_3632":1469,"_31224":1336,"_21643":55594,"_5":14891,"_28416":55216,"_3083":55595},[],"`EventBindDeviceIdentityKey`",{"_3632":1470,"_31224":1336,"_21643":55597,"_5":14891,"_28416":55216,"_3083":55598},[],"Device",{"_3632":1471,"_31224":1336,"_21643":55600,"_5":14891,"_28416":55216,"_3083":55601},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3632":1472,"_31224":1336,"_21643":55603,"_5":14891,"_28416":55216,"_3083":55604},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3632":1473,"_31224":1336,"_21643":55606,"_5":14891,"_28416":55216,"_3083":55607},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3632":1474,"_31224":1336,"_21643":55609,"_5":14891,"_28416":55216,"_3083":55265},[],{"_3632":1475,"_31224":1336,"_21643":55611,"_5":14891,"_28416":55216,"_3083":55612},[],"`EventUpdateCertificateStatusKey`",{"_3632":1476,"_31224":1336,"_21643":55614,"_5":14891,"_28416":55216,"_3083":55615},[],"Certificate",{"_3632":1477,"_31224":1336,"_21643":55617,"_5":14891,"_28416":55216,"_3083":55618},[],"`IoTCore/Certificate`",{"_3632":1478,"_31224":1336,"_21643":55620,"_5":14891,"_28416":55216,"_3083":55621},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3632":1479,"_31224":1336,"_21643":55623,"_5":14891,"_28416":55216,"_3083":55624},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3632":1480,"_31224":1336,"_21643":55626,"_5":14891,"_28416":55216,"_3083":55277},[],{"_3632":1481,"_31224":1336,"_21643":55628,"_5":14891,"_28416":55216,"_3083":55629},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3632":1482,"_31224":1336,"_21643":55631,"_5":14891,"_28416":55216,"_3083":55632},[],"Certificate / Device",{"_3632":1483,"_31224":1336,"_21643":55634,"_5":14891,"_28416":55216,"_3083":55635},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3632":1484,"_31224":1336,"_21643":55637,"_5":14891,"_28416":55216,"_3083":51432},[],{"_3632":1485,"_31224":1336,"_21643":55639,"_5":14891,"_28416":55216,"_3083":55640},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3632":1486,"_31224":1336,"_21643":55642,"_5":14891,"_28416":55216,"_3083":55285},[],{"_3632":1487,"_31224":1336,"_21643":55644,"_5":14891,"_28416":55220,"_3083":55645},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3632":1488,"_31224":1336,"_21643":55647,"_5":14891,"_28416":55224,"_3083":55648},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3632":1489,"_31224":1336,"_21643":55650,"_5":14891,"_28416":55224,"_3083":55651},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3632":1490,"_31224":1336,"_21643":55653,"_5":14891,"_28416":55228,"_3083":55654},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3632":1491,"_31224":1336,"_21643":55656,"_5":14891,"_28416":55228,"_3083":55657},[],"Transition",{"_3632":1492,"_31224":1336,"_21643":55659,"_5":14891,"_28416":55228,"_3083":55660},[],"AWS calls",{"_3632":1493,"_31224":1336,"_21643":55662,"_5":14891,"_28416":55228,"_3083":55663},[],"`NotRegistered` → `Requested`",{"_3632":1494,"_31224":1336,"_21643":55665,"_5":14891,"_28416":55228,"_3083":55666},[],"none (metadata write only)",{"_3632":1495,"_31224":1336,"_21643":55668,"_5":14891,"_28416":55228,"_3083":55669},[],"`Requested` → `Registering`",{"_3632":1496,"_31224":1336,"_21643":55671,"_5":14891,"_28416":55228,"_3083":55672},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3632":1497,"_31224":1336,"_21643":55674,"_5":14891,"_28416":55228,"_3083":55675},[],"`Registering` → `Succeeded`",{"_3632":1498,"_31224":1336,"_21643":55677,"_5":14891,"_28416":55228,"_3083":55678},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3632":1499,"_31224":1336,"_21643":55680,"_5":14891,"_28416":55228,"_3083":55681},[],"`Registering` → `Failed`",{"_3632":1500,"_31224":1336,"_21643":55683,"_5":14891,"_28416":55228,"_3083":55684},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3632":1501,"_31224":1336,"_21643":55686,"_5":14891,"_28416":55228,"_3083":55687},[],"`Failed` / `Succeeded` → `Requested`",{"_3632":1502,"_31224":1336,"_21643":55689,"_5":14891,"_28416":55228,"_3083":55690},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3632":1503,"_31224":1336,"_21643":55692,"_5":14891,"_28416":55232,"_3083":55693},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3632":1504,"_31224":1336,"_21643":55695,"_5":14891,"_28416":55232,"_3083":55696},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3632":1505,"_31224":1336,"_21643":55698,"_5":14891,"_28416":55232,"_3083":55699},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3632":1506,"_31224":1336,"_21643":55701,"_5":14891,"_28416":55232,"_3083":55702},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3632":1507,"_31224":1336,"_21643":55704,"_5":14891,"_28416":55232,"_3083":55705},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3632":1508,"_31224":1336,"_21643":55707,"_5":14891,"_28416":55232,"_3083":55708},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3632":1509,"_31224":1336,"_21643":55710,"_5":14891,"_28416":55236,"_3083":55711},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3632":1510,"_31224":1336,"_21643":55713,"_5":14891,"_28416":55240,"_3083":55714},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3632":1511,"_31224":1336,"_21643":55716,"_5":14891,"_28416":55240,"_3083":55717},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3632":1512,"_31224":1336,"_21643":55719,"_5":14891,"_28416":55244,"_3083":55720},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3632":1513,"_31224":1336,"_21643":55722,"_5":14891,"_28416":55248,"_3083":55723},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3632":1514,"_31224":1336,"_21643":55725,"_5":14891,"_28416":55248,"_3083":55726},[],"Creates or updates the IoT policies configured in the DMS.",{"_3632":1515,"_31224":1336,"_21643":55728,"_5":14891,"_28416":55248,"_3083":55729},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3632":1516,"_31224":1336,"_21643":55731,"_5":14891,"_28416":55248,"_3083":55732},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3632":1517,"_31224":1336,"_21643":55734,"_5":14891,"_28416":55248,"_3083":55735},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3632":1518,"_31224":1336,"_21643":55737,"_5":14891,"_28416":55248,"_3083":55738},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3632":1519,"_31224":1336,"_21643":55740,"_5":14891,"_28416":55248,"_3083":55741},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3632":1520,"_31224":1336,"_21643":55743,"_5":14891,"_28416":55252,"_3083":55744},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3632":1521,"_31224":1336,"_21643":55746,"_5":14891,"_28416":55252,"_3083":55747},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3632":1522,"_31224":1336,"_21643":55749,"_5":14891,"_28416":55252,"_3083":55750},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3632":1523,"_31224":1336,"_21643":55752,"_5":14891,"_28416":55252,"_3083":55753},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3632":1524,"_31224":1336,"_21643":55755,"_5":14891,"_28416":55252,"_3083":55756},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3632":1525,"_31224":1336,"_21643":55758,"_5":14891,"_28416":55256,"_3083":55759},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3632":1526,"_31224":1336,"_21643":55761,"_5":14891,"_28416":55256,"_3083":55657},[],{"_3632":1527,"_31224":1336,"_21643":55763,"_5":14891,"_28416":55256,"_3083":55660},[],{"_3632":1528,"_31224":1336,"_21643":55765,"_5":14891,"_28416":55256,"_3083":55766},[],"`Unconfigured` → `None` / `Auto`",{"_3632":1529,"_31224":1336,"_21643":55768,"_5":14891,"_28416":55256,"_3083":55769},[],"none (configuration only)",{"_3632":1530,"_31224":1336,"_21643":55771,"_5":14891,"_28416":55256,"_3083":55772},[],"`None` ↔ `Auto`",{"_3632":1531,"_31224":1336,"_21643":55774,"_5":14891,"_28416":55256,"_3083":55769},[],{"_3632":1532,"_31224":1336,"_21643":55776,"_5":14891,"_28416":55256,"_3083":55777},[],"Any → `Jitp`",{"_3632":1533,"_31224":1336,"_21643":55779,"_5":14891,"_28416":55256,"_3083":55780},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3632":1534,"_31224":1336,"_21643":55782,"_5":14891,"_28416":55256,"_3083":55783},[],"`Jitp` → `None` / `Auto`",{"_3632":1535,"_31224":1336,"_21643":55785,"_5":14891,"_28416":55256,"_3083":55786},[],"none (the template stays in the AWS account)",{"_3632":1536,"_31224":1336,"_21643":55788,"_5":14891,"_28416":55260,"_3083":55789},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3632":1537,"_31224":1336,"_21643":55791,"_5":14891,"_28416":55260,"_3083":55792},[],"The full flow from the device's perspective is:",{"_3632":1538,"_31224":1336,"_21643":55794,"_5":14891,"_28416":55260,"_3083":55795},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3632":1539,"_31224":1336,"_21643":55797,"_5":14891,"_28416":55264,"_3083":55798},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3632":1540,"_31224":1336,"_21643":55800,"_5":14891,"_28416":55264,"_3083":55657},[],{"_3632":1541,"_31224":1336,"_21643":55802,"_5":14891,"_28416":55264,"_3083":55660},[],{"_3632":1542,"_31224":1336,"_21643":55804,"_5":14891,"_28416":55264,"_3083":55805},[],"`Absent` → `Provisioned`",{"_3632":1543,"_31224":1336,"_21643":55807,"_5":14891,"_28416":55264,"_3083":55808},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3632":1544,"_31224":1336,"_21643":55810,"_5":14891,"_28416":55264,"_3083":55811},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3632":1545,"_31224":1336,"_21643":55813,"_5":14891,"_28416":55264,"_3083":55814},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3632":1546,"_31224":1336,"_21643":55816,"_5":14891,"_28416":55264,"_3083":55817},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3632":1547,"_31224":1336,"_21643":55819,"_5":14891,"_28416":55268,"_3083":55820},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3632":1548,"_31224":1336,"_21643":55822,"_5":14891,"_28416":55268,"_3083":55823},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3632":1549,"_31224":1336,"_21643":55825,"_5":14891,"_28416":55268,"_3083":55826},[],"For the JITP flow to work correctly:",{"_3632":1550,"_31224":1336,"_21643":55828,"_5":14891,"_28416":55268,"_3083":55829},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3632":1551,"_31224":1336,"_21643":55831,"_5":14891,"_28416":55268,"_3083":55832},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3632":1552,"_31224":1336,"_21643":55834,"_5":14891,"_28416":55268,"_3083":55835},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3632":1553,"_31224":1336,"_21643":55837,"_5":14891,"_28416":55268,"_3083":55838},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3632":1554,"_31224":1336,"_21643":55840,"_5":14891,"_28416":55272,"_3083":55841},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3632":1555,"_31224":1336,"_21643":55843,"_5":14891,"_28416":55272,"_3083":55844},[],"Status in Lamassu",{"_3632":1556,"_31224":1336,"_21643":55846,"_5":14891,"_28416":55272,"_3083":55847},[],"Revocation reason",{"_3632":1557,"_31224":1336,"_21643":55849,"_5":14891,"_28416":55272,"_3083":55850},[],"Status in AWS IoT Core",{"_3632":1558,"_31224":1336,"_21643":55852,"_5":14891,"_28416":55272,"_3083":55853},[],"`Active`",{"_3632":1559,"_31224":1336,"_21643":55855,"_5":14891,"_28416":55272,"_3083":55856},[],"None",{"_3632":1560,"_31224":1336,"_21643":55858,"_5":14891,"_28416":55272,"_3083":55859},[],"`ACTIVE`",{"_3632":1561,"_31224":1336,"_21643":55861,"_5":14891,"_28416":55272,"_3083":55862},[],"`Revoked`",{"_3632":1562,"_31224":1336,"_21643":55864,"_5":14891,"_28416":55272,"_3083":55865},[],"`certificateHold`",{"_3632":1563,"_31224":1336,"_21643":55867,"_5":14891,"_28416":55272,"_3083":55868},[],"`INACTIVE`",{"_3632":1564,"_31224":1336,"_21643":55870,"_5":14891,"_28416":55272,"_3083":55862},[],{"_3632":1565,"_31224":1336,"_21643":55872,"_5":14891,"_28416":55272,"_3083":55873},[],"Any other reason",{"_3632":1566,"_31224":1336,"_21643":55875,"_5":14891,"_28416":55272,"_3083":55876},[],"`REVOKED`",{"_3632":1567,"_31224":1336,"_21643":55878,"_5":14891,"_28416":55272,"_3083":55879},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3632":1568,"_31224":1336,"_21643":55881,"_5":14891,"_28416":55276,"_3083":55882},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3632":1569,"_31224":1336,"_21643":55884,"_5":14891,"_28416":55276,"_3083":55657},[],{"_3632":1570,"_31224":1336,"_21643":55886,"_5":14891,"_28416":55276,"_3083":55660},[],{"_3632":1571,"_31224":1336,"_21643":55888,"_5":14891,"_28416":55276,"_3083":55889},[],"`NotSynced` → `Active`",{"_3632":1572,"_31224":1336,"_21643":55891,"_5":14891,"_28416":55276,"_3083":55368},[],{"_3632":1573,"_31224":1336,"_21643":55893,"_5":14891,"_28416":55276,"_3083":55894},[],"`Active` → `Inactive`",{"_3632":1574,"_31224":1336,"_21643":55896,"_5":14891,"_28416":55276,"_3083":55897},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3632":1575,"_31224":1336,"_21643":55899,"_5":14891,"_28416":55276,"_3083":55900},[],"`Active` → `Revoked`",{"_3632":1576,"_31224":1336,"_21643":55902,"_5":14891,"_28416":55276,"_3083":55897},[],{"_3632":1577,"_31224":1336,"_21643":55904,"_5":14891,"_28416":55276,"_3083":55905},[],"`Inactive` / `Revoked` → `Active`",{"_3632":1578,"_31224":1336,"_21643":55907,"_5":14891,"_28416":55276,"_3083":55368},[],{"_3632":1579,"_31224":1336,"_21643":55909,"_5":14891,"_28416":55276,"_3083":55910},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3632":1580,"_31224":1336,"_21643":55912,"_5":14891,"_28416":55276,"_3083":55913},[],"none (these states are not synced to AWS)",{"_3632":1581,"_31224":1336,"_21643":55915,"_5":14891,"_28416":55280,"_3083":55916},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3632":1582,"_31224":1336,"_21643":55918,"_5":14891,"_28416":55280,"_3083":55919},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3632":1583,"_31224":1336,"_21643":55921,"_5":14891,"_28416":55280,"_3083":55922},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3632":1584,"_31224":1336,"_21643":55924,"_5":14891,"_28416":55284,"_3083":55925},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3632":1585,"_31224":1336,"_21643":55927,"_5":14891,"_28416":55284,"_3083":55928},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3632":1586,"_31224":1336,"_21643":55930,"_5":14891,"_28416":55288,"_3083":55931},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3632":1587,"_31224":1336,"_21643":55933,"_5":14891,"_28416":55288,"_3083":55934},[],"There are two action types:",{"_3632":1588,"_31224":1336,"_21643":55936,"_5":14891,"_28416":55288,"_3083":55937},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3632":1589,"_31224":1336,"_21643":55939,"_5":14891,"_28416":55288,"_3083":55940},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3632":1590,"_31224":1336,"_21643":55942,"_5":14891,"_28416":55288,"_3083":55943},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3632":1591,"_31224":1336,"_21643":55945,"_5":14891,"_28416":55292,"_3083":55946},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3632":1592,"_31224":1336,"_21643":55948,"_5":14891,"_28416":55292,"_3083":55949},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3632":1593,"_31224":1336,"_21643":55951,"_5":14891,"_28416":55292,"_3083":55952},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3632":1594,"_31224":1336,"_21643":55954,"_5":14891,"_28416":55296,"_3083":55955},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3632":1595,"_31224":1336,"_21643":55957,"_5":14891,"_28416":55296,"_3083":55958},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3632":1596,"_31224":1336,"_21643":55960,"_5":14891,"_28416":55296,"_3083":55961},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3632":1597,"_31224":1336,"_21643":55963,"_5":14891,"_28416":55296,"_3083":55964},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3632":1598,"_31224":1336,"_21643":55966,"_5":14891,"_28416":55296,"_3083":55967},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3632":1599,"_31224":1336,"_21643":55969,"_5":14891,"_28416":55296,"_3083":55970},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3632":1600,"_31224":1336,"_21643":55972,"_5":14891,"_28416":55296,"_3083":55973},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3632":1601,"_31224":1336,"_21643":55975,"_5":14891,"_28416":55296,"_3083":55976},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3632":1602,"_31224":1336,"_21643":55978,"_5":14891,"_28416":55296,"_3083":55979},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3632":1603,"_31224":1336,"_21643":55981,"_5":14891,"_28416":55296,"_3083":55982},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3632":1604,"_31224":1336,"_21643":55984,"_5":14891,"_28416":55296,"_3083":55985},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3632":1605,"_31224":1336,"_21643":55987,"_5":14891,"_28416":55296,"_3083":55988},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3632":1606,"_31224":1336,"_21643":55990,"_5":14891,"_28416":55296,"_3083":55991},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3632":1607,"_31224":1336,"_21643":55993,"_5":14891,"_28416":55296,"_3083":55994},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3632":1608,"_31224":1336,"_21643":55996,"_5":14891,"_28416":55296,"_3083":55997},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3632":1609,"_31224":1336,"_21643":55999,"_5":14891,"_28416":55296,"_3083":56000},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3632":1610,"_31224":1336,"_21643":56002,"_5":14891,"_28416":55296,"_3083":56003},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3632":1611,"_31224":1336,"_21643":56005,"_5":14891,"_28416":55296,"_3083":56006},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3632":1612,"_31224":1336,"_21643":56008,"_5":14891,"_28416":55296,"_3083":56009},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3632":1613,"_31224":1336,"_21643":56011,"_5":14891,"_28416":55296,"_3083":56012},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3632":1614,"_31224":1336,"_21643":56014,"_5":14891,"_28416":55296,"_3083":56015},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3632":1615,"_31224":1336,"_21643":56017,"_5":14891,"_28416":55296,"_3083":56018},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":1616,"_31224":1336,"_21643":56020,"_5":14891,"_28416":55296,"_3083":56021},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3632":1617,"_31224":1336,"_21643":56023,"_5":14891,"_28416":55296,"_3083":56024},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3632":1618,"_31224":1618,"_5":15251,"_3083":53720,"_31583":56026,"_21643":56027,"_28416":1618},[51036,52548,53720],[],{"_3632":1619,"_31224":1618,"_21643":56029,"_5":14891,"_28416":1618,"_3083":56030},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3632":1620,"_31224":1618,"_5":31580,"_21643":56032,"_28416":56033,"_3083":56034},[],"/docs/pr-preview/pr-82/platform/iot-fleets/overview#start-here","Start here",{"_3632":1621,"_31224":1618,"_5":31580,"_21643":56036,"_28416":56037,"_3083":53718},[],"/docs/pr-preview/pr-82/platform/iot-fleets/overview#devices-and-identities",{"_3632":1622,"_31224":1618,"_5":31580,"_21643":56039,"_28416":56040,"_3083":53904},[],"/docs/pr-preview/pr-82/platform/iot-fleets/overview#enrollment-with-pki",{"_3632":1623,"_31224":1618,"_5":31580,"_21643":56042,"_28416":56043,"_3083":55193},[],"/docs/pr-preview/pr-82/platform/iot-fleets/overview#integrations",{"_3632":1624,"_31224":1618,"_5":31580,"_21643":56045,"_28416":56046,"_3083":56047},[],"/docs/pr-preview/pr-82/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3632":1625,"_31224":1618,"_21643":56049,"_5":14891,"_28416":1618,"_3083":56050},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3632":1626,"_31224":1618,"_21643":56052,"_5":14891,"_28416":56033,"_3083":56053},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3632":1627,"_31224":1618,"_21643":56055,"_5":14891,"_28416":56033,"_3083":56056},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3632":1628,"_31224":1618,"_21643":56058,"_5":14891,"_28416":56037,"_3083":56059},[],"Resource",{"_3632":1629,"_31224":1618,"_21643":56061,"_5":14891,"_28416":56037,"_3083":56062},[],"What it represents",{"_3632":1630,"_31224":1618,"_21643":56064,"_5":14891,"_28416":56037,"_3083":56065},[],"**Device**",{"_3632":1631,"_31224":1618,"_21643":56067,"_5":14891,"_28416":56037,"_3083":56068},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3632":1632,"_31224":1618,"_21643":56070,"_5":14891,"_28416":56037,"_3083":56071},[],"**Identity**",{"_3632":1633,"_31224":1618,"_21643":56073,"_5":14891,"_28416":56037,"_3083":56074},[],"The device's association with its certificates: an active version and a history.",{"_3632":1634,"_31224":1618,"_21643":56076,"_5":14891,"_28416":56037,"_3083":56077},[],"**DMS**",{"_3632":1635,"_31224":1618,"_21643":56079,"_5":14891,"_28416":56037,"_3083":56080},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3632":1636,"_31224":1618,"_21643":56082,"_5":14891,"_28416":56037,"_3083":56083},[],"**Fleet**",{"_3632":1637,"_31224":1618,"_21643":56085,"_5":14891,"_28416":56037,"_3083":56086},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3632":1638,"_31224":1618,"_21643":56088,"_5":14891,"_28416":56037,"_3083":56089},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3632":1639,"_31224":1618,"_21643":56091,"_5":14891,"_28416":56037,"_3083":56092},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3632":1640,"_31224":1618,"_21643":56094,"_5":14891,"_28416":56040,"_3083":56095},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3632":1641,"_31224":1618,"_21643":56097,"_5":14891,"_28416":56040,"_3083":56098},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3632":1642,"_31224":1618,"_21643":56100,"_5":14891,"_28416":56040,"_3083":56101},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3632":1643,"_31224":1618,"_21643":56103,"_5":14891,"_28416":56040,"_3083":56104},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3632":1644,"_31224":1618,"_21643":56106,"_5":14891,"_28416":56040,"_3083":56107},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3632":1645,"_31224":1618,"_21643":56109,"_5":14891,"_28416":56040,"_3083":56110},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3632":1646,"_31224":1618,"_21643":56112,"_5":14891,"_28416":56040,"_3083":56113},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":1647,"_31224":1618,"_21643":56115,"_5":14891,"_28416":56040,"_3083":56116},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":1648,"_31224":1618,"_21643":56118,"_5":14891,"_28416":56043,"_3083":56119},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3632":1649,"_31224":1618,"_21643":56121,"_5":14891,"_28416":56043,"_3083":56122},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3632":1650,"_31224":1618,"_21643":56124,"_5":14891,"_28416":56046,"_3083":56125},[],"Participant",{"_3632":1651,"_31224":1618,"_21643":56127,"_5":14891,"_28416":56046,"_3083":56128},[],"Responsibility",{"_3632":1652,"_31224":1618,"_21643":56130,"_5":14891,"_28416":56046,"_3083":56131},[],"PKI administrator",{"_3632":1653,"_31224":1618,"_21643":56133,"_5":14891,"_28416":56046,"_3083":56134},[],"CA, issuance profile, chain and revocation publication.",{"_3632":1654,"_31224":1618,"_21643":56136,"_5":14891,"_28416":56046,"_3083":56137},[],"Provisioning administrator",{"_3632":1655,"_31224":1618,"_21643":56139,"_5":14891,"_28416":56046,"_3083":56140},[],"DMS, admission, authentication per operation and inventory.",{"_3632":1656,"_31224":1618,"_21643":56142,"_5":14891,"_28416":56046,"_3083":56143},[],"Device integrator",{"_3632":1657,"_31224":1618,"_21643":56145,"_5":14891,"_28416":56046,"_3083":56146},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3632":1658,"_31224":1618,"_21643":56148,"_5":14891,"_28416":56046,"_3083":56149},[],"Consumer integrator",{"_3632":1659,"_31224":1618,"_21643":56151,"_5":14891,"_28416":56046,"_3083":56152},[],"Trusted issuers, validation and device permissions in the destination.",{"_3632":1660,"_31224":1618,"_21643":56154,"_5":14891,"_28416":56046,"_3083":56155},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3632":1661,"_31224":1661,"_5":15251,"_3083":56157,"_31583":56158,"_21643":56160,"_28416":1661},"Enroll and connect your first device",[51036,52548,53720,56159],"Getting started",[],{"_3632":1662,"_31224":1661,"_21643":56162,"_5":14891,"_28416":1661,"_3083":56163},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3632":1663,"_31224":1661,"_5":31580,"_21643":56165,"_28416":56166,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3632":1664,"_31224":1661,"_5":31580,"_21643":56168,"_28416":56169,"_3083":56170},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3632":1665,"_31224":1661,"_5":31580,"_21643":56172,"_28416":56173,"_3083":56174},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3632":1666,"_31224":1661,"_5":31580,"_21643":56176,"_28416":56177,"_3083":56178},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3632":1667,"_31224":1661,"_5":31580,"_21643":56180,"_28416":56181,"_3083":56182},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3632":1668,"_31224":1661,"_5":31580,"_21643":56184,"_28416":56185,"_3083":56186},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3632":1669,"_31224":1661,"_5":31580,"_21643":56188,"_28416":56189,"_3083":56190},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3632":1670,"_31224":1661,"_5":31580,"_21643":56192,"_28416":56193,"_3083":56194},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3632":1671,"_31224":1661,"_21643":56196,"_5":14891,"_28416":1661,"_3083":56197},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3632":1672,"_31224":1661,"_21643":56199,"_5":14891,"_28416":56166,"_3083":56200},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3632":1673,"_31224":1661,"_21643":56202,"_5":14891,"_28416":56166,"_3083":56203},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3632":1674,"_31224":1661,"_21643":56205,"_5":14891,"_28416":56166,"_3083":56206},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3632":1675,"_31224":1661,"_21643":56208,"_5":14891,"_28416":56166,"_3083":56209},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3632":1676,"_31224":1661,"_21643":56211,"_5":14891,"_28416":56166,"_3083":56212},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3632":1677,"_31224":1661,"_21643":56214,"_5":14891,"_28416":56169,"_3083":56215},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3632":1678,"_31224":1661,"_21643":56217,"_5":14891,"_28416":56169,"_3083":56218},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3632":1679,"_31224":1661,"_21643":56220,"_5":14891,"_28416":56173,"_3083":56221},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3632":1680,"_31224":1661,"_21643":56223,"_5":14891,"_28416":56173,"_3083":56224},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3632":1681,"_31224":1661,"_21643":56226,"_5":14891,"_28416":56173,"_3083":56227},[],"Setting",{"_3632":1682,"_31224":1661,"_21643":56229,"_5":14891,"_28416":56173,"_3083":56230},[],"Evaluation value",{"_3632":1683,"_31224":1661,"_21643":56232,"_5":14891,"_28416":56173,"_3083":56233},[],"Enrollment CA",{"_3632":1684,"_31224":1661,"_21643":56235,"_5":14891,"_28416":56173,"_3083":56236},[],"Issuing root from `device-root.pem`.",{"_3632":1685,"_31224":1661,"_21643":56238,"_5":14891,"_28416":56173,"_3083":54040},[],{"_3632":1686,"_31224":1661,"_21643":56240,"_5":14891,"_28416":56173,"_3083":56241},[],"The 1-hour leaf profile you just prepared.",{"_3632":1687,"_31224":1661,"_21643":56243,"_5":14891,"_28416":56173,"_3083":56244},[],"Protocol / Registration Mode",{"_3632":1688,"_31224":1661,"_21643":56246,"_5":14891,"_28416":56173,"_3083":56247},[],"`EST_RFC7030` / `JITP`.",{"_3632":1689,"_31224":1661,"_21643":56249,"_5":14891,"_28416":56173,"_3083":56250},[],"Verify CSR Signature",{"_3632":1690,"_31224":1661,"_21643":56252,"_5":14891,"_28416":56173,"_3083":56253},[],"Enabled.",{"_3632":1691,"_31224":1661,"_21643":56255,"_5":14891,"_28416":56173,"_3083":56256},[],"Enable Replaceable Enrollment",{"_3632":1692,"_31224":1661,"_21643":56258,"_5":14891,"_28416":56173,"_3083":56259},[],"Disabled; the ID must be new.",{"_3632":1693,"_31224":1661,"_21643":56261,"_5":14891,"_28416":56173,"_3083":56262},[],"Initial authentication",{"_3632":1694,"_31224":1661,"_21643":56264,"_5":14891,"_28416":56173,"_3083":56265},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3632":1695,"_31224":1661,"_21643":56267,"_5":14891,"_28416":56173,"_3083":56268},[],"Renewal authentication",{"_3632":1696,"_31224":1661,"_21643":56270,"_5":14891,"_28416":56173,"_3083":56271},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3632":1697,"_31224":1661,"_21643":56273,"_5":14891,"_28416":56173,"_3083":56274},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3632":1698,"_31224":1661,"_21643":56276,"_5":14891,"_28416":56173,"_3083":56277},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3632":1699,"_31224":1661,"_21643":56279,"_5":14891,"_28416":56173,"_3083":56280},[],"Re-enrollment Delta",{"_3632":1700,"_31224":1661,"_21643":56282,"_5":14891,"_28416":56173,"_3083":56283},[],"1 hour.",{"_3632":1701,"_31224":1661,"_21643":56285,"_5":14891,"_28416":56173,"_3083":56286},[],"Preventive / Critical Delta",{"_3632":1702,"_31224":1661,"_21643":56288,"_5":14891,"_28416":56173,"_3083":56289},[],"30 minutes / 10 minutes.",{"_3632":1703,"_31224":1661,"_21643":56291,"_5":14891,"_28416":56173,"_3083":56292},[],"Revoke on Re-enrollment",{"_3632":1704,"_31224":1661,"_21643":56294,"_5":14891,"_28416":56173,"_3083":56295},[],"Disabled to test the successor before retiring the previous identity.",{"_3632":1705,"_31224":1661,"_21643":56297,"_5":14891,"_28416":56173,"_3083":54048},[],{"_3632":1706,"_31224":1661,"_21643":56299,"_5":14891,"_28416":56173,"_3083":56300},[],"Disabled; the operational key is generated in the client.",{"_3632":1707,"_31224":1661,"_21643":56302,"_5":14891,"_28416":56173,"_3083":56303},[],"CA Distribution",{"_3632":1708,"_31224":1661,"_21643":56305,"_5":14891,"_28416":56173,"_3083":56306},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3632":1709,"_31224":1661,"_21643":56308,"_5":14891,"_28416":56173,"_3083":56309},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3632":1710,"_31224":1661,"_21643":56311,"_5":14891,"_28416":56177,"_3083":56312},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3632":1711,"_31224":1661,"_21643":56314,"_5":14891,"_28416":56177,"_3083":56315},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3632":1712,"_31224":1661,"_21643":56317,"_5":14891,"_28416":56181,"_3083":56318},[],"Generate a new key and CSR with the selected identifier:",{"_3632":1713,"_31224":1661,"_21643":56320,"_5":14891,"_28416":56181,"_3083":56321},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3632":1714,"_31224":1661,"_21643":56323,"_5":14891,"_28416":56181,"_3083":56324},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3632":1715,"_31224":1661,"_21643":56326,"_5":14891,"_28416":56185,"_3083":56327},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3632":1716,"_31224":1661,"_21643":56329,"_5":14891,"_28416":56185,"_3083":56330},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3632":1717,"_31224":1661,"_21643":56332,"_5":14891,"_28416":56189,"_3083":56333},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3632":1718,"_31224":1661,"_21643":56335,"_5":14891,"_28416":56189,"_3083":56336},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3632":1719,"_31224":1661,"_21643":56338,"_5":14891,"_28416":56189,"_3083":56339},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3632":1720,"_31224":1661,"_21643":56341,"_5":14891,"_28416":56189,"_3083":56342},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3632":1721,"_31224":1661,"_21643":56344,"_5":14891,"_28416":56189,"_3083":56345},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3632":1722,"_31224":1661,"_21643":56347,"_5":14891,"_28416":56193,"_3083":56348},[],"Check",{"_3632":1723,"_31224":1661,"_21643":56350,"_5":14891,"_28416":56193,"_3083":56351},[],"Expected result",{"_3632":1724,"_31224":1661,"_21643":56353,"_5":14891,"_28416":56193,"_3083":56354},[],"Registration",{"_3632":1725,"_31224":1661,"_21643":56356,"_5":14891,"_28416":56193,"_3083":56357},[],"ID created automatically and correct DMS.",{"_3632":1726,"_31224":1661,"_21643":56359,"_5":14891,"_28416":56193,"_3083":55615},[],{"_3632":1727,"_31224":1661,"_21643":56361,"_5":14891,"_28416":56193,"_3083":56362},[],"CN, profile, serial and key verified.",{"_3632":1728,"_31224":1661,"_21643":56364,"_5":14891,"_28416":56193,"_3083":56365},[],"Inventory",{"_3632":1729,"_31224":1661,"_21643":56367,"_5":14891,"_28416":56193,"_3083":56368},[],"Received serial visible as the current identity and in history.",{"_3632":1730,"_31224":1661,"_21643":56370,"_5":14891,"_28416":56193,"_3083":56371},[],"Consumer",{"_3632":1731,"_31224":1661,"_21643":56373,"_5":14891,"_28416":56193,"_3083":56374},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3632":1732,"_31224":1661,"_21643":56376,"_5":14891,"_28416":56193,"_3083":56377},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3632":1733,"_31224":1661,"_21643":56379,"_5":14891,"_28416":56193,"_3083":56380},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3632":1734,"_31224":1734,"_5":15251,"_3083":53736,"_31583":56382,"_21643":56383,"_28416":1734},[51036,52548,53720,56159],[],{"_3632":1735,"_31224":1734,"_21643":56385,"_5":14891,"_28416":1734,"_3083":56386},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3632":1736,"_31224":1734,"_5":31580,"_21643":56388,"_28416":56389,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3632":1737,"_31224":1734,"_5":31580,"_21643":56391,"_28416":56392,"_3083":56393},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3632":1738,"_31224":1734,"_5":31580,"_21643":56395,"_28416":56396,"_3083":56397},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3632":1739,"_31224":1734,"_5":31580,"_21643":56399,"_28416":56400,"_3083":56401},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3632":1740,"_31224":1734,"_5":31580,"_21643":56403,"_28416":56404,"_3083":56405},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3632":1741,"_31224":1734,"_5":31580,"_21643":56407,"_28416":56408,"_3083":56409},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3632":1742,"_31224":1734,"_5":31580,"_21643":56411,"_28416":56412,"_3083":56351},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3632":1743,"_31224":1734,"_5":31580,"_21643":56414,"_28416":56415,"_3083":56416},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3632":1744,"_31224":1734,"_5":31580,"_21643":56418,"_28416":56419,"_3083":56420},[],"/docs/pr-preview/pr-82/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3632":1745,"_31224":1734,"_21643":56422,"_5":14891,"_28416":1734,"_3083":56423},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3632":1746,"_31224":1734,"_21643":56425,"_5":14891,"_28416":1734,"_3083":56426},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3632":1747,"_31224":1734,"_21643":56428,"_5":14891,"_28416":56389,"_3083":56429},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3632":1748,"_31224":1734,"_21643":56431,"_5":14891,"_28416":56389,"_3083":56432},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3632":1749,"_31224":1734,"_21643":56434,"_5":14891,"_28416":56389,"_3083":56435},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3632":1750,"_31224":1734,"_21643":56437,"_5":14891,"_28416":56389,"_3083":56438},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3632":1751,"_31224":1734,"_21643":56440,"_5":14891,"_28416":56392,"_3083":56441},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3632":1752,"_31224":1734,"_21643":56443,"_5":14891,"_28416":56392,"_3083":56444},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3632":1753,"_31224":1734,"_21643":56446,"_5":14891,"_28416":56392,"_3083":56447},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3632":1754,"_31224":1734,"_21643":56449,"_5":14891,"_28416":56392,"_3083":56450},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3632":1755,"_31224":1734,"_21643":56452,"_5":14891,"_28416":56392,"_3083":56453},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3632":1756,"_31224":1734,"_21643":56455,"_5":14891,"_28416":56392,"_3083":56456},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3632":1757,"_31224":1734,"_21643":56458,"_5":14891,"_28416":56392,"_3083":56459},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3632":1758,"_31224":1734,"_21643":56461,"_5":14891,"_28416":56392,"_3083":56462},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3632":1759,"_31224":1734,"_21643":56464,"_5":14891,"_28416":56396,"_3083":56465},[],"Open **Managed Devices** and the registration action. Complete:",{"_3632":1760,"_31224":1734,"_21643":56467,"_5":14891,"_28416":56396,"_3083":56468},[],"**Device ID**: `device-001`.",{"_3632":1761,"_31224":1734,"_21643":56470,"_5":14891,"_28416":56396,"_3083":56471},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3632":1762,"_31224":1734,"_21643":56473,"_5":14891,"_28416":56396,"_3083":56474},[],"**Icon** and **Tags**: optional classification.",{"_3632":1763,"_31224":1734,"_21643":56476,"_5":14891,"_28416":56396,"_3083":56477},[],"Confirm registration.",{"_3632":1764,"_31224":1734,"_21643":56479,"_5":14891,"_28416":56400,"_3083":56480},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3632":1765,"_31224":1734,"_21643":56482,"_5":14891,"_28416":56400,"_3083":56483},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3632":1766,"_31224":1734,"_21643":56485,"_5":14891,"_28416":56404,"_3083":56486},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3632":1767,"_31224":1734,"_21643":56488,"_5":14891,"_28416":56404,"_3083":56489},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3632":1768,"_31224":1734,"_21643":56491,"_5":14891,"_28416":56408,"_3083":56492},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3632":1769,"_31224":1734,"_21643":56494,"_5":14891,"_28416":56408,"_3083":56495},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3632":1770,"_31224":1734,"_21643":56497,"_5":14891,"_28416":56412,"_3083":56348},[],{"_3632":1771,"_31224":1734,"_21643":56499,"_5":14891,"_28416":56412,"_3083":56500},[],"Result",{"_3632":1772,"_31224":1734,"_21643":56502,"_5":14891,"_28416":56412,"_3083":55598},[],{"_3632":1773,"_31224":1734,"_21643":56504,"_5":14891,"_28416":56412,"_3083":56505},[],"`device-001` appears in inventory with the expected DMS.",{"_3632":1774,"_31224":1734,"_21643":56507,"_5":14891,"_28416":56412,"_3083":56508},[],"Current identity",{"_3632":1775,"_31224":1734,"_21643":56510,"_5":14891,"_28416":56412,"_3083":56511},[],"The associated certificate matches the one you verified in PKI.",{"_3632":1776,"_31224":1734,"_21643":56513,"_5":14891,"_28416":56412,"_3083":56514},[],"History",{"_3632":1777,"_31224":1734,"_21643":56516,"_5":14891,"_28416":56412,"_3083":56517},[],"The associated issuance appears with its serial number and dates.",{"_3632":1778,"_31224":1734,"_21643":56519,"_5":14891,"_28416":56412,"_3083":56520},[],"Key and certificate",{"_3632":1779,"_31224":1734,"_21643":56522,"_5":14891,"_28416":56412,"_3083":56523},[],"You have the verified pair ready to install on the device.",{"_3632":1780,"_31224":1734,"_21643":56525,"_5":14891,"_28416":56415,"_3083":56526},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3632":1781,"_31224":1734,"_21643":56528,"_5":14891,"_28416":56415,"_3083":56529},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3632":1782,"_31224":1734,"_21643":56531,"_5":14891,"_28416":56415,"_3083":56532},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3632":1783,"_31224":1734,"_21643":56534,"_5":14891,"_28416":56415,"_3083":56535},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3632":1784,"_31224":1734,"_21643":56537,"_5":14891,"_28416":56419,"_3083":56538},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3632":1785,"_31224":1734,"_21643":56540,"_5":14891,"_28416":56419,"_3083":56541},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3632":1786,"_31224":1734,"_21643":56543,"_5":14891,"_28416":56419,"_3083":56544},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3632":1787,"_31224":1787,"_5":15251,"_3083":56546,"_31583":56547,"_21643":56548,"_28416":1787},"Lamassu IoT Platform",[51036,52548],[],{"_3632":1788,"_31224":1787,"_21643":56550,"_5":14891,"_28416":1787,"_3083":56551},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3632":1789,"_31224":1787,"_5":31580,"_21643":56553,"_28416":56554,"_3083":56034},[],"/docs/pr-preview/pr-82/platform/overview#start-here",{"_3632":1790,"_31224":1787,"_5":31580,"_21643":56556,"_28416":56557,"_3083":56558},[],"/docs/pr-preview/pr-82/platform/overview#choose-your-path","Choose your path",{"_3632":1791,"_31224":1787,"_5":31580,"_21643":56560,"_28416":56561,"_3083":56562},[],"/docs/pr-preview/pr-82/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3632":1792,"_31224":1787,"_5":31580,"_21643":56564,"_28416":56565,"_3083":56566},[],"/docs/pr-preview/pr-82/platform/overview#core-capabilities","Core capabilities",{"_3632":1793,"_31224":1787,"_5":31580,"_21643":56568,"_28416":56569,"_3083":56570},[],"/docs/pr-preview/pr-82/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3632":1794,"_31224":1787,"_5":31580,"_21643":56572,"_28416":56573,"_3083":56574},[],"/docs/pr-preview/pr-82/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3632":1795,"_31224":1787,"_5":31580,"_21643":56576,"_28416":56577,"_3083":56578},[],"/docs/pr-preview/pr-82/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3632":1796,"_31224":1787,"_5":31580,"_21643":56580,"_28416":56581,"_3083":56582},[],"/docs/pr-preview/pr-82/platform/overview#automate-device-identities","Automate device identities",{"_3632":1797,"_31224":1787,"_5":31580,"_21643":56584,"_28416":56585,"_3083":56586},[],"/docs/pr-preview/pr-82/platform/overview#publish-validation-status","Publish validation status",{"_3632":1798,"_31224":1787,"_5":31580,"_21643":56588,"_28416":56589,"_3083":56590},[],"/docs/pr-preview/pr-82/platform/overview#react-to-events","React to events",{"_3632":1799,"_31224":1787,"_5":31580,"_21643":56592,"_28416":56593,"_3083":56594},[],"/docs/pr-preview/pr-82/platform/overview#operational-reference","Operational reference",{"_3632":1800,"_31224":1787,"_21643":56596,"_5":14891,"_28416":1787,"_3083":56597},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3632":1801,"_31224":1787,"_21643":56599,"_5":14891,"_28416":56554,"_3083":56600},[],"Choose the result you need:",{"_3632":1802,"_31224":1787,"_21643":56602,"_5":14891,"_28416":56554,"_3083":56603},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":1803,"_31224":1787,"_21643":56605,"_5":14891,"_28416":56554,"_3083":56606},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":1804,"_31224":1787,"_21643":56608,"_5":14891,"_28416":56554,"_3083":56609},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3632":1805,"_31224":1787,"_21643":56611,"_5":14891,"_28416":56557,"_3083":56612},[],"Section",{"_3632":1806,"_31224":1787,"_21643":56614,"_5":14891,"_28416":56557,"_3083":56615},[],"What you manage",{"_3632":1807,"_31224":1787,"_21643":56617,"_5":14891,"_28416":56557,"_3083":56618},[],"Entry point",{"_3632":1808,"_31224":1787,"_21643":56620,"_5":14891,"_28416":56557,"_3083":56621},[],"**PKI**",{"_3632":1809,"_31224":1787,"_21643":56623,"_5":14891,"_28416":56557,"_3083":56624},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3632":1810,"_31224":1787,"_21643":56626,"_5":14891,"_28416":56557,"_3083":56627},[],"PKI overview",{"_3632":1811,"_31224":1787,"_21643":56629,"_5":14891,"_28416":56557,"_3083":56630},[],"**IoT Fleets**",{"_3632":1812,"_31224":1787,"_21643":56632,"_5":14891,"_28416":56557,"_3083":56633},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3632":1813,"_31224":1787,"_21643":56635,"_5":14891,"_28416":56557,"_3083":56636},[],"IoT Fleets overview",{"_3632":1814,"_31224":1787,"_21643":56638,"_5":14891,"_28416":56557,"_3083":56639},[],"**Administration**",{"_3632":1815,"_31224":1787,"_21643":56641,"_5":14891,"_28416":56557,"_3083":56642},[],"Operator permissions, audit and event subscriptions.",{"_3632":1816,"_31224":1787,"_21643":56644,"_5":14891,"_28416":56557,"_3083":52550},[],{"_3632":1817,"_31224":1787,"_21643":56646,"_5":14891,"_28416":56557,"_3083":56647},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3632":1818,"_31224":1787,"_21643":56649,"_5":14891,"_28416":56561,"_3083":56650},[],"An identity's journey connects four responsibilities:",{"_3632":1819,"_31224":1787,"_21643":56652,"_5":14891,"_28416":56561,"_3083":56653},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3632":1820,"_31224":1787,"_21643":56655,"_5":14891,"_28416":56561,"_3083":56656},[],"The provisioning administrator configures the DMS and initial trust.",{"_3632":1821,"_31224":1787,"_21643":56658,"_5":14891,"_28416":56561,"_3083":56659},[],"The device client requests a certificate and installs it with the matching key.",{"_3632":1822,"_31224":1787,"_21643":56661,"_5":14891,"_28416":56561,"_3083":56662},[],"The consumer validates the identity and applies its access permissions.",{"_3632":1823,"_31224":1787,"_21643":56664,"_5":14891,"_28416":56561,"_3083":56665},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3632":1824,"_31224":1787,"_21643":56667,"_5":14891,"_28416":56569,"_3083":56668},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3632":1825,"_31224":1787,"_21643":56670,"_5":14891,"_28416":56573,"_3083":56671},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3632":1826,"_31224":1787,"_21643":56673,"_5":14891,"_28416":56577,"_3083":56674},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3632":1827,"_31224":1787,"_21643":56676,"_5":14891,"_28416":56581,"_3083":56677},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3632":1828,"_31224":1787,"_21643":56679,"_5":14891,"_28416":56585,"_3083":56680},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3632":1829,"_31224":1787,"_21643":56682,"_5":14891,"_28416":56589,"_3083":56683},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3632":1830,"_31224":1787,"_21643":56685,"_5":14891,"_28416":56593,"_3083":56128},[],{"_3632":1831,"_31224":1787,"_21643":56687,"_5":14891,"_28416":56593,"_3083":56688},[],"What it prepares or checks",{"_3632":1832,"_31224":1787,"_21643":56690,"_5":14891,"_28416":56593,"_3083":56131},[],{"_3632":1833,"_31224":1787,"_21643":56692,"_5":14891,"_28416":56593,"_3083":56693},[],"Key custody, CA hierarchy, profiles and validation.",{"_3632":1834,"_31224":1787,"_21643":56695,"_5":14891,"_28416":56593,"_3083":56696},[],"Fleet administrator",{"_3632":1835,"_31224":1787,"_21643":56698,"_5":14891,"_28416":56593,"_3083":56699},[],"DMS, device admission, renewal policy and inventory.",{"_3632":1836,"_31224":1787,"_21643":56701,"_5":14891,"_28416":56593,"_3083":56143},[],{"_3632":1837,"_31224":1787,"_21643":56703,"_5":14891,"_28416":56593,"_3083":56704},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3632":1838,"_31224":1787,"_21643":56706,"_5":14891,"_28416":56593,"_3083":56149},[],{"_3632":1839,"_31224":1787,"_21643":56708,"_5":14891,"_28416":56593,"_3083":56709},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3632":1840,"_31224":1787,"_21643":56711,"_5":14891,"_28416":56593,"_3083":56712},[],"Infrastructure operator",{"_3632":1841,"_31224":1787,"_21643":56714,"_5":14891,"_28416":56593,"_3083":56715},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3632":1842,"_31224":1787,"_21643":56717,"_5":14891,"_28416":56593,"_3083":56718},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3632":1843,"_31224":1843,"_5":15251,"_3083":56720,"_31583":56721,"_21643":56724,"_28416":1843},"CA hierarchy and rotation",[51036,52548,56722,56723],"PKI","Keys, authorities and certificates",[],{"_3632":1844,"_31224":1843,"_21643":56726,"_5":14891,"_28416":1843,"_3083":56727},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3632":1845,"_31224":1843,"_5":31580,"_21643":56729,"_28416":56730,"_3083":56731},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3632":1846,"_31224":1843,"_5":31580,"_21643":56733,"_28416":56734,"_3083":56735},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3632":1847,"_31224":1843,"_5":31580,"_21643":56737,"_28416":56738,"_3083":56739},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3632":1848,"_31224":1843,"_5":31580,"_21643":56741,"_28416":56742,"_3083":56743},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3632":1849,"_31224":1843,"_5":31580,"_21643":56745,"_28416":56746,"_3083":56747},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3632":1850,"_31224":1843,"_5":31580,"_21643":56749,"_28416":56750,"_3083":56751},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3632":1851,"_31224":1843,"_5":31580,"_21643":56753,"_28416":56754,"_3083":56755},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3632":1852,"_31224":1843,"_5":31580,"_21643":56757,"_28416":56758,"_3083":56759},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3632":1853,"_31224":1843,"_5":31580,"_21643":56761,"_28416":56762,"_3083":56763},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3632":1854,"_31224":1843,"_5":31580,"_21643":56765,"_28416":56766,"_3083":56767},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3632":1855,"_31224":1843,"_5":31580,"_21643":56769,"_28416":56770,"_3083":56771},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3632":1856,"_31224":1843,"_5":31580,"_21643":56773,"_28416":56774,"_3083":56775},[],"/docs/pr-preview/pr-82/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3632":1857,"_31224":1843,"_21643":56777,"_5":14891,"_28416":1843,"_3083":56778},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3632":1858,"_31224":1843,"_21643":56780,"_5":14891,"_28416":1843,"_3083":56781},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3632":1859,"_31224":1843,"_21643":56783,"_5":14891,"_28416":56730,"_3083":56784},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3632":1860,"_31224":1843,"_21643":56786,"_5":14891,"_28416":56730,"_3083":56787},[],"environment, such as production and preproduction;",{"_3632":1861,"_31224":1843,"_21643":56789,"_5":14891,"_28416":56730,"_3083":56790},[],"owner or operating team;",{"_3632":1862,"_31224":1843,"_21643":56792,"_5":14891,"_28416":56730,"_3083":56793},[],"device family or manufacturing process;",{"_3632":1863,"_31224":1843,"_21643":56795,"_5":14891,"_28416":56730,"_3083":56796},[],"region or regulatory requirement;",{"_3632":1864,"_31224":1843,"_21643":56798,"_5":14891,"_28416":56730,"_3083":56799},[],"cryptographic engine or key policy;",{"_3632":1865,"_31224":1843,"_21643":56801,"_5":14891,"_28416":56730,"_3083":56802},[],"maintenance window and renewal cadence.",{"_3632":1866,"_31224":1843,"_21643":56804,"_5":14891,"_28416":56730,"_3083":56805},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3632":1867,"_31224":1843,"_21643":56807,"_5":14891,"_28416":56730,"_3083":56808},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3632":1868,"_31224":1843,"_21643":56810,"_5":14891,"_28416":56734,"_3083":56811},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3632":1869,"_31224":1843,"_21643":56813,"_5":14891,"_28416":56734,"_3083":56814},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3632":1870,"_31224":1843,"_21643":56816,"_5":14891,"_28416":56734,"_3083":56817},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3632":1871,"_31224":1843,"_21643":56819,"_5":14891,"_28416":56734,"_3083":56820},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3632":1872,"_31224":1843,"_21643":56822,"_5":14891,"_28416":56738,"_3083":56823},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3632":1873,"_31224":1843,"_21643":56825,"_5":14891,"_28416":56738,"_3083":56826},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3632":1874,"_31224":1843,"_21643":56828,"_5":14891,"_28416":56738,"_3083":56829},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3632":1875,"_31224":1843,"_21643":56831,"_5":14891,"_28416":56738,"_3083":56832},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3632":1876,"_31224":1843,"_21643":56834,"_5":14891,"_28416":56746,"_3083":56835},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3632":1877,"_31224":1843,"_21643":56837,"_5":14891,"_28416":56750,"_3083":56838},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3632":1878,"_31224":1843,"_21643":56840,"_5":14891,"_28416":56754,"_3083":56841},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3632":1879,"_31224":1843,"_21643":56843,"_5":14891,"_28416":56758,"_3083":56844},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3632":1880,"_31224":1843,"_21643":56846,"_5":14891,"_28416":56762,"_3083":56847},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3632":1881,"_31224":1843,"_21643":56849,"_5":14891,"_28416":56766,"_3083":56850},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3632":1882,"_31224":1843,"_21643":56852,"_5":14891,"_28416":56770,"_3083":56853},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3632":1883,"_31224":1843,"_21643":56855,"_5":14891,"_28416":56770,"_3083":56856},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3632":1884,"_31224":1843,"_21643":56858,"_5":14891,"_28416":56770,"_3083":56859},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3632":1885,"_31224":1843,"_21643":56861,"_5":14891,"_28416":56770,"_3083":56862},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3632":1886,"_31224":1843,"_21643":56864,"_5":14891,"_28416":56774,"_3083":56865},[],"The new chain ends in an anchor installed by the consumer.",{"_3632":1887,"_31224":1843,"_21643":56867,"_5":14891,"_28416":56774,"_3083":56868},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3632":1888,"_31224":1843,"_21643":56870,"_5":14891,"_28416":56774,"_3083":56871},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3632":1889,"_31224":1843,"_21643":56873,"_5":14891,"_28416":56774,"_3083":56874},[],"Re-enrollment accepts the old identity during the planned period.",{"_3632":1890,"_31224":1843,"_21643":56876,"_5":14891,"_28416":56774,"_3083":56877},[],"OCSP and CRL respond for the authorities that remain active.",{"_3632":1891,"_31224":1843,"_21643":56879,"_5":14891,"_28416":56774,"_3083":56880},[],"No DMS is left accidentally issuing from the old CA.",{"_3632":1892,"_31224":1843,"_21643":56882,"_5":14891,"_28416":56774,"_3083":56883},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3632":1893,"_31224":1893,"_5":15251,"_3083":56885,"_31583":56886,"_21643":56887,"_28416":1893},"Certification authorities",[51036,52548,56722,56723],[],{"_3632":1894,"_31224":1893,"_21643":56889,"_5":14891,"_28416":1893,"_3083":56890},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3632":1895,"_31224":1893,"_5":31580,"_21643":56892,"_28416":56893,"_3083":56894},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3632":1896,"_31224":1893,"_5":31580,"_21643":56896,"_28416":56897,"_3083":56898},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3632":1897,"_31224":1893,"_5":31580,"_21643":56900,"_28416":56901,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#before-you-begin",{"_3632":1898,"_31224":1893,"_5":31580,"_21643":56903,"_28416":56904,"_3083":56905},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3632":1899,"_31224":1893,"_5":31580,"_21643":56907,"_28416":56908,"_3083":56909},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3632":1900,"_31224":1893,"_5":31580,"_21643":56911,"_28416":56912,"_3083":56913},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3632":1901,"_31224":1893,"_5":31580,"_21643":56915,"_28416":56916,"_3083":56917},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3632":1902,"_31224":1893,"_5":31580,"_21643":56919,"_28416":56920,"_3083":56921},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3632":1903,"_31224":1893,"_5":31580,"_21643":56923,"_28416":56924,"_3083":56925},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3632":1904,"_31224":1893,"_5":31580,"_21643":56927,"_28416":56928,"_3083":56929},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3632":1905,"_31224":1893,"_5":31580,"_21643":56931,"_28416":56932,"_3083":56933},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3632":1906,"_31224":1893,"_5":31580,"_21643":56935,"_28416":56936,"_3083":56937},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3632":1907,"_31224":1893,"_5":31580,"_21643":56939,"_28416":56940,"_3083":56941},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3632":1908,"_31224":1893,"_5":31580,"_21643":56943,"_28416":56944,"_3083":56945},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3632":1909,"_31224":1893,"_5":31580,"_21643":56947,"_28416":56948,"_3083":56949},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3632":1910,"_31224":1893,"_5":31580,"_21643":56951,"_28416":56952,"_3083":56953},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#ca-states","CA states",{"_3632":1911,"_31224":1893,"_5":31580,"_21643":56955,"_28416":56956,"_3083":56957},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3632":1912,"_31224":1893,"_5":31580,"_21643":56959,"_28416":56960,"_3083":56961},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3632":1913,"_31224":1893,"_5":31580,"_21643":56963,"_28416":56964,"_3083":56965},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3632":1914,"_31224":1893,"_5":31580,"_21643":56967,"_28416":56968,"_3083":56969},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3632":1915,"_31224":1893,"_5":31580,"_21643":56971,"_28416":56972,"_3083":56973},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3632":1916,"_31224":1893,"_5":31580,"_21643":56975,"_28416":56976,"_3083":56977},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3632":1917,"_31224":1893,"_5":31580,"_21643":56979,"_28416":56980,"_3083":56981},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3632":1918,"_31224":1893,"_5":31580,"_21643":56983,"_28416":56984,"_3083":56985},[],"/docs/pr-preview/pr-82/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3632":1919,"_31224":1893,"_21643":56987,"_5":14891,"_28416":1893,"_3083":56988},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3632":1920,"_31224":1893,"_21643":56990,"_5":14891,"_28416":1893,"_3083":56991},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3632":1921,"_31224":1893,"_21643":56993,"_5":14891,"_28416":1893,"_3083":56994},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3632":1922,"_31224":1893,"_21643":56996,"_5":14891,"_28416":56893,"_3083":56997},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3632":1923,"_31224":1893,"_21643":56999,"_5":14891,"_28416":56893,"_3083":57000},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3632":1924,"_31224":1893,"_21643":57002,"_5":14891,"_28416":56893,"_3083":57003},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3632":1925,"_31224":1893,"_21643":57005,"_5":14891,"_28416":56893,"_3083":57006},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3632":1926,"_31224":1893,"_21643":57008,"_5":14891,"_28416":56893,"_3083":57009},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3632":1927,"_31224":1893,"_21643":57011,"_5":14891,"_28416":56901,"_3083":57012},[],"Decide whether the CA will be a root or an intermediate.",{"_3632":1928,"_31224":1893,"_21643":57014,"_5":14891,"_28416":56901,"_3083":57015},[],"Choose the engine that will keep the key.",{"_3632":1929,"_31224":1893,"_21643":57017,"_5":14891,"_28416":56901,"_3083":57018},[],"Define a validity longer than that of the certificates it will issue.",{"_3632":1930,"_31224":1893,"_21643":57020,"_5":14891,"_28416":56901,"_3083":57021},[],"For an intermediate CA, make sure the parent CA is active.",{"_3632":1931,"_31224":1893,"_21643":57023,"_5":14891,"_28416":56904,"_3083":57024},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3632":1932,"_31224":1893,"_21643":57026,"_5":14891,"_28416":56908,"_3083":57027},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3632":1933,"_31224":1893,"_21643":57029,"_5":14891,"_28416":56908,"_3083":57030},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3632":1934,"_31224":1893,"_21643":57032,"_5":14891,"_28416":56912,"_3083":57033},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3632":1935,"_31224":1893,"_21643":57035,"_5":14891,"_28416":56916,"_3083":57036},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3632":1936,"_31224":1893,"_21643":57038,"_5":14891,"_28416":56916,"_3083":57039},[],"`C`: two-letter ISO 3166-1 country code.",{"_3632":1937,"_31224":1893,"_21643":57041,"_5":14891,"_28416":56916,"_3083":57042},[],"`ST`: state or province.",{"_3632":1938,"_31224":1893,"_21643":57044,"_5":14891,"_28416":56916,"_3083":57045},[],"`L`: locality.",{"_3632":1939,"_31224":1893,"_21643":57047,"_5":14891,"_28416":56916,"_3083":57048},[],"`O`: organization.",{"_3632":1940,"_31224":1893,"_21643":57050,"_5":14891,"_28416":56916,"_3083":57051},[],"`OU`: organizational unit.",{"_3632":1941,"_31224":1893,"_21643":57053,"_5":14891,"_28416":56916,"_3083":57054},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3632":1942,"_31224":1893,"_21643":57056,"_5":14891,"_28416":56920,"_3083":57057},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3632":1943,"_31224":1893,"_21643":57059,"_5":14891,"_28416":56920,"_3083":57060},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3632":1944,"_31224":1893,"_21643":57062,"_5":14891,"_28416":56924,"_3083":57063},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3632":1945,"_31224":1893,"_21643":57065,"_5":14891,"_28416":56924,"_3083":57066},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3632":1946,"_31224":1893,"_21643":57068,"_5":14891,"_28416":56928,"_3083":57069},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3632":1947,"_31224":1893,"_21643":57071,"_5":14891,"_28416":56928,"_3083":57072},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3632":1948,"_31224":1893,"_21643":57074,"_5":14891,"_28416":56932,"_3083":57075},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3632":1949,"_31224":1893,"_21643":57077,"_5":14891,"_28416":56932,"_3083":57078},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3632":1950,"_31224":1893,"_21643":57080,"_5":14891,"_28416":56932,"_3083":57081},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3632":1951,"_31224":1893,"_21643":57083,"_5":14891,"_28416":56932,"_3083":57084},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3632":1952,"_31224":1893,"_21643":57086,"_5":14891,"_28416":56936,"_3083":57087},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3632":1953,"_31224":1893,"_21643":57089,"_5":14891,"_28416":56940,"_3083":57090},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3632":1954,"_31224":1893,"_21643":57092,"_5":14891,"_28416":56940,"_3083":57093},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3632":1955,"_31224":1893,"_21643":57095,"_5":14891,"_28416":56944,"_3083":57096},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3632":1956,"_31224":1893,"_21643":57098,"_5":14891,"_28416":56948,"_3083":57099},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3632":1957,"_31224":1893,"_21643":57101,"_5":14891,"_28416":56948,"_3083":57102},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3632":1958,"_31224":1893,"_21643":57104,"_5":14891,"_28416":56948,"_3083":57105},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3632":1959,"_31224":1893,"_21643":57107,"_5":14891,"_28416":56952,"_3083":57108},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3632":1960,"_31224":1893,"_21643":57110,"_5":14891,"_28416":56952,"_3083":57111},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3632":1961,"_31224":1893,"_21643":57113,"_5":14891,"_28416":56952,"_3083":57114},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3632":1962,"_31224":1893,"_21643":57116,"_5":14891,"_28416":56952,"_3083":57117},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3632":1963,"_31224":1893,"_21643":57119,"_5":14891,"_28416":56956,"_3083":57120},[],"Open a CA from the inventory to review:",{"_3632":1964,"_31224":1893,"_21643":57122,"_5":14891,"_28416":56956,"_3083":57123},[],"Status and validity period.",{"_3632":1965,"_31224":1893,"_21643":57125,"_5":14891,"_28416":56956,"_3083":57126},[],"Certificate and chain in PEM format.",{"_3632":1966,"_31224":1893,"_21643":57128,"_5":14891,"_28416":56956,"_3083":57129},[],"Number of active, expired and revoked certificates.",{"_3632":1967,"_31224":1893,"_21643":57131,"_5":14891,"_28416":56956,"_3083":57132},[],"Certificates issued in **Issued Certificates**.",{"_3632":1968,"_31224":1893,"_21643":57134,"_5":14891,"_28416":56956,"_3083":57135},[],"The CRL linked to the authority.",{"_3632":1969,"_31224":1893,"_21643":57137,"_5":14891,"_28416":56956,"_3083":57138},[],"Metadata and the associated cryptographic engine.",{"_3632":1970,"_31224":1893,"_21643":57140,"_5":14891,"_28416":56956,"_3083":57141},[],"You can filter the inventory by name, status and CA type.",{"_3632":1971,"_31224":1893,"_21643":57143,"_5":14891,"_28416":56960,"_3083":57144},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3632":1972,"_31224":1893,"_21643":57146,"_5":14891,"_28416":56960,"_3083":57147},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3632":1973,"_31224":1893,"_21643":57149,"_5":14891,"_28416":56960,"_3083":57150},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3632":1974,"_31224":1893,"_21643":57152,"_5":14891,"_28416":56960,"_3083":57153},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3632":1975,"_31224":1893,"_21643":57155,"_5":14891,"_28416":56960,"_3083":57156},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3632":1976,"_31224":1893,"_21643":57158,"_5":14891,"_28416":56960,"_3083":57159},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3632":1977,"_31224":1893,"_21643":57161,"_5":14891,"_28416":56964,"_3083":57162},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3632":1978,"_31224":1893,"_21643":57164,"_5":14891,"_28416":56968,"_3083":57165},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3632":1979,"_31224":1893,"_21643":57167,"_5":14891,"_28416":56972,"_3083":57168},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3632":1980,"_31224":1893,"_21643":57170,"_5":14891,"_28416":56976,"_3083":57171},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3632":1981,"_31224":1893,"_21643":57173,"_5":14891,"_28416":56980,"_3083":57174},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3632":1982,"_31224":1893,"_21643":57176,"_5":14891,"_28416":56984,"_3083":57177},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3632":1983,"_31224":1893,"_21643":57179,"_5":14891,"_28416":56984,"_3083":57180},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3632":1984,"_31224":1893,"_21643":57182,"_5":14891,"_28416":56984,"_3083":57183},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3632":1985,"_31224":1893,"_21643":57185,"_5":14891,"_28416":56984,"_3083":57186},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3632":1986,"_31224":1893,"_21643":57188,"_5":14891,"_28416":56984,"_3083":57189},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3632":1987,"_31224":1987,"_5":15251,"_3083":57191,"_31583":57192,"_21643":57193,"_28416":1987},"Certificate profiles",[51036,52548,56722,56723],[],{"_3632":1988,"_31224":1987,"_21643":57195,"_5":14891,"_28416":1987,"_3083":57196},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3632":1989,"_31224":1987,"_5":31580,"_21643":57198,"_28416":57199,"_3083":57200},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3632":1990,"_31224":1987,"_5":31580,"_21643":57202,"_28416":57203,"_3083":57204},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#validity","Validity",{"_3632":1991,"_31224":1987,"_5":31580,"_21643":57206,"_28416":57207,"_3083":57208},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3632":1992,"_31224":1987,"_5":31580,"_21643":57210,"_28416":57211,"_3083":57212},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3632":1993,"_31224":1987,"_5":31580,"_21643":57214,"_28416":57215,"_3083":57216},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#subject","Subject",{"_3632":1994,"_31224":1987,"_5":31580,"_21643":57218,"_28416":57219,"_3083":57220},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3632":1995,"_31224":1987,"_5":31580,"_21643":57222,"_28416":57223,"_3083":57224},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3632":1996,"_31224":1987,"_5":31580,"_21643":57226,"_28416":57227,"_3083":57228},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3632":1997,"_31224":1987,"_5":31580,"_21643":57230,"_28416":57231,"_3083":57232},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3632":1998,"_31224":1987,"_5":31580,"_21643":57234,"_28416":57235,"_3083":57236},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3632":1999,"_31224":1987,"_5":31580,"_21643":57238,"_28416":57239,"_3083":57240},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3632":2000,"_31224":1987,"_5":31580,"_21643":57242,"_28416":57243,"_3083":57244},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3632":2001,"_31224":1987,"_5":31580,"_21643":57246,"_28416":57247,"_3083":57248},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3632":2002,"_31224":1987,"_5":31580,"_21643":57250,"_28416":57251,"_3083":57252},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3632":2003,"_31224":1987,"_5":31580,"_21643":57254,"_28416":57255,"_3083":57256},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#design-examples","Design examples",{"_3632":2004,"_31224":1987,"_5":31580,"_21643":57258,"_28416":57259,"_3083":57260},[],"/docs/pr-preview/pr-82/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3632":2005,"_31224":1987,"_21643":57262,"_5":14891,"_28416":1987,"_3083":57263},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3632":2006,"_31224":1987,"_21643":57265,"_5":14891,"_28416":1987,"_3083":57266},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3632":2007,"_31224":1987,"_21643":57268,"_5":14891,"_28416":57203,"_3083":57269},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3632":2008,"_31224":1987,"_21643":57271,"_5":14891,"_28416":57203,"_3083":57272},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3632":2009,"_31224":1987,"_21643":57274,"_5":14891,"_28416":57207,"_3083":57275},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3632":2010,"_31224":1987,"_21643":57277,"_5":14891,"_28416":57211,"_3083":57278},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3632":2011,"_31224":1987,"_21643":57280,"_5":14891,"_28416":57211,"_3083":57281},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3632":2012,"_31224":1987,"_21643":57283,"_5":14891,"_28416":57211,"_3083":57284},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3632":2013,"_31224":1987,"_21643":57286,"_5":14891,"_28416":57215,"_3083":57287},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3632":2014,"_31224":1987,"_21643":57289,"_5":14891,"_28416":57219,"_3083":57290},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3632":2015,"_31224":1987,"_21643":57292,"_5":14891,"_28416":57219,"_3083":57293},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3632":2016,"_31224":1987,"_21643":57295,"_5":14891,"_28416":57223,"_3083":57296},[],"The cryptographic enforcement can:",{"_3632":2017,"_31224":1987,"_21643":57298,"_5":14891,"_28416":57223,"_3083":57299},[],"allow or block RSA keys;",{"_3632":2018,"_31224":1987,"_21643":57301,"_5":14891,"_28416":57223,"_3083":57302},[],"limit the supported RSA sizes;",{"_3632":2019,"_31224":1987,"_21643":57304,"_5":14891,"_28416":57223,"_3083":57305},[],"allow or block ECDSA keys;",{"_3632":2020,"_31224":1987,"_21643":57307,"_5":14891,"_28416":57223,"_3083":57308},[],"limit the supported ECDSA sizes or curves.",{"_3632":2021,"_31224":1987,"_21643":57310,"_5":14891,"_28416":57223,"_3083":57311},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3632":2022,"_31224":1987,"_21643":57313,"_5":14891,"_28416":57227,"_3083":57314},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3632":2023,"_31224":1987,"_21643":57316,"_5":14891,"_28416":57227,"_3083":54485},[],{"_3632":2024,"_31224":1987,"_21643":57318,"_5":14891,"_28416":57227,"_3083":57319},[],"First choice",{"_3632":2025,"_31224":1987,"_21643":57321,"_5":14891,"_28416":57227,"_3083":57322},[],"Second choice",{"_3632":2026,"_31224":1987,"_21643":57324,"_5":14891,"_28416":57227,"_3083":57325},[],"If neither is supplied",{"_3632":2027,"_31224":1987,"_21643":57327,"_5":14891,"_28416":57227,"_3083":57328},[],"Direct signing with a CA",{"_3632":2028,"_31224":1987,"_21643":57330,"_5":14891,"_28416":57227,"_3083":57331},[],"`issuance_profile` embedded in the request",{"_3632":2029,"_31224":1987,"_21643":57333,"_5":14891,"_28416":57227,"_3083":57334},[],"Request `issuance_profile_id`",{"_3632":2030,"_31224":1987,"_21643":57336,"_5":14891,"_28416":57227,"_3083":57337},[],"CA default profile (`profile_id`).",{"_3632":2031,"_31224":1987,"_21643":57339,"_5":14891,"_28416":57227,"_3083":57340},[],"Issuance through a DMS",{"_3632":2032,"_31224":1987,"_21643":57342,"_5":14891,"_28416":57227,"_3083":57343},[],"`settings.issuance_profile_id`",{"_3632":2033,"_31224":1987,"_21643":57345,"_5":14891,"_28416":57227,"_3083":57346},[],"`settings.issuance_profile` embedded in the DMS",{"_3632":2034,"_31224":1987,"_21643":57348,"_5":14891,"_28416":57227,"_3083":57349},[],"Enrollment CA default profile.",{"_3632":2035,"_31224":1987,"_21643":57351,"_5":14891,"_28416":57227,"_3083":57352},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3632":2036,"_31224":1987,"_21643":57354,"_5":14891,"_28416":57227,"_3083":57355},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3632":2037,"_31224":1987,"_21643":57357,"_5":14891,"_28416":57235,"_3083":57358},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3632":2038,"_31224":1987,"_21643":57360,"_5":14891,"_28416":57239,"_3083":57361},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3632":2039,"_31224":1987,"_21643":57363,"_5":14891,"_28416":57243,"_3083":57364},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3632":2040,"_31224":1987,"_21643":57366,"_5":14891,"_28416":57247,"_3083":57367},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3632":2041,"_31224":1987,"_21643":57369,"_5":14891,"_28416":57251,"_3083":57370},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3632":2042,"_31224":1987,"_21643":57372,"_5":14891,"_28416":57251,"_3083":57373},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3632":2043,"_31224":1987,"_21643":57375,"_5":14891,"_28416":57255,"_3083":57376},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3632":2044,"_31224":1987,"_21643":57378,"_5":14891,"_28416":57255,"_3083":57379},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3632":2045,"_31224":1987,"_21643":57381,"_5":14891,"_28416":57255,"_3083":57382},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3632":2046,"_31224":1987,"_21643":57384,"_5":14891,"_28416":57255,"_3083":57385},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3632":2047,"_31224":1987,"_21643":57387,"_5":14891,"_28416":57259,"_3083":57388},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3632":2048,"_31224":1987,"_21643":57390,"_5":14891,"_28416":57259,"_3083":57391},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3632":2049,"_31224":2049,"_5":15251,"_3083":57393,"_31583":57394,"_21643":57396,"_28416":2049},"Certificate validation",[51036,52548,56722,57395],"Validation",[],{"_3632":2050,"_31224":2049,"_21643":57398,"_5":14891,"_28416":2049,"_3083":57399},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3632":2051,"_31224":2049,"_5":31580,"_21643":57401,"_28416":57402,"_3083":57403},[],"/docs/pr-preview/pr-82/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3632":2052,"_31224":2049,"_5":31580,"_21643":57405,"_28416":57406,"_3083":57407},[],"/docs/pr-preview/pr-82/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3632":2053,"_31224":2049,"_5":31580,"_21643":57409,"_28416":57410,"_3083":57411},[],"/docs/pr-preview/pr-82/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3632":2054,"_31224":2049,"_21643":57413,"_5":14891,"_28416":2049,"_3083":57414},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3632":2055,"_31224":2049,"_21643":57416,"_5":14891,"_28416":57402,"_3083":57417},[],"Verify these criteria together:",{"_3632":2056,"_31224":2049,"_21643":57419,"_5":14891,"_28416":57402,"_3083":56348},[],{"_3632":2057,"_31224":2049,"_21643":57421,"_5":14891,"_28416":57402,"_3083":57422},[],"Required result",{"_3632":2058,"_31224":2049,"_21643":57424,"_5":14891,"_28416":57402,"_3083":57425},[],"Chain and signature",{"_3632":2059,"_31224":2049,"_21643":57427,"_5":14891,"_28416":57402,"_3083":57428},[],"Valid chain to a root deliberately installed in the consumer.",{"_3632":2060,"_31224":2049,"_21643":57430,"_5":14891,"_28416":57402,"_3083":57431},[],"Dates",{"_3632":2061,"_31224":2049,"_21643":57433,"_5":14891,"_28416":57402,"_3083":57434},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3632":2062,"_31224":2049,"_21643":57436,"_5":14891,"_28416":57402,"_3083":52217},[],{"_3632":2063,"_31224":2049,"_21643":57438,"_5":14891,"_28416":57402,"_3083":57439},[],"Name, SAN or identifier matches the expected peer.",{"_3632":2064,"_31224":2049,"_21643":57441,"_5":14891,"_28416":57402,"_3083":51426},[],{"_3632":2065,"_31224":2049,"_21643":57443,"_5":14891,"_28416":57402,"_3083":57444},[],"KU, EKU and constraints permit the specific operation.",{"_3632":2066,"_31224":2049,"_21643":57446,"_5":14891,"_28416":57402,"_3083":57447},[],"Revocation",{"_3632":2067,"_31224":2049,"_21643":57449,"_5":14891,"_28416":57402,"_3083":57450},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3632":2068,"_31224":2049,"_21643":57452,"_5":14891,"_28416":57402,"_3083":57453},[],"Authorization",{"_3632":2069,"_31224":2049,"_21643":57455,"_5":14891,"_28416":57402,"_3083":57456},[],"The application permits that identity to perform the action.",{"_3632":2070,"_31224":2049,"_21643":57458,"_5":14891,"_28416":57402,"_3083":57459},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3632":2071,"_31224":2049,"_21643":57461,"_5":14891,"_28416":57406,"_3083":57462},[],"Mechanism",{"_3632":2072,"_31224":2049,"_21643":57464,"_5":14891,"_28416":57406,"_3083":57465},[],"When to use it",{"_3632":2073,"_31224":2049,"_21643":57467,"_5":14891,"_28416":57406,"_3083":57468},[],"What you must maintain",{"_3632":2074,"_31224":2049,"_21643":57470,"_5":14891,"_28416":57406,"_3083":57471},[],"OCSP",{"_3632":2075,"_31224":2049,"_21643":57473,"_5":14891,"_28416":57406,"_3083":57474},[],"Status query for a specific certificate.",{"_3632":2076,"_31224":2049,"_21643":57476,"_5":14891,"_28416":57406,"_3083":57477},[],"Responder access, signature verification and cache/freshness policy.",{"_3632":2077,"_31224":2049,"_21643":57479,"_5":14891,"_28416":57406,"_3083":57480},[],"CRL",{"_3632":2078,"_31224":2049,"_21643":57482,"_5":14891,"_28416":57406,"_3083":57483},[],"Local checks for many certificates or offline operation.",{"_3632":2079,"_31224":2049,"_21643":57485,"_5":14891,"_28416":57406,"_3083":57486},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3632":2080,"_31224":2049,"_21643":57488,"_5":14891,"_28416":57406,"_3083":57489},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3632":2081,"_31224":2049,"_21643":57491,"_5":14891,"_28416":57406,"_3083":57492},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3632":2082,"_31224":2049,"_21643":57494,"_5":14891,"_28416":57410,"_3083":57495},[],"Accept a current, authorized certificate with a known chain.",{"_3632":2083,"_31224":2049,"_21643":57497,"_5":14891,"_28416":57410,"_3083":57498},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3632":2084,"_31224":2049,"_21643":57500,"_5":14891,"_28416":57410,"_3083":57501},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3632":2085,"_31224":2049,"_21643":57503,"_5":14891,"_28416":57410,"_3083":57504},[],"Check that a new connection with that identity is rejected.",{"_3632":2086,"_31224":2049,"_21643":57506,"_5":14891,"_28416":57410,"_3083":57507},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3632":2087,"_31224":2049,"_21643":57509,"_5":14891,"_28416":57410,"_3083":57510},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3632":2088,"_31224":2049,"_21643":57512,"_5":14891,"_28416":57410,"_3083":57513},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3632":2089,"_31224":2049,"_21643":57515,"_5":14891,"_28416":57410,"_3083":57516},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":2090,"_31224":2049,"_21643":57518,"_5":14891,"_28416":57410,"_3083":57519},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3632":2091,"_31224":2091,"_5":15251,"_3083":57521,"_31583":57522,"_21643":57523,"_28416":2091},"Certificates",[51036,52548,56722,56723],[],{"_3632":2092,"_31224":2091,"_21643":57525,"_5":14891,"_28416":2091,"_3083":57526},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3632":2093,"_31224":2091,"_5":31580,"_21643":57528,"_28416":57529,"_3083":57530},[],"/docs/pr-preview/pr-82/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3632":2094,"_31224":2091,"_5":31580,"_21643":57532,"_28416":57533,"_3083":57534},[],"/docs/pr-preview/pr-82/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3632":2095,"_31224":2091,"_5":31580,"_21643":57536,"_28416":57537,"_3083":57538},[],"/docs/pr-preview/pr-82/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3632":2096,"_31224":2091,"_5":31580,"_21643":57540,"_28416":57541,"_3083":57542},[],"/docs/pr-preview/pr-82/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3632":2097,"_31224":2091,"_5":31580,"_21643":57544,"_28416":57545,"_3083":57546},[],"/docs/pr-preview/pr-82/platform/pki/certificates#open-the-action","Open the action",{"_3632":2098,"_31224":2091,"_5":31580,"_21643":57548,"_28416":57549,"_3083":57550},[],"/docs/pr-preview/pr-82/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3632":2099,"_31224":2091,"_5":31580,"_21643":57552,"_28416":57553,"_3083":57554},[],"/docs/pr-preview/pr-82/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3632":2100,"_31224":2091,"_5":31580,"_21643":57556,"_28416":57557,"_3083":57558},[],"/docs/pr-preview/pr-82/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3632":2101,"_31224":2091,"_5":31580,"_21643":57560,"_28416":57561,"_3083":57562},[],"/docs/pr-preview/pr-82/platform/pki/certificates#continue","Continue",{"_3632":2102,"_31224":2091,"_21643":57564,"_5":14891,"_28416":2091,"_3083":57565},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3632":2103,"_31224":2091,"_21643":57567,"_5":14891,"_28416":57529,"_3083":57568},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3632":2104,"_31224":2091,"_21643":57570,"_5":14891,"_28416":57529,"_3083":57571},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3632":2105,"_31224":2091,"_21643":57573,"_5":14891,"_28416":57529,"_3083":57574},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3632":2106,"_31224":2091,"_21643":57576,"_5":14891,"_28416":57529,"_3083":57577},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3632":2107,"_31224":2091,"_21643":57579,"_5":14891,"_28416":57529,"_3083":57580},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3632":2108,"_31224":2091,"_21643":57582,"_5":14891,"_28416":57529,"_3083":57583},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3632":2109,"_31224":2091,"_21643":57585,"_5":14891,"_28416":57529,"_3083":57586},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3632":2110,"_31224":2091,"_21643":57588,"_5":14891,"_28416":57533,"_3083":57589},[],"Download the PEM and inspect it:",{"_3632":2111,"_31224":2091,"_21643":57591,"_5":14891,"_28416":57533,"_3083":57592},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3632":2112,"_31224":2091,"_21643":57594,"_5":14891,"_28416":57537,"_3083":57595},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3632":2113,"_31224":2091,"_21643":57597,"_5":14891,"_28416":57537,"_3083":57598},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3632":2114,"_31224":2091,"_21643":57600,"_5":14891,"_28416":57537,"_3083":57601},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3632":2115,"_31224":2091,"_21643":57603,"_5":14891,"_28416":57537,"_3083":57604},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3632":2116,"_31224":2091,"_21643":57606,"_5":14891,"_28416":57537,"_3083":57607},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3632":2117,"_31224":2091,"_21643":57609,"_5":14891,"_28416":57537,"_3083":57610},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3632":2118,"_31224":2091,"_21643":57612,"_5":14891,"_28416":57537,"_3083":57613},[],"For browser key generation, follow Issue your first certificate.",{"_3632":2119,"_31224":2091,"_21643":57615,"_5":14891,"_28416":57541,"_3083":57616},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3632":2120,"_31224":2091,"_21643":57618,"_5":14891,"_28416":57545,"_3083":57619},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3632":2121,"_31224":2091,"_21643":57621,"_5":14891,"_28416":57549,"_3083":57622},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3632":2122,"_31224":2091,"_21643":57624,"_5":14891,"_28416":57553,"_3083":57625},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3632":2123,"_31224":2091,"_21643":57627,"_5":14891,"_28416":57553,"_3083":57628},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3632":2124,"_31224":2091,"_21643":57630,"_5":14891,"_28416":57553,"_3083":57631},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3632":2125,"_31224":2091,"_21643":57633,"_5":14891,"_28416":57557,"_3083":57634},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3632":2126,"_31224":2091,"_21643":57636,"_5":14891,"_28416":57557,"_3083":57637},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3632":2127,"_31224":2091,"_21643":57639,"_5":14891,"_28416":57557,"_3083":57640},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3632":2128,"_31224":2091,"_21643":57642,"_5":14891,"_28416":57561,"_3083":57643},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":2129,"_31224":2091,"_21643":57645,"_5":14891,"_28416":57561,"_3083":57646},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3632":2130,"_31224":2130,"_5":15251,"_3083":57648,"_31583":57649,"_21643":57651,"_28416":2130},"Certificate lifecycle",[51036,52548,56722,57650],"Concepts",[],{"_3632":2131,"_31224":2130,"_21643":57653,"_5":14891,"_28416":2130,"_3083":57654},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3632":2132,"_31224":2130,"_5":31580,"_21643":57656,"_28416":57657,"_3083":57658},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3632":2133,"_31224":2130,"_5":31580,"_21643":57660,"_28416":57661,"_3083":57662},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3632":2134,"_31224":2130,"_5":31580,"_21643":57664,"_28416":57665,"_3083":57666},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3632":2135,"_31224":2130,"_5":31580,"_21643":57668,"_28416":57669,"_3083":57670},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3632":2136,"_31224":2130,"_5":31580,"_21643":57672,"_28416":57673,"_3083":57674},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3632":2137,"_31224":2130,"_5":31580,"_21643":57676,"_28416":57677,"_3083":57678},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3632":2138,"_31224":2130,"_5":31580,"_21643":57680,"_28416":57681,"_3083":57682},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3632":2139,"_31224":2130,"_5":31580,"_21643":57684,"_28416":57685,"_3083":57686},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3632":2140,"_31224":2130,"_5":31580,"_21643":57688,"_28416":57689,"_3083":57690},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3632":2141,"_31224":2130,"_5":31580,"_21643":57692,"_28416":57693,"_3083":57694},[],"/docs/pr-preview/pr-82/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3632":2142,"_31224":2130,"_21643":57696,"_5":14891,"_28416":2130,"_3083":57697},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3632":2143,"_31224":2130,"_21643":57699,"_5":14891,"_28416":57661,"_3083":57700},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3632":2144,"_31224":2130,"_21643":57702,"_5":14891,"_28416":57665,"_3083":57703},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3632":2145,"_31224":2130,"_21643":57705,"_5":14891,"_28416":57669,"_3083":57706},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3632":2146,"_31224":2130,"_21643":57708,"_5":14891,"_28416":57673,"_3083":57709},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3632":2147,"_31224":2130,"_21643":57711,"_5":14891,"_28416":57677,"_3083":57712},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3632":2148,"_31224":2130,"_21643":57714,"_5":14891,"_28416":57681,"_3083":57715},[],"Lamassu persists four X.509 states:",{"_3632":2149,"_31224":2130,"_21643":57717,"_5":14891,"_28416":57681,"_3083":57718},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3632":2150,"_31224":2130,"_21643":57720,"_5":14891,"_28416":57681,"_3083":57721},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3632":2151,"_31224":2130,"_21643":57723,"_5":14891,"_28416":57681,"_3083":57724},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3632":2152,"_31224":2130,"_21643":57726,"_5":14891,"_28416":57681,"_3083":57727},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3632":2153,"_31224":2130,"_21643":57729,"_5":14891,"_28416":57681,"_3083":57730},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3632":2154,"_31224":2130,"_21643":57732,"_5":14891,"_28416":57685,"_3083":57733},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3632":2155,"_31224":2130,"_21643":57735,"_5":14891,"_28416":57685,"_3083":57736},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3632":2156,"_31224":2130,"_21643":57738,"_5":14891,"_28416":57685,"_3083":57739},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3632":2157,"_31224":2130,"_21643":57741,"_5":14891,"_28416":57689,"_3083":57742},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3632":2158,"_31224":2130,"_21643":57744,"_5":14891,"_28416":57689,"_3083":57745},[],"Before confirming:",{"_3632":2159,"_31224":2130,"_21643":57747,"_5":14891,"_28416":57689,"_3083":57748},[],"Identify DMSs, devices and services that trust that chain.",{"_3632":2160,"_31224":2130,"_21643":57750,"_5":14891,"_28416":57689,"_3083":57751},[],"Distribute the new chain of trust.",{"_3632":2161,"_31224":2130,"_21643":57753,"_5":14891,"_28416":57689,"_3083":57754},[],"Reissue the necessary identities.",{"_3632":2162,"_31224":2130,"_21643":57756,"_5":14891,"_28416":57689,"_3083":57757},[],"Check OCSP and CRL from a real consumer.",{"_3632":2163,"_31224":2130,"_21643":57759,"_5":14891,"_28416":57689,"_3083":57760},[],"Revoke the old CA once no legitimate traffic remains.",{"_3632":2164,"_31224":2130,"_21643":57762,"_5":14891,"_28416":57689,"_3083":57763},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3632":2165,"_31224":2130,"_21643":57765,"_5":14891,"_28416":57693,"_3083":57766},[],"Certificates entering the preventive or critical renewal window.",{"_3632":2166,"_31224":2130,"_21643":57768,"_5":14891,"_28416":57693,"_3083":57769},[],"Repeated enrollment or re-enrollment failures.",{"_3632":2167,"_31224":2130,"_21643":57771,"_5":14891,"_28416":57693,"_3083":57772},[],"Status changes and revocation reasons.",{"_3632":2168,"_31224":2130,"_21643":57774,"_5":14891,"_28416":57693,"_3083":57775},[],"OCSP and CRL publication and validity.",{"_3632":2169,"_31224":2130,"_21643":57777,"_5":14891,"_28416":57693,"_3083":57778},[],"Dependencies still presenting a replaced certificate.",{"_3632":2170,"_31224":2130,"_21643":57780,"_5":14891,"_28416":57693,"_3083":57781},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3632":2171,"_31224":2171,"_5":15251,"_3083":57783,"_31583":57784,"_21643":57785,"_28416":2171},"Trust model",[51036,52548,56722,57650],[],{"_3632":2172,"_31224":2171,"_21643":57787,"_5":14891,"_28416":2171,"_3083":57788},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3632":2173,"_31224":2171,"_5":31580,"_21643":57790,"_28416":57791,"_3083":57792},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3632":2174,"_31224":2171,"_5":31580,"_21643":57794,"_28416":57795,"_3083":57796},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3632":2175,"_31224":2171,"_5":31580,"_21643":57798,"_28416":57799,"_3083":57800},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3632":2176,"_31224":2171,"_5":31580,"_21643":57802,"_28416":57803,"_3083":57804},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3632":2177,"_31224":2171,"_5":31580,"_21643":57806,"_28416":57807,"_3083":57808},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3632":2178,"_31224":2171,"_5":31580,"_21643":57810,"_28416":57811,"_3083":57812},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3632":2179,"_31224":2171,"_5":31580,"_21643":57814,"_28416":57815,"_3083":57816},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3632":2180,"_31224":2171,"_5":31580,"_21643":57818,"_28416":57819,"_3083":57820},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3632":2181,"_31224":2171,"_5":31580,"_21643":57822,"_28416":57823,"_3083":57824},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3632":2182,"_31224":2171,"_5":31580,"_21643":57826,"_28416":57827,"_3083":57828},[],"/docs/pr-preview/pr-82/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3632":2183,"_31224":2171,"_21643":57830,"_5":14891,"_28416":2171,"_3083":57831},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3632":2184,"_31224":2171,"_21643":57833,"_5":14891,"_28416":57795,"_3083":57834},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3632":2185,"_31224":2171,"_21643":57836,"_5":14891,"_28416":57799,"_3083":57837},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3632":2186,"_31224":2171,"_21643":57839,"_5":14891,"_28416":57803,"_3083":57840},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3632":2187,"_31224":2171,"_21643":57842,"_5":14891,"_28416":57807,"_3083":57843},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3632":2188,"_31224":2171,"_21643":57845,"_5":14891,"_28416":57811,"_3083":57846},[],"The device proves it can enroll according to the DMS policy.",{"_3632":2189,"_31224":2171,"_21643":57848,"_5":14891,"_28416":57811,"_3083":57849},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3632":2190,"_31224":2171,"_21643":57851,"_5":14891,"_28416":57811,"_3083":57852},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3632":2191,"_31224":2171,"_21643":57854,"_5":14891,"_28416":57811,"_3083":57855},[],"The device installs the certificate and the chain it needs.",{"_3632":2192,"_31224":2171,"_21643":57857,"_5":14891,"_28416":57811,"_3083":57858},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3632":2193,"_31224":2171,"_21643":57860,"_5":14891,"_28416":57811,"_3083":57861},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3632":2194,"_31224":2171,"_21643":57863,"_5":14891,"_28416":57815,"_3083":57864},[],"A DMS relates three sets that are worth designing separately:",{"_3632":2195,"_31224":2171,"_21643":57866,"_5":14891,"_28416":57815,"_3083":57867},[],"**Enrollment CA:** signs the new identities.",{"_3632":2196,"_31224":2171,"_21643":57869,"_5":14891,"_28416":57815,"_3083":57870},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3632":2197,"_31224":2171,"_21643":57872,"_5":14891,"_28416":57815,"_3083":57873},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3632":2198,"_31224":2171,"_21643":57875,"_5":14891,"_28416":57815,"_3083":57876},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3632":2199,"_31224":2171,"_21643":57878,"_5":14891,"_28416":57819,"_3083":57879},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3632":2200,"_31224":2171,"_21643":57881,"_5":14891,"_28416":57819,"_3083":57882},[],"that the current date is between `Not Before` and `Not After`;",{"_3632":2201,"_31224":2171,"_21643":57884,"_5":14891,"_28416":57819,"_3083":57885},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3632":2202,"_31224":2171,"_21643":57887,"_5":14891,"_28416":57819,"_3083":57888},[],"that names, SANs and subject match the expected identity;",{"_3632":2203,"_31224":2171,"_21643":57890,"_5":14891,"_28416":57819,"_3083":57891},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3632":2204,"_31224":2171,"_21643":57893,"_5":14891,"_28416":57819,"_3083":57894},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3632":2205,"_31224":2171,"_21643":57896,"_5":14891,"_28416":57819,"_3083":57897},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3632":2206,"_31224":2171,"_21643":57899,"_5":14891,"_28416":57823,"_3083":57900},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3632":2207,"_31224":2171,"_21643":57902,"_5":14891,"_28416":57827,"_3083":57903},[],"Keep the root out of daily operations, or with very restricted access.",{"_3632":2208,"_31224":2171,"_21643":57905,"_5":14891,"_28416":57827,"_3083":57906},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3632":2209,"_31224":2171,"_21643":57908,"_5":14891,"_28416":57827,"_3083":57909},[],"Assign explicit profiles to every use case.",{"_3632":2210,"_31224":2171,"_21643":57911,"_5":14891,"_28416":57827,"_3083":57912},[],"Distribute the new trust before starting a rotation.",{"_3632":2211,"_31224":2171,"_21643":57914,"_5":14891,"_28416":57827,"_3083":57915},[],"Keep enough overlap to renew a disconnected fleet.",{"_3632":2212,"_31224":2171,"_21643":57917,"_5":14891,"_28416":57827,"_3083":57918},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3632":2213,"_31224":2171,"_21643":57920,"_5":14891,"_28416":57827,"_3083":57921},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3632":2214,"_31224":2214,"_5":15251,"_3083":57923,"_31583":57924,"_21643":57925,"_28416":2214},"Revocation lists (CRL)",[51036,52548,56722,57395],[],{"_3632":2215,"_31224":2214,"_21643":57927,"_5":14891,"_28416":2214,"_3083":57928},[],"Generate and distribute signed lists to validate certificates offline.",{"_3632":2216,"_31224":2214,"_5":31580,"_21643":57930,"_28416":57931,"_3083":57932},[],"/docs/pr-preview/pr-82/platform/pki/crl#crl-settings","CRL settings",{"_3632":2217,"_31224":2214,"_5":31580,"_21643":57934,"_28416":57935,"_3083":57936},[],"/docs/pr-preview/pr-82/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3632":2218,"_31224":2214,"_5":31580,"_21643":57938,"_28416":57939,"_3083":57940},[],"/docs/pr-preview/pr-82/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3632":2219,"_31224":2214,"_5":31580,"_21643":57942,"_28416":57943,"_3083":57944},[],"/docs/pr-preview/pr-82/platform/pki/crl#crl-contents","CRL contents",{"_3632":2220,"_31224":2214,"_5":31580,"_21643":57946,"_28416":57947,"_3083":57948},[],"/docs/pr-preview/pr-82/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3632":2221,"_31224":2214,"_5":31580,"_21643":57950,"_28416":57951,"_3083":57952},[],"/docs/pr-preview/pr-82/platform/pki/crl#crl-settings-api","CRL settings API",{"_3632":2222,"_31224":2214,"_5":31580,"_21643":57954,"_28416":57955,"_3083":57956},[],"/docs/pr-preview/pr-82/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3632":2223,"_31224":2214,"_5":31580,"_21643":57958,"_28416":57959,"_3083":57960},[],"/docs/pr-preview/pr-82/platform/pki/crl#references","References",{"_3632":2224,"_31224":2214,"_21643":57962,"_5":14891,"_28416":2214,"_3083":57963},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3632":2225,"_31224":2214,"_21643":57965,"_5":14891,"_28416":57931,"_3083":57966},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3632":2226,"_31224":2214,"_21643":57968,"_5":14891,"_28416":57931,"_3083":57969},[],"Field",{"_3632":2227,"_31224":2214,"_21643":57971,"_5":14891,"_28416":57931,"_3083":51426},[],{"_3632":2228,"_31224":2214,"_21643":57973,"_5":14891,"_28416":57931,"_3083":52668},[],{"_3632":2229,"_31224":2214,"_21643":57975,"_5":14891,"_28416":57931,"_3083":57976},[],"ID of the CA the settings belong to.",{"_3632":2230,"_31224":2214,"_21643":57978,"_5":14891,"_28416":57931,"_3083":57979},[],"`status`",{"_3632":2231,"_31224":2214,"_21643":57981,"_5":14891,"_28416":57931,"_3083":57982},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3632":2232,"_31224":2214,"_21643":57984,"_5":14891,"_28416":57931,"_3083":57985},[],"`legacy_ski`",{"_3632":2233,"_31224":2214,"_21643":57987,"_5":14891,"_28416":57931,"_3083":57988},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3632":2234,"_31224":2214,"_21643":57990,"_5":14891,"_28416":57931,"_3083":57991},[],"`latest_crl`",{"_3632":2235,"_31224":2214,"_21643":57993,"_5":14891,"_28416":57931,"_3083":57994},[],"Version, validity start and end of the last published list. Read-only.",{"_3632":2236,"_31224":2214,"_21643":57996,"_5":14891,"_28416":57931,"_3083":57997},[],"`crl_options` field",{"_3632":2237,"_31224":2214,"_21643":57999,"_5":14891,"_28416":57931,"_3083":51426},[],{"_3632":2238,"_31224":2214,"_21643":58001,"_5":14891,"_28416":57931,"_3083":58002},[],"Initial value",{"_3632":2239,"_31224":2214,"_21643":58004,"_5":14891,"_28416":57931,"_3083":58005},[],"`validity`",{"_3632":2240,"_31224":2214,"_21643":58007,"_5":14891,"_28416":57931,"_3083":58008},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3632":2241,"_31224":2214,"_21643":58010,"_5":14891,"_28416":57931,"_3083":58011},[],"7 days.",{"_3632":2242,"_31224":2214,"_21643":58013,"_5":14891,"_28416":57931,"_3083":58014},[],"`refresh_interval`",{"_3632":2243,"_31224":2214,"_21643":58016,"_5":14891,"_28416":57931,"_3083":58017},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3632":2244,"_31224":2214,"_21643":58019,"_5":14891,"_28416":57931,"_3083":58020},[],"6 days and 23 hours.",{"_3632":2245,"_31224":2214,"_21643":58022,"_5":14891,"_28416":57931,"_3083":58023},[],"`regenerate_on_revoke`",{"_3632":2246,"_31224":2214,"_21643":58025,"_5":14891,"_28416":57931,"_3083":58026},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3632":2247,"_31224":2214,"_21643":58028,"_5":14891,"_28416":57931,"_3083":58029},[],"`true`.",{"_3632":2248,"_31224":2214,"_21643":58031,"_5":14891,"_28416":57931,"_3083":58032},[],"`signer_serial_number`",{"_3632":2249,"_31224":2214,"_21643":58034,"_5":14891,"_28416":57931,"_3083":58035},[],"Serial number of the existing certificate that signs the CRL.",{"_3632":2250,"_31224":2214,"_21643":58037,"_5":14891,"_28416":57931,"_3083":58038},[],"Serial number of the CA’s current certificate.",{"_3632":2251,"_31224":2214,"_21643":58040,"_5":14891,"_28416":57931,"_3083":58041},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3632":2252,"_31224":2214,"_21643":58043,"_5":14891,"_28416":57931,"_3083":58044},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3632":2253,"_31224":2214,"_21643":58046,"_5":14891,"_28416":57931,"_3083":58047},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3632":2254,"_31224":2214,"_21643":58049,"_5":14891,"_28416":57931,"_3083":58050},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3632":2255,"_31224":2214,"_21643":58052,"_5":14891,"_28416":57931,"_3083":58053},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3632":2256,"_31224":2214,"_21643":58055,"_5":14891,"_28416":57931,"_3083":58056},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3632":2257,"_31224":2214,"_21643":58058,"_5":14891,"_28416":57931,"_3083":58059},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3632":2258,"_31224":2214,"_21643":58061,"_5":14891,"_28416":57931,"_3083":58062},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3632":2259,"_31224":2214,"_21643":58064,"_5":14891,"_28416":57931,"_3083":58065},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3632":2260,"_31224":2214,"_21643":58067,"_5":14891,"_28416":57931,"_3083":58068},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3632":2261,"_31224":2214,"_21643":58070,"_5":14891,"_28416":57931,"_3083":58071},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3632":2262,"_31224":2214,"_21643":58073,"_5":14891,"_28416":57935,"_3083":58074},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3632":2263,"_31224":2214,"_21643":58076,"_5":14891,"_28416":57935,"_3083":58077},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3632":2264,"_31224":2214,"_21643":58079,"_5":14891,"_28416":57935,"_3083":58080},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3632":2265,"_31224":2214,"_21643":58082,"_5":14891,"_28416":57935,"_3083":58083},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3632":2266,"_31224":2214,"_21643":58085,"_5":14891,"_28416":57939,"_3083":58086},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3632":2267,"_31224":2214,"_21643":58088,"_5":14891,"_28416":57939,"_3083":58089},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3632":2268,"_31224":2214,"_21643":58091,"_5":14891,"_28416":57939,"_3083":58092},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3632":2269,"_31224":2214,"_21643":58094,"_5":14891,"_28416":57939,"_3083":58095},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3632":2270,"_31224":2214,"_21643":58097,"_5":14891,"_28416":57939,"_3083":58098},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3632":2271,"_31224":2214,"_21643":58100,"_5":14891,"_28416":57939,"_3083":58101},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3632":2272,"_31224":2214,"_21643":58103,"_5":14891,"_28416":57939,"_3083":58104},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3632":2273,"_31224":2214,"_21643":58106,"_5":14891,"_28416":57939,"_3083":58107},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3632":2274,"_31224":2214,"_21643":58109,"_5":14891,"_28416":57939,"_3083":58110},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3632":2275,"_31224":2214,"_21643":58112,"_5":14891,"_28416":57943,"_3083":58113},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3632":2276,"_31224":2214,"_21643":58115,"_5":14891,"_28416":57943,"_3083":58116},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3632":2277,"_31224":2214,"_21643":58118,"_5":14891,"_28416":57947,"_3083":58119},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3632":2278,"_31224":2214,"_21643":58121,"_5":14891,"_28416":57947,"_3083":58122},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3632":2279,"_31224":2214,"_21643":58124,"_5":14891,"_28416":57947,"_3083":58125},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3632":2280,"_31224":2214,"_21643":58127,"_5":14891,"_28416":57947,"_3083":58128},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3632":2281,"_31224":2214,"_21643":58130,"_5":14891,"_28416":57947,"_3083":58131},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3632":2282,"_31224":2214,"_21643":58133,"_5":14891,"_28416":57951,"_3083":58134},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3632":2283,"_31224":2214,"_21643":58136,"_5":14891,"_28416":57951,"_3083":54488},[],{"_3632":2284,"_31224":2214,"_21643":58138,"_5":14891,"_28416":57951,"_3083":58139},[],"Relative path",{"_3632":2285,"_31224":2214,"_21643":58141,"_5":14891,"_28416":57951,"_3083":54485},[],{"_3632":2286,"_31224":2214,"_21643":58143,"_5":14891,"_28416":57951,"_3083":58144},[],"`GET`",{"_3632":2287,"_31224":2214,"_21643":58146,"_5":14891,"_28416":57951,"_3083":58147},[],"`/v1/crl-settings`",{"_3632":2288,"_31224":2214,"_21643":58149,"_5":14891,"_28416":57951,"_3083":58150},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3632":2289,"_31224":2214,"_21643":58152,"_5":14891,"_28416":57951,"_3083":58144},[],{"_3632":2290,"_31224":2214,"_21643":58154,"_5":14891,"_28416":57951,"_3083":58155},[],"`/v1/crl-settings/{ca-id}`",{"_3632":2291,"_31224":2214,"_21643":58157,"_5":14891,"_28416":57951,"_3083":58158},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3632":2292,"_31224":2214,"_21643":58160,"_5":14891,"_28416":57951,"_3083":58161},[],"`PUT`",{"_3632":2293,"_31224":2214,"_21643":58163,"_5":14891,"_28416":57951,"_3083":58155},[],{"_3632":2294,"_31224":2214,"_21643":58165,"_5":14891,"_28416":57951,"_3083":58166},[],"Replace the CRL configuration of a CA.",{"_3632":2295,"_31224":2214,"_21643":58168,"_5":14891,"_28416":57951,"_3083":58169},[],"`DELETE`",{"_3632":2296,"_31224":2214,"_21643":58171,"_5":14891,"_28416":57951,"_3083":58155},[],{"_3632":2297,"_31224":2214,"_21643":58173,"_5":14891,"_28416":57951,"_3083":58174},[],"Remove the archived CRL settings of a CA.",{"_3632":2298,"_31224":2214,"_21643":58176,"_5":14891,"_28416":57951,"_3083":58177},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3632":2299,"_31224":2214,"_21643":58179,"_5":14891,"_28416":57951,"_3083":58180},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3632":2300,"_31224":2214,"_21643":58182,"_5":14891,"_28416":57951,"_3083":58183},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3632":2301,"_31224":2214,"_21643":58185,"_5":14891,"_28416":57955,"_3083":58186},[],"Symptom",{"_3632":2302,"_31224":2214,"_21643":58188,"_5":14891,"_28416":57955,"_3083":58189},[],"Cause",{"_3632":2303,"_31224":2214,"_21643":58191,"_5":14891,"_28416":57955,"_3083":58192},[],"Action",{"_3632":2304,"_31224":2214,"_21643":58194,"_5":14891,"_28416":57955,"_3083":58195},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3632":2305,"_31224":2214,"_21643":58197,"_5":14891,"_28416":57955,"_3083":58198},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3632":2306,"_31224":2214,"_21643":58200,"_5":14891,"_28416":57955,"_3083":58201},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3632":2307,"_31224":2214,"_21643":58203,"_5":14891,"_28416":57955,"_3083":58204},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3632":2308,"_31224":2214,"_21643":58206,"_5":14891,"_28416":57955,"_3083":58207},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3632":2309,"_31224":2214,"_21643":58209,"_5":14891,"_28416":57955,"_3083":58210},[],"Delete the CA first; deleting it archives its settings.",{"_3632":2310,"_31224":2214,"_21643":58212,"_5":14891,"_28416":57955,"_3083":58213},[],"`PUT` returns 400.",{"_3632":2311,"_31224":2214,"_21643":58215,"_5":14891,"_28416":57955,"_3083":58216},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3632":2312,"_31224":2214,"_21643":58218,"_5":14891,"_28416":57955,"_3083":58219},[],"Set the serial number of a valid certificate of that CA.",{"_3632":2313,"_31224":2214,"_21643":58221,"_5":14891,"_28416":57955,"_3083":58222},[],"`PUT` returns 404.",{"_3632":2314,"_31224":2214,"_21643":58224,"_5":14891,"_28416":57955,"_3083":58225},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3632":2315,"_31224":2214,"_21643":58227,"_5":14891,"_28416":57955,"_3083":58228},[],"Check the CA ID and the signer serial number.",{"_3632":2316,"_31224":2214,"_21643":58230,"_5":14891,"_28416":57955,"_3083":58231},[],"`PUT` returns 400 from a 3.x client.",{"_3632":2317,"_31224":2214,"_21643":58233,"_5":14891,"_28416":57955,"_3083":58234},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3632":2318,"_31224":2214,"_21643":58236,"_5":14891,"_28416":57955,"_3083":58237},[],"Update the client to send the new field.",{"_3632":2319,"_31224":2214,"_21643":58239,"_5":14891,"_28416":57955,"_3083":58240},[],"The CRL does not change after revoking a certificate.",{"_3632":2320,"_31224":2214,"_21643":58242,"_5":14891,"_28416":57955,"_3083":58243},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3632":2321,"_31224":2214,"_21643":58245,"_5":14891,"_28416":57955,"_3083":58246},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3632":2322,"_31224":2214,"_21643":58248,"_5":14891,"_28416":57955,"_3083":58249},[],"A verifier rejects the CRL because of the issuer.",{"_3632":2323,"_31224":2214,"_21643":58251,"_5":14891,"_28416":57955,"_3083":58252},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3632":2324,"_31224":2214,"_21643":58254,"_5":14891,"_28416":57955,"_3083":58255},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3632":2325,"_31224":2214,"_21643":58257,"_5":14891,"_28416":57959,"_3083":58258},[],"RFC 5280: X.509 and CRL profile.",{"_3632":2326,"_31224":2214,"_21643":58260,"_5":14891,"_28416":57959,"_3083":58261},[],"OpenSSL: openssl-crl.",{"_3632":2327,"_31224":2214,"_21643":58263,"_5":14891,"_28416":57959,"_3083":58264},[],"OpenSSL: openssl-verify.",{"_3632":2328,"_31224":2214,"_21643":58266,"_5":14891,"_28416":57959,"_3083":58267},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":2329,"_31224":2214,"_21643":58269,"_5":14891,"_28416":57959,"_3083":58270},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3632":2330,"_31224":2330,"_5":15251,"_3083":58272,"_31583":58273,"_21643":58274,"_28416":2330},"Keys and cryptographic engines",[51036,52548,56722,56723],[],{"_3632":2331,"_31224":2330,"_21643":58276,"_5":14891,"_28416":2330,"_3083":58277},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3632":2332,"_31224":2330,"_5":31580,"_21643":58279,"_28416":58280,"_3083":58281},[],"/docs/pr-preview/pr-82/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3632":2333,"_31224":2330,"_5":31580,"_21643":58283,"_28416":58284,"_3083":58285},[],"/docs/pr-preview/pr-82/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3632":2334,"_31224":2330,"_5":31580,"_21643":58287,"_28416":58288,"_3083":58289},[],"/docs/pr-preview/pr-82/platform/pki/key-management#file-system","File System",{"_3632":2335,"_31224":2330,"_5":31580,"_21643":58291,"_28416":58292,"_3083":58293},[],"/docs/pr-preview/pr-82/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3632":2336,"_31224":2330,"_5":31580,"_21643":58295,"_28416":58296,"_3083":58297},[],"/docs/pr-preview/pr-82/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3632":2337,"_31224":2330,"_5":31580,"_21643":58299,"_28416":58300,"_3083":58301},[],"/docs/pr-preview/pr-82/platform/pki/key-management#aws-kms","AWS KMS",{"_3632":2338,"_31224":2330,"_5":31580,"_21643":58303,"_28416":58304,"_3083":58305},[],"/docs/pr-preview/pr-82/platform/pki/key-management#pkcs11","PKCS#11",{"_3632":2339,"_31224":2330,"_5":31580,"_21643":58307,"_28416":58308,"_3083":58309},[],"/docs/pr-preview/pr-82/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3632":2340,"_31224":2330,"_5":31580,"_21643":58311,"_28416":58312,"_3083":58313},[],"/docs/pr-preview/pr-82/platform/pki/key-management#key-inventory","Key inventory",{"_3632":2341,"_31224":2330,"_5":31580,"_21643":58315,"_28416":58316,"_3083":58317},[],"/docs/pr-preview/pr-82/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3632":2342,"_31224":2330,"_5":31580,"_21643":58319,"_28416":58320,"_3083":58321},[],"/docs/pr-preview/pr-82/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3632":2343,"_31224":2330,"_5":31580,"_21643":58323,"_28416":58324,"_3083":58325},[],"/docs/pr-preview/pr-82/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3632":2344,"_31224":2330,"_5":31580,"_21643":58327,"_28416":58328,"_3083":58329},[],"/docs/pr-preview/pr-82/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3632":2345,"_31224":2330,"_5":31580,"_21643":58331,"_28416":58332,"_3083":58333},[],"/docs/pr-preview/pr-82/platform/pki/key-management#view-details","View details",{"_3632":2346,"_31224":2330,"_5":31580,"_21643":58335,"_28416":58336,"_3083":58337},[],"/docs/pr-preview/pr-82/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3632":2347,"_31224":2330,"_5":31580,"_21643":58339,"_28416":58340,"_3083":58341},[],"/docs/pr-preview/pr-82/platform/pki/key-management#sign","Sign",{"_3632":2348,"_31224":2330,"_5":31580,"_21643":58343,"_28416":58344,"_3083":58345},[],"/docs/pr-preview/pr-82/platform/pki/key-management#verify","Verify",{"_3632":2349,"_31224":2330,"_5":31580,"_21643":58347,"_28416":58348,"_3083":58349},[],"/docs/pr-preview/pr-82/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3632":2350,"_31224":2330,"_5":31580,"_21643":58351,"_28416":58352,"_3083":58353},[],"/docs/pr-preview/pr-82/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3632":2351,"_31224":2330,"_5":31580,"_21643":58355,"_28416":58356,"_3083":58357},[],"/docs/pr-preview/pr-82/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3632":2352,"_31224":2330,"_21643":58359,"_5":14891,"_28416":2330,"_3083":58360},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3632":2353,"_31224":2330,"_21643":58362,"_5":14891,"_28416":2330,"_3083":58363},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3632":2354,"_31224":2330,"_21643":58365,"_5":14891,"_28416":58280,"_3083":58366},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3632":2355,"_31224":2330,"_21643":58368,"_5":14891,"_28416":58280,"_3083":58369},[],"In practice, it lets you:",{"_3632":2356,"_31224":2330,"_21643":58371,"_5":14891,"_28416":58280,"_3083":58372},[],"Generate new key pairs from Lamassu IoT.",{"_3632":2357,"_31224":2330,"_21643":58374,"_5":14891,"_28416":58280,"_3083":58375},[],"Import keys created externally.",{"_3632":2358,"_31224":2330,"_21643":58377,"_5":14891,"_28416":58280,"_3083":58378},[],"Delegate custody and cryptographic operations to external engines.",{"_3632":2359,"_31224":2330,"_21643":58380,"_5":14891,"_28416":58280,"_3083":58381},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3632":2360,"_31224":2330,"_21643":58383,"_5":14891,"_28416":58284,"_3083":58384},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3632":2361,"_31224":2330,"_21643":58386,"_5":14891,"_28416":58284,"_3083":58387},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3632":2362,"_31224":2330,"_21643":58389,"_5":14891,"_28416":58284,"_3083":58390},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3632":2363,"_31224":2330,"_21643":58392,"_5":14891,"_28416":58288,"_3083":58393},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3632":2364,"_31224":2330,"_21643":58395,"_5":14891,"_28416":58292,"_3083":58396},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3632":2365,"_31224":2330,"_21643":58398,"_5":14891,"_28416":58292,"_3083":58399},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3632":2366,"_31224":2330,"_21643":58401,"_5":14891,"_28416":58296,"_3083":58402},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3632":2367,"_31224":2330,"_21643":58404,"_5":14891,"_28416":58300,"_3083":58405},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3632":2368,"_31224":2330,"_21643":58407,"_5":14891,"_28416":58304,"_3083":58408},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3632":2369,"_31224":2330,"_21643":58410,"_5":14891,"_28416":58308,"_3083":58411},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3632":2370,"_31224":2330,"_21643":58413,"_5":14891,"_28416":58308,"_3083":58414},[],"Lamassu shows the enabled engines in the console.",{"_3632":2371,"_31224":2330,"_21643":58416,"_5":14891,"_28416":58308,"_3083":58417},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3632":2372,"_31224":2330,"_21643":58419,"_5":14891,"_28416":58308,"_3083":58420},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3632":2373,"_31224":2330,"_21643":58422,"_5":14891,"_28416":58312,"_3083":58423},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3632":2374,"_31224":2330,"_21643":58425,"_5":14891,"_28416":58312,"_3083":58426},[],"The table includes the following fields:",{"_3632":2375,"_31224":2330,"_21643":58428,"_5":14891,"_28416":58312,"_3083":58429},[],"**Name**: descriptive name of the key.",{"_3632":2376,"_31224":2330,"_21643":58431,"_5":14891,"_28416":58312,"_3083":58432},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3632":2377,"_31224":2330,"_21643":58434,"_5":14891,"_28416":58312,"_3083":58435},[],"**Strength**: visual indicator of cryptographic strength.",{"_3632":2378,"_31224":2330,"_21643":58437,"_5":14891,"_28416":58312,"_3083":58438},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3632":2379,"_31224":2330,"_21643":58440,"_5":14891,"_28416":58312,"_3083":58441},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3632":2380,"_31224":2330,"_21643":58443,"_5":14891,"_28416":58312,"_3083":58444},[],"**Aliases**: alternative names associated with the key.",{"_3632":2381,"_31224":2330,"_21643":58446,"_5":14891,"_28416":58312,"_3083":58447},[],"**Tags**: labels for classification and search.",{"_3632":2382,"_31224":2330,"_21643":58449,"_5":14891,"_28416":58312,"_3083":58450},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3632":2383,"_31224":2330,"_21643":58452,"_5":14891,"_28416":58312,"_3083":58453},[],"From this view you also reach the most common actions:",{"_3632":2384,"_31224":2330,"_21643":58455,"_5":14891,"_28416":58312,"_3083":58456},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3632":2385,"_31224":2330,"_21643":58458,"_5":14891,"_28416":58312,"_3083":58459},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3632":2386,"_31224":2330,"_21643":58461,"_5":14891,"_28416":58312,"_3083":58462},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3632":2387,"_31224":2330,"_21643":58464,"_5":14891,"_28416":58312,"_3083":58465},[],"**Delete Key** to remove the key from the system.",{"_3632":2388,"_31224":2330,"_21643":58467,"_5":14891,"_28416":58316,"_3083":58468},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3632":2389,"_31224":2330,"_21643":58470,"_5":14891,"_28416":58320,"_3083":58471},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3632":2390,"_31224":2330,"_21643":58473,"_5":14891,"_28416":58320,"_3083":58474},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3632":2391,"_31224":2330,"_21643":58476,"_5":14891,"_28416":58320,"_3083":58477},[],"**Key Name**: unique and descriptive name.",{"_3632":2392,"_31224":2330,"_21643":58479,"_5":14891,"_28416":58320,"_3083":58480},[],"**Crypto Engine**: engine that will keep the key.",{"_3632":2393,"_31224":2330,"_21643":58482,"_5":14891,"_28416":58320,"_3083":58483},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3632":2394,"_31224":2330,"_21643":58485,"_5":14891,"_28416":58320,"_3083":58486},[],"**Tags**: metadata to classify the key.",{"_3632":2395,"_31224":2330,"_21643":58488,"_5":14891,"_28416":58320,"_3083":58489},[],"**Metadata**: additional information for advanced uses.",{"_3632":2396,"_31224":2330,"_21643":58491,"_5":14891,"_28416":58324,"_3083":58492},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3632":2397,"_31224":2330,"_21643":58494,"_5":14891,"_28416":58324,"_3083":58495},[],"When you have an exportable private key and the destination engine supports import.",{"_3632":2398,"_31224":2330,"_21643":58497,"_5":14891,"_28416":58324,"_3083":58498},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3632":2399,"_31224":2330,"_21643":58500,"_5":14891,"_28416":58324,"_3083":58501},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3632":2400,"_31224":2330,"_21643":58503,"_5":14891,"_28416":58324,"_3083":58504},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3632":2401,"_31224":2330,"_21643":58506,"_5":14891,"_28416":58324,"_3083":58507},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3632":2402,"_31224":2330,"_21643":58509,"_5":14891,"_28416":58324,"_3083":58510},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3632":2403,"_31224":2330,"_21643":58512,"_5":14891,"_28416":58324,"_3083":58513},[],"**Tags**: labels for organization and search.",{"_3632":2404,"_31224":2330,"_21643":58515,"_5":14891,"_28416":58324,"_3083":58516},[],"**Metadata**: additional optional information.",{"_3632":2405,"_31224":2330,"_21643":58518,"_5":14891,"_28416":58324,"_3083":58519},[],"**Private Key (PEM)**: private key in PEM format.",{"_3632":2406,"_31224":2330,"_21643":58521,"_5":14891,"_28416":58324,"_3083":58522},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3632":2407,"_31224":2330,"_21643":58524,"_5":14891,"_28416":58328,"_3083":58525},[],"Each registered key has a detail view and several operational actions.",{"_3632":2408,"_31224":2330,"_21643":58527,"_5":14891,"_28416":58332,"_3083":58528},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3632":2409,"_31224":2330,"_21643":58530,"_5":14891,"_28416":58332,"_3083":58531},[],"The **Overview** tab shows, among others, these fields:",{"_3632":2410,"_31224":2330,"_21643":58533,"_5":14891,"_28416":58332,"_3083":58534},[],"**Key Name**: descriptive name.",{"_3632":2411,"_31224":2330,"_21643":58536,"_5":14891,"_28416":58332,"_3083":58537},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3632":2412,"_31224":2330,"_21643":58539,"_5":14891,"_28416":58332,"_3083":58540},[],"**Tags**: associated labels.",{"_3632":2413,"_31224":2330,"_21643":58542,"_5":14891,"_28416":58332,"_3083":58543},[],"**Aliases**: alternative names.",{"_3632":2414,"_31224":2330,"_21643":58545,"_5":14891,"_28416":58332,"_3083":58546},[],"**Crypto Engine**: engine where the key resides.",{"_3632":2415,"_31224":2330,"_21643":58548,"_5":14891,"_28416":58332,"_3083":58549},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3632":2416,"_31224":2330,"_21643":58551,"_5":14891,"_28416":58332,"_3083":58552},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3632":2417,"_31224":2330,"_21643":58554,"_5":14891,"_28416":58332,"_3083":58555},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3632":2418,"_31224":2330,"_21643":58557,"_5":14891,"_28416":58336,"_3083":58558},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3632":2419,"_31224":2330,"_21643":58560,"_5":14891,"_28416":58336,"_3083":58561},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3632":2420,"_31224":2330,"_21643":58563,"_5":14891,"_28416":58336,"_3083":58564},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3632":2421,"_31224":2330,"_21643":58566,"_5":14891,"_28416":58340,"_3083":58567},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3632":2422,"_31224":2330,"_21643":58569,"_5":14891,"_28416":58340,"_3083":58570},[],"Main fields:",{"_3632":2423,"_31224":2330,"_21643":58572,"_5":14891,"_28416":58340,"_3083":58573},[],"**Algorithm**: signing algorithm available for the key type.",{"_3632":2424,"_31224":2330,"_21643":58575,"_5":14891,"_28416":58340,"_3083":58576},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3632":2425,"_31224":2330,"_21643":58578,"_5":14891,"_28416":58340,"_3083":58579},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3632":2426,"_31224":2330,"_21643":58581,"_5":14891,"_28416":58340,"_3083":58582},[],"**Message**: content to sign.",{"_3632":2427,"_31224":2330,"_21643":58584,"_5":14891,"_28416":58340,"_3083":58585},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3632":2428,"_31224":2330,"_21643":58587,"_5":14891,"_28416":58344,"_3083":58588},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3632":2429,"_31224":2330,"_21643":58590,"_5":14891,"_28416":58344,"_3083":58570},[],{"_3632":2430,"_31224":2330,"_21643":58592,"_5":14891,"_28416":58344,"_3083":58593},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3632":2431,"_31224":2330,"_21643":58595,"_5":14891,"_28416":58344,"_3083":58596},[],"**Message Type**: `Raw` or `Digest`.",{"_3632":2432,"_31224":2330,"_21643":58598,"_5":14891,"_28416":58344,"_3083":58599},[],"**Payload Encoding**: encoding of the message.",{"_3632":2433,"_31224":2330,"_21643":58601,"_5":14891,"_28416":58344,"_3083":58602},[],"**Message**: original message or hash.",{"_3632":2434,"_31224":2330,"_21643":58604,"_5":14891,"_28416":58344,"_3083":58605},[],"**Signature**: signature to check.",{"_3632":2435,"_31224":2330,"_21643":58607,"_5":14891,"_28416":58344,"_3083":58608},[],"**Result**: indicator of the validation result.",{"_3632":2436,"_31224":2330,"_21643":58610,"_5":14891,"_28416":58348,"_3083":58611},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3632":2437,"_31224":2330,"_21643":58613,"_5":14891,"_28416":58348,"_3083":58614},[],"This flow is useful for:",{"_3632":2438,"_31224":2330,"_21643":58616,"_5":14891,"_28416":58348,"_3083":58617},[],"Requesting certificates from an external CA.",{"_3632":2439,"_31224":2330,"_21643":58619,"_5":14891,"_28416":58348,"_3083":58620},[],"Renewing an identity while keeping the same key.",{"_3632":2440,"_31224":2330,"_21643":58622,"_5":14891,"_28416":58348,"_3083":58623},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3632":2441,"_31224":2330,"_21643":58625,"_5":14891,"_28416":58348,"_3083":58626},[],"**Common Name (CN)**: main name of the identity.",{"_3632":2442,"_31224":2330,"_21643":58628,"_5":14891,"_28416":58348,"_3083":58629},[],"**Organization (O)**: organization or company.",{"_3632":2443,"_31224":2330,"_21643":58631,"_5":14891,"_28416":58348,"_3083":58632},[],"**Organizational Unit (OU)**: department or unit.",{"_3632":2444,"_31224":2330,"_21643":58634,"_5":14891,"_28416":58348,"_3083":58635},[],"**Country (C)**: two-letter country code.",{"_3632":2445,"_31224":2330,"_21643":58637,"_5":14891,"_28416":58348,"_3083":58638},[],"**State / Province (ST)**: state or province.",{"_3632":2446,"_31224":2330,"_21643":58640,"_5":14891,"_28416":58348,"_3083":58641},[],"**Locality (L)**: city or locality.",{"_3632":2447,"_31224":2330,"_21643":58643,"_5":14891,"_28416":58348,"_3083":58644},[],"**Email Address**: contact email.",{"_3632":2448,"_31224":2330,"_21643":58646,"_5":14891,"_28416":58348,"_3083":58647},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3632":2449,"_31224":2330,"_21643":58649,"_5":14891,"_28416":58348,"_3083":58650},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3632":2450,"_31224":2330,"_21643":58652,"_5":14891,"_28416":58352,"_3083":58653},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3632":2451,"_31224":2330,"_21643":58655,"_5":14891,"_28416":58352,"_3083":58656},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3632":2452,"_31224":2330,"_21643":58658,"_5":14891,"_28416":58356,"_3083":58659},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3632":2453,"_31224":2330,"_21643":58661,"_5":14891,"_28416":58356,"_3083":58662},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3632":2454,"_31224":2454,"_5":15251,"_3083":58664,"_31583":58665,"_21643":58666,"_28416":2454},"Online validation with OCSP",[51036,52548,56722,57395],[],{"_3632":2455,"_31224":2454,"_21643":58668,"_5":14891,"_28416":2454,"_3083":58669},[],"Query signed status and verify the responder’s response.",{"_3632":2456,"_31224":2454,"_5":31580,"_21643":58671,"_28416":58672,"_3083":58673},[],"/docs/pr-preview/pr-82/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3632":2457,"_31224":2454,"_5":31580,"_21643":58675,"_28416":58676,"_3083":58677},[],"/docs/pr-preview/pr-82/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3632":2458,"_31224":2454,"_5":31580,"_21643":58679,"_28416":58680,"_3083":58681},[],"/docs/pr-preview/pr-82/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3632":2459,"_31224":2454,"_5":31580,"_21643":58683,"_28416":58684,"_3083":58685},[],"/docs/pr-preview/pr-82/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3632":2460,"_31224":2454,"_5":31580,"_21643":58687,"_28416":58688,"_3083":58689},[],"/docs/pr-preview/pr-82/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3632":2461,"_31224":2454,"_5":31580,"_21643":58691,"_28416":58692,"_3083":57960},[],"/docs/pr-preview/pr-82/platform/pki/ocsp#references",{"_3632":2462,"_31224":2454,"_21643":58694,"_5":14891,"_28416":2454,"_3083":58695},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3632":2463,"_31224":2454,"_21643":58697,"_5":14891,"_28416":58672,"_3083":58698},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3632":2464,"_31224":2454,"_21643":58700,"_5":14891,"_28416":58672,"_3083":58701},[],"Record status",{"_3632":2465,"_31224":2454,"_21643":58703,"_5":14891,"_28416":58672,"_3083":58704},[],"Signed response",{"_3632":2466,"_31224":2454,"_21643":58706,"_5":14891,"_28416":58672,"_3083":55859},[],{"_3632":2467,"_31224":2454,"_21643":58708,"_5":14891,"_28416":58672,"_3083":58709},[],"`Good`.",{"_3632":2468,"_31224":2454,"_21643":58711,"_5":14891,"_28416":58672,"_3083":55876},[],{"_3632":2469,"_31224":2454,"_21643":58713,"_5":14891,"_28416":58672,"_3083":58714},[],"`Revoked`, with revocation reason and timestamp.",{"_3632":2470,"_31224":2454,"_21643":58716,"_5":14891,"_28416":58672,"_3083":58717},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3632":2471,"_31224":2454,"_21643":58719,"_5":14891,"_28416":58672,"_3083":58720},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3632":2472,"_31224":2454,"_21643":58722,"_5":14891,"_28416":58672,"_3083":58723},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3632":2473,"_31224":2454,"_21643":58725,"_5":14891,"_28416":58672,"_3083":58726},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3632":2474,"_31224":2454,"_21643":58728,"_5":14891,"_28416":58672,"_3083":58729},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3632":2475,"_31224":2454,"_21643":58731,"_5":14891,"_28416":58676,"_3083":58732},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3632":2476,"_31224":2454,"_21643":58734,"_5":14891,"_28416":58676,"_3083":58735},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3632":2477,"_31224":2454,"_21643":58737,"_5":14891,"_28416":58680,"_3083":58738},[],"The service accepts:",{"_3632":2478,"_31224":2454,"_21643":58740,"_5":14891,"_28416":58680,"_3083":54488},[],{"_3632":2479,"_31224":2454,"_21643":58742,"_5":14891,"_28416":58680,"_3083":58743},[],"VA service path",{"_3632":2480,"_31224":2454,"_21643":58745,"_5":14891,"_28416":58680,"_3083":58746},[],"Format",{"_3632":2481,"_31224":2454,"_21643":58748,"_5":14891,"_28416":58680,"_3083":58749},[],"`POST`",{"_3632":2482,"_31224":2454,"_21643":58751,"_5":14891,"_28416":58680,"_3083":58752},[],"`/ocsp`",{"_3632":2483,"_31224":2454,"_21643":58754,"_5":14891,"_28416":58680,"_3083":58755},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3632":2484,"_31224":2454,"_21643":58757,"_5":14891,"_28416":58680,"_3083":58144},[],{"_3632":2485,"_31224":2454,"_21643":58759,"_5":14891,"_28416":58680,"_3083":58760},[],"`/ocsp/{ocsp_request}`",{"_3632":2486,"_31224":2454,"_21643":58762,"_5":14891,"_28416":58680,"_3083":58763},[],"DER request encoded using padded URL Base64.",{"_3632":2487,"_31224":2454,"_21643":58765,"_5":14891,"_28416":58680,"_3083":58766},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3632":2488,"_31224":2454,"_21643":58768,"_5":14891,"_28416":58684,"_3083":58769},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3632":2489,"_31224":2454,"_21643":58771,"_5":14891,"_28416":58684,"_3083":58772},[],"Generate the request:",{"_3632":2490,"_31224":2454,"_21643":58774,"_5":14891,"_28416":58684,"_3083":58775},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3632":2491,"_31224":2454,"_21643":58777,"_5":14891,"_28416":58684,"_3083":58778},[],"Replace the example URL with the inspected endpoint:",{"_3632":2492,"_31224":2454,"_21643":58780,"_5":14891,"_28416":58684,"_3083":58781},[],"Verify the returned DER:",{"_3632":2493,"_31224":2454,"_21643":58783,"_5":14891,"_28416":58684,"_3083":58784},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3632":2494,"_31224":2454,"_21643":58786,"_5":14891,"_28416":58688,"_3083":58787},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3632":2495,"_31224":2454,"_21643":58789,"_5":14891,"_28416":58688,"_3083":58790},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3632":2496,"_31224":2454,"_21643":58792,"_5":14891,"_28416":58692,"_3083":58793},[],"RFC 6960: OCSP.",{"_3632":2497,"_31224":2454,"_21643":58795,"_5":14891,"_28416":58692,"_3083":58796},[],"OpenSSL: openssl-ocsp.",{"_3632":2498,"_31224":2454,"_21643":58798,"_5":14891,"_28416":58692,"_3083":58799},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3632":2499,"_31224":2454,"_21643":58801,"_5":14891,"_28416":58692,"_3083":58270},[],{"_3632":2500,"_31224":2500,"_5":15251,"_3083":56722,"_31583":58803,"_21643":58804,"_28416":2500},[51036,52548,56722],[],{"_3632":2501,"_31224":2500,"_21643":58806,"_5":14891,"_28416":2500,"_3083":58807},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3632":2502,"_31224":2500,"_5":31580,"_21643":58809,"_28416":58810,"_3083":56034},[],"/docs/pr-preview/pr-82/platform/pki/overview#start-here",{"_3632":2503,"_31224":2500,"_5":31580,"_21643":58812,"_28416":58813,"_3083":58814},[],"/docs/pr-preview/pr-82/platform/pki/overview#what-you-need","What you need",{"_3632":2504,"_31224":2500,"_5":31580,"_21643":58816,"_28416":58817,"_3083":56566},[],"/docs/pr-preview/pr-82/platform/pki/overview#core-capabilities",{"_3632":2505,"_31224":2500,"_5":31580,"_21643":58819,"_28416":58820,"_3083":56570},[],"/docs/pr-preview/pr-82/platform/pki/overview#build-your-trust-hierarchy",{"_3632":2506,"_31224":2500,"_5":31580,"_21643":58822,"_28416":58823,"_3083":56574},[],"/docs/pr-preview/pr-82/platform/pki/overview#protect-cryptographic-keys",{"_3632":2507,"_31224":2500,"_5":31580,"_21643":58825,"_28416":58826,"_3083":56578},[],"/docs/pr-preview/pr-82/platform/pki/overview#issue-and-control-certificates",{"_3632":2508,"_31224":2500,"_5":31580,"_21643":58828,"_28416":58829,"_3083":56586},[],"/docs/pr-preview/pr-82/platform/pki/overview#publish-validation-status",{"_3632":2509,"_31224":2500,"_5":31580,"_21643":58831,"_28416":58832,"_3083":58833},[],"/docs/pr-preview/pr-82/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3632":2510,"_31224":2500,"_5":31580,"_21643":58835,"_28416":58836,"_3083":57562},[],"/docs/pr-preview/pr-82/platform/pki/overview#continue",{"_3632":2511,"_31224":2500,"_21643":58838,"_5":14891,"_28416":2500,"_3083":58839},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3632":2512,"_31224":2500,"_21643":58841,"_5":14891,"_28416":58810,"_3083":58842},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3632":2513,"_31224":2500,"_21643":58844,"_5":14891,"_28416":58810,"_3083":58845},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3632":2514,"_31224":2500,"_21643":58847,"_5":14891,"_28416":58813,"_3083":58848},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3632":2515,"_31224":2500,"_21643":58850,"_5":14891,"_28416":58813,"_3083":58851},[],"An available cryptographic engine to keep the authority's key.",{"_3632":2516,"_31224":2500,"_21643":58853,"_5":14891,"_28416":58813,"_3083":58854},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3632":2517,"_31224":2500,"_21643":58856,"_5":14891,"_28416":58813,"_3083":58857},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3632":2518,"_31224":2500,"_21643":58859,"_5":14891,"_28416":58813,"_3083":58860},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3632":2519,"_31224":2500,"_21643":58862,"_5":14891,"_28416":58820,"_3083":58863},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3632":2520,"_31224":2500,"_21643":58865,"_5":14891,"_28416":58823,"_3083":58866},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3632":2521,"_31224":2500,"_21643":58868,"_5":14891,"_28416":58826,"_3083":58869},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3632":2522,"_31224":2500,"_21643":58871,"_5":14891,"_28416":58829,"_3083":58872},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3632":2523,"_31224":2500,"_21643":58874,"_5":14891,"_28416":58832,"_3083":58875},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3632":2524,"_31224":2500,"_21643":58877,"_5":14891,"_28416":58832,"_3083":58878},[],"its subject and extensions identify the expected client;",{"_3632":2525,"_31224":2500,"_21643":58880,"_5":14891,"_28416":58832,"_3083":58881},[],"its public key matches the client's private key;",{"_3632":2526,"_31224":2500,"_21643":58883,"_5":14891,"_28416":58832,"_3083":58884},[],"its chain reaches a root trusted by the consumer;",{"_3632":2527,"_31224":2500,"_21643":58886,"_5":14891,"_28416":58832,"_3083":58887},[],"its dates and usages allow the operation;",{"_3632":2528,"_31224":2500,"_21643":58889,"_5":14891,"_28416":58832,"_3083":58890},[],"the consumer applies revocation checks and authorization.",{"_3632":2529,"_31224":2500,"_21643":58892,"_5":14891,"_28416":58832,"_3083":58893},[],"The issuance path includes the first independent checks.",{"_3632":2530,"_31224":2500,"_21643":58895,"_5":14891,"_28416":58836,"_3083":58896},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":2531,"_31224":2500,"_21643":58898,"_5":14891,"_28416":58836,"_3083":58899},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3632":2532,"_31224":2500,"_21643":58901,"_5":14891,"_28416":58836,"_3083":58902},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3632":2533,"_31224":2533,"_5":15251,"_3083":58904,"_31583":58905,"_21643":58906,"_28416":2533},"Create your first CA",[51036,52548,56722,56159],[],{"_3632":2534,"_31224":2533,"_21643":58908,"_5":14891,"_28416":2533,"_3083":58909},[],"Create an evaluation root and check its certificate before issuing.",{"_3632":2535,"_31224":2533,"_5":31580,"_21643":58911,"_28416":58912,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3632":2536,"_31224":2533,"_5":31580,"_21643":58914,"_28416":58915,"_3083":58916},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3632":2537,"_31224":2533,"_5":31580,"_21643":58918,"_28416":58919,"_3083":58920},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3632":2538,"_31224":2533,"_5":31580,"_21643":58922,"_28416":58923,"_3083":58924},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3632":2539,"_31224":2533,"_5":31580,"_21643":58926,"_28416":58927,"_3083":58928},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3632":2540,"_31224":2533,"_5":31580,"_21643":58930,"_28416":58931,"_3083":58932},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3632":2541,"_31224":2533,"_5":31580,"_21643":58934,"_28416":58935,"_3083":58936},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3632":2542,"_31224":2533,"_5":31580,"_21643":58938,"_28416":58939,"_3083":56416},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3632":2543,"_31224":2533,"_5":31580,"_21643":58941,"_28416":58942,"_3083":51070},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3632":2544,"_31224":2533,"_21643":58944,"_5":14891,"_28416":2533,"_3083":58945},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3632":2545,"_31224":2533,"_21643":58947,"_5":14891,"_28416":58912,"_3083":58948},[],"Console access and permission to create keys and authorities.",{"_3632":2546,"_31224":2533,"_21643":58950,"_5":14891,"_28416":58912,"_3083":58951},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3632":2547,"_31224":2533,"_21643":58953,"_5":14891,"_28416":58912,"_3083":58954},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3632":2548,"_31224":2533,"_21643":58956,"_5":14891,"_28416":58912,"_3083":58957},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3632":2549,"_31224":2533,"_21643":58959,"_5":14891,"_28416":58915,"_3083":58960},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3632":2550,"_31224":2533,"_21643":58962,"_5":14891,"_28416":58915,"_3083":58963},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3632":2551,"_31224":2533,"_21643":58965,"_5":14891,"_28416":58919,"_3083":58966},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3632":2552,"_31224":2533,"_21643":58968,"_5":14891,"_28416":58919,"_3083":58969},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3632":2553,"_31224":2533,"_21643":58971,"_5":14891,"_28416":58923,"_3083":58972},[],"Select **Root CA** and complete:",{"_3632":2554,"_31224":2533,"_21643":58974,"_5":14891,"_28416":58923,"_3083":58975},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3632":2555,"_31224":2533,"_21643":58977,"_5":14891,"_28416":58923,"_3083":58978},[],"**Subject**: organization and country details for your evaluation.",{"_3632":2556,"_31224":2533,"_21643":58980,"_5":14891,"_28416":58923,"_3083":58981},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3632":2557,"_31224":2533,"_21643":58983,"_5":14891,"_28416":58923,"_3083":58984},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3632":2558,"_31224":2533,"_21643":58986,"_5":14891,"_28416":58923,"_3083":58987},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3632":2559,"_31224":2533,"_21643":58989,"_5":14891,"_28416":58927,"_3083":58990},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3632":2560,"_31224":2533,"_21643":58992,"_5":14891,"_28416":58931,"_3083":58993},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3632":2561,"_31224":2533,"_21643":58995,"_5":14891,"_28416":58931,"_3083":58996},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3632":2562,"_31224":2533,"_21643":58998,"_5":14891,"_28416":58935,"_3083":58999},[],"Run from the directory where you saved `ca.pem`:",{"_3632":2563,"_31224":2533,"_21643":59001,"_5":14891,"_28416":58935,"_3083":59002},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3632":2564,"_31224":2533,"_21643":59004,"_5":14891,"_28416":58935,"_3083":59005},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3632":2565,"_31224":2533,"_21643":59007,"_5":14891,"_28416":58939,"_3083":59008},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3632":2566,"_31224":2533,"_21643":59010,"_5":14891,"_28416":58939,"_3083":59011},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3632":2567,"_31224":2533,"_21643":59013,"_5":14891,"_28416":58939,"_3083":59014},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3632":2568,"_31224":2533,"_21643":59016,"_5":14891,"_28416":58939,"_3083":59017},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3632":2569,"_31224":2533,"_21643":59019,"_5":14891,"_28416":58942,"_3083":59020},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3632":2570,"_31224":2570,"_5":15251,"_3083":59022,"_31583":59023,"_21643":59024,"_28416":2570},"Issue and verify a certificate",[51036,52548,56722,56159],[],{"_3632":2571,"_31224":2570,"_21643":59026,"_5":14891,"_28416":2570,"_3083":59027},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3632":2572,"_31224":2570,"_5":31580,"_21643":59029,"_28416":59030,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3632":2573,"_31224":2570,"_5":31580,"_21643":59032,"_28416":59033,"_3083":59034},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3632":2574,"_31224":2570,"_5":31580,"_21643":59036,"_28416":59037,"_3083":59038},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3632":2575,"_31224":2570,"_5":31580,"_21643":59040,"_28416":59041,"_3083":59042},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3632":2576,"_31224":2570,"_5":31580,"_21643":59044,"_28416":59045,"_3083":59046},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3632":2577,"_31224":2570,"_5":31580,"_21643":59048,"_28416":59049,"_3083":59050},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3632":2578,"_31224":2570,"_5":31580,"_21643":59052,"_28416":59053,"_3083":59054},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3632":2579,"_31224":2570,"_5":31580,"_21643":59056,"_28416":59057,"_3083":59058},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3632":2580,"_31224":2570,"_5":31580,"_21643":59060,"_28416":59061,"_3083":59062},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3632":2581,"_31224":2570,"_5":31580,"_21643":59064,"_28416":59065,"_3083":59066},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3632":2582,"_31224":2570,"_5":31580,"_21643":59068,"_28416":59069,"_3083":56416},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3632":2583,"_31224":2570,"_5":31580,"_21643":59071,"_28416":59072,"_3083":51070},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/issue-certificate#next-step",{"_3632":2584,"_31224":2570,"_21643":59074,"_5":14891,"_28416":2570,"_3083":59075},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3632":2585,"_31224":2570,"_21643":59077,"_5":14891,"_28416":59030,"_3083":59078},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3632":2586,"_31224":2570,"_21643":59080,"_5":14891,"_28416":59030,"_3083":59081},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3632":2587,"_31224":2570,"_21643":59083,"_5":14891,"_28416":59030,"_3083":59084},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3632":2588,"_31224":2570,"_21643":59086,"_5":14891,"_28416":59030,"_3083":59087},[],"A client identifier: here we use `device-001`.",{"_3632":2589,"_31224":2570,"_21643":59089,"_5":14891,"_28416":59030,"_3083":59090},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3632":2590,"_31224":2570,"_21643":59092,"_5":14891,"_28416":59033,"_3083":59093},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3632":2591,"_31224":2570,"_21643":59095,"_5":14891,"_28416":59037,"_3083":59096},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3632":2592,"_31224":2570,"_21643":59098,"_5":14891,"_28416":59037,"_3083":59099},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3632":2593,"_31224":2570,"_21643":59101,"_5":14891,"_28416":59041,"_3083":59102},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3632":2594,"_31224":2570,"_21643":59104,"_5":14891,"_28416":59041,"_3083":59105},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3632":2595,"_31224":2570,"_21643":59107,"_5":14891,"_28416":59045,"_3083":59108},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3632":2596,"_31224":2570,"_21643":59110,"_5":14891,"_28416":59045,"_3083":59111},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3632":2597,"_31224":2570,"_21643":59113,"_5":14891,"_28416":59049,"_3083":59114},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3632":2598,"_31224":2570,"_21643":59116,"_5":14891,"_28416":59053,"_3083":59117},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3632":2599,"_31224":2570,"_21643":59119,"_5":14891,"_28416":59057,"_3083":59120},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3632":2600,"_31224":2570,"_21643":59122,"_5":14891,"_28416":59061,"_3083":59123},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3632":2601,"_31224":2570,"_21643":59125,"_5":14891,"_28416":59061,"_3083":59126},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3632":2602,"_31224":2570,"_21643":59128,"_5":14891,"_28416":59061,"_3083":59129},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3632":2603,"_31224":2570,"_21643":59131,"_5":14891,"_28416":59065,"_3083":59132},[],"In Bash, compare the two public-key digests:",{"_3632":2604,"_31224":2570,"_21643":59134,"_5":14891,"_28416":59065,"_3083":59135},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3632":2605,"_31224":2570,"_21643":59137,"_5":14891,"_28416":59065,"_3083":59138},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3632":2606,"_31224":2570,"_21643":59140,"_5":14891,"_28416":59069,"_3083":56500},[],{"_3632":2607,"_31224":2570,"_21643":59142,"_5":14891,"_28416":59069,"_3083":59143},[],"What to review",{"_3632":2608,"_31224":2570,"_21643":59145,"_5":14891,"_28416":59069,"_3083":59146},[],"The CA rejects issuance",{"_3632":2609,"_31224":2570,"_21643":59148,"_5":14891,"_28416":59069,"_3083":59149},[],"Permissions, CA state and key, algorithm and profile.",{"_3632":2610,"_31224":2570,"_21643":59151,"_5":14891,"_28416":59069,"_3083":59152},[],"Different subject or usages",{"_3632":2611,"_31224":2570,"_21643":59154,"_5":14891,"_28416":59069,"_3083":59155},[],"Applied profile and requested values.",{"_3632":2612,"_31224":2570,"_21643":59157,"_5":14891,"_28416":59069,"_3083":59158},[],"Issuer cannot be found",{"_3632":2613,"_31224":2570,"_21643":59160,"_5":14891,"_28416":59069,"_3083":59161},[],"Downloaded CA and required intermediate chain.",{"_3632":2614,"_31224":2570,"_21643":59163,"_5":14891,"_28416":59069,"_3083":59164},[],"Validity fails",{"_3632":2615,"_31224":2570,"_21643":59166,"_5":14891,"_28416":59069,"_3083":59167},[],"Certificate and CA dates, and the computer's clock.",{"_3632":2616,"_31224":2570,"_21643":59169,"_5":14891,"_28416":59069,"_3083":59170},[],"Public-key digests differ",{"_3632":2617,"_31224":2570,"_21643":59172,"_5":14891,"_28416":59069,"_3083":59173},[],"Certificate and key files from the same issuance.",{"_3632":2618,"_31224":2570,"_21643":59175,"_5":14891,"_28416":59069,"_3083":59176},[],"See PKI diagnostics to narrow an issuance failure.",{"_3632":2619,"_31224":2570,"_21643":59178,"_5":14891,"_28416":59072,"_3083":59179},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3632":2620,"_31224":2570,"_21643":59181,"_5":14891,"_28416":59072,"_3083":59182},[],"Manage certificates for inspection, status and revocation.",{"_3632":2621,"_31224":2570,"_21643":59184,"_5":14891,"_28416":59072,"_3083":59185},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3632":2622,"_31224":2570,"_21643":59187,"_5":14891,"_28416":59072,"_3083":59188},[],"Prepare EST for the device to request its next identities.",{"_3632":2623,"_31224":2570,"_21643":59190,"_5":14891,"_28416":59072,"_3083":59191},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3632":2624,"_31224":2624,"_5":15251,"_3083":59193,"_31583":59194,"_21643":59195,"_28416":2624},"PKI getting started",[51036,52548,56722,56159],[],{"_3632":2625,"_31224":2624,"_21643":59197,"_5":14891,"_28416":2624,"_3083":59198},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3632":2626,"_31224":2624,"_5":31580,"_21643":59200,"_28416":59201,"_3083":51046},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/overview#before-you-begin",{"_3632":2627,"_31224":2624,"_5":31580,"_21643":59203,"_28416":59204,"_3083":59205},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3632":2628,"_31224":2624,"_5":31580,"_21643":59207,"_28416":59208,"_3083":56351},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/overview#expected-result",{"_3632":2629,"_31224":2624,"_5":31580,"_21643":59210,"_28416":59211,"_3083":59212},[],"/docs/pr-preview/pr-82/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3632":2630,"_31224":2624,"_21643":59214,"_5":14891,"_28416":2624,"_3083":59215},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3632":2631,"_31224":2624,"_21643":59217,"_5":14891,"_28416":59201,"_3083":59218},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3632":2632,"_31224":2624,"_21643":59220,"_5":14891,"_28416":59201,"_3083":59221},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3632":2633,"_31224":2624,"_21643":59223,"_5":14891,"_28416":59201,"_3083":59224},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3632":2634,"_31224":2624,"_21643":59226,"_5":14891,"_28416":59201,"_3083":59227},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3632":2635,"_31224":2624,"_21643":59229,"_5":14891,"_28416":59201,"_3083":59230},[],"A working directory with restricted access for the downloaded key.",{"_3632":2636,"_31224":2624,"_21643":59232,"_5":14891,"_28416":59204,"_3083":59233},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3632":2637,"_31224":2624,"_21643":59235,"_5":14891,"_28416":59204,"_3083":59236},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3632":2638,"_31224":2624,"_21643":59238,"_5":14891,"_28416":59204,"_3083":59239},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3632":2639,"_31224":2624,"_21643":59241,"_5":14891,"_28416":59204,"_3083":59242},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3632":2640,"_31224":2624,"_21643":59244,"_5":14891,"_28416":59208,"_3083":59245},[],"File or resource",{"_3632":2641,"_31224":2624,"_21643":59247,"_5":14891,"_28416":59208,"_3083":56348},[],{"_3632":2642,"_31224":2624,"_21643":59249,"_5":14891,"_28416":59208,"_3083":59250},[],"Active root CA and `ca.pem`",{"_3632":2643,"_31224":2624,"_21643":59252,"_5":14891,"_28416":59208,"_3083":59253},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3632":2644,"_31224":2624,"_21643":59255,"_5":14891,"_28416":59208,"_3083":59256},[],"End-entity certificate and `device.crt`",{"_3632":2645,"_31224":2624,"_21643":59258,"_5":14891,"_28416":59208,"_3083":59259},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3632":2646,"_31224":2624,"_21643":59261,"_5":14891,"_28416":59208,"_3083":59262},[],"Private key `device.key`",{"_3632":2647,"_31224":2624,"_21643":59264,"_5":14891,"_28416":59208,"_3083":59265},[],"Its public key matches the one included in `device.crt`.",{"_3632":2648,"_31224":2624,"_21643":59267,"_5":14891,"_28416":59208,"_3083":59268},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3632":2649,"_31224":2624,"_21643":59270,"_5":14891,"_28416":59211,"_3083":59271},[],"To operate certificates, continue with Certificates and Validation.",{"_3632":2650,"_31224":2624,"_21643":59273,"_5":14891,"_28416":59211,"_3083":59274},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3632":2651,"_31224":2624,"_21643":59276,"_5":14891,"_28416":59211,"_3083":59277},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3632":2652,"_31224":2652,"_5":15251,"_3083":59279,"_31583":59280,"_21643":59281,"_28416":2652},"PKI troubleshooting",[51036,52548,56722,55297],[],{"_3632":2653,"_31224":2652,"_21643":59283,"_5":14891,"_28416":2652,"_3083":59284},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3632":2654,"_31224":2652,"_5":31580,"_21643":59286,"_28416":59287,"_3083":59288},[],"/docs/pr-preview/pr-82/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3632":2655,"_31224":2652,"_5":31580,"_21643":59290,"_28416":59291,"_3083":59292},[],"/docs/pr-preview/pr-82/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3632":2656,"_31224":2652,"_5":31580,"_21643":59294,"_28416":59295,"_3083":59296},[],"/docs/pr-preview/pr-82/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3632":2657,"_31224":2652,"_21643":59298,"_5":14891,"_28416":2652,"_3083":59299},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3632":2658,"_31224":2652,"_21643":59301,"_5":14891,"_28416":2652,"_3083":59302},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3632":2659,"_31224":2652,"_21643":59304,"_5":14891,"_28416":59287,"_3083":56348},[],{"_3632":2660,"_31224":2652,"_21643":59306,"_5":14891,"_28416":59287,"_3083":59307},[],"What to inspect",{"_3632":2661,"_31224":2652,"_21643":59309,"_5":14891,"_28416":59287,"_3083":51070},[],{"_3632":2662,"_31224":2652,"_21643":59311,"_5":14891,"_28416":59287,"_3083":55564},[],{"_3632":2663,"_31224":2652,"_21643":59313,"_5":14891,"_28416":59287,"_3083":59314},[],"Exists, is active and has usable dates.",{"_3632":2664,"_31224":2652,"_21643":59316,"_5":14891,"_28416":59287,"_3083":59317},[],"Authorities.",{"_3632":2665,"_31224":2652,"_21643":59319,"_5":14891,"_28416":59287,"_3083":59320},[],"Key",{"_3632":2666,"_31224":2652,"_21643":59322,"_5":14891,"_28416":59287,"_3083":59323},[],"The record has a usable private key and the engine can sign.",{"_3632":2667,"_31224":2652,"_21643":59325,"_5":14891,"_28416":59287,"_3083":59326},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3632":2668,"_31224":2652,"_21643":59328,"_5":14891,"_28416":59287,"_3083":59329},[],"CSR",{"_3632":2669,"_31224":2652,"_21643":59331,"_5":14891,"_28416":59287,"_3083":59332},[],"Correct PEM and verifiable signature.",{"_3632":2670,"_31224":2652,"_21643":59334,"_5":14891,"_28416":59287,"_3083":59335},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3632":2671,"_31224":2652,"_21643":59337,"_5":14891,"_28416":59287,"_3083":59338},[],"Profile",{"_3632":2672,"_31224":2652,"_21643":59340,"_5":14891,"_28416":59287,"_3083":59341},[],"Selected source, existing ID, allowed algorithm and size.",{"_3632":2673,"_31224":2652,"_21643":59343,"_5":14891,"_28416":59287,"_3083":59344},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3632":2674,"_31224":2652,"_21643":59346,"_5":14891,"_28416":59287,"_3083":56500},[],{"_3632":2675,"_31224":2652,"_21643":59348,"_5":14891,"_28416":59287,"_3083":59349},[],"Appropriate subject, SAN, usages and dates.",{"_3632":2676,"_31224":2652,"_21643":59351,"_5":14891,"_28416":59287,"_3083":59352},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3632":2677,"_31224":2652,"_21643":59354,"_5":14891,"_28416":59287,"_3083":59355},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3632":2678,"_31224":2652,"_21643":59357,"_5":14891,"_28416":59287,"_3083":59358},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3632":2679,"_31224":2652,"_21643":59360,"_5":14891,"_28416":59287,"_3083":59361},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3632":2680,"_31224":2652,"_21643":59363,"_5":14891,"_28416":59291,"_3083":59364},[],"Check each boundary independently:",{"_3632":2681,"_31224":2652,"_21643":59366,"_5":14891,"_28416":59291,"_3083":59367},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3632":2682,"_31224":2652,"_21643":59369,"_5":14891,"_28416":59291,"_3083":59370},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3632":2683,"_31224":2652,"_21643":59372,"_5":14891,"_28416":59291,"_3083":59373},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3632":2684,"_31224":2652,"_21643":59375,"_5":14891,"_28416":59291,"_3083":59376},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3632":2685,"_31224":2652,"_21643":59378,"_5":14891,"_28416":59291,"_3083":59379},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3632":2686,"_31224":2652,"_21643":59381,"_5":14891,"_28416":59291,"_3083":59382},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3632":2687,"_31224":2652,"_21643":59384,"_5":14891,"_28416":59295,"_3083":59385},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3632":2688,"_31224":2652,"_21643":59387,"_5":14891,"_28416":59295,"_3083":59388},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3632":2689,"_31224":2689,"_5":15251,"_3083":59390,"_31583":59391,"_21643":59392,"_28416":2689},"Security",[51036],[],{"_3632":2690,"_31224":2689,"_21643":59394,"_5":14891,"_28416":2689,"_3083":59395},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3632":2691,"_31224":2689,"_5":31580,"_21643":59397,"_28416":59398,"_3083":59399},[],"/docs/pr-preview/pr-82/security#report-a-vulnerability","Report a vulnerability",{"_3632":2692,"_31224":2689,"_5":31580,"_21643":59401,"_28416":59402,"_3083":59403},[],"/docs/pr-preview/pr-82/security#what-to-include-in-a-report","What to include in a report",{"_3632":2693,"_31224":2689,"_5":31580,"_21643":59405,"_28416":59406,"_3083":59407},[],"/docs/pr-preview/pr-82/security#supported-versions","Supported versions",{"_3632":2694,"_31224":2689,"_5":31580,"_21643":59409,"_28416":59410,"_3083":59411},[],"/docs/pr-preview/pr-82/security#responsible-disclosure","Responsible disclosure",{"_3632":2695,"_31224":2689,"_21643":59413,"_5":14891,"_28416":2689,"_3083":59414},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3632":2696,"_31224":2689,"_21643":59416,"_5":14891,"_28416":59398,"_3083":59417},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3632":2697,"_31224":2689,"_21643":59419,"_5":14891,"_28416":59398,"_3083":59420},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3632":2698,"_31224":2689,"_21643":59422,"_5":14891,"_28416":59398,"_3083":15530},[],{"_3632":2699,"_31224":2689,"_21643":59424,"_5":14891,"_28416":59398,"_3083":15459},[],{"_3632":2700,"_31224":2689,"_21643":59426,"_5":14891,"_28416":59398,"_3083":15517},[],{"_3632":2701,"_31224":2689,"_21643":59428,"_5":14891,"_28416":59398,"_3083":59429},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3632":2702,"_31224":2689,"_21643":59431,"_5":14891,"_28416":59398,"_3083":59432},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3632":2703,"_31224":2689,"_21643":59434,"_5":14891,"_28416":59402,"_3083":59435},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3632":2704,"_31224":2689,"_21643":59437,"_5":14891,"_28416":59402,"_3083":59438},[],"Do not include in the report:",{"_3632":2705,"_31224":2689,"_21643":59440,"_5":14891,"_28416":59402,"_3083":59441},[],"Credentials, tokens, or private keys",{"_3632":2706,"_31224":2689,"_21643":59443,"_5":14891,"_28416":59402,"_3083":59444},[],"Customer data or customer-identifiable information",{"_3632":2707,"_31224":2689,"_21643":59446,"_5":14891,"_28416":59402,"_3083":59447},[],"Confidential architecture or internal infrastructure details",{"_3632":2708,"_31224":2689,"_21643":59449,"_5":14891,"_28416":59406,"_3083":59450},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3632":2709,"_31224":2689,"_21643":59452,"_5":14891,"_28416":59406,"_3083":59453},[],"For upgrade guidance, see Upgrades.",{"_3632":2710,"_31224":2689,"_21643":59455,"_5":14891,"_28416":59410,"_3083":59456},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3632":2711,"_31224":2689,"_21643":59458,"_5":14891,"_28416":59410,"_3083":59459},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3632":2712,"_31224":2689,"_21643":59461,"_5":14891,"_28416":59410,"_3083":59462},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3632":2713,"_31224":2689,"_21643":59464,"_5":14891,"_28416":59410,"_3083":59465},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3632":2714,"_31224":2689,"_21643":59467,"_5":14891,"_28416":59410,"_3083":59468},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3632":2715,"_31224":2715,"_5":15251,"_3083":59470,"_31583":59471,"_21643":59473,"_28416":2715},"3.8.0 to 4.0.0",[51036,59472],"Upgrades",[],{"_3632":2716,"_31224":2715,"_21643":59475,"_5":14891,"_28416":2715,"_3083":59476},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3632":2717,"_31224":2715,"_5":31580,"_21643":59478,"_28416":59479,"_3083":59480},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3632":2718,"_31224":2715,"_5":31580,"_21643":59482,"_28416":59483,"_3083":59484},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3632":2719,"_31224":2715,"_5":31580,"_21643":59486,"_28416":59487,"_3083":59488},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3632":2720,"_31224":2715,"_5":31580,"_21643":59490,"_28416":59491,"_3083":59492},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3632":2721,"_31224":2715,"_5":31580,"_21643":59494,"_28416":59495,"_3083":59496},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3632":2722,"_31224":2715,"_5":31580,"_21643":59498,"_28416":59499,"_3083":59500},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3632":2723,"_31224":2715,"_5":31580,"_21643":59502,"_28416":59503,"_3083":59504},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3632":2724,"_31224":2715,"_5":31580,"_21643":59506,"_28416":59507,"_3083":59508},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3632":2725,"_31224":2715,"_5":31580,"_21643":59510,"_28416":59511,"_3083":59512},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3632":2726,"_31224":2715,"_5":31580,"_21643":59514,"_28416":59515,"_3083":59516},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3632":2727,"_31224":2715,"_5":31580,"_21643":59518,"_28416":59519,"_3083":51674},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3632":2728,"_31224":2715,"_5":31580,"_21643":59521,"_28416":59522,"_3083":59523},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3632":2729,"_31224":2715,"_5":31580,"_21643":59525,"_28416":59526,"_3083":59527},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3632":2730,"_31224":2715,"_5":31580,"_21643":59529,"_28416":59530,"_3083":59531},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3632":2731,"_31224":2715,"_5":31580,"_21643":59533,"_28416":59534,"_3083":59535},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3632":2732,"_31224":2715,"_5":31580,"_21643":59537,"_28416":59538,"_3083":59539},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3632":2733,"_31224":2715,"_5":31580,"_21643":59541,"_28416":59542,"_3083":59543},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3632":2734,"_31224":2715,"_5":31580,"_21643":59545,"_28416":59546,"_3083":59547},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3632":2735,"_31224":2715,"_5":31580,"_21643":59549,"_28416":59550,"_3083":59551},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3632":2736,"_31224":2715,"_5":31580,"_21643":59553,"_28416":59554,"_3083":59555},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3632":2737,"_31224":2715,"_5":31580,"_21643":59557,"_28416":59558,"_3083":59559},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3632":2738,"_31224":2715,"_5":31580,"_21643":59561,"_28416":59562,"_3083":59563},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3632":2739,"_31224":2715,"_5":31580,"_21643":59565,"_28416":59566,"_3083":59567},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3632":2740,"_31224":2715,"_5":31580,"_21643":59569,"_28416":59570,"_3083":59571},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3632":2741,"_31224":2715,"_5":31580,"_21643":59573,"_28416":59574,"_3083":59575},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3632":2742,"_31224":2715,"_5":31580,"_21643":59577,"_28416":59578,"_3083":59579},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3632":2743,"_31224":2715,"_5":31580,"_21643":59581,"_28416":59582,"_3083":59583},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3632":2744,"_31224":2715,"_5":31580,"_21643":59585,"_28416":59586,"_3083":59587},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3632":2745,"_31224":2715,"_5":31580,"_21643":59589,"_28416":59590,"_3083":59591},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3632":2746,"_31224":2715,"_5":31580,"_21643":59593,"_28416":59594,"_3083":59595},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3632":2747,"_31224":2715,"_5":31580,"_21643":59597,"_28416":59598,"_3083":59599},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3632":2748,"_31224":2715,"_5":31580,"_21643":59601,"_28416":59602,"_3083":59603},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3632":2749,"_31224":2715,"_5":31580,"_21643":59605,"_28416":59606,"_3083":59607},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3632":2750,"_31224":2715,"_5":31580,"_21643":59609,"_28416":59610,"_3083":59611},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3632":2751,"_31224":2715,"_5":31580,"_21643":59613,"_28416":59614,"_3083":59607},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3632":2752,"_31224":2715,"_5":31580,"_21643":59616,"_28416":59617,"_3083":59618},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3632":2753,"_31224":2715,"_5":31580,"_21643":59620,"_28416":59621,"_3083":59622},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3632":2754,"_31224":2715,"_5":31580,"_21643":59624,"_28416":59625,"_3083":59626},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3632":2755,"_31224":2715,"_5":31580,"_21643":59628,"_28416":59629,"_3083":59630},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3632":2756,"_31224":2715,"_5":31580,"_21643":59632,"_28416":59633,"_3083":59634},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3632":2757,"_31224":2715,"_5":31580,"_21643":59636,"_28416":59637,"_3083":59638},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3632":2758,"_31224":2715,"_5":31580,"_21643":59640,"_28416":59641,"_3083":59642},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3632":2759,"_31224":2715,"_5":31580,"_21643":59644,"_28416":59645,"_3083":59646},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3632":2760,"_31224":2715,"_5":31580,"_21643":59648,"_28416":59649,"_3083":59650},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3632":2761,"_31224":2715,"_5":31580,"_21643":59652,"_28416":59653,"_3083":55297},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3632":2762,"_31224":2715,"_5":31580,"_21643":59655,"_28416":59656,"_3083":59657},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3632":2763,"_31224":2715,"_5":31580,"_21643":59659,"_28416":59660,"_3083":59661},[],"/docs/pr-preview/pr-82/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3632":2764,"_31224":2715,"_21643":59663,"_5":14891,"_28416":2715,"_3083":59664},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3632":2765,"_31224":2715,"_21643":59666,"_5":14891,"_28416":2715,"_3083":59667},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3632":2766,"_31224":2715,"_21643":59669,"_5":14891,"_28416":2715,"_3083":59670},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3632":2767,"_31224":2715,"_21643":59672,"_5":14891,"_28416":2715,"_3083":59673},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3632":2768,"_31224":2715,"_21643":59675,"_5":14891,"_28416":2715,"_3083":59676},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3632":2769,"_31224":2715,"_21643":59678,"_5":14891,"_28416":2715,"_3083":59679},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3632":2770,"_31224":2715,"_21643":59681,"_5":14891,"_28416":2715,"_3083":59682},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3632":2771,"_31224":2715,"_21643":59684,"_5":14891,"_28416":59483,"_3083":59685},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3632":2772,"_31224":2715,"_21643":59687,"_5":14891,"_28416":59483,"_3083":59688},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3632":2773,"_31224":2715,"_21643":59690,"_5":14891,"_28416":59487,"_3083":59691},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3632":2774,"_31224":2715,"_21643":59693,"_5":14891,"_28416":59487,"_3083":59694},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3632":2775,"_31224":2715,"_21643":59696,"_5":14891,"_28416":59491,"_3083":59697},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3632":2776,"_31224":2715,"_21643":59699,"_5":14891,"_28416":59495,"_3083":59700},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3632":2777,"_31224":2715,"_21643":59702,"_5":14891,"_28416":59495,"_3083":59703},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3632":2778,"_31224":2715,"_21643":59705,"_5":14891,"_28416":59495,"_3083":59706},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3632":2779,"_31224":2715,"_21643":59708,"_5":14891,"_28416":59495,"_3083":59709},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3632":2780,"_31224":2715,"_21643":59711,"_5":14891,"_28416":59495,"_3083":59712},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3632":2781,"_31224":2715,"_21643":59714,"_5":14891,"_28416":59499,"_3083":59715},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3632":2782,"_31224":2715,"_21643":59717,"_5":14891,"_28416":59499,"_3083":59718},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3632":2783,"_31224":2715,"_21643":59720,"_5":14891,"_28416":59499,"_3083":59721},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3632":2784,"_31224":2715,"_21643":59723,"_5":14891,"_28416":59499,"_3083":59724},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3632":2785,"_31224":2715,"_21643":59726,"_5":14891,"_28416":59499,"_3083":59727},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3632":2786,"_31224":2715,"_21643":59729,"_5":14891,"_28416":59499,"_3083":59730},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3632":2787,"_31224":2715,"_21643":59732,"_5":14891,"_28416":59503,"_3083":59733},[],"Change",{"_3632":2788,"_31224":2715,"_21643":59735,"_5":14891,"_28416":59503,"_3083":59736},[],"Who is affected",{"_3632":2789,"_31224":2715,"_21643":59738,"_5":14891,"_28416":59503,"_3083":59739},[],"Severity",{"_3632":2790,"_31224":2715,"_21643":59741,"_5":14891,"_28416":59503,"_3083":58192},[],{"_3632":2791,"_31224":2715,"_21643":59743,"_5":14891,"_28416":59503,"_3083":59512},[],{"_3632":2792,"_31224":2715,"_21643":59745,"_5":14891,"_28416":59503,"_3083":59746},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3632":2793,"_31224":2715,"_21643":59748,"_5":14891,"_28416":59503,"_3083":59749},[],"High: KMS and VA start on empty volumes",{"_3632":2794,"_31224":2715,"_21643":59751,"_5":14891,"_28416":59503,"_3083":59752},[],"Copy the data into the new volumes",{"_3632":2795,"_31224":2715,"_21643":59754,"_5":14891,"_28416":59503,"_3083":59516},[],{"_3632":2796,"_31224":2715,"_21643":59756,"_5":14891,"_28416":59503,"_3083":59757},[],"Every Helm release",{"_3632":2797,"_31224":2715,"_21643":59759,"_5":14891,"_28416":59503,"_3083":59760},[],"High: `helm upgrade` fails",{"_3632":2798,"_31224":2715,"_21643":59762,"_5":14891,"_28416":59503,"_3083":59763},[],"Remove or rename legacy keys",{"_3632":2799,"_31224":2715,"_21643":59765,"_5":14891,"_28416":59503,"_3083":51674},[],{"_3632":2800,"_31224":2715,"_21643":59767,"_5":14891,"_28416":59503,"_3083":59757},[],{"_3632":2801,"_31224":2715,"_21643":59769,"_5":14891,"_28416":59503,"_3083":59770},[],"High: `helm upgrade` fails on inline credentials",{"_3632":2802,"_31224":2715,"_21643":59772,"_5":14891,"_28416":59503,"_3083":59773},[],"Create the Secrets first; see Step 2",{"_3632":2803,"_31224":2715,"_21643":59775,"_5":14891,"_28416":59503,"_3083":59523},[],{"_3632":2804,"_31224":2715,"_21643":59777,"_5":14891,"_28416":59503,"_3083":59778},[],"Every deployment",{"_3632":2805,"_31224":2715,"_21643":59780,"_5":14891,"_28416":59503,"_3083":59781},[],"High: without a bootstrap principal there is no administrator",{"_3632":2806,"_31224":2715,"_21643":59783,"_5":14891,"_28416":59503,"_3083":59784},[],"Configure `services.authz`",{"_3632":2807,"_31224":2715,"_21643":59786,"_5":14891,"_28416":59503,"_3083":59527},[],{"_3632":2808,"_31224":2715,"_21643":59788,"_5":14891,"_28416":59503,"_3083":59757},[],{"_3632":2809,"_31224":2715,"_21643":59790,"_5":14891,"_28416":59503,"_3083":59791},[],"High: `helm upgrade` fails on the old keys",{"_3632":2810,"_31224":2715,"_21643":59793,"_5":14891,"_28416":59503,"_3083":59794},[],"Move JWKS and roles into `services.authz`",{"_3632":2811,"_31224":2715,"_21643":59796,"_5":14891,"_28416":59503,"_3083":59547},[],{"_3632":2812,"_31224":2715,"_21643":59798,"_5":14891,"_28416":59503,"_3083":59799},[],"3.8.0 deployments with per-service databases",{"_3632":2813,"_31224":2715,"_21643":59801,"_5":14891,"_28416":59503,"_3083":59802},[],"High: services find no data, or a migration aborts",{"_3632":2814,"_31224":2715,"_21643":59804,"_5":14891,"_28416":59503,"_3083":59805},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3632":2815,"_31224":2715,"_21643":59807,"_5":14891,"_28416":59503,"_3083":59551},[],{"_3632":2816,"_31224":2715,"_21643":59809,"_5":14891,"_28416":59503,"_3083":59810},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3632":2817,"_31224":2715,"_21643":59812,"_5":14891,"_28416":59503,"_3083":59813},[],"High: the backend no longer starts with them",{"_3632":2818,"_31224":2715,"_21643":59815,"_5":14891,"_28416":59503,"_3083":59816},[],"Move to PostgreSQL before upgrading",{"_3632":2819,"_31224":2715,"_21643":59818,"_5":14891,"_28416":59503,"_3083":59599},[],{"_3632":2820,"_31224":2715,"_21643":59820,"_5":14891,"_28416":59503,"_3083":59821},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3632":2821,"_31224":2715,"_21643":59823,"_5":14891,"_28416":59503,"_3083":59824},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3632":2822,"_31224":2715,"_21643":59826,"_5":14891,"_28416":59503,"_3083":59827},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3632":2823,"_31224":2715,"_21643":59829,"_5":14891,"_28416":59503,"_3083":59830},[],"Webhooks with file references",{"_3632":2824,"_31224":2715,"_21643":59832,"_5":14891,"_28416":59503,"_3083":59833},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3632":2825,"_31224":2715,"_21643":59835,"_5":14891,"_28416":59503,"_3083":59836},[],"High: enrollments calling the webhook fail",{"_3632":2826,"_31224":2715,"_21643":59838,"_5":14891,"_28416":59503,"_3083":59839},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3632":2827,"_31224":2715,"_21643":59841,"_5":14891,"_28416":59503,"_3083":59531},[],{"_3632":2828,"_31224":2715,"_21643":59843,"_5":14891,"_28416":59503,"_3083":59844},[],"Releases with per-service identity overrides or mounted key material",{"_3632":2829,"_31224":2715,"_21643":59846,"_5":14891,"_28416":59503,"_3083":59847},[],"Medium: services cannot read their files",{"_3632":2830,"_31224":2715,"_21643":59849,"_5":14891,"_28416":59503,"_3083":59850},[],"Remove the overrides and fix volume ownership",{"_3632":2831,"_31224":2715,"_21643":59852,"_5":14891,"_28416":59503,"_3083":59535},[],{"_3632":2832,"_31224":2715,"_21643":59854,"_5":14891,"_28416":59503,"_3083":59855},[],"Releases that set `amqp.tls`",{"_3632":2833,"_31224":2715,"_21643":59857,"_5":14891,"_28416":59503,"_3083":59858},[],"Medium: clients connect to the wrong port",{"_3632":2834,"_31224":2715,"_21643":59860,"_5":14891,"_28416":59503,"_3083":59861},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3632":2835,"_31224":2715,"_21643":59863,"_5":14891,"_28416":59503,"_3083":59555},[],{"_3632":2836,"_31224":2715,"_21643":59865,"_5":14891,"_28416":59503,"_3083":59866},[],"Installations whose CA keys predate the KMS",{"_3632":2837,"_31224":2715,"_21643":59868,"_5":14891,"_28416":59503,"_3083":59869},[],"Medium: CA keys stay unmanaged",{"_3632":2838,"_31224":2715,"_21643":59871,"_5":14891,"_28416":59503,"_3083":59872},[],"Run the CA-to-KMS migration",{"_3632":2839,"_31224":2715,"_21643":59874,"_5":14891,"_28416":59503,"_3083":59875},[],"Receiver certificate verification",{"_3632":2840,"_31224":2715,"_21643":59877,"_5":14891,"_28416":59503,"_3083":59878},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3632":2841,"_31224":2715,"_21643":59880,"_5":14891,"_28416":59503,"_3083":59881},[],"Medium: credentials go to an unverified receiver",{"_3632":2842,"_31224":2715,"_21643":59883,"_5":14891,"_28416":59503,"_3083":59884},[],"Set `insecure_skip_verify` to `false`",{"_3632":2843,"_31224":2715,"_21643":59886,"_5":14891,"_28416":59503,"_3083":59571},[],{"_3632":2844,"_31224":2715,"_21643":59888,"_5":14891,"_28416":59503,"_3083":59889},[],"Scripts and consoles that edit DMSs through the API",{"_3632":2845,"_31224":2715,"_21643":59891,"_5":14891,"_28416":59503,"_3083":59892},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3632":2846,"_31224":2715,"_21643":59894,"_5":14891,"_28416":59503,"_3083":59895},[],"Read the DMS before editing and use the new field",{"_3632":2847,"_31224":2715,"_21643":59897,"_5":14891,"_28416":59503,"_3083":59575},[],{"_3632":2848,"_31224":2715,"_21643":59899,"_5":14891,"_28416":59503,"_3083":59900},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3632":2849,"_31224":2715,"_21643":59902,"_5":14891,"_28416":59503,"_3083":59903},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3632":2850,"_31224":2715,"_21643":59905,"_5":14891,"_28416":59503,"_3083":59906},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3632":2851,"_31224":2715,"_21643":59908,"_5":14891,"_28416":59503,"_3083":59595},[],{"_3632":2852,"_31224":2715,"_21643":59910,"_5":14891,"_28416":59503,"_3083":59911},[],"Clients that create or update CRL settings through the API",{"_3632":2853,"_31224":2715,"_21643":59913,"_5":14891,"_28416":59503,"_3083":59914},[],"Medium: requests with the old field return an error",{"_3632":2854,"_31224":2715,"_21643":59916,"_5":14891,"_28416":59503,"_3083":59917},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3632":2855,"_31224":2715,"_21643":59919,"_5":14891,"_28416":59503,"_3083":59603},[],{"_3632":2856,"_31224":2715,"_21643":59921,"_5":14891,"_28416":59503,"_3083":59922},[],"Alert subscriptions and consumers of the VA events",{"_3632":2857,"_31224":2715,"_21643":59924,"_5":14891,"_28416":59503,"_3083":59925},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3632":2858,"_31224":2715,"_21643":59927,"_5":14891,"_28416":59503,"_3083":59928},[],"Review conditions filtering on the old event payload or subject",{"_3632":2859,"_31224":2715,"_21643":59930,"_5":14891,"_28416":59503,"_3083":59607},[],{"_3632":2860,"_31224":2715,"_21643":59932,"_5":14891,"_28416":59503,"_3083":59933},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3632":2861,"_31224":2715,"_21643":59935,"_5":14891,"_28416":59503,"_3083":59936},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3632":2862,"_31224":2715,"_21643":59938,"_5":14891,"_28416":59503,"_3083":59939},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3632":2863,"_31224":2715,"_21643":59941,"_5":14891,"_28416":59503,"_3083":59591},[],{"_3632":2864,"_31224":2715,"_21643":59943,"_5":14891,"_28416":59503,"_3083":59944},[],"Consumers that read the device `events` field",{"_3632":2865,"_31224":2715,"_21643":59946,"_5":14891,"_28416":59503,"_3083":59947},[],"Medium: the field disappears",{"_3632":2866,"_31224":2715,"_21643":59949,"_5":14891,"_28416":59503,"_3083":59950},[],"Use the new event endpoints",{"_3632":2867,"_31224":2715,"_21643":59952,"_5":14891,"_28416":59503,"_3083":59618},[],{"_3632":2868,"_31224":2715,"_21643":59954,"_5":14891,"_28416":59503,"_3083":59955},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3632":2869,"_31224":2715,"_21643":59957,"_5":14891,"_28416":59503,"_3083":59958},[],"Medium: the VA migration aborts",{"_3632":2870,"_31224":2715,"_21643":59960,"_5":14891,"_28416":59503,"_3083":59961},[],"Fix the affected roles before upgrading",{"_3632":2871,"_31224":2715,"_21643":59963,"_5":14891,"_28416":59503,"_3083":59539},[],{"_3632":2872,"_31224":2715,"_21643":59965,"_5":14891,"_28416":59503,"_3083":59966},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3632":2873,"_31224":2715,"_21643":59968,"_5":14891,"_28416":59503,"_3083":59969},[],"Low to medium: validation errors or changed defaults",{"_3632":2874,"_31224":2715,"_21643":59971,"_5":14891,"_28416":59503,"_3083":59972},[],"Update the values file",{"_3632":2875,"_31224":2715,"_21643":59974,"_5":14891,"_28416":59503,"_3083":59583},[],{"_3632":2876,"_31224":2715,"_21643":59976,"_5":14891,"_28416":59503,"_3083":59977},[],"Clients that send the DMS ID in the update body",{"_3632":2877,"_31224":2715,"_21643":59979,"_5":14891,"_28416":59503,"_3083":59980},[],"Low: the ID in the URL wins",{"_3632":2878,"_31224":2715,"_21643":59982,"_5":14891,"_28416":59503,"_3083":59983},[],"Send the ID in the URL",{"_3632":2879,"_31224":2715,"_21643":59985,"_5":14891,"_28416":59503,"_3083":59611},[],{"_3632":2880,"_31224":2715,"_21643":59987,"_5":14891,"_28416":59503,"_3083":59988},[],"Clients that send an `id` when creating or importing CAs",{"_3632":2881,"_31224":2715,"_21643":59990,"_5":14891,"_28416":59503,"_3083":59991},[],"Low: the ID in the body is ignored, and the field is removed",{"_3632":2882,"_31224":2715,"_21643":59993,"_5":14891,"_28416":59503,"_3083":59994},[],"Let the backend assign the ID and use the returned one",{"_3632":2883,"_31224":2715,"_21643":59996,"_5":14891,"_28416":59503,"_3083":59607},[],{"_3632":2884,"_31224":2715,"_21643":59998,"_5":14891,"_28416":59503,"_3083":59999},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3632":2885,"_31224":2715,"_21643":60001,"_5":14891,"_28416":59503,"_3083":60002},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3632":2886,"_31224":2715,"_21643":60004,"_5":14891,"_28416":59503,"_3083":60005},[],"Use the KMS `sign` and `verify` operations",{"_3632":2887,"_31224":2715,"_21643":60007,"_5":14891,"_28416":59503,"_3083":59587},[],{"_3632":2888,"_31224":2715,"_21643":60009,"_5":14891,"_28416":59503,"_3083":60010},[],"Consumers that match on certificate `type`",{"_3632":2889,"_31224":2715,"_21643":60012,"_5":14891,"_28416":59503,"_3083":60013},[],"Low: two values are renamed",{"_3632":2890,"_31224":2715,"_21643":60015,"_5":14891,"_28416":59503,"_3083":60016},[],"Adapt consumers",{"_3632":2891,"_31224":2715,"_21643":60018,"_5":14891,"_28416":59503,"_3083":59579},[],{"_3632":2892,"_31224":2715,"_21643":60020,"_5":14891,"_28416":59503,"_3083":60021},[],"Any DMS",{"_3632":2893,"_31224":2715,"_21643":60023,"_5":14891,"_28416":59503,"_3083":60024},[],"Low: informational",{"_3632":2894,"_31224":2715,"_21643":60026,"_5":14891,"_28416":59503,"_3083":60027},[],"Read both blocks before editing",{"_3632":2895,"_31224":2715,"_21643":60029,"_5":14891,"_28416":59511,"_3083":60030},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3632":2896,"_31224":2715,"_21643":60032,"_5":14891,"_28416":59511,"_3083":60033},[],"Step 4 of the migration guide copies the data.",{"_3632":2897,"_31224":2715,"_21643":60035,"_5":14891,"_28416":59515,"_3083":60036},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3632":2898,"_31224":2715,"_21643":60038,"_5":14891,"_28416":59519,"_3083":60039},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3632":2899,"_31224":2715,"_21643":60041,"_5":14891,"_28416":59519,"_3083":60042},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3632":2900,"_31224":2715,"_21643":60044,"_5":14891,"_28416":59522,"_3083":60045},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3632":2901,"_31224":2715,"_21643":60047,"_5":14891,"_28416":59526,"_3083":60048},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3632":2902,"_31224":2715,"_21643":60050,"_5":14891,"_28416":59530,"_3083":60051},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3632":2903,"_31224":2715,"_21643":60053,"_5":14891,"_28416":59530,"_3083":60054},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3632":2904,"_31224":2715,"_21643":60056,"_5":14891,"_28416":59530,"_3083":60057},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3632":2905,"_31224":2715,"_21643":60059,"_5":14891,"_28416":59534,"_3083":60060},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3632":2906,"_31224":2715,"_21643":60062,"_5":14891,"_28416":59538,"_3083":60063},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3632":2907,"_31224":2715,"_21643":60065,"_5":14891,"_28416":59538,"_3083":60066},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3632":2908,"_31224":2715,"_21643":60068,"_5":14891,"_28416":59538,"_3083":60069},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3632":2909,"_31224":2715,"_21643":60071,"_5":14891,"_28416":59538,"_3083":60072},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3632":2910,"_31224":2715,"_21643":60074,"_5":14891,"_28416":59538,"_3083":60075},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3632":2911,"_31224":2715,"_21643":60077,"_5":14891,"_28416":59538,"_3083":60078},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3632":2912,"_31224":2715,"_21643":60080,"_5":14891,"_28416":59546,"_3083":60081},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3632":2913,"_31224":2715,"_21643":60083,"_5":14891,"_28416":59546,"_3083":60084},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3632":2914,"_31224":2715,"_21643":60086,"_5":14891,"_28416":59546,"_3083":60087},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3632":2915,"_31224":2715,"_21643":60089,"_5":14891,"_28416":59546,"_3083":60090},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3632":2916,"_31224":2715,"_21643":60092,"_5":14891,"_28416":59546,"_3083":60093},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3632":2917,"_31224":2715,"_21643":60095,"_5":14891,"_28416":59550,"_3083":60096},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3632":2918,"_31224":2715,"_21643":60098,"_5":14891,"_28416":59554,"_3083":60099},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3632":2919,"_31224":2715,"_21643":60101,"_5":14891,"_28416":59554,"_3083":60102},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3632":2920,"_31224":2715,"_21643":60104,"_5":14891,"_28416":59554,"_3083":60105},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3632":2921,"_31224":2715,"_21643":60107,"_5":14891,"_28416":59554,"_3083":60108},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3632":2922,"_31224":2715,"_21643":60110,"_5":14891,"_28416":59554,"_3083":60111},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3632":2923,"_31224":2715,"_21643":60113,"_5":14891,"_28416":59554,"_3083":60114},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3632":2924,"_31224":2715,"_21643":60116,"_5":14891,"_28416":59554,"_3083":60117},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3632":2925,"_31224":2715,"_21643":60119,"_5":14891,"_28416":59554,"_3083":60120},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3632":2926,"_31224":2715,"_21643":60122,"_5":14891,"_28416":59558,"_3083":60123},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3632":2927,"_31224":2715,"_21643":60125,"_5":14891,"_28416":59566,"_3083":60126},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3632":2928,"_31224":2715,"_21643":60128,"_5":14891,"_28416":59566,"_3083":60129},[],"Field in 3.8.0",{"_3632":2929,"_31224":2715,"_21643":60131,"_5":14891,"_28416":59566,"_3083":60132},[],"Field in 4.0.0",{"_3632":2930,"_31224":2715,"_21643":60134,"_5":14891,"_28416":59566,"_3083":60135},[],"`validate_server_cert`",{"_3632":2931,"_31224":2715,"_21643":60137,"_5":14891,"_28416":59566,"_3083":60138},[],"`insecure_skip_verify` (value negated)",{"_3632":2932,"_31224":2715,"_21643":60140,"_5":14891,"_28416":59566,"_3083":60141},[],"`oidc`",{"_3632":2933,"_31224":2715,"_21643":60143,"_5":14891,"_28416":59566,"_3083":60144},[],"`jwt_options`",{"_3632":2934,"_31224":2715,"_21643":60146,"_5":14891,"_28416":59566,"_3083":60147},[],"`apikey`",{"_3632":2935,"_31224":2715,"_21643":60149,"_5":14891,"_28416":59566,"_3083":60150},[],"`apikey_options`",{"_3632":2936,"_31224":2715,"_21643":60152,"_5":14891,"_28416":59566,"_3083":60153},[],"`mtls`",{"_3632":2937,"_31224":2715,"_21643":60155,"_5":14891,"_28416":59566,"_3083":60156},[],"`mtls_options`",{"_3632":2938,"_31224":2715,"_21643":60158,"_5":14891,"_28416":59566,"_3083":60159},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3632":2939,"_31224":2715,"_21643":60161,"_5":14891,"_28416":59566,"_3083":60162},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3632":2940,"_31224":2715,"_21643":60164,"_5":14891,"_28416":59566,"_3083":60165},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3632":2941,"_31224":2715,"_21643":60167,"_5":14891,"_28416":59570,"_3083":60168},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3632":2942,"_31224":2715,"_21643":60170,"_5":14891,"_28416":59570,"_3083":60171},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3632":2943,"_31224":2715,"_21643":60173,"_5":14891,"_28416":59570,"_3083":60174},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3632":2944,"_31224":2715,"_21643":60176,"_5":14891,"_28416":59574,"_3083":60177},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3632":2945,"_31224":2715,"_21643":60179,"_5":14891,"_28416":59574,"_3083":60180},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3632":2946,"_31224":2715,"_21643":60182,"_5":14891,"_28416":59578,"_3083":60183},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3632":2947,"_31224":2715,"_21643":60185,"_5":14891,"_28416":59582,"_3083":60186},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3632":2948,"_31224":2715,"_21643":60188,"_5":14891,"_28416":59586,"_3083":60189},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3632":2949,"_31224":2715,"_21643":60191,"_5":14891,"_28416":59590,"_3083":60192},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3632":2950,"_31224":2715,"_21643":60194,"_5":14891,"_28416":59590,"_3083":60195},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3632":2951,"_31224":2715,"_21643":60197,"_5":14891,"_28416":59590,"_3083":60198},[],"`POST /v1/devices/:id/events` creates an event.",{"_3632":2952,"_31224":2715,"_21643":60200,"_5":14891,"_28416":59590,"_3083":60201},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3632":2953,"_31224":2715,"_21643":60203,"_5":14891,"_28416":59594,"_3083":60204},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3632":2954,"_31224":2715,"_21643":60206,"_5":14891,"_28416":59598,"_3083":60207},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3632":2955,"_31224":2715,"_21643":60209,"_5":14891,"_28416":59598,"_3083":60210},[],"Route",{"_3632":2956,"_31224":2715,"_21643":60212,"_5":14891,"_28416":59598,"_3083":54485},[],{"_3632":2957,"_31224":2715,"_21643":60214,"_5":14891,"_28416":59598,"_3083":60215},[],"`GET /v1/crl-settings`",{"_3632":2958,"_31224":2715,"_21643":60217,"_5":14891,"_28416":59598,"_3083":60218},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3632":2959,"_31224":2715,"_21643":60220,"_5":14891,"_28416":59598,"_3083":60221},[],"`GET /v1/crl-settings/{ca-id}`",{"_3632":2960,"_31224":2715,"_21643":60223,"_5":14891,"_28416":59598,"_3083":60224},[],"Reads the settings of a CA.",{"_3632":2961,"_31224":2715,"_21643":60226,"_5":14891,"_28416":59598,"_3083":60227},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3632":2962,"_31224":2715,"_21643":60229,"_5":14891,"_28416":59598,"_3083":60230},[],"Replaces `crl_options`.",{"_3632":2963,"_31224":2715,"_21643":60232,"_5":14891,"_28416":59598,"_3083":60233},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3632":2964,"_31224":2715,"_21643":60235,"_5":14891,"_28416":59598,"_3083":60236},[],"Removes the archived settings of a CA.",{"_3632":2965,"_31224":2715,"_21643":60238,"_5":14891,"_28416":59598,"_3083":60239},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3632":2966,"_31224":2715,"_21643":60241,"_5":14891,"_28416":59598,"_3083":60242},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3632":2967,"_31224":2715,"_21643":60244,"_5":14891,"_28416":59598,"_3083":60245},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3632":2968,"_31224":2715,"_21643":60247,"_5":14891,"_28416":59598,"_3083":60248},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3632":2969,"_31224":2715,"_21643":60250,"_5":14891,"_28416":59598,"_3083":60251},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3632":2970,"_31224":2715,"_21643":60253,"_5":14891,"_28416":59598,"_3083":60254},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3632":2971,"_31224":2715,"_21643":60256,"_5":14891,"_28416":59598,"_3083":60257},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3632":2972,"_31224":2715,"_21643":60259,"_5":14891,"_28416":59598,"_3083":60260},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3632":2973,"_31224":2715,"_21643":60262,"_5":14891,"_28416":59598,"_3083":60263},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3632":2974,"_31224":2715,"_21643":60265,"_5":14891,"_28416":59598,"_3083":60266},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3632":2975,"_31224":2715,"_21643":60268,"_5":14891,"_28416":59598,"_3083":60269},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3632":2976,"_31224":2715,"_21643":60271,"_5":14891,"_28416":59602,"_3083":60272},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3632":2977,"_31224":2715,"_21643":60274,"_5":14891,"_28416":59606,"_3083":60275},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3632":2978,"_31224":2715,"_21643":60277,"_5":14891,"_28416":59610,"_3083":60278},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3632":2979,"_31224":2715,"_21643":60280,"_5":14891,"_28416":59614,"_3083":60281},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3632":2980,"_31224":2715,"_21643":60283,"_5":14891,"_28416":59614,"_3083":60284},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3632":2981,"_31224":2715,"_21643":60286,"_5":14891,"_28416":59617,"_3083":60287},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3632":2982,"_31224":2715,"_21643":60289,"_5":14891,"_28416":59621,"_3083":60290},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3632":2983,"_31224":2715,"_21643":60292,"_5":14891,"_28416":59625,"_3083":60293},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3632":2984,"_31224":2715,"_21643":60295,"_5":14891,"_28416":59625,"_3083":60296},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3632":2985,"_31224":2715,"_21643":60298,"_5":14891,"_28416":59625,"_3083":60299},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3632":2986,"_31224":2715,"_21643":60301,"_5":14891,"_28416":59625,"_3083":60302},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3632":2987,"_31224":2715,"_21643":60304,"_5":14891,"_28416":59625,"_3083":60305},[],"Record the names of your local-storage PVCs:",{"_3632":2988,"_31224":2715,"_21643":60307,"_5":14891,"_28416":59625,"_3083":60308},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3632":2989,"_31224":2715,"_21643":60310,"_5":14891,"_28416":59629,"_3083":60311},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3632":2990,"_31224":2715,"_21643":60313,"_5":14891,"_28416":59629,"_3083":60314},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3632":2991,"_31224":2715,"_21643":60316,"_5":14891,"_28416":59629,"_3083":60317},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3632":2992,"_31224":2715,"_21643":60319,"_5":14891,"_28416":59629,"_3083":60320},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3632":2993,"_31224":2715,"_21643":60322,"_5":14891,"_28416":59629,"_3083":60323},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3632":2994,"_31224":2715,"_21643":60325,"_5":14891,"_28416":59633,"_3083":60326},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3632":2995,"_31224":2715,"_21643":60328,"_5":14891,"_28416":59633,"_3083":60329},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3632":2996,"_31224":2715,"_21643":60331,"_5":14891,"_28416":59633,"_3083":60332},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3632":2997,"_31224":2715,"_21643":60334,"_5":14891,"_28416":59633,"_3083":60335},[],"Secret (`existingSecret`)",{"_3632":2998,"_31224":2715,"_21643":60337,"_5":14891,"_28416":59633,"_3083":60338},[],"Required data keys",{"_3632":2999,"_31224":2715,"_21643":60340,"_5":14891,"_28416":59633,"_3083":60341},[],"When",{"_3632":3000,"_31224":2715,"_21643":60343,"_5":14891,"_28416":59633,"_3083":60344},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3632":3001,"_31224":2715,"_21643":60346,"_5":14891,"_28416":59633,"_3083":60347},[],"`username`, `password`",{"_3632":3002,"_31224":2715,"_21643":60349,"_5":14891,"_28416":59633,"_3083":60350},[],"Always",{"_3632":3003,"_31224":2715,"_21643":60352,"_5":14891,"_28416":59633,"_3083":60353},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3632":3004,"_31224":2715,"_21643":60355,"_5":14891,"_28416":59633,"_3083":60347},[],{"_3632":3005,"_31224":2715,"_21643":60357,"_5":14891,"_28416":59633,"_3083":60350},[],{"_3632":3006,"_31224":2715,"_21643":60359,"_5":14891,"_28416":59633,"_3083":60360},[],"`services.alerts.smtp_server.existingSecret`",{"_3632":3007,"_31224":2715,"_21643":60362,"_5":14891,"_28416":59633,"_3083":60347},[],{"_3632":3008,"_31224":2715,"_21643":60364,"_5":14891,"_28416":59633,"_3083":60365},[],"Only when SMTP authentication is enabled",{"_3632":3009,"_31224":2715,"_21643":60367,"_5":14891,"_28416":59633,"_3083":60368},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3632":3010,"_31224":2715,"_21643":60370,"_5":14891,"_28416":59633,"_3083":60371},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3632":3011,"_31224":2715,"_21643":60373,"_5":14891,"_28416":59633,"_3083":60374},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3632":3012,"_31224":2715,"_21643":60376,"_5":14891,"_28416":59633,"_3083":60377},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3632":3013,"_31224":2715,"_21643":60379,"_5":14891,"_28416":59633,"_3083":60380},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3632":3014,"_31224":2715,"_21643":60382,"_5":14891,"_28416":59633,"_3083":60383},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3632":3015,"_31224":2715,"_21643":60385,"_5":14891,"_28416":59633,"_3083":60386},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3632":3016,"_31224":2715,"_21643":60388,"_5":14891,"_28416":59633,"_3083":60389},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3632":3017,"_31224":2715,"_21643":60391,"_5":14891,"_28416":59633,"_3083":60392},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3632":3018,"_31224":2715,"_21643":60394,"_5":14891,"_28416":59633,"_3083":60395},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3632":3019,"_31224":2715,"_21643":60397,"_5":14891,"_28416":59633,"_3083":60398},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3632":3020,"_31224":2715,"_21643":60400,"_5":14891,"_28416":59633,"_3083":60401},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3632":3021,"_31224":2715,"_21643":60403,"_5":14891,"_28416":59633,"_3083":60404},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3632":3022,"_31224":2715,"_21643":60406,"_5":14891,"_28416":59633,"_3083":60407},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3632":3023,"_31224":2715,"_21643":60409,"_5":14891,"_28416":59633,"_3083":60410},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3632":3024,"_31224":2715,"_21643":60412,"_5":14891,"_28416":59637,"_3083":60413},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3632":3025,"_31224":2715,"_21643":60415,"_5":14891,"_28416":59637,"_3083":60416},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3632":3026,"_31224":2715,"_21643":60418,"_5":14891,"_28416":59641,"_3083":60419},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3632":3027,"_31224":2715,"_21643":60421,"_5":14891,"_28416":59641,"_3083":60422},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3632":3028,"_31224":2715,"_21643":60424,"_5":14891,"_28416":59641,"_3083":60425},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3632":3029,"_31224":2715,"_21643":60427,"_5":14891,"_28416":59641,"_3083":60428},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3632":3030,"_31224":2715,"_21643":60430,"_5":14891,"_28416":59641,"_3083":60431},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3632":3031,"_31224":2715,"_21643":60433,"_5":14891,"_28416":59641,"_3083":60434},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3632":3032,"_31224":2715,"_21643":60436,"_5":14891,"_28416":59641,"_3083":60437},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3632":3033,"_31224":2715,"_21643":60439,"_5":14891,"_28416":59641,"_3083":60440},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3632":3034,"_31224":2715,"_21643":60442,"_5":14891,"_28416":59641,"_3083":60443},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3632":3035,"_31224":2715,"_21643":60445,"_5":14891,"_28416":59641,"_3083":60446},[],"**Remove the helper and restore the recorded replica counts:**",{"_3632":3036,"_31224":2715,"_21643":60448,"_5":14891,"_28416":59641,"_3083":60449},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3632":3037,"_31224":2715,"_21643":60451,"_5":14891,"_28416":59645,"_3083":60452},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3632":3038,"_31224":2715,"_21643":60454,"_5":14891,"_28416":59645,"_3083":60455},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3632":3039,"_31224":2715,"_21643":60457,"_5":14891,"_28416":59649,"_3083":60458},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3632":3040,"_31224":2715,"_21643":60460,"_5":14891,"_28416":59649,"_3083":60461},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3632":3041,"_31224":2715,"_21643":60463,"_5":14891,"_28416":59649,"_3083":60464},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3632":3042,"_31224":2715,"_21643":60466,"_5":14891,"_28416":59649,"_3083":60467},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3632":3043,"_31224":2715,"_21643":60469,"_5":14891,"_28416":59649,"_3083":60470},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3632":3044,"_31224":2715,"_21643":60472,"_5":14891,"_28416":59649,"_3083":60473},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3632":3045,"_31224":2715,"_21643":60475,"_5":14891,"_28416":59649,"_3083":60476},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3632":3046,"_31224":2715,"_21643":60478,"_5":14891,"_28416":59649,"_3083":60479},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3632":3047,"_31224":2715,"_21643":60481,"_5":14891,"_28416":59653,"_3083":60482},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3632":3048,"_31224":2715,"_21643":60484,"_5":14891,"_28416":59653,"_3083":60485},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3632":3049,"_31224":2715,"_21643":60487,"_5":14891,"_28416":59653,"_3083":60488},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3632":3050,"_31224":2715,"_21643":60490,"_5":14891,"_28416":59653,"_3083":60491},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3632":3051,"_31224":2715,"_21643":60493,"_5":14891,"_28416":59653,"_3083":60494},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3632":3052,"_31224":2715,"_21643":60496,"_5":14891,"_28416":59653,"_3083":60497},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3632":3053,"_31224":2715,"_21643":60499,"_5":14891,"_28416":59653,"_3083":60500},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3632":3054,"_31224":2715,"_21643":60502,"_5":14891,"_28416":59653,"_3083":60503},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3632":3055,"_31224":2715,"_21643":60505,"_5":14891,"_28416":59653,"_3083":60506},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3632":3056,"_31224":2715,"_21643":60508,"_5":14891,"_28416":59653,"_3083":60509},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3632":3057,"_31224":2715,"_21643":60511,"_5":14891,"_28416":59653,"_3083":60512},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3632":3058,"_31224":2715,"_21643":60514,"_5":14891,"_28416":59656,"_3083":60515},[],"After the upgrade, check in this order:",{"_3632":3059,"_31224":2715,"_21643":60517,"_5":14891,"_28416":59656,"_3083":60518},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3632":3060,"_31224":2715,"_21643":60520,"_5":14891,"_28416":59656,"_3083":60521},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3632":3061,"_31224":2715,"_21643":60523,"_5":14891,"_28416":59656,"_3083":60524},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3632":3062,"_31224":2715,"_21643":60526,"_5":14891,"_28416":59656,"_3083":60527},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3632":3063,"_31224":2715,"_21643":60529,"_5":14891,"_28416":59656,"_3083":60530},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3632":3064,"_31224":2715,"_21643":60532,"_5":14891,"_28416":59656,"_3083":60533},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3632":3065,"_31224":2715,"_21643":60535,"_5":14891,"_28416":59656,"_3083":60536},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3632":3066,"_31224":2715,"_21643":60538,"_5":14891,"_28416":59656,"_3083":60539},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3632":3067,"_31224":2715,"_21643":60541,"_5":14891,"_28416":59656,"_3083":60542},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3632":3068,"_31224":2715,"_21643":60544,"_5":14891,"_28416":59656,"_3083":60545},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3632":3069,"_31224":2715,"_21643":60547,"_5":14891,"_28416":59656,"_3083":60548},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3632":3070,"_31224":2715,"_21643":60550,"_5":14891,"_28416":59656,"_3083":60551},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3632":3071,"_31224":2715,"_21643":60553,"_5":14891,"_28416":59656,"_3083":60554},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3632":3072,"_31224":2715,"_21643":60556,"_5":14891,"_28416":59656,"_3083":60557},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3632":3073,"_31224":2715,"_21643":60559,"_5":14891,"_28416":59656,"_3083":60560},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3632":3074,"_31224":2715,"_21643":60562,"_5":14891,"_28416":59660,"_3083":60563},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3632":3075,"_31224":2715,"_21643":60565,"_5":14891,"_28416":59660,"_3083":60566},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3632":3076,"_31224":2715,"_21643":60568,"_5":14891,"_28416":59660,"_3083":60569},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":3077,"_31224":2715,"_21643":60571,"_5":14891,"_28416":59660,"_3083":60572},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3632":3078,"_31224":2715,"_21643":60574,"_5":14891,"_28416":59660,"_3083":60575},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60578":60579,"_60580":60581,"_60582":60583,"_60584":60585,"_18771":3118,"_72855":3118},"language","english","sortableProperties",[3083,31224,5,28416],"sortablePropertiesWithTypes",{"_3083":25830,"_31224":25830,"_5":25830,"_28416":25830},"sorts",{"_3083":60586,"_31224":63654,"_5":66721,"_28416":69788},{"_4836":60587,"_60588":60589,"_5":25830},{"_14972":3395,"_15351":16356,"_15370":3251,"_30224":4039,"_15357":4244,"_20555":12906,"_14993":7026,"_15000":7921,"_30166":4173,"_30574":6256,"_30601":3501,"_30200":7496,"_35640":3339,"_30303":7823,"_30645":5631,"_35647":15422,"_35650":5354,"_35653":4615,"_35656":13590,"_31047":5152,"_35661":3382,"_35663":7244,"_31082":4766,"_15366":18796,"_35667":4809,"_35670":4550,"_35672":6437,"_30629":20107,"_31067":3255,"_31095":5192,"_35677":15409,"_35679":15021,"_35681":6989,"_30314":3184,"_35684":5355,"_35686":8510,"_35688":20856,"_35690":3813,"_35692":6236,"_30237":7288,"_35695":4040,"_35697":20654,"_30231":7256,"_30666":6793,"_35701":3923,"_35703":3924,"_35706":11029,"_30277":4571,"_35710":5165,"_30157":3565,"_35713":4580,"_30205":20140,"_35716":5298,"_35718":7919,"_35721":20908,"_15360":7867,"_35724":3592,"_35726":12270,"_35729":6065,"_35731":3567,"_35733":14544,"_35735":7295,"_35737":13876,"_20558":5385,"_35740":20855,"_35742":3336,"_30178":7945,"_30623":5386,"_35746":3408,"_35748":4783,"_35750":15230,"_31111":6545,"_35753":5337,"_35755":4150,"_35757":7882,"_31204":4582,"_30682":7393,"_35761":6052,"_35763":26236,"_30215":5474,"_35766":3208,"_31289":4086,"_35769":21279,"_31127":6207,"_30297":3399,"_29677":6082,"_35774":10661,"_35776":4418,"_35778":6750,"_30340":9015,"_35782":19174,"_30617":7345,"_35786":7395,"_35788":4494,"_35790":18401,"_35792":7312,"_35794":7