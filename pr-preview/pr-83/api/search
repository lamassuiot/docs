torial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible."},"1724":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device","type":"page","content":"Registra un dispositivo manualmente","breadcrumbs":["Docs","Plataforma","IoT Fleets","Primeros pasos"],"tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device"},"1725":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device-0","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device","content":"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad."},"1726":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device-1","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar","content":"Antes de empezar"},"1727":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device-2","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","content":"Prepara el DMS"},"1728":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device-3","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","content":"Registra el dispositivo"},"1729":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/reg