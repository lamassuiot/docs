latform/pki/certificate-authorities#define-the-default-issuance","content":"Define the default issuance"},"1900":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-15","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#verify-the-import","content":"Verify the import"},"1901":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-16","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#ca-states","content":"CA states"},"1902":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-17","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"Inspect an authority"},"1903":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-18","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#issue-certificates","content":"Issue certificates"},"1904":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-19","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#revoke-a-ca","content":"Revoke a CA"},"1905":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-20","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#assess-the-impact","content":"Assess the impact"},"1906":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-21","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#start-the-revocation","content":"Start the revocation"},"1907":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-22","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#confirm-the-identity","content":"Confirm the identity"},"1908":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-23","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#check-the-publication","content":"Check the publication"},"1909":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-24","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#delete-a-ca","content":"Delete a CA"},"1910":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-25","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","content":"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA."},"1911":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-26","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","content":"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles."},"1912":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-27","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","content":"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately."},"1913":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-28","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-a-flow","content":"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair."},"1914":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-29","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-a-flow","content":"**New CA from the KMS:** reuse a key already registered in the platform."},"1915":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-30","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-a-flow","content":"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with."},"1916":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-31","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-a-flow","content":"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance."},"1917":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-32","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-a-flow","content":"First time here? Follow Create your first CA to complete the minimal journey."},"1918":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-33","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#before-you-begin","content":"Decide whether the CA will be a root or an intermediate."},"1919":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-34","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#before-you-begin","content":"Choose the engine that will keep the key."},"1920":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-35","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#before-you-begin","content":"Define a validity longer than that of the certificates it will issue."},"1921":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-36","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#before-you-begin","content":"For an intermediate CA, make sure the parent CA is active."},"1922":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-37","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#open-the-wizard","content":"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair."},"1923":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-38","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#configure-the-key","content":"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities."},"1924":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-39","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#configure-the-key","content":"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material."},"1925":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-40","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-the-ca-type","content":"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA."},"1926":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-41","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:"},"1927":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-42","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"`C`: two-letter ISO 3166-1 country code."},"1928":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-43","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"`ST`: state or province."},"1929":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-44","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"`L`: locality."},"1930":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-45","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"`O`: organization."},"1931":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-46","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"`OU`: organizational unit."},"1932":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-47","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"The CA's internal identifier is generated automatically and cannot be changed."},"1933":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-48","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#configure-validity-and-uses","content":"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date."},"1934":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-49","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#configure-validity-and-uses","content":"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers."},"1935":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-50","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#create-and-verify","content":"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign."},"1936":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-51","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#create-and-verify","content":"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities."},"1937":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-52","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#use-a-key-from-the-kms","content":"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile."},"1938":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-53","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#use-a-key-from-the-kms","content":"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy."},"1939":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-54","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#import-an-external-ca","content":"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate."},"1940":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-55","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#import-an-external-ca","content":"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing."},"1941":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-56","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#import-an-external-ca","content":"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle."},"1942":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-57","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#import-an-external-ca","content":"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references."},"1943":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-58","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#select-the-engine","content":"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS."},"1944":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-59","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#load-the-material","content":"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores."},"1945":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-60","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#load-the-material","content":"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually."},"1946":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-61","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-default-issuance","content":"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles."},"1947":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-62","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#verify-the-import","content":"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign."},"1948":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-63","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#verify-the-import","content":"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL)."},"1949":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-64","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#verify-the-import","content":"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication."},"1950":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-65","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#ca-states","content":"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone."},"1951":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-66","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#ca-states","content":"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates)."},"1952":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-67","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#ca-states","content":"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA."},"1953":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-68","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#ca-states","content":"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA."},"1954":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-69","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"Open a CA from the inventory to review:"},"1955":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-70","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"Status and validity period."},"1956":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-71","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"Certificate and chain in PEM format."},"1957":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-72","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"Number of active, expired and revoked certificates."},"1958":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-73","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"Certificates issued in **Issued Certificates**."},"1959":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-74","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"The CRL linked to the authority."},"1960":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-75","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"Metadata and the associated cryptographic engine."},"1961":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-76","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#inspect-an-authority","content":"You can filter the inventory by name, status and CA type."},"1962":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-77","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#issue-certificates","content":"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory."},"1963":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-78","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#issue-certificates","content":"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end."},"1964":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-79","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#issue-certificates","content":"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key."},"1965":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-80","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#issue-certificates","content":"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation."},"1966":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-81","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#issue-certificates","content":"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions."},"1967":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-82","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#issue-certificates","content":"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it."},"1968":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-83","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#revoke-a-ca","content":"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions."},"1969":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-84","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#assess-the-impact","content":"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary."},"1970":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-85","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#start-the-revocation","content":"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`."},"1971":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-86","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#confirm-the-identity","content":"Type the CA's name exactly to enable **Confirm Revocation**."},"1972":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-87","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#check-the-publication","content":"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes."},"1973":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-88","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#delete-a-ca","content":"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it."},"1974":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-89","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#delete-a-ca","content":"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it."},"1975":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-90","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#delete-a-ca","content":"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted."},"1976":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-91","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#delete-a-ca","content":"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it."},"1977":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-92","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#delete-a-ca","content":"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL)."},"1978":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"page","content":"Certificate profiles","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles"},"1979":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-0","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","content":"Define reusable policies to issue consistent certificates and constrain accepted keys."},"1980":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-1","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#what-a-profile-controls","content":"What a profile controls"},"1981":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-2","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#validity","content":"Validity"},"1982":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-3","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","content":"CA certificate or end-entity certificate"},"1983":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-4","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"Key Usage and Extended Key Usage"},"1984":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-5","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#subject","content":"Subject"},"1985":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-6","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#csr-extensions","content":"CSR extensions"},"1986":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-7","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#cryptographic-constraints","content":"Cryptographic constraints"},"1987":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-8","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Profile precedence"},"1988":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-9","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#create-a-profile","content":"Create a profile"},"1989":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-10","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#define-a-single-purpose","content":"Define a single purpose"},"1990":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-11","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#choose-the-validity","content":"Choose the validity"},"1991":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-12","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#fix-usages-and-subject","content":"Fix usages and subject"},"1992":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-13","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#constrain-the-keys","content":"Constrain the keys"},"1993":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-14","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#attach-it-and-test","content":"Attach it and test"},"1994":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-15","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#design-examples","content":"Design examples"},"1995":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-16","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#changes-and-deletion","content":"Changes and deletion"},"1996":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-17","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","content":"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance."},"1997":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-18","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","content":"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements."},"1998":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-19","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#validity","content":"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement."},"1999":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-20","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#validity","content":"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either."},"2000":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-21","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","content":"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed."},"2001":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-22","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`."},"2002":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-23","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile."},"2003":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-24","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","content":"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended."},"2004":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-25","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#subject","content":"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept."},"2005":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-26","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#csr-extensions","content":"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions."},"2006":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-27","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#csr-extensions","content":"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points."},"2007":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-28","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#cryptographic-constraints","content":"The cryptographic enforcement can:"},"2008":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-29","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#cryptographic-constraints","content":"allow or block RSA keys;"},"2009":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-30","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#cryptographic-constraints","content":"limit the supported RSA sizes;"},"2010":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-31","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#cryptographic-constraints","content":"allow or block ECDSA keys;"},"2011":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-32","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#cryptographic-constraints","content":"limit the supported ECDSA sizes or curves."},"2012":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-33","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#cryptographic-constraints","content":"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected."},"2013":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-34","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile."},"2014":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-35","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Operation"},"2015":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-36","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"First choice"},"2016":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-37","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Second choice"},"2017":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-38","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"If neither is supplied"},"2018":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-39","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Direct signing with a CA"},"2019":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-40","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"`issuance_profile` embedded in the request"},"2020":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-41","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Request `issuance_profile_id`"},"2021":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-42","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"CA default profile (`profile_id`)."},"2022":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-43","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Issuance through a DMS"},"2023":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-44","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"`settings.issuance_profile_id`"},"2024":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-45","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"`settings.issuance_profile` embedded in the DMS"},"2025":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-46","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Enrollment CA default profile."},"2026":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-47","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR."},"2027":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-48","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#profile-precedence","content":"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS."},"2028":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-49","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#define-a-single-purpose","content":"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use."},"2029":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-50","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#choose-the-validity","content":"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration."},"2030":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-51","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#fix-usages-and-subject","content":"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it."},"2031":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-52","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#constrain-the-keys","content":"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices."},"2032":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-53","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#attach-it-and-test","content":"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present."},"2033":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-54","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#attach-it-and-test","content":"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer."},"2034":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-55","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#design-examples","content":"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device."},"2035":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-56","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#design-examples","content":"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use."},"2036":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-57","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#design-examples","content":"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints."},"2037":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-58","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#design-examples","content":"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer."},"2038":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-59","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#changes-and-deletion","content":"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification."},"2039":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles-60","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-profiles#changes-and-deletion","content":"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one."},"2040":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","type":"page","content":"Certificate validation","breadcrumbs":["Docs","Platform","PKI","Validation"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation"},"2041":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-0","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","content":"Check chain, identity, purpose and revocation from the consumer."},"2042":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-1","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Before querying status"},"2043":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-2","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"Choose a mechanism"},"2044":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-3","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"Check consumer behavior"},"2045":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-4","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","content":"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy."},"2046":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-5","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Verify these criteria together:"},"2047":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-6","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Check"},"2048":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-7","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Required result"},"2049":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-8","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Chain and signature"},"2050":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-9","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Valid chain to a root deliberately installed in the consumer."},"2051":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-10","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Dates"},"2052":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-11","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Current time between `Not Before` and `Not After`, including the CAs in the chain."},"2053":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-12","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Identity"},"2054":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-13","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Name, SAN or identifier matches the expected peer."},"2055":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-14","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Purpose"},"2056":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-15","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"KU, EKU and constraints permit the specific operation."},"2057":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-16","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Revocation"},"2058":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-17","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Signed, current evidence corresponding to the queried issuer and certificate."},"2059":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-18","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"Authorization"},"2060":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-19","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"The application permits that identity to perform the action."},"2061":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-20","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#before-querying-status","content":"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria."},"2062":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-21","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"Mechanism"},"2063":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-22","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"When to use it"},"2064":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-23","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"What you must maintain"},"2065":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-24","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"OCSP"},"2066":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-25","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"Status query for a specific certificate."},"2067":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-26","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"Responder access, signature verification and cache/freshness policy."},"2068":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-27","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"CRL"},"2069":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-28","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"Local checks for many certificates or offline operation."},"2070":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-29","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"Periodic download of an issuer-signed list and rejection of expired lists."},"2071":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-30","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved."},"2072":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-31","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#choose-a-mechanism","content":"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision."},"2073":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-32","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"Accept a current, authorized certificate with a known chain."},"2074":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-33","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"Reject another certificate with an unknown root or incompatible purpose."},"2075":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-34","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"Revoke a test certificate and verify the OCSP response or new CRL."},"2076":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-35","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"Check that a new connection with that identity is rejected."},"2077":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-36","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy."},"2078":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-37","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it."},"2079":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-38","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain."},"2080":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-39","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />"},"2081":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation-40","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-validation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-validation#check-consumer-behavior","content":"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />"},"2082":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"page","content":"Certificates","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates"},"2083":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-0","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates","content":"Inspect, download and revoke the certificates issued by Lamassu."},"2084":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-1","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"Find a certificate"},"2085":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-2","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#download-the-certificate","content":"Download the certificate"},"2086":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-3","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"Issue from an existing CSR"},"2087":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-4","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#revoke-a-certificate","content":"Revoke a certificate"},"2088":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-5","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#open-the-action","content":"Open the action"},"2089":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-6","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#choose-a-reason","content":"Choose a reason"},"2090":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-7","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#confirm-and-verify","content":"Confirm and verify"},"2091":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-8","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#reactivate-a-hold","content":"Reactivate a hold"},"2092":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-9","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificates#continue","content":"Continue"},"2093":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-10","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates","content":"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer."},"2094":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-11","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:"},"2095":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-12","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**."},"2096":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-13","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`."},"2097":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-14","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu."},"2098":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-15","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata."},"2099":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-16","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade."},"2100":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-17","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#find-a-certificate","content":"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions."},"2101":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-18","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#download-the-certificate","content":"Download the PEM and inspect it:"},"2102":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-19","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#download-the-certificate","content":"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate."},"2103":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-20","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile."},"2104":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-21","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity."},"2105":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-22","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"Start issuance from the CA or inventory and select **Upload Existing CSR**."},"2106":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-23","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained."},"2107":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-24","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system."},"2108":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-25","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration."},"2109":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-26","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#issue-from-an-existing-csr","content":"For browser key generation, follow Issue your first certificate."},"2110":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-27","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#revoke-a-certificate","content":"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement."},"2111":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-28","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#open-the-action","content":"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes."},"2112":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-29","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#choose-a-reason","content":"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key."},"2113":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-30","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#confirm-and-verify","content":"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer."},"2114":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-31","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#confirm-and-verify","content":"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps."},"2115":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-32","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#confirm-and-verify","content":"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory."},"2116":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-33","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#reactivate-a-hold","content":"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu."},"2117":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-34","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#reactivate-a-hold","content":"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy."},"2118":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-35","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#reactivate-a-hold","content":"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA."},"2119":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-36","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#continue","content":"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />"},"2120":{"id":"/docs/pr-preview/pr-83/platform/pki/certificates-37","page_id":"/docs/pr-preview/pr-83/platform/pki/certificates","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificates#continue","content":"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />"},"2121":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"page","content":"Certificate lifecycle","breadcrumbs":["Docs","Platform","PKI","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle"},"2122":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-0","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","content":"Issuance, use, renewal, revocation and retirement of certificates in Lamassu."},"2123":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-1","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#the-full-journey","content":"The full journey"},"2124":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-2","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#request","content":"Request"},"2125":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-3","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#issuance","content":"Issuance"},"2126":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-4","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","content":"Use and monitoring"},"2127":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-5","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","content":"Renewal or re-enrollment"},"2128":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-6","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","content":"Revocation or retirement"},"2129":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-7","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"Certificate states"},"2130":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-8","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"Renewal and revocation are not equivalent"},"2131":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-9","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Effect of revoking a CA"},"2132":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-10","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"What you should watch"},"2133":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-11","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","content":"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to."},"2134":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-12","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#request","content":"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it."},"2135":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-13","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#issuance","content":"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints."},"2136":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-14","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","content":"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`."},"2137":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-15","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","content":"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST."},"2138":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-16","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","content":"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status."},"2139":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-17","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"Lamassu persists four X.509 states:"},"2140":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-18","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity."},"2141":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-19","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually."},"2142":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-20","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp."},"2143":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-21","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"**`INACTIVE`**: it is disabled without representing a definitive revocation."},"2144":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-22","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#certificate-states","content":"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states."},"2145":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-23","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity."},"2146":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-24","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation."},"2147":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-25","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","content":"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period."},"2148":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-26","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks."},"2149":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-27","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Before confirming:"},"2150":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-28","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Identify DMSs, devices and services that trust that chain."},"2151":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-29","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Distribute the new chain of trust."},"2152":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-30","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Reissue the necessary identities."},"2153":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-31","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Check OCSP and CRL from a real consumer."},"2154":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-32","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Revoke the old CA once no legitimate traffic remains."},"2155":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-33","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","content":"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management."},"2156":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-34","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Certificates entering the preventive or critical renewal window."},"2157":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-35","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Repeated enrollment or re-enrollment failures."},"2158":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-36","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Status changes and revocation reasons."},"2159":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-37","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"OCSP and CRL publication and validity."},"2160":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-38","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"Dependencies still presenting a replaced certificate."},"2161":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle-39","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","content":"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs."},"2162":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"page","content":"Trust model","breadcrumbs":["Docs","Platform","PKI","Concepts"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model"},"2163":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-0","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","content":"Understand where trust originates, how it is distributed and what each component validates."},"2164":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-1","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#the-four-trust-decisions","content":"The four trust decisions"},"2165":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-2","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#who-can-issue","content":"Who can issue"},"2166":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-3","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#what-can-be-issued","content":"What can be issued"},"2167":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-4","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#who-can-request-it","content":"Who can request it"},"2168":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-5","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#who-accepts-the-result","content":"Who accepts the result"},"2169":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-6","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#identity-flow","content":"Identity flow"},"2170":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-7","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"Enrollment, validation and distribution CAs"},"2171":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-8","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"Validation and revocation"},"2172":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-9","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#custody-limits","content":"Custody limits"},"2173":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-10","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Recommended pattern"},"2174":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-11","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","content":"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid."},"2175":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-12","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#who-can-issue","content":"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance."},"2176":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-13","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#what-can-be-issued","content":"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy."},"2177":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-14","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#who-can-request-it","content":"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity."},"2178":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-15","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#who-accepts-the-result","content":"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root."},"2179":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-16","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#identity-flow","content":"The device proves it can enroll according to the DMS policy."},"2180":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-17","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#identity-flow","content":"The DMS validates the request and forwards the CSR to the enrollment CA."},"2181":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-18","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#identity-flow","content":"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key."},"2182":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-19","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#identity-flow","content":"The device installs the certificate and the chain it needs."},"2183":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-20","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#identity-flow","content":"The system that trusts the device validates the chain, dates, uses and revocation status."},"2184":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-21","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#identity-flow","content":"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy."},"2185":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-22","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"A DMS relates three sets that are worth designing separately:"},"2186":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-23","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Enrollment CA:** signs the new identities."},"2187":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-24","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional."},"2188":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-25","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors."},"2189":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-26","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","content":"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap."},"2190":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-27","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:"},"2191":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-28","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"that the current date is between `Not Before` and `Not After`;"},"2192":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-29","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"that `Key Usage` and `Extended Key Usage` allow the operation;"},"2193":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-30","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"that names, SANs and subject match the expected identity;"},"2194":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-31","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"that the certificate does not appear revoked in OCSP or a CRL."},"2195":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-32","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together."},"2196":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-33","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#validation-and-revocation","content":"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds."},"2197":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-34","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#custody-limits","content":"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations."},"2198":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-35","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Keep the root out of daily operations, or with very restricted access."},"2199":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-36","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Issue from intermediate CAs separated by environment or risk domain."},"2200":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-37","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Assign explicit profiles to every use case."},"2201":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-38","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Distribute the new trust before starting a rotation."},"2202":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-39","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Keep enough overlap to renew a disconnected fleet."},"2203":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-40","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Validate from the consuming system, not only from the Lamassu console."},"2204":{"id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model-41","page_id":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/concepts/trust-model#recommended-pattern","content":"Continue with CA hierarchy and rotation to turn this model into an operating procedure."},"2205":{"id":"/docs/pr-preview/pr-83/platform/pki/crl","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"page","content":"Revocation lists (CRL)","breadcrumbs":["Docs","Platform","PKI","Validation"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl"},"2206":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-0","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl","content":"Generate and distribute signed lists to validate certificates offline."},"2207":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-1","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"CRL settings"},"2208":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-2","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#cas-that-share-a-key","content":"CAs that share a key"},"2209":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-3","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"Periodic and automatic regeneration"},"2210":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-4","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-contents","content":"CRL contents"},"2211":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-5","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#public-download-endpoint","content":"Public download endpoint"},"2212":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-6","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"CRL settings API"},"2213":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-7","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Common CRL settings errors"},"2214":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-8","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/crl#references","content":"References"},"2215":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-9","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl","content":"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence."},"2216":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-10","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL."},"2217":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-11","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Field"},"2218":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-12","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Purpose"},"2219":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-13","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`ca_id`"},"2220":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-14","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"ID of the CA the settings belong to."},"2221":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-15","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`status`"},"2222":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-16","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated."},"2223":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-17","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`legacy_ski`"},"2224":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-18","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them."},"2225":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-19","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`latest_crl`"},"2226":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-20","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Version, validity start and end of the last published list. Read-only."},"2227":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-21","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`crl_options` field"},"2228":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-22","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Purpose"},"2229":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-23","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Initial value"},"2230":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-24","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`validity`"},"2231":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-25","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Time from `thisUpdate` to `nextUpdate`."},"2232":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-26","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"7 days."},"2233":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-27","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`refresh_interval`"},"2234":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-28","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration)."},"2235":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-29","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"6 days and 23 hours."},"2236":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-30","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`regenerate_on_revoke`"},"2237":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-31","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Request regeneration on revocation or reactivation from `CertificateHold` events."},"2238":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-32","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`true`."},"2239":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-33","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`signer_serial_number`"},"2240":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-34","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Serial number of the existing certificate that signs the CRL."},"2241":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-35","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Serial number of the CA’s current certificate."},"2242":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-36","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected."},"2243":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-37","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`."},"2244":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-38","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior."},"2245":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-39","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer."},"2246":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-40","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:"},"2247":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-41","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`."},"2248":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-42","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration."},"2249":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-43","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA."},"2250":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-44","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set."},"2251":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-45","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key."},"2252":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-46","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings","content":"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served."},"2253":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-47","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#cas-that-share-a-key","content":"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity."},"2254":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-48","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#cas-that-share-a-key","content":"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window."},"2255":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-49","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#cas-that-share-a-key","content":"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued."},"2256":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-50","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#cas-that-share-a-key","content":"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs."},"2257":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-51","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:"},"2258":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-52","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled."},"2259":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-53","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire."},"2260":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-54","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows."},"2261":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-55","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle."},"2262":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-56","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing."},"2263":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-57","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL."},"2264":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-58","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it."},"2265":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-59","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#periodic-and-automatic-regeneration","content":"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable."},"2266":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-60","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-contents","content":"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents."},"2267":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-61","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-contents","content":"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation."},"2268":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-62","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#public-download-endpoint","content":"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:"},"2269":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-63","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#public-download-endpoint","content":"Replace the following URL with the CDP URL and review exposure in Deployment:"},"2270":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-64","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#public-download-endpoint","content":"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:"},"2271":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-65","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#public-download-endpoint","content":"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them."},"2272":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-66","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#public-download-endpoint","content":"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial."},"2273":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-67","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints."},"2274":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-68","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"Method"},"2275":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-69","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"Relative path"},"2276":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-70","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"Operation"},"2277":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-71","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`GET`"},"2278":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-72","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`/v1/crl-settings`"},"2279":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-73","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`."},"2280":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-74","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`GET`"},"2281":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-75","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`/v1/crl-settings/{ca-id}`"},"2282":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-76","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"Read the `crl_options` and `latest_crl` of a CA."},"2283":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-77","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`PUT`"},"2284":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-78","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`/v1/crl-settings/{ca-id}`"},"2285":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-79","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"Replace the CRL configuration of a CA."},"2286":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-80","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`DELETE`"},"2287":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-81","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"`/v1/crl-settings/{ca-id}`"},"2288":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-82","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"Remove the archived CRL settings of a CA."},"2289":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-83","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL."},"2290":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-84","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone."},"2291":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-85","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#crl-settings-api","content":"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance."},"2292":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-86","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Symptom"},"2293":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-87","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Cause"},"2294":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-88","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Action"},"2295":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-89","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"`PUT /v1/crl-settings/{ca-id}` returns 409."},"2296":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-90","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade."},"2297":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-91","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"There is no API way back to `ACTIVE`. The last CRL keeps being served."},"2298":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-92","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"`DELETE /v1/crl-settings/{ca-id}` returns 409."},"2299":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-93","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"The settings are not yet `ARCHIVED`: the CA has not been deleted."},"2300":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-94","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Delete the CA first; deleting it archives its settings."},"2301":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-95","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"`PUT` returns 400."},"2302":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-96","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"The new signer lacks `cRLSign`, or its subject and public key do not match the CA."},"2303":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-97","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Set the serial number of a valid certificate of that CA."},"2304":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-98","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"`PUT` returns 404."},"2305":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-99","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`."},"2306":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-100","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Check the CA ID and the signer serial number."},"2307":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-101","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"`PUT` returns 400 from a 3.x client."},"2308":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-102","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required."},"2309":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-103","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Update the client to send the new field."},"2310":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-104","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"The CRL does not change after revoking a certificate."},"2311":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-105","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer."},"2312":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-106","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer."},"2313":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-107","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"A verifier rejects the CRL because of the issuer."},"2314":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-108","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran."},"2315":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-109","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#common-crl-settings-errors","content":"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs."},"2316":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-110","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#references","content":"RFC 5280: X.509 and CRL profile."},"2317":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-111","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#references","content":"OpenSSL: openssl-crl."},"2318":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-112","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#references","content":"OpenSSL: openssl-verify."},"2319":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-113","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#references","content":"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />"},"2320":{"id":"/docs/pr-preview/pr-83/platform/pki/crl-114","page_id":"/docs/pr-preview/pr-83/platform/pki/crl","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/crl#references","content":"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />"},"2321":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"page","content":"Keys and cryptographic engines","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management"},"2322":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-0","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management","content":"Generate, import and operate keys without coupling the PKI to a specific provider."},"2323":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-1","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#what-the-kms-solves","content":"What the KMS solves"},"2324":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-2","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#cryptographic-engines","content":"Cryptographic engines"},"2325":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-3","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#file-system","content":"File System"},"2326":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-4","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#hashicorp-vault","content":"HashiCorp Vault"},"2327":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-5","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#aws-secrets-manager","content":"AWS Secrets Manager"},"2328":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-6","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#aws-kms","content":"AWS KMS"},"2329":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-7","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#pkcs11","content":"PKCS#11"},"2330":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-8","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#azure-key-vault","content":"Azure Key Vault"},"2331":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"Key inventory"},"2332":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#create-or-import-keys","content":"Create or import keys"},"2333":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#generate-a-new-key-pair","content":"Generate a new key pair"},"2334":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#import-an-existing-pair","content":"Import an existing pair"},"2335":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#operations-on-a-key","content":"Operations on a key"},"2336":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#view-details","content":"View details"},"2337":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#sign-and-verify","content":"Sign and verify"},"2338":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#sign","content":"Sign"},"2339":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#verify","content":"Verify"},"2340":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#generate-a-csr","content":"Generate a CSR"},"2341":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#sign-locally-with-pkcs11","content":"Sign locally with PKCS#11"},"2342":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/key-management#before-deleting-a-key","content":"Before deleting a key"},"2343":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management","content":"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI."},"2344":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management","content":"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system."},"2345":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#what-the-kms-solves","content":"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider."},"2346":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#what-the-kms-solves","content":"In practice, it lets you:"},"2347":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#what-the-kms-solves","content":"Generate new key pairs from Lamassu IoT."},"2348":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#what-the-kms-solves","content":"Import keys created externally."},"2349":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#what-the-kms-solves","content":"Delegate custody and cryptographic operations to external engines."},"2350":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#what-the-kms-solves","content":"Reuse existing keys for CAs, CSRs and signing or verification tasks."},"2351":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#cryptographic-engines","content":"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform."},"2352":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#cryptographic-engines","content":"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements."},"2353":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#cryptographic-engines","content":"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration."},"2354":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#file-system","content":"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files."},"2355":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#hashicorp-vault","content":"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner."},"2356":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#hashicorp-vault","content":"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner."},"2357":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#aws-secrets-manager","content":"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM."},"2358":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#aws-kms","content":"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations."},"2359":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#pkcs11","content":"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody."},"2360":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#azure-key-vault","content":"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations."},"2361":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#azure-key-vault","content":"Lamassu shows the enabled engines in the console."},"2362":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#azure-key-vault","content":"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate."},"2363":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#azure-key-vault","content":"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA."},"2364":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to."},"2365":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"The table includes the following fields:"},"2366":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Name**: descriptive name of the key."},"2367":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Type**: algorithm and key size, for example RSA 2048 or EC P-256."},"2368":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Strength**: visual indicator of cryptographic strength."},"2369":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Public/Private**: whether Lamassu manages the full pair or only the public key."},"2370":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Crypto Engine**: cryptographic engine keeping the key."},"2371":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Aliases**: alternative names associated with the key."},"2372":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Tags**: labels for classification and search."},"2373":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-83/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/key-management#key-inventory","content":"**Related Entities**: certificates or other entities linked to that key."},"2374":{"id":"/docs/pr-preview/pr-83/platform/pki/key-management-52","page_id":"/d