pe":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#azure-key-vault","content":"Azure Key Vault"},"2330":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-9","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"Inventario de claves"},"2331":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-10","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#crear-o-importar-claves","content":"Crear o importar claves"},"2332":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-11","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Generar un nuevo par de claves"},"2333":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-12","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"Importar un par existente"},"2334":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-13","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#operaciones-sobre-una-clave","content":"Operaciones sobre una clave"},"2335":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-14","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"Ver detalles"},"2336":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-15","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#firmar-y-verificar","content":"Firmar y verificar"},"2337":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-16","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"Sign"},"2338":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-17","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"Verify"},"2339":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-18","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"Generar un CSR"},"2340":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-19","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#firma-local-con-pkcs11","content":"Firma local con PKCS#11"},"2341":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-20","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#antes-de-eliminar-una-clave","content":"Antes de eliminar una clave"},"2342":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-21","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management","content":"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI."},"2343":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-22","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management","content":"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema."},"2344":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-23","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#qué-resuelve-el-kms","content":"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto."},"2345":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-24","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#qué-resuelve-el-kms","content":"En la práctica, permite:"},"2346":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-25","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Generar nuevos pares de claves desde Lamassu IoT."},"2347":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-26","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Importar claves creadas externamente."},"2348":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-27","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Delegar la custodia y las operaciones criptográficas en motores externos."},"2349":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-28","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#qué-resuelve-el-kms","content":"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación."},"2350":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-29","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#motores-criptográficos","content":"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada."},"2351":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-30","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#motores-criptográficos","content":"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios."},"2352":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-31","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#motores-criptográficos","content":"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración."},"2353":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-32","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#file-system","content":"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos."},"2354":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-33","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#hashicorp-vault","content":"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue."},"2355":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-34","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#hashicorp-vault","content":"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue."},"2356":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-35","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#aws-secrets-manager","content":"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM."},"2357":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-36","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#aws-kms","content":"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas."},"2358":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-37","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#pkcs11","content":"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware."},"2359":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-38","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#azure-key-vault","content":"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias."},"2360":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-39","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#azure-key-vault","content":"Lamassu muestra en la consola el listado de motores habilitados."},"2361":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-40","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#azure-key-vault","content":"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar."},"2362":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-41","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#azure-key-vault","content":"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA."},"2363":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-42","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas."},"2364":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-43","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"La tabla incluye los siguientes campos:"},"2365":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-44","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Name**: nombre descriptivo de la clave."},"2366":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-45","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256."},"2367":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-46","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Strength**: indicador visual de fortaleza criptográfica."},"2368":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-47","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública."},"2369":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-48","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Crypto Engine**: motor criptográfico que custodia la clave."},"2370":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-49","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Aliases**: nombres alternativos asociados a la clave."},"2371":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-50","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Tags**: etiquetas para clasificación y búsqueda."},"2372":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-51","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Related Entities**: certificados u otras entidades vinculadas a esa clave."},"2373":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-52","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"Desde esta vista también se accede a las acciones más habituales:"},"2374":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-53","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**View Details** para consultar metadatos, identificadores y relaciones."},"2375":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-54","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada."},"2376":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-55","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Sign / Verify** para probar operaciones criptográficas sobre la clave."},"2377":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-56","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","content":"**Delete Key** para eliminar la clave del sistema."},"2378":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-57","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#crear-o-importar-claves","content":"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación."},"2379":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-58","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados."},"2380":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-59","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:"},"2381":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-60","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Key Name**: nombre único y descriptivo."},"2382":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-61","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Crypto Engine**: motor que custodiará la clave."},"2383":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-62","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Key Type** y **Key Size**: algoritmo y tamaño o curva."},"2384":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-63","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Tags**: metadatos para clasificar la clave."},"2385":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-64","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","content":"**Metadata**: información adicional para usos avanzados."},"2386":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-65","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción."},"2387":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-66","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"Cuando tienes una clave privada exportable y el motor de destino admite su importación."},"2388":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-67","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"Cuando se necesita migrar una PKI existente sin reemitir certificados."},"2389":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-68","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero."},"2390":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-69","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:"},"2391":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-70","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"**Key Name**: nombre descriptivo dentro de Lamassu IoT."},"2392":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-71","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"**Crypto Engine**: motor que custodiará la clave importada."},"2393":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-72","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"**Tags**: etiquetas para organización y búsqueda."},"2394":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-73","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"**Metadata**: información adicional opcional."},"2395":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-74","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"**Private Key (PEM)**: clave privada en formato PEM."},"2396":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-75","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","content":"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad."},"2397":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-76","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#operaciones-sobre-una-clave","content":"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas."},"2398":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-77","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"La pantalla **View Details** concentra la información técnica y administrativa de la clave."},"2399":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-78","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"En la pestaña **Overview** se muestran, entre otros, estos campos:"},"2400":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-79","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"**Key Name**: nombre descriptivo."},"2401":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-80","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11."},"2402":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-81","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"**Tags**: etiquetas asociadas."},"2403":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-82","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"**Aliases**: nombres alternativos."},"2404":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-83","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"**Crypto Engine**: motor en el que reside la clave."},"2405":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-84","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza."},"2406":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-85","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave."},"2407":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-86","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","content":"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella."},"2408":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-87","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#firmar-y-verificar","content":"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente."},"2409":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-88","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#firmar-y-verificar","content":"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA."},"2410":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-89","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#firmar-y-verificar","content":"Al abrirla aparecen dos áreas: **Sign** y **Verify**."},"2411":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-90","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado."},"2412":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-91","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"Campos principales:"},"2413":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-92","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"**Algorithm**: algoritmo de firma disponible para el tipo de clave."},"2414":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-93","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado."},"2415":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-94","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64."},"2416":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-95","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"**Message**: contenido que se va a firmar."},"2417":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-96","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign","content":"**Signature**: resultado de la operación, mostrado en hexadecimal."},"2418":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-97","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"Esta pestaña comprueba si una firma corresponde a la clave pública asociada."},"2419":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-98","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"Campos principales:"},"2420":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-99","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"**Algorithm**: debe coincidir con el algoritmo usado para la firma."},"2421":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-100","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"**Message Type**: `Raw` o `Digest`."},"2422":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-101","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"**Payload Encoding**: codificación del mensaje."},"2423":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-102","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"**Message**: mensaje original o hash."},"2424":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-103","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"**Signature**: firma que se desea comprobar."},"2425":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-104","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify","content":"**Result**: indicador del resultado de la validación."},"2426":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-105","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico."},"2427":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-106","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"Este flujo es útil para:"},"2428":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-107","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"Solicitar certificados a una CA externa."},"2429":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-108","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"Renovar una identidad manteniendo la misma clave."},"2430":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-109","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:"},"2431":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-110","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**Common Name (CN)**: nombre principal de la identidad."},"2432":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-111","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**Organization (O)**: organización o empresa."},"2433":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-112","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**Organizational Unit (OU)**: departamento o unidad."},"2434":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-113","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**Country (C)**: código de país de dos letras."},"2435":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-114","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**State / Province (ST)**: estado o provincia."},"2436":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-115","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**Locality (L)**: ciudad o localidad."},"2437":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-116","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**Email Address**: correo de contacto."},"2438":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-117","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP."},"2439":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-118","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","content":"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos."},"2440":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-119","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#firma-local-con-pkcs11","content":"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**."},"2441":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-120","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#firma-local-con-pkcs11","content":"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue."},"2442":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-121","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#antes-de-eliminar-una-clave","content":"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor."},"2443":{"id":"/docs/pr-preview/pr-83/es/platform/pki/key-management-122","page_id":"/docs/pr-preview/pr-83/es/platform/pki/key-management","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/key-management#antes-de-eliminar-una-clave","content":"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración."},"2444":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","type":"page","content":"Validación online con OCSP","breadcrumbs":["Docs","Plataforma","PKI","Validación"],"tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp"},"2445":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-0","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","content":"Consulta el estado firmado y verifica la respuesta del respondedor."},"2446":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-1","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"Cómo funciona el respondedor en Lamassu"},"2447":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-2","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","content":"Enlace en los certificados emitidos"},"2448":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-3","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"Endpoints HTTP"},"2449":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-4","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","content":"Genera y verifica una consulta"},"2450":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-5","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#comprobación-desde-la-interfaz","content":"Comprobación desde la interfaz"},"2451":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-6","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#referencias","content":"Referencias"},"2452":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-7","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","content":"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados."},"2453":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-8","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:"},"2454":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-9","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"Estado del registro"},"2455":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-10","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"Respuesta firmada"},"2456":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-11","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"`ACTIVE`"},"2457":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-12","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"`Good`."},"2458":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-13","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"`REVOKED`"},"2459":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-14","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"`Revoked`, con razón y fecha de revocación."},"2460":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-15","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"Otros estados, incluidos `INACTIVE` y `EXPIRED`"},"2461":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-16","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"`Unknown` si puede obtener el certificado y su emisor."},"2462":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-17","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor."},"2463":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-18","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas."},"2464":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-19","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","content":"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar."},"2465":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-20","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","content":"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:"},"2466":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-21","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","content":"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados."},"2467":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-22","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"El servicio acepta:"},"2468":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-23","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"Método"},"2469":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-24","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"Ruta del servicio VA"},"2470":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-25","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"Formato"},"2471":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-26","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"`POST`"},"2472":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-27","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"`/ocsp`"},"2473":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-28","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"Solicitud DER, `Content-Type: application/ocsp-request`."},"2474":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-29","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"`GET`"},"2475":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-30","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"`/ocsp/{ocsp_request}`"},"2476":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-31","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"Solicitud DER codificada en Base64 URL con padding."},"2477":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-32","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","content":"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador."},"2478":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-33","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","content":"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias."},"2479":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-34","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","content":"Genera la solicitud:"},"2480":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-35","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","content":"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce."},"2481":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-36","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","content":"Sustituye la URL de ejemplo por el endpoint inspeccionado:"},"2482":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-37","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","content":"Verifica el DER recibido:"},"2483":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-38","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","content":"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando."},"2484":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-39","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#comprobación-desde-la-interfaz","content":"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación."},"2485":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-40","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#comprobación-desde-la-interfaz","content":"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI."},"2486":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-41","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#referencias","content":"RFC 6960: OCSP."},"2487":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-42","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#referencias","content":"OpenSSL: openssl-ocsp."},"2488":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-43","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#referencias","content":"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />"},"2489":{"id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp-44","page_id":"/docs/pr-preview/pr-83/es/platform/pki/ocsp","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/ocsp#referencias","content":"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />"},"2490":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"page","content":"PKI","breadcrumbs":["Docs","Plataforma","PKI"],"tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview"},"2491":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-0","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview","content":"Administra claves y autoridades, define la emisión y verifica los certificados resultantes."},"2492":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-1","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#empieza-aquí","content":"Empieza aquí"},"2493":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-2","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#qué-necesitas","content":"Qué necesitas"},"2494":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-3","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#capacidades-principales","content":"Capacidades principales"},"2495":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-4","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#construye-tu-jerarquía-de-confianza","content":"Construye tu jerarquía de confianza"},"2496":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-5","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#protege-las-claves-criptográficas","content":"Protege las claves criptográficas"},"2497":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-6","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#emite-y-controla-certificados","content":"Emite y controla certificados"},"2498":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-7","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#publica-el-estado-de-validación","content":"Publica el estado de validación"},"2499":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-8","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"Cómo comprobar el resultado"},"2500":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-9","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/pki/overview#continúa","content":"Continúa"},"2501":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-10","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview","content":"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor."},"2502":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-11","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#empieza-aquí","content":"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada."},"2503":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-12","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#empieza-aquí","content":"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets."},"2504":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-13","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#qué-necesitas","content":"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás."},"2505":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-14","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#qué-necesitas","content":"Un motor criptográfico disponible para custodiar la clave de la autoridad."},"2506":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-15","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#qué-necesitas","content":"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS."},"2507":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-16","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#qué-necesitas","content":"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos."},"2508":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-17","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#qué-necesitas","content":"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza."},"2509":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-18","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#construye-tu-jerarquía-de-confianza","content":"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad."},"2510":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-19","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#protege-las-claves-criptográficas","content":"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión."},"2511":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-20","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#emite-y-controla-certificados","content":"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado."},"2512":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-21","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#publica-el-estado-de-validación","content":"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado."},"2513":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-22","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:"},"2514":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-23","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"su sujeto y sus extensiones identifiquen al cliente esperado;"},"2515":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-24","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"su clave pública corresponda a la clave privada del cliente;"},"2516":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-25","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"su cadena alcance una raíz confiable para el consumidor;"},"2517":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-26","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"sus fechas y usos permitan la operación;"},"2518":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-27","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"el consumidor aplique la comprobación de revocación y su autorización."},"2519":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-28","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","content":"El recorrido de emisión incluye las primeras comprobaciones independientes."},"2520":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-29","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#continúa","content":"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />"},"2521":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-30","page_id":"/docs/pr-preview/pr-83/es/platform/pki/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/pki/overview#continúa","content":"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />"},"2522":{"id":"/docs/pr-preview/pr-83/es/platform/pki/overview-31","page_id":"/docs/pr-preview/pr