/pr-preview/pr-83/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/overview#operational-reference","content":"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment."},"1834":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"page","content":"CA hierarchy and rotation","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation"},"1835":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-0","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","content":"Design root and intermediate authorities and replace certificates or keys without breaking trust."},"1836":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-1","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Design the hierarchy"},"1837":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-2","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Reissuance and rotation are not the same"},"1838":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-3","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"When to choose each operation"},"1839":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-4","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","content":"Key rotation procedure"},"1840":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-5","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Inventory the dependencies"},"1841":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-6","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Create the successor CA"},"1842":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-7","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Distribute the new trust"},"1843":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-8","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Switch issuance"},"1844":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-9","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Renew in batches"},"1845":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-10","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Close the overlap"},"1846":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-11","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Cascading revocation"},"1847":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-12","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Checks after the change"},"1848":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-13","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","content":"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust."},"1849":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-14","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","content":"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap."},"1850":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-15","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:"},"1851":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-16","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"environment, such as production and preproduction;"},"1852":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-17","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"owner or operating team;"},"1853":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-18","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"device family or manufacturing process;"},"1854":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-19","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"region or regulatory requirement;"},"1855":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-20","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"cryptographic engine or key policy;"},"1856":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-21","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"maintenance window and renewal cadence."},"1857":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-22","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew."},"1858":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-23","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates."},"1859":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-24","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata."},"1860":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-25","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide."},"1861":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-26","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies."},"1862":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-27","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions."},"1863":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-28","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate."},"1864":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-29","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine."},"1865":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-30","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Create a parallel branch if you cannot update all consumers at the same time."},"1866":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-31","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet."},"1867":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-32","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months."},"1868":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-33","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation."},"1869":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-34","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity."},"1870":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-35","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting."},"1871":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-36","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain."},"1872":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-37","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it."},"1873":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-38","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed."},"1874":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-39","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes."},"1875":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-40","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored."},"1876":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-41","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows."},"1877":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-42","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The new chain ends in an anchor installed by the consumer."},"1878":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-43","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"New certificates contain the expected AKI, SKI, KU, EKU and SAN."},"1879":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-44","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The DMS delivers the correct chain through EST `/cacerts`."},"1880":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-45","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Re-enrollment accepts the old identity during the planned period."},"1881":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-46","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"OCSP and CRL respond for the authorities that remain active."},"1882":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-47","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"No DMS is left accidentally issuing from the old CA."},"1883":{"id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation-48","page_id":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects."},"1884":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"page","content":"Certification authorities","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities"},"1885":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-0","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","content":"Create, import and operate the authorities that establish your PKI's trust."},"1886":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-1","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-a-flow","content":"Choose a flow"},"1887":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-2","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#create-a-new-authority","content":"Create a new authority"},"1888":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-3","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#before-you-begin","content":"Before you begin"},"1889":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-4","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#open-the-wizard","content":"Open the wizard"},"1890":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-5","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#configure-the-key","content":"Configure the key"},"1891":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-6","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#choose-the-ca-type","content":"Choose the CA type"},"1892":{"id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities-7","page_id":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/platform/pki/certificate-authorities#define-the-identity","content":"Define the identity"},"1893":{