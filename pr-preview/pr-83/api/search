-fleets/enrollment/dms-40","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Uno de los cuatro modos de autenticación."},"982":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-41","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#enrollment-settings","content":"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales."},"983":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-42","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Los bloques son independientes:"},"984":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-43","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`."},"985":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-44","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`."},"986":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-45","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`auth_mode`"},"987":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-46","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Control aplicado en la operación configurada"},"988":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-47","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`CLIENT_CERTIFICATE`"},"989":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-48","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Validación del certificado presentado."},"990":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-49","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`EXTERNAL_WEBHOOK`"},"991":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-50","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Autorización del webhook configurado."},"992":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-51","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`"},"993":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-52","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Validación del certificado y, después, aprobación del webhook."},"994":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-53","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"`NO_AUTH`"},"995":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-54","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Sin autenticación del solicitante por el DMS."},"996":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-55","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla."},"997":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-56","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway."},"998":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-57","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones."},"999":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-58","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento."},"1000":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-59","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","content":"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado."},"1001":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-60","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:"},"1002":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-61","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Campo de `external_webhook_settings`"},"1003":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-62","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Decisión"},"1004":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-63","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`url`"},"1005":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-64","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones."},"1006":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-65","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`method`"},"1007":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-66","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`POST` o `PUT`; `POST` por defecto."},"1008":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-67","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`name`"},"1009":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-68","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Etiqueta usada en los logs del servicio."},"1010":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-69","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.auth_mode`"},"1011":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-70","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`."},"1012":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-71","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.log_level`"},"1013":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-72","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto."},"1014":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-73","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.apikey_options`"},"1015":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-74","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan."},"1016":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-75","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.jwt_options`"},"1017":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-76","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`."},"1018":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-77","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.mtls_options`"},"1019":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-78","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro."},"1020":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-79","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.insecure_skip_verify`"},"1021":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-80","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí."},"1022":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-81","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"`config.call_timeout`"},"1023":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-82","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto."},"1024":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-83","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Reglas de esa configuración:"},"1025":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-84","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro."},"1026":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-85","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan."},"1027":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-86","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`."},"1028":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-87","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan."},"1029":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-88","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada."},"1030":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-89","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia."},"1031":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-90","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas)."},"1032":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-91","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador."},"1033":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-92","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","content":"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`."},"1034":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-93","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","content":"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes."},"1035":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-94","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Campo de `settings.reenrollment_settings`"},"1036":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-95","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Función"},"1037":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-96","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`reenrollment_delta`"},"1038":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-97","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"La ventana abre en `NotAfter` del certificado activo menos este delta."},"1039":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-98","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`preventive_delta`"},"1040":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-99","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Umbral operativo preventivo de monitorización."},"1041":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-100","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`critical_delta`"},"1042":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-101","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Umbral operativo crítico de monitorización."},"1043":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-102","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`enable_expired_renewal`"},"1044":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-103","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway."},"1045":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-104","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`est_rfc7030_settings.client_certificate_settings.validation_cas`"},"1046":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-105","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan."},"1047":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-106","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"`revoke_on_reenrollment`"},"1048":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-107","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor."},"1049":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-108","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","content":"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales."},"1050":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-109","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#serverkeygen","content":"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST."},"1051":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-110","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Opción"},"1052":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-111","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Qué publica"},"1053":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-112","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Include Lamassu System CA**"},"1054":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-113","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión."},"1055":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-114","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Include Enrollment CA**"},"1056":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-115","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificado de la CA emisora seleccionada."},"1057":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-116","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"**Managed CAs**"},"1058":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-117","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"Certificados de las CAs elegidas explícitamente."},"1059":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-118","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","content":"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor."},"1060":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-119","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS."},"1061":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-120","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs."},"1062":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-121","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","content":"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo."},"1063":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms-122","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","content":"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos."},"1064":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","type":"page","content":"Integra el cliente EST","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client"},"1065":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-0","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","content":"Prepara la confianza, envía una CSR y comprueba la identidad recibida."},"1066":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-1","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Antes de empezar"},"1067":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-2","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"Descarga e inspecciona cacerts"},"1068":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-3","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"Prepara la CSR"},"1069":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-4","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Solicita la identidad"},"1070":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-5","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Comprueba e instala el resultado"},"1071":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-6","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","content":"Siguientes pasos"},"1072":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-7","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","content":"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo."},"1073":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-8","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas."},"1074":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-9","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial."},"1075":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-10","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar","content":"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible."},"1076":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-11","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo."},"1077":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-12","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","content":"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen."},"1078":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-13","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos."},"1079":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-14","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","content":"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles."},"1080":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-15","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:"},"1081":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-16","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","content":"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión."},"1082":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-17","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Para el caso de una raíz que emite directamente:"},"1083":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-18","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI."},"1084":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-19","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","content":"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso."},"1085":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client-20","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","content":"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia."},"1086":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"page","content":"Referencia EST","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference"},"1087":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-0","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","content":"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu."},"1088":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-1","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Referencia de endpoints"},"1089":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-2","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"cacerts"},"1090":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-3","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"simpleenroll"},"1091":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-4","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"simplereenroll"},"1092":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-5","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"serverkeygen"},"1093":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-6","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Formato de respuesta"},"1094":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-7","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Solicitud y extracción"},"1095":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-8","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"Notas de compatibilidad"},"1096":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-9","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","content":"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política."},"1097":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-10","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos."},"1098":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-11","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Operación"},"1099":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-12","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Método"},"1100":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-13","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación y condición"},"1101":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-14","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/cacerts`"},"1102":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-15","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"GET"},"1103":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-16","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose."},"1104":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-17","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/simpleenroll`"},"1105":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-18","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1106":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-19","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación inicial y política de registro/sustitución del DMS."},"1107":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-20","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/simplereenroll`"},"1108":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-21","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1109":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-22","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación de renovación, identidad existente, sujeto, revocación y ventana."},"1110":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-23","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"`/serverkeygen`"},"1111":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-24","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"POST"},"1112":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-25","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Autenticación y admisión iniciales; generación en servidor habilitada."},"1113":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-26","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","content":"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato."},"1114":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-27","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes."},"1115":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-28","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#cacerts","content":"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables."},"1116":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-29","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS."},"1117":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-30","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simpleenroll","content":"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR."},"1118":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-31","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual."},"1119":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-32","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simplereenroll","content":"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación."},"1120":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-33","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM."},"1121":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-34","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#serverkeygen","content":"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución."},"1122":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-35","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:"},"1123":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-36","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Parte"},"1124":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-37","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Contenido tras decodificar su Base64"},"1125":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-38","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"`application/pkcs8`"},"1126":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-39","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"Clave privada PKCS#8 DER sin cifrar."},"1127":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-40","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"`application/pkcs7-mime; smime-type=certs-only`"},"1128":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-41","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"PKCS#7 DER con el certificado emitido."},"1129":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-42","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","content":"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras."},"1130":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-43","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor."},"1131":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-44","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:"},"1132":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-45","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Convierte y comprueba el resultado:"},"1133":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-46","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","content":"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python."},"1134":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-47","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico."},"1135":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference-48","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","content":"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico."},"1136":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","type":"page","content":"Enrolamiento con PKI","breadcrumbs":["Docs","Plataforma","IoT Fleets","Dispositivos e identidades","Enrolamiento con PKI"],"tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview"},"1137":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-0","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","content":"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST."},"1138":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-1","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El recorrido"},"1139":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-2","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"Para el administrador"},"1140":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-3","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","type":"heading","tags":[],"url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"Para el integrador"},"1141":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-4","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","content":"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor."},"1142":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-5","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El administrador prepara CA, perfil de emisión y DMS."},"1143":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-6","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El integrador instala confianza inicial en el servidor EST y una credencial de admisión."},"1144":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-7","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El cliente solicita una identidad para su `Device ID` mediante EST."},"1145":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-8","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado."},"1146":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-9","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación."},"1147":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-10","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","content":"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS."},"1148":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-11","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />"},"1149":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-12","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />"},"1150":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-13","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />"},"1151":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-14","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-administrador","content":"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />"},"1152":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-15","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />"},"1153":{"id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview-16","page_id":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-integrador","content":"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />"},"1154":{"id":"/docs/pr-previe