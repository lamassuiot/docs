"_41539":129642,"_41542":129645,"_41544":129648,"_41546":129651,"_41548":129654,"_41550":129657,"_41552":129660,"_41554":129663,"_41556":129666,"_41559":129669,"_41561":129672,"_41563":129675,"_41565":129678,"_41567":129681,"_41569":129684,"_41571":129687,"_41573":129690,"_41575":129693,"_41577":129696,"_41579":129699,"_41581":129702,"_41583":129705,"_41585":129708,"_41587":129711,"_41589":129714,"_41591":129717,"_41593":129720,"_41595":129723,"_41597":129726,"_41599":129729,"_41601":129731,"_41603":129734,"_41605":129737,"_41607":129740,"_41609":129742,"_41611":129745,"_41613":129748,"_41615":129750,"_41617":129752,"_41619":129754,"_41621":129756,"_41623":129759,"_41625":129762,"_41627":129765,"_41629":129768,"_41631":129771,"_41633":129774,"_41635":129777,"_41637":129780,"_41639":129783,"_41641":129786,"_41643":129789,"_41645":129792,"_41647":129795,"_41649":129798,"_41651":129801,"_41653":129804,"_41655":129807,"_41657":129810,"_41659":129813,"_41661":129816,"_41663":129819,"_41666":129822,"_41668":129825,"_41670":129828,"_41672":129831,"_41674":129834,"_41676":129837,"_41678":129840,"_41680":129843,"_41682":129846,"_41684":129849,"_41686":129852,"_41688":129855,"_41690":129858,"_41692":129861,"_41695":129864,"_41697":129867,"_41699":129870,"_41701":129873,"_41703":129876,"_41705":129879,"_41707":129882,"_41709":129885,"_41711":129888,"_41713":129891,"_41715":129894,"_41717":129897,"_41719":129900,"_41721":129903,"_41723":129906,"_41725":129909,"_41727":129912,"_41729":129915,"_41731":129918,"_41733":129921,"_41735":129924,"_41737":129927,"_41739":129930,"_41741":129933,"_41743":129936,"_41745":129939,"_41747":129942,"_41749":129945,"_41751":129948,"_41753":129951,"_41755":129954,"_41757":129957,"_41760":129960,"_41762":129963,"_41764":129966},{"_3638":72913,"_31204":72913,"_5":15245,"_3088":120651,"_31563":120652,"_21623":120655,"_28401":72913},"Despliega desde AWS Marketplace",[51051,120653,120654],"Despliegue","Otros modelos",[],{"_3638":72914,"_31204":72913,"_21623":120657,"_5":14885,"_28401":72913,"_3088":120658},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3638":72915,"_31204":72913,"_5":31560,"_21623":120660,"_28401":120661,"_3088":120662},[],"/docs/pr-preview/pr-83/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3638":72916,"_31204":72913,"_5":31560,"_21623":120664,"_28401":120665,"_3088":120666},[],"/docs/pr-preview/pr-83/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3638":72917,"_31204":72913,"_5":31560,"_21623":120668,"_28401":120669,"_3088":120670},[],"/docs/pr-preview/pr-83/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3638":72918,"_31204":72913,"_5":31560,"_21623":120672,"_28401":120673,"_3088":120674},[],"/docs/pr-preview/pr-83/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3638":72919,"_31204":72913,"_5":31560,"_21623":120676,"_28401":120677,"_3088":120678},[],"/docs/pr-preview/pr-83/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3638":72920,"_31204":72913,"_5":31560,"_21623":120680,"_28401":120681,"_3088":120682},[],"/docs/pr-preview/pr-83/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3638":72921,"_31204":72913,"_5":31560,"_21623":120684,"_28401":120685,"_3088":120686},[],"/docs/pr-preview/pr-83/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3638":72922,"_31204":72913,"_21623":120688,"_5":14885,"_28401":72913,"_3088":120689},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3638":72923,"_31204":72913,"_21623":120691,"_5":14885,"_28401":120661,"_3088":120692},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3638":72924,"_31204":72913,"_21623":120694,"_5":14885,"_28401":120661,"_3088":120695},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3638":72925,"_31204":72913,"_21623":120697,"_5":14885,"_28401":120661,"_3088":120698},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3638":72926,"_31204":72913,"_21623":120700,"_5":14885,"_28401":120665,"_3088":120701},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3638":72927,"_31204":72913,"_21623":120703,"_5":14885,"_28401":120665,"_3088":120704},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3638":72928,"_31204":72913,"_21623":120706,"_5":14885,"_28401":120665,"_3088":120707},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3638":72929,"_31204":72913,"_21623":120709,"_5":14885,"_28401":120669,"_3088":120710},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3638":72930,"_31204":72913,"_21623":120712,"_5":14885,"_28401":120673,"_3088":120713},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3638":72931,"_31204":72913,"_21623":120715,"_5":14885,"_28401":120677,"_3088":120716},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3638":72932,"_31204":72913,"_21623":120718,"_5":14885,"_28401":120681,"_3088":120719},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3638":72933,"_31204":72913,"_21623":120721,"_5":14885,"_28401":120685,"_3088":120722},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3638":72934,"_31204":72934,"_5":15245,"_3088":120724,"_31563":120725,"_21623":120726,"_28401":72934},"Despliega Lamassu",[51051,120653],[],{"_3638":72935,"_31204":72934,"_21623":120728,"_5":14885,"_28401":72934,"_3088":120729},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3638":72936,"_31204":72934,"_5":31560,"_21623":120731,"_28401":120732,"_3088":120733},[],"/docs/pr-preview/pr-83/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3638":72937,"_31204":72934,"_5":31560,"_21623":120735,"_28401":120736,"_3088":120737},[],"/docs/pr-preview/pr-83/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3638":72938,"_31204":72934,"_5":31560,"_21623":120739,"_28401":120740,"_3088":120741},[],"/docs/pr-preview/pr-83/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3638":72939,"_31204":72934,"_21623":120743,"_5":14885,"_28401":72934,"_3088":120744},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3638":72940,"_31204":72934,"_21623":120746,"_5":14885,"_28401":120732,"_3088":120747},[],"Modelo",{"_3638":72941,"_31204":72934,"_21623":120749,"_5":14885,"_28401":120732,"_3088":120750},[],"Recomendado para",{"_3638":72942,"_31204":72934,"_21623":120752,"_5":14885,"_28401":120732,"_3088":120753},[],"Quién opera la infraestructura",{"_3638":72943,"_31204":72934,"_21623":120755,"_5":14885,"_28401":120732,"_3088":120756},[],"Punto de partida",{"_3638":72944,"_31204":72934,"_21623":120758,"_5":14885,"_28401":120732,"_3088":51158},[],{"_3638":72945,"_31204":72934,"_21623":120760,"_5":14885,"_28401":120732,"_3088":120761},[],"Producción, entornos regulados y despliegues personalizados",{"_3638":72946,"_31204":72934,"_21623":120763,"_5":14885,"_28401":120732,"_3088":120764},[],"Tu equipo",{"_3638":72947,"_31204":72934,"_21623":120766,"_5":14885,"_28401":120732,"_3088":120767},[],"Helm o Fastlane",{"_3638":72948,"_31204":72934,"_21623":120769,"_5":14885,"_28401":120732,"_3088":51170},[],{"_3638":72949,"_31204":72934,"_21623":120771,"_5":14885,"_28401":120732,"_3088":120772},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3638":72950,"_31204":72934,"_21623":120774,"_5":14885,"_28401":120732,"_3088":120764},[],{"_3638":72951,"_31204":72934,"_21623":120776,"_5":14885,"_28401":120732,"_3088":120777},[],"Imagen preconfigurada en EC2",{"_3638":72952,"_31204":72934,"_21623":120779,"_5":14885,"_28401":120732,"_3088":51181},[],{"_3638":72953,"_31204":72934,"_21623":120781,"_5":14885,"_28401":120732,"_3088":120782},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3638":72954,"_31204":72934,"_21623":120784,"_5":14885,"_28401":120732,"_3088":51187},[],{"_3638":72955,"_31204":72934,"_21623":120786,"_5":14885,"_28401":120732,"_3088":120787},[],"Suscripción gestionada",{"_3638":72956,"_31204":72934,"_21623":120789,"_5":14885,"_28401":120732,"_3088":120790},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3638":72957,"_31204":72934,"_21623":120792,"_5":14885,"_28401":120732,"_3088":120793},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3638":72958,"_31204":72934,"_21623":120795,"_5":14885,"_28401":120732,"_3088":120796},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3638":72959,"_31204":72934,"_21623":120798,"_5":14885,"_28401":120736,"_3088":120799},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3638":72960,"_31204":72934,"_21623":120801,"_5":14885,"_28401":120740,"_3088":120802},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3638":72961,"_31204":72961,"_5":15245,"_3088":120804,"_31563":120805,"_21623":120806,"_28401":72961},"Utiliza Lamassu como SaaS",[51051,120653,120654],[],{"_3638":72962,"_31204":72961,"_21623":120808,"_5":14885,"_28401":72961,"_3088":120809},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3638":72963,"_31204":72961,"_5":31560,"_21623":120811,"_28401":120812,"_3088":120813},[],"/docs/pr-preview/pr-83/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3638":72964,"_31204":72961,"_5":31560,"_21623":120815,"_28401":120816,"_3088":120817},[],"/docs/pr-preview/pr-83/es/deployment/saas#planes","Planes",{"_3638":72965,"_31204":72961,"_5":31560,"_21623":120819,"_28401":120820,"_3088":120821},[],"/docs/pr-preview/pr-83/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3638":72966,"_31204":72961,"_21623":120823,"_5":14885,"_28401":72961,"_3088":120824},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3638":72967,"_31204":72961,"_21623":120826,"_5":14885,"_28401":120812,"_3088":120827},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3638":72968,"_31204":72961,"_21623":120829,"_5":14885,"_28401":120812,"_3088":120830},[],"Copias de seguridad automáticas.",{"_3638":72969,"_31204":72961,"_21623":120832,"_5":14885,"_28401":120812,"_3088":120833},[],"Actualizaciones de versión.",{"_3638":72970,"_31204":72961,"_21623":120835,"_5":14885,"_28401":120812,"_3088":120836},[],"Soporte técnico y SLA según el plan contratado.",{"_3638":72971,"_31204":72961,"_21623":120838,"_5":14885,"_28401":120816,"_3088":51242},[],{"_3638":72972,"_31204":72961,"_21623":120840,"_5":14885,"_28401":120816,"_3088":120841},[],"Dispositivos",{"_3638":72973,"_31204":72961,"_21623":120843,"_5":14885,"_28401":120816,"_3088":120844},[],"Soporte",{"_3638":72974,"_31204":72961,"_21623":120846,"_5":14885,"_28401":120816,"_3088":51251},[],{"_3638":72975,"_31204":72961,"_21623":120848,"_5":14885,"_28401":120816,"_3088":51254},[],{"_3638":72976,"_31204":72961,"_21623":120850,"_5":14885,"_28401":120816,"_3088":120851},[],"Hasta 1.000",{"_3638":72977,"_31204":72961,"_21623":120853,"_5":14885,"_28401":120816,"_3088":51260},[],{"_3638":72978,"_31204":72961,"_21623":120855,"_5":14885,"_28401":120816,"_3088":120856},[],"99,5 %",{"_3638":72979,"_31204":72961,"_21623":120858,"_5":14885,"_28401":120816,"_3088":51266},[],{"_3638":72980,"_31204":72961,"_21623":120860,"_5":14885,"_28401":120816,"_3088":120861},[],"Hasta 10.000",{"_3638":72981,"_31204":72961,"_21623":120863,"_5":14885,"_28401":120816,"_3088":120864},[],"Email y chat",{"_3638":72982,"_31204":72961,"_21623":120866,"_5":14885,"_28401":120816,"_3088":120867},[],"99,9 %",{"_3638":72983,"_31204":72961,"_21623":120869,"_5":14885,"_28401":120816,"_3088":51278},[],{"_3638":72984,"_31204":72961,"_21623":120871,"_5":14885,"_28401":120816,"_3088":120872},[],"Ilimitados",{"_3638":72985,"_31204":72961,"_21623":120874,"_5":14885,"_28401":120816,"_3088":120875},[],"Dedicado",{"_3638":72986,"_31204":72961,"_21623":120877,"_5":14885,"_28401":120816,"_3088":120878},[],"99,99 %",{"_3638":72987,"_31204":72961,"_21623":120880,"_5":14885,"_28401":120820,"_3088":120881},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3638":72988,"_31204":72961,"_21623":120883,"_5":14885,"_28401":120820,"_3088":120884},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3638":72989,"_31204":72989,"_5":15245,"_3088":51295,"_31563":120886,"_21623":120888,"_28401":72989},[51051,120653,120887],"Kubernetes autogestionado",[],{"_3638":72990,"_31204":72989,"_21623":120890,"_5":14885,"_28401":72989,"_3088":120891},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3638":72991,"_31204":72989,"_5":31560,"_21623":120893,"_28401":120894,"_3088":120895},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3638":72992,"_31204":72989,"_5":31560,"_21623":120897,"_28401":120898,"_3088":120899},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3638":72993,"_31204":72989,"_5":31560,"_21623":120901,"_28401":120902,"_3088":120903},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3638":72994,"_31204":72989,"_5":31560,"_21623":120905,"_28401":120906,"_3088":120907},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3638":72995,"_31204":72989,"_5":31560,"_21623":120909,"_28401":120910,"_3088":120911},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3638":72996,"_31204":72989,"_5":31560,"_21623":120913,"_28401":120914,"_3088":120915},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3638":72997,"_31204":72989,"_5":31560,"_21623":120917,"_28401":120918,"_3088":120919},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3638":72998,"_31204":72989,"_5":31560,"_21623":120921,"_28401":120922,"_3088":120923},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3638":72999,"_31204":72989,"_5":31560,"_21623":120925,"_28401":120926,"_3088":120927},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3638":73000,"_31204":72989,"_5":31560,"_21623":120929,"_28401":120930,"_3088":120931},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3638":73001,"_31204":72989,"_5":31560,"_21623":120933,"_28401":120934,"_3088":120935},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3638":73002,"_31204":72989,"_21623":120937,"_5":14885,"_28401":120894,"_3088":120938},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3638":73003,"_31204":72989,"_21623":120940,"_5":14885,"_28401":120894,"_3088":120941},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3638":73004,"_31204":72989,"_21623":120943,"_5":14885,"_28401":120898,"_3088":120944},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3638":73005,"_31204":72989,"_21623":120946,"_5":14885,"_28401":120898,"_3088":120947},[],"Fastlane instala o configura",{"_3638":73006,"_31204":72989,"_21623":120949,"_5":14885,"_28401":120898,"_3088":120950},[],"Tú sigues proporcionando",{"_3638":73007,"_31204":72989,"_21623":120952,"_5":14885,"_28401":120898,"_3088":120953},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3638":73008,"_31204":72989,"_21623":120955,"_5":14885,"_28401":120898,"_3088":120956},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3638":73009,"_31204":72989,"_21623":120958,"_5":14885,"_28401":120898,"_3088":120959},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3638":73010,"_31204":72989,"_21623":120961,"_5":14885,"_28401":120898,"_3088":120962},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3638":73011,"_31204":72989,"_21623":120964,"_5":14885,"_28401":120898,"_3088":120965},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3638":73012,"_31204":72989,"_21623":120967,"_5":14885,"_28401":120898,"_3088":120968},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3638":73013,"_31204":72989,"_21623":120970,"_5":14885,"_28401":120898,"_3088":120971},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3638":73014,"_31204":72989,"_21623":120973,"_5":14885,"_28401":120898,"_3088":120974},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3638":73015,"_31204":72989,"_21623":120976,"_5":14885,"_28401":120898,"_3088":120977},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3638":73016,"_31204":72989,"_21623":120979,"_5":14885,"_28401":120902,"_3088":120980},[],"Necesitas:",{"_3638":73017,"_31204":72989,"_21623":120982,"_5":14885,"_28401":120902,"_3088":120983},[],"un clúster Kubernetes existente",{"_3638":73018,"_31204":72989,"_21623":120985,"_5":14885,"_28401":120902,"_3088":120986},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3638":73019,"_31204":72989,"_21623":120988,"_5":14885,"_28401":120902,"_3088":51397},[],{"_3638":73020,"_31204":72989,"_21623":120990,"_5":14885,"_28401":120902,"_3088":24436},[],{"_3638":73021,"_31204":72989,"_21623":120992,"_5":14885,"_28401":120902,"_3088":120993},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3638":73022,"_31204":72989,"_21623":120995,"_5":14885,"_28401":120902,"_3088":120996},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3638":73023,"_31204":72989,"_21623":120998,"_5":14885,"_28401":120902,"_3088":120999},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3638":73024,"_31204":72989,"_21623":121001,"_5":14885,"_28401":120902,"_3088":121002},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3638":73025,"_31204":72989,"_21623":121004,"_5":14885,"_28401":120902,"_3088":121005},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3638":73026,"_31204":72989,"_21623":121007,"_5":14885,"_28401":120906,"_3088":121008},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3638":73027,"_31204":72989,"_21623":121010,"_5":14885,"_28401":120906,"_3088":121011},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3638":73028,"_31204":72989,"_21623":121013,"_5":14885,"_28401":120910,"_3088":121014},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3638":73029,"_31204":72989,"_21623":121016,"_5":14885,"_28401":120910,"_3088":121017},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3638":73030,"_31204":72989,"_21623":121019,"_5":14885,"_28401":120910,"_3088":121020},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3638":73031,"_31204":72989,"_21623":121022,"_5":14885,"_28401":120910,"_3088":121023},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3638":73032,"_31204":72989,"_21623":121025,"_5":14885,"_28401":120914,"_3088":121026},[],"Opción",{"_3638":73033,"_31204":72989,"_21623":121028,"_5":14885,"_28401":120914,"_3088":121029},[],"Valor predeterminado",{"_3638":73034,"_31204":72989,"_21623":121031,"_5":14885,"_28401":120914,"_3088":121032},[],"Propósito",{"_3638":73035,"_31204":72989,"_21623":121034,"_5":14885,"_28401":120914,"_3088":51444},[],{"_3638":73036,"_31204":72989,"_21623":121036,"_5":14885,"_28401":120914,"_3088":51447},[],{"_3638":73037,"_31204":72989,"_21623":121038,"_5":14885,"_28401":120914,"_3088":121039},[],"Muestra la ayuda",{"_3638":73038,"_31204":72989,"_21623":121041,"_5":14885,"_28401":120914,"_3088":51453},[],{"_3638":73039,"_31204":72989,"_21623":121043,"_5":14885,"_28401":120914,"_3088":121044},[],"contexto actual",{"_3638":73040,"_31204":72989,"_21623":121046,"_5":14885,"_28401":120914,"_3088":121047},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3638":73041,"_31204":72989,"_21623":121049,"_5":14885,"_28401":120914,"_3088":51462},[],{"_3638":73042,"_31204":72989,"_21623":121051,"_5":14885,"_28401":120914,"_3088":6816},[],{"_3638":73043,"_31204":72989,"_21623":121053,"_5":14885,"_28401":120914,"_3088":121054},[],"Omite prompts y genera credenciales para las dependencias",{"_3638":73044,"_31204":72989,"_21623":121056,"_5":14885,"_28401":120914,"_3088":51470},[],{"_3638":73045,"_31204":72989,"_21623":121058,"_5":14885,"_28401":120914,"_3088":51473},[],{"_3638":73046,"_31204":72989,"_21623":121060,"_5":14885,"_28401":120914,"_3088":121061},[],"Namespace de la instalación",{"_3638":73047,"_31204":72989,"_21623":121063,"_5":14885,"_28401":120914,"_3088":51479},[],{"_3638":73048,"_31204":72989,"_21623":121065,"_5":14885,"_28401":120914,"_3088":51482},[],{"_3638":73049,"_31204":72989,"_21623":121067,"_5":14885,"_28401":120914,"_3088":121068},[],"Dominio usado por la UI, OIDC y el certificado",{"_3638":73050,"_31204":72989,"_21623":121070,"_5":14885,"_28401":120914,"_3088":51488},[],{"_3638":73051,"_31204":72989,"_21623":121072,"_5":14885,"_28401":120914,"_3088":15597},[],{"_3638":73052,"_31204":72989,"_21623":121074,"_5":14885,"_28401":120914,"_3088":121075},[],"Versión del chart de Lamassu",{"_3638":73053,"_31204":72989,"_21623":121077,"_5":14885,"_28401":120914,"_3088":51496},[],{"_3638":73054,"_31204":72989,"_21623":121079,"_5":14885,"_28401":120914,"_3088":51499},[],{"_3638":73055,"_31204":72989,"_21623":121081,"_5":14885,"_28401":120914,"_3088":121082},[],"Puerto del listener HTTPS",{"_3638":73056,"_31204":72989,"_21623":121084,"_5":14885,"_28401":120914,"_3088":51505},[],{"_3638":73057,"_31204":72989,"_21623":121086,"_5":14885,"_28401":120914,"_3088":51508},[],{"_3638":73058,"_31204":72989,"_21623":121088,"_5":14885,"_28401":120914,"_3088":121089},[],"Puerto del listener HTTP",{"_3638":73059,"_31204":72989,"_21623":121091,"_5":14885,"_28401":120914,"_3088":51514},[],{"_3638":73060,"_31204":72989,"_21623":121093,"_5":14885,"_28401":120914,"_3088":51447},[],{"_3638":73061,"_31204":72989,"_21623":121095,"_5":14885,"_28401":120914,"_3088":121096},[],"Certificado PEM para TLS downstream",{"_3638":73062,"_31204":72989,"_21623":121098,"_5":14885,"_28401":120914,"_3088":51522},[],{"_3638":73063,"_31204":72989,"_21623":121100,"_5":14885,"_28401":120914,"_3088":51447},[],{"_3638":73064,"_31204":72989,"_21623":121102,"_5":14885,"_28401":120914,"_3088":121103},[],"Clave privada PEM para TLS downstream",{"_3638":73065,"_31204":72989,"_21623":121105,"_5":14885,"_28401":120914,"_3088":51530},[],{"_3638":73066,"_31204":72989,"_21623":121107,"_5":14885,"_28401":120914,"_3088":121108},[],"chart del repositorio",{"_3638":73067,"_31204":72989,"_21623":121110,"_5":14885,"_28401":120914,"_3088":121111},[],"Usa un chart local de Lamassu sin empaquetar",{"_3638":73068,"_31204":72989,"_21623":121113,"_5":14885,"_28401":120914,"_3088":51539},[],{"_3638":73069,"_31204":72989,"_21623":121115,"_5":14885,"_28401":120914,"_3088":121116},[],"detección automática",{"_3638":73070,"_31204":72989,"_21623":121118,"_5":14885,"_28401":120914,"_3088":121119},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3638":73071,"_31204":72989,"_21623":121121,"_5":14885,"_28401":120914,"_3088":51547},[],{"_3638":73072,"_31204":72989,"_21623":121123,"_5":14885,"_28401":120914,"_3088":6816},[],{"_3638":73073,"_31204":72989,"_21623":121125,"_5":14885,"_28401":120914,"_3088":121126},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3638":73074,"_31204":72989,"_21623":121128,"_5":14885,"_28401":120914,"_3088":51555},[],{"_3638":73075,"_31204":72989,"_21623":121130,"_5":14885,"_28401":120914,"_3088":6816},[],{"_3638":73076,"_31204":72989,"_21623":121132,"_5":14885,"_28401":120914,"_3088":121133},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3638":73077,"_31204":72989,"_21623":121135,"_5":14885,"_28401":120914,"_3088":51563},[],{"_3638":73078,"_31204":72989,"_21623":121137,"_5":14885,"_28401":120914,"_3088":6816},[],{"_3638":73079,"_31204":72989,"_21623":121139,"_5":14885,"_28401":120914,"_3088":121140},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3638":73080,"_31204":72989,"_21623":121142,"_5":14885,"_28401":120914,"_3088":51571},[],{"_3638":73081,"_31204":72989,"_21623":121144,"_5":14885,"_28401":120914,"_3088":6816},[],{"_3638":73082,"_31204":72989,"_21623":121146,"_5":14885,"_28401":120914,"_3088":121147},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3638":73083,"_31204":72989,"_21623":121149,"_5":14885,"_28401":120914,"_3088":51579},[],{"_3638":73084,"_31204":72989,"_21623":121151,"_5":14885,"_28401":120914,"_3088":51582},[],{"_3638":73085,"_31204":72989,"_21623":121153,"_5":14885,"_28401":120914,"_3088":121154},[],"Usa otro chart local de SoftHSM",{"_3638":73086,"_31204":72989,"_21623":121156,"_5":14885,"_28401":120914,"_3088":121157},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3638":73087,"_31204":72989,"_21623":121159,"_5":14885,"_28401":120918,"_3088":121160},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3638":73088,"_31204":72989,"_21623":121162,"_5":14885,"_28401":120918,"_3088":121163},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3638":73089,"_31204":72989,"_21623":121165,"_5":14885,"_28401":120918,"_3088":121166},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3638":73090,"_31204":72989,"_21623":121168,"_5":14885,"_28401":120918,"_3088":121169},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3638":73091,"_31204":72989,"_21623":121171,"_5":14885,"_28401":120918,"_3088":121172},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3638":73092,"_31204":72989,"_21623":121174,"_5":14885,"_28401":120918,"_3088":121175},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3638":73093,"_31204":72989,"_21623":121177,"_5":14885,"_28401":120922,"_3088":51609},[],{"_3638":73094,"_31204":72989,"_21623":121179,"_5":14885,"_28401":120922,"_3088":121180},[],"valida las herramientas locales y el clúster seleccionado",{"_3638":73095,"_31204":72989,"_21623":121182,"_5":14885,"_28401":120922,"_3088":121183},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3638":73096,"_31204":72989,"_21623":121185,"_5":14885,"_28401":120922,"_3088":121186},[],"crea el namespace",{"_3638":73097,"_31204":72989,"_21623":121188,"_5":14885,"_28401":120922,"_3088":121189},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3638":73098,"_31204":72989,"_21623":121191,"_5":14885,"_28401":120922,"_3088":121192},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3638":73099,"_31204":72989,"_21623":121194,"_5":14885,"_28401":120922,"_3088":121195},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3638":73100,"_31204":72989,"_21623":121197,"_5":14885,"_28401":120922,"_3088":121198},[],"instala RabbitMQ",{"_3638":73101,"_31204":72989,"_21623":121200,"_5":14885,"_28401":120922,"_3088":121201},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3638":73102,"_31204":72989,"_21623":121203,"_5":14885,"_28401":120922,"_3088":121204},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3638":73103,"_31204":72989,"_21623":121206,"_5":14885,"_28401":120922,"_3088":121207},[],"carga datos de ejemplo opcionalmente",{"_3638":73104,"_31204":72989,"_21623":121209,"_5":14885,"_28401":120922,"_3088":121210},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3638":73105,"_31204":72989,"_21623":121212,"_5":14885,"_28401":120926,"_3088":121213},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3638":73106,"_31204":72989,"_21623":121215,"_5":14885,"_28401":120926,"_3088":121216},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3638":73107,"_31204":72989,"_21623":121218,"_5":14885,"_28401":120930,"_3088":121219},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3638":73108,"_31204":72989,"_21623":121221,"_5":14885,"_28401":120930,"_3088":121222},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3638":73109,"_31204":72989,"_21623":121224,"_5":14885,"_28401":120930,"_3088":121225},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3638":73110,"_31204":72989,"_21623":121227,"_5":14885,"_28401":120930,"_3088":121228},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3638":73111,"_31204":72989,"_21623":121230,"_5":14885,"_28401":120934,"_3088":121231},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3638":73112,"_31204":73112,"_5":15245,"_3088":121233,"_31563":121234,"_21623":121235,"_28401":73112},"Instala con Helm",[51051,120653,120887],[],{"_3638":73113,"_31204":73112,"_21623":121237,"_5":14885,"_28401":73112,"_3088":121238},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3638":73114,"_31204":73112,"_5":31560,"_21623":121240,"_28401":121241,"_3088":121242},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3638":73115,"_31204":73112,"_5":31560,"_21623":121244,"_28401":121245,"_3088":120903},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3638":73116,"_31204":73112,"_5":31560,"_21623":121247,"_28401":121248,"_3088":121249},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3638":73117,"_31204":73112,"_5":31560,"_21623":121251,"_28401":121252,"_3088":121253},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3638":73118,"_31204":73112,"_5":31560,"_21623":121255,"_28401":121256,"_3088":121257},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3638":73119,"_31204":73112,"_5":31560,"_21623":121259,"_28401":121260,"_3088":121261},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3638":73120,"_31204":73112,"_5":31560,"_21623":121263,"_28401":121264,"_3088":121265},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3638":73121,"_31204":73112,"_5":31560,"_21623":121267,"_28401":121268,"_3088":121269},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3638":73122,"_31204":73112,"_5":31560,"_21623":121271,"_28401":121272,"_3088":121273},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3638":73123,"_31204":73112,"_5":31560,"_21623":121275,"_28401":121276,"_3088":121277},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3638":73124,"_31204":73112,"_5":31560,"_21623":121279,"_28401":121280,"_3088":121281},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3638":73125,"_31204":73112,"_5":31560,"_21623":121283,"_28401":121284,"_3088":121285},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3638":73126,"_31204":73112,"_5":31560,"_21623":121287,"_28401":121288,"_3088":121289},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3638":73127,"_31204":73112,"_21623":121291,"_5":14885,"_28401":121241,"_3088":121292},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3638":73128,"_31204":73112,"_21623":121294,"_5":14885,"_28401":121245,"_3088":121295},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3638":73129,"_31204":73112,"_21623":121297,"_5":14885,"_28401":121245,"_3088":121298},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3638":73130,"_31204":73112,"_21623":121300,"_5":14885,"_28401":121245,"_3088":121301},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3638":73131,"_31204":73112,"_21623":121303,"_5":14885,"_28401":121245,"_3088":121304},[],"un broker RabbitMQ accesible y sus credenciales",{"_3638":73132,"_31204":73112,"_21623":121306,"_5":14885,"_28401":121245,"_3088":121307},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3638":73133,"_31204":73112,"_21623":121309,"_5":14885,"_28401":121245,"_3088":121310},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3638":73134,"_31204":73112,"_21623":121312,"_5":14885,"_28401":121245,"_3088":121313},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3638":73135,"_31204":73112,"_21623":121315,"_5":14885,"_28401":121245,"_3088":121316},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3638":73136,"_31204":73112,"_21623":121318,"_5":14885,"_28401":121245,"_3088":121319},[],"una StorageClass y un diseño de tráfico externo",{"_3638":73137,"_31204":73112,"_21623":121321,"_5":14885,"_28401":121245,"_3088":121322},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3638":73138,"_31204":73112,"_21623":121324,"_5":14885,"_28401":121245,"_3088":121325},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3638":73139,"_31204":73112,"_21623":121327,"_5":14885,"_28401":121245,"_3088":121328},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3638":73140,"_31204":73112,"_21623":121330,"_5":14885,"_28401":121248,"_3088":121331},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3638":73141,"_31204":73112,"_21623":121333,"_5":14885,"_28401":121248,"_3088":121334},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3638":73142,"_31204":73112,"_21623":121336,"_5":14885,"_28401":121248,"_3088":121337},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3638":73143,"_31204":73112,"_21623":121339,"_5":14885,"_28401":121252,"_3088":121340},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3638":73144,"_31204":73112,"_21623":121342,"_5":14885,"_28401":121252,"_3088":121343},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3638":73145,"_31204":73112,"_21623":121345,"_5":14885,"_28401":121252,"_3088":121346},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3638":73146,"_31204":73112,"_21623":121348,"_5":14885,"_28401":121252,"_3088":121349},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3638":73147,"_31204":73112,"_21623":121351,"_5":14885,"_28401":121256,"_3088":121352},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3638":73148,"_31204":73112,"_21623":121354,"_5":14885,"_28401":121256,"_3088":121355},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3638":73149,"_31204":73112,"_21623":121357,"_5":14885,"_28401":121256,"_3088":121358},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3638":73150,"_31204":73112,"_21623":121360,"_5":14885,"_28401":121256,"_3088":121361},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3638":73151,"_31204":73112,"_21623":121363,"_5":14885,"_28401":121256,"_3088":121364},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3638":73152,"_31204":73112,"_21623":121366,"_5":14885,"_28401":121256,"_3088":121367},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3638":73153,"_31204":73112,"_21623":121369,"_5":14885,"_28401":121256,"_3088":121370},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3638":73154,"_31204":73112,"_21623":121372,"_5":14885,"_28401":121256,"_3088":121373},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3638":73155,"_31204":73112,"_21623":121375,"_5":14885,"_28401":121260,"_3088":121376},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3638":73156,"_31204":73112,"_21623":121378,"_5":14885,"_28401":121264,"_3088":121379},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3638":73157,"_31204":73112,"_21623":121381,"_5":14885,"_28401":121264,"_3088":121382},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3638":73158,"_31204":73112,"_21623":121384,"_5":14885,"_28401":121264,"_3088":121385},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3638":73159,"_31204":73112,"_21623":121387,"_5":14885,"_28401":121264,"_3088":121388},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3638":73160,"_31204":73112,"_21623":121390,"_5":14885,"_28401":121264,"_3088":121391},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3638":73161,"_31204":73112,"_21623":121393,"_5":14885,"_28401":121264,"_3088":121394},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3638":73162,"_31204":73112,"_21623":121396,"_5":14885,"_28401":121264,"_3088":121397},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3638":73163,"_31204":73112,"_21623":121399,"_5":14885,"_28401":121268,"_3088":121400},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3638":73164,"_31204":73112,"_21623":121402,"_5":14885,"_28401":121268,"_3088":121403},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3638":73165,"_31204":73112,"_21623":121405,"_5":14885,"_28401":121268,"_3088":121406},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3638":73166,"_31204":73112,"_21623":121408,"_5":14885,"_28401":121268,"_3088":121409},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3638":73167,"_31204":73112,"_21623":121411,"_5":14885,"_28401":121272,"_3088":121412},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3638":73168,"_31204":73112,"_21623":121414,"_5":14885,"_28401":121272,"_3088":121415},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3638":73169,"_31204":73112,"_21623":121417,"_5":14885,"_28401":121272,"_3088":121418},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3638":73170,"_31204":73112,"_21623":121420,"_5":14885,"_28401":121272,"_3088":121421},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3638":73171,"_31204":73112,"_21623":121423,"_5":14885,"_28401":121276,"_3088":121424},[],"Para instalar un checkout local:",{"_3638":73172,"_31204":73112,"_21623":121426,"_5":14885,"_28401":121280,"_3088":121427},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3638":73173,"_31204":73112,"_21623":121429,"_5":14885,"_28401":121280,"_3088":121430},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3638":73174,"_31204":73112,"_21623":121432,"_5":14885,"_28401":121284,"_3088":121433},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3638":73175,"_31204":73112,"_21623":121435,"_5":14885,"_28401":121284,"_3088":121436},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3638":73176,"_31204":73112,"_21623":121438,"_5":14885,"_28401":121284,"_3088":121439},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3638":73177,"_31204":73112,"_21623":121441,"_5":14885,"_28401":121284,"_3088":121442},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3638":73178,"_31204":73112,"_21623":121444,"_5":14885,"_28401":121284,"_3088":121445},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3638":73179,"_31204":73112,"_21623":121447,"_5":14885,"_28401":121288,"_3088":121448},[],"Antes de pasar a producción, revisa:",{"_3638":73180,"_31204":73112,"_21623":121450,"_5":14885,"_28401":121288,"_3088":121451},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3638":73181,"_31204":73112,"_21623":121453,"_5":14885,"_28401":121288,"_3088":121454},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3638":73182,"_31204":73112,"_21623":121456,"_5":14885,"_28401":121288,"_3088":121457},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3638":73183,"_31204":73112,"_21623":121459,"_5":14885,"_28401":121288,"_3088":121460},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3638":73184,"_31204":73112,"_21623":121462,"_5":14885,"_28401":121288,"_3088":121463},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3638":73185,"_31204":73112,"_21623":121465,"_5":14885,"_28401":121288,"_3088":121466},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3638":73186,"_31204":73112,"_21623":121468,"_5":14885,"_28401":121288,"_3088":121469},[],"SMTP, observabilidad y entrega de alertas",{"_3638":73187,"_31204":73112,"_21623":121471,"_5":14885,"_28401":121288,"_3088":121472},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3638":73188,"_31204":73112,"_21623":121474,"_5":14885,"_28401":121288,"_3088":121475},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3638":73189,"_31204":73189,"_5":15245,"_3088":121477,"_31563":121478,"_21623":121479,"_28401":73189},"Expón el Gateway",[51051,120653,120887],[],{"_3638":73190,"_31204":73189,"_21623":121481,"_5":14885,"_28401":73189,"_3088":121482},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3638":73191,"_31204":73189,"_5":31560,"_21623":121484,"_28401":121485,"_3088":121486},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3638":73192,"_31204":73189,"_5":31560,"_21623":121488,"_28401":121489,"_3088":121490},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3638":73193,"_31204":73189,"_5":31560,"_21623":121492,"_28401":121493,"_3088":121494},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3638":73194,"_31204":73189,"_5":31560,"_21623":121496,"_28401":121497,"_3088":51930},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#k3s",{"_3638":73195,"_31204":73189,"_5":31560,"_21623":121499,"_28401":121500,"_3088":121501},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3638":73196,"_31204":73189,"_5":31560,"_21623":121503,"_28401":121504,"_3088":121505},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3638":73197,"_31204":73189,"_5":31560,"_21623":121507,"_28401":121508,"_3088":121509},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3638":73198,"_31204":73189,"_5":31560,"_21623":121511,"_28401":121512,"_3088":121513},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3638":73199,"_31204":73189,"_5":31560,"_21623":121515,"_28401":121516,"_3088":121517},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3638":73200,"_31204":73189,"_5":31560,"_21623":121519,"_28401":121520,"_3088":121521},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3638":73201,"_31204":73189,"_5":31560,"_21623":121523,"_28401":121524,"_3088":121525},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3638":73202,"_31204":73189,"_21623":121527,"_5":14885,"_28401":121485,"_3088":121528},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3638":73203,"_31204":73189,"_21623":121530,"_5":14885,"_28401":121485,"_3088":121531},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3638":73204,"_31204":73189,"_21623":121533,"_5":14885,"_28401":121489,"_3088":121534},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3638":73205,"_31204":73189,"_21623":121536,"_5":14885,"_28401":121489,"_3088":121537},[],"Defínelo únicamente cuando:",{"_3638":73206,"_31204":73189,"_21623":121539,"_5":14885,"_28401":121489,"_3088":121540},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3638":73207,"_31204":73189,"_21623":121542,"_5":14885,"_28401":121489,"_3088":121543},[],"esa dirección está asignada a este Gateway",{"_3638":73208,"_31204":73189,"_21623":121545,"_5":14885,"_28401":121489,"_3088":121546},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3638":73209,"_31204":73189,"_21623":121548,"_5":14885,"_28401":121489,"_3088":121549},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3638":73210,"_31204":73189,"_21623":121551,"_5":14885,"_28401":121489,"_3088":121552},[],"No confundas estos valores:",{"_3638":73211,"_31204":73189,"_21623":121554,"_5":14885,"_28401":121489,"_3088":121555},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3638":73212,"_31204":73189,"_21623":121557,"_5":14885,"_28401":121489,"_3088":121558},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3638":73213,"_31204":73189,"_21623":121560,"_5":14885,"_28401":121489,"_3088":121561},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3638":73214,"_31204":73189,"_21623":121563,"_5":14885,"_28401":121493,"_3088":121564},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3638":73215,"_31204":73189,"_21623":121566,"_5":14885,"_28401":121493,"_3088":121567},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3638":73216,"_31204":73189,"_21623":121569,"_5":14885,"_28401":121497,"_3088":121570},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3638":73217,"_31204":73189,"_21623":121572,"_5":14885,"_28401":121497,"_3088":121573},[],"Para el diseño recomendado:",{"_3638":73218,"_31204":73189,"_21623":121575,"_5":14885,"_28401":121497,"_3088":121576},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3638":73219,"_31204":73189,"_21623":121578,"_5":14885,"_28401":121497,"_3088":121579},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3638":73220,"_31204":73189,"_21623":121581,"_5":14885,"_28401":121497,"_3088":121582},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3638":73221,"_31204":73189,"_21623":121584,"_5":14885,"_28401":121497,"_3088":121585},[],"Apunta DNS a la dirección accesible de la VM.",{"_3638":73222,"_31204":73189,"_21623":121587,"_5":14885,"_28401":121497,"_3088":121588},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3638":73223,"_31204":73189,"_21623":121590,"_5":14885,"_28401":121500,"_3088":121591},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3638":73224,"_31204":73189,"_21623":121593,"_5":14885,"_28401":121504,"_3088":121594},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3638":73225,"_31204":73189,"_21623":121596,"_5":14885,"_28401":121504,"_3088":121597},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3638":73226,"_31204":73189,"_21623":121599,"_5":14885,"_28401":121508,"_3088":121600},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3638":73227,"_31204":73189,"_21623":121602,"_5":14885,"_28401":121508,"_3088":121603},[],"Requisito",{"_3638":73228,"_31204":73189,"_21623":121605,"_5":14885,"_28401":121508,"_3088":121606},[],"Diseño recomendado",{"_3638":73229,"_31204":73189,"_21623":121608,"_5":14885,"_28401":121508,"_3088":121609},[],"Consecuencia",{"_3638":73230,"_31204":73189,"_21623":121611,"_5":14885,"_28401":121508,"_3088":121612},[],"Varias URL o servicios de Lamassu",{"_3638":73231,"_31204":73189,"_21623":121614,"_5":14885,"_28401":121508,"_3088":121615},[],"Un Gateway con varias rutas",{"_3638":73232,"_31204":73189,"_21623":121617,"_5":14885,"_28401":121508,"_3088":121618},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3638":73233,"_31204":73189,"_21623":121620,"_5":14885,"_28401":121508,"_3088":121621},[],"Gateways independientes e IP externas distintas",{"_3638":73234,"_31204":73189,"_21623":121623,"_5":14885,"_28401":121508,"_3088":121624},[],"Una VIP por Gateway",{"_3638":73235,"_31204":73189,"_21623":121626,"_5":14885,"_28401":121508,"_3088":121627},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3638":73236,"_31204":73189,"_21623":121629,"_5":14885,"_28401":121508,"_3088":121630},[],"Gateways independientes, un nodo y una IP",{"_3638":73237,"_31204":73189,"_21623":121632,"_5":14885,"_28401":121508,"_3088":121633},[],"Puertos externos diferentes",{"_3638":73238,"_31204":73189,"_21623":121635,"_5":14885,"_28401":121508,"_3088":121636},[],"Los clientes deben indicar puertos no estándar",{"_3638":73239,"_31204":73189,"_21623":121638,"_5":14885,"_28401":121508,"_3088":121639},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3638":73240,"_31204":73189,"_21623":121641,"_5":14885,"_28401":121508,"_3088":121642},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3638":73241,"_31204":73189,"_21623":121644,"_5":14885,"_28401":121508,"_3088":121645},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3638":73242,"_31204":73189,"_21623":121647,"_5":14885,"_28401":121508,"_3088":121648},[],"Recursos Gateway separados pero proxy compartido",{"_3638":73243,"_31204":73189,"_21623":121650,"_5":14885,"_28401":121508,"_3088":121651},[],"Modo merged Gateway de Envoy",{"_3638":73244,"_31204":73189,"_21623":121653,"_5":14885,"_28401":121508,"_3088":121654},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3638":73245,"_31204":73189,"_21623":121656,"_5":14885,"_28401":121508,"_3088":121657},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3638":73246,"_31204":73189,"_21623":121659,"_5":14885,"_28401":121508,"_3088":121660},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3638":73247,"_31204":73189,"_21623":121662,"_5":14885,"_28401":121508,"_3088":121663},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3638":73248,"_31204":73189,"_21623":121665,"_5":14885,"_28401":121508,"_3088":121666},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3638":73249,"_31204":73189,"_21623":121668,"_5":14885,"_28401":121512,"_3088":121669},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3638":73250,"_31204":73189,"_21623":121671,"_5":14885,"_28401":121516,"_3088":121672},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3638":73251,"_31204":73189,"_21623":121674,"_5":14885,"_28401":121516,"_3088":121675},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3638":73252,"_31204":73189,"_21623":121677,"_5":14885,"_28401":121516,"_3088":121678},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3638":73253,"_31204":73189,"_21623":121680,"_5":14885,"_28401":121516,"_3088":121681},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3638":73254,"_31204":73189,"_21623":121683,"_5":14885,"_28401":121516,"_3088":121684},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3638":73255,"_31204":73189,"_21623":121686,"_5":14885,"_28401":121520,"_3088":121687},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3638":73256,"_31204":73189,"_21623":121689,"_5":14885,"_28401":121520,"_3088":121690},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3638":73257,"_31204":73189,"_21623":121692,"_5":14885,"_28401":121524,"_3088":121693},[],"Comprueba, en orden:",{"_3638":73258,"_31204":73189,"_21623":121695,"_5":14885,"_28401":121524,"_3088":121696},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3638":73259,"_31204":73189,"_21623":121698,"_5":14885,"_28401":121524,"_3088":121699},[],"Su estado contiene la dirección esperada.",{"_3638":73260,"_31204":73189,"_21623":121701,"_5":14885,"_28401":121524,"_3088":121702},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3638":73261,"_31204":73189,"_21623":121704,"_5":14885,"_28401":121524,"_3088":121705},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3638":73262,"_31204":73189,"_21623":121707,"_5":14885,"_28401":121524,"_3088":121708},[],"DNS resuelve al endpoint accesible externamente.",{"_3638":73263,"_31204":73189,"_21623":121710,"_5":14885,"_28401":121524,"_3088":121711},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3638":73264,"_31204":73189,"_21623":121713,"_5":14885,"_28401":121524,"_3088":121714},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3638":73265,"_31204":73265,"_5":15245,"_3088":51158,"_31563":121716,"_21623":121717,"_28401":73265},[51051,120653,120887],[],{"_3638":73266,"_31204":73265,"_21623":121719,"_5":14885,"_28401":73265,"_3088":121720},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3638":73267,"_31204":73265,"_5":31560,"_21623":121722,"_28401":121723,"_3088":121724},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3638":73268,"_31204":73265,"_5":31560,"_21623":121726,"_28401":121727,"_3088":121728},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3638":73269,"_31204":73265,"_5":31560,"_21623":121730,"_28401":121731,"_3088":121732},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3638":73270,"_31204":73265,"_5":31560,"_21623":121734,"_28401":121735,"_3088":121736},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3638":73271,"_31204":73265,"_5":31560,"_21623":121738,"_28401":121739,"_3088":121740},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3638":73272,"_31204":73265,"_5":31560,"_21623":121742,"_28401":121743,"_3088":121744},[],"/docs/pr-preview/pr-83/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3638":73273,"_31204":73265,"_21623":121746,"_5":14885,"_28401":121723,"_3088":121747},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3638":73274,"_31204":73265,"_21623":121749,"_5":14885,"_28401":121727,"_3088":121750},[],"Flujo",{"_3638":73275,"_31204":73265,"_21623":121752,"_5":14885,"_28401":121727,"_3088":121753},[],"Úsalo para",{"_3638":73276,"_31204":73265,"_21623":121755,"_5":14885,"_28401":121727,"_3088":121756},[],"Qué instala",{"_3638":73277,"_31204":73265,"_21623":121758,"_5":14885,"_28401":121727,"_3088":52192},[],{"_3638":73278,"_31204":73265,"_21623":121760,"_5":14885,"_28401":121727,"_3088":121761},[],"Producción y entornos controlados",{"_3638":73279,"_31204":73265,"_21623":121763,"_5":14885,"_28401":121727,"_3088":121764},[],"Servicios de Lamassu y recursos de Gateway API",{"_3638":73280,"_31204":73265,"_21623":121766,"_5":14885,"_28401":121727,"_3088":51295},[],{"_3638":73281,"_31204":73265,"_21623":121768,"_5":14885,"_28401":121727,"_3088":121769},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3638":73282,"_31204":73265,"_21623":121771,"_5":14885,"_28401":121727,"_3088":121772},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3638":73283,"_31204":73265,"_21623":121774,"_5":14885,"_28401":121731,"_3088":121775},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3638":73284,"_31204":73265,"_21623":121777,"_5":14885,"_28401":121731,"_3088":121778},[],"Área",{"_3638":73285,"_31204":73265,"_21623":121780,"_5":14885,"_28401":121731,"_3088":121781},[],"El chart de Lamassu proporciona",{"_3638":73286,"_31204":73265,"_21623":121783,"_5":14885,"_28401":121731,"_3088":121784},[],"Tú proporcionas",{"_3638":73287,"_31204":73265,"_21623":121786,"_5":14885,"_28401":121731,"_3088":121787},[],"Aplicaciones Lamassu",{"_3638":73288,"_31204":73265,"_21623":121789,"_5":14885,"_28401":121731,"_3088":121790},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3638":73289,"_31204":73265,"_21623":121792,"_5":14885,"_28401":121731,"_3088":121793},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3638":73290,"_31204":73265,"_21623":121795,"_5":14885,"_28401":121731,"_3088":121796},[],"Datos PostgreSQL",{"_3638":73291,"_31204":73265,"_21623":121798,"_5":14885,"_28401":121731,"_3088":121799},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3638":73292,"_31204":73265,"_21623":121801,"_5":14885,"_28401":121731,"_3088":121802},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3638":73293,"_31204":73265,"_21623":121804,"_5":14885,"_28401":121731,"_3088":121805},[],"Mensajería",{"_3638":73294,"_31204":73265,"_21623":121807,"_5":14885,"_28401":121731,"_3088":121808},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3638":73295,"_31204":73265,"_21623":121810,"_5":14885,"_28401":121731,"_3088":121811},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3638":73296,"_31204":73265,"_21623":121813,"_5":14885,"_28401":121731,"_3088":121814},[],"Identidad",{"_3638":73297,"_31204":73265,"_21623":121816,"_5":14885,"_28401":121731,"_3088":121817},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3638":73298,"_31204":73265,"_21623":121819,"_5":14885,"_28401":121731,"_3088":121820},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3638":73299,"_31204":73265,"_21623":121822,"_5":14885,"_28401":121731,"_3088":121823},[],"Enrutamiento externo",{"_3638":73300,"_31204":73265,"_21623":121825,"_5":14885,"_28401":121731,"_3088":121826},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3638":73301,"_31204":73265,"_21623":121828,"_5":14885,"_28401":121731,"_3088":121829},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3638":73302,"_31204":73265,"_21623":121831,"_5":14885,"_28401":121731,"_3088":52266},[],{"_3638":73303,"_31204":73265,"_21623":121833,"_5":14885,"_28401":121731,"_3088":121834},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3638":73304,"_31204":73265,"_21623":121836,"_5":14885,"_28401":121731,"_3088":121837},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3638":73305,"_31204":73265,"_21623":121839,"_5":14885,"_28401":121731,"_3088":121840},[],"Datos persistentes de la aplicación",{"_3638":73306,"_31204":73265,"_21623":121842,"_5":14885,"_28401":121731,"_3088":121843},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3638":73307,"_31204":73265,"_21623":121845,"_5":14885,"_28401":121731,"_3088":121846},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3638":73308,"_31204":73265,"_21623":121848,"_5":14885,"_28401":121731,"_3088":121849},[],"Integraciones opcionales",{"_3638":73309,"_31204":73265,"_21623":121851,"_5":14885,"_28401":121731,"_3088":121852},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3638":73310,"_31204":73265,"_21623":121854,"_5":14885,"_28401":121731,"_3088":121855},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3638":73311,"_31204":73265,"_21623":121857,"_5":14885,"_28401":121731,"_3088":121858},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3638":73312,"_31204":73265,"_21623":121860,"_5":14885,"_28401":121731,"_3088":121861},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3638":73313,"_31204":73265,"_21623":121863,"_5":14885,"_28401":121735,"_3088":121864},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3638":73314,"_31204":73265,"_21623":121866,"_5":14885,"_28401":121735,"_3088":121867},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3638":73315,"_31204":73265,"_21623":121869,"_5":14885,"_28401":121739,"_3088":121870},[],"Kubernetes 1.24 o posterior",{"_3638":73316,"_31204":73265,"_21623":121872,"_5":14885,"_28401":121739,"_3088":121873},[],"Helm 3.2 o posterior",{"_3638":73317,"_31204":73265,"_21623":121875,"_5":14885,"_28401":121739,"_3088":121876},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3638":73318,"_31204":73265,"_21623":121878,"_5":14885,"_28401":121739,"_3088":121879},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3638":73319,"_31204":73265,"_21623":121881,"_5":14885,"_28401":121739,"_3088":121882},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3638":73320,"_31204":73265,"_21623":121884,"_5":14885,"_28401":121739,"_3088":121885},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3638":73321,"_31204":73265,"_21623":121887,"_5":14885,"_28401":121739,"_3088":121888},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3638":73322,"_31204":73265,"_21623":121890,"_5":14885,"_28401":121743,"_3088":121891},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3638":73323,"_31204":73265,"_21623":121893,"_5":14885,"_28401":121743,"_3088":121894},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3638":73324,"_31204":73265,"_21623":121896,"_5":14885,"_28401":121743,"_3088":121897},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3638":73325,"_31204":73265,"_21623":121899,"_5":14885,"_28401":121743,"_3088":121900},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3638":73326,"_31204":73326,"_5":15245,"_3088":121902,"_31563":121903,"_21623":121905,"_28401":73326},"Resolución de problemas de despliegue",[51051,120653,121904],"Operación",[],{"_3638":73327,"_31204":73326,"_21623":121907,"_5":14885,"_28401":73326,"_3088":121908},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3638":73328,"_31204":73326,"_5":31560,"_21623":121910,"_28401":121911,"_3088":121912},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3638":73329,"_31204":73326,"_5":31560,"_21623":121914,"_28401":121915,"_3088":121916},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3638":73330,"_31204":73326,"_5":31560,"_21623":121918,"_28401":121919,"_3088":121920},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3638":73331,"_31204":73326,"_5":31560,"_21623":121922,"_28401":121923,"_3088":121924},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3638":73332,"_31204":73326,"_5":31560,"_21623":121926,"_28401":121927,"_3088":121928},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3638":73333,"_31204":73326,"_5":31560,"_21623":121930,"_28401":121931,"_3088":121932},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3638":73334,"_31204":73326,"_5":31560,"_21623":121934,"_28401":121935,"_3088":121936},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3638":73335,"_31204":73326,"_5":31560,"_21623":121938,"_28401":121939,"_3088":121940},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3638":73336,"_31204":73326,"_5":31560,"_21623":121942,"_28401":121943,"_3088":121944},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3638":73337,"_31204":73326,"_5":31560,"_21623":121946,"_28401":121947,"_3088":121948},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3638":73338,"_31204":73326,"_5":31560,"_21623":121950,"_28401":121951,"_3088":121952},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3638":73339,"_31204":73326,"_5":31560,"_21623":121954,"_28401":121955,"_3088":121956},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3638":73340,"_31204":73326,"_5":31560,"_21623":121958,"_28401":121959,"_3088":121960},[],"/docs/pr-preview/pr-83/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3638":73341,"_31204":73326,"_21623":121962,"_5":14885,"_28401":73326,"_3088":121963},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3638":73342,"_31204":73326,"_21623":121965,"_5":14885,"_28401":121915,"_3088":121966},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3638":73343,"_31204":73326,"_21623":121968,"_5":14885,"_28401":121919,"_3088":121969},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3638":73344,"_31204":73326,"_21623":121971,"_5":14885,"_28401":121923,"_3088":121972},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3638":73345,"_31204":73326,"_21623":121974,"_5":14885,"_28401":121927,"_3088":121975},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3638":73346,"_31204":73326,"_21623":121977,"_5":14885,"_28401":121931,"_3088":121978},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3638":73347,"_31204":73326,"_21623":121980,"_5":14885,"_28401":121935,"_3088":121981},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3638":73348,"_31204":73326,"_21623":121983,"_5":14885,"_28401":121935,"_3088":121984},[],"Ejecuta también la prueba de conectividad del chart:",{"_3638":73349,"_31204":73326,"_21623":121986,"_5":14885,"_28401":121935,"_3088":121987},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3638":73350,"_31204":73326,"_21623":121989,"_5":14885,"_28401":121935,"_3088":121990},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3638":73351,"_31204":73326,"_21623":121992,"_5":14885,"_28401":121939,"_3088":121993},[],"Si recibes un 401:",{"_3638":73352,"_31204":73326,"_21623":121995,"_5":14885,"_28401":121939,"_3088":121996},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3638":73353,"_31204":73326,"_21623":121998,"_5":14885,"_28401":121939,"_3088":121999},[],"verifica emisor, audiencia y expiración del token;",{"_3638":73354,"_31204":73326,"_21623":122001,"_5":14885,"_28401":121939,"_3088":122002},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3638":73355,"_31204":73326,"_21623":122004,"_5":14885,"_28401":121939,"_3088":122005},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3638":73356,"_31204":73326,"_21623":122007,"_5":14885,"_28401":121939,"_3088":122008},[],"Si el login termina pero las APIs devuelven 403:",{"_3638":73357,"_31204":73326,"_21623":122010,"_5":14885,"_28401":121939,"_3088":122011},[],"inspecciona los claims reales del token;",{"_3638":73358,"_31204":73326,"_21623":122013,"_5":14885,"_28401":121939,"_3088":122014},[],"confirma que coinciden con un principal activo;",{"_3638":73359,"_31204":73326,"_21623":122016,"_5":14885,"_28401":121939,"_3088":122017},[],"revisa las políticas concedidas al principal;",{"_3638":73360,"_31204":73326,"_21623":122019,"_5":14885,"_28401":121939,"_3088":122020},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3638":73361,"_31204":73326,"_21623":122022,"_5":14885,"_28401":121939,"_3088":122023},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3638":73362,"_31204":73326,"_21623":122025,"_5":14885,"_28401":121943,"_3088":122026},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3638":73363,"_31204":73326,"_21623":122028,"_5":14885,"_28401":121943,"_3088":122029},[],"Localiza el pod y Service de authz.",{"_3638":73364,"_31204":73326,"_21623":122031,"_5":14885,"_28401":121943,"_3088":122032},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3638":73365,"_31204":73326,"_21623":122034,"_5":14885,"_28401":121943,"_3088":122035},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3638":73366,"_31204":73326,"_21623":122037,"_5":14885,"_28401":121943,"_3088":122038},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3638":73367,"_31204":73326,"_21623":122040,"_5":14885,"_28401":121943,"_3088":122041},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3638":73368,"_31204":73326,"_21623":122043,"_5":14885,"_28401":121947,"_3088":122044},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3638":73369,"_31204":73326,"_21623":122046,"_5":14885,"_28401":121951,"_3088":122047},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3638":73370,"_31204":73326,"_21623":122049,"_5":14885,"_28401":121951,"_3088":122050},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3638":73371,"_31204":73326,"_21623":122052,"_5":14885,"_28401":121951,"_3088":122053},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3638":73372,"_31204":73326,"_21623":122055,"_5":14885,"_28401":121951,"_3088":122056},[],"volumen persistente sin enlazar;",{"_3638":73373,"_31204":73326,"_21623":122058,"_5":14885,"_28401":121951,"_3088":122059},[],"imagen inaccesible o política de pull incorrecta;",{"_3638":73374,"_31204":73326,"_21623":122061,"_5":14885,"_28401":121951,"_3088":122062},[],"configuración inválida del motor criptográfico;",{"_3638":73375,"_31204":73326,"_21623":122064,"_5":14885,"_28401":121951,"_3088":122065},[],"límites de CPU o memoria demasiado bajos;",{"_3638":73376,"_31204":73326,"_21623":122067,"_5":14885,"_28401":121951,"_3088":122068},[],"migración previa incompleta.",{"_3638":73377,"_31204":73326,"_21623":122070,"_5":14885,"_28401":121951,"_3088":122071},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3638":73378,"_31204":73326,"_21623":122073,"_5":14885,"_28401":121951,"_3088":122074},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3638":73379,"_31204":73326,"_21623":122076,"_5":14885,"_28401":121951,"_3088":122077},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3638":73380,"_31204":73326,"_21623":122079,"_5":14885,"_28401":121955,"_3088":122080},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3638":73381,"_31204":73326,"_21623":122082,"_5":14885,"_28401":121955,"_3088":122083},[],"verifica que esté habilitado en el servicio emisor;",{"_3638":73382,"_31204":73326,"_21623":122085,"_5":14885,"_28401":121955,"_3088":122086},[],"comprueba conectividad y credenciales AMQP;",{"_3638":73383,"_31204":73326,"_21623":122088,"_5":14885,"_28401":121955,"_3088":122089},[],"revisa exchange, routing key, colas y consumidores;",{"_3638":73384,"_31204":73326,"_21623":122091,"_5":14885,"_28401":121955,"_3088":122092},[],"inspecciona dead-letter queues;",{"_3638":73385,"_31204":73326,"_21623":122094,"_5":14885,"_28401":121955,"_3088":122095},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3638":73386,"_31204":73326,"_21623":122097,"_5":14885,"_28401":121955,"_3088":122098},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3638":73387,"_31204":73326,"_21623":122100,"_5":14885,"_28401":121955,"_3088":122101},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3638":73388,"_31204":73326,"_21623":122103,"_5":14885,"_28401":121955,"_3088":122104},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3638":73389,"_31204":73326,"_21623":122106,"_5":14885,"_28401":121955,"_3088":122107},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3638":73390,"_31204":73326,"_21623":122109,"_5":14885,"_28401":121955,"_3088":122110},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3638":73391,"_31204":73326,"_21623":122112,"_5":14885,"_28401":121955,"_3088":122113},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3638":73392,"_31204":73326,"_21623":122115,"_5":14885,"_28401":121955,"_3088":122116},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3638":73393,"_31204":73326,"_21623":122118,"_5":14885,"_28401":121959,"_3088":122119},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3638":73394,"_31204":73326,"_21623":122121,"_5":14885,"_28401":121959,"_3088":122122},[],"Antes de cerrar una incidencia, guarda:",{"_3638":73395,"_31204":73326,"_21623":122124,"_5":14885,"_28401":121959,"_3088":122125},[],"causa confirmada;",{"_3638":73396,"_31204":73326,"_21623":122127,"_5":14885,"_28401":121959,"_3088":122128},[],"alcance temporal y recursos afectados;",{"_3638":73397,"_31204":73326,"_21623":122130,"_5":14885,"_28401":121959,"_3088":122131},[],"comandos o consultas utilizados;",{"_3638":73398,"_31204":73326,"_21623":122133,"_5":14885,"_28401":121959,"_3088":122134},[],"cambio aplicado y forma de revertirlo;",{"_3638":73399,"_31204":73326,"_21623":122136,"_5":14885,"_28401":121959,"_3088":122137},[],"validación desde un consumidor;",{"_3638":73400,"_31204":73326,"_21623":122139,"_5":14885,"_28401":121959,"_3088":122140},[],"acción preventiva y propietario.",{"_3638":73401,"_31204":73401,"_5":15245,"_3088":122142,"_31563":122143,"_21623":122147,"_28401":73401},"Modelo de datos",[51051,122144,122145,122146],"Plataforma","Administración","Control de acceso",[],{"_3638":73402,"_31204":73401,"_21623":122149,"_5":14885,"_28401":73401,"_3088":122150},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3638":73403,"_31204":73401,"_5":31560,"_21623":122152,"_28401":122153,"_3088":122154},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3638":73404,"_31204":73401,"_5":31560,"_21623":122156,"_28401":122157,"_3088":122158},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3638":73405,"_31204":73401,"_21623":122160,"_5":14885,"_28401":73401,"_3088":122161},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3638":73406,"_31204":73401,"_21623":122163,"_5":14885,"_28401":122153,"_3088":122164},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3638":73407,"_31204":73401,"_21623":122166,"_5":14885,"_28401":122153,"_3088":122167},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3638":73408,"_31204":73401,"_21623":122169,"_5":14885,"_28401":122153,"_3088":122170},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3638":73409,"_31204":73401,"_21623":122172,"_5":14885,"_28401":122157,"_3088":122173},[],"Entidad (`schema_name.entity_type`)",{"_3638":73410,"_31204":73401,"_21623":122175,"_5":14885,"_28401":122157,"_3088":122176},[],"Tabla (`table_name`)",{"_3638":73411,"_31204":73401,"_21623":122178,"_5":14885,"_28401":122157,"_3088":122179},[],"Clave (`primary_key`)",{"_3638":73412,"_31204":73401,"_21623":122181,"_5":14885,"_28401":122157,"_3088":52617},[],{"_3638":73413,"_31204":73401,"_21623":122183,"_5":14885,"_28401":122157,"_3088":52620},[],{"_3638":73414,"_31204":73401,"_21623":122185,"_5":14885,"_28401":122157,"_3088":52623},[],{"_3638":73415,"_31204":73401,"_21623":122187,"_5":14885,"_28401":122157,"_3088":52626},[],{"_3638":73416,"_31204":73401,"_21623":122189,"_5":14885,"_28401":122157,"_3088":52629},[],{"_3638":73417,"_31204":73401,"_21623":122191,"_5":14885,"_28401":122157,"_3088":52632},[],{"_3638":73418,"_31204":73401,"_21623":122193,"_5":14885,"_28401":122157,"_3088":52635},[],{"_3638":73419,"_31204":73401,"_21623":122195,"_5":14885,"_28401":122157,"_3088":52638},[],{"_3638":73420,"_31204":73401,"_21623":122197,"_5":14885,"_28401":122157,"_3088":52632},[],{"_3638":73421,"_31204":73401,"_21623":122199,"_5":14885,"_28401":122157,"_3088":52643},[],{"_3638":73422,"_31204":73401,"_21623":122201,"_5":14885,"_28401":122157,"_3088":52646},[],{"_3638":73423,"_31204":73401,"_21623":122203,"_5":14885,"_28401":122157,"_3088":52649},[],{"_3638":73424,"_31204":73401,"_21623":122205,"_5":14885,"_28401":122157,"_3088":52652},[],{"_3638":73425,"_31204":73401,"_21623":122207,"_5":14885,"_28401":122157,"_3088":52655},[],{"_3638":73426,"_31204":73401,"_21623":122209,"_5":14885,"_28401":122157,"_3088":52632},[],{"_3638":73427,"_31204":73401,"_21623":122211,"_5":14885,"_28401":122157,"_3088":52660},[],{"_3638":73428,"_31204":73401,"_21623":122213,"_5":14885,"_28401":122157,"_3088":52663},[],{"_3638":73429,"_31204":73401,"_21623":122215,"_5":14885,"_28401":122157,"_3088":52632},[],{"_3638":73430,"_31204":73401,"_21623":122217,"_5":14885,"_28401":122157,"_3088":52668},[],{"_3638":73431,"_31204":73401,"_21623":122219,"_5":14885,"_28401":122157,"_3088":52671},[],{"_3638":73432,"_31204":73401,"_21623":122221,"_5":14885,"_28401":122157,"_3088":52632},[],{"_3638":73433,"_31204":73401,"_21623":122223,"_5":14885,"_28401":122157,"_3088":52676},[],{"_3638":73434,"_31204":73401,"_21623":122225,"_5":14885,"_28401":122157,"_3088":52679},[],{"_3638":73435,"_31204":73401,"_21623":122227,"_5":14885,"_28401":122157,"_3088":52632},[],{"_3638":73436,"_31204":73401,"_21623":122229,"_5":14885,"_28401":122157,"_3088":52684},[],{"_3638":73437,"_31204":73401,"_21623":122231,"_5":14885,"_28401":122157,"_3088":52687},[],{"_3638":73438,"_31204":73401,"_21623":122233,"_5":14885,"_28401":122157,"_3088":52690},[],{"_3638":73439,"_31204":73401,"_21623":122235,"_5":14885,"_28401":122157,"_3088":52693},[],{"_3638":73440,"_31204":73401,"_21623":122237,"_5":14885,"_28401":122157,"_3088":52696},[],{"_3638":73441,"_31204":73401,"_21623":122239,"_5":14885,"_28401":122157,"_3088":52699},[],{"_3638":73442,"_31204":73401,"_21623":122241,"_5":14885,"_28401":122157,"_3088":122242},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3638":73443,"_31204":73401,"_21623":122244,"_5":14885,"_28401":122157,"_3088":122245},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3638":73444,"_31204":73401,"_21623":122247,"_5":14885,"_28401":122157,"_3088":122248},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3638":73445,"_31204":73445,"_5":15245,"_3088":122250,"_31563":122251,"_21623":122252,"_28401":73445},"Visión general del control de acceso",[51051,122144,122145,122146],[],{"_3638":73446,"_31204":73445,"_21623":122254,"_5":14885,"_28401":73445,"_3088":122255},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3638":73447,"_31204":73445,"_5":31560,"_21623":122257,"_28401":122258,"_3088":122259},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3638":73448,"_31204":73445,"_5":31560,"_21623":122261,"_28401":122262,"_3088":122263},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3638":73449,"_31204":73445,"_5":31560,"_21623":122265,"_28401":122266,"_3088":122267},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3638":73450,"_31204":73445,"_5":31560,"_21623":122269,"_28401":122270,"_3088":122271},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3638":73451,"_31204":73445,"_5":31560,"_21623":122273,"_28401":122274,"_3088":122275},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3638":73452,"_31204":73445,"_5":31560,"_21623":122277,"_28401":122278,"_3088":122279},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3638":73453,"_31204":73445,"_5":31560,"_21623":122281,"_28401":122282,"_3088":122283},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3638":73454,"_31204":73445,"_5":31560,"_21623":122285,"_28401":122286,"_3088":122287},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3638":73455,"_31204":73445,"_5":31560,"_21623":122289,"_28401":122290,"_3088":122291},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3638":73456,"_31204":73445,"_5":31560,"_21623":122293,"_28401":122294,"_3088":122295},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3638":73457,"_31204":73445,"_5":31560,"_21623":122297,"_28401":122298,"_3088":122299},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3638":73458,"_31204":73445,"_5":31560,"_21623":122301,"_28401":122302,"_3088":122303},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3638":73459,"_31204":73445,"_5":31560,"_21623":122305,"_28401":122306,"_3088":122307},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3638":73460,"_31204":73445,"_5":31560,"_21623":122309,"_28401":122310,"_3088":122311},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3638":73461,"_31204":73445,"_5":31560,"_21623":122313,"_28401":122314,"_3088":122315},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3638":73462,"_31204":73445,"_5":31560,"_21623":122317,"_28401":122318,"_3088":121269},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3638":73463,"_31204":73445,"_5":31560,"_21623":122320,"_28401":122321,"_3088":122322},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3638":73464,"_31204":73445,"_5":31560,"_21623":122324,"_28401":122325,"_3088":122326},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3638":73465,"_31204":73445,"_5":31560,"_21623":122328,"_28401":122329,"_3088":122330},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3638":73466,"_31204":73445,"_5":31560,"_21623":122332,"_28401":122333,"_3088":122334},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3638":73467,"_31204":73445,"_5":31560,"_21623":122336,"_28401":122337,"_3088":122338},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3638":73468,"_31204":73445,"_5":31560,"_21623":122340,"_28401":122341,"_3088":122342},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3638":73469,"_31204":73445,"_5":31560,"_21623":122344,"_28401":122345,"_3088":122346},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3638":73470,"_31204":73445,"_5":31560,"_21623":122348,"_28401":122349,"_3088":122350},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3638":73471,"_31204":73445,"_5":31560,"_21623":122352,"_28401":122353,"_3088":122354},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3638":73472,"_31204":73445,"_5":31560,"_21623":122356,"_28401":122357,"_3088":122358},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3638":73473,"_31204":73445,"_5":31560,"_21623":122360,"_28401":122361,"_3088":122362},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3638":73474,"_31204":73445,"_5":31560,"_21623":122364,"_28401":122365,"_3088":122366},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3638":73475,"_31204":73445,"_5":31560,"_21623":122368,"_28401":122369,"_3088":122370},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3638":73476,"_31204":73445,"_5":31560,"_21623":122372,"_28401":122373,"_3088":122374},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3638":73477,"_31204":73445,"_5":31560,"_21623":122376,"_28401":122377,"_3088":122378},[],"/docs/pr-preview/pr-83/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3638":73478,"_31204":73445,"_21623":122380,"_5":14885,"_28401":73445,"_3088":122381},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3638":73479,"_31204":73445,"_21623":122383,"_5":14885,"_28401":73445,"_3088":122384},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3638":73480,"_31204":73445,"_21623":122386,"_5":14885,"_28401":73445,"_3088":122387},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3638":73481,"_31204":73445,"_21623":122389,"_5":14885,"_28401":122258,"_3088":122390},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3638":73482,"_31204":73445,"_21623":122392,"_5":14885,"_28401":122258,"_3088":122393},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3638":73483,"_31204":73445,"_21623":122395,"_5":14885,"_28401":122258,"_3088":122396},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3638":73484,"_31204":73445,"_21623":122398,"_5":14885,"_28401":122258,"_3088":122399},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3638":73485,"_31204":73445,"_21623":122401,"_5":14885,"_28401":122258,"_3088":122402},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3638":73486,"_31204":73445,"_21623":122404,"_5":14885,"_28401":122258,"_3088":122405},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3638":73487,"_31204":73445,"_21623":122407,"_5":14885,"_28401":122262,"_3088":122408},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3638":73488,"_31204":73445,"_21623":122410,"_5":14885,"_28401":122262,"_3088":122411},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3638":73489,"_31204":73445,"_21623":122413,"_5":14885,"_28401":122266,"_3088":122414},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3638":73490,"_31204":73445,"_21623":122416,"_5":14885,"_28401":122266,"_3088":122417},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3638":73491,"_31204":73445,"_21623":122419,"_5":14885,"_28401":122266,"_3088":122420},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3638":73492,"_31204":73445,"_21623":122422,"_5":14885,"_28401":122266,"_3088":122423},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3638":73493,"_31204":73445,"_21623":122425,"_5":14885,"_28401":122266,"_3088":122426},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3638":73494,"_31204":73445,"_21623":122428,"_5":14885,"_28401":122266,"_3088":122429},[],"Carga por separado las políticas concedidas a cada principal.",{"_3638":73495,"_31204":73445,"_21623":122431,"_5":14885,"_28401":122266,"_3088":122432},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3638":73496,"_31204":73445,"_21623":122434,"_5":14885,"_28401":122266,"_3088":122435},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3638":73497,"_31204":73445,"_21623":122437,"_5":14885,"_28401":122266,"_3088":122438},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3638":73498,"_31204":73445,"_21623":122440,"_5":14885,"_28401":122266,"_3088":122441},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3638":73499,"_31204":73445,"_21623":122443,"_5":14885,"_28401":122266,"_3088":122444},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3638":73500,"_31204":73445,"_21623":122446,"_5":14885,"_28401":122266,"_3088":122447},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3638":73501,"_31204":73445,"_21623":122449,"_5":14885,"_28401":122270,"_3088":122450},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3638":73502,"_31204":73445,"_21623":122452,"_5":14885,"_28401":122270,"_3088":122453},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3638":73503,"_31204":73445,"_21623":122455,"_5":14885,"_28401":122270,"_3088":122456},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3638":73504,"_31204":73445,"_21623":122458,"_5":14885,"_28401":122270,"_3088":122459},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3638":73505,"_31204":73445,"_21623":122461,"_5":14885,"_28401":122270,"_3088":122462},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3638":73506,"_31204":73445,"_21623":122464,"_5":14885,"_28401":122270,"_3088":122465},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3638":73507,"_31204":73445,"_21623":122467,"_5":14885,"_28401":122270,"_3088":122468},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3638":73508,"_31204":73445,"_21623":122470,"_5":14885,"_28401":122270,"_3088":122471},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3638":73509,"_31204":73445,"_21623":122473,"_5":14885,"_28401":122270,"_3088":122474},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3638":73510,"_31204":73445,"_21623":122476,"_5":14885,"_28401":122270,"_3088":122477},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3638":73511,"_31204":73445,"_21623":122479,"_5":14885,"_28401":122274,"_3088":122480},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3638":73512,"_31204":73445,"_21623":122482,"_5":14885,"_28401":122274,"_3088":122483},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3638":73513,"_31204":73445,"_21623":122485,"_5":14885,"_28401":122274,"_3088":122486},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3638":73514,"_31204":73445,"_21623":122488,"_5":14885,"_28401":122274,"_3088":122489},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3638":73515,"_31204":73445,"_21623":122491,"_5":14885,"_28401":122274,"_3088":122492},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3638":73516,"_31204":73445,"_21623":122494,"_5":14885,"_28401":122274,"_3088":122495},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3638":73517,"_31204":73445,"_21623":122497,"_5":14885,"_28401":122274,"_3088":122498},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3638":73518,"_31204":73445,"_21623":122500,"_5":14885,"_28401":122274,"_3088":122501},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3638":73519,"_31204":73445,"_21623":122503,"_5":14885,"_28401":122274,"_3088":122504},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3638":73520,"_31204":73445,"_21623":122506,"_5":14885,"_28401":122274,"_3088":122507},[],"Las acciones se dividen en dos grupos:",{"_3638":73521,"_31204":73445,"_21623":122509,"_5":14885,"_28401":122274,"_3088":122510},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3638":73522,"_31204":73445,"_21623":122512,"_5":14885,"_28401":122274,"_3088":122513},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3638":73523,"_31204":73445,"_21623":122515,"_5":14885,"_28401":122274,"_3088":122516},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3638":73524,"_31204":73445,"_21623":122518,"_5":14885,"_28401":122278,"_3088":122519},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3638":73525,"_31204":73445,"_21623":122521,"_5":14885,"_28401":122278,"_3088":122522},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3638":73526,"_31204":73445,"_21623":122524,"_5":14885,"_28401":122278,"_3088":122525},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3638":73527,"_31204":73445,"_21623":122527,"_5":14885,"_28401":122282,"_3088":122528},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3638":73528,"_31204":73445,"_21623":122530,"_5":14885,"_28401":122282,"_3088":122531},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3638":73529,"_31204":73445,"_21623":122533,"_5":14885,"_28401":122282,"_3088":122534},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3638":73530,"_31204":73445,"_21623":122536,"_5":14885,"_28401":122282,"_3088":122537},[],"Los operadores implementados son:",{"_3638":73531,"_31204":73445,"_21623":122539,"_5":14885,"_28401":122282,"_3088":122540},[],"`equals`, para igualdad exacta;",{"_3638":73532,"_31204":73445,"_21623":122542,"_5":14885,"_28401":122282,"_3088":122543},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3638":73533,"_31204":73445,"_21623":122545,"_5":14885,"_28401":122282,"_3088":122546},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3638":73534,"_31204":73445,"_21623":122548,"_5":14885,"_28401":122282,"_3088":122549},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3638":73535,"_31204":73445,"_21623":122551,"_5":14885,"_28401":122286,"_3088":122552},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3638":73536,"_31204":73445,"_21623":122554,"_5":14885,"_28401":122286,"_3088":122555},[],"Los modos disponibles son:",{"_3638":73537,"_31204":73445,"_21623":122557,"_5":14885,"_28401":122286,"_3088":122558},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3638":73538,"_31204":73445,"_21623":122560,"_5":14885,"_28401":122286,"_3088":122561},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3638":73539,"_31204":73445,"_21623":122563,"_5":14885,"_28401":122286,"_3088":122564},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3638":73540,"_31204":73445,"_21623":122566,"_5":14885,"_28401":122286,"_3088":122567},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3638":73541,"_31204":73445,"_21623":122569,"_5":14885,"_28401":122286,"_3088":122570},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3638":73542,"_31204":73445,"_21623":122572,"_5":14885,"_28401":122286,"_3088":122573},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3638":73543,"_31204":73445,"_21623":122575,"_5":14885,"_28401":122290,"_3088":122576},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3638":73544,"_31204":73445,"_21623":122578,"_5":14885,"_28401":122290,"_3088":122579},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3638":73545,"_31204":73445,"_21623":122581,"_5":14885,"_28401":122290,"_3088":122582},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3638":73546,"_31204":73445,"_21623":122584,"_5":14885,"_28401":122290,"_3088":122585},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3638":73547,"_31204":73445,"_21623":122587,"_5":14885,"_28401":122298,"_3088":122588},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3638":73548,"_31204":73445,"_21623":122590,"_5":14885,"_28401":122298,"_3088":122591},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3638":73549,"_31204":73445,"_21623":122593,"_5":14885,"_28401":122302,"_3088":122594},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3638":73550,"_31204":73445,"_21623":122596,"_5":14885,"_28401":122302,"_3088":122597},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3638":73551,"_31204":73445,"_21623":122599,"_5":14885,"_28401":122302,"_3088":122600},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3638":73552,"_31204":73445,"_21623":122602,"_5":14885,"_28401":122302,"_3088":122603},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3638":73553,"_31204":73445,"_21623":122605,"_5":14885,"_28401":122302,"_3088":122606},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3638":73554,"_31204":73445,"_21623":122608,"_5":14885,"_28401":122306,"_3088":122609},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3638":73555,"_31204":73445,"_21623":122611,"_5":14885,"_28401":122306,"_3088":122612},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3638":73556,"_31204":73445,"_21623":122614,"_5":14885,"_28401":122306,"_3088":122615},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3638":73557,"_31204":73445,"_21623":122617,"_5":14885,"_28401":122310,"_3088":122618},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3638":73558,"_31204":73445,"_21623":122620,"_5":14885,"_28401":122310,"_3088":122621},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3638":73559,"_31204":73445,"_21623":122623,"_5":14885,"_28401":122310,"_3088":122624},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3638":73560,"_31204":73445,"_21623":122626,"_5":14885,"_28401":122310,"_3088":122627},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3638":73561,"_31204":73445,"_21623":122629,"_5":14885,"_28401":122310,"_3088":122630},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3638":73562,"_31204":73445,"_21623":122632,"_5":14885,"_28401":122310,"_3088":122633},[],"Ten en cuenta que:",{"_3638":73563,"_31204":73445,"_21623":122635,"_5":14885,"_28401":122310,"_3088":122636},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3638":73564,"_31204":73445,"_21623":122638,"_5":14885,"_28401":122310,"_3088":122639},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3638":73565,"_31204":73445,"_21623":122641,"_5":14885,"_28401":122310,"_3088":122642},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3638":73566,"_31204":73445,"_21623":122644,"_5":14885,"_28401":122314,"_3088":122645},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3638":73567,"_31204":73445,"_21623":122647,"_5":14885,"_28401":122314,"_3088":122648},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3638":73568,"_31204":73445,"_21623":122650,"_5":14885,"_28401":122314,"_3088":122651},[],"acceso completo y de solo lectura a KMS;",{"_3638":73569,"_31204":73445,"_21623":122653,"_5":14885,"_28401":122314,"_3088":122654},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3638":73570,"_31204":73445,"_21623":122656,"_5":14885,"_28401":122314,"_3088":122657},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3638":73571,"_31204":73445,"_21623":122659,"_5":14885,"_28401":122314,"_3088":122660},[],"acceso a la interfaz;",{"_3638":73572,"_31204":73445,"_21623":122662,"_5":14885,"_28401":122314,"_3088":122663},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3638":73573,"_31204":73445,"_21623":122665,"_5":14885,"_28401":122314,"_3088":122666},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3638":73574,"_31204":73445,"_21623":122668,"_5":14885,"_28401":122314,"_3088":122669},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3638":73575,"_31204":73445,"_21623":122671,"_5":14885,"_28401":122314,"_3088":122672},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3638":73576,"_31204":73445,"_21623":122674,"_5":14885,"_28401":122314,"_3088":122675},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3638":73577,"_31204":73445,"_21623":122677,"_5":14885,"_28401":122318,"_3088":122678},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3638":73578,"_31204":73445,"_21623":122680,"_5":14885,"_28401":122318,"_3088":122681},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3638":73579,"_31204":73445,"_21623":122683,"_5":14885,"_28401":122318,"_3088":122684},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3638":73580,"_31204":73445,"_21623":122686,"_5":14885,"_28401":122321,"_3088":122687},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3638":73581,"_31204":73445,"_21623":122689,"_5":14885,"_28401":122325,"_3088":122690},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3638":73582,"_31204":73445,"_21623":122692,"_5":14885,"_28401":122325,"_3088":122693},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3638":73583,"_31204":73445,"_21623":122695,"_5":14885,"_28401":122329,"_3088":122696},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3638":73584,"_31204":73445,"_21623":122698,"_5":14885,"_28401":122333,"_3088":122699},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3638":73585,"_31204":73445,"_21623":122701,"_5":14885,"_28401":122337,"_3088":122702},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3638":73586,"_31204":73445,"_21623":122704,"_5":14885,"_28401":122341,"_3088":122705},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3638":73587,"_31204":73445,"_21623":122707,"_5":14885,"_28401":122341,"_3088":122708},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3638":73588,"_31204":73445,"_21623":122710,"_5":14885,"_28401":122345,"_3088":122711},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3638":73589,"_31204":73445,"_21623":122713,"_5":14885,"_28401":122345,"_3088":122714},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3638":73590,"_31204":73445,"_21623":122716,"_5":14885,"_28401":122345,"_3088":122717},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3638":73591,"_31204":73445,"_21623":122719,"_5":14885,"_28401":122345,"_3088":122720},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3638":73592,"_31204":73445,"_21623":122722,"_5":14885,"_28401":122345,"_3088":122723},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3638":73593,"_31204":73445,"_21623":122725,"_5":14885,"_28401":122345,"_3088":122726},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3638":73594,"_31204":73445,"_21623":122728,"_5":14885,"_28401":122345,"_3088":122729},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3638":73595,"_31204":73445,"_21623":122731,"_5":14885,"_28401":122345,"_3088":122732},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3638":73596,"_31204":73445,"_21623":122734,"_5":14885,"_28401":122349,"_3088":122735},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3638":73597,"_31204":73445,"_21623":122737,"_5":14885,"_28401":122349,"_3088":122738},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3638":73598,"_31204":73445,"_21623":122740,"_5":14885,"_28401":122349,"_3088":122741},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3638":73599,"_31204":73445,"_21623":122743,"_5":14885,"_28401":122353,"_3088":122744},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3638":73600,"_31204":73445,"_21623":122746,"_5":14885,"_28401":122353,"_3088":122747},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3638":73601,"_31204":73445,"_21623":122749,"_5":14885,"_28401":122353,"_3088":122750},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3638":73602,"_31204":73445,"_21623":122752,"_5":14885,"_28401":122353,"_3088":122753},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3638":73603,"_31204":73445,"_21623":122755,"_5":14885,"_28401":122353,"_3088":122756},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3638":73604,"_31204":73445,"_21623":122758,"_5":14885,"_28401":122353,"_3088":122759},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3638":73605,"_31204":73445,"_21623":122761,"_5":14885,"_28401":122353,"_3088":122762},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3638":73606,"_31204":73445,"_21623":122764,"_5":14885,"_28401":122353,"_3088":122765},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3638":73607,"_31204":73445,"_21623":122767,"_5":14885,"_28401":122361,"_3088":122768},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3638":73608,"_31204":73445,"_21623":122770,"_5":14885,"_28401":122365,"_3088":122771},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3638":73609,"_31204":73445,"_21623":122773,"_5":14885,"_28401":122365,"_3088":122774},[],"que exista un principal activo del tipo correcto;",{"_3638":73610,"_31204":73445,"_21623":122776,"_5":14885,"_28401":122365,"_3088":122777},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3638":73611,"_31204":73445,"_21623":122779,"_5":14885,"_28401":122365,"_3088":122780},[],"que todas las condiciones del principal se cumplan;",{"_3638":73612,"_31204":73445,"_21623":122782,"_5":14885,"_28401":122365,"_3088":122783},[],"que el principal tenga concedida la política esperada;",{"_3638":73613,"_31204":73445,"_21623":122785,"_5":14885,"_28401":122365,"_3088":122786},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3638":73614,"_31204":73445,"_21623":122788,"_5":14885,"_28401":122365,"_3088":122789},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3638":73615,"_31204":73445,"_21623":122791,"_5":14885,"_28401":122365,"_3088":122792},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3638":73616,"_31204":73445,"_21623":122794,"_5":14885,"_28401":122365,"_3088":122795},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3638":73617,"_31204":73445,"_21623":122797,"_5":14885,"_28401":122369,"_3088":122798},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3638":73618,"_31204":73445,"_21623":122800,"_5":14885,"_28401":122373,"_3088":122801},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3638":73619,"_31204":73445,"_21623":122803,"_5":14885,"_28401":122377,"_3088":122804},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3638":73620,"_31204":73445,"_21623":122806,"_5":14885,"_28401":122377,"_3088":122807},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3638":73621,"_31204":73621,"_5":15245,"_3088":122809,"_31563":122810,"_21623":122811,"_28401":73621},"Alertas y suscripciones",[51051,122144,122145],[],{"_3638":73622,"_31204":73621,"_21623":122813,"_5":14885,"_28401":73621,"_3088":122814},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3638":73623,"_31204":73621,"_5":31560,"_21623":122816,"_28401":122817,"_3088":122818},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3638":73624,"_31204":73621,"_5":31560,"_21623":122820,"_28401":122821,"_3088":122822},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3638":73625,"_31204":73621,"_5":31560,"_21623":122824,"_28401":122825,"_3088":122826},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3638":73626,"_31204":73621,"_5":31560,"_21623":122828,"_28401":122829,"_3088":122830},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3638":73627,"_31204":73621,"_5":31560,"_21623":122832,"_28401":122833,"_3088":122834},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3638":73628,"_31204":73621,"_5":31560,"_21623":122836,"_28401":122837,"_3088":122838},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3638":73629,"_31204":73621,"_5":31560,"_21623":122840,"_28401":122841,"_3088":122842},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3638":73630,"_31204":73621,"_5":31560,"_21623":122844,"_28401":122845,"_3088":122846},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3638":73631,"_31204":73621,"_5":31560,"_21623":122848,"_28401":122849,"_3088":122850},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3638":73632,"_31204":73621,"_5":31560,"_21623":122852,"_28401":122853,"_3088":122854},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3638":73633,"_31204":73621,"_5":31560,"_21623":122856,"_28401":122857,"_3088":122858},[],"/docs/pr-preview/pr-83/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3638":73634,"_31204":73621,"_21623":122860,"_5":14885,"_28401":73621,"_3088":122861},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3638":73635,"_31204":73621,"_21623":122863,"_5":14885,"_28401":122817,"_3088":122864},[],"Un servicio publica un evento de dominio.",{"_3638":73636,"_31204":73621,"_21623":122866,"_5":14885,"_28401":122817,"_3088":122867},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3638":73637,"_31204":73621,"_21623":122869,"_5":14885,"_28401":122817,"_3088":122870},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3638":73638,"_31204":73621,"_21623":122872,"_5":14885,"_28401":122817,"_3088":122873},[],"Lamassu entrega el evento al canal configurado.",{"_3638":73639,"_31204":73621,"_21623":122875,"_5":14885,"_28401":122817,"_3088":122876},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3638":73640,"_31204":73621,"_21623":122878,"_5":14885,"_28401":122821,"_3088":122879},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3638":73641,"_31204":73621,"_21623":122881,"_5":14885,"_28401":122821,"_3088":122882},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3638":73642,"_31204":73621,"_21623":122884,"_5":14885,"_28401":122821,"_3088":122885},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3638":73643,"_31204":73621,"_21623":122887,"_5":14885,"_28401":122821,"_3088":122888},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3638":73644,"_31204":73621,"_21623":122890,"_5":14885,"_28401":122821,"_3088":122891},[],"`apikey_options` necesita `header` y `key`.",{"_3638":73645,"_31204":73621,"_21623":122893,"_5":14885,"_28401":122821,"_3088":122894},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3638":73646,"_31204":73621,"_21623":122896,"_5":14885,"_28401":122821,"_3088":122897},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3638":73647,"_31204":73621,"_21623":122899,"_5":14885,"_28401":122821,"_3088":122900},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3638":73648,"_31204":73621,"_21623":122902,"_5":14885,"_28401":122829,"_3088":122903},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3638":73649,"_31204":73621,"_21623":122905,"_5":14885,"_28401":122833,"_3088":122906},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3638":73650,"_31204":73621,"_21623":122908,"_5":14885,"_28401":122837,"_3088":122909},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3638":73651,"_31204":73621,"_21623":122911,"_5":14885,"_28401":122837,"_3088":122912},[],"**None** notifica todas las instancias del evento.",{"_3638":73652,"_31204":73621,"_21623":122914,"_5":14885,"_28401":122837,"_3088":122915},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3638":73653,"_31204":73621,"_21623":122917,"_5":14885,"_28401":122837,"_3088":122918},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3638":73654,"_31204":73621,"_21623":122920,"_5":14885,"_28401":122837,"_3088":122921},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3638":73655,"_31204":73621,"_21623":122923,"_5":14885,"_28401":122837,"_3088":122924},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3638":73656,"_31204":73621,"_21623":122926,"_5":14885,"_28401":122837,"_3088":122927},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3638":73657,"_31204":73621,"_21623":122929,"_5":14885,"_28401":122841,"_3088":122930},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3638":73658,"_31204":73621,"_21623":122932,"_5":14885,"_28401":122845,"_3088":122933},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3638":73659,"_31204":73621,"_21623":122935,"_5":14885,"_28401":122845,"_3088":122936},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3638":73660,"_31204":73621,"_21623":122938,"_5":14885,"_28401":122845,"_3088":122939},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3638":73661,"_31204":73621,"_21623":122941,"_5":14885,"_28401":122845,"_3088":122942},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3638":73662,"_31204":73621,"_21623":122944,"_5":14885,"_28401":122845,"_3088":122945},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3638":73663,"_31204":73621,"_21623":122947,"_5":14885,"_28401":122845,"_3088":122948},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3638":73664,"_31204":73621,"_21623":122950,"_5":14885,"_28401":122845,"_3088":122951},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3638":73665,"_31204":73621,"_21623":122953,"_5":14885,"_28401":122845,"_3088":122954},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3638":73666,"_31204":73621,"_21623":122956,"_5":14885,"_28401":122849,"_3088":122957},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3638":73667,"_31204":73621,"_21623":122959,"_5":14885,"_28401":122849,"_3088":122960},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3638":73668,"_31204":73621,"_21623":122962,"_5":14885,"_28401":122849,"_3088":122963},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3638":73669,"_31204":73621,"_21623":122965,"_5":14885,"_28401":122849,"_3088":122966},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3638":73670,"_31204":73621,"_21623":122968,"_5":14885,"_28401":122849,"_3088":122969},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3638":73671,"_31204":73621,"_21623":122971,"_5":14885,"_28401":122849,"_3088":122972},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3638":73672,"_31204":73621,"_21623":122974,"_5":14885,"_28401":122849,"_3088":122975},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3638":73673,"_31204":73621,"_21623":122977,"_5":14885,"_28401":122849,"_3088":122978},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3638":73674,"_31204":73621,"_21623":122980,"_5":14885,"_28401":122853,"_3088":122981},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3638":73675,"_31204":73621,"_21623":122983,"_5":14885,"_28401":122853,"_3088":122984},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3638":73676,"_31204":73621,"_21623":122986,"_5":14885,"_28401":122857,"_3088":122987},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3638":73677,"_31204":73621,"_21623":122989,"_5":14885,"_28401":122857,"_3088":122990},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3638":73678,"_31204":73621,"_21623":122992,"_5":14885,"_28401":122857,"_3088":122993},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3638":73679,"_31204":73621,"_21623":122995,"_5":14885,"_28401":122857,"_3088":122996},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3638":73680,"_31204":73621,"_21623":122998,"_5":14885,"_28401":122857,"_3088":122999},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3638":73681,"_31204":73621,"_21623":123001,"_5":14885,"_28401":122857,"_3088":123002},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3638":73682,"_31204":73621,"_21623":123004,"_5":14885,"_28401":122857,"_3088":123005},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3638":73683,"_31204":73621,"_21623":123007,"_5":14885,"_28401":122857,"_3088":123008},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3638":73684,"_31204":73621,"_21623":123010,"_5":14885,"_28401":122857,"_3088":123011},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3638":73685,"_31204":73621,"_21623":123013,"_5":14885,"_28401":122857,"_3088":123014},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3638":73686,"_31204":73686,"_5":15245,"_3088":123016,"_31563":123017,"_21623":123018,"_28401":73686},"Registros de auditoría",[51051,122144,122145],[],{"_3638":73687,"_31204":73686,"_21623":123020,"_5":14885,"_28401":73686,"_3088":123021},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3638":73688,"_31204":73686,"_5":31560,"_21623":123023,"_28401":123024,"_3088":123025},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3638":73689,"_31204":73686,"_5":31560,"_21623":123027,"_28401":123028,"_3088":123029},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3638":73690,"_31204":73686,"_5":31560,"_21623":123031,"_28401":123032,"_3088":123033},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3638":73691,"_31204":73686,"_5":31560,"_21623":123035,"_28401":123036,"_3088":123037},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3638":73692,"_31204":73686,"_5":31560,"_21623":123039,"_28401":123040,"_3088":123041},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3638":73693,"_31204":73686,"_5":31560,"_21623":123043,"_28401":123044,"_3088":123045},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3638":73694,"_31204":73686,"_5":31560,"_21623":123047,"_28401":123048,"_3088":123049},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3638":73695,"_31204":73686,"_5":31560,"_21623":123051,"_28401":123052,"_3088":123053},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3638":73696,"_31204":73686,"_5":31560,"_21623":123055,"_28401":123056,"_3088":123057},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3638":73697,"_31204":73686,"_5":31560,"_21623":123059,"_28401":123060,"_3088":123061},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3638":73698,"_31204":73686,"_5":31560,"_21623":123063,"_28401":123064,"_3088":123065},[],"/docs/pr-preview/pr-83/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3638":73699,"_31204":73686,"_21623":123067,"_5":14885,"_28401":73686,"_3088":123068},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3638":73700,"_31204":73686,"_21623":123070,"_5":14885,"_28401":123024,"_3088":123071},[],"El cuerpo de auditoría incluye:",{"_3638":73701,"_31204":73686,"_21623":123073,"_5":14885,"_28401":123024,"_3088":123074},[],"input: datos recibidos por la operación;",{"_3638":73702,"_31204":73686,"_21623":123076,"_5":14885,"_28401":123024,"_3088":123077},[],"has\\_error: indica si el servicio devolvió un error;",{"_3638":73703,"_31204":73686,"_21623":123079,"_5":14885,"_28401":123024,"_3088":123080},[],"output: resultado producido o mensaje de error;",{"_3638":73704,"_31204":73686,"_21623":123082,"_5":14885,"_28401":123024,"_3088":123083},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3638":73705,"_31204":73686,"_21623":123085,"_5":14885,"_28401":123024,"_3088":123086},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3638":73706,"_31204":73686,"_21623":123088,"_5":14885,"_28401":123024,"_3088":123089},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3638":73707,"_31204":73686,"_21623":123091,"_5":14885,"_28401":123028,"_3088":123092},[],"El backend aplica auditoría a mutaciones de:",{"_3638":73708,"_31204":73686,"_21623":123094,"_5":14885,"_28401":123028,"_3088":123095},[],"autoridades, certificados y perfiles de emisión;",{"_3638":73709,"_31204":73686,"_21623":123097,"_5":14885,"_28401":123028,"_3088":123098},[],"claves y motores KMS;",{"_3638":73710,"_31204":73686,"_21623":123100,"_5":14885,"_28401":123028,"_3088":123101},[],"dispositivos e identidades;",{"_3638":73711,"_31204":73686,"_21623":123103,"_5":14885,"_28401":123028,"_3088":123104},[],"DMS y operaciones de enrolamiento;",{"_3638":73712,"_31204":73686,"_21623":123106,"_5":14885,"_28401":123028,"_3088":123107},[],"funciones de validación y CRL;",{"_3638":73713,"_31204":73686,"_21623":123109,"_5":14885,"_28401":123028,"_3088":123110},[],"principales, políticas y concesiones de autorización.",{"_3638":73714,"_31204":73686,"_21623":123112,"_5":14885,"_28401":123028,"_3088":123113},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3638":73715,"_31204":73686,"_21623":123115,"_5":14885,"_28401":123032,"_3088":123116},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3638":73716,"_31204":73686,"_21623":123118,"_5":14885,"_28401":123032,"_3088":123119},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3638":73717,"_31204":73686,"_21623":123121,"_5":14885,"_28401":123032,"_3088":123122},[],"Diseña el consumidor para:",{"_3638":73718,"_31204":73686,"_21623":123124,"_5":14885,"_28401":123032,"_3088":123125},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3638":73719,"_31204":73686,"_21623":123127,"_5":14885,"_28401":123032,"_3088":123128},[],"conservar el CloudEvent completo sin modificar;",{"_3638":73720,"_31204":73686,"_21623":123130,"_5":14885,"_28401":123032,"_3088":123131},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3638":73721,"_31204":73686,"_21623":123133,"_5":14885,"_28401":123032,"_3088":123134},[],"cifrar en tránsito y en reposo;",{"_3638":73722,"_31204":73686,"_21623":123136,"_5":14885,"_28401":123032,"_3088":123137},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3638":73723,"_31204":73686,"_21623":123139,"_5":14885,"_28401":123032,"_3088":123140},[],"aplicar una política explícita de retención y legal hold;",{"_3638":73724,"_31204":73686,"_21623":123142,"_5":14885,"_28401":123032,"_3088":123143},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3638":73725,"_31204":73686,"_21623":123145,"_5":14885,"_28401":123036,"_3088":123146},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3638":73726,"_31204":73686,"_21623":123148,"_5":14885,"_28401":123036,"_3088":123149},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3638":73727,"_31204":73686,"_21623":123151,"_5":14885,"_28401":123044,"_3088":123152},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3638":73728,"_31204":73686,"_21623":123154,"_5":14885,"_28401":123048,"_3088":123155},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3638":73729,"_31204":73686,"_21623":123157,"_5":14885,"_28401":123052,"_3088":123158},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3638":73730,"_31204":73686,"_21623":123160,"_5":14885,"_28401":123056,"_3088":123161},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3638":73731,"_31204":73686,"_21623":123163,"_5":14885,"_28401":123060,"_3088":123164},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3638":73732,"_31204":73686,"_21623":123166,"_5":14885,"_28401":123064,"_3088":123167},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3638":73733,"_31204":73686,"_21623":123169,"_5":14885,"_28401":123064,"_3088":123170},[],"aparece un evento de auditoría correcto;",{"_3638":73734,"_31204":73686,"_21623":123172,"_5":14885,"_28401":123064,"_3088":123173},[],"el principal coincide con la identidad utilizada;",{"_3638":73735,"_31204":73686,"_21623":123175,"_5":14885,"_28401":123064,"_3088":123176},[],"el consumidor lo persiste una sola vez;",{"_3638":73736,"_31204":73686,"_21623":123178,"_5":14885,"_28401":123064,"_3088":123179},[],"puede recuperarse por recurso, actor y periodo;",{"_3638":73737,"_31204":73686,"_21623":123181,"_5":14885,"_28401":123064,"_3088":123182},[],"una interrupción del consumidor produce una alerta.",{"_3638":73738,"_31204":73686,"_21623":123184,"_5":14885,"_28401":123064,"_3088":123185},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3638":73739,"_31204":73739,"_5":15245,"_3088":123187,"_31563":123188,"_21623":123189,"_28401":73739},"Arquitectura de la plataforma",[51051,122144],[],{"_3638":73740,"_31204":73739,"_21623":123191,"_5":14885,"_28401":73739,"_3088":123192},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3638":73741,"_31204":73739,"_5":31560,"_21623":123194,"_28401":123195,"_3088":123196},[],"/docs/pr-preview/pr-83/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3638":73742,"_31204":73739,"_5":31560,"_21623":123198,"_28401":123199,"_3088":123200},[],"/docs/pr-preview/pr-83/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3638":73743,"_31204":73739,"_5":31560,"_21623":123202,"_28401":123203,"_3088":123204},[],"/docs/pr-preview/pr-83/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3638":73744,"_31204":73739,"_5":31560,"_21623":123206,"_28401":123207,"_3088":123208},[],"/docs/pr-preview/pr-83/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3638":73745,"_31204":73739,"_5":31560,"_21623":123210,"_28401":123211,"_3088":123212},[],"/docs/pr-preview/pr-83/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3638":73746,"_31204":73739,"_21623":123214,"_5":14885,"_28401":73739,"_3088":123215},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3638":73747,"_31204":73739,"_21623":123217,"_5":14885,"_28401":73739,"_3088":123218},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3638":73748,"_31204":73739,"_21623":123220,"_5":14885,"_28401":123195,"_3088":123221},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3638":73749,"_31204":73739,"_21623":123223,"_5":14885,"_28401":123199,"_3088":123224},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3638":73750,"_31204":73739,"_21623":123226,"_5":14885,"_28401":123203,"_3088":123227},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3638":73751,"_31204":73739,"_21623":123229,"_5":14885,"_28401":123207,"_3088":123230},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3638":73752,"_31204":73739,"_21623":123232,"_5":14885,"_28401":123211,"_3088":123233},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3638":73753,"_31204":73753,"_5":15245,"_3088":123235,"_31563":123236,"_21623":123237,"_28401":73753},"Cómo funciona Lamassu",[51051,122144],[],{"_3638":73754,"_31204":73753,"_21623":123239,"_5":14885,"_28401":73753,"_3088":123240},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3638":73755,"_31204":73753,"_5":31560,"_21623":123242,"_28401":123243,"_3088":123244},[],"/docs/pr-preview/pr-83/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3638":73756,"_31204":73753,"_5":31560,"_21623":123246,"_28401":123247,"_3088":123248},[],"/docs/pr-preview/pr-83/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3638":73757,"_31204":73753,"_21623":123250,"_5":14885,"_28401":73753,"_3088":123251},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3638":73758,"_31204":73753,"_21623":123253,"_5":14885,"_28401":123243,"_3088":123254},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3638":73759,"_31204":73753,"_21623":123256,"_5":14885,"_28401":123243,"_3088":123257},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3638":73760,"_31204":73753,"_21623":123259,"_5":14885,"_28401":123243,"_3088":123260},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3638":73761,"_31204":73753,"_21623":123262,"_5":14885,"_28401":123243,"_3088":123263},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3638":73762,"_31204":73753,"_21623":123265,"_5":14885,"_28401":123243,"_3088":123266},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3638":73763,"_31204":73753,"_21623":123268,"_5":14885,"_28401":123247,"_3088":123269},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3638":73764,"_31204":73753,"_21623":123271,"_5":14885,"_28401":123247,"_3088":123272},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3638":73765,"_31204":73753,"_21623":123274,"_5":14885,"_28401":123247,"_3088":123275},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3638":73766,"_31204":73753,"_21623":123277,"_5":14885,"_28401":123247,"_3088":123278},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3638":73767,"_31204":73753,"_21623":123280,"_5":14885,"_28401":123247,"_3088":123281},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3638":73768,"_31204":73753,"_21623":123283,"_5":14885,"_28401":123247,"_3088":123284},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3638":73769,"_31204":73753,"_21623":123286,"_5":14885,"_28401":123247,"_3088":123287},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3638":73770,"_31204":73770,"_5":15245,"_3088":123289,"_31563":123290,"_21623":123291,"_28401":73770},"Dispositivos e identidades",[51051,122144,53751,123289],[],{"_3638":73771,"_31204":73770,"_21623":123293,"_5":14885,"_28401":73770,"_3088":123294},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3638":73772,"_31204":73770,"_5":31560,"_21623":123296,"_28401":123297,"_3088":123298},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3638":73773,"_31204":73770,"_5":31560,"_21623":123300,"_28401":123301,"_3088":123302},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3638":73774,"_31204":73770,"_5":31560,"_21623":123304,"_28401":123305,"_3088":123306},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3638":73775,"_31204":73770,"_5":31560,"_21623":123308,"_28401":123309,"_3088":123310},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3638":73776,"_31204":73770,"_5":31560,"_21623":123312,"_28401":123313,"_3088":123314},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3638":73777,"_31204":73770,"_5":31560,"_21623":123316,"_28401":123317,"_3088":123318},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3638":73778,"_31204":73770,"_5":31560,"_21623":123320,"_28401":123321,"_3088":123322},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3638":73779,"_31204":73770,"_5":31560,"_21623":123324,"_28401":123325,"_3088":123326},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3638":73780,"_31204":73770,"_5":31560,"_21623":123328,"_28401":123329,"_3088":123330},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3638":73781,"_31204":73770,"_5":31560,"_21623":123332,"_28401":123333,"_3088":123334},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3638":73782,"_31204":73770,"_5":31560,"_21623":123336,"_28401":123337,"_3088":123338},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3638":73783,"_31204":73770,"_21623":123340,"_5":14885,"_28401":73770,"_3088":123341},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3638":73784,"_31204":73770,"_21623":123343,"_5":14885,"_28401":73770,"_3088":123344},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3638":73785,"_31204":73770,"_21623":123346,"_5":14885,"_28401":123297,"_3088":123347},[],"Vista operativa",{"_3638":73786,"_31204":73770,"_21623":123349,"_5":14885,"_28401":123297,"_3088":123350},[],"Interpretación",{"_3638":73787,"_31204":73770,"_21623":123352,"_5":14885,"_28401":123297,"_3088":53814},[],{"_3638":73788,"_31204":73770,"_21623":123354,"_5":14885,"_28401":123297,"_3088":123355},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3638":73789,"_31204":73770,"_21623":123357,"_5":14885,"_28401":123297,"_3088":53820},[],{"_3638":73790,"_31204":73770,"_21623":123359,"_5":14885,"_28401":123297,"_3088":123360},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3638":73791,"_31204":73770,"_21623":123362,"_5":14885,"_28401":123297,"_3088":53826},[],{"_3638":73792,"_31204":73770,"_21623":123364,"_5":14885,"_28401":123297,"_3088":123365},[],"La identidad está en la ventana operativa de renovación.",{"_3638":73793,"_31204":73770,"_21623":123367,"_5":14885,"_28401":123297,"_3088":53832},[],{"_3638":73794,"_31204":73770,"_21623":123369,"_5":14885,"_28401":123297,"_3088":123370},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3638":73795,"_31204":73770,"_21623":123372,"_5":14885,"_28401":123297,"_3088":53838},[],{"_3638":73796,"_31204":73770,"_21623":123374,"_5":14885,"_28401":123297,"_3088":123375},[],"La identidad ha vencido.",{"_3638":73797,"_31204":73770,"_21623":123377,"_5":14885,"_28401":123297,"_3088":53844},[],{"_3638":73798,"_31204":73770,"_21623":123379,"_5":14885,"_28401":123297,"_3088":123380},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3638":73799,"_31204":73770,"_21623":123382,"_5":14885,"_28401":123297,"_3088":53850},[],{"_3638":73800,"_31204":73770,"_21623":123384,"_5":14885,"_28401":123297,"_3088":123385},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3638":73801,"_31204":73770,"_21623":123387,"_5":14885,"_28401":123297,"_3088":123388},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3638":73802,"_31204":73770,"_21623":123390,"_5":14885,"_28401":123301,"_3088":123391},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3638":73803,"_31204":73770,"_21623":123393,"_5":14885,"_28401":123301,"_3088":123394},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3638":73804,"_31204":73770,"_21623":123396,"_5":14885,"_28401":123301,"_3088":123397},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3638":73805,"_31204":73770,"_21623":123399,"_5":14885,"_28401":123301,"_3088":123400},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3638":73806,"_31204":73770,"_21623":123402,"_5":14885,"_28401":123305,"_3088":123403},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3638":73807,"_31204":73770,"_21623":123405,"_5":14885,"_28401":123309,"_3088":123406},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3638":73808,"_31204":73770,"_21623":123408,"_5":14885,"_28401":123313,"_3088":123409},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3638":73809,"_31204":73770,"_21623":123411,"_5":14885,"_28401":123317,"_3088":123412},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3638":73810,"_31204":73770,"_21623":123414,"_5":14885,"_28401":123321,"_3088":123415},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3638":73811,"_31204":73770,"_21623":123417,"_5":14885,"_28401":123321,"_3088":123418},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3638":73812,"_31204":73770,"_21623":123420,"_5":14885,"_28401":123325,"_3088":123421},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3638":73813,"_31204":73770,"_21623":123423,"_5":14885,"_28401":123325,"_3088":123424},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3638":73814,"_31204":73770,"_21623":123426,"_5":14885,"_28401":123325,"_3088":123427},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3638":73815,"_31204":73770,"_21623":123429,"_5":14885,"_28401":123325,"_3088":123430},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3638":73816,"_31204":73770,"_21623":123432,"_5":14885,"_28401":123325,"_3088":123433},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3638":73817,"_31204":73770,"_21623":123435,"_5":14885,"_28401":123325,"_3088":123436},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3638":73818,"_31204":73770,"_21623":123438,"_5":14885,"_28401":123329,"_3088":123439},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3638":73819,"_31204":73770,"_21623":123441,"_5":14885,"_28401":123329,"_3088":123442},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3638":73820,"_31204":73770,"_21623":123444,"_5":14885,"_28401":123329,"_3088":123445},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3638":73821,"_31204":73770,"_21623":123447,"_5":14885,"_28401":123333,"_3088":123448},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3638":73822,"_31204":73770,"_21623":123450,"_5":14885,"_28401":123333,"_3088":123451},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3638":73823,"_31204":73770,"_21623":123453,"_5":14885,"_28401":123333,"_3088":123454},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3638":73824,"_31204":73770,"_21623":123456,"_5":14885,"_28401":123333,"_3088":123457},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3638":73825,"_31204":73770,"_21623":123459,"_5":14885,"_28401":123337,"_3088":123460},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3638":73826,"_31204":73770,"_21623":123462,"_5":14885,"_28401":123337,"_3088":123463},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3638":73827,"_31204":73827,"_5":15245,"_3088":123465,"_31563":123466,"_21623":123468,"_28401":73827},"Identidad inicial y autenticación",[51051,122144,53751,123289,123467],"Enrolamiento con PKI",[],{"_3638":73828,"_31204":73827,"_21623":123470,"_5":14885,"_28401":73827,"_3088":123471},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3638":73829,"_31204":73827,"_5":31560,"_21623":123473,"_28401":123474,"_3088":123475},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3638":73830,"_31204":73827,"_5":31560,"_21623":123477,"_28401":123478,"_3088":123479},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3638":73831,"_31204":73827,"_5":31560,"_21623":123481,"_28401":123482,"_3088":123483},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3638":73832,"_31204":73827,"_5":31560,"_21623":123485,"_28401":123486,"_3088":123487},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3638":73833,"_31204":73827,"_5":31560,"_21623":123489,"_28401":123490,"_3088":123491},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3638":73834,"_31204":73827,"_21623":123493,"_5":14885,"_28401":73827,"_3088":123494},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3638":73835,"_31204":73827,"_21623":123496,"_5":14885,"_28401":123474,"_3088":123497},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3638":73836,"_31204":73827,"_21623":123499,"_5":14885,"_28401":123474,"_3088":123500},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3638":73837,"_31204":73827,"_21623":123502,"_5":14885,"_28401":123478,"_3088":123503},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3638":73838,"_31204":73827,"_21623":123505,"_5":14885,"_28401":123478,"_3088":123506},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3638":73839,"_31204":73827,"_21623":123508,"_5":14885,"_28401":123478,"_3088":123509},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3638":73840,"_31204":73827,"_21623":123511,"_5":14885,"_28401":123482,"_3088":123512},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3638":73841,"_31204":73827,"_21623":123514,"_5":14885,"_28401":123482,"_3088":123515},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3638":73842,"_31204":73827,"_21623":123517,"_5":14885,"_28401":123486,"_3088":123518},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3638":73843,"_31204":73827,"_21623":123520,"_5":14885,"_28401":123486,"_3088":123521},[],"Ejemplo de cuerpo:",{"_3638":73844,"_31204":73827,"_21623":123523,"_5":14885,"_28401":123486,"_3088":123524},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3638":73845,"_31204":73827,"_21623":123526,"_5":14885,"_28401":123486,"_3088":123527},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3638":73846,"_31204":73827,"_21623":123529,"_5":14885,"_28401":123486,"_3088":123530},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3638":73847,"_31204":73827,"_21623":123532,"_5":14885,"_28401":123486,"_3088":123533},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3638":73848,"_31204":73827,"_21623":123535,"_5":14885,"_28401":123490,"_3088":123536},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3638":73849,"_31204":73827,"_21623":123538,"_5":14885,"_28401":123490,"_3088":123539},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3638":73850,"_31204":73827,"_21623":123541,"_5":14885,"_28401":123490,"_3088":123542},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3638":73851,"_31204":73827,"_21623":123544,"_5":14885,"_28401":123490,"_3088":123545},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3638":73852,"_31204":73852,"_5":15245,"_3088":123547,"_31563":123548,"_21623":123549,"_28401":73852},"Configura y opera el DMS",[51051,122144,53751,123289,123467],[],{"_3638":73853,"_31204":73852,"_21623":123551,"_5":14885,"_28401":73852,"_3088":123552},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3638":73854,"_31204":73852,"_5":31560,"_21623":123554,"_28401":123555,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3638":73855,"_31204":73852,"_5":31560,"_21623":123557,"_28401":123558,"_3088":123559},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3638":73856,"_31204":73852,"_5":31560,"_21623":123561,"_28401":123562,"_3088":123563},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3638":73857,"_31204":73852,"_5":31560,"_21623":123565,"_28401":123566,"_3088":123567},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3638":73858,"_31204":73852,"_5":31560,"_21623":123569,"_28401":123570,"_3088":123571},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3638":73859,"_31204":73852,"_5":31560,"_21623":123573,"_28401":123574,"_3088":123575},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3638":73860,"_31204":73852,"_5":31560,"_21623":123577,"_28401":123578,"_3088":123579},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3638":73861,"_31204":73852,"_5":31560,"_21623":123581,"_28401":123582,"_3088":123583},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3638":73862,"_31204":73852,"_5":31560,"_21623":123585,"_28401":123586,"_3088":54055},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3638":73863,"_31204":73852,"_5":31560,"_21623":123588,"_28401":123589,"_3088":54059},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3638":73864,"_31204":73852,"_5":31560,"_21623":123591,"_28401":123592,"_3088":123593},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3638":73865,"_31204":73852,"_5":31560,"_21623":123595,"_28401":123596,"_3088":123597},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3638":73866,"_31204":73852,"_5":31560,"_21623":123599,"_28401":123600,"_3088":123601},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3638":73867,"_31204":73852,"_5":31560,"_21623":123603,"_28401":123604,"_3088":123605},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3638":73868,"_31204":73852,"_5":31560,"_21623":123607,"_28401":123608,"_3088":54079},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3638":73869,"_31204":73852,"_5":31560,"_21623":123610,"_28401":123611,"_3088":123612},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3638":73870,"_31204":73852,"_5":31560,"_21623":123614,"_28401":123615,"_3088":123616},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3638":73871,"_31204":73852,"_5":31560,"_21623":123618,"_28401":123619,"_3088":123620},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3638":73872,"_31204":73852,"_21623":123622,"_5":14885,"_28401":73852,"_3088":123623},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3638":73873,"_31204":73852,"_21623":123625,"_5":14885,"_28401":123555,"_3088":123626},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3638":73874,"_31204":73852,"_21623":123628,"_5":14885,"_28401":123555,"_3088":123629},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3638":73875,"_31204":73852,"_21623":123631,"_5":14885,"_28401":123562,"_3088":123632},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3638":73876,"_31204":73852,"_21623":123634,"_5":14885,"_28401":123566,"_3088":123635},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3638":73877,"_31204":73852,"_21623":123637,"_5":14885,"_28401":123570,"_3088":123638},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3638":73878,"_31204":73852,"_21623":123640,"_5":14885,"_28401":123574,"_3088":123641},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3638":73879,"_31204":73852,"_21623":123643,"_5":14885,"_28401":123578,"_3088":123644},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3638":73880,"_31204":73852,"_21623":123646,"_5":14885,"_28401":123586,"_3088":123647},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3638":73881,"_31204":73852,"_21623":123649,"_5":14885,"_28401":123586,"_3088":123650},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3638":73882,"_31204":73852,"_21623":123652,"_5":14885,"_28401":123589,"_3088":123653},[],"Campo de `settings.enrollment_settings`",{"_3638":73883,"_31204":73852,"_21623":123655,"_5":14885,"_28401":123589,"_3088":123656},[],"Decisión",{"_3638":73884,"_31204":73852,"_21623":123658,"_5":14885,"_28401":123589,"_3088":54130},[],{"_3638":73885,"_31204":73852,"_21623":123660,"_5":14885,"_28401":123589,"_3088":123661},[],"`EST_RFC7030` para estas operaciones.",{"_3638":73886,"_31204":73852,"_21623":123663,"_5":14885,"_28401":123589,"_3088":54136},[],{"_3638":73887,"_31204":73852,"_21623":123665,"_5":14885,"_28401":123589,"_3088":123666},[],"ID de la CA que firmará.",{"_3638":73888,"_31204":73852,"_21623":123668,"_5":14885,"_28401":123589,"_3088":54142},[],{"_3638":73889,"_31204":73852,"_21623":123670,"_5":14885,"_28401":123589,"_3088":123671},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3638":73890,"_31204":73852,"_21623":123673,"_5":14885,"_28401":123589,"_3088":54148},[],{"_3638":73891,"_31204":73852,"_21623":123675,"_5":14885,"_28401":123589,"_3088":123676},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3638":73892,"_31204":73852,"_21623":123678,"_5":14885,"_28401":123589,"_3088":54154},[],{"_3638":73893,"_31204":73852,"_21623":123680,"_5":14885,"_28401":123589,"_3088":123681},[],"Uno de los cuatro modos de autenticación.",{"_3638":73894,"_31204":73852,"_21623":123683,"_5":14885,"_28401":123589,"_3088":123684},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3638":73895,"_31204":73852,"_21623":123686,"_5":14885,"_28401":123592,"_3088":123687},[],"Los bloques son independientes:",{"_3638":73896,"_31204":73852,"_21623":123689,"_5":14885,"_28401":123592,"_3088":123690},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3638":73897,"_31204":73852,"_21623":123692,"_5":14885,"_28401":123592,"_3088":123693},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3638":73898,"_31204":73852,"_21623":123695,"_5":14885,"_28401":123592,"_3088":54172},[],{"_3638":73899,"_31204":73852,"_21623":123697,"_5":14885,"_28401":123592,"_3088":123698},[],"Control aplicado en la operación configurada",{"_3638":73900,"_31204":73852,"_21623":123700,"_5":14885,"_28401":123592,"_3088":54178},[],{"_3638":73901,"_31204":73852,"_21623":123702,"_5":14885,"_28401":123592,"_3088":123703},[],"Validación del certificado presentado.",{"_3638":73902,"_31204":73852,"_21623":123705,"_5":14885,"_28401":123592,"_3088":54184},[],{"_3638":73903,"_31204":73852,"_21623":123707,"_5":14885,"_28401":123592,"_3088":123708},[],"Autorización del webhook configurado.",{"_3638":73904,"_31204":73852,"_21623":123710,"_5":14885,"_28401":123592,"_3088":54190},[],{"_3638":73905,"_31204":73852,"_21623":123712,"_5":14885,"_28401":123592,"_3088":123713},[],"Validación del certificado y, después, aprobación del webhook.",{"_3638":73906,"_31204":73852,"_21623":123715,"_5":14885,"_28401":123592,"_3088":54196},[],{"_3638":73907,"_31204":73852,"_21623":123717,"_5":14885,"_28401":123592,"_3088":123718},[],"Sin autenticación del solicitante por el DMS.",{"_3638":73908,"_31204":73852,"_21623":123720,"_5":14885,"_28401":123592,"_3088":123721},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3638":73909,"_31204":73852,"_21623":123723,"_5":14885,"_28401":123592,"_3088":123724},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3638":73910,"_31204":73852,"_21623":123726,"_5":14885,"_28401":123592,"_3088":123727},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3638":73911,"_31204":73852,"_21623":123729,"_5":14885,"_28401":123592,"_3088":123730},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3638":73912,"_31204":73852,"_21623":123732,"_5":14885,"_28401":123592,"_3088":123733},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3638":73913,"_31204":73852,"_21623":123735,"_5":14885,"_28401":123596,"_3088":123736},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3638":73914,"_31204":73852,"_21623":123738,"_5":14885,"_28401":123596,"_3088":123739},[],"Campo de `external_webhook_settings`",{"_3638":73915,"_31204":73852,"_21623":123741,"_5":14885,"_28401":123596,"_3088":123656},[],{"_3638":73916,"_31204":73852,"_21623":123743,"_5":14885,"_28401":123596,"_3088":54225},[],{"_3638":73917,"_31204":73852,"_21623":123745,"_5":14885,"_28401":123596,"_3088":123746},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3638":73918,"_31204":73852,"_21623":123748,"_5":14885,"_28401":123596,"_3088":54231},[],{"_3638":73919,"_31204":73852,"_21623":123750,"_5":14885,"_28401":123596,"_3088":123751},[],"`POST` o `PUT`; `POST` por defecto.",{"_3638":73920,"_31204":73852,"_21623":123753,"_5":14885,"_28401":123596,"_3088":54237},[],{"_3638":73921,"_31204":73852,"_21623":123755,"_5":14885,"_28401":123596,"_3088":123756},[],"Etiqueta usada en los logs del servicio.",{"_3638":73922,"_31204":73852,"_21623":123758,"_5":14885,"_28401":123596,"_3088":54243},[],{"_3638":73923,"_31204":73852,"_21623":123760,"_5":14885,"_28401":123596,"_3088":123761},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3638":73924,"_31204":73852,"_21623":123763,"_5":14885,"_28401":123596,"_3088":54249},[],{"_3638":73925,"_31204":73852,"_21623":123765,"_5":14885,"_28401":123596,"_3088":123766},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3638":73926,"_31204":73852,"_21623":123768,"_5":14885,"_28401":123596,"_3088":54255},[],{"_3638":73927,"_31204":73852,"_21623":123770,"_5":14885,"_28401":123596,"_3088":123771},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3638":73928,"_31204":73852,"_21623":123773,"_5":14885,"_28401":123596,"_3088":54261},[],{"_3638":73929,"_31204":73852,"_21623":123775,"_5":14885,"_28401":123596,"_3088":123776},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3638":73930,"_31204":73852,"_21623":123778,"_5":14885,"_28401":123596,"_3088":54267},[],{"_3638":73931,"_31204":73852,"_21623":123780,"_5":14885,"_28401":123596,"_3088":123781},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3638":73932,"_31204":73852,"_21623":123783,"_5":14885,"_28401":123596,"_3088":54273},[],{"_3638":73933,"_31204":73852,"_21623":123785,"_5":14885,"_28401":123596,"_3088":123786},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3638":73934,"_31204":73852,"_21623":123788,"_5":14885,"_28401":123596,"_3088":54279},[],{"_3638":73935,"_31204":73852,"_21623":123790,"_5":14885,"_28401":123596,"_3088":123791},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3638":73936,"_31204":73852,"_21623":123793,"_5":14885,"_28401":123596,"_3088":123794},[],"Reglas de esa configuración:",{"_3638":73937,"_31204":73852,"_21623":123796,"_5":14885,"_28401":123596,"_3088":123797},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3638":73938,"_31204":73852,"_21623":123799,"_5":14885,"_28401":123596,"_3088":123800},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3638":73939,"_31204":73852,"_21623":123802,"_5":14885,"_28401":123596,"_3088":123803},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3638":73940,"_31204":73852,"_21623":123805,"_5":14885,"_28401":123596,"_3088":123806},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3638":73941,"_31204":73852,"_21623":123808,"_5":14885,"_28401":123596,"_3088":123809},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3638":73942,"_31204":73852,"_21623":123811,"_5":14885,"_28401":123596,"_3088":123812},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3638":73943,"_31204":73852,"_21623":123814,"_5":14885,"_28401":123596,"_3088":123815},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3638":73944,"_31204":73852,"_21623":123817,"_5":14885,"_28401":123596,"_3088":123818},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3638":73945,"_31204":73852,"_21623":123820,"_5":14885,"_28401":123596,"_3088":123821},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3638":73946,"_31204":73852,"_21623":123823,"_5":14885,"_28401":123600,"_3088":123824},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3638":73947,"_31204":73852,"_21623":123826,"_5":14885,"_28401":123604,"_3088":123827},[],"Campo de `settings.reenrollment_settings`",{"_3638":73948,"_31204":73852,"_21623":123829,"_5":14885,"_28401":123604,"_3088":123830},[],"Función",{"_3638":73949,"_31204":73852,"_21623":123832,"_5":14885,"_28401":123604,"_3088":54323},[],{"_3638":73950,"_31204":73852,"_21623":123834,"_5":14885,"_28401":123604,"_3088":123835},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3638":73951,"_31204":73852,"_21623":123837,"_5":14885,"_28401":123604,"_3088":54329},[],{"_3638":73952,"_31204":73852,"_21623":123839,"_5":14885,"_28401":123604,"_3088":123840},[],"Umbral operativo preventivo de monitorización.",{"_3638":73953,"_31204":73852,"_21623":123842,"_5":14885,"_28401":123604,"_3088":54335},[],{"_3638":73954,"_31204":73852,"_21623":123844,"_5":14885,"_28401":123604,"_3088":123845},[],"Umbral operativo crítico de monitorización.",{"_3638":73955,"_31204":73852,"_21623":123847,"_5":14885,"_28401":123604,"_3088":54341},[],{"_3638":73956,"_31204":73852,"_21623":123849,"_5":14885,"_28401":123604,"_3088":123850},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3638":73957,"_31204":73852,"_21623":123852,"_5":14885,"_28401":123604,"_3088":54347},[],{"_3638":73958,"_31204":73852,"_21623":123854,"_5":14885,"_28401":123604,"_3088":123855},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3638":73959,"_31204":73852,"_21623":123857,"_5":14885,"_28401":123604,"_3088":54353},[],{"_3638":73960,"_31204":73852,"_21623":123859,"_5":14885,"_28401":123604,"_3088":123860},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3638":73961,"_31204":73852,"_21623":123862,"_5":14885,"_28401":123604,"_3088":123863},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3638":73962,"_31204":73852,"_21623":123865,"_5":14885,"_28401":123608,"_3088":123866},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3638":73963,"_31204":73852,"_21623":123868,"_5":14885,"_28401":123611,"_3088":121026},[],{"_3638":73964,"_31204":73852,"_21623":123870,"_5":14885,"_28401":123611,"_3088":123871},[],"Qué publica",{"_3638":73965,"_31204":73852,"_21623":123873,"_5":14885,"_28401":123611,"_3088":54370},[],{"_3638":73966,"_31204":73852,"_21623":123875,"_5":14885,"_28401":123611,"_3088":123876},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3638":73967,"_31204":73852,"_21623":123878,"_5":14885,"_28401":123611,"_3088":54376},[],{"_3638":73968,"_31204":73852,"_21623":123880,"_5":14885,"_28401":123611,"_3088":123881},[],"Certificado de la CA emisora seleccionada.",{"_3638":73969,"_31204":73852,"_21623":123883,"_5":14885,"_28401":123611,"_3088":54382},[],{"_3638":73970,"_31204":73852,"_21623":123885,"_5":14885,"_28401":123611,"_3088":123886},[],"Certificados de las CAs elegidas explícitamente.",{"_3638":73971,"_31204":73852,"_21623":123888,"_5":14885,"_28401":123611,"_3088":123889},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3638":73972,"_31204":73852,"_21623":123891,"_5":14885,"_28401":123615,"_3088":123892},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3638":73973,"_31204":73852,"_21623":123894,"_5":14885,"_28401":123615,"_3088":123895},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3638":73974,"_31204":73852,"_21623":123897,"_5":14885,"_28401":123615,"_3088":123898},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3638":73975,"_31204":73852,"_21623":123900,"_5":14885,"_28401":123619,"_3088":123901},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3638":73976,"_31204":73976,"_5":15245,"_3088":123903,"_31563":123904,"_21623":123905,"_28401":73976},"Integra el cliente EST",[51051,122144,53751,123289,123467],[],{"_3638":73977,"_31204":73976,"_21623":123907,"_5":14885,"_28401":73976,"_3088":123908},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3638":73978,"_31204":73976,"_5":31560,"_21623":123910,"_28401":123911,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3638":73979,"_31204":73976,"_5":31560,"_21623":123913,"_28401":123914,"_3088":123915},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3638":73980,"_31204":73976,"_5":31560,"_21623":123917,"_28401":123918,"_3088":123919},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3638":73981,"_31204":73976,"_5":31560,"_21623":123921,"_28401":123922,"_3088":123923},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3638":73982,"_31204":73976,"_5":31560,"_21623":123925,"_28401":123926,"_3088":123927},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3638":73983,"_31204":73976,"_5":31560,"_21623":123929,"_28401":123930,"_3088":123931},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3638":73984,"_31204":73976,"_21623":123933,"_5":14885,"_28401":73976,"_3088":123934},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3638":73985,"_31204":73976,"_21623":123936,"_5":14885,"_28401":123911,"_3088":123937},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3638":73986,"_31204":73976,"_21623":123939,"_5":14885,"_28401":123911,"_3088":123940},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3638":73987,"_31204":73976,"_21623":123942,"_5":14885,"_28401":123911,"_3088":123943},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3638":73988,"_31204":73976,"_21623":123945,"_5":14885,"_28401":123914,"_3088":123946},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3638":73989,"_31204":73976,"_21623":123948,"_5":14885,"_28401":123914,"_3088":123949},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3638":73990,"_31204":73976,"_21623":123951,"_5":14885,"_28401":123918,"_3088":123952},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3638":73991,"_31204":73976,"_21623":123954,"_5":14885,"_28401":123918,"_3088":123955},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3638":73992,"_31204":73976,"_21623":123957,"_5":14885,"_28401":123922,"_3088":123958},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3638":73993,"_31204":73976,"_21623":123960,"_5":14885,"_28401":123922,"_3088":123961},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3638":73994,"_31204":73976,"_21623":123963,"_5":14885,"_28401":123926,"_3088":123964},[],"Para el caso de una raíz que emite directamente:",{"_3638":73995,"_31204":73976,"_21623":123966,"_5":14885,"_28401":123926,"_3088":123967},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3638":73996,"_31204":73976,"_21623":123969,"_5":14885,"_28401":123926,"_3088":123970},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3638":73997,"_31204":73976,"_21623":123972,"_5":14885,"_28401":123930,"_3088":123973},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3638":73998,"_31204":73998,"_5":15245,"_3088":123975,"_31563":123976,"_21623":123977,"_28401":73998},"Referencia EST",[51051,122144,53751,123289,123467],[],{"_3638":73999,"_31204":73998,"_21623":123979,"_5":14885,"_28401":73998,"_3088":123980},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3638":74000,"_31204":73998,"_5":31560,"_21623":123982,"_28401":123983,"_3088":123984},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3638":74001,"_31204":73998,"_5":31560,"_21623":123986,"_28401":123987,"_3088":23426},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3638":74002,"_31204":73998,"_5":31560,"_21623":123989,"_28401":123990,"_3088":26941},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3638":74003,"_31204":73998,"_5":31560,"_21623":123992,"_28401":123993,"_3088":26948},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3638":74004,"_31204":73998,"_5":31560,"_21623":123995,"_28401":123996,"_3088":26210},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3638":74005,"_31204":73998,"_5":31560,"_21623":123998,"_28401":123999,"_3088":124000},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3638":74006,"_31204":73998,"_5":31560,"_21623":124002,"_28401":124003,"_3088":124004},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3638":74007,"_31204":73998,"_5":31560,"_21623":124006,"_28401":124007,"_3088":124008},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3638":74008,"_31204":73998,"_21623":124010,"_5":14885,"_28401":73998,"_3088":124011},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3638":74009,"_31204":73998,"_21623":124013,"_5":14885,"_28401":123983,"_3088":124014},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3638":74010,"_31204":73998,"_21623":124016,"_5":14885,"_28401":123983,"_3088":121904},[],{"_3638":74011,"_31204":73998,"_21623":124018,"_5":14885,"_28401":123983,"_3088":124019},[],"Método",{"_3638":74012,"_31204":73998,"_21623":124021,"_5":14885,"_28401":123983,"_3088":124022},[],"Autenticación y condición",{"_3638":74013,"_31204":73998,"_21623":124024,"_5":14885,"_28401":123983,"_3088":54525},[],{"_3638":74014,"_31204":73998,"_21623":124026,"_5":14885,"_28401":123983,"_3088":54528},[],{"_3638":74015,"_31204":73998,"_21623":124028,"_5":14885,"_28401":123983,"_3088":124029},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3638":74016,"_31204":73998,"_21623":124031,"_5":14885,"_28401":123983,"_3088":54534},[],{"_3638":74017,"_31204":73998,"_21623":124033,"_5":14885,"_28401":123983,"_3088":54537},[],{"_3638":74018,"_31204":73998,"_21623":124035,"_5":14885,"_28401":123983,"_3088":124036},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3638":74019,"_31204":73998,"_21623":124038,"_5":14885,"_28401":123983,"_3088":54543},[],{"_3638":74020,"_31204":73998,"_21623":124040,"_5":14885,"_28401":123983,"_3088":54537},[],{"_3638":74021,"_31204":73998,"_21623":124042,"_5":14885,"_28401":123983,"_3088":124043},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3638":74022,"_31204":73998,"_21623":124045,"_5":14885,"_28401":123983,"_3088":54551},[],{"_3638":74023,"_31204":73998,"_21623":124047,"_5":14885,"_28401":123983,"_3088":54537},[],{"_3638":74024,"_31204":73998,"_21623":124049,"_5":14885,"_28401":123983,"_3088":124050},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3638":74025,"_31204":73998,"_21623":124052,"_5":14885,"_28401":123983,"_3088":124053},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3638":74026,"_31204":73998,"_21623":124055,"_5":14885,"_28401":123987,"_3088":124056},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3638":74027,"_31204":73998,"_21623":124058,"_5":14885,"_28401":123987,"_3088":124059},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3638":74028,"_31204":73998,"_21623":124061,"_5":14885,"_28401":123990,"_3088":124062},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3638":74029,"_31204":73998,"_21623":124064,"_5":14885,"_28401":123990,"_3088":124065},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3638":74030,"_31204":73998,"_21623":124067,"_5":14885,"_28401":123993,"_3088":124068},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3638":74031,"_31204":73998,"_21623":124070,"_5":14885,"_28401":123993,"_3088":124071},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3638":74032,"_31204":73998,"_21623":124073,"_5":14885,"_28401":123996,"_3088":124074},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3638":74033,"_31204":73998,"_21623":124076,"_5":14885,"_28401":123996,"_3088":124077},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3638":74034,"_31204":73998,"_21623":124079,"_5":14885,"_28401":123999,"_3088":124080},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3638":74035,"_31204":73998,"_21623":124082,"_5":14885,"_28401":123999,"_3088":124083},[],"Parte",{"_3638":74036,"_31204":73998,"_21623":124085,"_5":14885,"_28401":123999,"_3088":124086},[],"Contenido tras decodificar su Base64",{"_3638":74037,"_31204":73998,"_21623":124088,"_5":14885,"_28401":123999,"_3088":54595},[],{"_3638":74038,"_31204":73998,"_21623":124090,"_5":14885,"_28401":123999,"_3088":124091},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3638":74039,"_31204":73998,"_21623":124093,"_5":14885,"_28401":123999,"_3088":54601},[],{"_3638":74040,"_31204":73998,"_21623":124095,"_5":14885,"_28401":123999,"_3088":124096},[],"PKCS#7 DER con el certificado emitido.",{"_3638":74041,"_31204":73998,"_21623":124098,"_5":14885,"_28401":123999,"_3088":124099},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3638":74042,"_31204":73998,"_21623":124101,"_5":14885,"_28401":124003,"_3088":124102},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3638":74043,"_31204":73998,"_21623":124104,"_5":14885,"_28401":124003,"_3088":124105},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3638":74044,"_31204":73998,"_21623":124107,"_5":14885,"_28401":124003,"_3088":124108},[],"Convierte y comprueba el resultado:",{"_3638":74045,"_31204":73998,"_21623":124110,"_5":14885,"_28401":124003,"_3088":124111},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3638":74046,"_31204":73998,"_21623":124113,"_5":14885,"_28401":124007,"_3088":124114},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3638":74047,"_31204":73998,"_21623":124116,"_5":14885,"_28401":124007,"_3088":124117},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3638":74048,"_31204":74048,"_5":15245,"_3088":123467,"_31563":124119,"_21623":124120,"_28401":74048},[51051,122144,53751,123289,123467],[],{"_3638":74049,"_31204":74048,"_21623":124122,"_5":14885,"_28401":74048,"_3088":124123},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3638":74050,"_31204":74048,"_5":31560,"_21623":124125,"_28401":124126,"_3088":124127},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3638":74051,"_31204":74048,"_5":31560,"_21623":124129,"_28401":124130,"_3088":124131},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3638":74052,"_31204":74048,"_5":31560,"_21623":124133,"_28401":124134,"_3088":124135},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3638":74053,"_31204":74048,"_21623":124137,"_5":14885,"_28401":74048,"_3088":124138},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3638":74054,"_31204":74048,"_21623":124140,"_5":14885,"_28401":124126,"_3088":124141},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3638":74055,"_31204":74048,"_21623":124143,"_5":14885,"_28401":124126,"_3088":124144},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3638":74056,"_31204":74048,"_21623":124146,"_5":14885,"_28401":124126,"_3088":124147},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3638":74057,"_31204":74048,"_21623":124149,"_5":14885,"_28401":124126,"_3088":124150},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3638":74058,"_31204":74048,"_21623":124152,"_5":14885,"_28401":124126,"_3088":124153},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3638":74059,"_31204":74048,"_21623":124155,"_5":14885,"_28401":124126,"_3088":124156},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3638":74060,"_31204":74048,"_21623":124158,"_5":14885,"_28401":124130,"_3088":124159},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3638":74061,"_31204":74048,"_21623":124161,"_5":14885,"_28401":124130,"_3088":124162},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3638":74062,"_31204":74048,"_21623":124164,"_5":14885,"_28401":124130,"_3088":124165},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3638":74063,"_31204":74048,"_21623":124167,"_5":14885,"_28401":124130,"_3088":124168},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3638":74064,"_31204":74048,"_21623":124170,"_5":14885,"_28401":124134,"_3088":124171},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3638":74065,"_31204":74048,"_21623":124173,"_5":14885,"_28401":124134,"_3088":124174},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3638":74066,"_31204":74048,"_21623":124176,"_5":14885,"_28401":124134,"_3088":124177},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3638":74067,"_31204":74048,"_21623":124179,"_5":14885,"_28401":124134,"_3088":124180},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3638":74068,"_31204":74048,"_21623":124182,"_5":14885,"_28401":124134,"_3088":124183},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3638":74069,"_31204":74069,"_5":15245,"_3088":124185,"_31563":124186,"_21623":124187,"_28401":74069},"Estrategias de aprovisionamiento",[51051,122144,53751,123289,123467],[],{"_3638":74070,"_31204":74069,"_21623":124189,"_5":14885,"_28401":74069,"_3088":124190},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3638":74071,"_31204":74069,"_5":31560,"_21623":124192,"_28401":124193,"_3088":124194},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3638":74072,"_31204":74069,"_5":31560,"_21623":124196,"_28401":124197,"_3088":124198},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3638":74073,"_31204":74069,"_5":31560,"_21623":124200,"_28401":124201,"_3088":124202},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3638":74074,"_31204":74069,"_5":31560,"_21623":124204,"_28401":124205,"_3088":124206},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3638":74075,"_31204":74069,"_5":31560,"_21623":124208,"_28401":124209,"_3088":124210},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3638":74076,"_31204":74069,"_21623":124212,"_5":14885,"_28401":74069,"_3088":124213},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3638":74077,"_31204":74069,"_21623":124215,"_5":14885,"_28401":124193,"_3088":124216},[],"Recorrido",{"_3638":74078,"_31204":74069,"_21623":124218,"_5":14885,"_28401":124193,"_3088":124219},[],"Cuándo existe el dispositivo",{"_3638":74079,"_31204":74069,"_21623":124221,"_5":14885,"_28401":124193,"_3088":124222},[],"Qué compruebas",{"_3638":74080,"_31204":74069,"_21623":124224,"_5":14885,"_28401":124193,"_3088":124225},[],"Asignación manual",{"_3638":74081,"_31204":74069,"_21623":124227,"_5":14885,"_28401":124193,"_3088":124228},[],"El operador lo crea antes de asociar un certificado.",{"_3638":74082,"_31204":74069,"_21623":124230,"_5":14885,"_28401":124193,"_3088":124231},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3638":74083,"_31204":74069,"_21623":124233,"_5":14885,"_28401":124193,"_3088":124234},[],"EST con `JITP`",{"_3638":74084,"_31204":74069,"_21623":124236,"_5":14885,"_28401":124193,"_3088":124237},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3638":74085,"_31204":74069,"_21623":124239,"_5":14885,"_28401":124193,"_3088":124240},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3638":74086,"_31204":74069,"_21623":124242,"_5":14885,"_28401":124193,"_3088":124243},[],"EST con `PRE_REGISTRATION`",{"_3638":74087,"_31204":74069,"_21623":124245,"_5":14885,"_28401":124193,"_3088":124246},[],"Debe existir antes de `/simpleenroll`.",{"_3638":74088,"_31204":74069,"_21623":124248,"_5":14885,"_28401":124193,"_3088":124249},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3638":74089,"_31204":74069,"_21623":124251,"_5":14885,"_28401":124193,"_3088":124252},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3638":74090,"_31204":74069,"_21623":124254,"_5":14885,"_28401":124193,"_3088":124255},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3638":74091,"_31204":74069,"_21623":124257,"_5":14885,"_28401":124197,"_3088":124258},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3638":74092,"_31204":74069,"_21623":124260,"_5":14885,"_28401":124197,"_3088":124261},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3638":74093,"_31204":74069,"_21623":124263,"_5":14885,"_28401":124197,"_3088":124264},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3638":74094,"_31204":74069,"_21623":124266,"_5":14885,"_28401":124201,"_3088":124267},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3638":74095,"_31204":74069,"_21623":124269,"_5":14885,"_28401":124201,"_3088":124270},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3638":74096,"_31204":74069,"_21623":124272,"_5":14885,"_28401":124201,"_3088":124273},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3638":74097,"_31204":74069,"_21623":124275,"_5":14885,"_28401":124201,"_3088":124276},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3638":74098,"_31204":74069,"_21623":124278,"_5":14885,"_28401":124201,"_3088":124279},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3638":74099,"_31204":74069,"_21623":124281,"_5":14885,"_28401":124201,"_3088":124282},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3638":74100,"_31204":74069,"_21623":124284,"_5":14885,"_28401":124205,"_3088":121026},[],{"_3638":74101,"_31204":74069,"_21623":124286,"_5":14885,"_28401":124205,"_3088":124287},[],"Material que atraviesa EST",{"_3638":74102,"_31204":74069,"_21623":124289,"_5":14885,"_28401":124205,"_3088":124290},[],"Clave generada por el dispositivo",{"_3638":74103,"_31204":74069,"_21623":124292,"_5":14885,"_28401":124205,"_3088":124293},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3638":74104,"_31204":74069,"_21623":124295,"_5":14885,"_28401":124205,"_3088":124296},[],"Clave ya disponible en el dispositivo",{"_3638":74105,"_31204":74069,"_21623":124298,"_5":14885,"_28401":124205,"_3088":124299},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3638":74106,"_31204":74069,"_21623":124301,"_5":14885,"_28401":124205,"_3088":54079},[],{"_3638":74107,"_31204":74069,"_21623":124303,"_5":14885,"_28401":124205,"_3088":124304},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3638":74108,"_31204":74069,"_21623":124306,"_5":14885,"_28401":124205,"_3088":124307},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3638":74109,"_31204":74069,"_21623":124309,"_5":14885,"_28401":124209,"_3088":124310},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3638":74110,"_31204":74110,"_5":15245,"_3088":124312,"_31563":124313,"_21623":124314,"_28401":74110},"Renovación y recuperación",[51051,122144,53751,123289,123467],[],{"_3638":74111,"_31204":74110,"_21623":124316,"_5":14885,"_28401":74110,"_3088":124317},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3638":74112,"_31204":74110,"_5":31560,"_21623":124319,"_28401":124320,"_3088":124321},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3638":74113,"_31204":74110,"_5":31560,"_21623":124323,"_28401":124324,"_3088":124325},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3638":74114,"_31204":74110,"_5":31560,"_21623":124327,"_28401":124328,"_3088":124329},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3638":74115,"_31204":74110,"_5":31560,"_21623":124331,"_28401":124332,"_3088":124333},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3638":74116,"_31204":74110,"_5":31560,"_21623":124335,"_28401":124336,"_3088":124337},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3638":74117,"_31204":74110,"_21623":124339,"_5":14885,"_28401":74110,"_3088":124340},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3638":74118,"_31204":74110,"_21623":124342,"_5":14885,"_28401":124320,"_3088":124343},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3638":74119,"_31204":74110,"_21623":124345,"_5":14885,"_28401":124320,"_3088":124346},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3638":74120,"_31204":74110,"_21623":124348,"_5":14885,"_28401":124320,"_3088":124349},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3638":74121,"_31204":74110,"_21623":124351,"_5":14885,"_28401":124320,"_3088":124352},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3638":74122,"_31204":74110,"_21623":124354,"_5":14885,"_28401":124324,"_3088":124355},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3638":74123,"_31204":74110,"_21623":124357,"_5":14885,"_28401":124324,"_3088":124358},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3638":74124,"_31204":74110,"_21623":124360,"_5":14885,"_28401":124328,"_3088":124361},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3638":74125,"_31204":74110,"_21623":124363,"_5":14885,"_28401":124328,"_3088":124364},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3638":74126,"_31204":74110,"_21623":124366,"_5":14885,"_28401":124328,"_3088":124367},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3638":74127,"_31204":74110,"_21623":124369,"_5":14885,"_28401":124332,"_3088":124370},[],"Situación",{"_3638":74128,"_31204":74110,"_21623":124372,"_5":14885,"_28401":124332,"_3088":124373},[],"Procedimiento",{"_3638":74129,"_31204":74110,"_21623":124375,"_5":14885,"_28401":124332,"_3088":124376},[],"Certificado vigente, fuera de ventana",{"_3638":74130,"_31204":74110,"_21623":124378,"_5":14885,"_28401":124332,"_3088":124379},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3638":74131,"_31204":74110,"_21623":124381,"_5":14885,"_28401":124332,"_3088":124382},[],"Certificado vencido, clave disponible",{"_3638":74132,"_31204":74110,"_21623":124384,"_5":14885,"_28401":124332,"_3088":124385},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3638":74133,"_31204":74110,"_21623":124387,"_5":14885,"_28401":124332,"_3088":124388},[],"Renovación por webhook o `NO_AUTH`",{"_3638":74134,"_31204":74110,"_21623":124390,"_5":14885,"_28401":124332,"_3088":124391},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3638":74135,"_31204":74110,"_21623":124393,"_5":14885,"_28401":124332,"_3088":124394},[],"Clave perdida o inaccesible",{"_3638":74136,"_31204":74110,"_21623":124396,"_5":14885,"_28401":124332,"_3088":124397},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3638":74137,"_31204":74110,"_21623":124399,"_5":14885,"_28401":124332,"_3088":124400},[],"Identidad actual revocada",{"_3638":74138,"_31204":74110,"_21623":124402,"_5":14885,"_28401":124332,"_3088":124403},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3638":74139,"_31204":74110,"_21623":124405,"_5":14885,"_28401":124332,"_3088":124406},[],"Dispositivo sin identidad",{"_3638":74140,"_31204":74110,"_21623":124408,"_5":14885,"_28401":124332,"_3088":124409},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3638":74141,"_31204":74110,"_21623":124411,"_5":14885,"_28401":124332,"_3088":124412},[],"Dispositivo retirado",{"_3638":74142,"_31204":74110,"_21623":124414,"_5":14885,"_28401":124332,"_3088":124415},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3638":74143,"_31204":74110,"_21623":124417,"_5":14885,"_28401":124332,"_3088":124418},[],"Timeout, HTTP 500 o fallo de instalación",{"_3638":74144,"_31204":74110,"_21623":124420,"_5":14885,"_28401":124332,"_3088":124421},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3638":74145,"_31204":74110,"_21623":124423,"_5":14885,"_28401":124336,"_3088":124424},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3638":74146,"_31204":74110,"_21623":124426,"_5":14885,"_28401":124336,"_3088":124427},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3638":74147,"_31204":74147,"_5":15245,"_3088":124429,"_31563":124430,"_21623":124431,"_28401":74147},"Diagnóstico de enrolamiento",[51051,122144,53751,123289,123467],[],{"_3638":74148,"_31204":74147,"_21623":124433,"_5":14885,"_28401":74147,"_3088":124434},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3638":74149,"_31204":74147,"_5":31560,"_21623":124436,"_28401":124437,"_3088":124438},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3638":74150,"_31204":74147,"_5":31560,"_21623":124440,"_28401":124441,"_3088":124442},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3638":74151,"_31204":74147,"_5":31560,"_21623":124444,"_28401":124445,"_3088":124008},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3638":74152,"_31204":74147,"_5":31560,"_21623":124447,"_28401":124448,"_3088":124449},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3638":74153,"_31204":74147,"_21623":124451,"_5":14885,"_28401":74147,"_3088":124452},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3638":74154,"_31204":74147,"_21623":124454,"_5":14885,"_28401":124441,"_3088":124455},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3638":74155,"_31204":74147,"_21623":124457,"_5":14885,"_28401":124441,"_3088":124458},[],"Síntoma o mensaje",{"_3638":74156,"_31204":74147,"_21623":124460,"_5":14885,"_28401":124441,"_3088":124461},[],"Qué revisar",{"_3638":74157,"_31204":74147,"_21623":124463,"_5":14885,"_28401":124441,"_3088":124464},[],"curl rechaza TLS, nombre o emisor",{"_3638":74158,"_31204":74147,"_21623":124466,"_5":14885,"_28401":124441,"_3088":124467},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3638":74159,"_31204":74147,"_21623":124469,"_5":14885,"_28401":124441,"_3088":124470},[],"404 o APS ausente",{"_3638":74160,"_31204":74147,"_21623":124472,"_5":14885,"_28401":124441,"_3088":124473},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3638":74161,"_31204":74147,"_21623":124475,"_5":14885,"_28401":124441,"_3088":124476},[],"400, error de CSR o formato",{"_3638":74162,"_31204":74147,"_21623":124478,"_5":14885,"_28401":124441,"_3088":124479},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3638":74163,"_31204":74147,"_21623":124481,"_5":14885,"_28401":124441,"_3088":124482},[],"Credencial ausente o certificado no válido",{"_3638":74164,"_31204":74147,"_21623":124484,"_5":14885,"_28401":124441,"_3088":124485},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3638":74165,"_31204":74147,"_21623":124487,"_5":14885,"_28401":124441,"_3088":124488},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3638":74166,"_31204":74147,"_21623":124490,"_5":14885,"_28401":124441,"_3088":124491},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3638":74167,"_31204":74147,"_21623":124493,"_5":14885,"_28401":124441,"_3088":124494},[],"Webhook deniega, expira o responde sin autorización",{"_3638":74168,"_31204":74147,"_21623":124496,"_5":14885,"_28401":124441,"_3088":124497},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3638":74169,"_31204":74147,"_21623":124499,"_5":14885,"_28401":124441,"_3088":55007},[],{"_3638":74170,"_31204":74147,"_21623":124501,"_5":14885,"_28401":124441,"_3088":124502},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3638":74171,"_31204":74147,"_21623":124504,"_5":14885,"_28401":124441,"_3088":55013},[],{"_3638":74172,"_31204":74147,"_21623":124506,"_5":14885,"_28401":124441,"_3088":124507},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3638":74173,"_31204":74147,"_21623":124509,"_5":14885,"_28401":124441,"_3088":55019},[],{"_3638":74174,"_31204":74147,"_21623":124511,"_5":14885,"_28401":124441,"_3088":124512},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3638":74175,"_31204":74147,"_21623":124514,"_5":14885,"_28401":124441,"_3088":55025},[],{"_3638":74176,"_31204":74147,"_21623":124516,"_5":14885,"_28401":124441,"_3088":124517},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3638":74177,"_31204":74147,"_21623":124519,"_5":14885,"_28401":124441,"_3088":55031},[],{"_3638":74178,"_31204":74147,"_21623":124521,"_5":14885,"_28401":124441,"_3088":124522},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3638":74179,"_31204":74147,"_21623":124524,"_5":14885,"_28401":124441,"_3088":124525},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3638":74180,"_31204":74147,"_21623":124527,"_5":14885,"_28401":124441,"_3088":124528},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3638":74181,"_31204":74147,"_21623":124530,"_5":14885,"_28401":124441,"_3088":124531},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3638":74182,"_31204":74147,"_21623":124533,"_5":14885,"_28401":124441,"_3088":124534},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3638":74183,"_31204":74147,"_21623":124536,"_5":14885,"_28401":124441,"_3088":55049},[],{"_3638":74184,"_31204":74147,"_21623":124538,"_5":14885,"_28401":124441,"_3088":124539},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3638":74185,"_31204":74147,"_21623":124541,"_5":14885,"_28401":124441,"_3088":55055},[],{"_3638":74186,"_31204":74147,"_21623":124543,"_5":14885,"_28401":124441,"_3088":124544},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3638":74187,"_31204":74147,"_21623":124546,"_5":14885,"_28401":124441,"_3088":124547},[],"DMS propietario distinto",{"_3638":74188,"_31204":74147,"_21623":124549,"_5":14885,"_28401":124441,"_3088":124550},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3638":74189,"_31204":74147,"_21623":124552,"_5":14885,"_28401":124441,"_3088":55067},[],{"_3638":74190,"_31204":74147,"_21623":124554,"_5":14885,"_28401":124441,"_3088":124555},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3638":74191,"_31204":74147,"_21623":124557,"_5":14885,"_28401":124441,"_3088":55073},[],{"_3638":74192,"_31204":74147,"_21623":124559,"_5":14885,"_28401":124441,"_3088":124560},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3638":74193,"_31204":74147,"_21623":124562,"_5":14885,"_28401":124441,"_3088":124563},[],"Certificado actual revocado",{"_3638":74194,"_31204":74147,"_21623":124565,"_5":14885,"_28401":124441,"_3088":124566},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3638":74195,"_31204":74147,"_21623":124568,"_5":14885,"_28401":124441,"_3088":124569},[],"Error de CA, perfil o firma",{"_3638":74196,"_31204":74147,"_21623":124571,"_5":14885,"_28401":124441,"_3088":124572},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3638":74197,"_31204":74147,"_21623":124574,"_5":14885,"_28401":124441,"_3088":124575},[],"HTTP 200 sin conexión del dispositivo",{"_3638":74198,"_31204":74147,"_21623":124577,"_5":14885,"_28401":124441,"_3088":124578},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3638":74199,"_31204":74147,"_21623":124580,"_5":14885,"_28401":124441,"_3088":124581},[],"Timeout o error después de emitir",{"_3638":74200,"_31204":74147,"_21623":124583,"_5":14885,"_28401":124441,"_3088":124584},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3638":74201,"_31204":74147,"_21623":124586,"_5":14885,"_28401":124445,"_3088":124587},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3638":74202,"_31204":74147,"_21623":124589,"_5":14885,"_28401":124445,"_3088":124590},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3638":74203,"_31204":74147,"_21623":124592,"_5":14885,"_28401":124448,"_3088":124593},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3638":74204,"_31204":74147,"_21623":124595,"_5":14885,"_28401":124448,"_3088":124596},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3638":74205,"_31204":74147,"_21623":124598,"_5":14885,"_28401":124448,"_3088":124599},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3638":74206,"_31204":74147,"_21623":124601,"_5":14885,"_28401":124448,"_3088":124602},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3638":74207,"_31204":74147,"_21623":124604,"_5":14885,"_28401":124448,"_3088":124605},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3638":74208,"_31204":74147,"_21623":124607,"_5":14885,"_28401":124448,"_3088":124608},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3638":74209,"_31204":74147,"_21623":124610,"_5":14885,"_28401":124448,"_3088":124611},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3638":74210,"_31204":74210,"_5":15245,"_3088":124613,"_31563":124614,"_21623":124615,"_28401":74210},"Distribución y actualización de confianza",[51051,122144,53751,123289,123467],[],{"_3638":74211,"_31204":74210,"_21623":124617,"_5":14885,"_28401":74210,"_3088":124618},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3638":74212,"_31204":74210,"_5":31560,"_21623":124620,"_28401":124621,"_3088":124622},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3638":74213,"_31204":74210,"_5":31560,"_21623":124624,"_28401":124625,"_3088":124626},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3638":74214,"_31204":74210,"_5":31560,"_21623":124628,"_28401":124629,"_3088":124630},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3638":74215,"_31204":74210,"_5":31560,"_21623":124632,"_28401":124633,"_3088":124634},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3638":74216,"_31204":74210,"_5":31560,"_21623":124636,"_28401":124637,"_3088":124638},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3638":74217,"_31204":74210,"_21623":124640,"_5":14885,"_28401":74210,"_3088":124641},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3638":74218,"_31204":74210,"_21623":124643,"_5":14885,"_28401":124621,"_3088":124644},[],"Relación",{"_3638":74219,"_31204":74210,"_21623":124646,"_5":14885,"_28401":124621,"_3088":124647},[],"Material que prepara el responsable",{"_3638":74220,"_31204":74210,"_21623":124649,"_5":14885,"_28401":124621,"_3088":124650},[],"Dispositivo → servidor EST",{"_3638":74221,"_31204":74210,"_21623":124652,"_5":14885,"_28401":124621,"_3088":124653},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3638":74222,"_31204":74210,"_21623":124655,"_5":14885,"_28401":124621,"_3088":124656},[],"DMS → solicitante",{"_3638":74223,"_31204":74210,"_21623":124658,"_5":14885,"_28401":124621,"_3088":124659},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3638":74224,"_31204":74210,"_21623":124661,"_5":14885,"_28401":124621,"_3088":124662},[],"Consumidor → dispositivo",{"_3638":74225,"_31204":74210,"_21623":124664,"_5":14885,"_28401":124621,"_3088":124665},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3638":74226,"_31204":74210,"_21623":124667,"_5":14885,"_28401":124621,"_3088":124668},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3638":74227,"_31204":74210,"_21623":124670,"_5":14885,"_28401":124625,"_3088":124671},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3638":74228,"_31204":74210,"_21623":124673,"_5":14885,"_28401":124625,"_3088":124674},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3638":74229,"_31204":74210,"_21623":124676,"_5":14885,"_28401":124629,"_3088":124677},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3638":74230,"_31204":74210,"_21623":124679,"_5":14885,"_28401":124629,"_3088":124680},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3638":74231,"_31204":74210,"_21623":124682,"_5":14885,"_28401":124629,"_3088":124683},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3638":74232,"_31204":74210,"_21623":124685,"_5":14885,"_28401":124629,"_3088":124686},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3638":74233,"_31204":74210,"_21623":124688,"_5":14885,"_28401":124629,"_3088":124689},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3638":74234,"_31204":74210,"_21623":124691,"_5":14885,"_28401":124629,"_3088":124692},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3638":74235,"_31204":74210,"_21623":124694,"_5":14885,"_28401":124633,"_3088":124695},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3638":74236,"_31204":74210,"_21623":124697,"_5":14885,"_28401":124633,"_3088":124698},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3638":74237,"_31204":74210,"_21623":124700,"_5":14885,"_28401":124633,"_3088":124701},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3638":74238,"_31204":74210,"_21623":124703,"_5":14885,"_28401":124637,"_3088":124704},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3638":74239,"_31204":74239,"_5":15245,"_3088":55222,"_31563":124706,"_21623":124708,"_28401":74239},[51051,122144,53751,123289,124707],"Integraciones",[],{"_3638":74240,"_31204":74239,"_21623":124710,"_5":14885,"_28401":74239,"_3088":124711},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3638":74241,"_31204":74239,"_5":31560,"_21623":124713,"_28401":124714,"_3088":124715},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3638":74242,"_31204":74239,"_5":31560,"_21623":124717,"_28401":124718,"_3088":124719},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3638":74243,"_31204":74239,"_5":31560,"_21623":124721,"_28401":124722,"_3088":124723},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3638":74244,"_31204":74239,"_5":31560,"_21623":124725,"_28401":124726,"_3088":124727},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3638":74245,"_31204":74239,"_5":31560,"_21623":124729,"_28401":124730,"_3088":124731},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3638":74246,"_31204":74239,"_5":31560,"_21623":124733,"_28401":124734,"_3088":124735},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3638":74247,"_31204":74239,"_5":31560,"_21623":124737,"_28401":124738,"_3088":124739},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3638":74248,"_31204":74239,"_5":31560,"_21623":124741,"_28401":124742,"_3088":124743},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3638":74249,"_31204":74239,"_5":31560,"_21623":124745,"_28401":124746,"_3088":55264},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3638":74250,"_31204":74239,"_5":31560,"_21623":124748,"_28401":124749,"_3088":55268},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3638":74251,"_31204":74239,"_5":31560,"_21623":124751,"_28401":124752,"_3088":124753},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3638":74252,"_31204":74239,"_5":31560,"_21623":124755,"_28401":124756,"_3088":124757},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3638":74253,"_31204":74239,"_5":31560,"_21623":124759,"_28401":124760,"_3088":124761},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3638":74254,"_31204":74239,"_5":31560,"_21623":124763,"_28401":124764,"_3088":124765},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3638":74255,"_31204":74239,"_5":31560,"_21623":124767,"_28401":124768,"_3088":124769},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3638":74256,"_31204":74239,"_5":31560,"_21623":124771,"_28401":124772,"_3088":124773},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3638":74257,"_31204":74239,"_5":31560,"_21623":124775,"_28401":124776,"_3088":124777},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3638":74258,"_31204":74239,"_5":31560,"_21623":124779,"_28401":124780,"_3088":124781},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3638":74259,"_31204":74239,"_5":31560,"_21623":124783,"_28401":124784,"_3088":124785},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3638":74260,"_31204":74239,"_5":31560,"_21623":124787,"_28401":124788,"_3088":124789},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3638":74261,"_31204":74239,"_5":31560,"_21623":124791,"_28401":124792,"_3088":124793},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3638":74262,"_31204":74239,"_5":31560,"_21623":124795,"_28401":124796,"_3088":124797},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3638":74263,"_31204":74239,"_5":31560,"_21623":124799,"_28401":124800,"_3088":124801},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3638":74264,"_31204":74239,"_5":31560,"_21623":124803,"_28401":124804,"_3088":124805},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3638":74265,"_31204":74239,"_5":31560,"_21623":124807,"_28401":124808,"_3088":124809},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3638":74266,"_31204":74239,"_21623":124811,"_5":14885,"_28401":74239,"_3088":124812},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3638":74267,"_31204":74239,"_21623":124814,"_5":14885,"_28401":74239,"_3088":124815},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3638":74268,"_31204":74239,"_21623":124817,"_5":14885,"_28401":74239,"_3088":124818},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3638":74269,"_31204":74239,"_21623":124820,"_5":14885,"_28401":124714,"_3088":124821},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3638":74270,"_31204":74239,"_21623":124823,"_5":14885,"_28401":124714,"_3088":124824},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3638":74271,"_31204":74239,"_21623":124826,"_5":14885,"_28401":124714,"_3088":124827},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3638":74272,"_31204":74239,"_21623":124829,"_5":14885,"_28401":124714,"_3088":124830},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3638":74273,"_31204":74239,"_21623":124832,"_5":14885,"_28401":124718,"_3088":124833},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3638":74274,"_31204":74239,"_21623":124835,"_5":14885,"_28401":124722,"_3088":124836},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3638":74275,"_31204":74239,"_21623":124838,"_5":14885,"_28401":124722,"_3088":124839},[],"Acción IAM",{"_3638":74276,"_31204":74239,"_21623":124841,"_5":14885,"_28401":124722,"_3088":121032},[],{"_3638":74277,"_31204":74239,"_21623":124843,"_5":14885,"_28401":124722,"_3088":55363},[],{"_3638":74278,"_31204":74239,"_21623":124845,"_5":14885,"_28401":124722,"_3088":124846},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3638":74279,"_31204":74239,"_21623":124848,"_5":14885,"_28401":124722,"_3088":55369},[],{"_3638":74280,"_31204":74239,"_21623":124850,"_5":14885,"_28401":124722,"_3088":124851},[],"Registrar la CA en AWS IoT",{"_3638":74281,"_31204":74239,"_21623":124853,"_5":14885,"_28401":124722,"_3088":55375},[],{"_3638":74282,"_31204":74239,"_21623":124855,"_5":14885,"_28401":124722,"_3088":124856},[],"Consultar el estado del registro de la CA",{"_3638":74283,"_31204":74239,"_21623":124858,"_5":14885,"_28401":124722,"_3088":55381},[],{"_3638":74284,"_31204":74239,"_21623":124860,"_5":14885,"_28401":124722,"_3088":124861},[],"Crear o actualizar Things en IoT Core",{"_3638":74285,"_31204":74239,"_21623":124863,"_5":14885,"_28401":124722,"_3088":55387},[],{"_3638":74286,"_31204":74239,"_21623":124865,"_5":14885,"_28401":124722,"_3088":124866},[],"Aprovisionar Things mediante plantilla",{"_3638":74287,"_31204":74239,"_21623":124868,"_5":14885,"_28401":124722,"_3088":55393},[],{"_3638":74288,"_31204":74239,"_21623":124870,"_5":14885,"_28401":124722,"_3088":124871},[],"Registrar certificados de dispositivo",{"_3638":74289,"_31204":74239,"_21623":124873,"_5":14885,"_28401":124722,"_3088":55399},[],{"_3638":74290,"_31204":74239,"_21623":124875,"_5":14885,"_28401":124722,"_3088":124876},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3638":74291,"_31204":74239,"_21623":124878,"_5":14885,"_28401":124722,"_3088":55405},[],{"_3638":74292,"_31204":74239,"_21623":124880,"_5":14885,"_28401":124722,"_3088":124881},[],"Crear y adjuntar políticas IoT",{"_3638":74293,"_31204":74239,"_21623":124883,"_5":14885,"_28401":124722,"_3088":55411},[],{"_3638":74294,"_31204":74239,"_21623":124885,"_5":14885,"_28401":124722,"_3088":124886},[],"Gestionar grupos de Things",{"_3638":74295,"_31204":74239,"_21623":124888,"_5":14885,"_28401":124722,"_3088":55417},[],{"_3638":74296,"_31204":74239,"_21623":124890,"_5":14885,"_28401":124722,"_3088":124891},[],"Crear plantillas JITP",{"_3638":74297,"_31204":74239,"_21623":124893,"_5":14885,"_28401":124722,"_3088":55423},[],{"_3638":74298,"_31204":74239,"_21623":124895,"_5":14885,"_28401":124722,"_3088":124896},[],"Leer y escribir el Device Shadow",{"_3638":74299,"_31204":74239,"_21623":124898,"_5":14885,"_28401":124722,"_3088":124899},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3638":74300,"_31204":74239,"_21623":124901,"_5":14885,"_28401":124726,"_3088":124902},[],"Parámetro",{"_3638":74301,"_31204":74239,"_21623":124904,"_5":14885,"_28401":124726,"_3088":124905},[],"Tipo",{"_3638":74302,"_31204":74239,"_21623":124907,"_5":14885,"_28401":124726,"_3088":124908},[],"Requerido",{"_3638":74303,"_31204":74239,"_21623":124910,"_5":14885,"_28401":124726,"_3088":124911},[],"Descripción",{"_3638":74304,"_31204":74239,"_21623":124913,"_5":14885,"_28401":124726,"_3088":55444},[],{"_3638":74305,"_31204":74239,"_21623":124915,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74306,"_31204":74239,"_21623":124917,"_5":14885,"_28401":124726,"_3088":124918},[],"Sí",{"_3638":74307,"_31204":74239,"_21623":124920,"_5":14885,"_28401":124726,"_3088":124921},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3638":74308,"_31204":74239,"_21623":124923,"_5":14885,"_28401":124726,"_3088":55455},[],{"_3638":74309,"_31204":74239,"_21623":124925,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74310,"_31204":74239,"_21623":124927,"_5":14885,"_28401":124726,"_3088":124918},[],{"_3638":74311,"_31204":74239,"_21623":124929,"_5":14885,"_28401":124726,"_3088":124930},[],"Región AWS donde opera el conector.",{"_3638":74312,"_31204":74239,"_21623":124932,"_5":14885,"_28401":124726,"_3088":55465},[],{"_3638":74313,"_31204":74239,"_21623":124934,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74314,"_31204":74239,"_21623":124936,"_5":14885,"_28401":124726,"_3088":124918},[],{"_3638":74315,"_31204":74239,"_21623":124938,"_5":14885,"_28401":124726,"_3088":124939},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3638":74316,"_31204":74239,"_21623":124941,"_5":14885,"_28401":124726,"_3088":55475},[],{"_3638":74317,"_31204":74239,"_21623":124943,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74318,"_31204":74239,"_21623":124945,"_5":14885,"_28401":124726,"_3088":124946},[],"Solo con `auth_method=static`",{"_3638":74319,"_31204":74239,"_21623":124948,"_5":14885,"_28401":124726,"_3088":124949},[],"Clave de acceso AWS.",{"_3638":74320,"_31204":74239,"_21623":124951,"_5":14885,"_28401":124726,"_3088":55486},[],{"_3638":74321,"_31204":74239,"_21623":124953,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74322,"_31204":74239,"_21623":124955,"_5":14885,"_28401":124726,"_3088":124946},[],{"_3638":74323,"_31204":74239,"_21623":124957,"_5":14885,"_28401":124726,"_3088":124958},[],"Clave secreta AWS.",{"_3638":74324,"_31204":74239,"_21623":124960,"_5":14885,"_28401":124726,"_3088":55496},[],{"_3638":74325,"_31204":74239,"_21623":124962,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74326,"_31204":74239,"_21623":124964,"_5":14885,"_28401":124726,"_3088":55501},[],{"_3638":74327,"_31204":74239,"_21623":124966,"_5":14885,"_28401":124726,"_3088":124967},[],"Token de sesión (con `auth_method=static`).",{"_3638":74328,"_31204":74239,"_21623":124969,"_5":14885,"_28401":124726,"_3088":55507},[],{"_3638":74329,"_31204":74239,"_21623":124971,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74330,"_31204":74239,"_21623":124973,"_5":14885,"_28401":124726,"_3088":124974},[],"Solo con `auth_method=role`",{"_3638":74331,"_31204":74239,"_21623":124976,"_5":14885,"_28401":124726,"_3088":124977},[],"ARN del rol a asumir.",{"_3638":74332,"_31204":74239,"_21623":124979,"_5":14885,"_28401":124726,"_3088":55518},[],{"_3638":74333,"_31204":74239,"_21623":124981,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74334,"_31204":74239,"_21623":124983,"_5":14885,"_28401":124726,"_3088":55501},[],{"_3638":74335,"_31204":74239,"_21623":124985,"_5":14885,"_28401":124726,"_3088":124986},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3638":74336,"_31204":74239,"_21623":124988,"_5":14885,"_28401":124726,"_3088":55528},[],{"_3638":74337,"_31204":74239,"_21623":124990,"_5":14885,"_28401":124726,"_3088":93140},[],{"_3638":74338,"_31204":74239,"_21623":124992,"_5":14885,"_28401":124726,"_3088":124918},[],{"_3638":74339,"_31204":74239,"_21623":124994,"_5":14885,"_28401":124726,"_3088":124995},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3638":74340,"_31204":74239,"_21623":124997,"_5":14885,"_28401":124726,"_3088":55538},[],{"_3638":74341,"_31204":74239,"_21623":124999,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74342,"_31204":74239,"_21623":125001,"_5":14885,"_28401":124726,"_3088":124918},[],{"_3638":74343,"_31204":74239,"_21623":125003,"_5":14885,"_28401":124726,"_3088":125004},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3638":74344,"_31204":74239,"_21623":125006,"_5":14885,"_28401":124726,"_3088":55548},[],{"_3638":74345,"_31204":74239,"_21623":125008,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74346,"_31204":74239,"_21623":125010,"_5":14885,"_28401":124726,"_3088":124918},[],{"_3638":74347,"_31204":74239,"_21623":125012,"_5":14885,"_28401":124726,"_3088":125013},[],"URL HTTP del Device Manager de Lamassu.",{"_3638":74348,"_31204":74239,"_21623":125015,"_5":14885,"_28401":124726,"_3088":55558},[],{"_3638":74349,"_31204":74239,"_21623":125017,"_5":14885,"_28401":124726,"_3088":25810},[],{"_3638":74350,"_31204":74239,"_21623":125019,"_5":14885,"_28401":124726,"_3088":124918},[],{"_3638":74351,"_31204":74239,"_21623":125021,"_5":14885,"_28401":124726,"_3088":125022},[],"URL HTTP del servicio de CA de Lamassu.",{"_3638":74352,"_31204":74239,"_21623":125024,"_5":14885,"_28401":124730,"_3088":125025},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3638":74353,"_31204":74239,"_21623":125027,"_5":14885,"_28401":124730,"_3088":125028},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3638":74354,"_31204":74239,"_21623":125030,"_5":14885,"_28401":124730,"_3088":125031},[],"Tipo de CloudEvent",{"_3638":74355,"_31204":74239,"_21623":125033,"_5":14885,"_28401":124730,"_3088":125034},[],"Recurso en Lamassu",{"_3638":74356,"_31204":74239,"_21623":125036,"_5":14885,"_28401":124730,"_3088":125037},[],"Recurso AWS",{"_3638":74357,"_31204":74239,"_21623":125039,"_5":14885,"_28401":124730,"_3088":125040},[],"Acciones IAM",{"_3638":74358,"_31204":74239,"_21623":125042,"_5":14885,"_28401":124730,"_3088":125043},[],"Llamadas AWS y efecto",{"_3638":74359,"_31204":74239,"_21623":125045,"_5":14885,"_28401":124730,"_3088":125046},[],"Dónde en esta página",{"_3638":74360,"_31204":74239,"_21623":125048,"_5":14885,"_28401":124730,"_3088":55592},[],{"_3638":74361,"_31204":74239,"_21623":125050,"_5":14885,"_28401":124730,"_3088":55595},[],{"_3638":74362,"_31204":74239,"_21623":125052,"_5":14885,"_28401":124730,"_3088":55598},[],{"_3638":74363,"_31204":74239,"_21623":125054,"_5":14885,"_28401":124730,"_3088":55601},[],{"_3638":74364,"_31204":74239,"_21623":125056,"_5":14885,"_28401":124730,"_3088":125057},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3638":74365,"_31204":74239,"_21623":125059,"_5":14885,"_28401":124730,"_3088":124743},[],{"_3638":74366,"_31204":74239,"_21623":125061,"_5":14885,"_28401":124730,"_3088":55609},[],{"_3638":74367,"_31204":74239,"_21623":125063,"_5":14885,"_28401":124730,"_3088":55612},[],{"_3638":74368,"_31204":74239,"_21623":125065,"_5":14885,"_28401":124730,"_3088":55615},[],{"_3638":74369,"_31204":74239,"_21623":125067,"_5":14885,"_28401":124730,"_3088":55618},[],{"_3638":74370,"_31204":74239,"_21623":125069,"_5":14885,"_28401":124730,"_3088":125070},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3638":74371,"_31204":74239,"_21623":125072,"_5":14885,"_28401":124730,"_3088":124769},[],{"_3638":74372,"_31204":74239,"_21623":125074,"_5":14885,"_28401":124730,"_3088":55626},[],{"_3638":74373,"_31204":74239,"_21623":125076,"_5":14885,"_28401":124730,"_3088":125077},[],"Dispositivo",{"_3638":74374,"_31204":74239,"_21623":125079,"_5":14885,"_28401":124730,"_3088":55632},[],{"_3638":74375,"_31204":74239,"_21623":125081,"_5":14885,"_28401":124730,"_3088":55635},[],{"_3638":74376,"_31204":74239,"_21623":125083,"_5":14885,"_28401":124730,"_3088":125084},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3638":74377,"_31204":74239,"_21623":125086,"_5":14885,"_28401":124730,"_3088":124777},[],{"_3638":74378,"_31204":74239,"_21623":125088,"_5":14885,"_28401":124730,"_3088":55643},[],{"_3638":74379,"_31204":74239,"_21623":125090,"_5":14885,"_28401":124730,"_3088":125091},[],"Certificado",{"_3638":74380,"_31204":74239,"_21623":125093,"_5":14885,"_28401":124730,"_3088":55649},[],{"_3638":74381,"_31204":74239,"_21623":125095,"_5":14885,"_28401":124730,"_3088":125096},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3638":74382,"_31204":74239,"_21623":125098,"_5":14885,"_28401":124730,"_3088":125099},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3638":74383,"_31204":74239,"_21623":125101,"_5":14885,"_28401":124730,"_3088":124789},[],{"_3638":74384,"_31204":74239,"_21623":125103,"_5":14885,"_28401":124730,"_3088":55660},[],{"_3638":74385,"_31204":74239,"_21623":125105,"_5":14885,"_28401":124730,"_3088":125106},[],"Certificado / Dispositivo",{"_3638":74386,"_31204":74239,"_21623":125108,"_5":14885,"_28401":124730,"_3088":55666},[],{"_3638":74387,"_31204":74239,"_21623":125110,"_5":14885,"_28401":124730,"_3088":51447},[],{"_3638":74388,"_31204":74239,"_21623":125112,"_5":14885,"_28401":124730,"_3088":125113},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3638":74389,"_31204":74239,"_21623":125115,"_5":14885,"_28401":124730,"_3088":124797},[],{"_3638":74390,"_31204":74239,"_21623":125117,"_5":14885,"_28401":124734,"_3088":125118},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3638":74391,"_31204":74239,"_21623":125120,"_5":14885,"_28401":124738,"_3088":125121},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3638":74392,"_31204":74239,"_21623":125123,"_5":14885,"_28401":124738,"_3088":125124},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3638":74393,"_31204":74239,"_21623":125126,"_5":14885,"_28401":124742,"_3088":125127},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3638":74394,"_31204":74239,"_21623":125129,"_5":14885,"_28401":124742,"_3088":125130},[],"Transición",{"_3638":74395,"_31204":74239,"_21623":125132,"_5":14885,"_28401":124742,"_3088":125133},[],"Llamadas AWS",{"_3638":74396,"_31204":74239,"_21623":125135,"_5":14885,"_28401":124742,"_3088":125136},[],"`NoRegistrada` → `Solicitada`",{"_3638":74397,"_31204":74239,"_21623":125138,"_5":14885,"_28401":124742,"_3088":125139},[],"ninguna (solo escritura de metadatos)",{"_3638":74398,"_31204":74239,"_21623":125141,"_5":14885,"_28401":124742,"_3088":125142},[],"`Solicitada` → `Registrando`",{"_3638":74399,"_31204":74239,"_21623":125144,"_5":14885,"_28401":124742,"_3088":125145},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3638":74400,"_31204":74239,"_21623":125147,"_5":14885,"_28401":124742,"_3088":125148},[],"`Registrando` → `Completada`",{"_3638":74401,"_31204":74239,"_21623":125150,"_5":14885,"_28401":124742,"_3088":125151},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3638":74402,"_31204":74239,"_21623":125153,"_5":14885,"_28401":124742,"_3088":125154},[],"`Registrando` → `Fallida`",{"_3638":74403,"_31204":74239,"_21623":125156,"_5":14885,"_28401":124742,"_3088":125157},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3638":74404,"_31204":74239,"_21623":125159,"_5":14885,"_28401":124742,"_3088":125160},[],"`Fallida` / `Completada` → `Solicitada`",{"_3638":74405,"_31204":74239,"_21623":125162,"_5":14885,"_28401":124742,"_3088":125163},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3638":74406,"_31204":74239,"_21623":125165,"_5":14885,"_28401":124746,"_3088":125166},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3638":74407,"_31204":74239,"_21623":125168,"_5":14885,"_28401":124746,"_3088":125169},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3638":74408,"_31204":74239,"_21623":125171,"_5":14885,"_28401":124746,"_3088":125172},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3638":74409,"_31204":74239,"_21623":125174,"_5":14885,"_28401":124746,"_3088":125175},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3638":74410,"_31204":74239,"_21623":125177,"_5":14885,"_28401":124746,"_3088":125178},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3638":74411,"_31204":74239,"_21623":125180,"_5":14885,"_28401":124746,"_3088":125181},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3638":74412,"_31204":74239,"_21623":125183,"_5":14885,"_28401":124749,"_3088":125184},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3638":74413,"_31204":74239,"_21623":125186,"_5":14885,"_28401":124752,"_3088":125187},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3638":74414,"_31204":74239,"_21623":125189,"_5":14885,"_28401":124752,"_3088":125190},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3638":74415,"_31204":74239,"_21623":125192,"_5":14885,"_28401":124756,"_3088":125193},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3638":74416,"_31204":74239,"_21623":125195,"_5":14885,"_28401":124760,"_3088":125196},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3638":74417,"_31204":74239,"_21623":125198,"_5":14885,"_28401":124760,"_3088":125199},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3638":74418,"_31204":74239,"_21623":125201,"_5":14885,"_28401":124760,"_3088":125202},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3638":74419,"_31204":74239,"_21623":125204,"_5":14885,"_28401":124760,"_3088":125205},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3638":74420,"_31204":74239,"_21623":125207,"_5":14885,"_28401":124760,"_3088":125208},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3638":74421,"_31204":74239,"_21623":125210,"_5":14885,"_28401":124760,"_3088":125211},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3638":74422,"_31204":74239,"_21623":125213,"_5":14885,"_28401":124764,"_3088":125214},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3638":74423,"_31204":74239,"_21623":125216,"_5":14885,"_28401":124764,"_3088":125217},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3638":74424,"_31204":74239,"_21623":125219,"_5":14885,"_28401":124764,"_3088":125220},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3638":74425,"_31204":74239,"_21623":125222,"_5":14885,"_28401":124764,"_3088":125223},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3638":74426,"_31204":74239,"_21623":125225,"_5":14885,"_28401":124764,"_3088":125226},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3638":74427,"_31204":74239,"_21623":125228,"_5":14885,"_28401":124768,"_3088":125229},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3638":74428,"_31204":74239,"_21623":125231,"_5":14885,"_28401":124768,"_3088":125130},[],{"_3638":74429,"_31204":74239,"_21623":125233,"_5":14885,"_28401":124768,"_3088":125133},[],{"_3638":74430,"_31204":74239,"_21623":125235,"_5":14885,"_28401":124768,"_3088":125236},[],"`SinConfigurar` → `None` / `Auto`",{"_3638":74431,"_31204":74239,"_21623":125238,"_5":14885,"_28401":124768,"_3088":125239},[],"ninguna (solo configuración)",{"_3638":74432,"_31204":74239,"_21623":125241,"_5":14885,"_28401":124768,"_3088":55803},[],{"_3638":74433,"_31204":74239,"_21623":125243,"_5":14885,"_28401":124768,"_3088":125239},[],{"_3638":74434,"_31204":74239,"_21623":125245,"_5":14885,"_28401":124768,"_3088":125246},[],"Cualquiera → `Jitp`",{"_3638":74435,"_31204":74239,"_21623":125248,"_5":14885,"_28401":124768,"_3088":125249},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3638":74436,"_31204":74239,"_21623":125251,"_5":14885,"_28401":124768,"_3088":55814},[],{"_3638":74437,"_31204":74239,"_21623":125253,"_5":14885,"_28401":124768,"_3088":125254},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3638":74438,"_31204":74239,"_21623":125256,"_5":14885,"_28401":124772,"_3088":125257},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3638":74439,"_31204":74239,"_21623":125259,"_5":14885,"_28401":124772,"_3088":125260},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3638":74440,"_31204":74239,"_21623":125262,"_5":14885,"_28401":124772,"_3088":125263},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3638":74441,"_31204":74239,"_21623":125265,"_5":14885,"_28401":124776,"_3088":125266},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3638":74442,"_31204":74239,"_21623":125268,"_5":14885,"_28401":124776,"_3088":125130},[],{"_3638":74443,"_31204":74239,"_21623":125270,"_5":14885,"_28401":124776,"_3088":125133},[],{"_3638":74444,"_31204":74239,"_21623":125272,"_5":14885,"_28401":124776,"_3088":125273},[],"`Ausente` → `Aprovisionado`",{"_3638":74445,"_31204":74239,"_21623":125275,"_5":14885,"_28401":124776,"_3088":125276},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3638":74446,"_31204":74239,"_21623":125278,"_5":14885,"_28401":124776,"_3088":125279},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3638":74447,"_31204":74239,"_21623":125281,"_5":14885,"_28401":124776,"_3088":125282},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3638":74448,"_31204":74239,"_21623":125284,"_5":14885,"_28401":124776,"_3088":125285},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3638":74449,"_31204":74239,"_21623":125287,"_5":14885,"_28401":124780,"_3088":125288},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3638":74450,"_31204":74239,"_21623":125290,"_5":14885,"_28401":124780,"_3088":125291},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3638":74451,"_31204":74239,"_21623":125293,"_5":14885,"_28401":124780,"_3088":125294},[],"Para que el flujo JITP funcione correctamente:",{"_3638":74452,"_31204":74239,"_21623":125296,"_5":14885,"_28401":124780,"_3088":125297},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3638":74453,"_31204":74239,"_21623":125299,"_5":14885,"_28401":124780,"_3088":125300},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3638":74454,"_31204":74239,"_21623":125302,"_5":14885,"_28401":124780,"_3088":125303},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3638":74455,"_31204":74239,"_21623":125305,"_5":14885,"_28401":124780,"_3088":125306},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3638":74456,"_31204":74239,"_21623":125308,"_5":14885,"_28401":124784,"_3088":125309},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3638":74457,"_31204":74239,"_21623":125311,"_5":14885,"_28401":124784,"_3088":125312},[],"Estado en Lamassu",{"_3638":74458,"_31204":74239,"_21623":125314,"_5":14885,"_28401":124784,"_3088":125315},[],"Razón de revocación",{"_3638":74459,"_31204":74239,"_21623":125317,"_5":14885,"_28401":124784,"_3088":125318},[],"Estado en AWS IoT Core",{"_3638":74460,"_31204":74239,"_21623":125320,"_5":14885,"_28401":124784,"_3088":55884},[],{"_3638":74461,"_31204":74239,"_21623":125322,"_5":14885,"_28401":124784,"_3088":125323},[],"Ninguna",{"_3638":74462,"_31204":74239,"_21623":125325,"_5":14885,"_28401":124784,"_3088":55890},[],{"_3638":74463,"_31204":74239,"_21623":125327,"_5":14885,"_28401":124784,"_3088":55893},[],{"_3638":74464,"_31204":74239,"_21623":125329,"_5":14885,"_28401":124784,"_3088":55896},[],{"_3638":74465,"_31204":74239,"_21623":125331,"_5":14885,"_28401":124784,"_3088":55899},[],{"_3638":74466,"_31204":74239,"_21623":125333,"_5":14885,"_28401":124784,"_3088":55893},[],{"_3638":74467,"_31204":74239,"_21623":125335,"_5":14885,"_28401":124784,"_3088":125336},[],"Cualquier otra razón",{"_3638":74468,"_31204":74239,"_21623":125338,"_5":14885,"_28401":124784,"_3088":55907},[],{"_3638":74469,"_31204":74239,"_21623":125340,"_5":14885,"_28401":124784,"_3088":125341},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3638":74470,"_31204":74239,"_21623":125343,"_5":14885,"_28401":124788,"_3088":125344},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3638":74471,"_31204":74239,"_21623":125346,"_5":14885,"_28401":124788,"_3088":125130},[],{"_3638":74472,"_31204":74239,"_21623":125348,"_5":14885,"_28401":124788,"_3088":125133},[],{"_3638":74473,"_31204":74239,"_21623":125350,"_5":14885,"_28401":124788,"_3088":125351},[],"`NoSincronizado` → `Active`",{"_3638":74474,"_31204":74239,"_21623":125353,"_5":14885,"_28401":124788,"_3088":55399},[],{"_3638":74475,"_31204":74239,"_21623":125355,"_5":14885,"_28401":124788,"_3088":55925},[],{"_3638":74476,"_31204":74239,"_21623":125357,"_5":14885,"_28401":124788,"_3088":125358},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3638":74477,"_31204":74239,"_21623":125360,"_5":14885,"_28401":124788,"_3088":55931},[],{"_3638":74478,"_31204":74239,"_21623":125362,"_5":14885,"_28401":124788,"_3088":125358},[],{"_3638":74479,"_31204":74239,"_21623":125364,"_5":14885,"_28401":124788,"_3088":55936},[],{"_3638":74480,"_31204":74239,"_21623":125366,"_5":14885,"_28401":124788,"_3088":55399},[],{"_3638":74481,"_31204":74239,"_21623":125368,"_5":14885,"_28401":124788,"_3088":55941},[],{"_3638":74482,"_31204":74239,"_21623":125370,"_5":14885,"_28401":124788,"_3088":125371},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3638":74483,"_31204":74239,"_21623":125373,"_5":14885,"_28401":124792,"_3088":125374},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3638":74484,"_31204":74239,"_21623":125376,"_5":14885,"_28401":124792,"_3088":125377},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3638":74485,"_31204":74239,"_21623":125379,"_5":14885,"_28401":124792,"_3088":125380},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3638":74486,"_31204":74239,"_21623":125382,"_5":14885,"_28401":124796,"_3088":125383},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3638":74487,"_31204":74239,"_21623":125385,"_5":14885,"_28401":124796,"_3088":125386},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3638":74488,"_31204":74239,"_21623":125388,"_5":14885,"_28401":124800,"_3088":125389},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3638":74489,"_31204":74239,"_21623":125391,"_5":14885,"_28401":124800,"_3088":125392},[],"Existen dos tipos de acciones:",{"_3638":74490,"_31204":74239,"_21623":125394,"_5":14885,"_28401":124800,"_3088":125395},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3638":74491,"_31204":74239,"_21623":125397,"_5":14885,"_28401":124800,"_3088":125398},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3638":74492,"_31204":74239,"_21623":125400,"_5":14885,"_28401":124800,"_3088":125401},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3638":74493,"_31204":74239,"_21623":125403,"_5":14885,"_28401":124804,"_3088":125404},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3638":74494,"_31204":74239,"_21623":125406,"_5":14885,"_28401":124804,"_3088":125407},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3638":74495,"_31204":74239,"_21623":125409,"_5":14885,"_28401":124804,"_3088":125410},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3638":74496,"_31204":74239,"_21623":125412,"_5":14885,"_28401":124808,"_3088":125413},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3638":74497,"_31204":74239,"_21623":125415,"_5":14885,"_28401":124808,"_3088":125416},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3638":74498,"_31204":74239,"_21623":125418,"_5":14885,"_28401":124808,"_3088":125419},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3638":74499,"_31204":74239,"_21623":125421,"_5":14885,"_28401":124808,"_3088":125422},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3638":74500,"_31204":74239,"_21623":125424,"_5":14885,"_28401":124808,"_3088":125425},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3638":74501,"_31204":74239,"_21623":125427,"_5":14885,"_28401":124808,"_3088":125428},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3638":74502,"_31204":74239,"_21623":125430,"_5":14885,"_28401":124808,"_3088":125431},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3638":74503,"_31204":74239,"_21623":125433,"_5":14885,"_28401":124808,"_3088":125434},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3638":74504,"_31204":74239,"_21623":125436,"_5":14885,"_28401":124808,"_3088":125437},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3638":74505,"_31204":74239,"_21623":125439,"_5":14885,"_28401":124808,"_3088":125440},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3638":74506,"_31204":74239,"_21623":125442,"_5":14885,"_28401":124808,"_3088":125443},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3638":74507,"_31204":74239,"_21623":125445,"_5":14885,"_28401":124808,"_3088":125446},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3638":74508,"_31204":74239,"_21623":125448,"_5":14885,"_28401":124808,"_3088":125449},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3638":74509,"_31204":74239,"_21623":125451,"_5":14885,"_28401":124808,"_3088":125452},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3638":74510,"_31204":74239,"_21623":125454,"_5":14885,"_28401":124808,"_3088":125455},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3638":74511,"_31204":74239,"_21623":125457,"_5":14885,"_28401":124808,"_3088":125458},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3638":74512,"_31204":74239,"_21623":125460,"_5":14885,"_28401":124808,"_3088":125461},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3638":74513,"_31204":74239,"_21623":125463,"_5":14885,"_28401":124808,"_3088":125464},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3638":74514,"_31204":74239,"_21623":125466,"_5":14885,"_28401":124808,"_3088":125467},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3638":74515,"_31204":74239,"_21623":125469,"_5":14885,"_28401":124808,"_3088":125470},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3638":74516,"_31204":74239,"_21623":125472,"_5":14885,"_28401":124808,"_3088":125473},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3638":74517,"_31204":74239,"_21623":125475,"_5":14885,"_28401":124808,"_3088":125476},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3638":74518,"_31204":74239,"_21623":125478,"_5":14885,"_28401":124808,"_3088":125479},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3638":74519,"_31204":74239,"_21623":125481,"_5":14885,"_28401":124808,"_3088":125482},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3638":74520,"_31204":74520,"_5":15245,"_3088":53751,"_31563":125484,"_21623":125485,"_28401":74520},[51051,122144,53751],[],{"_3638":74521,"_31204":74520,"_21623":125487,"_5":14885,"_28401":74520,"_3088":125488},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3638":74522,"_31204":74520,"_5":31560,"_21623":125490,"_28401":125491,"_3088":125492},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3638":74523,"_31204":74520,"_5":31560,"_21623":125494,"_28401":125495,"_3088":123289},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3638":74524,"_31204":74520,"_5":31560,"_21623":125497,"_28401":125498,"_3088":123467},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3638":74525,"_31204":74520,"_5":31560,"_21623":125500,"_28401":125501,"_3088":124707},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/overview#integraciones",{"_3638":74526,"_31204":74520,"_5":31560,"_21623":125503,"_28401":125504,"_3088":125505},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3638":74527,"_31204":74520,"_21623":125507,"_5":14885,"_28401":74520,"_3088":125508},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3638":74528,"_31204":74520,"_21623":125510,"_5":14885,"_28401":125491,"_3088":125511},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3638":74529,"_31204":74520,"_21623":125513,"_5":14885,"_28401":125491,"_3088":125514},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3638":74530,"_31204":74520,"_21623":125516,"_5":14885,"_28401":125495,"_3088":125517},[],"Recurso",{"_3638":74531,"_31204":74520,"_21623":125519,"_5":14885,"_28401":125495,"_3088":125520},[],"Qué representa",{"_3638":74532,"_31204":74520,"_21623":125522,"_5":14885,"_28401":125495,"_3088":125523},[],"**Dispositivo**",{"_3638":74533,"_31204":74520,"_21623":125525,"_5":14885,"_28401":125495,"_3088":125526},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3638":74534,"_31204":74520,"_21623":125528,"_5":14885,"_28401":125495,"_3088":125529},[],"**Identidad**",{"_3638":74535,"_31204":74520,"_21623":125531,"_5":14885,"_28401":125495,"_3088":125532},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3638":74536,"_31204":74520,"_21623":125534,"_5":14885,"_28401":125495,"_3088":56108},[],{"_3638":74537,"_31204":74520,"_21623":125536,"_5":14885,"_28401":125495,"_3088":125537},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3638":74538,"_31204":74520,"_21623":125539,"_5":14885,"_28401":125495,"_3088":125540},[],"**Flota**",{"_3638":74539,"_31204":74520,"_21623":125542,"_5":14885,"_28401":125495,"_3088":125543},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3638":74540,"_31204":74520,"_21623":125545,"_5":14885,"_28401":125495,"_3088":125546},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3638":74541,"_31204":74520,"_21623":125548,"_5":14885,"_28401":125495,"_3088":125549},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3638":74542,"_31204":74520,"_21623":125551,"_5":14885,"_28401":125498,"_3088":125552},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3638":74543,"_31204":74520,"_21623":125554,"_5":14885,"_28401":125498,"_3088":125555},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3638":74544,"_31204":74520,"_21623":125557,"_5":14885,"_28401":125498,"_3088":125558},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3638":74545,"_31204":74520,"_21623":125560,"_5":14885,"_28401":125498,"_3088":125561},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3638":74546,"_31204":74520,"_21623":125563,"_5":14885,"_28401":125498,"_3088":125564},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3638":74547,"_31204":74520,"_21623":125566,"_5":14885,"_28401":125498,"_3088":125567},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3638":74548,"_31204":74520,"_21623":125569,"_5":14885,"_28401":125498,"_3088":125570},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3638":74549,"_31204":74520,"_21623":125572,"_5":14885,"_28401":125498,"_3088":125573},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3638":74550,"_31204":74520,"_21623":125575,"_5":14885,"_28401":125501,"_3088":125576},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3638":74551,"_31204":74520,"_21623":125578,"_5":14885,"_28401":125501,"_3088":125579},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3638":74552,"_31204":74520,"_21623":125581,"_5":14885,"_28401":125504,"_3088":125582},[],"Participante",{"_3638":74553,"_31204":74520,"_21623":125584,"_5":14885,"_28401":125504,"_3088":125585},[],"Responsabilidad",{"_3638":74554,"_31204":74520,"_21623":125587,"_5":14885,"_28401":125504,"_3088":125588},[],"Administrador PKI",{"_3638":74555,"_31204":74520,"_21623":125590,"_5":14885,"_28401":125504,"_3088":125591},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3638":74556,"_31204":74520,"_21623":125593,"_5":14885,"_28401":125504,"_3088":125594},[],"Administrador del aprovisionamiento",{"_3638":74557,"_31204":74520,"_21623":125596,"_5":14885,"_28401":125504,"_3088":125597},[],"DMS, admisión, autenticación por operación e inventario.",{"_3638":74558,"_31204":74520,"_21623":125599,"_5":14885,"_28401":125504,"_3088":125600},[],"Integrador del dispositivo",{"_3638":74559,"_31204":74520,"_21623":125602,"_5":14885,"_28401":125504,"_3088":125603},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3638":74560,"_31204":74520,"_21623":125605,"_5":14885,"_28401":125504,"_3088":125606},[],"Integrador del consumidor",{"_3638":74561,"_31204":74520,"_21623":125608,"_5":14885,"_28401":125504,"_3088":125609},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3638":74562,"_31204":74520,"_21623":125611,"_5":14885,"_28401":125504,"_3088":125612},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3638":74563,"_31204":74563,"_5":15245,"_3088":125614,"_31563":125615,"_21623":125617,"_28401":74563},"Enrola y conecta tu primer dispositivo",[51051,122144,53751,125616],"Primeros pasos",[],{"_3638":74564,"_31204":74563,"_21623":125619,"_5":14885,"_28401":74563,"_3088":125620},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3638":74565,"_31204":74563,"_5":31560,"_21623":125622,"_28401":125623,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3638":74566,"_31204":74563,"_5":31560,"_21623":125625,"_28401":125626,"_3088":125627},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3638":74567,"_31204":74563,"_5":31560,"_21623":125629,"_28401":125630,"_3088":125631},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3638":74568,"_31204":74563,"_5":31560,"_21623":125633,"_28401":125634,"_3088":125635},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3638":74569,"_31204":74563,"_5":31560,"_21623":125637,"_28401":125638,"_3088":125639},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3638":74570,"_31204":74563,"_5":31560,"_21623":125641,"_28401":125642,"_3088":125643},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3638":74571,"_31204":74563,"_5":31560,"_21623":125645,"_28401":125646,"_3088":125647},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3638":74572,"_31204":74563,"_5":31560,"_21623":125649,"_28401":125650,"_3088":125651},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3638":74573,"_31204":74563,"_21623":125653,"_5":14885,"_28401":74563,"_3088":125654},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3638":74574,"_31204":74563,"_21623":125656,"_5":14885,"_28401":125623,"_3088":125657},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3638":74575,"_31204":74563,"_21623":125659,"_5":14885,"_28401":125623,"_3088":125660},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3638":74576,"_31204":74563,"_21623":125662,"_5":14885,"_28401":125623,"_3088":125663},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3638":74577,"_31204":74563,"_21623":125665,"_5":14885,"_28401":125623,"_3088":125666},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3638":74578,"_31204":74563,"_21623":125668,"_5":14885,"_28401":125623,"_3088":125669},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3638":74579,"_31204":74563,"_21623":125671,"_5":14885,"_28401":125626,"_3088":125672},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3638":74580,"_31204":74563,"_21623":125674,"_5":14885,"_28401":125626,"_3088":125675},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3638":74581,"_31204":74563,"_21623":125677,"_5":14885,"_28401":125630,"_3088":125678},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3638":74582,"_31204":74563,"_21623":125680,"_5":14885,"_28401":125630,"_3088":125681},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3638":74583,"_31204":74563,"_21623":125683,"_5":14885,"_28401":125630,"_3088":125684},[],"Ajuste",{"_3638":74584,"_31204":74563,"_21623":125686,"_5":14885,"_28401":125630,"_3088":125687},[],"Valor de evaluación",{"_3638":74585,"_31204":74563,"_21623":125689,"_5":14885,"_28401":125630,"_3088":56264},[],{"_3638":74586,"_31204":74563,"_21623":125691,"_5":14885,"_28401":125630,"_3088":125692},[],"Raíz emisora de `device-root.pem`.",{"_3638":74587,"_31204":74563,"_21623":125694,"_5":14885,"_28401":125630,"_3088":123601},[],{"_3638":74588,"_31204":74563,"_21623":125696,"_5":14885,"_28401":125630,"_3088":125697},[],"Perfil final de 1 hora que acabas de preparar.",{"_3638":74589,"_31204":74563,"_21623":125699,"_5":14885,"_28401":125630,"_3088":56275},[],{"_3638":74590,"_31204":74563,"_21623":125701,"_5":14885,"_28401":125630,"_3088":56278},[],{"_3638":74591,"_31204":74563,"_21623":125703,"_5":14885,"_28401":125630,"_3088":56281},[],{"_3638":74592,"_31204":74563,"_21623":125705,"_5":14885,"_28401":125630,"_3088":125706},[],"Habilitado.",{"_3638":74593,"_31204":74563,"_21623":125708,"_5":14885,"_28401":125630,"_3088":56287},[],{"_3638":74594,"_31204":74563,"_21623":125710,"_5":14885,"_28401":125630,"_3088":125711},[],"Deshabilitado; el ID debe ser nuevo.",{"_3638":74595,"_31204":74563,"_21623":125713,"_5":14885,"_28401":125630,"_3088":125714},[],"Autenticación inicial",{"_3638":74596,"_31204":74563,"_21623":125716,"_5":14885,"_28401":125630,"_3088":125717},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3638":74597,"_31204":74563,"_21623":125719,"_5":14885,"_28401":125630,"_3088":125720},[],"Autenticación de renovación",{"_3638":74598,"_31204":74563,"_21623":125722,"_5":14885,"_28401":125630,"_3088":125723},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3638":74599,"_31204":74563,"_21623":125725,"_5":14885,"_28401":125630,"_3088":56305},[],{"_3638":74600,"_31204":74563,"_21623":125727,"_5":14885,"_28401":125630,"_3088":125728},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3638":74601,"_31204":74563,"_21623":125730,"_5":14885,"_28401":125630,"_3088":56311},[],{"_3638":74602,"_31204":74563,"_21623":125732,"_5":14885,"_28401":125630,"_3088":125733},[],"1 hora.",{"_3638":74603,"_31204":74563,"_21623":125735,"_5":14885,"_28401":125630,"_3088":56317},[],{"_3638":74604,"_31204":74563,"_21623":125737,"_5":14885,"_28401":125630,"_3088":125738},[],"30 minutos / 10 minutos.",{"_3638":74605,"_31204":74563,"_21623":125740,"_5":14885,"_28401":125630,"_3088":56323},[],{"_3638":74606,"_31204":74563,"_21623":125742,"_5":14885,"_28401":125630,"_3088":125743},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3638":74607,"_31204":74563,"_21623":125745,"_5":14885,"_28401":125630,"_3088":54079},[],{"_3638":74608,"_31204":74563,"_21623":125747,"_5":14885,"_28401":125630,"_3088":125748},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3638":74609,"_31204":74563,"_21623":125750,"_5":14885,"_28401":125630,"_3088":56334},[],{"_3638":74610,"_31204":74563,"_21623":125752,"_5":14885,"_28401":125630,"_3088":125753},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3638":74611,"_31204":74563,"_21623":125755,"_5":14885,"_28401":125630,"_3088":125756},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3638":74612,"_31204":74563,"_21623":125758,"_5":14885,"_28401":125634,"_3088":125759},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3638":74613,"_31204":74563,"_21623":125761,"_5":14885,"_28401":125634,"_3088":125762},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3638":74614,"_31204":74563,"_21623":125764,"_5":14885,"_28401":125638,"_3088":125765},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3638":74615,"_31204":74563,"_21623":125767,"_5":14885,"_28401":125638,"_3088":125768},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3638":74616,"_31204":74563,"_21623":125770,"_5":14885,"_28401":125638,"_3088":125771},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3638":74617,"_31204":74563,"_21623":125773,"_5":14885,"_28401":125642,"_3088":125774},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3638":74618,"_31204":74563,"_21623":125776,"_5":14885,"_28401":125642,"_3088":125777},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3638":74619,"_31204":74563,"_21623":125779,"_5":14885,"_28401":125646,"_3088":125780},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3638":74620,"_31204":74563,"_21623":125782,"_5":14885,"_28401":125646,"_3088":125783},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3638":74621,"_31204":74563,"_21623":125785,"_5":14885,"_28401":125646,"_3088":125786},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3638":74622,"_31204":74563,"_21623":125788,"_5":14885,"_28401":125646,"_3088":125789},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3638":74623,"_31204":74563,"_21623":125791,"_5":14885,"_28401":125646,"_3088":125792},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3638":74624,"_31204":74563,"_21623":125794,"_5":14885,"_28401":125650,"_3088":125795},[],"Comprobación",{"_3638":74625,"_31204":74563,"_21623":125797,"_5":14885,"_28401":125650,"_3088":125798},[],"Resultado esperado",{"_3638":74626,"_31204":74563,"_21623":125800,"_5":14885,"_28401":125650,"_3088":125801},[],"Registro",{"_3638":74627,"_31204":74563,"_21623":125803,"_5":14885,"_28401":125650,"_3088":125804},[],"ID creado automáticamente y DMS correcto.",{"_3638":74628,"_31204":74563,"_21623":125806,"_5":14885,"_28401":125650,"_3088":125091},[],{"_3638":74629,"_31204":74563,"_21623":125808,"_5":14885,"_28401":125650,"_3088":125809},[],"CN, perfil, serie y clave verificados.",{"_3638":74630,"_31204":74563,"_21623":125811,"_5":14885,"_28401":125650,"_3088":125812},[],"Inventario",{"_3638":74631,"_31204":74563,"_21623":125814,"_5":14885,"_28401":125650,"_3088":125815},[],"Serie recibida visible como identidad actual y en el historial.",{"_3638":74632,"_31204":74563,"_21623":125817,"_5":14885,"_28401":125650,"_3088":125818},[],"Consumidor",{"_3638":74633,"_31204":74563,"_21623":125820,"_5":14885,"_28401":125650,"_3088":125821},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3638":74634,"_31204":74563,"_21623":125823,"_5":14885,"_28401":125650,"_3088":125824},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3638":74635,"_31204":74563,"_21623":125826,"_5":14885,"_28401":125650,"_3088":125827},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3638":74636,"_31204":74636,"_5":15245,"_3088":123306,"_31563":125829,"_21623":125830,"_28401":74636},[51051,122144,53751,125616],[],{"_3638":74637,"_31204":74636,"_21623":125832,"_5":14885,"_28401":74636,"_3088":125833},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3638":74638,"_31204":74636,"_5":31560,"_21623":125835,"_28401":125836,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3638":74639,"_31204":74636,"_5":31560,"_21623":125838,"_28401":125839,"_3088":125840},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3638":74640,"_31204":74636,"_5":31560,"_21623":125842,"_28401":125843,"_3088":125844},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3638":74641,"_31204":74636,"_5":31560,"_21623":125846,"_28401":125847,"_3088":125848},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3638":74642,"_31204":74636,"_5":31560,"_21623":125850,"_28401":125851,"_3088":125852},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3638":74643,"_31204":74636,"_5":31560,"_21623":125854,"_28401":125855,"_3088":125856},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3638":74644,"_31204":74636,"_5":31560,"_21623":125858,"_28401":125859,"_3088":125798},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3638":74645,"_31204":74636,"_5":31560,"_21623":125861,"_28401":125862,"_3088":125863},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3638":74646,"_31204":74636,"_5":31560,"_21623":125865,"_28401":125866,"_3088":125867},[],"/docs/pr-preview/pr-83/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3638":74647,"_31204":74636,"_21623":125869,"_5":14885,"_28401":74636,"_3088":125870},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3638":74648,"_31204":74636,"_21623":125872,"_5":14885,"_28401":74636,"_3088":125873},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3638":74649,"_31204":74636,"_21623":125875,"_5":14885,"_28401":125836,"_3088":125876},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3638":74650,"_31204":74636,"_21623":125878,"_5":14885,"_28401":125836,"_3088":125879},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3638":74651,"_31204":74636,"_21623":125881,"_5":14885,"_28401":125836,"_3088":125882},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3638":74652,"_31204":74636,"_21623":125884,"_5":14885,"_28401":125836,"_3088":125885},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3638":74653,"_31204":74636,"_21623":125887,"_5":14885,"_28401":125839,"_3088":125888},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3638":74654,"_31204":74636,"_21623":125890,"_5":14885,"_28401":125839,"_3088":125891},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3638":74655,"_31204":74636,"_21623":125893,"_5":14885,"_28401":125839,"_3088":125894},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3638":74656,"_31204":74636,"_21623":125896,"_5":14885,"_28401":125839,"_3088":125897},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3638":74657,"_31204":74636,"_21623":125899,"_5":14885,"_28401":125839,"_3088":125900},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3638":74658,"_31204":74636,"_21623":125902,"_5":14885,"_28401":125839,"_3088":125903},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3638":74659,"_31204":74636,"_21623":125905,"_5":14885,"_28401":125839,"_3088":125906},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3638":74660,"_31204":74636,"_21623":125908,"_5":14885,"_28401":125839,"_3088":125909},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3638":74661,"_31204":74636,"_21623":125911,"_5":14885,"_28401":125843,"_3088":125912},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3638":74662,"_31204":74636,"_21623":125914,"_5":14885,"_28401":125843,"_3088":56499},[],{"_3638":74663,"_31204":74636,"_21623":125916,"_5":14885,"_28401":125843,"_3088":125917},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3638":74664,"_31204":74636,"_21623":125919,"_5":14885,"_28401":125843,"_3088":125920},[],"**Icon** y **Tags**: clasificación opcional.",{"_3638":74665,"_31204":74636,"_21623":125922,"_5":14885,"_28401":125843,"_3088":125923},[],"Confirma el registro.",{"_3638":74666,"_31204":74636,"_21623":125925,"_5":14885,"_28401":125847,"_3088":125926},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3638":74667,"_31204":74636,"_21623":125928,"_5":14885,"_28401":125847,"_3088":125929},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3638":74668,"_31204":74636,"_21623":125931,"_5":14885,"_28401":125851,"_3088":125932},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3638":74669,"_31204":74636,"_21623":125934,"_5":14885,"_28401":125851,"_3088":125935},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3638":74670,"_31204":74636,"_21623":125937,"_5":14885,"_28401":125855,"_3088":125938},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3638":74671,"_31204":74636,"_21623":125940,"_5":14885,"_28401":125855,"_3088":125941},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3638":74672,"_31204":74636,"_21623":125943,"_5":14885,"_28401":125859,"_3088":125795},[],{"_3638":74673,"_31204":74636,"_21623":125945,"_5":14885,"_28401":125859,"_3088":125946},[],"Resultado",{"_3638":74674,"_31204":74636,"_21623":125948,"_5":14885,"_28401":125859,"_3088":125077},[],{"_3638":74675,"_31204":74636,"_21623":125950,"_5":14885,"_28401":125859,"_3088":125951},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3638":74676,"_31204":74636,"_21623":125953,"_5":14885,"_28401":125859,"_3088":125954},[],"Identidad actual",{"_3638":74677,"_31204":74636,"_21623":125956,"_5":14885,"_28401":125859,"_3088":125957},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3638":74678,"_31204":74636,"_21623":125959,"_5":14885,"_28401":125859,"_3088":125960},[],"Historial",{"_3638":74679,"_31204":74636,"_21623":125962,"_5":14885,"_28401":125859,"_3088":125963},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3638":74680,"_31204":74636,"_21623":125965,"_5":14885,"_28401":125859,"_3088":125966},[],"Clave y certificado",{"_3638":74681,"_31204":74636,"_21623":125968,"_5":14885,"_28401":125859,"_3088":125969},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3638":74682,"_31204":74636,"_21623":125971,"_5":14885,"_28401":125862,"_3088":125972},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3638":74683,"_31204":74636,"_21623":125974,"_5":14885,"_28401":125862,"_3088":125975},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3638":74684,"_31204":74636,"_21623":125977,"_5":14885,"_28401":125862,"_3088":125978},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3638":74685,"_31204":74636,"_21623":125980,"_5":14885,"_28401":125862,"_3088":125981},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3638":74686,"_31204":74636,"_21623":125983,"_5":14885,"_28401":125866,"_3088":125984},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3638":74687,"_31204":74636,"_21623":125986,"_5":14885,"_28401":125866,"_3088":125987},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3638":74688,"_31204":74636,"_21623":125989,"_5":14885,"_28401":125866,"_3088":125990},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3638":74689,"_31204":74689,"_5":15245,"_3088":125992,"_31563":125993,"_21623":125994,"_28401":74689},"Plataforma Lamassu IoT",[51051,122144],[],{"_3638":74690,"_31204":74689,"_21623":125996,"_5":14885,"_28401":74689,"_3088":125997},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3638":74691,"_31204":74689,"_5":31560,"_21623":125999,"_28401":126000,"_3088":125492},[],"/docs/pr-preview/pr-83/es/platform/overview#empieza-aquí",{"_3638":74692,"_31204":74689,"_5":31560,"_21623":126002,"_28401":126003,"_3088":126004},[],"/docs/pr-preview/pr-83/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3638":74693,"_31204":74689,"_5":31560,"_21623":126006,"_28401":126007,"_3088":126008},[],"/docs/pr-preview/pr-83/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3638":74694,"_31204":74689,"_5":31560,"_21623":126010,"_28401":126011,"_3088":126012},[],"/docs/pr-preview/pr-83/es/platform/overview#capacidades-principales","Capacidades principales",{"_3638":74695,"_31204":74689,"_5":31560,"_21623":126014,"_28401":126015,"_3088":126016},[],"/docs/pr-preview/pr-83/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3638":74696,"_31204":74689,"_5":31560,"_21623":126018,"_28401":126019,"_3088":126020},[],"/docs/pr-preview/pr-83/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3638":74697,"_31204":74689,"_5":31560,"_21623":126022,"_28401":126023,"_3088":126024},[],"/docs/pr-preview/pr-83/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3638":74698,"_31204":74689,"_5":31560,"_21623":126026,"_28401":126027,"_3088":126028},[],"/docs/pr-preview/pr-83/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3638":74699,"_31204":74689,"_5":31560,"_21623":126030,"_28401":126031,"_3088":126032},[],"/docs/pr-preview/pr-83/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3638":74700,"_31204":74689,"_5":31560,"_21623":126034,"_28401":126035,"_3088":126036},[],"/docs/pr-preview/pr-83/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3638":74701,"_31204":74689,"_5":31560,"_21623":126038,"_28401":126039,"_3088":126040},[],"/docs/pr-preview/pr-83/es/platform/overview#referencia-operativa","Referencia operativa",{"_3638":74702,"_31204":74689,"_21623":126042,"_5":14885,"_28401":74689,"_3088":126043},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3638":74703,"_31204":74689,"_21623":126045,"_5":14885,"_28401":126000,"_3088":126046},[],"Elige el resultado que necesitas obtener:",{"_3638":74704,"_31204":74689,"_21623":126048,"_5":14885,"_28401":126000,"_3088":126049},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3638":74705,"_31204":74689,"_21623":126051,"_5":14885,"_28401":126000,"_3088":126052},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3638":74706,"_31204":74689,"_21623":126054,"_5":14885,"_28401":126000,"_3088":126055},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3638":74707,"_31204":74689,"_21623":126057,"_5":14885,"_28401":126003,"_3088":126058},[],"Bloque",{"_3638":74708,"_31204":74689,"_21623":126060,"_5":14885,"_28401":126003,"_3088":126061},[],"Qué gestionas",{"_3638":74709,"_31204":74689,"_21623":126063,"_5":14885,"_28401":126003,"_3088":126064},[],"Punto de entrada",{"_3638":74710,"_31204":74689,"_21623":126066,"_5":14885,"_28401":126003,"_3088":56652},[],{"_3638":74711,"_31204":74689,"_21623":126068,"_5":14885,"_28401":126003,"_3088":126069},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3638":74712,"_31204":74689,"_21623":126071,"_5":14885,"_28401":126003,"_3088":126072},[],"Visión general de PKI",{"_3638":74713,"_31204":74689,"_21623":126074,"_5":14885,"_28401":126003,"_3088":56661},[],{"_3638":74714,"_31204":74689,"_21623":126076,"_5":14885,"_28401":126003,"_3088":126077},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3638":74715,"_31204":74689,"_21623":126079,"_5":14885,"_28401":126003,"_3088":126080},[],"Visión general de IoT Fleets",{"_3638":74716,"_31204":74689,"_21623":126082,"_5":14885,"_28401":126003,"_3088":126083},[],"**Administración**",{"_3638":74717,"_31204":74689,"_21623":126085,"_5":14885,"_28401":126003,"_3088":126086},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3638":74718,"_31204":74689,"_21623":126088,"_5":14885,"_28401":126003,"_3088":122146},[],{"_3638":74719,"_31204":74689,"_21623":126090,"_5":14885,"_28401":126003,"_3088":126091},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3638":74720,"_31204":74689,"_21623":126093,"_5":14885,"_28401":126007,"_3088":126094},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3638":74721,"_31204":74689,"_21623":126096,"_5":14885,"_28401":126007,"_3088":126097},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3638":74722,"_31204":74689,"_21623":126099,"_5":14885,"_28401":126007,"_3088":126100},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3638":74723,"_31204":74689,"_21623":126102,"_5":14885,"_28401":126007,"_3088":126103},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3638":74724,"_31204":74689,"_21623":126105,"_5":14885,"_28401":126007,"_3088":126106},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3638":74725,"_31204":74689,"_21623":126108,"_5":14885,"_28401":126007,"_3088":126109},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3638":74726,"_31204":74689,"_21623":126111,"_5":14885,"_28401":126015,"_3088":126112},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3638":74727,"_31204":74689,"_21623":126114,"_5":14885,"_28401":126019,"_3088":126115},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3638":74728,"_31204":74689,"_21623":126117,"_5":14885,"_28401":126023,"_3088":126118},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3638":74729,"_31204":74689,"_21623":126120,"_5":14885,"_28401":126027,"_3088":126121},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3638":74730,"_31204":74689,"_21623":126123,"_5":14885,"_28401":126031,"_3088":126124},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3638":74731,"_31204":74689,"_21623":126126,"_5":14885,"_28401":126035,"_3088":126127},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3638":74732,"_31204":74689,"_21623":126129,"_5":14885,"_28401":126039,"_3088":125585},[],{"_3638":74733,"_31204":74689,"_21623":126131,"_5":14885,"_28401":126039,"_3088":126132},[],"Qué prepara o comprueba",{"_3638":74734,"_31204":74689,"_21623":126134,"_5":14885,"_28401":126039,"_3088":125588},[],{"_3638":74735,"_31204":74689,"_21623":126136,"_5":14885,"_28401":126039,"_3088":126137},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3638":74736,"_31204":74689,"_21623":126139,"_5":14885,"_28401":126039,"_3088":126140},[],"Administrador de la flota",{"_3638":74737,"_31204":74689,"_21623":126142,"_5":14885,"_28401":126039,"_3088":126143},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3638":74738,"_31204":74689,"_21623":126145,"_5":14885,"_28401":126039,"_3088":125600},[],{"_3638":74739,"_31204":74689,"_21623":126147,"_5":14885,"_28401":126039,"_3088":126148},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3638":74740,"_31204":74689,"_21623":126150,"_5":14885,"_28401":126039,"_3088":125606},[],{"_3638":74741,"_31204":74689,"_21623":126152,"_5":14885,"_28401":126039,"_3088":126153},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3638":74742,"_31204":74689,"_21623":126155,"_5":14885,"_28401":126039,"_3088":126156},[],"Operador de infraestructura",{"_3638":74743,"_31204":74689,"_21623":126158,"_5":14885,"_28401":126039,"_3088":126159},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3638":74744,"_31204":74689,"_21623":126161,"_5":14885,"_28401":126039,"_3088":126162},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3638":74745,"_31204":74745,"_5":15245,"_3088":126164,"_31563":126165,"_21623":126167,"_28401":74745},"Jerarquía y rotación de CAs",[51051,122144,56753,126166],"Claves, autoridades y certificados",[],{"_3638":74746,"_31204":74745,"_21623":126169,"_5":14885,"_28401":74745,"_3088":126170},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3638":74747,"_31204":74745,"_5":31560,"_21623":126172,"_28401":126173,"_3088":126174},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3638":74748,"_31204":74745,"_5":31560,"_21623":126176,"_28401":126177,"_3088":126178},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3638":74749,"_31204":74745,"_5":31560,"_21623":126180,"_28401":126181,"_3088":126182},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3638":74750,"_31204":74745,"_5":31560,"_21623":126184,"_28401":126185,"_3088":126186},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3638":74751,"_31204":74745,"_5":31560,"_21623":126188,"_28401":126189,"_3088":126190},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3638":74752,"_31204":74745,"_5":31560,"_21623":126192,"_28401":126193,"_3088":126194},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3638":74753,"_31204":74745,"_5":31560,"_21623":126196,"_28401":126197,"_3088":126198},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3638":74754,"_31204":74745,"_5":31560,"_21623":126200,"_28401":126201,"_3088":126202},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3638":74755,"_31204":74745,"_5":31560,"_21623":126204,"_28401":126205,"_3088":126206},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3638":74756,"_31204":74745,"_5":31560,"_21623":126208,"_28401":126209,"_3088":126210},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3638":74757,"_31204":74745,"_5":31560,"_21623":126212,"_28401":126213,"_3088":126214},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3638":74758,"_31204":74745,"_5":31560,"_21623":126216,"_28401":126217,"_3088":126218},[],"/docs/pr-preview/pr-83/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3638":74759,"_31204":74745,"_21623":126220,"_5":14885,"_28401":74745,"_3088":126221},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3638":74760,"_31204":74745,"_21623":126223,"_5":14885,"_28401":74745,"_3088":126224},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3638":74761,"_31204":74745,"_21623":126226,"_5":14885,"_28401":126173,"_3088":126227},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3638":74762,"_31204":74745,"_21623":126229,"_5":14885,"_28401":126173,"_3088":126230},[],"entorno, como producción y preproducción;",{"_3638":74763,"_31204":74745,"_21623":126232,"_5":14885,"_28401":126173,"_3088":126233},[],"propietario o equipo operador;",{"_3638":74764,"_31204":74745,"_21623":126235,"_5":14885,"_28401":126173,"_3088":126236},[],"familia de dispositivos o proceso de fabricación;",{"_3638":74765,"_31204":74745,"_21623":126238,"_5":14885,"_28401":126173,"_3088":126239},[],"región o requisito regulatorio;",{"_3638":74766,"_31204":74745,"_21623":126241,"_5":14885,"_28401":126173,"_3088":126242},[],"motor criptográfico o política de clave;",{"_3638":74767,"_31204":74745,"_21623":126244,"_5":14885,"_28401":126173,"_3088":126245},[],"ventana de mantenimiento y ritmo de renovación.",{"_3638":74768,"_31204":74745,"_21623":126247,"_5":14885,"_28401":126173,"_3088":126248},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3638":74769,"_31204":74745,"_21623":126250,"_5":14885,"_28401":126173,"_3088":126251},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3638":74770,"_31204":74745,"_21623":126253,"_5":14885,"_28401":126177,"_3088":126254},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3638":74771,"_31204":74745,"_21623":126256,"_5":14885,"_28401":126177,"_3088":126257},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3638":74772,"_31204":74745,"_21623":126259,"_5":14885,"_28401":126177,"_3088":126260},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3638":74773,"_31204":74745,"_21623":126262,"_5":14885,"_28401":126177,"_3088":126263},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3638":74774,"_31204":74745,"_21623":126265,"_5":14885,"_28401":126181,"_3088":126266},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3638":74775,"_31204":74745,"_21623":126268,"_5":14885,"_28401":126181,"_3088":126269},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3638":74776,"_31204":74745,"_21623":126271,"_5":14885,"_28401":126181,"_3088":126272},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3638":74777,"_31204":74745,"_21623":126274,"_5":14885,"_28401":126181,"_3088":126275},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3638":74778,"_31204":74745,"_21623":126277,"_5":14885,"_28401":126189,"_3088":126278},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3638":74779,"_31204":74745,"_21623":126280,"_5":14885,"_28401":126193,"_3088":126281},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3638":74780,"_31204":74745,"_21623":126283,"_5":14885,"_28401":126197,"_3088":126284},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3638":74781,"_31204":74745,"_21623":126286,"_5":14885,"_28401":126201,"_3088":126287},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3638":74782,"_31204":74745,"_21623":126289,"_5":14885,"_28401":126205,"_3088":126290},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3638":74783,"_31204":74745,"_21623":126292,"_5":14885,"_28401":126209,"_3088":126293},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3638":74784,"_31204":74745,"_21623":126295,"_5":14885,"_28401":126213,"_3088":126296},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3638":74785,"_31204":74745,"_21623":126298,"_5":14885,"_28401":126213,"_3088":126299},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3638":74786,"_31204":74745,"_21623":126301,"_5":14885,"_28401":126213,"_3088":126302},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3638":74787,"_31204":74745,"_21623":126304,"_5":14885,"_28401":126213,"_3088":126305},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3638":74788,"_31204":74745,"_21623":126307,"_5":14885,"_28401":126217,"_3088":126308},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3638":74789,"_31204":74745,"_21623":126310,"_5":14885,"_28401":126217,"_3088":126311},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3638":74790,"_31204":74745,"_21623":126313,"_5":14885,"_28401":126217,"_3088":126314},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3638":74791,"_31204":74745,"_21623":126316,"_5":14885,"_28401":126217,"_3088":126317},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3638":74792,"_31204":74745,"_21623":126319,"_5":14885,"_28401":126217,"_3088":126320},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3638":74793,"_31204":74745,"_21623":126322,"_5":14885,"_28401":126217,"_3088":126323},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3638":74794,"_31204":74745,"_21623":126325,"_5":14885,"_28401":126217,"_3088":126326},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3638":74795,"_31204":74795,"_5":15245,"_3088":126328,"_31563":126329,"_21623":126330,"_28401":74795},"Autoridades de certificación",[51051,122144,56753,126166],[],{"_3638":74796,"_31204":74795,"_21623":126332,"_5":14885,"_28401":74795,"_3088":126333},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3638":74797,"_31204":74795,"_5":31560,"_21623":126335,"_28401":126336,"_3088":126337},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3638":74798,"_31204":74795,"_5":31560,"_21623":126339,"_28401":126340,"_3088":126341},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3638":74799,"_31204":74795,"_5":31560,"_21623":126343,"_28401":126344,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3638":74800,"_31204":74795,"_5":31560,"_21623":126346,"_28401":126347,"_3088":126348},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3638":74801,"_31204":74795,"_5":31560,"_21623":126350,"_28401":126351,"_3088":126352},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3638":74802,"_31204":74795,"_5":31560,"_21623":126354,"_28401":126355,"_3088":126356},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3638":74803,"_31204":74795,"_5":31560,"_21623":126358,"_28401":126359,"_3088":126360},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3638":74804,"_31204":74795,"_5":31560,"_21623":126362,"_28401":126363,"_3088":126364},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3638":74805,"_31204":74795,"_5":31560,"_21623":126366,"_28401":126367,"_3088":126368},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3638":74806,"_31204":74795,"_5":31560,"_21623":126370,"_28401":126371,"_3088":126372},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3638":74807,"_31204":74795,"_5":31560,"_21623":126374,"_28401":126375,"_3088":126376},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3638":74808,"_31204":74795,"_5":31560,"_21623":126378,"_28401":126379,"_3088":126380},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3638":74809,"_31204":74795,"_5":31560,"_21623":126382,"_28401":126383,"_3088":126384},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3638":74810,"_31204":74795,"_5":31560,"_21623":126386,"_28401":126387,"_3088":126388},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3638":74811,"_31204":74795,"_5":31560,"_21623":126390,"_28401":126391,"_3088":126392},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3638":74812,"_31204":74795,"_5":31560,"_21623":126394,"_28401":126395,"_3088":126396},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3638":74813,"_31204":74795,"_5":31560,"_21623":126398,"_28401":126399,"_3088":126400},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3638":74814,"_31204":74795,"_5":31560,"_21623":126402,"_28401":126403,"_3088":126404},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3638":74815,"_31204":74795,"_5":31560,"_21623":126406,"_28401":126407,"_3088":126408},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3638":74816,"_31204":74795,"_5":31560,"_21623":126410,"_28401":126411,"_3088":126412},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3638":74817,"_31204":74795,"_5":31560,"_21623":126414,"_28401":126415,"_3088":126416},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3638":74818,"_31204":74795,"_5":31560,"_21623":126418,"_28401":126419,"_3088":126420},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3638":74819,"_31204":74795,"_5":31560,"_21623":126422,"_28401":126423,"_3088":126424},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3638":74820,"_31204":74795,"_5":31560,"_21623":126426,"_28401":126427,"_3088":126428},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3638":74821,"_31204":74795,"_21623":126430,"_5":14885,"_28401":74795,"_3088":126431},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3638":74822,"_31204":74795,"_21623":126433,"_5":14885,"_28401":74795,"_3088":126434},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3638":74823,"_31204":74795,"_21623":126436,"_5":14885,"_28401":74795,"_3088":126437},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3638":74824,"_31204":74795,"_21623":126439,"_5":14885,"_28401":126336,"_3088":126440},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3638":74825,"_31204":74795,"_21623":126442,"_5":14885,"_28401":126336,"_3088":126443},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3638":74826,"_31204":74795,"_21623":126445,"_5":14885,"_28401":126336,"_3088":126446},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3638":74827,"_31204":74795,"_21623":126448,"_5":14885,"_28401":126336,"_3088":126449},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3638":74828,"_31204":74795,"_21623":126451,"_5":14885,"_28401":126336,"_3088":126452},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3638":74829,"_31204":74795,"_21623":126454,"_5":14885,"_28401":126344,"_3088":126455},[],"Decide si la CA será raíz o intermedia.",{"_3638":74830,"_31204":74795,"_21623":126457,"_5":14885,"_28401":126344,"_3088":126458},[],"Elige el motor que custodiará la clave.",{"_3638":74831,"_31204":74795,"_21623":126460,"_5":14885,"_28401":126344,"_3088":126461},[],"Define una validez superior a la de los certificados que emitirá.",{"_3638":74832,"_31204":74795,"_21623":126463,"_5":14885,"_28401":126344,"_3088":126464},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3638":74833,"_31204":74795,"_21623":126466,"_5":14885,"_28401":126347,"_3088":126467},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3638":74834,"_31204":74795,"_21623":126469,"_5":14885,"_28401":126351,"_3088":126470},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3638":74835,"_31204":74795,"_21623":126472,"_5":14885,"_28401":126351,"_3088":126473},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3638":74836,"_31204":74795,"_21623":126475,"_5":14885,"_28401":126355,"_3088":126476},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3638":74837,"_31204":74795,"_21623":126478,"_5":14885,"_28401":126359,"_3088":126479},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3638":74838,"_31204":74795,"_21623":126481,"_5":14885,"_28401":126359,"_3088":126482},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3638":74839,"_31204":74795,"_21623":126484,"_5":14885,"_28401":126359,"_3088":126485},[],"`ST`: estado o provincia.",{"_3638":74840,"_31204":74795,"_21623":126487,"_5":14885,"_28401":126359,"_3088":126488},[],"`L`: localidad.",{"_3638":74841,"_31204":74795,"_21623":126490,"_5":14885,"_28401":126359,"_3088":126491},[],"`O`: organización.",{"_3638":74842,"_31204":74795,"_21623":126493,"_5":14885,"_28401":126359,"_3088":126494},[],"`OU`: unidad organizativa.",{"_3638":74843,"_31204":74795,"_21623":126496,"_5":14885,"_28401":126359,"_3088":126497},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3638":74844,"_31204":74795,"_21623":126499,"_5":14885,"_28401":126363,"_3088":126500},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3638":74845,"_31204":74795,"_21623":126502,"_5":14885,"_28401":126363,"_3088":126503},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3638":74846,"_31204":74795,"_21623":126505,"_5":14885,"_28401":126367,"_3088":126506},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3638":74847,"_31204":74795,"_21623":126508,"_5":14885,"_28401":126367,"_3088":126509},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3638":74848,"_31204":74795,"_21623":126511,"_5":14885,"_28401":126371,"_3088":126512},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3638":74849,"_31204":74795,"_21623":126514,"_5":14885,"_28401":126371,"_3088":126515},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3638":74850,"_31204":74795,"_21623":126517,"_5":14885,"_28401":126375,"_3088":126518},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3638":74851,"_31204":74795,"_21623":126520,"_5":14885,"_28401":126375,"_3088":126521},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3638":74852,"_31204":74795,"_21623":126523,"_5":14885,"_28401":126375,"_3088":126524},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3638":74853,"_31204":74795,"_21623":126526,"_5":14885,"_28401":126375,"_3088":126527},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3638":74854,"_31204":74795,"_21623":126529,"_5":14885,"_28401":126379,"_3088":126530},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3638":74855,"_31204":74795,"_21623":126532,"_5":14885,"_28401":126383,"_3088":126533},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3638":74856,"_31204":74795,"_21623":126535,"_5":14885,"_28401":126383,"_3088":126536},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3638":74857,"_31204":74795,"_21623":126538,"_5":14885,"_28401":126387,"_3088":126539},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3638":74858,"_31204":74795,"_21623":126541,"_5":14885,"_28401":126391,"_3088":126542},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3638":74859,"_31204":74795,"_21623":126544,"_5":14885,"_28401":126391,"_3088":126545},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3638":74860,"_31204":74795,"_21623":126547,"_5":14885,"_28401":126391,"_3088":126548},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3638":74861,"_31204":74795,"_21623":126550,"_5":14885,"_28401":126395,"_3088":126551},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3638":74862,"_31204":74795,"_21623":126553,"_5":14885,"_28401":126395,"_3088":126554},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3638":74863,"_31204":74795,"_21623":126556,"_5":14885,"_28401":126395,"_3088":126557},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3638":74864,"_31204":74795,"_21623":126559,"_5":14885,"_28401":126395,"_3088":126560},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3638":74865,"_31204":74795,"_21623":126562,"_5":14885,"_28401":126399,"_3088":126563},[],"Abre una CA desde el inventario para consultar:",{"_3638":74866,"_31204":74795,"_21623":126565,"_5":14885,"_28401":126399,"_3088":126566},[],"Estado y periodo de validez.",{"_3638":74867,"_31204":74795,"_21623":126568,"_5":14885,"_28401":126399,"_3088":126569},[],"Certificado y cadena en formato PEM.",{"_3638":74868,"_31204":74795,"_21623":126571,"_5":14885,"_28401":126399,"_3088":126572},[],"Número de certificados activos, expirados y revocados.",{"_3638":74869,"_31204":74795,"_21623":126574,"_5":14885,"_28401":126399,"_3088":126575},[],"Certificados emitidos en **Issued Certificates**.",{"_3638":74870,"_31204":74795,"_21623":126577,"_5":14885,"_28401":126399,"_3088":126578},[],"CRL vinculada a la autoridad.",{"_3638":74871,"_31204":74795,"_21623":126580,"_5":14885,"_28401":126399,"_3088":126581},[],"Metadatos y motor criptográfico asociado.",{"_3638":74872,"_31204":74795,"_21623":126583,"_5":14885,"_28401":126399,"_3088":126584},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3638":74873,"_31204":74795,"_21623":126586,"_5":14885,"_28401":126403,"_3088":126587},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3638":74874,"_31204":74795,"_21623":126589,"_5":14885,"_28401":126403,"_3088":126590},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3638":74875,"_31204":74795,"_21623":126592,"_5":14885,"_28401":126403,"_3088":126593},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3638":74876,"_31204":74795,"_21623":126595,"_5":14885,"_28401":126403,"_3088":126596},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3638":74877,"_31204":74795,"_21623":126598,"_5":14885,"_28401":126403,"_3088":126599},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3638":74878,"_31204":74795,"_21623":126601,"_5":14885,"_28401":126403,"_3088":126602},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3638":74879,"_31204":74795,"_21623":126604,"_5":14885,"_28401":126407,"_3088":126605},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3638":74880,"_31204":74795,"_21623":126607,"_5":14885,"_28401":126411,"_3088":126608},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3638":74881,"_31204":74795,"_21623":126610,"_5":14885,"_28401":126415,"_3088":126611},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3638":74882,"_31204":74795,"_21623":126613,"_5":14885,"_28401":126419,"_3088":126614},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3638":74883,"_31204":74795,"_21623":126616,"_5":14885,"_28401":126423,"_3088":126617},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3638":74884,"_31204":74795,"_21623":126619,"_5":14885,"_28401":126427,"_3088":126620},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3638":74885,"_31204":74795,"_21623":126622,"_5":14885,"_28401":126427,"_3088":126623},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3638":74886,"_31204":74795,"_21623":126625,"_5":14885,"_28401":126427,"_3088":126626},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3638":74887,"_31204":74795,"_21623":126628,"_5":14885,"_28401":126427,"_3088":126629},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3638":74888,"_31204":74795,"_21623":126631,"_5":14885,"_28401":126427,"_3088":126632},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3638":74889,"_31204":74889,"_5":15245,"_3088":126634,"_31563":126635,"_21623":126636,"_28401":74889},"Perfiles de certificado",[51051,122144,56753,126166],[],{"_3638":74890,"_31204":74889,"_21623":126638,"_5":14885,"_28401":74889,"_3088":126639},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3638":74891,"_31204":74889,"_5":31560,"_21623":126641,"_28401":126642,"_3088":126643},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3638":74892,"_31204":74889,"_5":31560,"_21623":126645,"_28401":126646,"_3088":126647},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#validez","Validez",{"_3638":74893,"_31204":74889,"_5":31560,"_21623":126649,"_28401":126650,"_3088":126651},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3638":74894,"_31204":74889,"_5":31560,"_21623":126653,"_28401":126654,"_3088":126655},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3638":74895,"_31204":74889,"_5":31560,"_21623":126657,"_28401":126658,"_3088":126659},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3638":74896,"_31204":74889,"_5":31560,"_21623":126661,"_28401":126662,"_3088":126663},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3638":74897,"_31204":74889,"_5":31560,"_21623":126665,"_28401":126666,"_3088":126667},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3638":74898,"_31204":74889,"_5":31560,"_21623":126669,"_28401":126670,"_3088":126671},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3638":74899,"_31204":74889,"_5":31560,"_21623":126673,"_28401":126674,"_3088":126675},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3638":74900,"_31204":74889,"_5":31560,"_21623":126677,"_28401":126678,"_3088":126679},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3638":74901,"_31204":74889,"_5":31560,"_21623":126681,"_28401":126682,"_3088":126683},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3638":74902,"_31204":74889,"_5":31560,"_21623":126685,"_28401":126686,"_3088":126687},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3638":74903,"_31204":74889,"_5":31560,"_21623":126689,"_28401":126690,"_3088":126691},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3638":74904,"_31204":74889,"_5":31560,"_21623":126693,"_28401":126694,"_3088":126695},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3638":74905,"_31204":74889,"_5":31560,"_21623":126697,"_28401":126698,"_3088":126699},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3638":74906,"_31204":74889,"_5":31560,"_21623":126701,"_28401":126702,"_3088":126703},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3638":74907,"_31204":74889,"_21623":126705,"_5":14885,"_28401":74889,"_3088":126706},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3638":74908,"_31204":74889,"_21623":126708,"_5":14885,"_28401":74889,"_3088":126709},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3638":74909,"_31204":74889,"_21623":126711,"_5":14885,"_28401":126646,"_3088":126712},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3638":74910,"_31204":74889,"_21623":126714,"_5":14885,"_28401":126646,"_3088":126715},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3638":74911,"_31204":74889,"_21623":126717,"_5":14885,"_28401":126650,"_3088":126718},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3638":74912,"_31204":74889,"_21623":126720,"_5":14885,"_28401":126654,"_3088":126721},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3638":74913,"_31204":74889,"_21623":126723,"_5":14885,"_28401":126654,"_3088":126724},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3638":74914,"_31204":74889,"_21623":126726,"_5":14885,"_28401":126654,"_3088":126727},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3638":74915,"_31204":74889,"_21623":126729,"_5":14885,"_28401":126658,"_3088":126730},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3638":74916,"_31204":74889,"_21623":126732,"_5":14885,"_28401":126662,"_3088":126733},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3638":74917,"_31204":74889,"_21623":126735,"_5":14885,"_28401":126662,"_3088":126736},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3638":74918,"_31204":74889,"_21623":126738,"_5":14885,"_28401":126666,"_3088":126739},[],"La aplicación criptográfica puede:",{"_3638":74919,"_31204":74889,"_21623":126741,"_5":14885,"_28401":126666,"_3088":126742},[],"permitir o bloquear claves RSA;",{"_3638":74920,"_31204":74889,"_21623":126744,"_5":14885,"_28401":126666,"_3088":126745},[],"limitar los tamaños RSA admitidos;",{"_3638":74921,"_31204":74889,"_21623":126747,"_5":14885,"_28401":126666,"_3088":126748},[],"permitir o bloquear claves ECDSA;",{"_3638":74922,"_31204":74889,"_21623":126750,"_5":14885,"_28401":126666,"_3088":126751},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3638":74923,"_31204":74889,"_21623":126753,"_5":14885,"_28401":126666,"_3088":126754},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3638":74924,"_31204":74889,"_21623":126756,"_5":14885,"_28401":126670,"_3088":126757},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3638":74925,"_31204":74889,"_21623":126759,"_5":14885,"_28401":126670,"_3088":121904},[],{"_3638":74926,"_31204":74889,"_21623":126761,"_5":14885,"_28401":126670,"_3088":126762},[],"Primera opción",{"_3638":74927,"_31204":74889,"_21623":126764,"_5":14885,"_28401":126670,"_3088":126765},[],"Segunda opción",{"_3638":74928,"_31204":74889,"_21623":126767,"_5":14885,"_28401":126670,"_3088":126768},[],"Si no hay ninguna",{"_3638":74929,"_31204":74889,"_21623":126770,"_5":14885,"_28401":126670,"_3088":126771},[],"Firma directa con una CA",{"_3638":74930,"_31204":74889,"_21623":126773,"_5":14885,"_28401":126670,"_3088":126774},[],"`issuance_profile` incluido en la solicitud",{"_3638":74931,"_31204":74889,"_21623":126776,"_5":14885,"_28401":126670,"_3088":126777},[],"`issuance_profile_id` de la solicitud",{"_3638":74932,"_31204":74889,"_21623":126779,"_5":14885,"_28401":126670,"_3088":126780},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3638":74933,"_31204":74889,"_21623":126782,"_5":14885,"_28401":126670,"_3088":126783},[],"Emisión mediante DMS",{"_3638":74934,"_31204":74889,"_21623":126785,"_5":14885,"_28401":126670,"_3088":57374},[],{"_3638":74935,"_31204":74889,"_21623":126787,"_5":14885,"_28401":126670,"_3088":126788},[],"`settings.issuance_profile` incluido en el DMS",{"_3638":74936,"_31204":74889,"_21623":126790,"_5":14885,"_28401":126670,"_3088":126791},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3638":74937,"_31204":74889,"_21623":126793,"_5":14885,"_28401":126670,"_3088":126794},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3638":74938,"_31204":74889,"_21623":126796,"_5":14885,"_28401":126670,"_3088":126797},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3638":74939,"_31204":74889,"_21623":126799,"_5":14885,"_28401":126678,"_3088":126800},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3638":74940,"_31204":74889,"_21623":126802,"_5":14885,"_28401":126682,"_3088":126803},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3638":74941,"_31204":74889,"_21623":126805,"_5":14885,"_28401":126686,"_3088":126806},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3638":74942,"_31204":74889,"_21623":126808,"_5":14885,"_28401":126690,"_3088":126809},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3638":74943,"_31204":74889,"_21623":126811,"_5":14885,"_28401":126694,"_3088":126812},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3638":74944,"_31204":74889,"_21623":126814,"_5":14885,"_28401":126694,"_3088":126815},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3638":74945,"_31204":74889,"_21623":126817,"_5":14885,"_28401":126698,"_3088":126818},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3638":74946,"_31204":74889,"_21623":126820,"_5":14885,"_28401":126698,"_3088":126821},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3638":74947,"_31204":74889,"_21623":126823,"_5":14885,"_28401":126698,"_3088":126824},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3638":74948,"_31204":74889,"_21623":126826,"_5":14885,"_28401":126698,"_3088":126827},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3638":74949,"_31204":74889,"_21623":126829,"_5":14885,"_28401":126702,"_3088":126830},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3638":74950,"_31204":74889,"_21623":126832,"_5":14885,"_28401":126702,"_3088":126833},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3638":74951,"_31204":74951,"_5":15245,"_3088":126835,"_31563":126836,"_21623":126838,"_28401":74951},"Validación de certificados",[51051,122144,56753,126837],"Validación",[],{"_3638":74952,"_31204":74951,"_21623":126840,"_5":14885,"_28401":74951,"_3088":126841},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3638":74953,"_31204":74951,"_5":31560,"_21623":126843,"_28401":126844,"_3088":126845},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3638":74954,"_31204":74951,"_5":31560,"_21623":126847,"_28401":126848,"_3088":126849},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3638":74955,"_31204":74951,"_5":31560,"_21623":126851,"_28401":126852,"_3088":126853},[],"/docs/pr-preview/pr-83/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3638":74956,"_31204":74951,"_21623":126855,"_5":14885,"_28401":74951,"_3088":126856},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3638":74957,"_31204":74951,"_21623":126858,"_5":14885,"_28401":126844,"_3088":126859},[],"Verifica estos criterios juntos:",{"_3638":74958,"_31204":74951,"_21623":126861,"_5":14885,"_28401":126844,"_3088":125795},[],{"_3638":74959,"_31204":74951,"_21623":126863,"_5":14885,"_28401":126844,"_3088":126864},[],"Resultado necesario",{"_3638":74960,"_31204":74951,"_21623":126866,"_5":14885,"_28401":126844,"_3088":126867},[],"Cadena y firma",{"_3638":74961,"_31204":74951,"_21623":126869,"_5":14885,"_28401":126844,"_3088":126870},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3638":74962,"_31204":74951,"_21623":126872,"_5":14885,"_28401":126844,"_3088":126873},[],"Fechas",{"_3638":74963,"_31204":74951,"_21623":126875,"_5":14885,"_28401":126844,"_3088":126876},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3638":74964,"_31204":74951,"_21623":126878,"_5":14885,"_28401":126844,"_3088":121814},[],{"_3638":74965,"_31204":74951,"_21623":126880,"_5":14885,"_28401":126844,"_3088":126881},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3638":74966,"_31204":74951,"_21623":126883,"_5":14885,"_28401":126844,"_3088":126884},[],"Uso",{"_3638":74967,"_31204":74951,"_21623":126886,"_5":14885,"_28401":126844,"_3088":126887},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3638":74968,"_31204":74951,"_21623":126889,"_5":14885,"_28401":126844,"_3088":126890},[],"Revocación",{"_3638":74969,"_31204":74951,"_21623":126892,"_5":14885,"_28401":126844,"_3088":126893},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3638":74970,"_31204":74951,"_21623":126895,"_5":14885,"_28401":126844,"_3088":126896},[],"Autorización",{"_3638":74971,"_31204":74951,"_21623":126898,"_5":14885,"_28401":126844,"_3088":126899},[],"La aplicación permite la acción a esa identidad.",{"_3638":74972,"_31204":74951,"_21623":126901,"_5":14885,"_28401":126844,"_3088":126902},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3638":74973,"_31204":74951,"_21623":126904,"_5":14885,"_28401":126848,"_3088":126905},[],"Mecanismo",{"_3638":74974,"_31204":74951,"_21623":126907,"_5":14885,"_28401":126848,"_3088":126908},[],"Cuándo utilizarlo",{"_3638":74975,"_31204":74951,"_21623":126910,"_5":14885,"_28401":126848,"_3088":126911},[],"Qué debes mantener",{"_3638":74976,"_31204":74951,"_21623":126913,"_5":14885,"_28401":126848,"_3088":57502},[],{"_3638":74977,"_31204":74951,"_21623":126915,"_5":14885,"_28401":126848,"_3088":126916},[],"Consulta del estado de un certificado concreto.",{"_3638":74978,"_31204":74951,"_21623":126918,"_5":14885,"_28401":126848,"_3088":126919},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3638":74979,"_31204":74951,"_21623":126921,"_5":14885,"_28401":126848,"_3088":57511},[],{"_3638":74980,"_31204":74951,"_21623":126923,"_5":14885,"_28401":126848,"_3088":126924},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3638":74981,"_31204":74951,"_21623":126926,"_5":14885,"_28401":126848,"_3088":126927},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3638":74982,"_31204":74951,"_21623":126929,"_5":14885,"_28401":126848,"_3088":126930},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3638":74983,"_31204":74951,"_21623":126932,"_5":14885,"_28401":126848,"_3088":126933},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3638":74984,"_31204":74951,"_21623":126935,"_5":14885,"_28401":126852,"_3088":126936},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3638":74985,"_31204":74951,"_21623":126938,"_5":14885,"_28401":126852,"_3088":126939},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3638":74986,"_31204":74951,"_21623":126941,"_5":14885,"_28401":126852,"_3088":126942},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3638":74987,"_31204":74951,"_21623":126944,"_5":14885,"_28401":126852,"_3088":126945},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3638":74988,"_31204":74951,"_21623":126947,"_5":14885,"_28401":126852,"_3088":126948},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3638":74989,"_31204":74951,"_21623":126950,"_5":14885,"_28401":126852,"_3088":126951},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3638":74990,"_31204":74951,"_21623":126953,"_5":14885,"_28401":126852,"_3088":126954},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3638":74991,"_31204":74951,"_21623":126956,"_5":14885,"_28401":126852,"_3088":126957},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3638":74992,"_31204":74951,"_21623":126959,"_5":14885,"_28401":126852,"_3088":126960},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3638":74993,"_31204":74993,"_5":15245,"_3088":126962,"_31563":126963,"_21623":126964,"_28401":74993},"Certificados",[51051,122144,56753,126166],[],{"_3638":74994,"_31204":74993,"_21623":126966,"_5":14885,"_28401":74993,"_3088":126967},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3638":74995,"_31204":74993,"_5":31560,"_21623":126969,"_28401":126970,"_3088":126971},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3638":74996,"_31204":74993,"_5":31560,"_21623":126973,"_28401":126974,"_3088":126975},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3638":74997,"_31204":74993,"_5":31560,"_21623":126977,"_28401":126978,"_3088":126979},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3638":74998,"_31204":74993,"_5":31560,"_21623":126981,"_28401":126982,"_3088":126983},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3638":74999,"_31204":74993,"_5":31560,"_21623":126985,"_28401":126986,"_3088":126987},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3638":75000,"_31204":74993,"_5":31560,"_21623":126989,"_28401":126990,"_3088":126991},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3638":75001,"_31204":74993,"_5":31560,"_21623":126993,"_28401":126994,"_3088":126995},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3638":75002,"_31204":74993,"_5":31560,"_21623":126997,"_28401":126998,"_3088":126999},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3638":75003,"_31204":74993,"_5":31560,"_21623":127001,"_28401":127002,"_3088":127003},[],"/docs/pr-preview/pr-83/es/platform/pki/certificates#continúa","Continúa",{"_3638":75004,"_31204":74993,"_21623":127005,"_5":14885,"_28401":74993,"_3088":127006},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3638":75005,"_31204":74993,"_21623":127008,"_5":14885,"_28401":126970,"_3088":127009},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3638":75006,"_31204":74993,"_21623":127011,"_5":14885,"_28401":126970,"_3088":127012},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3638":75007,"_31204":74993,"_21623":127014,"_5":14885,"_28401":126970,"_3088":127015},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3638":75008,"_31204":74993,"_21623":127017,"_5":14885,"_28401":126970,"_3088":127018},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3638":75009,"_31204":74993,"_21623":127020,"_5":14885,"_28401":126970,"_3088":127021},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3638":75010,"_31204":74993,"_21623":127023,"_5":14885,"_28401":126970,"_3088":127024},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3638":75011,"_31204":74993,"_21623":127026,"_5":14885,"_28401":126970,"_3088":127027},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3638":75012,"_31204":74993,"_21623":127029,"_5":14885,"_28401":126974,"_3088":127030},[],"Descarga el PEM e inspecciónalo:",{"_3638":75013,"_31204":74993,"_21623":127032,"_5":14885,"_28401":126974,"_3088":127033},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3638":75014,"_31204":74993,"_21623":127035,"_5":14885,"_28401":126978,"_3088":127036},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3638":75015,"_31204":74993,"_21623":127038,"_5":14885,"_28401":126978,"_3088":127039},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3638":75016,"_31204":74993,"_21623":127041,"_5":14885,"_28401":126978,"_3088":127042},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3638":75017,"_31204":74993,"_21623":127044,"_5":14885,"_28401":126978,"_3088":127045},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3638":75018,"_31204":74993,"_21623":127047,"_5":14885,"_28401":126978,"_3088":127048},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3638":75019,"_31204":74993,"_21623":127050,"_5":14885,"_28401":126978,"_3088":127051},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3638":75020,"_31204":74993,"_21623":127053,"_5":14885,"_28401":126978,"_3088":127054},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3638":75021,"_31204":74993,"_21623":127056,"_5":14885,"_28401":126982,"_3088":127057},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3638":75022,"_31204":74993,"_21623":127059,"_5":14885,"_28401":126986,"_3088":127060},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3638":75023,"_31204":74993,"_21623":127062,"_5":14885,"_28401":126990,"_3088":127063},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3638":75024,"_31204":74993,"_21623":127065,"_5":14885,"_28401":126994,"_3088":127066},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3638":75025,"_31204":74993,"_21623":127068,"_5":14885,"_28401":126994,"_3088":127069},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3638":75026,"_31204":74993,"_21623":127071,"_5":14885,"_28401":126994,"_3088":127072},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3638":75027,"_31204":74993,"_21623":127074,"_5":14885,"_28401":126998,"_3088":127075},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3638":75028,"_31204":74993,"_21623":127077,"_5":14885,"_28401":126998,"_3088":127078},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3638":75029,"_31204":74993,"_21623":127080,"_5":14885,"_28401":126998,"_3088":127081},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3638":75030,"_31204":74993,"_21623":127083,"_5":14885,"_28401":127002,"_3088":127084},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3638":75031,"_31204":74993,"_21623":127086,"_5":14885,"_28401":127002,"_3088":127087},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3638":75032,"_31204":75032,"_5":15245,"_3088":127089,"_31563":127090,"_21623":127092,"_28401":75032},"Ciclo de vida de un certificado",[51051,122144,56753,127091],"Conceptos",[],{"_3638":75033,"_31204":75032,"_21623":127094,"_5":14885,"_28401":75032,"_3088":127095},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3638":75034,"_31204":75032,"_5":31560,"_21623":127097,"_28401":127098,"_3088":127099},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3638":75035,"_31204":75032,"_5":31560,"_21623":127101,"_28401":127102,"_3088":127103},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3638":75036,"_31204":75032,"_5":31560,"_21623":127105,"_28401":127106,"_3088":127107},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3638":75037,"_31204":75032,"_5":31560,"_21623":127109,"_28401":127110,"_3088":127111},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3638":75038,"_31204":75032,"_5":31560,"_21623":127113,"_28401":127114,"_3088":127115},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3638":75039,"_31204":75032,"_5":31560,"_21623":127117,"_28401":127118,"_3088":127119},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3638":75040,"_31204":75032,"_5":31560,"_21623":127121,"_28401":127122,"_3088":124789},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3638":75041,"_31204":75032,"_5":31560,"_21623":127124,"_28401":127125,"_3088":127126},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3638":75042,"_31204":75032,"_5":31560,"_21623":127128,"_28401":127129,"_3088":127130},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3638":75043,"_31204":75032,"_5":31560,"_21623":127132,"_28401":127133,"_3088":127134},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3638":75044,"_31204":75032,"_21623":127136,"_5":14885,"_28401":75032,"_3088":127137},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3638":75045,"_31204":75032,"_21623":127139,"_5":14885,"_28401":127102,"_3088":127140},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3638":75046,"_31204":75032,"_21623":127142,"_5":14885,"_28401":127106,"_3088":127143},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3638":75047,"_31204":75032,"_21623":127145,"_5":14885,"_28401":127110,"_3088":127146},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3638":75048,"_31204":75032,"_21623":127148,"_5":14885,"_28401":127114,"_3088":127149},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3638":75049,"_31204":75032,"_21623":127151,"_5":14885,"_28401":127118,"_3088":127152},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3638":75050,"_31204":75032,"_21623":127154,"_5":14885,"_28401":127122,"_3088":127155},[],"Lamassu persiste cuatro estados X.509:",{"_3638":75051,"_31204":75032,"_21623":127157,"_5":14885,"_28401":127122,"_3088":127158},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3638":75052,"_31204":75032,"_21623":127160,"_5":14885,"_28401":127122,"_3088":127161},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3638":75053,"_31204":75032,"_21623":127163,"_5":14885,"_28401":127122,"_3088":127164},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3638":75054,"_31204":75032,"_21623":127166,"_5":14885,"_28401":127122,"_3088":127167},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3638":75055,"_31204":75032,"_21623":127169,"_5":14885,"_28401":127122,"_3088":127170},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3638":75056,"_31204":75032,"_21623":127172,"_5":14885,"_28401":127125,"_3088":127173},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3638":75057,"_31204":75032,"_21623":127175,"_5":14885,"_28401":127125,"_3088":127176},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3638":75058,"_31204":75032,"_21623":127178,"_5":14885,"_28401":127125,"_3088":127179},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3638":75059,"_31204":75032,"_21623":127181,"_5":14885,"_28401":127129,"_3088":127182},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3638":75060,"_31204":75032,"_21623":127184,"_5":14885,"_28401":127129,"_3088":127185},[],"Antes de confirmar:",{"_3638":75061,"_31204":75032,"_21623":127187,"_5":14885,"_28401":127129,"_3088":127188},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3638":75062,"_31204":75032,"_21623":127190,"_5":14885,"_28401":127129,"_3088":127191},[],"Distribuye la nueva cadena de confianza.",{"_3638":75063,"_31204":75032,"_21623":127193,"_5":14885,"_28401":127129,"_3088":127194},[],"Reemite las identidades necesarias.",{"_3638":75064,"_31204":75032,"_21623":127196,"_5":14885,"_28401":127129,"_3088":127197},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3638":75065,"_31204":75032,"_21623":127199,"_5":14885,"_28401":127129,"_3088":127200},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3638":75066,"_31204":75032,"_21623":127202,"_5":14885,"_28401":127129,"_3088":127203},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3638":75067,"_31204":75032,"_21623":127205,"_5":14885,"_28401":127133,"_3088":127206},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3638":75068,"_31204":75032,"_21623":127208,"_5":14885,"_28401":127133,"_3088":127209},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3638":75069,"_31204":75032,"_21623":127211,"_5":14885,"_28401":127133,"_3088":127212},[],"Cambios de estado y razones de revocación.",{"_3638":75070,"_31204":75032,"_21623":127214,"_5":14885,"_28401":127133,"_3088":127215},[],"Publicación y vigencia de OCSP y CRLs.",{"_3638":75071,"_31204":75032,"_21623":127217,"_5":14885,"_28401":127133,"_3088":127218},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3638":75072,"_31204":75032,"_21623":127220,"_5":14885,"_28401":127133,"_3088":127221},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3638":75073,"_31204":75073,"_5":15245,"_3088":127223,"_31563":127224,"_21623":127225,"_28401":75073},"Modelo de confianza",[51051,122144,56753,127091],[],{"_3638":75074,"_31204":75073,"_21623":127227,"_5":14885,"_28401":75073,"_3088":127228},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3638":75075,"_31204":75073,"_5":31560,"_21623":127230,"_28401":127231,"_3088":127232},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3638":75076,"_31204":75073,"_5":31560,"_21623":127234,"_28401":127235,"_3088":127236},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3638":75077,"_31204":75073,"_5":31560,"_21623":127238,"_28401":127239,"_3088":127240},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3638":75078,"_31204":75073,"_5":31560,"_21623":127242,"_28401":127243,"_3088":127244},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3638":75079,"_31204":75073,"_5":31560,"_21623":127246,"_28401":127247,"_3088":127248},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3638":75080,"_31204":75073,"_5":31560,"_21623":127250,"_28401":127251,"_3088":127252},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3638":75081,"_31204":75073,"_5":31560,"_21623":127254,"_28401":127255,"_3088":127256},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3638":75082,"_31204":75073,"_5":31560,"_21623":127258,"_28401":127259,"_3088":127260},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3638":75083,"_31204":75073,"_5":31560,"_21623":127262,"_28401":127263,"_3088":127264},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3638":75084,"_31204":75073,"_5":31560,"_21623":127266,"_28401":127267,"_3088":127268},[],"/docs/pr-preview/pr-83/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3638":75085,"_31204":75073,"_21623":127270,"_5":14885,"_28401":75073,"_3088":127271},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3638":75086,"_31204":75073,"_21623":127273,"_5":14885,"_28401":127235,"_3088":127274},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3638":75087,"_31204":75073,"_21623":127276,"_5":14885,"_28401":127239,"_3088":127277},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3638":75088,"_31204":75073,"_21623":127279,"_5":14885,"_28401":127243,"_3088":127280},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3638":75089,"_31204":75073,"_21623":127282,"_5":14885,"_28401":127247,"_3088":127283},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3638":75090,"_31204":75073,"_21623":127285,"_5":14885,"_28401":127251,"_3088":127286},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3638":75091,"_31204":75073,"_21623":127288,"_5":14885,"_28401":127251,"_3088":127289},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3638":75092,"_31204":75073,"_21623":127291,"_5":14885,"_28401":127251,"_3088":127292},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3638":75093,"_31204":75073,"_21623":127294,"_5":14885,"_28401":127251,"_3088":127295},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3638":75094,"_31204":75073,"_21623":127297,"_5":14885,"_28401":127251,"_3088":127298},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3638":75095,"_31204":75073,"_21623":127300,"_5":14885,"_28401":127251,"_3088":127301},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3638":75096,"_31204":75073,"_21623":127303,"_5":14885,"_28401":127255,"_3088":127304},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3638":75097,"_31204":75073,"_21623":127306,"_5":14885,"_28401":127255,"_3088":127307},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3638":75098,"_31204":75073,"_21623":127309,"_5":14885,"_28401":127255,"_3088":127310},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3638":75099,"_31204":75073,"_21623":127312,"_5":14885,"_28401":127255,"_3088":127313},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3638":75100,"_31204":75073,"_21623":127315,"_5":14885,"_28401":127255,"_3088":127316},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3638":75101,"_31204":75073,"_21623":127318,"_5":14885,"_28401":127259,"_3088":127319},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3638":75102,"_31204":75073,"_21623":127321,"_5":14885,"_28401":127259,"_3088":127322},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3638":75103,"_31204":75073,"_21623":127324,"_5":14885,"_28401":127259,"_3088":127325},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3638":75104,"_31204":75073,"_21623":127327,"_5":14885,"_28401":127259,"_3088":127328},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3638":75105,"_31204":75073,"_21623":127330,"_5":14885,"_28401":127259,"_3088":127331},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3638":75106,"_31204":75073,"_21623":127333,"_5":14885,"_28401":127259,"_3088":127334},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3638":75107,"_31204":75073,"_21623":127336,"_5":14885,"_28401":127259,"_3088":127337},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3638":75108,"_31204":75073,"_21623":127339,"_5":14885,"_28401":127263,"_3088":127340},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3638":75109,"_31204":75073,"_21623":127342,"_5":14885,"_28401":127267,"_3088":127343},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3638":75110,"_31204":75073,"_21623":127345,"_5":14885,"_28401":127267,"_3088":127346},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3638":75111,"_31204":75073,"_21623":127348,"_5":14885,"_28401":127267,"_3088":127349},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3638":75112,"_31204":75073,"_21623":127351,"_5":14885,"_28401":127267,"_3088":127352},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3638":75113,"_31204":75073,"_21623":127354,"_5":14885,"_28401":127267,"_3088":127355},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3638":75114,"_31204":75073,"_21623":127357,"_5":14885,"_28401":127267,"_3088":127358},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3638":75115,"_31204":75073,"_21623":127360,"_5":14885,"_28401":127267,"_3088":127361},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3638":75116,"_31204":75116,"_5":15245,"_3088":127363,"_31563":127364,"_21623":127365,"_28401":75116},"Listas de revocación (CRL)",[51051,122144,56753,126837],[],{"_3638":75117,"_31204":75116,"_21623":127367,"_5":14885,"_28401":75116,"_3088":127368},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3638":75118,"_31204":75116,"_5":31560,"_21623":127370,"_28401":127371,"_3088":127372},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3638":75119,"_31204":75116,"_5":31560,"_21623":127374,"_28401":127375,"_3088":127376},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3638":75120,"_31204":75116,"_5":31560,"_21623":127378,"_28401":127379,"_3088":127380},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3638":75121,"_31204":75116,"_5":31560,"_21623":127382,"_28401":127383,"_3088":127384},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3638":75122,"_31204":75116,"_5":31560,"_21623":127386,"_28401":127387,"_3088":127388},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3638":75123,"_31204":75116,"_5":31560,"_21623":127390,"_28401":127391,"_3088":127392},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3638":75124,"_31204":75116,"_5":31560,"_21623":127394,"_28401":127395,"_3088":127396},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3638":75125,"_31204":75116,"_5":31560,"_21623":127398,"_28401":127399,"_3088":127400},[],"/docs/pr-preview/pr-83/es/platform/pki/crl#referencias","Referencias",{"_3638":75126,"_31204":75116,"_21623":127402,"_5":14885,"_28401":75116,"_3088":127403},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3638":75127,"_31204":75116,"_21623":127405,"_5":14885,"_28401":127371,"_3088":127406},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3638":75128,"_31204":75116,"_21623":127408,"_5":14885,"_28401":127371,"_3088":127409},[],"Campo",{"_3638":75129,"_31204":75116,"_21623":127411,"_5":14885,"_28401":127371,"_3088":123830},[],{"_3638":75130,"_31204":75116,"_21623":127413,"_5":14885,"_28401":127371,"_3088":52699},[],{"_3638":75131,"_31204":75116,"_21623":127415,"_5":14885,"_28401":127371,"_3088":127416},[],"ID de la CA a la que pertenecen los ajustes.",{"_3638":75132,"_31204":75116,"_21623":127418,"_5":14885,"_28401":127371,"_3088":58010},[],{"_3638":75133,"_31204":75116,"_21623":127420,"_5":14885,"_28401":127371,"_3088":127421},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3638":75134,"_31204":75116,"_21623":127423,"_5":14885,"_28401":127371,"_3088":58016},[],{"_3638":75135,"_31204":75116,"_21623":127425,"_5":14885,"_28401":127371,"_3088":127426},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3638":75136,"_31204":75116,"_21623":127428,"_5":14885,"_28401":127371,"_3088":58022},[],{"_3638":75137,"_31204":75116,"_21623":127430,"_5":14885,"_28401":127371,"_3088":127431},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3638":75138,"_31204":75116,"_21623":127433,"_5":14885,"_28401":127371,"_3088":127434},[],"Campo de `crl_options`",{"_3638":75139,"_31204":75116,"_21623":127436,"_5":14885,"_28401":127371,"_3088":123830},[],{"_3638":75140,"_31204":75116,"_21623":127438,"_5":14885,"_28401":127371,"_3088":127439},[],"Valor inicial",{"_3638":75141,"_31204":75116,"_21623":127441,"_5":14885,"_28401":127371,"_3088":58036},[],{"_3638":75142,"_31204":75116,"_21623":127443,"_5":14885,"_28401":127371,"_3088":127444},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3638":75143,"_31204":75116,"_21623":127446,"_5":14885,"_28401":127371,"_3088":127447},[],"7 días.",{"_3638":75144,"_31204":75116,"_21623":127449,"_5":14885,"_28401":127371,"_3088":58045},[],{"_3638":75145,"_31204":75116,"_21623":127451,"_5":14885,"_28401":127371,"_3088":127452},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3638":75146,"_31204":75116,"_21623":127454,"_5":14885,"_28401":127371,"_3088":127455},[],"6 días y 23 horas.",{"_3638":75147,"_31204":75116,"_21623":127457,"_5":14885,"_28401":127371,"_3088":58054},[],{"_3638":75148,"_31204":75116,"_21623":127459,"_5":14885,"_28401":127371,"_3088":127460},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3638":75149,"_31204":75116,"_21623":127462,"_5":14885,"_28401":127371,"_3088":58060},[],{"_3638":75150,"_31204":75116,"_21623":127464,"_5":14885,"_28401":127371,"_3088":58063},[],{"_3638":75151,"_31204":75116,"_21623":127466,"_5":14885,"_28401":127371,"_3088":127467},[],"Número de serie del certificado existente que firma la CRL.",{"_3638":75152,"_31204":75116,"_21623":127469,"_5":14885,"_28401":127371,"_3088":127470},[],"Número de serie del certificado actual de la CA.",{"_3638":75153,"_31204":75116,"_21623":127472,"_5":14885,"_28401":127371,"_3088":127473},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3638":75154,"_31204":75116,"_21623":127475,"_5":14885,"_28401":127371,"_3088":127476},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3638":75155,"_31204":75116,"_21623":127478,"_5":14885,"_28401":127371,"_3088":127479},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3638":75156,"_31204":75116,"_21623":127481,"_5":14885,"_28401":127371,"_3088":127482},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3638":75157,"_31204":75116,"_21623":127484,"_5":14885,"_28401":127371,"_3088":127485},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3638":75158,"_31204":75116,"_21623":127487,"_5":14885,"_28401":127371,"_3088":127488},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3638":75159,"_31204":75116,"_21623":127490,"_5":14885,"_28401":127371,"_3088":127491},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3638":75160,"_31204":75116,"_21623":127493,"_5":14885,"_28401":127371,"_3088":127494},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3638":75161,"_31204":75116,"_21623":127496,"_5":14885,"_28401":127371,"_3088":127497},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3638":75162,"_31204":75116,"_21623":127499,"_5":14885,"_28401":127371,"_3088":127500},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3638":75163,"_31204":75116,"_21623":127502,"_5":14885,"_28401":127371,"_3088":127503},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3638":75164,"_31204":75116,"_21623":127505,"_5":14885,"_28401":127375,"_3088":127506},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3638":75165,"_31204":75116,"_21623":127508,"_5":14885,"_28401":127375,"_3088":127509},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3638":75166,"_31204":75116,"_21623":127511,"_5":14885,"_28401":127375,"_3088":127512},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3638":75167,"_31204":75116,"_21623":127514,"_5":14885,"_28401":127375,"_3088":127515},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3638":75168,"_31204":75116,"_21623":127517,"_5":14885,"_28401":127379,"_3088":127518},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3638":75169,"_31204":75116,"_21623":127520,"_5":14885,"_28401":127379,"_3088":127521},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3638":75170,"_31204":75116,"_21623":127523,"_5":14885,"_28401":127379,"_3088":127524},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3638":75171,"_31204":75116,"_21623":127526,"_5":14885,"_28401":127379,"_3088":127527},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3638":75172,"_31204":75116,"_21623":127529,"_5":14885,"_28401":127379,"_3088":127530},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3638":75173,"_31204":75116,"_21623":127532,"_5":14885,"_28401":127379,"_3088":127533},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3638":75174,"_31204":75116,"_21623":127535,"_5":14885,"_28401":127379,"_3088":127536},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3638":75175,"_31204":75116,"_21623":127538,"_5":14885,"_28401":127379,"_3088":127539},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3638":75176,"_31204":75116,"_21623":127541,"_5":14885,"_28401":127379,"_3088":127542},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3638":75177,"_31204":75116,"_21623":127544,"_5":14885,"_28401":127383,"_3088":127545},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3638":75178,"_31204":75116,"_21623":127547,"_5":14885,"_28401":127383,"_3088":127548},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3638":75179,"_31204":75116,"_21623":127550,"_5":14885,"_28401":127387,"_3088":127551},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3638":75180,"_31204":75116,"_21623":127553,"_5":14885,"_28401":127387,"_3088":127554},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3638":75181,"_31204":75116,"_21623":127556,"_5":14885,"_28401":127387,"_3088":127557},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3638":75182,"_31204":75116,"_21623":127559,"_5":14885,"_28401":127387,"_3088":127560},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3638":75183,"_31204":75116,"_21623":127562,"_5":14885,"_28401":127387,"_3088":127563},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3638":75184,"_31204":75116,"_21623":127565,"_5":14885,"_28401":127391,"_3088":127566},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3638":75185,"_31204":75116,"_21623":127568,"_5":14885,"_28401":127391,"_3088":124019},[],{"_3638":75186,"_31204":75116,"_21623":127570,"_5":14885,"_28401":127391,"_3088":127571},[],"Path relativo",{"_3638":75187,"_31204":75116,"_21623":127573,"_5":14885,"_28401":127391,"_3088":121904},[],{"_3638":75188,"_31204":75116,"_21623":127575,"_5":14885,"_28401":127391,"_3088":58175},[],{"_3638":75189,"_31204":75116,"_21623":127577,"_5":14885,"_28401":127391,"_3088":58178},[],{"_3638":75190,"_31204":75116,"_21623":127579,"_5":14885,"_28401":127391,"_3088":127580},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3638":75191,"_31204":75116,"_21623":127582,"_5":14885,"_28401":127391,"_3088":58175},[],{"_3638":75192,"_31204":75116,"_21623":127584,"_5":14885,"_28401":127391,"_3088":58186},[],{"_3638":75193,"_31204":75116,"_21623":127586,"_5":14885,"_28401":127391,"_3088":127587},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3638":75194,"_31204":75116,"_21623":127589,"_5":14885,"_28401":127391,"_3088":58192},[],{"_3638":75195,"_31204":75116,"_21623":127591,"_5":14885,"_28401":127391,"_3088":58186},[],{"_3638":75196,"_31204":75116,"_21623":127593,"_5":14885,"_28401":127391,"_3088":127594},[],"Sustituir la configuración de CRL de una CA.",{"_3638":75197,"_31204":75116,"_21623":127596,"_5":14885,"_28401":127391,"_3088":58200},[],{"_3638":75198,"_31204":75116,"_21623":127598,"_5":14885,"_28401":127391,"_3088":58186},[],{"_3638":75199,"_31204":75116,"_21623":127600,"_5":14885,"_28401":127391,"_3088":127601},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3638":75200,"_31204":75116,"_21623":127603,"_5":14885,"_28401":127391,"_3088":127604},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3638":75201,"_31204":75116,"_21623":127606,"_5":14885,"_28401":127391,"_3088":127607},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3638":75202,"_31204":75116,"_21623":127609,"_5":14885,"_28401":127391,"_3088":127610},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3638":75203,"_31204":75116,"_21623":127612,"_5":14885,"_28401":127395,"_3088":127613},[],"Síntoma",{"_3638":75204,"_31204":75116,"_21623":127615,"_5":14885,"_28401":127395,"_3088":127616},[],"Causa",{"_3638":75205,"_31204":75116,"_21623":127618,"_5":14885,"_28401":127395,"_3088":127619},[],"Acción",{"_3638":75206,"_31204":75116,"_21623":127621,"_5":14885,"_28401":127395,"_3088":127622},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3638":75207,"_31204":75116,"_21623":127624,"_5":14885,"_28401":127395,"_3088":127625},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3638":75208,"_31204":75116,"_21623":127627,"_5":14885,"_28401":127395,"_3088":127628},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3638":75209,"_31204":75116,"_21623":127630,"_5":14885,"_28401":127395,"_3088":127631},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3638":75210,"_31204":75116,"_21623":127633,"_5":14885,"_28401":127395,"_3088":127634},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3638":75211,"_31204":75116,"_21623":127636,"_5":14885,"_28401":127395,"_3088":127637},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3638":75212,"_31204":75116,"_21623":127639,"_5":14885,"_28401":127395,"_3088":127640},[],"`PUT` devuelve 400.",{"_3638":75213,"_31204":75116,"_21623":127642,"_5":14885,"_28401":127395,"_3088":127643},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3638":75214,"_31204":75116,"_21623":127645,"_5":14885,"_28401":127395,"_3088":127646},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3638":75215,"_31204":75116,"_21623":127648,"_5":14885,"_28401":127395,"_3088":127649},[],"`PUT` devuelve 404.",{"_3638":75216,"_31204":75116,"_21623":127651,"_5":14885,"_28401":127395,"_3088":127652},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3638":75217,"_31204":75116,"_21623":127654,"_5":14885,"_28401":127395,"_3088":127655},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3638":75218,"_31204":75116,"_21623":127657,"_5":14885,"_28401":127395,"_3088":127658},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3638":75219,"_31204":75116,"_21623":127660,"_5":14885,"_28401":127395,"_3088":127661},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3638":75220,"_31204":75116,"_21623":127663,"_5":14885,"_28401":127395,"_3088":127664},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3638":75221,"_31204":75116,"_21623":127666,"_5":14885,"_28401":127395,"_3088":127667},[],"La CRL no cambia tras revocar un certificado.",{"_3638":75222,"_31204":75116,"_21623":127669,"_5":14885,"_28401":127395,"_3088":127670},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3638":75223,"_31204":75116,"_21623":127672,"_5":14885,"_28401":127395,"_3088":127673},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3638":75224,"_31204":75116,"_21623":127675,"_5":14885,"_28401":127395,"_3088":127676},[],"Un verificador rechaza la CRL por el emisor.",{"_3638":75225,"_31204":75116,"_21623":127678,"_5":14885,"_28401":127395,"_3088":127679},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3638":75226,"_31204":75116,"_21623":127681,"_5":14885,"_28401":127395,"_3088":127682},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3638":75227,"_31204":75116,"_21623":127684,"_5":14885,"_28401":127399,"_3088":127685},[],"RFC 5280: perfil X.509 y CRL.",{"_3638":75228,"_31204":75116,"_21623":127687,"_5":14885,"_28401":127399,"_3088":58292},[],{"_3638":75229,"_31204":75116,"_21623":127689,"_5":14885,"_28401":127399,"_3088":58295},[],{"_3638":75230,"_31204":75116,"_21623":127691,"_5":14885,"_28401":127399,"_3088":127692},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3638":75231,"_31204":75116,"_21623":127694,"_5":14885,"_28401":127399,"_3088":127695},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3638":75232,"_31204":75232,"_5":15245,"_3088":127697,"_31563":127698,"_21623":127699,"_28401":75232},"Claves y motores criptográficos",[51051,122144,56753,126166],[],{"_3638":75233,"_31204":75232,"_21623":127701,"_5":14885,"_28401":75232,"_3088":127702},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3638":75234,"_31204":75232,"_5":31560,"_21623":127704,"_28401":127705,"_3088":127706},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3638":75235,"_31204":75232,"_5":31560,"_21623":127708,"_28401":127709,"_3088":127710},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3638":75236,"_31204":75232,"_5":31560,"_21623":127712,"_28401":127713,"_3088":58320},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#file-system",{"_3638":75237,"_31204":75232,"_5":31560,"_21623":127715,"_28401":127716,"_3088":58324},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#hashicorp-vault",{"_3638":75238,"_31204":75232,"_5":31560,"_21623":127718,"_28401":127719,"_3088":58328},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#aws-secrets-manager",{"_3638":75239,"_31204":75232,"_5":31560,"_21623":127721,"_28401":127722,"_3088":58332},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#aws-kms",{"_3638":75240,"_31204":75232,"_5":31560,"_21623":127724,"_28401":127725,"_3088":58336},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#pkcs11",{"_3638":75241,"_31204":75232,"_5":31560,"_21623":127727,"_28401":127728,"_3088":58340},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#azure-key-vault",{"_3638":75242,"_31204":75232,"_5":31560,"_21623":127730,"_28401":127731,"_3088":127732},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3638":75243,"_31204":75232,"_5":31560,"_21623":127734,"_28401":127735,"_3088":127736},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3638":75244,"_31204":75232,"_5":31560,"_21623":127738,"_28401":127739,"_3088":127740},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3638":75245,"_31204":75232,"_5":31560,"_21623":127742,"_28401":127743,"_3088":127744},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3638":75246,"_31204":75232,"_5":31560,"_21623":127746,"_28401":127747,"_3088":127748},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3638":75247,"_31204":75232,"_5":31560,"_21623":127750,"_28401":127751,"_3088":127752},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3638":75248,"_31204":75232,"_5":31560,"_21623":127754,"_28401":127755,"_3088":127756},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3638":75249,"_31204":75232,"_5":31560,"_21623":127758,"_28401":127759,"_3088":58372},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#sign",{"_3638":75250,"_31204":75232,"_5":31560,"_21623":127761,"_28401":127762,"_3088":58376},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#verify",{"_3638":75251,"_31204":75232,"_5":31560,"_21623":127764,"_28401":127765,"_3088":127766},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3638":75252,"_31204":75232,"_5":31560,"_21623":127768,"_28401":127769,"_3088":127770},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3638":75253,"_31204":75232,"_5":31560,"_21623":127772,"_28401":127773,"_3088":127774},[],"/docs/pr-preview/pr-83/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3638":75254,"_31204":75232,"_21623":127776,"_5":14885,"_28401":75232,"_3088":127777},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3638":75255,"_31204":75232,"_21623":127779,"_5":14885,"_28401":75232,"_3088":127780},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3638":75256,"_31204":75232,"_21623":127782,"_5":14885,"_28401":127705,"_3088":127783},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3638":75257,"_31204":75232,"_21623":127785,"_5":14885,"_28401":127705,"_3088":127786},[],"En la práctica, permite:",{"_3638":75258,"_31204":75232,"_21623":127788,"_5":14885,"_28401":127705,"_3088":127789},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3638":75259,"_31204":75232,"_21623":127791,"_5":14885,"_28401":127705,"_3088":127792},[],"Importar claves creadas externamente.",{"_3638":75260,"_31204":75232,"_21623":127794,"_5":14885,"_28401":127705,"_3088":127795},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3638":75261,"_31204":75232,"_21623":127797,"_5":14885,"_28401":127705,"_3088":127798},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3638":75262,"_31204":75232,"_21623":127800,"_5":14885,"_28401":127709,"_3088":127801},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3638":75263,"_31204":75232,"_21623":127803,"_5":14885,"_28401":127709,"_3088":127804},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3638":75264,"_31204":75232,"_21623":127806,"_5":14885,"_28401":127709,"_3088":127807},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3638":75265,"_31204":75232,"_21623":127809,"_5":14885,"_28401":127713,"_3088":127810},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3638":75266,"_31204":75232,"_21623":127812,"_5":14885,"_28401":127716,"_3088":127813},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3638":75267,"_31204":75232,"_21623":127815,"_5":14885,"_28401":127716,"_3088":127816},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3638":75268,"_31204":75232,"_21623":127818,"_5":14885,"_28401":127719,"_3088":127819},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3638":75269,"_31204":75232,"_21623":127821,"_5":14885,"_28401":127722,"_3088":127822},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3638":75270,"_31204":75232,"_21623":127824,"_5":14885,"_28401":127725,"_3088":127825},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3638":75271,"_31204":75232,"_21623":127827,"_5":14885,"_28401":127728,"_3088":127828},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3638":75272,"_31204":75232,"_21623":127830,"_5":14885,"_28401":127728,"_3088":127831},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3638":75273,"_31204":75232,"_21623":127833,"_5":14885,"_28401":127728,"_3088":127834},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3638":75274,"_31204":75232,"_21623":127836,"_5":14885,"_28401":127728,"_3088":127837},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3638":75275,"_31204":75232,"_21623":127839,"_5":14885,"_28401":127731,"_3088":127840},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3638":75276,"_31204":75232,"_21623":127842,"_5":14885,"_28401":127731,"_3088":127843},[],"La tabla incluye los siguientes campos:",{"_3638":75277,"_31204":75232,"_21623":127845,"_5":14885,"_28401":127731,"_3088":127846},[],"**Name**: nombre descriptivo de la clave.",{"_3638":75278,"_31204":75232,"_21623":127848,"_5":14885,"_28401":127731,"_3088":127849},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3638":75279,"_31204":75232,"_21623":127851,"_5":14885,"_28401":127731,"_3088":127852},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3638":75280,"_31204":75232,"_21623":127854,"_5":14885,"_28401":127731,"_3088":127855},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3638":75281,"_31204":75232,"_21623":127857,"_5":14885,"_28401":127731,"_3088":127858},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3638":75282,"_31204":75232,"_21623":127860,"_5":14885,"_28401":127731,"_3088":127861},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3638":75283,"_31204":75232,"_21623":127863,"_5":14885,"_28401":127731,"_3088":127864},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3638":75284,"_31204":75232,"_21623":127866,"_5":14885,"_28401":127731,"_3088":127867},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3638":75285,"_31204":75232,"_21623":127869,"_5":14885,"_28401":127731,"_3088":127870},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3638":75286,"_31204":75232,"_21623":127872,"_5":14885,"_28401":127731,"_3088":127873},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3638":75287,"_31204":75232,"_21623":127875,"_5":14885,"_28401":127731,"_3088":127876},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3638":75288,"_31204":75232,"_21623":127878,"_5":14885,"_28401":127731,"_3088":127879},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3638":75289,"_31204":75232,"_21623":127881,"_5":14885,"_28401":127731,"_3088":127882},[],"**Delete Key** para eliminar la clave del sistema.",{"_3638":75290,"_31204":75232,"_21623":127884,"_5":14885,"_28401":127735,"_3088":127885},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3638":75291,"_31204":75232,"_21623":127887,"_5":14885,"_28401":127739,"_3088":127888},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3638":75292,"_31204":75232,"_21623":127890,"_5":14885,"_28401":127739,"_3088":127891},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3638":75293,"_31204":75232,"_21623":127893,"_5":14885,"_28401":127739,"_3088":127894},[],"**Key Name**: nombre único y descriptivo.",{"_3638":75294,"_31204":75232,"_21623":127896,"_5":14885,"_28401":127739,"_3088":127897},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3638":75295,"_31204":75232,"_21623":127899,"_5":14885,"_28401":127739,"_3088":127900},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3638":75296,"_31204":75232,"_21623":127902,"_5":14885,"_28401":127739,"_3088":127903},[],"**Tags**: metadatos para clasificar la clave.",{"_3638":75297,"_31204":75232,"_21623":127905,"_5":14885,"_28401":127739,"_3088":127906},[],"**Metadata**: información adicional para usos avanzados.",{"_3638":75298,"_31204":75232,"_21623":127908,"_5":14885,"_28401":127743,"_3088":127909},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3638":75299,"_31204":75232,"_21623":127911,"_5":14885,"_28401":127743,"_3088":127912},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3638":75300,"_31204":75232,"_21623":127914,"_5":14885,"_28401":127743,"_3088":127915},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3638":75301,"_31204":75232,"_21623":127917,"_5":14885,"_28401":127743,"_3088":127918},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3638":75302,"_31204":75232,"_21623":127920,"_5":14885,"_28401":127743,"_3088":127921},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3638":75303,"_31204":75232,"_21623":127923,"_5":14885,"_28401":127743,"_3088":127924},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3638":75304,"_31204":75232,"_21623":127926,"_5":14885,"_28401":127743,"_3088":127927},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3638":75305,"_31204":75232,"_21623":127929,"_5":14885,"_28401":127743,"_3088":127930},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3638":75306,"_31204":75232,"_21623":127932,"_5":14885,"_28401":127743,"_3088":127933},[],"**Metadata**: información adicional opcional.",{"_3638":75307,"_31204":75232,"_21623":127935,"_5":14885,"_28401":127743,"_3088":127936},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3638":75308,"_31204":75232,"_21623":127938,"_5":14885,"_28401":127743,"_3088":127939},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3638":75309,"_31204":75232,"_21623":127941,"_5":14885,"_28401":127747,"_3088":127942},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3638":75310,"_31204":75232,"_21623":127944,"_5":14885,"_28401":127751,"_3088":127945},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3638":75311,"_31204":75232,"_21623":127947,"_5":14885,"_28401":127751,"_3088":127948},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3638":75312,"_31204":75232,"_21623":127950,"_5":14885,"_28401":127751,"_3088":127951},[],"**Key Name**: nombre descriptivo.",{"_3638":75313,"_31204":75232,"_21623":127953,"_5":14885,"_28401":127751,"_3088":127954},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3638":75314,"_31204":75232,"_21623":127956,"_5":14885,"_28401":127751,"_3088":127957},[],"**Tags**: etiquetas asociadas.",{"_3638":75315,"_31204":75232,"_21623":127959,"_5":14885,"_28401":127751,"_3088":127960},[],"**Aliases**: nombres alternativos.",{"_3638":75316,"_31204":75232,"_21623":127962,"_5":14885,"_28401":127751,"_3088":127963},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3638":75317,"_31204":75232,"_21623":127965,"_5":14885,"_28401":127751,"_3088":127966},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3638":75318,"_31204":75232,"_21623":127968,"_5":14885,"_28401":127751,"_3088":127969},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3638":75319,"_31204":75232,"_21623":127971,"_5":14885,"_28401":127751,"_3088":127972},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3638":75320,"_31204":75232,"_21623":127974,"_5":14885,"_28401":127755,"_3088":127975},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3638":75321,"_31204":75232,"_21623":127977,"_5":14885,"_28401":127755,"_3088":127978},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3638":75322,"_31204":75232,"_21623":127980,"_5":14885,"_28401":127755,"_3088":127981},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3638":75323,"_31204":75232,"_21623":127983,"_5":14885,"_28401":127759,"_3088":127984},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3638":75324,"_31204":75232,"_21623":127986,"_5":14885,"_28401":127759,"_3088":127987},[],"Campos principales:",{"_3638":75325,"_31204":75232,"_21623":127989,"_5":14885,"_28401":127759,"_3088":127990},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3638":75326,"_31204":75232,"_21623":127992,"_5":14885,"_28401":127759,"_3088":127993},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3638":75327,"_31204":75232,"_21623":127995,"_5":14885,"_28401":127759,"_3088":127996},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3638":75328,"_31204":75232,"_21623":127998,"_5":14885,"_28401":127759,"_3088":127999},[],"**Message**: contenido que se va a firmar.",{"_3638":75329,"_31204":75232,"_21623":128001,"_5":14885,"_28401":127759,"_3088":128002},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3638":75330,"_31204":75232,"_21623":128004,"_5":14885,"_28401":127762,"_3088":128005},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3638":75331,"_31204":75232,"_21623":128007,"_5":14885,"_28401":127762,"_3088":127987},[],{"_3638":75332,"_31204":75232,"_21623":128009,"_5":14885,"_28401":127762,"_3088":128010},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3638":75333,"_31204":75232,"_21623":128012,"_5":14885,"_28401":127762,"_3088":128013},[],"**Message Type**: `Raw` o `Digest`.",{"_3638":75334,"_31204":75232,"_21623":128015,"_5":14885,"_28401":127762,"_3088":128016},[],"**Payload Encoding**: codificación del mensaje.",{"_3638":75335,"_31204":75232,"_21623":128018,"_5":14885,"_28401":127762,"_3088":128019},[],"**Message**: mensaje original o hash.",{"_3638":75336,"_31204":75232,"_21623":128021,"_5":14885,"_28401":127762,"_3088":128022},[],"**Signature**: firma que se desea comprobar.",{"_3638":75337,"_31204":75232,"_21623":128024,"_5":14885,"_28401":127762,"_3088":128025},[],"**Result**: indicador del resultado de la validación.",{"_3638":75338,"_31204":75232,"_21623":128027,"_5":14885,"_28401":127765,"_3088":128028},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3638":75339,"_31204":75232,"_21623":128030,"_5":14885,"_28401":127765,"_3088":128031},[],"Este flujo es útil para:",{"_3638":75340,"_31204":75232,"_21623":128033,"_5":14885,"_28401":127765,"_3088":128034},[],"Solicitar certificados a una CA externa.",{"_3638":75341,"_31204":75232,"_21623":128036,"_5":14885,"_28401":127765,"_3088":128037},[],"Renovar una identidad manteniendo la misma clave.",{"_3638":75342,"_31204":75232,"_21623":128039,"_5":14885,"_28401":127765,"_3088":128040},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3638":75343,"_31204":75232,"_21623":128042,"_5":14885,"_28401":127765,"_3088":128043},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3638":75344,"_31204":75232,"_21623":128045,"_5":14885,"_28401":127765,"_3088":128046},[],"**Organization (O)**: organización o empresa.",{"_3638":75345,"_31204":75232,"_21623":128048,"_5":14885,"_28401":127765,"_3088":128049},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3638":75346,"_31204":75232,"_21623":128051,"_5":14885,"_28401":127765,"_3088":128052},[],"**Country (C)**: código de país de dos letras.",{"_3638":75347,"_31204":75232,"_21623":128054,"_5":14885,"_28401":127765,"_3088":128055},[],"**State / Province (ST)**: estado o provincia.",{"_3638":75348,"_31204":75232,"_21623":128057,"_5":14885,"_28401":127765,"_3088":128058},[],"**Locality (L)**: ciudad o localidad.",{"_3638":75349,"_31204":75232,"_21623":128060,"_5":14885,"_28401":127765,"_3088":128061},[],"**Email Address**: correo de contacto.",{"_3638":75350,"_31204":75232,"_21623":128063,"_5":14885,"_28401":127765,"_3088":128064},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3638":75351,"_31204":75232,"_21623":128066,"_5":14885,"_28401":127765,"_3088":128067},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3638":75352,"_31204":75232,"_21623":128069,"_5":14885,"_28401":127769,"_3088":128070},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3638":75353,"_31204":75232,"_21623":128072,"_5":14885,"_28401":127769,"_3088":128073},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3638":75354,"_31204":75232,"_21623":128075,"_5":14885,"_28401":127773,"_3088":128076},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3638":75355,"_31204":75232,"_21623":128078,"_5":14885,"_28401":127773,"_3088":128079},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3638":75356,"_31204":75356,"_5":15245,"_3088":128081,"_31563":128082,"_21623":128083,"_28401":75356},"Validación online con OCSP",[51051,122144,56753,126837],[],{"_3638":75357,"_31204":75356,"_21623":128085,"_5":14885,"_28401":75356,"_3088":128086},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3638":75358,"_31204":75356,"_5":31560,"_21623":128088,"_28401":128089,"_3088":128090},[],"/docs/pr-preview/pr-83/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3638":75359,"_31204":75356,"_5":31560,"_21623":128092,"_28401":128093,"_3088":128094},[],"/docs/pr-preview/pr-83/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3638":75360,"_31204":75356,"_5":31560,"_21623":128096,"_28401":128097,"_3088":128098},[],"/docs/pr-preview/pr-83/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3638":75361,"_31204":75356,"_5":31560,"_21623":128100,"_28401":128101,"_3088":128102},[],"/docs/pr-preview/pr-83/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3638":75362,"_31204":75356,"_5":31560,"_21623":128104,"_28401":128105,"_3088":128106},[],"/docs/pr-preview/pr-83/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3638":75363,"_31204":75356,"_5":31560,"_21623":128108,"_28401":128109,"_3088":127400},[],"/docs/pr-preview/pr-83/es/platform/pki/ocsp#referencias",{"_3638":75364,"_31204":75356,"_21623":128111,"_5":14885,"_28401":75356,"_3088":128112},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3638":75365,"_31204":75356,"_21623":128114,"_5":14885,"_28401":128089,"_3088":128115},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3638":75366,"_31204":75356,"_21623":128117,"_5":14885,"_28401":128089,"_3088":128118},[],"Estado del registro",{"_3638":75367,"_31204":75356,"_21623":128120,"_5":14885,"_28401":128089,"_3088":128121},[],"Respuesta firmada",{"_3638":75368,"_31204":75356,"_21623":128123,"_5":14885,"_28401":128089,"_3088":55890},[],{"_3638":75369,"_31204":75356,"_21623":128125,"_5":14885,"_28401":128089,"_3088":58740},[],{"_3638":75370,"_31204":75356,"_21623":128127,"_5":14885,"_28401":128089,"_3088":55907},[],{"_3638":75371,"_31204":75356,"_21623":128129,"_5":14885,"_28401":128089,"_3088":128130},[],"`Revoked`, con razón y fecha de revocación.",{"_3638":75372,"_31204":75356,"_21623":128132,"_5":14885,"_28401":128089,"_3088":128133},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3638":75373,"_31204":75356,"_21623":128135,"_5":14885,"_28401":128089,"_3088":128136},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3638":75374,"_31204":75356,"_21623":128138,"_5":14885,"_28401":128089,"_3088":128139},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3638":75375,"_31204":75356,"_21623":128141,"_5":14885,"_28401":128089,"_3088":128142},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3638":75376,"_31204":75356,"_21623":128144,"_5":14885,"_28401":128089,"_3088":128145},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3638":75377,"_31204":75356,"_21623":128147,"_5":14885,"_28401":128093,"_3088":128148},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3638":75378,"_31204":75356,"_21623":128150,"_5":14885,"_28401":128093,"_3088":128151},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3638":75379,"_31204":75356,"_21623":128153,"_5":14885,"_28401":128097,"_3088":128154},[],"El servicio acepta:",{"_3638":75380,"_31204":75356,"_21623":128156,"_5":14885,"_28401":128097,"_3088":124019},[],{"_3638":75381,"_31204":75356,"_21623":128158,"_5":14885,"_28401":128097,"_3088":128159},[],"Ruta del servicio VA",{"_3638":75382,"_31204":75356,"_21623":128161,"_5":14885,"_28401":128097,"_3088":128162},[],"Formato",{"_3638":75383,"_31204":75356,"_21623":128164,"_5":14885,"_28401":128097,"_3088":58780},[],{"_3638":75384,"_31204":75356,"_21623":128166,"_5":14885,"_28401":128097,"_3088":58783},[],{"_3638":75385,"_31204":75356,"_21623":128168,"_5":14885,"_28401":128097,"_3088":128169},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3638":75386,"_31204":75356,"_21623":128171,"_5":14885,"_28401":128097,"_3088":58175},[],{"_3638":75387,"_31204":75356,"_21623":128173,"_5":14885,"_28401":128097,"_3088":58791},[],{"_3638":75388,"_31204":75356,"_21623":128175,"_5":14885,"_28401":128097,"_3088":128176},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3638":75389,"_31204":75356,"_21623":128178,"_5":14885,"_28401":128097,"_3088":128179},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3638":75390,"_31204":75356,"_21623":128181,"_5":14885,"_28401":128101,"_3088":128182},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3638":75391,"_31204":75356,"_21623":128184,"_5":14885,"_28401":128101,"_3088":128185},[],"Genera la solicitud:",{"_3638":75392,"_31204":75356,"_21623":128187,"_5":14885,"_28401":128101,"_3088":128188},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3638":75393,"_31204":75356,"_21623":128190,"_5":14885,"_28401":128101,"_3088":128191},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3638":75394,"_31204":75356,"_21623":128193,"_5":14885,"_28401":128101,"_3088":128194},[],"Verifica el DER recibido:",{"_3638":75395,"_31204":75356,"_21623":128196,"_5":14885,"_28401":128101,"_3088":128197},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3638":75396,"_31204":75356,"_21623":128199,"_5":14885,"_28401":128105,"_3088":128200},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3638":75397,"_31204":75356,"_21623":128202,"_5":14885,"_28401":128105,"_3088":128203},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3638":75398,"_31204":75356,"_21623":128205,"_5":14885,"_28401":128109,"_3088":58824},[],{"_3638":75399,"_31204":75356,"_21623":128207,"_5":14885,"_28401":128109,"_3088":58827},[],{"_3638":75400,"_31204":75356,"_21623":128209,"_5":14885,"_28401":128109,"_3088":128210},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3638":75401,"_31204":75356,"_21623":128212,"_5":14885,"_28401":128109,"_3088":127695},[],{"_3638":75402,"_31204":75402,"_5":15245,"_3088":56753,"_31563":128214,"_21623":128215,"_28401":75402},[51051,122144,56753],[],{"_3638":75403,"_31204":75402,"_21623":128217,"_5":14885,"_28401":75402,"_3088":128218},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3638":75404,"_31204":75402,"_5":31560,"_21623":128220,"_28401":128221,"_3088":125492},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#empieza-aquí",{"_3638":75405,"_31204":75402,"_5":31560,"_21623":128223,"_28401":128224,"_3088":128225},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3638":75406,"_31204":75402,"_5":31560,"_21623":128227,"_28401":128228,"_3088":126012},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#capacidades-principales",{"_3638":75407,"_31204":75402,"_5":31560,"_21623":128230,"_28401":128231,"_3088":126016},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3638":75408,"_31204":75402,"_5":31560,"_21623":128233,"_28401":128234,"_3088":126020},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3638":75409,"_31204":75402,"_5":31560,"_21623":128236,"_28401":128237,"_3088":126024},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#emite-y-controla-certificados",{"_3638":75410,"_31204":75402,"_5":31560,"_21623":128239,"_28401":128240,"_3088":126032},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#publica-el-estado-de-validación",{"_3638":75411,"_31204":75402,"_5":31560,"_21623":128242,"_28401":128243,"_3088":128244},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3638":75412,"_31204":75402,"_5":31560,"_21623":128246,"_28401":128247,"_3088":127003},[],"/docs/pr-preview/pr-83/es/platform/pki/overview#continúa",{"_3638":75413,"_31204":75402,"_21623":128249,"_5":14885,"_28401":75402,"_3088":128250},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3638":75414,"_31204":75402,"_21623":128252,"_5":14885,"_28401":128221,"_3088":128253},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3638":75415,"_31204":75402,"_21623":128255,"_5":14885,"_28401":128221,"_3088":128256},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3638":75416,"_31204":75402,"_21623":128258,"_5":14885,"_28401":128224,"_3088":128259},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3638":75417,"_31204":75402,"_21623":128261,"_5":14885,"_28401":128224,"_3088":128262},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3638":75418,"_31204":75402,"_21623":128264,"_5":14885,"_28401":128224,"_3088":128265},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3638":75419,"_31204":75402,"_21623":128267,"_5":14885,"_28401":128224,"_3088":128268},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3638":75420,"_31204":75402,"_21623":128270,"_5":14885,"_28401":128224,"_3088":128271},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3638":75421,"_31204":75402,"_21623":128273,"_5":14885,"_28401":128231,"_3088":128274},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3638":75422,"_31204":75402,"_21623":128276,"_5":14885,"_28401":128234,"_3088":128277},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3638":75423,"_31204":75402,"_21623":128279,"_5":14885,"_28401":128237,"_3088":128280},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3638":75424,"_31204":75402,"_21623":128282,"_5":14885,"_28401":128240,"_3088":128283},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3638":75425,"_31204":75402,"_21623":128285,"_5":14885,"_28401":128243,"_3088":128286},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3638":75426,"_31204":75402,"_21623":128288,"_5":14885,"_28401":128243,"_3088":128289},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3638":75427,"_31204":75402,"_21623":128291,"_5":14885,"_28401":128243,"_3088":128292},[],"su clave pública corresponda a la clave privada del cliente;",{"_3638":75428,"_31204":75402,"_21623":128294,"_5":14885,"_28401":128243,"_3088":128295},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3638":75429,"_31204":75402,"_21623":128297,"_5":14885,"_28401":128243,"_3088":128298},[],"sus fechas y usos permitan la operación;",{"_3638":75430,"_31204":75402,"_21623":128300,"_5":14885,"_28401":128243,"_3088":128301},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3638":75431,"_31204":75402,"_21623":128303,"_5":14885,"_28401":128243,"_3088":128304},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3638":75432,"_31204":75402,"_21623":128306,"_5":14885,"_28401":128247,"_3088":128307},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3638":75433,"_31204":75402,"_21623":128309,"_5":14885,"_28401":128247,"_3088":128310},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3638":75434,"_31204":75402,"_21623":128312,"_5":14885,"_28401":128247,"_3088":128313},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3638":75435,"_31204":75435,"_5":15245,"_3088":128315,"_31563":128316,"_21623":128317,"_28401":75435},"Crea tu primera CA",[51051,122144,56753,125616],[],{"_3638":75436,"_31204":75435,"_21623":128319,"_5":14885,"_28401":75435,"_3088":128320},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3638":75437,"_31204":75435,"_5":31560,"_21623":128322,"_28401":128323,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3638":75438,"_31204":75435,"_5":31560,"_21623":128325,"_28401":128326,"_3088":128327},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3638":75439,"_31204":75435,"_5":31560,"_21623":128329,"_28401":128330,"_3088":128331},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3638":75440,"_31204":75435,"_5":31560,"_21623":128333,"_28401":128334,"_3088":128335},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3638":75441,"_31204":75435,"_5":31560,"_21623":128337,"_28401":128338,"_3088":128339},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3638":75442,"_31204":75435,"_5":31560,"_21623":128341,"_28401":128342,"_3088":128343},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3638":75443,"_31204":75435,"_5":31560,"_21623":128345,"_28401":128346,"_3088":128347},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3638":75444,"_31204":75435,"_5":31560,"_21623":128349,"_28401":128350,"_3088":125863},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3638":75445,"_31204":75435,"_5":31560,"_21623":128352,"_28401":128353,"_3088":120686},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3638":75446,"_31204":75435,"_21623":128355,"_5":14885,"_28401":75435,"_3088":128356},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3638":75447,"_31204":75435,"_21623":128358,"_5":14885,"_28401":128323,"_3088":128359},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3638":75448,"_31204":75435,"_21623":128361,"_5":14885,"_28401":128323,"_3088":128362},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3638":75449,"_31204":75435,"_21623":128364,"_5":14885,"_28401":128323,"_3088":128365},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3638":75450,"_31204":75435,"_21623":128367,"_5":14885,"_28401":128323,"_3088":128368},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3638":75451,"_31204":75435,"_21623":128370,"_5":14885,"_28401":128326,"_3088":128371},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3638":75452,"_31204":75435,"_21623":128373,"_5":14885,"_28401":128326,"_3088":128374},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3638":75453,"_31204":75435,"_21623":128376,"_5":14885,"_28401":128330,"_3088":128377},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3638":75454,"_31204":75435,"_21623":128379,"_5":14885,"_28401":128330,"_3088":128380},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3638":75455,"_31204":75435,"_21623":128382,"_5":14885,"_28401":128334,"_3088":128383},[],"Selecciona **Root CA** y completa:",{"_3638":75456,"_31204":75435,"_21623":128385,"_5":14885,"_28401":128334,"_3088":59006},[],{"_3638":75457,"_31204":75435,"_21623":128387,"_5":14885,"_28401":128334,"_3088":128388},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3638":75458,"_31204":75435,"_21623":128390,"_5":14885,"_28401":128334,"_3088":128391},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3638":75459,"_31204":75435,"_21623":128393,"_5":14885,"_28401":128334,"_3088":128394},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3638":75460,"_31204":75435,"_21623":128396,"_5":14885,"_28401":128334,"_3088":128397},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3638":75461,"_31204":75435,"_21623":128399,"_5":14885,"_28401":128338,"_3088":128400},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3638":75462,"_31204":75435,"_21623":128402,"_5":14885,"_28401":128342,"_3088":128403},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3638":75463,"_31204":75435,"_21623":128405,"_5":14885,"_28401":128342,"_3088":128406},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3638":75464,"_31204":75435,"_21623":128408,"_5":14885,"_28401":128346,"_3088":128409},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3638":75465,"_31204":75435,"_21623":128411,"_5":14885,"_28401":128346,"_3088":128412},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3638":75466,"_31204":75435,"_21623":128414,"_5":14885,"_28401":128346,"_3088":128415},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3638":75467,"_31204":75435,"_21623":128417,"_5":14885,"_28401":128350,"_3088":128418},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3638":75468,"_31204":75435,"_21623":128420,"_5":14885,"_28401":128350,"_3088":128421},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3638":75469,"_31204":75435,"_21623":128423,"_5":14885,"_28401":128350,"_3088":128424},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3638":75470,"_31204":75435,"_21623":128426,"_5":14885,"_28401":128350,"_3088":128427},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3638":75471,"_31204":75435,"_21623":128429,"_5":14885,"_28401":128353,"_3088":128430},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3638":75472,"_31204":75472,"_5":15245,"_3088":128432,"_31563":128433,"_21623":128434,"_28401":75472},"Emite y verifica un certificado",[51051,122144,56753,125616],[],{"_3638":75473,"_31204":75472,"_21623":128436,"_5":14885,"_28401":75472,"_3088":128437},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3638":75474,"_31204":75472,"_5":31560,"_21623":128439,"_28401":128440,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3638":75475,"_31204":75472,"_5":31560,"_21623":128442,"_28401":128443,"_3088":128444},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3638":75476,"_31204":75472,"_5":31560,"_21623":128446,"_28401":128447,"_3088":128448},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3638":75477,"_31204":75472,"_5":31560,"_21623":128450,"_28401":128451,"_3088":128452},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3638":75478,"_31204":75472,"_5":31560,"_21623":128454,"_28401":128455,"_3088":128456},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3638":75479,"_31204":75472,"_5":31560,"_21623":128458,"_28401":128459,"_3088":128460},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3638":75480,"_31204":75472,"_5":31560,"_21623":128462,"_28401":128463,"_3088":128464},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3638":75481,"_31204":75472,"_5":31560,"_21623":128466,"_28401":128467,"_3088":128468},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3638":75482,"_31204":75472,"_5":31560,"_21623":128470,"_28401":128471,"_3088":128472},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3638":75483,"_31204":75472,"_5":31560,"_21623":128474,"_28401":128475,"_3088":128476},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3638":75484,"_31204":75472,"_5":31560,"_21623":128478,"_28401":128479,"_3088":125863},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3638":75485,"_31204":75472,"_5":31560,"_21623":128481,"_28401":128482,"_3088":120686},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3638":75486,"_31204":75472,"_21623":128484,"_5":14885,"_28401":75472,"_3088":128485},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3638":75487,"_31204":75472,"_21623":128487,"_5":14885,"_28401":128440,"_3088":128488},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3638":75488,"_31204":75472,"_21623":128490,"_5":14885,"_28401":128440,"_3088":128491},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3638":75489,"_31204":75472,"_21623":128493,"_5":14885,"_28401":128440,"_3088":128494},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3638":75490,"_31204":75472,"_21623":128496,"_5":14885,"_28401":128440,"_3088":128497},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3638":75491,"_31204":75472,"_21623":128499,"_5":14885,"_28401":128440,"_3088":128500},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3638":75492,"_31204":75472,"_21623":128502,"_5":14885,"_28401":128443,"_3088":128503},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3638":75493,"_31204":75472,"_21623":128505,"_5":14885,"_28401":128447,"_3088":128506},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3638":75494,"_31204":75472,"_21623":128508,"_5":14885,"_28401":128447,"_3088":128509},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3638":75495,"_31204":75472,"_21623":128511,"_5":14885,"_28401":128451,"_3088":128512},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3638":75496,"_31204":75472,"_21623":128514,"_5":14885,"_28401":128451,"_3088":128515},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3638":75497,"_31204":75472,"_21623":128517,"_5":14885,"_28401":128455,"_3088":128518},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3638":75498,"_31204":75472,"_21623":128520,"_5":14885,"_28401":128455,"_3088":128521},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3638":75499,"_31204":75472,"_21623":128523,"_5":14885,"_28401":128459,"_3088":128524},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3638":75500,"_31204":75472,"_21623":128526,"_5":14885,"_28401":128463,"_3088":128527},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3638":75501,"_31204":75472,"_21623":128529,"_5":14885,"_28401":128467,"_3088":128530},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3638":75502,"_31204":75472,"_21623":128532,"_5":14885,"_28401":128471,"_3088":128533},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3638":75503,"_31204":75472,"_21623":128535,"_5":14885,"_28401":128471,"_3088":128536},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3638":75504,"_31204":75472,"_21623":128538,"_5":14885,"_28401":128471,"_3088":128539},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3638":75505,"_31204":75472,"_21623":128541,"_5":14885,"_28401":128475,"_3088":128542},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3638":75506,"_31204":75472,"_21623":128544,"_5":14885,"_28401":128475,"_3088":128545},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3638":75507,"_31204":75472,"_21623":128547,"_5":14885,"_28401":128475,"_3088":128548},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3638":75508,"_31204":75472,"_21623":128550,"_5":14885,"_28401":128479,"_3088":125946},[],{"_3638":75509,"_31204":75472,"_21623":128552,"_5":14885,"_28401":128479,"_3088":124461},[],{"_3638":75510,"_31204":75472,"_21623":128554,"_5":14885,"_28401":128479,"_3088":128555},[],"La CA rechaza la emisión",{"_3638":75511,"_31204":75472,"_21623":128557,"_5":14885,"_28401":128479,"_3088":128558},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3638":75512,"_31204":75472,"_21623":128560,"_5":14885,"_28401":128479,"_3088":128561},[],"Sujeto o usos diferentes",{"_3638":75513,"_31204":75472,"_21623":128563,"_5":14885,"_28401":128479,"_3088":128564},[],"Perfil aplicado y valores solicitados.",{"_3638":75514,"_31204":75472,"_21623":128566,"_5":14885,"_28401":128479,"_3088":128567},[],"No se encuentra el emisor",{"_3638":75515,"_31204":75472,"_21623":128569,"_5":14885,"_28401":128479,"_3088":128570},[],"CA descargada y cadena intermedia necesaria.",{"_3638":75516,"_31204":75472,"_21623":128572,"_5":14885,"_28401":128479,"_3088":128573},[],"Falla la vigencia",{"_3638":75517,"_31204":75472,"_21623":128575,"_5":14885,"_28401":128479,"_3088":128576},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3638":75518,"_31204":75472,"_21623":128578,"_5":14885,"_28401":128479,"_3088":128579},[],"Los resúmenes de clave difieren",{"_3638":75519,"_31204":75472,"_21623":128581,"_5":14885,"_28401":128479,"_3088":128582},[],"Archivos de certificado y clave de la misma emisión.",{"_3638":75520,"_31204":75472,"_21623":128584,"_5":14885,"_28401":128479,"_3088":128585},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3638":75521,"_31204":75472,"_21623":128587,"_5":14885,"_28401":128482,"_3088":128588},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3638":75522,"_31204":75472,"_21623":128590,"_5":14885,"_28401":128482,"_3088":128591},[],"Gestionar certificados para inspección, estado y revocación.",{"_3638":75523,"_31204":75472,"_21623":128593,"_5":14885,"_28401":128482,"_3088":128594},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3638":75524,"_31204":75472,"_21623":128596,"_5":14885,"_28401":128482,"_3088":128597},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3638":75525,"_31204":75472,"_21623":128599,"_5":14885,"_28401":128482,"_3088":128600},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3638":75526,"_31204":75526,"_5":15245,"_3088":128602,"_31563":128603,"_21623":128604,"_28401":75526},"Primeros pasos de PKI",[51051,122144,56753,125616],[],{"_3638":75527,"_31204":75526,"_21623":128606,"_5":14885,"_28401":75526,"_3088":128607},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3638":75528,"_31204":75526,"_5":31560,"_21623":128609,"_28401":128610,"_3088":120662},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3638":75529,"_31204":75526,"_5":31560,"_21623":128612,"_28401":128613,"_3088":128614},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3638":75530,"_31204":75526,"_5":31560,"_21623":128616,"_28401":128617,"_3088":125798},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3638":75531,"_31204":75526,"_5":31560,"_21623":128619,"_28401":128620,"_3088":128621},[],"/docs/pr-preview/pr-83/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3638":75532,"_31204":75526,"_21623":128623,"_5":14885,"_28401":75526,"_3088":128624},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3638":75533,"_31204":75526,"_21623":128626,"_5":14885,"_28401":128610,"_3088":128627},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3638":75534,"_31204":75526,"_21623":128629,"_5":14885,"_28401":128610,"_3088":128630},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3638":75535,"_31204":75526,"_21623":128632,"_5":14885,"_28401":128610,"_3088":128633},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3638":75536,"_31204":75526,"_21623":128635,"_5":14885,"_28401":128610,"_3088":128636},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3638":75537,"_31204":75526,"_21623":128638,"_5":14885,"_28401":128610,"_3088":128639},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3638":75538,"_31204":75526,"_21623":128641,"_5":14885,"_28401":128613,"_3088":128642},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3638":75539,"_31204":75526,"_21623":128644,"_5":14885,"_28401":128613,"_3088":128645},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3638":75540,"_31204":75526,"_21623":128647,"_5":14885,"_28401":128613,"_3088":128648},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3638":75541,"_31204":75526,"_21623":128650,"_5":14885,"_28401":128613,"_3088":128651},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3638":75542,"_31204":75526,"_21623":128653,"_5":14885,"_28401":128617,"_3088":128654},[],"Archivo o recurso",{"_3638":75543,"_31204":75526,"_21623":128656,"_5":14885,"_28401":128617,"_3088":125795},[],{"_3638":75544,"_31204":75526,"_21623":128658,"_5":14885,"_28401":128617,"_3088":128659},[],"CA raíz activa y `ca.pem`",{"_3638":75545,"_31204":75526,"_21623":128661,"_5":14885,"_28401":128617,"_3088":128662},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3638":75546,"_31204":75526,"_21623":128664,"_5":14885,"_28401":128617,"_3088":128665},[],"Certificado final y `device.crt`",{"_3638":75547,"_31204":75526,"_21623":128667,"_5":14885,"_28401":128617,"_3088":128668},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3638":75548,"_31204":75526,"_21623":128670,"_5":14885,"_28401":128617,"_3088":128671},[],"Clave privada `device.key`",{"_3638":75549,"_31204":75526,"_21623":128673,"_5":14885,"_28401":128617,"_3088":128674},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3638":75550,"_31204":75526,"_21623":128676,"_5":14885,"_28401":128617,"_3088":128677},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3638":75551,"_31204":75526,"_21623":128679,"_5":14885,"_28401":128620,"_3088":128680},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3638":75552,"_31204":75526,"_21623":128682,"_5":14885,"_28401":128620,"_3088":128683},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3638":75553,"_31204":75526,"_21623":128685,"_5":14885,"_28401":128620,"_3088":128686},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3638":75554,"_31204":75554,"_5":15245,"_3088":128688,"_31563":128689,"_21623":128691,"_28401":75554},"Resolución de problemas PKI",[51051,122144,56753,128690],"Resolución de problemas",[],{"_3638":75555,"_31204":75554,"_21623":128693,"_5":14885,"_28401":75554,"_3088":128694},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3638":75556,"_31204":75554,"_5":31560,"_21623":128696,"_28401":128697,"_3088":128698},[],"/docs/pr-preview/pr-83/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3638":75557,"_31204":75554,"_5":31560,"_21623":128700,"_28401":128701,"_3088":128702},[],"/docs/pr-preview/pr-83/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3638":75558,"_31204":75554,"_5":31560,"_21623":128704,"_28401":128705,"_3088":128706},[],"/docs/pr-preview/pr-83/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3638":75559,"_31204":75554,"_21623":128708,"_5":14885,"_28401":75554,"_3088":128709},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3638":75560,"_31204":75554,"_21623":128711,"_5":14885,"_28401":75554,"_3088":128712},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3638":75561,"_31204":75554,"_21623":128714,"_5":14885,"_28401":128697,"_3088":125795},[],{"_3638":75562,"_31204":75554,"_21623":128716,"_5":14885,"_28401":128697,"_3088":124461},[],{"_3638":75563,"_31204":75554,"_21623":128718,"_5":14885,"_28401":128697,"_3088":120686},[],{"_3638":75564,"_31204":75554,"_21623":128720,"_5":14885,"_28401":128697,"_3088":55595},[],{"_3638":75565,"_31204":75554,"_21623":128722,"_5":14885,"_28401":128697,"_3088":128723},[],"Existe, está activa y sus fechas son utilizables.",{"_3638":75566,"_31204":75554,"_21623":128725,"_5":14885,"_28401":128697,"_3088":128726},[],"Autoridades.",{"_3638":75567,"_31204":75554,"_21623":128728,"_5":14885,"_28401":128697,"_3088":128729},[],"Clave",{"_3638":75568,"_31204":75554,"_21623":128731,"_5":14885,"_28401":128697,"_3088":128732},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3638":75569,"_31204":75554,"_21623":128734,"_5":14885,"_28401":128697,"_3088":128735},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3638":75570,"_31204":75554,"_21623":128737,"_5":14885,"_28401":128697,"_3088":59360},[],{"_3638":75571,"_31204":75554,"_21623":128739,"_5":14885,"_28401":128697,"_3088":128740},[],"PEM correcto y firma verificable.",{"_3638":75572,"_31204":75554,"_21623":128742,"_5":14885,"_28401":128697,"_3088":59366},[],{"_3638":75573,"_31204":75554,"_21623":128744,"_5":14885,"_28401":128697,"_3088":128745},[],"Perfil",{"_3638":75574,"_31204":75554,"_21623":128747,"_5":14885,"_28401":128697,"_3088":128748},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3638":75575,"_31204":75554,"_21623":128750,"_5":14885,"_28401":128697,"_3088":128751},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3638":75576,"_31204":75554,"_21623":128753,"_5":14885,"_28401":128697,"_3088":125946},[],{"_3638":75577,"_31204":75554,"_21623":128755,"_5":14885,"_28401":128697,"_3088":128756},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3638":75578,"_31204":75554,"_21623":128758,"_5":14885,"_28401":128697,"_3088":128759},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3638":75579,"_31204":75554,"_21623":128761,"_5":14885,"_28401":128697,"_3088":128762},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3638":75580,"_31204":75554,"_21623":128764,"_5":14885,"_28401":128697,"_3088":128765},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3638":75581,"_31204":75554,"_21623":128767,"_5":14885,"_28401":128697,"_3088":128768},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3638":75582,"_31204":75554,"_21623":128770,"_5":14885,"_28401":128701,"_3088":128771},[],"Revisa cada frontera por separado:",{"_3638":75583,"_31204":75554,"_21623":128773,"_5":14885,"_28401":128701,"_3088":128774},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3638":75584,"_31204":75554,"_21623":128776,"_5":14885,"_28401":128701,"_3088":128777},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3638":75585,"_31204":75554,"_21623":128779,"_5":14885,"_28401":128701,"_3088":128780},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3638":75586,"_31204":75554,"_21623":128782,"_5":14885,"_28401":128701,"_3088":128783},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3638":75587,"_31204":75554,"_21623":128785,"_5":14885,"_28401":128701,"_3088":128786},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3638":75588,"_31204":75554,"_21623":128788,"_5":14885,"_28401":128701,"_3088":128789},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3638":75589,"_31204":75554,"_21623":128791,"_5":14885,"_28401":128705,"_3088":128792},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3638":75590,"_31204":75554,"_21623":128794,"_5":14885,"_28401":128705,"_3088":128795},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3638":75591,"_31204":75591,"_5":15245,"_3088":128797,"_31563":128798,"_21623":128799,"_28401":75591},"Seguridad",[51051],[],{"_3638":75592,"_31204":75591,"_21623":128801,"_5":14885,"_28401":75591,"_3088":128802},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3638":75593,"_31204":75591,"_5":31560,"_21623":128804,"_28401":128805,"_3088":128806},[],"/docs/pr-preview/pr-83/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3638":75594,"_31204":75591,"_5":31560,"_21623":128808,"_28401":128809,"_3088":128810},[],"/docs/pr-preview/pr-83/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3638":75595,"_31204":75591,"_5":31560,"_21623":128812,"_28401":128813,"_3088":128814},[],"/docs/pr-preview/pr-83/es/security#versiones-soportadas","Versiones soportadas",{"_3638":75596,"_31204":75591,"_5":31560,"_21623":128816,"_28401":128817,"_3088":128818},[],"/docs/pr-preview/pr-83/es/security#divulgación-responsable","Divulgación responsable",{"_3638":75597,"_31204":75591,"_21623":128820,"_5":14885,"_28401":75591,"_3088":128821},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3638":75598,"_31204":75591,"_21623":128823,"_5":14885,"_28401":128805,"_3088":128824},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3638":75599,"_31204":75591,"_21623":128826,"_5":14885,"_28401":128805,"_3088":128827},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3638":75600,"_31204":75591,"_21623":128829,"_5":14885,"_28401":128805,"_3088":15524},[],{"_3638":75601,"_31204":75591,"_21623":128831,"_5":14885,"_28401":128805,"_3088":15453},[],{"_3638":75602,"_31204":75591,"_21623":128833,"_5":14885,"_28401":128805,"_3088":15511},[],{"_3638":75603,"_31204":75591,"_21623":128835,"_5":14885,"_28401":128805,"_3088":128836},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3638":75604,"_31204":75591,"_21623":128838,"_5":14885,"_28401":128805,"_3088":128839},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3638":75605,"_31204":75591,"_21623":128841,"_5":14885,"_28401":128809,"_3088":128842},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3638":75606,"_31204":75591,"_21623":128844,"_5":14885,"_28401":128809,"_3088":128845},[],"No incluyas en el reporte:",{"_3638":75607,"_31204":75591,"_21623":128847,"_5":14885,"_28401":128809,"_3088":128848},[],"Credenciales, tokens o claves privadas",{"_3638":75608,"_31204":75591,"_21623":128850,"_5":14885,"_28401":128809,"_3088":128851},[],"Datos de clientes o información identificable de clientes",{"_3638":75609,"_31204":75591,"_21623":128853,"_5":14885,"_28401":128809,"_3088":128854},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3638":75610,"_31204":75591,"_21623":128856,"_5":14885,"_28401":128813,"_3088":128857},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3638":75611,"_31204":75591,"_21623":128859,"_5":14885,"_28401":128813,"_3088":128860},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3638":75612,"_31204":75591,"_21623":128862,"_5":14885,"_28401":128817,"_3088":128863},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3638":75613,"_31204":75591,"_21623":128865,"_5":14885,"_28401":128817,"_3088":128866},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3638":75614,"_31204":75591,"_21623":128868,"_5":14885,"_28401":128817,"_3088":128869},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3638":75615,"_31204":75591,"_21623":128871,"_5":14885,"_28401":128817,"_3088":128872},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3638":75616,"_31204":75591,"_21623":128874,"_5":14885,"_28401":128817,"_3088":128875},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3638":75617,"_31204":75617,"_5":15245,"_3088":128877,"_31563":128878,"_21623":128880,"_28401":75617},"3.8.0 a 4.0.0",[51051,128879],"Actualizaciones",[],{"_3638":75618,"_31204":75617,"_21623":128882,"_5":14885,"_28401":75617,"_3088":128883},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3638":75619,"_31204":75617,"_5":31560,"_21623":128885,"_28401":128886,"_3088":128887},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3638":75620,"_31204":75617,"_5":31560,"_21623":128889,"_28401":128890,"_3088":128891},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3638":75621,"_31204":75617,"_5":31560,"_21623":128893,"_28401":128894,"_3088":128895},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3638":75622,"_31204":75617,"_5":31560,"_21623":128897,"_28401":128898,"_3088":128899},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3638":75623,"_31204":75617,"_5":31560,"_21623":128901,"_28401":128902,"_3088":128903},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3638":75624,"_31204":75617,"_5":31560,"_21623":128905,"_28401":128906,"_3088":128907},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3638":75625,"_31204":75617,"_5":31560,"_21623":128909,"_28401":128910,"_3088":59535},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3638":75626,"_31204":75617,"_5":31560,"_21623":128912,"_28401":128913,"_3088":128914},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3638":75627,"_31204":75617,"_5":31560,"_21623":128916,"_28401":128917,"_3088":128918},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3638":75628,"_31204":75617,"_5":31560,"_21623":128920,"_28401":128921,"_3088":128922},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3638":75629,"_31204":75617,"_5":31560,"_21623":128924,"_28401":128925,"_3088":121257},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3638":75630,"_31204":75617,"_5":31560,"_21623":128927,"_28401":128928,"_3088":128929},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3638":75631,"_31204":75617,"_5":31560,"_21623":128931,"_28401":128932,"_3088":128933},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3638":75632,"_31204":75617,"_5":31560,"_21623":128935,"_28401":128936,"_3088":128937},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3638":75633,"_31204":75617,"_5":31560,"_21623":128939,"_28401":128940,"_3088":128941},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3638":75634,"_31204":75617,"_5":31560,"_21623":128943,"_28401":128944,"_3088":128945},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3638":75635,"_31204":75617,"_5":31560,"_21623":128947,"_28401":128948,"_3088":128949},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3638":75636,"_31204":75617,"_5":31560,"_21623":128951,"_28401":128952,"_3088":128953},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3638":75637,"_31204":75617,"_5":31560,"_21623":128955,"_28401":128956,"_3088":128957},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3638":75638,"_31204":75617,"_5":31560,"_21623":128959,"_28401":128960,"_3088":128961},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3638":75639,"_31204":75617,"_5":31560,"_21623":128963,"_28401":128964,"_3088":128965},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3638":75640,"_31204":75617,"_5":31560,"_21623":128967,"_28401":128968,"_3088":128969},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3638":75641,"_31204":75617,"_5":31560,"_21623":128971,"_28401":128972,"_3088":128973},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3638":75642,"_31204":75617,"_5":31560,"_21623":128975,"_28401":128976,"_3088":128977},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3638":75643,"_31204":75617,"_5":31560,"_21623":128979,"_28401":128980,"_3088":128981},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3638":75644,"_31204":75617,"_5":31560,"_21623":128983,"_28401":128984,"_3088":128985},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3638":75645,"_31204":75617,"_5":31560,"_21623":128987,"_28401":128988,"_3088":128989},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3638":75646,"_31204":75617,"_5":31560,"_21623":128991,"_28401":128992,"_3088":128993},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3638":75647,"_31204":75617,"_5":31560,"_21623":128995,"_28401":128996,"_3088":128997},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3638":75648,"_31204":75617,"_5":31560,"_21623":128999,"_28401":129000,"_3088":129001},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3638":75649,"_31204":75617,"_5":31560,"_21623":129003,"_28401":129004,"_3088":129005},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3638":75650,"_31204":75617,"_5":31560,"_21623":129007,"_28401":129008,"_3088":129009},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3638":75651,"_31204":75617,"_5":31560,"_21623":129011,"_28401":129012,"_3088":129013},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3638":75652,"_31204":75617,"_5":31560,"_21623":129015,"_28401":129016,"_3088":129017},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3638":75653,"_31204":75617,"_5":31560,"_21623":129019,"_28401":129020,"_3088":129021},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3638":75654,"_31204":75617,"_5":31560,"_21623":129023,"_28401":129024,"_3088":129025},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3638":75655,"_31204":75617,"_5":31560,"_21623":129027,"_28401":129028,"_3088":129029},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3638":75656,"_31204":75617,"_5":31560,"_21623":129031,"_28401":129032,"_3088":129033},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3638":75657,"_31204":75617,"_5":31560,"_21623":129035,"_28401":129036,"_3088":129037},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3638":75658,"_31204":75617,"_5":31560,"_21623":129039,"_28401":129040,"_3088":129041},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3638":75659,"_31204":75617,"_5":31560,"_21623":129043,"_28401":129044,"_3088":129045},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3638":75660,"_31204":75617,"_5":31560,"_21623":129047,"_28401":129048,"_3088":129049},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3638":75661,"_31204":75617,"_5":31560,"_21623":129051,"_28401":129052,"_3088":129053},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3638":75662,"_31204":75617,"_5":31560,"_21623":129055,"_28401":129056,"_3088":129057},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3638":75663,"_31204":75617,"_5":31560,"_21623":129059,"_28401":129060,"_3088":124809},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3638":75664,"_31204":75617,"_5":31560,"_21623":129062,"_28401":129063,"_3088":129064},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3638":75665,"_31204":75617,"_5":31560,"_21623":129066,"_28401":129067,"_3088":129068},[],"/docs/pr-preview/pr-83/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3638":75666,"_31204":75617,"_21623":129070,"_5":14885,"_28401":75617,"_3088":129071},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3638":75667,"_31204":75617,"_21623":129073,"_5":14885,"_28401":75617,"_3088":129074},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3638":75668,"_31204":75617,"_21623":129076,"_5":14885,"_28401":75617,"_3088":129077},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3638":75669,"_31204":75617,"_21623":129079,"_5":14885,"_28401":75617,"_3088":129080},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3638":75670,"_31204":75617,"_21623":129082,"_5":14885,"_28401":75617,"_3088":129083},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3638":75671,"_31204":75617,"_21623":129085,"_5":14885,"_28401":75617,"_3088":129086},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3638":75672,"_31204":75617,"_21623":129088,"_5":14885,"_28401":75617,"_3088":129089},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3638":75673,"_31204":75617,"_21623":129091,"_5":14885,"_28401":128890,"_3088":129092},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3638":75674,"_31204":75617,"_21623":129094,"_5":14885,"_28401":128890,"_3088":129095},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3638":75675,"_31204":75617,"_21623":129097,"_5":14885,"_28401":128894,"_3088":129098},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3638":75676,"_31204":75617,"_21623":129100,"_5":14885,"_28401":128894,"_3088":129101},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3638":75677,"_31204":75617,"_21623":129103,"_5":14885,"_28401":128898,"_3088":129104},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3638":75678,"_31204":75617,"_21623":129106,"_5":14885,"_28401":128902,"_3088":129107},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3638":75679,"_31204":75617,"_21623":129109,"_5":14885,"_28401":128902,"_3088":129110},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3638":75680,"_31204":75617,"_21623":129112,"_5":14885,"_28401":128902,"_3088":129113},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3638":75681,"_31204":75617,"_21623":129115,"_5":14885,"_28401":128902,"_3088":129116},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3638":75682,"_31204":75617,"_21623":129118,"_5":14885,"_28401":128902,"_3088":129119},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3638":75683,"_31204":75617,"_21623":129121,"_5":14885,"_28401":128906,"_3088":129122},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3638":75684,"_31204":75617,"_21623":129124,"_5":14885,"_28401":128906,"_3088":129125},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3638":75685,"_31204":75617,"_21623":129127,"_5":14885,"_28401":128906,"_3088":129128},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3638":75686,"_31204":75617,"_21623":129130,"_5":14885,"_28401":128906,"_3088":129131},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3638":75687,"_31204":75617,"_21623":129133,"_5":14885,"_28401":128906,"_3088":129134},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3638":75688,"_31204":75617,"_21623":129136,"_5":14885,"_28401":128906,"_3088":129137},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3638":75689,"_31204":75617,"_21623":129139,"_5":14885,"_28401":128910,"_3088":129140},[],"Cambio",{"_3638":75690,"_31204":75617,"_21623":129142,"_5":14885,"_28401":128910,"_3088":129143},[],"A quién afecta",{"_3638":75691,"_31204":75617,"_21623":129145,"_5":14885,"_28401":128910,"_3088":129146},[],"Gravedad",{"_3638":75692,"_31204":75617,"_21623":129148,"_5":14885,"_28401":128910,"_3088":127619},[],{"_3638":75693,"_31204":75617,"_21623":129150,"_5":14885,"_28401":128910,"_3088":128918},[],{"_3638":75694,"_31204":75617,"_21623":129152,"_5":14885,"_28401":128910,"_3088":129153},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3638":75695,"_31204":75617,"_21623":129155,"_5":14885,"_28401":128910,"_3088":129156},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3638":75696,"_31204":75617,"_21623":129158,"_5":14885,"_28401":128910,"_3088":129159},[],"Copiar los datos a los volúmenes nuevos",{"_3638":75697,"_31204":75617,"_21623":129161,"_5":14885,"_28401":128910,"_3088":128922},[],{"_3638":75698,"_31204":75617,"_21623":129163,"_5":14885,"_28401":128910,"_3088":129164},[],"Todas las releases de Helm",{"_3638":75699,"_31204":75617,"_21623":129166,"_5":14885,"_28401":128910,"_3088":129167},[],"Alta: `helm upgrade` falla",{"_3638":75700,"_31204":75617,"_21623":129169,"_5":14885,"_28401":128910,"_3088":129170},[],"Eliminar o renombrar las claves heredadas",{"_3638":75701,"_31204":75617,"_21623":129172,"_5":14885,"_28401":128910,"_3088":121257},[],{"_3638":75702,"_31204":75617,"_21623":129174,"_5":14885,"_28401":128910,"_3088":129164},[],{"_3638":75703,"_31204":75617,"_21623":129176,"_5":14885,"_28401":128910,"_3088":129177},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3638":75704,"_31204":75617,"_21623":129179,"_5":14885,"_28401":128910,"_3088":129180},[],"Crear primero los Secrets; consulta el paso 2",{"_3638":75705,"_31204":75617,"_21623":129182,"_5":14885,"_28401":128910,"_3088":128929},[],{"_3638":75706,"_31204":75617,"_21623":129184,"_5":14885,"_28401":128910,"_3088":129185},[],"Todos los despliegues",{"_3638":75707,"_31204":75617,"_21623":129187,"_5":14885,"_28401":128910,"_3088":129188},[],"Alta: sin principal de bootstrap no hay administrador",{"_3638":75708,"_31204":75617,"_21623":129190,"_5":14885,"_28401":128910,"_3088":129191},[],"Configurar `services.authz`",{"_3638":75709,"_31204":75617,"_21623":129193,"_5":14885,"_28401":128910,"_3088":128933},[],{"_3638":75710,"_31204":75617,"_21623":129195,"_5":14885,"_28401":128910,"_3088":129164},[],{"_3638":75711,"_31204":75617,"_21623":129197,"_5":14885,"_28401":128910,"_3088":129198},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3638":75712,"_31204":75617,"_21623":129200,"_5":14885,"_28401":128910,"_3088":129201},[],"Mover JWKS y roles a `services.authz`",{"_3638":75713,"_31204":75617,"_21623":129203,"_5":14885,"_28401":128910,"_3088":128953},[],{"_3638":75714,"_31204":75617,"_21623":129205,"_5":14885,"_28401":128910,"_3088":129206},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3638":75715,"_31204":75617,"_21623":129208,"_5":14885,"_28401":128910,"_3088":129209},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3638":75716,"_31204":75617,"_21623":129211,"_5":14885,"_28401":128910,"_3088":129212},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3638":75717,"_31204":75617,"_21623":129214,"_5":14885,"_28401":128910,"_3088":128957},[],{"_3638":75718,"_31204":75617,"_21623":129216,"_5":14885,"_28401":128910,"_3088":129217},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3638":75719,"_31204":75617,"_21623":129219,"_5":14885,"_28401":128910,"_3088":129220},[],"Alta: el backend ya no arranca con ellos",{"_3638":75720,"_31204":75617,"_21623":129222,"_5":14885,"_28401":128910,"_3088":129223},[],"Pasar a PostgreSQL antes de actualizar",{"_3638":75721,"_31204":75617,"_21623":129225,"_5":14885,"_28401":128910,"_3088":129005},[],{"_3638":75722,"_31204":75617,"_21623":129227,"_5":14885,"_28401":128910,"_3088":129228},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3638":75723,"_31204":75617,"_21623":129230,"_5":14885,"_28401":128910,"_3088":129231},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3638":75724,"_31204":75617,"_21623":129233,"_5":14885,"_28401":128910,"_3088":129234},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3638":75725,"_31204":75617,"_21623":129236,"_5":14885,"_28401":128910,"_3088":129237},[],"Webhooks con referencias a archivos",{"_3638":75726,"_31204":75617,"_21623":129239,"_5":14885,"_28401":128910,"_3088":129240},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3638":75727,"_31204":75617,"_21623":129242,"_5":14885,"_28401":128910,"_3088":129243},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3638":75728,"_31204":75617,"_21623":129245,"_5":14885,"_28401":128910,"_3088":129246},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3638":75729,"_31204":75617,"_21623":129248,"_5":14885,"_28401":128910,"_3088":128937},[],{"_3638":75730,"_31204":75617,"_21623":129250,"_5":14885,"_28401":128910,"_3088":129251},[],"Releases con identidades por servicio o material de claves montado",{"_3638":75731,"_31204":75617,"_21623":129253,"_5":14885,"_28401":128910,"_3088":129254},[],"Media: los servicios no pueden leer sus archivos",{"_3638":75732,"_31204":75617,"_21623":129256,"_5":14885,"_28401":128910,"_3088":129257},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3638":75733,"_31204":75617,"_21623":129259,"_5":14885,"_28401":128910,"_3088":128941},[],{"_3638":75734,"_31204":75617,"_21623":129261,"_5":14885,"_28401":128910,"_3088":129262},[],"Releases que definen `amqp.tls`",{"_3638":75735,"_31204":75617,"_21623":129264,"_5":14885,"_28401":128910,"_3088":129265},[],"Media: los clientes se conectan al puerto equivocado",{"_3638":75736,"_31204":75617,"_21623":129267,"_5":14885,"_28401":128910,"_3088":129268},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3638":75737,"_31204":75617,"_21623":129270,"_5":14885,"_28401":128910,"_3088":128961},[],{"_3638":75738,"_31204":75617,"_21623":129272,"_5":14885,"_28401":128910,"_3088":129273},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3638":75739,"_31204":75617,"_21623":129275,"_5":14885,"_28401":128910,"_3088":129276},[],"Media: las claves de CA quedan sin gestionar",{"_3638":75740,"_31204":75617,"_21623":129278,"_5":14885,"_28401":128910,"_3088":129279},[],"Ejecutar la migración de CA a KMS",{"_3638":75741,"_31204":75617,"_21623":129281,"_5":14885,"_28401":128910,"_3088":129282},[],"Verificación del certificado del receptor",{"_3638":75742,"_31204":75617,"_21623":129284,"_5":14885,"_28401":128910,"_3088":129285},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3638":75743,"_31204":75617,"_21623":129287,"_5":14885,"_28401":128910,"_3088":129288},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3638":75744,"_31204":75617,"_21623":129290,"_5":14885,"_28401":128910,"_3088":129291},[],"Poner `insecure_skip_verify` a `false`",{"_3638":75745,"_31204":75617,"_21623":129293,"_5":14885,"_28401":128910,"_3088":128977},[],{"_3638":75746,"_31204":75617,"_21623":129295,"_5":14885,"_28401":128910,"_3088":129296},[],"Scripts y consolas que editan DMS por API",{"_3638":75747,"_31204":75617,"_21623":129298,"_5":14885,"_28401":128910,"_3088":129299},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3638":75748,"_31204":75617,"_21623":129301,"_5":14885,"_28401":128910,"_3088":129302},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3638":75749,"_31204":75617,"_21623":129304,"_5":14885,"_28401":128910,"_3088":128981},[],{"_3638":75750,"_31204":75617,"_21623":129306,"_5":14885,"_28401":128910,"_3088":129307},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3638":75751,"_31204":75617,"_21623":129309,"_5":14885,"_28401":128910,"_3088":129310},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3638":75752,"_31204":75617,"_21623":129312,"_5":14885,"_28401":128910,"_3088":129313},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3638":75753,"_31204":75617,"_21623":129315,"_5":14885,"_28401":128910,"_3088":129001},[],{"_3638":75754,"_31204":75617,"_21623":129317,"_5":14885,"_28401":128910,"_3088":129318},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3638":75755,"_31204":75617,"_21623":129320,"_5":14885,"_28401":128910,"_3088":129321},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3638":75756,"_31204":75617,"_21623":129323,"_5":14885,"_28401":128910,"_3088":129324},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3638":75757,"_31204":75617,"_21623":129326,"_5":14885,"_28401":128910,"_3088":129009},[],{"_3638":75758,"_31204":75617,"_21623":129328,"_5":14885,"_28401":128910,"_3088":129329},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3638":75759,"_31204":75617,"_21623":129331,"_5":14885,"_28401":128910,"_3088":129332},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3638":75760,"_31204":75617,"_21623":129334,"_5":14885,"_28401":128910,"_3088":129335},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3638":75761,"_31204":75617,"_21623":129337,"_5":14885,"_28401":128910,"_3088":129013},[],{"_3638":75762,"_31204":75617,"_21623":129339,"_5":14885,"_28401":128910,"_3088":129340},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3638":75763,"_31204":75617,"_21623":129342,"_5":14885,"_28401":128910,"_3088":129343},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3638":75764,"_31204":75617,"_21623":129345,"_5":14885,"_28401":128910,"_3088":129346},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3638":75765,"_31204":75617,"_21623":129348,"_5":14885,"_28401":128910,"_3088":128997},[],{"_3638":75766,"_31204":75617,"_21623":129350,"_5":14885,"_28401":128910,"_3088":129351},[],"Consumidores que leen el campo `events` del dispositivo",{"_3638":75767,"_31204":75617,"_21623":129353,"_5":14885,"_28401":128910,"_3088":129354},[],"Media: el campo desaparece",{"_3638":75768,"_31204":75617,"_21623":129356,"_5":14885,"_28401":128910,"_3088":129357},[],"Usar los nuevos endpoints de eventos",{"_3638":75769,"_31204":75617,"_21623":129359,"_5":14885,"_28401":128910,"_3088":129025},[],{"_3638":75770,"_31204":75617,"_21623":129361,"_5":14885,"_28401":128910,"_3088":129362},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3638":75771,"_31204":75617,"_21623":129364,"_5":14885,"_28401":128910,"_3088":129365},[],"Media: la migración de la VA aborta",{"_3638":75772,"_31204":75617,"_21623":129367,"_5":14885,"_28401":128910,"_3088":129368},[],"Corregir los roles afectados antes de actualizar",{"_3638":75773,"_31204":75617,"_21623":129370,"_5":14885,"_28401":128910,"_3088":128945},[],{"_3638":75774,"_31204":75617,"_21623":129372,"_5":14885,"_28401":128910,"_3088":129373},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3638":75775,"_31204":75617,"_21623":129375,"_5":14885,"_28401":128910,"_3088":129376},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3638":75776,"_31204":75617,"_21623":129378,"_5":14885,"_28401":128910,"_3088":129379},[],"Actualizar el archivo de values",{"_3638":75777,"_31204":75617,"_21623":129381,"_5":14885,"_28401":128910,"_3088":128989},[],{"_3638":75778,"_31204":75617,"_21623":129383,"_5":14885,"_28401":128910,"_3088":129384},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3638":75779,"_31204":75617,"_21623":129386,"_5":14885,"_28401":128910,"_3088":129387},[],"Baja: prevalece el ID de la URL",{"_3638":75780,"_31204":75617,"_21623":129389,"_5":14885,"_28401":128910,"_3088":129390},[],"Enviar el ID en la URL",{"_3638":75781,"_31204":75617,"_21623":129392,"_5":14885,"_28401":128910,"_3088":129017},[],{"_3638":75782,"_31204":75617,"_21623":129394,"_5":14885,"_28401":128910,"_3088":129395},[],"Clientes que envían un `id` al crear o importar CAs",{"_3638":75783,"_31204":75617,"_21623":129397,"_5":14885,"_28401":128910,"_3088":129398},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3638":75784,"_31204":75617,"_21623":129400,"_5":14885,"_28401":128910,"_3088":129401},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3638":75785,"_31204":75617,"_21623":129403,"_5":14885,"_28401":128910,"_3088":129021},[],{"_3638":75786,"_31204":75617,"_21623":129405,"_5":14885,"_28401":128910,"_3088":129406},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3638":75787,"_31204":75617,"_21623":129408,"_5":14885,"_28401":128910,"_3088":129409},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3638":75788,"_31204":75617,"_21623":129411,"_5":14885,"_28401":128910,"_3088":129412},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3638":75789,"_31204":75617,"_21623":129414,"_5":14885,"_28401":128910,"_3088":128993},[],{"_3638":75790,"_31204":75617,"_21623":129416,"_5":14885,"_28401":128910,"_3088":129417},[],"Consumidores que comparan el `type` del certificado",{"_3638":75791,"_31204":75617,"_21623":129419,"_5":14885,"_28401":128910,"_3088":129420},[],"Baja: dos valores cambian de nombre",{"_3638":75792,"_31204":75617,"_21623":129422,"_5":14885,"_28401":128910,"_3088":129423},[],"Adaptar los consumidores",{"_3638":75793,"_31204":75617,"_21623":129425,"_5":14885,"_28401":128910,"_3088":128985},[],{"_3638":75794,"_31204":75617,"_21623":129427,"_5":14885,"_28401":128910,"_3088":129428},[],"Cualquier DMS",{"_3638":75795,"_31204":75617,"_21623":129430,"_5":14885,"_28401":128910,"_3088":129431},[],"Baja: solo informativo",{"_3638":75796,"_31204":75617,"_21623":129433,"_5":14885,"_28401":128910,"_3088":129434},[],"Revisar ambos bloques antes de editar",{"_3638":75797,"_31204":75617,"_21623":129436,"_5":14885,"_28401":128917,"_3088":129437},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3638":75798,"_31204":75617,"_21623":129439,"_5":14885,"_28401":128917,"_3088":129440},[],"El paso 4 de la guía de migración copia los datos.",{"_3638":75799,"_31204":75617,"_21623":129442,"_5":14885,"_28401":128921,"_3088":129443},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3638":75800,"_31204":75617,"_21623":129445,"_5":14885,"_28401":128925,"_3088":129446},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3638":75801,"_31204":75617,"_21623":129448,"_5":14885,"_28401":128925,"_3088":129449},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3638":75802,"_31204":75617,"_21623":129451,"_5":14885,"_28401":128928,"_3088":129452},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3638":75803,"_31204":75617,"_21623":129454,"_5":14885,"_28401":128932,"_3088":129455},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3638":75804,"_31204":75617,"_21623":129457,"_5":14885,"_28401":128936,"_3088":129458},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3638":75805,"_31204":75617,"_21623":129460,"_5":14885,"_28401":128936,"_3088":129461},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3638":75806,"_31204":75617,"_21623":129463,"_5":14885,"_28401":128936,"_3088":129464},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3638":75807,"_31204":75617,"_21623":129466,"_5":14885,"_28401":128940,"_3088":129467},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3638":75808,"_31204":75617,"_21623":129469,"_5":14885,"_28401":128944,"_3088":129470},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3638":75809,"_31204":75617,"_21623":129472,"_5":14885,"_28401":128944,"_3088":129473},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3638":75810,"_31204":75617,"_21623":129475,"_5":14885,"_28401":128944,"_3088":129476},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3638":75811,"_31204":75617,"_21623":129478,"_5":14885,"_28401":128944,"_3088":129479},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3638":75812,"_31204":75617,"_21623":129481,"_5":14885,"_28401":128944,"_3088":129482},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3638":75813,"_31204":75617,"_21623":129484,"_5":14885,"_28401":128944,"_3088":129485},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3638":75814,"_31204":75617,"_21623":129487,"_5":14885,"_28401":128952,"_3088":129488},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3638":75815,"_31204":75617,"_21623":129490,"_5":14885,"_28401":128952,"_3088":129491},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3638":75816,"_31204":75617,"_21623":129493,"_5":14885,"_28401":128952,"_3088":129494},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3638":75817,"_31204":75617,"_21623":129496,"_5":14885,"_28401":128952,"_3088":129497},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3638":75818,"_31204":75617,"_21623":129499,"_5":14885,"_28401":128952,"_3088":129500},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3638":75819,"_31204":75617,"_21623":129502,"_5":14885,"_28401":128956,"_3088":129503},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3638":75820,"_31204":75617,"_21623":129505,"_5":14885,"_28401":128960,"_3088":129506},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3638":75821,"_31204":75617,"_21623":129508,"_5":14885,"_28401":128960,"_3088":129509},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3638":75822,"_31204":75617,"_21623":129511,"_5":14885,"_28401":128960,"_3088":129512},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3638":75823,"_31204":75617,"_21623":129514,"_5":14885,"_28401":128960,"_3088":129515},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3638":75824,"_31204":75617,"_21623":129517,"_5":14885,"_28401":128960,"_3088":129518},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3638":75825,"_31204":75617,"_21623":129520,"_5":14885,"_28401":128960,"_3088":129521},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3638":75826,"_31204":75617,"_21623":129523,"_5":14885,"_28401":128960,"_3088":129524},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3638":75827,"_31204":75617,"_21623":129526,"_5":14885,"_28401":128960,"_3088":129527},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3638":75828,"_31204":75617,"_21623":129529,"_5":14885,"_28401":128964,"_3088":129530},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3638":75829,"_31204":75617,"_21623":129532,"_5":14885,"_28401":128972,"_3088":129533},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3638":75830,"_31204":75617,"_21623":129535,"_5":14885,"_28401":128972,"_3088":129536},[],"Campo en 3.8.0",{"_3638":75831,"_31204":75617,"_21623":129538,"_5":14885,"_28401":128972,"_3088":129539},[],"Campo en 4.0.0",{"_3638":75832,"_31204":75617,"_21623":129541,"_5":14885,"_28401":128972,"_3088":60166},[],{"_3638":75833,"_31204":75617,"_21623":129543,"_5":14885,"_28401":128972,"_3088":129544},[],"`insecure_skip_verify` (con el valor negado)",{"_3638":75834,"_31204":75617,"_21623":129546,"_5":14885,"_28401":128972,"_3088":60172},[],{"_3638":75835,"_31204":75617,"_21623":129548,"_5":14885,"_28401":128972,"_3088":60175},[],{"_3638":75836,"_31204":75617,"_21623":129550,"_5":14885,"_28401":128972,"_3088":60178},[],{"_3638":75837,"_31204":75617,"_21623":129552,"_5":14885,"_28401":128972,"_3088":60181},[],{"_3638":75838,"_31204":75617,"_21623":129554,"_5":14885,"_28401":128972,"_3088":60184},[],{"_3638":75839,"_31204":75617,"_21623":129556,"_5":14885,"_28401":128972,"_3088":60187},[],{"_3638":75840,"_31204":75617,"_21623":129558,"_5":14885,"_28401":128972,"_3088":129559},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3638":75841,"_31204":75617,"_21623":129561,"_5":14885,"_28401":128972,"_3088":129562},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3638":75842,"_31204":75617,"_21623":129564,"_5":14885,"_28401":128972,"_3088":129565},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3638":75843,"_31204":75617,"_21623":129567,"_5":14885,"_28401":128976,"_3088":129568},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3638":75844,"_31204":75617,"_21623":129570,"_5":14885,"_28401":128976,"_3088":129571},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3638":75845,"_31204":75617,"_21623":129573,"_5":14885,"_28401":128976,"_3088":129574},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3638":75846,"_31204":75617,"_21623":129576,"_5":14885,"_28401":128980,"_3088":129577},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3638":75847,"_31204":75617,"_21623":129579,"_5":14885,"_28401":128980,"_3088":129580},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3638":75848,"_31204":75617,"_21623":129582,"_5":14885,"_28401":128984,"_3088":129583},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3638":75849,"_31204":75617,"_21623":129585,"_5":14885,"_28401":128988,"_3088":129586},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3638":75850,"_31204":75617,"_21623":129588,"_5":14885,"_28401":128992,"_3088":129589},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3638":75851,"_31204":75617,"_21623":129591,"_5":14885,"_28401":128996,"_3088":129592},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3638":75852,"_31204":75617,"_21623":129594,"_5":14885,"_28401":128996,"_3088":129595},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3638":75853,"_31204":75617,"_21623":129597,"_5":14885,"_28401":128996,"_3088":129598},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3638":75854,"_31204":75617,"_21623":129600,"_5":14885,"_28401":128996,"_3088":129601},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3638":75855,"_31204":75617,"_21623":129603,"_5":14885,"_28401":129000,"_3088":129604},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3638":75856,"_31204":75617,"_21623":129606,"_5":14885,"_28401":129004,"_3088":129607},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3638":75857,"_31204":75617,"_21623":129609,"_5":14885,"_28401":129004,"_3088":129610},[],"Ruta",{"_3638":75858,"_31204":75617,"_21623":129612,"_5":14885,"_28401":129004,"_3088":121904},[],{"_3638":75859,"_31204":75617,"_21623":129614,"_5":14885,"_28401":129004,"_3088":60246},[],{"_3638":75860,"_31204":75617,"_21623":129616,"_5":14885,"_28401":129004,"_3088":129617},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3638":75861,"_31204":75617,"_21623":129619,"_5":14885,"_28401":129004,"_3088":60252},[],{"_3638":75862,"_31204":75617,"_21623":129621,"_5":14885,"_28401":129004,"_3088":129622},[],"Lee los ajustes de una CA.",{"_3638":75863,"_31204":75617,"_21623":129624,"_5":14885,"_28401":129004,"_3088":60258},[],{"_3638":75864,"_31204":75617,"_21623":129626,"_5":14885,"_28401":129004,"_3088":129627},[],"Sustituye los `crl_options`.",{"_3638":75865,"_31204":75617,"_21623":129629,"_5":14885,"_28401":129004,"_3088":60264},[],{"_3638":75866,"_31204":75617,"_21623":129631,"_5":14885,"_28401":129004,"_3088":129632},[],"Elimina los ajustes archivados de una CA.",{"_3638":75867,"_31204":75617,"_21623":129634,"_5":14885,"_28401":129004,"_3088":129635},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3638":75868,"_31204":75617,"_21623":129637,"_5":14885,"_28401":129004,"_3088":129638},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3638":75869,"_31204":75617,"_21623":129640,"_5":14885,"_28401":129004,"_3088":129641},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3638":75870,"_31204":75617,"_21623":129643,"_5":14885,"_28401":129004,"_3088":129644},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3638":75871,"_31204":75617,"_21623":129646,"_5":14885,"_28401":129004,"_3088":129647},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3638":75872,"_31204":75617,"_21623":129649,"_5":14885,"_28401":129004,"_3088":129650},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3638":75873,"_31204":75617,"_21623":129652,"_5":14885,"_28401":129004,"_3088":129653},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3638":75874,"_31204":75617,"_21623":129655,"_5":14885,"_28401":129004,"_3088":129656},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3638":75875,"_31204":75617,"_21623":129658,"_5":14885,"_28401":129004,"_3088":129659},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3638":75876,"_31204":75617,"_21623":129661,"_5":14885,"_28401":129004,"_3088":129662},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3638":75877,"_31204":75617,"_21623":129664,"_5":14885,"_28401":129004,"_3088":129665},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3638":75878,"_31204":75617,"_21623":129667,"_5":14885,"_28401":129008,"_3088":129668},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3638":75879,"_31204":75617,"_21623":129670,"_5":14885,"_28401":129012,"_3088":129671},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3638":75880,"_31204":75617,"_21623":129673,"_5":14885,"_28401":129016,"_3088":129674},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3638":75881,"_31204":75617,"_21623":129676,"_5":14885,"_28401":129020,"_3088":129677},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3638":75882,"_31204":75617,"_21623":129679,"_5":14885,"_28401":129020,"_3088":129680},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3638":75883,"_31204":75617,"_21623":129682,"_5":14885,"_28401":129024,"_3088":129683},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3638":75884,"_31204":75617,"_21623":129685,"_5":14885,"_28401":129028,"_3088":129686},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3638":75885,"_31204":75617,"_21623":129688,"_5":14885,"_28401":129032,"_3088":129689},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3638":75886,"_31204":75617,"_21623":129691,"_5":14885,"_28401":129032,"_3088":129692},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3638":75887,"_31204":75617,"_21623":129694,"_5":14885,"_28401":129032,"_3088":129695},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3638":75888,"_31204":75617,"_21623":129697,"_5":14885,"_28401":129032,"_3088":129698},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3638":75889,"_31204":75617,"_21623":129700,"_5":14885,"_28401":129032,"_3088":129701},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3638":75890,"_31204":75617,"_21623":129703,"_5":14885,"_28401":129032,"_3088":129704},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3638":75891,"_31204":75617,"_21623":129706,"_5":14885,"_28401":129036,"_3088":129707},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3638":75892,"_31204":75617,"_21623":129709,"_5":14885,"_28401":129036,"_3088":129710},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3638":75893,"_31204":75617,"_21623":129712,"_5":14885,"_28401":129036,"_3088":129713},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3638":75894,"_31204":75617,"_21623":129715,"_5":14885,"_28401":129036,"_3088":129716},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3638":75895,"_31204":75617,"_21623":129718,"_5":14885,"_28401":129036,"_3088":129719},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3638":75896,"_31204":75617,"_21623":129721,"_5":14885,"_28401":129040,"_3088":129722},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3638":75897,"_31204":75617,"_21623":129724,"_5":14885,"_28401":129040,"_3088":129725},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3638":75898,"_31204":75617,"_21623":129727,"_5":14885,"_28401":129040,"_3088":129728},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3638":75899,"_31204":75617,"_21623":129730,"_5":14885,"_28401":129040,"_3088":60366},[],{"_3638":75900,"_31204":75617,"_21623":129732,"_5":14885,"_28401":129040,"_3088":129733},[],"Claves de datos obligatorias",{"_3638":75901,"_31204":75617,"_21623":129735,"_5":14885,"_28401":129040,"_3088":129736},[],"Cuándo",{"_3638":75902,"_31204":75617,"_21623":129738,"_5":14885,"_28401":129040,"_3088":129739},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3638":75903,"_31204":75617,"_21623":129741,"_5":14885,"_28401":129040,"_3088":60378},[],{"_3638":75904,"_31204":75617,"_21623":129743,"_5":14885,"_28401":129040,"_3088":129744},[],"Siempre",{"_3638":75905,"_31204":75617,"_21623":129746,"_5":14885,"_28401":129040,"_3088":129747},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3638":75906,"_31204":75617,"_21623":129749,"_5":14885,"_28401":129040,"_3088":60378},[],{"_3638":75907,"_31204":75617,"_21623":129751,"_5":14885,"_28401":129040,"_3088":129744},[],{"_3638":75908,"_31204":75617,"_21623":129753,"_5":14885,"_28401":129040,"_3088":60391},[],{"_3638":75909,"_31204":75617,"_21623":129755,"_5":14885,"_28401":129040,"_3088":60378},[],{"_3638":75910,"_31204":75617,"_21623":129757,"_5":14885,"_28401":129040,"_3088":129758},[],"Solo cuando hay autenticación SMTP",{"_3638":75911,"_31204":75617,"_21623":129760,"_5":14885,"_28401":129040,"_3088":129761},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3638":75912,"_31204":75617,"_21623":129763,"_5":14885,"_28401":129040,"_3088":129764},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3638":75913,"_31204":75617,"_21623":129766,"_5":14885,"_28401":129040,"_3088":129767},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3638":75914,"_31204":75617,"_21623":129769,"_5":14885,"_28401":129040,"_3088":129770},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3638":75915,"_31204":75617,"_21623":129772,"_5":14885,"_28401":129040,"_3088":129773},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3638":75916,"_31204":75617,"_21623":129775,"_5":14885,"_28401":129040,"_3088":129776},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3638":75917,"_31204":75617,"_21623":129778,"_5":14885,"_28401":129040,"_3088":129779},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3638":75918,"_31204":75617,"_21623":129781,"_5":14885,"_28401":129040,"_3088":129782},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3638":75919,"_31204":75617,"_21623":129784,"_5":14885,"_28401":129040,"_3088":129785},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3638":75920,"_31204":75617,"_21623":129787,"_5":14885,"_28401":129040,"_3088":129788},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3638":75921,"_31204":75617,"_21623":129790,"_5":14885,"_28401":129040,"_3088":129791},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3638":75922,"_31204":75617,"_21623":129793,"_5":14885,"_28401":129040,"_3088":129794},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3638":75923,"_31204":75617,"_21623":129796,"_5":14885,"_28401":129040,"_3088":129797},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3638":75924,"_31204":75617,"_21623":129799,"_5":14885,"_28401":129040,"_3088":129800},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3638":75925,"_31204":75617,"_21623":129802,"_5":14885,"_28401":129040,"_3088":129803},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3638":75926,"_31204":75617,"_21623":129805,"_5":14885,"_28401":129044,"_3088":129806},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3638":75927,"_31204":75617,"_21623":129808,"_5":14885,"_28401":129044,"_3088":129809},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3638":75928,"_31204":75617,"_21623":129811,"_5":14885,"_28401":129048,"_3088":129812},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3638":75929,"_31204":75617,"_21623":129814,"_5":14885,"_28401":129048,"_3088":129815},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3638":75930,"_31204":75617,"_21623":129817,"_5":14885,"_28401":129048,"_3088":129818},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3638":75931,"_31204":75617,"_21623":129820,"_5":14885,"_28401":129048,"_3088":129821},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3638":75932,"_31204":75617,"_21623":129823,"_5":14885,"_28401":129048,"_3088":129824},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3638":75933,"_31204":75617,"_21623":129826,"_5":14885,"_28401":129048,"_3088":129827},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3638":75934,"_31204":75617,"_21623":129829,"_5":14885,"_28401":129048,"_3088":129830},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3638":75935,"_31204":75617,"_21623":129832,"_5":14885,"_28401":129048,"_3088":129833},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3638":75936,"_31204":75617,"_21623":129835,"_5":14885,"_28401":129048,"_3088":129836},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3638":75937,"_31204":75617,"_21623":129838,"_5":14885,"_28401":129048,"_3088":129839},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3638":75938,"_31204":75617,"_21623":129841,"_5":14885,"_28401":129048,"_3088":129842},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3638":75939,"_31204":75617,"_21623":129844,"_5":14885,"_28401":129052,"_3088":129845},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3638":75940,"_31204":75617,"_21623":129847,"_5":14885,"_28401":129052,"_3088":129848},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3638":75941,"_31204":75617,"_21623":129850,"_5":14885,"_28401":129056,"_3088":129851},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3638":75942,"_31204":75617,"_21623":129853,"_5":14885,"_28401":129056,"_3088":129854},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3638":75943,"_31204":75617,"_21623":129856,"_5":14885,"_28401":129056,"_3088":129857},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3638":75944,"_31204":75617,"_21623":129859,"_5":14885,"_28401":129056,"_3088":129860},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3638":75945,"_31204":75617,"_21623":129862,"_5":14885,"_28401":129056,"_3088":129863},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3638":75946,"_31204":75617,"_21623":129865,"_5":14885,"_28401":129056,"_3088":129866},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3638":75947,"_31204":75617,"_21623":129868,"_5":14885,"_28401":129056,"_3088":129869},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3638":75948,"_31204":75617,"_21623":129871,"_5":14885,"_28401":129056,"_3088":129872},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3638":75949,"_31204":75617,"_21623":129874,"_5":14885,"_28401":129060,"_3088":129875},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3638":75950,"_31204":75617,"_21623":129877,"_5":14885,"_28401":129060,"_3088":129878},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3638":75951,"_31204":75617,"_21623":129880,"_5":14885,"_28401":129060,"_3088":129881},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3638":75952,"_31204":75617,"_21623":129883,"_5":14885,"_28401":129060,"_3088":129884},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3638":75953,"_31204":75617,"_21623":129886,"_5":14885,"_28401":129060,"_3088":129887},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3638":75954,"_31204":75617,"_21623":129889,"_5":14885,"_28401":129060,"_3088":129890},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3638":75955,"_31204":75617,"_21623":129892,"_5":14885,"_28401":129060,"_3088":129893},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3638":75956,"_31204":75617,"_21623":129895,"_5":14885,"_28401":129060,"_3088":129896},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3638":75957,"_31204":75617,"_21623":129898,"_5":14885,"_28401":129060,"_3088":129899},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3638":75958,"_31204":75617,"_21623":129901,"_5":14885,"_28401":129060,"_3088":129902},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3638":75959,"_31204":75617,"_21623":129904,"_5":14885,"_28401":129060,"_3088":129905},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3638":75960,"_31204":75617,"_21623":129907,"_5":14885,"_28401":129063,"_3088":129908},[],"Tras la actualización, comprueba en este orden:",{"_3638":75961,"_31204":75617,"_21623":129910,"_5":14885,"_28401":129063,"_3088":129911},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3638":75962,"_31204":75617,"_21623":129913,"_5":14885,"_28401":129063,"_3088":129914},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3638":75963,"_31204":75617,"_21623":129916,"_5":14885,"_28401":129063,"_3088":129917},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3638":75964,"_31204":75617,"_21623":129919,"_5":14885,"_28401":129063,"_3088":129920},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3638":75965,"_31204":75617,"_21623":129922,"_5":14885,"_28401":129063,"_3088":129923},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3638":75966,"_31204":75617,"_21623":129925,"_5":14885,"_28401":129063,"_3088":129926},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3638":75967,"_31204":75617,"_21623":129928,"_5":14885,"_28401":129063,"_3088":129929},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3638":75968,"_31204":75617,"_21623":129931,"_5":14885,"_28401":129063,"_3088":129932},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3638":75969,"_31204":75617,"_21623":129934,"_5":14885,"_28401":129063,"_3088":129935},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3638":75970,"_31204":75617,"_21623":129937,"_5":14885,"_28401":129063,"_3088":129938},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3638":75971,"_31204":75617,"_21623":129940,"_5":14885,"_28401":129063,"_3088":129941},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3638":75972,"_31204":75617,"_21623":129943,"_5":14885,"_28401":129063,"_3088":129944},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3638":75973,"_31204":75617,"_21623":129946,"_5":14885,"_28401":129063,"_3088":129947},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3638":75974,"_31204":75617,"_21623":129949,"_5":14885,"_28401":129063,"_3088":129950},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3638":75975,"_31204":75617,"_21623":129952,"_5":14885,"_28401":129063,"_3088":129953},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3638":75976,"_31204":75617,"_21623":129955,"_5":14885,"_28401":129067,"_3088":129956},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3638":75977,"_31204":75617,"_21623":129958,"_5":14885,"_28401":129067,"_3088":129959},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3638":75978,"_31204":75617,"_21623":129961,"_5":14885,"_28401":129067,"_3088":129962},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3638":75979,"_31204":75617,"_21623":129964,"_5":14885,"_28401":129067,"_3088":129965},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3638":75980,"_31204":75617,"_21623":129967,"_5":14885,"_28401":129067,"_3088":129968},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60609":129970,"_60611":129971,"_60613":129972,"_60615":129973,"_18755":3123,"_72906":3123},"spanish",[3088,31204,5,28401],{"_3088":25810,"_31204":25810,"_5":25810,"_28401":25810},{"_3088":129974,"_31204":133045,"_5":136116,"_28401":139187},{"_4842":129975,"_60619":129976,"_5":25810},{"_14966":7260,"_15345":7806,"_15364":6062,"_30204":7990,"_15351":4225,"_20530":3381,"_14987":17303,"_14994":22310,"_30146":21767,"_30554":7948,"_30581":9603,"_30180":4585,"_35630":5171,"_30283":19706,"_30625":10237,"_35637":5604,"_35640":4367,"_35643":7325,"_35646":3379,"_31027":3497,"_35651":18787,"_35653":3401,"_31062":13851,"_15360":31220,"_35657":7835,"_35660":7625,"_35662":11382,"_30609":3592,"_31047":13295,"_31075":18386,"_35667":3317,"_35669":6241,"_35671":3261,"_30294":5169,"_35674":3700,"_35676":6770,"_35678":7926,"_35680":8010,"_35682":15015,"_30217":11387,"_35685":3827,"_35687":5047,"_30211":3201,"_30646":7507,"_35691":27948,"_35693":10778,"_35696":4587,"_30257":9260,"_35700":8518,"_30137":6881,"_35703":6090,"_30185":4561,"_35706":4583,"_35708":13763,"_35711":3405,"_15354":9757,"_35714":6200,"_35716":11419,"_35719":14963,"_35721":5542,"_35723":7732,"_35725":3198,"_35727":6577,"_20533":3583,"_35730":7808,"_35732":3754,"_30158":4101,"_30603":3485,"_35736":6921,"_35738":3848,"_35740":7376,"_31091":3605,"_35743":3807,"_35745":4330,"_35747":4170,"_31184":3720,"_30662":12308,"_35751":4334,"_35753":26216,"_30195":15403,"_35756":7874,"_35758":3498,"_31269":7693,"_31107":26876,"_30277":12789,"_29657":4084,"_35764":7624,"_35766":4923,"_35768":5199,"_30320":8895,"_35772":7299,"_30597":8894,"_35776":12924,"_35778":3543,"_35780":7938,"_35782":4929,"_35784":3451,"_35786":7245,"_30309":5170,"_30559":5666,"_35790":3365,"_35792":7321,"_35794":4646,"_35797":4273,"_35799":6503,"_35801":9369,"_35803":17397,"_35805":6607,"_35807":7862,"_35809":4271,"_35812":7004,"_35814":5789,"_35816":5750,"_35818":5355,"_35820":4800,"_35823":3307,"_35825":17057,"_35828":7738,"_35831":4167,"_35833":5760,"_35835":6578,"_35837":6333,"_35839":4144,"_35841":51041,"_35843":17347,"_35845":5142,"_35847":13584,"_30608":7996,"_35850":6052,"_35852":3681,"_35854":12505,"_35856":7848,"_35858":18191,"_35860":10850,"_35862":5143,"_35864":3927,"_35866":4690,"_35868":7849,"_35870":10847,"_35872":6097,"_35874":4142,"_35876":3972,"_35878":5158,"_35880":4141,"_35882":6182,"_35884":7821,"_35886":6552,"_35888":3125,"_35890":3563,"_35892":7212,"_35894"