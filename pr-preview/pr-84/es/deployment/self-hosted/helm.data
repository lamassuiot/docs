278},"platform/iot-fleets/integrations/aws-iot-core.mdx","es:platform/iot-fleets/integrations",{"_204":281},"platform/iot-fleets/integrations/meta.json","<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud shrink-0\" aria-hidden=\"true\"><path d=\"M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z\"></path></svg>",{"_37":284,"_44":84,"_59":-7,"_39":285},"es:_7","EST (RFC 7030)",{"_37":287,"_44":56,"_39":288,"_50":289,"_59":-7,"_12":290,"_61":291},"es:platform/iot-fleets/est/index.mdx","Referencia EST","El protocolo Enrollment over Secure Transport definido en RFC 7030.","/docs/pr-preview/pr-84/es/platform/iot-fleets/est",{"_63":292},"platform/iot-fleets/est/index.mdx",{"_37":294,"_44":56,"_39":295,"_50":296,"_59":-7,"_12":297,"_61":298},"es:platform/iot-fleets/est/configuration.mdx","EST en Lamassu","Configura las operaciones EST, la autenticación y la distribución de confianza.","/docs/pr-preview/pr-84/es/platform/iot-fleets/est/configuration",{"_63":299},"platform/iot-fleets/est/configuration.mdx",{"_37":301,"_44":56,"_39":302,"_50":303,"_59":-7,"_12":304,"_61":305},"es:platform/iot-fleets/est/bootstrap-identity.mdx","Autenticación y confianza","Prepara las credenciales, la autenticación y la distribución de confianza para EST.","/docs/pr-preview/pr-84/es/platform/iot-fleets/est/bootstrap-identity",{"_63":306},"platform/iot-fleets/est/bootstrap-identity.mdx",{"_37":308,"_44":56,"_39":309,"_50":310,"_59":-7,"_12":311,"_61":312},"es:platform/iot-fleets/est/troubleshooting.mdx","Diagnóstico de enrolamiento","Localiza fallos de transporte, autenticación, registro, emisión e instalación.","/docs/pr-preview/pr-84/es/platform/iot-fleets/est/troubleshooting",{"_63":313},"platform/iot-fleets/est/troubleshooting.mdx","es:platform/iot-fleets",{"_204":316},"platform/iot-fleets/meta.json","<svg xmlns=\"h